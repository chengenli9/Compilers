    #   object that tells where the pointers in the object end
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0, $t9
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger"
3256#    lw $s0,($t4)
3260#    lw $t9,-8($t1)
3264#    sw $t9,($t4)
3268#    sw $s0,-8($t1)

    # copy all source bytes to the target
3272:  gCinnerCopy2:
3272#    lw $s0,($t4)
3276#    sw $s0,($s3)
3280#    addu $t4,$t4,4
3284#    addu $s3,$s3,4
3288#    bltu $t4,$t3,gCinnerCopy2
3289##...sltu $at,$t4,$t3
3293##...bne $at,$zero,3272

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
3296#    sw $zero,-8($t1) # 0 in first header-slot
3300#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
3304#    sw $t8,($t0)

3308:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
3308#    addu $t0,$t0,4
3312#    bltu $t0,$s1,gcNextPointerInObject
3313##...sltu $at,$t0,$s1
3317##...bne $at,$zero,3156

3320:  gcTestIterDone2:
3320#    bltu $t0,$s3,gcHeapCopyLoop
3321##...sltu $at,$t0,$s3
3325##...bne $at,$zero,3040

    ###### end outer loop to copy all non-stack-direct objects ######

3328:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
3328#    lw $s2,($sp)
3332#    addu $sp,$sp,4

    # mark us as having already GC'd
3336#    move $t5,$s5

    # go try and allocate again
3340#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
3344:vm_init:

    # mark bottom of stack
3344#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
3348#    move $s2,$zero

    #set up the "five" register
3352#    li $s5,5

3356#    la $s3,seg0_start
3360#    la $s4,seg0_end
3361##...lui $s4,16
3365##...addiu $s4,$s4,4296
    
    # return
3368#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3372:divide:
    # get parameters; abort if divisor zero
3372#    lw $t0,($sp)
3376#    lw $t1,8($sp)
3380#    beq $t0,$zero,divByZeroError
    
    # perform division
3384#    div $t1,$t0
3388#    mflo $t0

    # store result, adjust stack and return
3392#    addu $sp,$sp,8 # adjust stack
3396#    sw $t0,($sp) # store result
3400#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3404:remainder:
    # get parameters; abort if divisor zero
3404#    lw $t0,($sp)
3408#    lw $t1,8($sp)
3412#    beq $t0,$zero,divByZeroError
    
    # perform division
3416#    div $t1,$t0
3420#    mfhi $t0

    # store result, adjust stack and return
3424#    addu $sp,$sp,8 # adjust stack
3428#    sw $t0,($sp) # store result
3432#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
3436:checkCast:
    # get object, allow immediately if null
3436#    lw $t2,($sp)
3440#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
3444#    lw $t2,-12($t2) # vtable address
3448#    bge $t2,$t1,castException
3449##...slt $at,$t2,$t1
3453##...beq $at,$zero,3624
3456#    blt $t2,$t0,castException
3457##...slt $at,$t2,$t0
3461##...bne $at,$zero,3624
    
    # return, leaving object unchanged on stack
3464:  checkCastReturn:    
3464#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
3468:instanceOf:
    # get object, go return false if null
3468#    lw $t2,($sp)
3472#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
3476#    lw $t2,-12($t2) # vtable address
3480#    sge $t0,$t2,$t0 # are we >= the lower limit?
3481##...slt $t0,$t2,$t0
3485##...xori $t0,$t0,0x1
3488#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
3492#    and $t2,$t0,$t1
3496#    sw $t2,($sp)
3500:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
3500#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

3504:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
3504#    li $v0,4 # syscall-code for print-string
3508#    syscall
3512:exit:
    # print termination message
3512#    li $v0,4 # syscall-code for print-string
3516#    la $a0,exitString
3520#    syscall

    # print number of garbage collections
3524#    li $v0,4 # syscall-code for print-string
3528#    la $a0,gcCountMsg
3532#    syscall # print "Number of ..."
3536#    lw $a0,gcCount # number of GC's
3540#    li $v0,1 # code for print-int
3544#    syscall
3548#    li $v0,4 # syscall-code for print-string
3552#    la $a0,newlineString
3556#    syscall # print newline

    # terminate execution
3560#    li $v0,10 #syscall-code for "exit"
3564#    syscall

3568:outOfHeapMemory:
3568#    la $a0,heapMemoryMsg
3572#    j exitError
3576:divByZeroError:
3576#    la $a0,divByZeroMsg
3580#    j exitError
3584:strIndexOutOfBounds:
3584#    la $a0,strIndexOutOfBoundsMsg
3588#    j exitError
3592:arrayIndexOutOfBounds:
3592#    la $a0,arrayIndexOutOfBoundsMsg
3596#    j exitError
3600:arraySizeOutOfBounds:
3600#    la $a0,arraySizeOutOfBoundsMsg
3604#    j exitError
3608:nullPtrException:
3608#    la $a0,nullPtrExceptionMsg
3612#    j exitError
3616:badIntegerFormat:
3616#    la $a0,badIntegerFormatMsg
3620#    j exitError
3624:castException:
3624#    la $a0,castExceptionMsg
3628#    j exitError
############## data section ################
    .data
3924:hexChars:
    .ascii "0123456789abcdef"
    .align 2
3940:cur_seg:
    .word 0

3944:lastCharRead:
    .word -2 # -2 => no buffered character
3948:prevHashConstant:
    .word 0x2785173c
3952:gcCount:
    .word 0

3956:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
3983:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
4006:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
4041:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
4075:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
4108:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
4139:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
4187:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
4208:gcMsg: 
      .asciiz "\nGC!\n"
4214:gcCountMsg: 
      .asciiz "Number of garbage collections: "

4246:nullStr:
    .asciiz "null"
4251:trueString:
    .asciiz "true"
4256:falseString:
    .asciiz "false"
4262:exitString:
    .ascii "Program execution completed."
    #### "falls through" here
4290:newlineString:
    .asciiz "\n"
    
    .align 2
4292:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

4296:seg0_start:
    .space 0x100000
1052872:seg0_end:
1052872:seg1_start:
    .space 0x100000
2101448:seg1_end:
