    # - $t1 will contain the contents of the heap-slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space, which will also be the first address
    #   of the target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # Then during processing:
    # And when we're actually copying an object:
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $t8 will contain a pointer to the target object
    # - available for use: $s0, $t8, $t9
    ##########################################################

    # compute the amount of space that is needed
20456#    bge $t8,$zero,gcSkip5 # # words in negative-offset portion
20457##...slt $at,$t8,$zero
20461##...beq $at,$zero,20476
20464#    and $t8,0xff # mask off hash bits
20465##...lui $at,0
20469##...ori $at,$at,0xff
20473##...and $t8,$t8,$at

20476:  gcSkip5:
20476#    sll $t8,$t8,2 # bytes in negative-offset portion ...
20480#    addu $t8,$t8,8 # ... add in bytes for header-words
20484#    subu $t4,$t1,$t8 # address of first word of source object
20488#    lw $t3,-4($t1) # # words in positive-offset portion
20492#    bge $t3,$zero,gcNoNeg
20493##...slt $at,$t3,$zero
20497##...beq $at,$zero,20504
20500#    move $t3,$zero # negative treated as zero
20504:  gcNoNeg:
20504#    sll $t3,$t3,2 # bytes in negative-offset portion
20508#    addu $t3,$t3,$t1 # address one word past last word of source

20512#    addu $t8,$s3,$t8 # pointer to target object

    #########################################################
    # At this point:
    # - $t0 contains the address of the stack slot we'll
    #   process next
    # - $t1 contains the contents of the stack slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $t8 contains the pointer to the target object
    # - $s1 contains the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0, $t9
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger"
20516#    lw $s0,($t4)
20520#    lw $t9,-8($t1)
20524#    sw $t9,($t4)
20528#    sw $s0,-8($t1)

    # copy all source bytes to the target
20532:  gCinnerCopy2:
20532#    lw $s0,($t4)
20536#    sw $s0,($s3)
20540#    addu $t4,$t4,4
20544#    addu $s3,$s3,4
20548#    bltu $t4,$t3,gCinnerCopy2
20549##...sltu $at,$t4,$t3
20553##...bne $at,$zero,20532

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
20556#    sw $zero,-8($t1) # 0 in first header-slot
20560#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
20564#    sw $t8,($t0)

20568:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
20568#    addu $t0,$t0,4
20572#    bltu $t0,$s1,gcNextPointerInObject
20573##...sltu $at,$t0,$s1
20577##...bne $at,$zero,20416

20580:  gcTestIterDone2:
20580#    bltu $t0,$s3,gcHeapCopyLoop
20581##...sltu $at,$t0,$s3
20585##...bne $at,$zero,20300

    ###### end outer loop to copy all non-stack-direct objects ######

20588:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
20588#    lw $s2,($sp)
20592#    addu $sp,$sp,4

    # mark us as having already GC'd
20596#    move $t5,$s5

    # go try and allocate again
20600#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
20604:vm_init:

    # mark bottom of stack
20604#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
20608#    move $s2,$zero

    #set up the "five" register
20612#    li $s5,5

20616#    la $s3,seg0_start
20620#    la $s4,seg0_end
20621##...lui $s4,16
20625##...addiu $s4,$s4,21524
    
    # return
20628#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
20632:divide:
    # get parameters; abort if divisor zero
20632#    lw $t0,($sp)
20636#    lw $t1,8($sp)
20640#    beq $t0,$zero,divByZeroError
    
    # perform division
20644#    div $t1,$t0
20648#    mflo $t0

    # store result, adjust stack and return
20652#    addu $sp,$sp,8 # adjust stack
20656#    sw $t0,($sp) # store result
20660#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
20664:remainder:
    # get parameters; abort if divisor zero
20664#    lw $t0,($sp)
20668#    lw $t1,8($sp)
20672#    beq $t0,$zero,divByZeroError
    
    # perform division
20676#    div $t1,$t0
20680#    mfhi $t0

    # store result, adjust stack and return
20684#    addu $sp,$sp,8 # adjust stack
20688#    sw $t0,($sp) # store result
20692#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
20696:checkCast:
    # get object, allow immediately if null
20696#    lw $t2,($sp)
20700#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
20704#    lw $t2,-12($t2) # vtable address
20708#    bge $t2,$t1,castException
20709##...slt $at,$t2,$t1
20713##...beq $at,$zero,20848
20716#    blt $t2,$t0,castException
20717##...slt $at,$t2,$t0
20721##...bne $at,$zero,20848
    
    # return, leaving object unchanged on stack
20724:  checkCastReturn:    
20724#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
20728:instanceOf:
    # get object, go return false if null
20728#    lw $t2,($sp)
20732#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
20736#    lw $t2,-12($t2) # vtable address
20740#    sge $t0,$t2,$t0 # are we >= the lower limit?
20741##...slt $t0,$t2,$t0
20745##...xori $t0,$t0,0x1
20748#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
20752#    and $t2,$t0,$t1
20756#    sw $t2,($sp)
20760:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
20760#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

20764:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
20764#    li $v0,4 # syscall-code for print-string
20768#    syscall
20772:exit:
    # print termination message
20772#    li $v0,4 # syscall-code for print-string
20776#    la $a0,exitString
20780#    syscall

    # terminate execution
20784#    li $v0,10 #syscall-code for "exit"
20788#    syscall

20792:outOfHeapMemory:
20792#    la $a0,heapMemoryMsg
20796#    j exitError
20800:divByZeroError:
20800#    la $a0,divByZeroMsg
20804#    j exitError
20808:strIndexOutOfBounds:
20808#    la $a0,strIndexOutOfBoundsMsg
20812#    j exitError
20816:arrayIndexOutOfBounds:
20816#    la $a0,arrayIndexOutOfBoundsMsg
20820#    j exitError
20824:arraySizeOutOfBounds:
20824#    la $a0,arraySizeOutOfBoundsMsg
20828#    j exitError
20832:nullPtrException:
20832#    la $a0,nullPtrExceptionMsg
20836#    j exitError
20840:badIntegerFormat:
20840#    la $a0,badIntegerFormatMsg
20844#    j exitError
20848:castException:
20848#    la $a0,castExceptionMsg
20852#    j exitError
############## data section ################
    .data
21160:hexChars:
    .ascii "0123456789abcdef"
    .align 2
21176:cur_seg:
    .word 0

21180:lastCharRead:
    .word -2 # -2 => no buffered character
21184:prevHashConstant:
    .word 0x2785173c
21188:gcCount:
    .word 0

21192:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
21219:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
21242:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
21277:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
21311:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
21344:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
21375:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
21423:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
21444:gcMsg: 
      .asciiz "\nGC!\n"
21450:gcCountMsg: 
      .asciiz "Number of garbage collections: "

21482:nullStr:
    .asciiz "null"
21487:trueString:
    .asciiz "true"
21492:falseString:
    .asciiz "false"
21498:exitString:
    .ascii "Program terminated."
    #### "falls through" here
21517:newlineString:
    .asciiz "\n"
    
    .align 2
21520:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

21524:seg0_start:
    .space 0x100000
1070100:seg0_end:
1070100:seg1_start:
    .space 0x100000
2118676:seg1_end:
