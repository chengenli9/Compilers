###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
3468:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
3468#    lw $t0,-8($s2) # get word with hash bits from this
3472#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
3476#    addu $t0,$t1

3480#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
3484:mth_equals_Object:
3484#    move $t0,$s2 # first pointer (this)
3488#    lw $t1,($sp) # second pointer
3492#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
3493##...subu $at,$t0,$t1
3497##...sltiu $t0,$at,1

3500#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
3504:mth_hashCode_String:
3504#    move $t0,$s2 # put this pointer in t0

3508#    li $t2,0 # current hash value
3512#    lw $t1,-4($t0) # negative of number of characters in string
3516#    beq $t1,$zero,done_hashCode_String # if zero length => done
3520#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
3524#    and $t0,0xfffffffc # adjust for padding
3525##...lui $at,65535
3529##...ori $at,$at,0xfffc
3533##...and $t0,$t0,$at
3536#    subu $t1,$t0,$t1 # address at end of string +12
3540:loop_hashCode_String:    
3540#    sll $t4,$t2,5 # multiply by 32
3544#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
3548#    lbu $t3,-12($t0) # current character
3552#    addu $t2,$t3 # add in current character
3556#    addu $t0,1 # go to next character's address
3560#    bne $t0,$t1,loop_hashCode_String # loop back if more
3564:done_hashCode_String:    

    # push int on stack
3564#    move $t0, $t2 # put $t2 in return slot
3568#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
3572:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
3572#    subu $sp,4
3576#    sw $ra,($sp)
    
    # get hash value
3580#    lw $t2,-12($s2) # vtable address
3584#    lw $t0,($t2) # method address
3588#    jalr $t0
3592#    subu $sp,8 # push result (int in $t0) on stack
3596#    sw $s5,4($sp)
3600#    sw $t0,($sp)

    # compute print-size of hash value
3604#    li $t0, 1
3608#    lw $t1, ($sp)
3612#    srl $t1,$t1,4
3616#    beq $t1,$zero,toString_skip_loop
3620:toString_loop_top:
3620#    addu $t0,1
3624#    srl $t1,$t1,4
3628#    bne $t1,$zero,toString_loop_top
3632:toString_skip_loop:
3632#    subu $sp,8
3636#    sw $s5,4($sp)
3640#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
3644#    lw $t2,-12($s2) # vtable address
3648#    move $t0,$t2
3652:toString_checkTagBit:
3652#    subu $t0,1
3656#    lb $t1,($t0)
3660#    and $t1,0x80
3661##...lui $at,0
3665##...ori $at,$at,0x80
3669##...and $t1,$t1,$at
3672#    beq $t1,$zero,toString_checkTagBit
3676#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
3680#    subu $sp,8
3684#    sw $t1,($sp)
3688#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
3692#    move $s7,$zero # -4 offset header word
3696#    lw $t4,8($sp) # bytes for hash value
3700#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
3704#    addu $t4,8
3708#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
3712#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

3716#    li $t0,CLASS_String # store string vtable address into ...
3720#    sw $t0,-12($s7) # ... -12 offset in object header
3724#    lw $t2,-12($s2) # our object's vtable address
3728#    lw $t5,4($sp) # number characters in prefix
3732#    lw $t1,12($sp) # number of characters in hashcode
3736#    addu $t3,$t1,$t5 # number of characters in string ...
3740#    addu $t3,1 # ... including the '@' character
3744#    subu $t0,$zero,$t3 # store negated length into ...
3748#    sw $t0,-4($s7) # ... -4 offset header word
3752#    lw $t0,-8($s7) # get -8 offset header-word
3756#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
3757##...slt $at,$t0,$zero
3761##...beq $at,$zero,3780
3764#    and $t0,0xff # mask off object's hash value ...
3765##...lui $at,0
3769##...ori $at,$at,0xff
3773##...and $t0,$t0,$at
3776#    sw $t0,-8($s7) # ... and store back into -8 header-word
3780:skipMask_toString:
3780#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
3784#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
3788#    subu $t4,$t2,$t5
3792:toString_copyLoop:    
3792#    lb $t3,($t4)
3796#    and $t3,0x7f # mask off sign bit (in case first word)
3797##...lui $at,0
3801##...ori $at,$at,0x7f
3805##...and $t3,$t3,$at
3808#    sb $t3,-8($t0)
3812#    addu $t4,1
3816#    addu $t0,1
3820#    blt $t4,$t2,toString_copyLoop
3821##...slt $at,$t4,$t2
3825##...bne $at,$zero,3792

    # copy the '@' sign
3828#    li $t3,'@'
3832#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
3836#    addu $t2,$t0,$t1 # address of last byte in string to store +8
3840#    lw $t3,20($sp) # hash code to print
3844:toString_hashCopyLoop:
3844#    and $t4,$t3,0xf
3848#    srl $t3,4
3852#    lb $t4,hexChars($t4)
3856#    sb $t4,-8($t2)
3860#    subu $t2,$t2,1
3864#    bgt $t2,$t0,toString_hashCopyLoop
3865##...slt $at,$t0,$t2
3869##...bne $at,$zero,3844

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
3872#    addu $sp,28
3876#    lw $ra,($sp)
3880#    addu $sp,4
3884#    move $t0, $s7 # return string we created
3888#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
3892:mth_equals_String:
    
    # quick test for obvious false
3892#    lw $t0,($sp) # second parameter
3896#    beq $t0,$zero,goEsFalse # go return false if null
3900#    lw $t1,-12($t0) # vtable pointer
3904#    la $t2,CLASS_String # string vtable pointer
3908#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
3912#    subu $sp,12
3916#    sw $ra,8($sp)
3920#    sw $s2,4($sp)
3924#    sw $t0,($sp)
3928#    jal mth_compareTo_String
3932#    lw $s2, 4($sp) #restore this pointer and pop parameters
3936#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
3940#    seq $t0,$t0,$zero
3941##...subu $at,$t0,$zero
3945##...sltiu $t0,$at,1

    # pop return address and return $t0
3948#    lw $ra,($sp)
3952#    addu $sp,4

3956#    jr $ra # return
    
3960:goEsFalse:
    # put 0 in $t0 and return
3960#    li $t0, 0
3964#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
3968:mth_toString_String:
    #we are a string, so return this.
3968#    move $t0, $s2
3972#    jr $ra

###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
3976:mth_readLine_Lib:
    
3976#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
3980#    sw $ra, 4($sp) # save $ra
3984#    move $t1,$sp # save "original" sp

3988:  doRead:

    # read the character
3988#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
3992#    subu $t2,$v0,13
3996#    bne $t2,$zero,notReturnRL
4000#    jal readLogicalChar
4004#    subu $t2,$v0,10 # check for newline
4008#    beq $t2,$zero,foundNewLine
4012#    sw $v0,lastCharRead # push back character into queue
4016#    j foundNewLine # go process the line

4020:  notReturnRL:

    # at this point, $v0 has our character

4020#    subu $t0,$v0,10
4024#    beq $t0,$zero,foundNewLine
4028#    blt $v0,$zero,foundEof
4029##...slt $at,$v0,$zero
4033##...bne $at,$zero,4048

    # we have a character, so push it onto stack
4036#    subu $sp,$sp,4
4040#    sw $v0,($sp)

    # loop back up to get next character
4044#    j doRead

4048:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
4048#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
4052#    li $s7, 0 # return-value: null
4056#    j rlReturn # return

4060:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
4060#    subu $t0,$t1,$sp # number of chars we read (times 4)
4064#    srl $s6,$t0,2 # number of words on stack with chars
4068#    subu $sp,$sp,4 # push char-count ...
4072#    sw $s6,($sp) # ... onto stack
4076#    addu $t2,$t0,5 # GC tag, incl. for count-word
4080#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
4084#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
4088#    srl $s6,$s6,2  # data words in object
4092#    move $s7,$zero # object words in object
4096#    jal newObject  # allocate space
    
    # store header words
4100#    la $t0,CLASS_String
4104#    sw $t0,-12($s7)# store class tag (String) into object
4108#    lw $t2,4($sp) # char-count
4112#    sll $t1,$t2,2 # 4 times number of chars
4116#    subu $t2,$zero,$t2 # negative of char-count
4120#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
4124#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
4128#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
4129##...slt $at,$t0,$zero
4133##...beq $at,$zero,4152
4136#    and $t0,0xff # mask off object's hash value ...
4137##...lui $at,0
4141##...ori $at,$at,0xff
4145##...and $t0,$t0,$at
4148#    sw $t0,-8($s7) # ... and store back into -8 header-word
4152:  skipMask_readLine:

4152#    sll $t0,$t0,2 # data bytes in object
4156#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
4160#    subu $t0,$t0,$t2 # place to store last character (plus 9)
4164#    addu $sp,$sp,8 # pop redundant object-pointer and count
4168#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

4172#    beq $sp,$t1,rlReturn
4176:  charCopyLoop:
4176#    lw $t2,($sp)
4180#    sb $t2,-9($t0)
