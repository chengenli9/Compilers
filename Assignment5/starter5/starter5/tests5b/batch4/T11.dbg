3665##...bne $at,$zero,3800

    # if the object has already been moved, update the stack-value
    # via the forwarding pointer
3668#    lw $t8,-8($t1) # possible forwarding tag
3672#    bne $t8,$zero,gcNoForward2 # if not forwarding tag, go copy
3676#    lw $t8,-4($t1) # forwarding pointer: object's new address
3680#    sw $t8,($t0) # update pointer in object
3684#    j gcGoNextPointerSlot # do next iteration

3688:  gcNoForward2:
    #########################################################
    # we actually need to copy the object into the new space
    #########################################################

    #########################################################
    # At this point:
    # - $t0 contains the address of the heap-slot we're translating
    # - $t1 will contain the contents of the heap-slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space, which will also be the first address
    #   of the target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # Then during processing:
    # And when we're actually copying an object:
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $t8 will contain a pointer to the target object
    # - available for use: $s0, $t8, $t9
    ##########################################################

    # compute the amount of space that is needed
3688#    bge $t8,$zero,gcSkip5 # # words in negative-offset portion
3689##...slt $at,$t8,$zero
3693##...beq $at,$zero,3708
3696#    and $t8,0xff # mask off hash bits
3697##...lui $at,0
3701##...ori $at,$at,0xff
3705##...and $t8,$t8,$at

3708:  gcSkip5:
3708#    sll $t8,$t8,2 # bytes in negative-offset portion ...
3712#    addu $t8,$t8,8 # ... add in bytes for header-words
3716#    subu $t4,$t1,$t8 # address of first word of source object
3720#    lw $t3,-4($t1) # # words in positive-offset portion
3724#    bge $t3,$zero,gcNoNeg
3725##...slt $at,$t3,$zero
3729##...beq $at,$zero,3736
3732#    move $t3,$zero # negative treated as zero
3736:  gcNoNeg:
3736#    sll $t3,$t3,2 # bytes in negative-offset portion
3740#    addu $t3,$t3,$t1 # address one word past last word of source

3744#    addu $t8,$s3,$t8 # pointer to target object

    #########################################################
    # At this point:
    # - $t0 contains the address of the stack slot we'll
    #   process next
    # - $t1 contains the contents of the stack slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $t8 contains the pointer to the target object
    # - $s1 contains the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0, $t9
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger"
3748#    lw $s0,($t4)
3752#    lw $t9,-8($t1)
3756#    sw $t9,($t4)
3760#    sw $s0,-8($t1)

    # copy all source bytes to the target
3764:  gCinnerCopy2:
3764#    lw $s0,($t4)
3768#    sw $s0,($s3)
3772#    addu $t4,$t4,4
3776#    addu $s3,$s3,4
3780#    bltu $t4,$t3,gCinnerCopy2
3781##...sltu $at,$t4,$t3
3785##...bne $at,$zero,3764

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
3788#    sw $zero,-8($t1) # 0 in first header-slot
3792#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
3796#    sw $t8,($t0)

3800:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
3800#    addu $t0,$t0,4
3804#    bltu $t0,$s1,gcNextPointerInObject
3805##...sltu $at,$t0,$s1
3809##...bne $at,$zero,3648

3812:  gcTestIterDone2:
3812#    bltu $t0,$s3,gcHeapCopyLoop
3813##...sltu $at,$t0,$s3
3817##...bne $at,$zero,3532

    ###### end outer loop to copy all non-stack-direct objects ######

3820:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
3820#    lw $s2,($sp)
3824#    addu $sp,$sp,4

    # mark us as having already GC'd
3828#    move $t5,$s5

    # go try and allocate again
3832#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
3836:vm_init:

    # mark bottom of stack
3836#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
3840#    move $s2,$zero

    #set up the "five" register
3844#    li $s5,5

3848#    la $s3,seg0_start
3852#    la $s4,seg0_end
3853##...lui $s4,16
3857##...addiu $s4,$s4,4740
    
    # return
3860#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3864:divide:
    # get parameters; abort if divisor zero
3864#    lw $t0,($sp)
3868#    lw $t1,8($sp)
3872#    beq $t0,$zero,divByZeroError
    
    # perform division
3876#    div $t1,$t0
3880#    mflo $t0

    # store result, adjust stack and return
3884#    addu $sp,$sp,8 # adjust stack
3888#    sw $t0,($sp) # store result
3892#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3896:remainder:
    # get parameters; abort if divisor zero
3896#    lw $t0,($sp)
3900#    lw $t1,8($sp)
3904#    beq $t0,$zero,divByZeroError
    
    # perform division
3908#    div $t1,$t0
3912#    mfhi $t0

    # store result, adjust stack and return
3916#    addu $sp,$sp,8 # adjust stack
3920#    sw $t0,($sp) # store result
3924#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
3928:checkCast:
    # get object, allow immediately if null
3928#    lw $t2,($sp)
3932#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
3936#    lw $t2,-12($t2) # vtable address
3940#    bge $t2,$t1,castException
3941##...slt $at,$t2,$t1
3945##...beq $at,$zero,4116
3948#    blt $t2,$t0,castException
3949##...slt $at,$t2,$t0
3953##...bne $at,$zero,4116
    
    # return, leaving object unchanged on stack
3956:  checkCastReturn:    
3956#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
3960:instanceOf:
    # get object, go return false if null
3960#    lw $t2,($sp)
3964#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
3968#    lw $t2,-12($t2) # vtable address
3972#    sge $t0,$t2,$t0 # are we >= the lower limit?
3973##...slt $t0,$t2,$t0
3977##...xori $t0,$t0,0x1
3980#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
3984#    and $t2,$t0,$t1
3988#    sw $t2,($sp)
3992:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
3992#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

3996:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
3996#    li $v0,4 # syscall-code for print-string
4000#    syscall
4004:exit:
    # print termination message
4004#    li $v0,4 # syscall-code for print-string
4008#    la $a0,exitString
4012#    syscall

    # print number of garbage collections
4016#    li $v0,4 # syscall-code for print-string
4020#    la $a0,gcCountMsg
4024#    syscall # print "Number of ..."
4028#    lw $a0,gcCount # number of GC's
4032#    li $v0,1 # code for print-int
4036#    syscall
4040#    li $v0,4 # syscall-code for print-string
4044#    la $a0,newlineString
4048#    syscall # print newline

    # terminate execution
4052#    li $v0,10 #syscall-code for "exit"
4056#    syscall

4060:outOfHeapMemory:
4060#    la $a0,heapMemoryMsg
4064#    j exitError
4068:divByZeroError:
4068#    la $a0,divByZeroMsg
4072#    j exitError
4076:strIndexOutOfBounds:
4076#    la $a0,strIndexOutOfBoundsMsg
4080#    j exitError
4084:arrayIndexOutOfBounds:
4084#    la $a0,arrayIndexOutOfBoundsMsg
4088#    j exitError
4092:arraySizeOutOfBounds:
4092#    la $a0,arraySizeOutOfBoundsMsg
4096#    j exitError
4100:nullPtrException:
4100#    la $a0,nullPtrExceptionMsg
4104#    j exitError
4108:badIntegerFormat:
4108#    la $a0,badIntegerFormatMsg
4112#    j exitError
4116:castException:
4116#    la $a0,castExceptionMsg
4120#    j exitError
############## data section ################
    .data
4368:hexChars:
    .ascii "0123456789abcdef"
    .align 2
4384:cur_seg:
    .word 0

4388:lastCharRead:
    .word -2 # -2 => no buffered character
4392:prevHashConstant:
    .word 0x2785173c
4396:gcCount:
    .word 0

4400:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
4427:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
4450:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
4485:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
4519:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
4552:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
4583:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
4631:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
4652:gcMsg: 
      .asciiz "\nGC!\n"
4658:gcCountMsg: 
      .asciiz "Number of garbage collections: "

4690:nullStr:
    .asciiz "null"
4695:trueString:
    .asciiz "true"
4700:falseString:
    .asciiz "false"
4706:exitString:
    .ascii "Program execution completed."
    #### "falls through" here
4734:newlineString:
    .asciiz "\n"
    
    .align 2
4736:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

4740:seg0_start:
    .space 0x100000
1053316:seg0_end:
1053316:seg1_start:
    .space 0x100000
2101892:seg1_end:
