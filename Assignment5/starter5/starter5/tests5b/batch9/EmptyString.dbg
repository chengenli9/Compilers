    #############################################################
    # We have finished processing the stack elements.  Now we need
    # to update elements in the heap itself. This may itself involve
    # moving additional objects
    #############################################################

    #########################################################
    # At this point:
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # We want to set things up so that in addition:
    # - $t0 is the "trailing finger", containing the address
    #   of the first slot in target space that we have yet
    #   to process.
    # Then during processing:
    # - $t1 will contain the contents of the heap slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # And when we're actually copying an object:
    # - $t2 will contain pointer to the target object
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - available for use: $s0
    ##########################################################

    # set $t0 to be at the beginning of target-space
6868#    lw $t1,cur_seg
6872#    la $t0,seg0_start
6876#    beq $t1,$zero,gcSkip4
6880#    la $t0,seg1_start
6881##...lui $t0,16
6885##...addiu $t0,$t0,8456


6888:  gcSkip4:

    # if there were no objects put into the heap during stack
    # processing, we're done, so go finish up
6888#    bgeu $t0,$s3,gcFinishUp
6889##...sltu $at,$t0,$s3
6893##...beq $at,$zero,7184

    ###### begin outer loop to copy all non-stack-direct objects ######

6896:  gcHeapCopyLoop:
    # get data count for object; swap header-word with first word
    # of object so that they're back in the right place
6896#    lw $t1,($t0) # (what will be) first header word for current object
6900#    move $t2,$t1 # number data bytes in object (poss. w/hash bits)
6904#    bge $t2,$zero,gcSkip4a # are there hash bits?
6905##...slt $at,$t2,$zero
6909##...beq $at,$zero,6924
6912#    and $t2,0xff # mask off hash bits
6913##...lui $at,0
6917##...ori $at,$at,0xff
6921##...and $t2,$t2,$at
6924:gcSkip4a:    
6924#    sll $t2,$t2,2 # # data bytes
6928#    addu $t2,$t2,8 # to skip header words
6932#    addu $t2,$t0,$t2 # pointer to new object
6936#    lw $t3,-8($t2) # word to swap
6940#    sw $t1,-8($t2) # store header word
6944#    sw $t3,($t0) # restore first word of object

    ################################################
    # at this point:
    # - $t2 contains the pointer to our new object
    ################################################

    # check if we have a data array
6948#    lw $t1,-12($t2) # vtable pointer
6952#    li $t0,dataArrayVTableStart # address of vtable for first data array
6956#    blt $t1,$t0,gcNotDataArray # if data array, no more xforming to do
6957##...slt $at,$t1,$t0
6961##...bne $at,$zero,6980

    # We have a vtable address that is a data array.
    # we need skip over it then loop back to do next object.
6964:  skipToNextObj:
6964#    lw $t1,-4($t2) # data words in (object position of) array
    #### note: we know that it's not a string, so the value will
    #### not be artificially negative
6968#    sll $t1,$t1,2 # convert to byte-count
6972#    addu $t0,$t2,$t1 # skip over object
6976#    j gcTestIterDone2 # go do next object, if any

    ###################################################
    # at this point:
    # - the object has been restored to normal status--that is, the
    #   word-swap has been done
    # - $t2 contains a pointer to the object
    ###################################################
    
6980:  gcNotDataArray:
6980#    lw $t3,-4($t2) # # object words (negative treated as zero)
6984#    bge $t3,$zero,gcH2Neg2
6985##...slt $at,$t3,$zero
6989##...beq $at,$zero,6996
6992#    move $t3,$zero
6996:  gcH2Neg2:
6996#    sll $t3,$t3,2 # # object bytes
7000#    move $t0,$t2 # address of first pointer in object
7004#    add $s1,$t2,$t3 # limit address for this object

    #####################################################
    # At this point, we have to "translate" all pointers,
    # starting at $t0 to (but not including) $s1
    #####################################################

    # if there are no pointer-slots (i.e., $t0=$s1), skip this
    # part
7008#    beq $t0,$s1,gcTestIterDone2
    
7012:  gcNextPointerInObject:
    # get pointer from object
7012#    lw $t1,($t0)

    # if value is out of range, and is therefore does not refer
    # to an object, just go loop back and do the next one
7016#    bleu $t1,$t6,gcGoNextPointerSlot
7017##...sltu $at,$t6,$t1
7021##...beq $at,$zero,7164
7024#    bgtu $t1,$t7,gcGoNextPointerSlot
7025##...sltu $at,$t7,$t1
7029##...bne $at,$zero,7164

    # if the object has already been moved, update the stack-value
    # via the forwarding pointer
7032#    lw $t8,-8($t1) # possible forwarding tag
7036#    bne $t8,$zero,gcNoForward2 # if not forwarding tag, go copy
7040#    lw $t8,-4($t1) # forwarding pointer: object's new address
7044#    sw $t8,($t0) # update pointer in object
7048#    j gcGoNextPointerSlot # do next iteration

7052:  gcNoForward2:
    #########################################################
    # we actually need to copy the object into the new space
    #########################################################

    #########################################################
    # At this point:
    # - $t0 contains the address of the heap-slot we're translating
    # - $t1 will contain the contents of the heap-slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space, which will also be the first address
    #   of the target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # Then during processing:
    # And when we're actually copying an object:
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $t8 will contain a pointer to the target object
    # - available for use: $s0, $t8, $t9
    ##########################################################

    # compute the amount of space that is needed
7052#    bge $t8,$zero,gcSkip5 # # words in negative-offset portion
7053##...slt $at,$t8,$zero
7057##...beq $at,$zero,7072
7060#    and $t8,0xff # mask off hash bits
7061##...lui $at,0
7065##...ori $at,$at,0xff
7069##...and $t8,$t8,$at

7072:  gcSkip5:
7072#    sll $t8,$t8,2 # bytes in negative-offset portion ...
7076#    addu $t8,$t8,8 # ... add in bytes for header-words
7080#    subu $t4,$t1,$t8 # address of first word of source object
7084#    lw $t3,-4($t1) # # words in positive-offset portion
7088#    bge $t3,$zero,gcNoNeg
7089##...slt $at,$t3,$zero
7093##...beq $at,$zero,7100
7096#    move $t3,$zero # negative treated as zero
7100:  gcNoNeg:
7100#    sll $t3,$t3,2 # bytes in negative-offset portion
7104#    addu $t3,$t3,$t1 # address one word past last word of source

7108#    addu $t8,$s3,$t8 # pointer to target object

    #########################################################
    # At this point:
    # - $t0 contains the address of the stack slot we'll
    #   process next
    # - $t1 contains the contents of the stack slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $t8 contains the pointer to the target object
    # - $s1 contains the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0, $t9
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger"
7112#    lw $s0,($t4)
7116#    lw $t9,-8($t1)
7120#    sw $t9,($t4)
7124#    sw $s0,-8($t1)

    # copy all source bytes to the target
7128:  gCinnerCopy2:
7128#    lw $s0,($t4)
7132#    sw $s0,($s3)
7136#    addu $t4,$t4,4
7140#    addu $s3,$s3,4
7144#    bltu $t4,$t3,gCinnerCopy2
7145##...sltu $at,$t4,$t3
7149##...bne $at,$zero,7128

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
7152#    sw $zero,-8($t1) # 0 in first header-slot
7156#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
7160#    sw $t8,($t0)

7164:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
7164#    addu $t0,$t0,4
7168#    bltu $t0,$s1,gcNextPointerInObject
7169##...sltu $at,$t0,$s1
7173##...bne $at,$zero,7012

7176:  gcTestIterDone2:
7176#    bltu $t0,$s3,gcHeapCopyLoop
7177##...sltu $at,$t0,$s3
7181##...bne $at,$zero,6896

    ###### end outer loop to copy all non-stack-direct objects ######

7184:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
7184#    lw $s2,($sp)
7188#    addu $sp,$sp,4

    # mark us as having already GC'd
7192#    move $t5,$s5

    # go try and allocate again
7196#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
7200:vm_init:

    # mark bottom of stack
7200#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
7204#    move $s2,$zero

    #set up the "five" register
7208#    li $s5,5

7212#    la $s3,seg0_start
7216#    la $s4,seg0_end
7217##...lui $s4,16
7221##...addiu $s4,$s4,8456
    
    # return
7224#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
7228:divide:
    # get parameters; abort if divisor zero
7228#    lw $t0,($sp)
7232#    lw $t1,8($sp)
7236#    beq $t0,$zero,divByZeroError
    
    # perform division
7240#    div $t1,$t0
7244#    mflo $t0

    # store result, adjust stack and return
7248#    addu $sp,$sp,8 # adjust stack
7252#    sw $t0,($sp) # store result
7256#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
7260:remainder:
    # get parameters; abort if divisor zero
7260#    lw $t0,($sp)
7264#    lw $t1,8($sp)
7268#    beq $t0,$zero,divByZeroError
    
    # perform division
7272#    div $t1,$t0
7276#    mfhi $t0

    # store result, adjust stack and return
7280#    addu $sp,$sp,8 # adjust stack
7284#    sw $t0,($sp) # store result
7288#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
7292:checkCast:
    # get object, allow immediately if null
7292#    lw $t2,($sp)
7296#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
7300#    lw $t2,-12($t2) # vtable address
7304#    bge $t2,$t1,castException
7305##...slt $at,$t2,$t1
7309##...beq $at,$zero,7480
7312#    blt $t2,$t0,castException
7313##...slt $at,$t2,$t0
7317##...bne $at,$zero,7480
    
    # return, leaving object unchanged on stack
7320:  checkCastReturn:    
7320#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
7324:instanceOf:
    # get object, go return false if null
7324#    lw $t2,($sp)
7328#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
7332#    lw $t2,-12($t2) # vtable address
7336#    sge $t0,$t2,$t0 # are we >= the lower limit?
7337##...slt $t0,$t2,$t0
7341##...xori $t0,$t0,0x1
7344#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
7348#    and $t2,$t0,$t1
7352#    sw $t2,($sp)
7356:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
7356#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

7360:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
7360#    li $v0,4 # syscall-code for print-string
7364#    syscall
7368:exit:
    # print termination message
7368#    li $v0,4 # syscall-code for print-string
7372#    la $a0,exitString
7376#    syscall

    # print number of garbage collections
7380#    li $v0,4 # syscall-code for print-string
7384#    la $a0,gcCountMsg
7388#    syscall # print "Number of ..."
7392#    lw $a0,gcCount # number of GC's
7396#    li $v0,1 # code for print-int
7400#    syscall
7404#    li $v0,4 # syscall-code for print-string
7408#    la $a0,newlineString
7412#    syscall # print newline

    # terminate execution
7416#    li $v0,10 #syscall-code for "exit"
7420#    syscall

7424:outOfHeapMemory:
7424#    la $a0,heapMemoryMsg
7428#    j exitError
7432:divByZeroError:
7432#    la $a0,divByZeroMsg
7436#    j exitError
7440:strIndexOutOfBounds:
7440#    la $a0,strIndexOutOfBoundsMsg
7444#    j exitError
7448:arrayIndexOutOfBounds:
7448#    la $a0,arrayIndexOutOfBoundsMsg
7452#    j exitError
7456:arraySizeOutOfBounds:
7456#    la $a0,arraySizeOutOfBoundsMsg
7460#    j exitError
7464:nullPtrException:
7464#    la $a0,nullPtrExceptionMsg
7468#    j exitError
7472:badIntegerFormat:
7472#    la $a0,badIntegerFormatMsg
7476#    j exitError
7480:castException:
7480#    la $a0,castExceptionMsg
7484#    j exitError
############## data section ################
    .data
8084:hexChars:
    .ascii "0123456789abcdef"
    .align 2
8100:cur_seg:
    .word 0

8104:lastCharRead:
    .word -2 # -2 => no buffered character
8108:prevHashConstant:
    .word 0x2785173c
8112:gcCount:
    .word 0

8116:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
8143:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
8166:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
8201:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
8235:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
8268:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
8299:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
8347:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
8368:gcMsg: 
      .asciiz "\nGC!\n"
8374:gcCountMsg: 
      .asciiz "Number of garbage collections: "

8406:nullStr:
    .asciiz "null"
8411:trueString:
    .asciiz "true"
8416:falseString:
    .asciiz "false"
8422:exitString:
    .ascii "Program execution completed."
    #### "falls through" here
8450:newlineString:
    .asciiz "\n"
    
    .align 2
8452:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

8456:seg0_start:
    .space 0x100000
1057032:seg0_end:
1057032:seg1_start:
    .space 0x100000
2105608:seg1_end:
