##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
6748:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
6748#    lw $t0,-8($s2) # get word with hash bits from this
6752#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
6756#    addu $t0,$t1

6760#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
6764:mth_equals_Object:
6764#    move $t0,$s2 # first pointer (this)
6768#    lw $t1,($sp) # second pointer
6772#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
6773##...subu $at,$t0,$t1
6777##...sltiu $t0,$at,1

6780#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
6784:mth_hashCode_String:
6784#    move $t0,$s2 # put this pointer in t0

6788#    li $t2,0 # current hash value
6792#    lw $t1,-4($t0) # negative of number of characters in string
6796#    beq $t1,$zero,done_hashCode_String # if zero length => done
6800#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
6804#    and $t0,0xfffffffc # adjust for padding
6805##...lui $at,65535
6809##...ori $at,$at,0xfffc
6813##...and $t0,$t0,$at
6816#    subu $t1,$t0,$t1 # address at end of string +12
6820:loop_hashCode_String:    
6820#    sll $t4,$t2,5 # multiply by 32
6824#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
6828#    lbu $t3,-12($t0) # current character
6832#    addu $t2,$t3 # add in current character
6836#    addu $t0,1 # go to next character's address
6840#    bne $t0,$t1,loop_hashCode_String # loop back if more
6844:done_hashCode_String:    

    # push int on stack
6844#    move $t0, $t2 # put $t2 in return slot
6848#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
6852:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
6852#    subu $sp,4
6856#    sw $ra,($sp)
    
    # get hash value
6860#    lw $t2,-12($s2) # vtable address
6864#    lw $t0,($t2) # method address
6868#    jalr $t0
6872#    subu $sp,8 # push result (int in $t0) on stack
6876#    sw $s5,4($sp)
6880#    sw $t0,($sp)

    # compute print-size of hash value
6884#    li $t0, 1
6888#    lw $t1, ($sp)
6892#    srl $t1,$t1,4
6896#    beq $t1,$zero,toString_skip_loop
6900:toString_loop_top:
6900#    addu $t0,1
6904#    srl $t1,$t1,4
6908#    bne $t1,$zero,toString_loop_top
6912:toString_skip_loop:
6912#    subu $sp,8
6916#    sw $s5,4($sp)
6920#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
6924#    lw $t2,-12($s2) # vtable address
6928#    move $t0,$t2
6932:toString_checkTagBit:
6932#    subu $t0,1
6936#    lb $t1,($t0)
6940#    and $t1,0x80
6941##...lui $at,0
6945##...ori $at,$at,0x80
6949##...and $t1,$t1,$at
6952#    beq $t1,$zero,toString_checkTagBit
6956#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
6960#    subu $sp,8
6964#    sw $t1,($sp)
6968#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
6972#    move $s7,$zero # -4 offset header word
6976#    lw $t4,8($sp) # bytes for hash value
6980#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
6984#    addu $t4,8
6988#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
6992#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

6996#    li $t0,CLASS_String # store string vtable address into ...
7000#    sw $t0,-12($s7) # ... -12 offset in object header
7004#    lw $t2,-12($s2) # our object's vtable address
7008#    lw $t5,4($sp) # number characters in prefix
7012#    lw $t1,12($sp) # number of characters in hashcode
7016#    addu $t3,$t1,$t5 # number of characters in string ...
7020#    addu $t3,1 # ... including the '@' character
7024#    subu $t0,$zero,$t3 # store negated length into ...
7028#    sw $t0,-4($s7) # ... -4 offset header word
7032#    lw $t0,-8($s7) # get -8 offset header-word
7036#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
7037##...slt $at,$t0,$zero
7041##...beq $at,$zero,7060
7044#    and $t0,0xff # mask off object's hash value ...
7045##...lui $at,0
7049##...ori $at,$at,0xff
7053##...and $t0,$t0,$at
7056#    sw $t0,-8($s7) # ... and store back into -8 header-word
7060:skipMask_toString:
7060#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
7064#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
7068#    subu $t4,$t2,$t5
7072:toString_copyLoop:    
7072#    lb $t3,($t4)
7076#    and $t3,0x7f # mask off sign bit (in case first word)
7077##...lui $at,0
7081##...ori $at,$at,0x7f
7085##...and $t3,$t3,$at
7088#    sb $t3,-8($t0)
7092#    addu $t4,1
7096#    addu $t0,1
7100#    blt $t4,$t2,toString_copyLoop
7101##...slt $at,$t4,$t2
7105##...bne $at,$zero,7072

    # copy the '@' sign
7108#    li $t3,'@'
7112#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
7116#    addu $t2,$t0,$t1 # address of last byte in string to store +8
7120#    lw $t3,20($sp) # hash code to print
7124:toString_hashCopyLoop:
7124#    and $t4,$t3,0xf
7128#    srl $t3,4
7132#    lb $t4,hexChars($t4)
7136#    sb $t4,-8($t2)
7140#    subu $t2,$t2,1
7144#    bgt $t2,$t0,toString_hashCopyLoop
7145##...slt $at,$t0,$t2
7149##...bne $at,$zero,7124

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
7152#    addu $sp,28
7156#    lw $ra,($sp)
7160#    addu $sp,4
7164#    move $t0, $s7 # return string we created
7168#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
7172:mth_equals_String:
    
    # quick test for obvious false
7172#    lw $t0,($sp) # second parameter
7176#    beq $t0,$zero,goEsFalse # go return false if null
7180#    lw $t1,-12($t0) # vtable pointer
7184#    la $t2,CLASS_String # string vtable pointer
7188#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
7192#    subu $sp,12
7196#    sw $ra,8($sp)
7200#    sw $s2,4($sp)
7204#    sw $t0,($sp)
7208#    jal mth_compareTo_String
7212#    lw $s2, 4($sp) #restore this pointer and pop parameters
7216#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
7220#    seq $t0,$t0,$zero
7221##...subu $at,$t0,$zero
7225##...sltiu $t0,$at,1

    # pop return address and return $t0
7228#    lw $ra,($sp)
7232#    addu $sp,4

7236#    jr $ra # return
    
7240:goEsFalse:
    # put 0 in $t0 and return
7240#    li $t0, 0
7244#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
7248:mth_toString_String:
    #we are a string, so return this.
7248#    move $t0, $s2
7252#    jr $ra

###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
7256:mth_readLine_Lib:
    
7256#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
7260#    sw $ra, 4($sp) # save $ra
