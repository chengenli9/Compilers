3605##...sltu $at,$t0,$sp
3609##...beq $at,$zero,3420

    ###### end outer loop to copy all stack-direct objects ######

    #############################################################
    # We have finished processing the stack elements.  Now we need
    # to update elements in the heap itself. This may itself involve
    # moving additional objects
    #############################################################

    #########################################################
    # At this point:
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # We want to set things up so that in addition:
    # - $t0 is the "trailing finger", containing the address
    #   of the first slot in target space that we have yet
    #   to process.
    # Then during processing:
    # - $t1 will contain the contents of the heap slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # And when we're actually copying an object:
    # - $t2 will contain pointer to the target object
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - available for use: $s0
    ##########################################################

    # set $t0 to be at the beginning of target-space
3612#    lw $t1,cur_seg
3616#    la $t0,seg0_start
3620#    beq $t1,$zero,gcSkip4
3624#    la $t0,seg1_start
3625##...lui $t0,16
3629##...addiu $t0,$t0,4808


3632:  gcSkip4:

    # if there were no objects put into the heap during stack
    # processing, we're done, so go finish up
3632#    bgeu $t0,$s3,gcFinishUp
3633##...sltu $at,$t0,$s3
3637##...beq $at,$zero,3928

    ###### begin outer loop to copy all non-stack-direct objects ######

3640:  gcHeapCopyLoop:
    # get data count for object; swap header-word with first word
    # of object so that they're back in the right place
3640#    lw $t1,($t0) # (what will be) first header word for current object
3644#    move $t2,$t1 # number data bytes in object (poss. w/hash bits)
3648#    bge $t2,$zero,gcSkip4a # are there hash bits?
3649##...slt $at,$t2,$zero
3653##...beq $at,$zero,3668
3656#    and $t2,0xff # mask off hash bits
3657##...lui $at,0
3661##...ori $at,$at,0xff
3665##...and $t2,$t2,$at
3668:gcSkip4a:    
3668#    sll $t2,$t2,2 # # data bytes
3672#    addu $t2,$t2,8 # to skip header words
3676#    addu $t2,$t0,$t2 # pointer to new object
3680#    lw $t3,-8($t2) # word to swap
3684#    sw $t1,-8($t2) # store header word
3688#    sw $t3,($t0) # restore first word of object

    ################################################
    # at this point:
    # - $t2 contains the pointer to our new object
    ################################################

    # check if we have a data array
3692#    lw $t1,-12($t2) # vtable pointer
3696#    li $t0,dataArrayVTableStart # address of vtable for first data array
3700#    blt $t1,$t0,gcNotDataArray # if data array, no more xforming to do
3701##...slt $at,$t1,$t0
3705##...bne $at,$zero,3724

    # We have a vtable address that is a data array.
    # we need skip over it then loop back to do next object.
3708:  skipToNextObj:
3708#    lw $t1,-4($t2) # data words in (object position of) array
    #### note: we know that it's not a string, so the value will
    #### not be artificially negative
3712#    sll $t1,$t1,2 # convert to byte-count
3716#    addu $t0,$t2,$t1 # skip over object
3720#    j gcTestIterDone2 # go do next object, if any

    ###################################################
    # at this point:
    # - the object has been restored to normal status--that is, the
    #   word-swap has been done
    # - $t2 contains a pointer to the object
    ###################################################
    
3724:  gcNotDataArray:
3724#    lw $t3,-4($t2) # # object words (negative treated as zero)
3728#    bge $t3,$zero,gcH2Neg2
3729##...slt $at,$t3,$zero
3733##...beq $at,$zero,3740
3736#    move $t3,$zero
3740:  gcH2Neg2:
3740#    sll $t3,$t3,2 # # object bytes
3744#    move $t0,$t2 # address of first pointer in object
3748#    add $s1,$t2,$t3 # limit address for this object

    #####################################################
    # At this point, we have to "translate" all pointers,
    # starting at $t0 to (but not including) $s1
    #####################################################

    # if there are no pointer-slots (i.e., $t0=$s1), skip this
    # part
3752#    beq $t0,$s1,gcTestIterDone2
    
3756:  gcNextPointerInObject:
    # get pointer from object
3756#    lw $t1,($t0)

    # if value is out of range, and is therefore does not refer
    # to an object, just go loop back and do the next one
3760#    bleu $t1,$t6,gcGoNextPointerSlot
3761##...sltu $at,$t6,$t1
3765##...beq $at,$zero,3908
3768#    bgtu $t1,$t7,gcGoNextPointerSlot
3769##...sltu $at,$t7,$t1
3773##...bne $at,$zero,3908

    # if the object has already been moved, update the stack-value
    # via the forwarding pointer
3776#    lw $t8,-8($t1) # possible forwarding tag
3780#    bne $t8,$zero,gcNoForward2 # if not forwarding tag, go copy
3784#    lw $t8,-4($t1) # forwarding pointer: object's new address
3788#    sw $t8,($t0) # update pointer in object
3792#    j gcGoNextPointerSlot # do next iteration

3796:  gcNoForward2:
    #########################################################
    # we actually need to copy the object into the new space
    #########################################################

    #########################################################
    # At this point:
    # - $t0 contains the address of the heap-slot we're translating
    # - $t1 will contain the contents of the heap-slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space, which will also be the first address
    #   of the target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # Then during processing:
    # And when we're actually copying an object:
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $t8 will contain a pointer to the target object
    # - available for use: $s0, $t8, $t9
    ##########################################################

    # compute the amount of space that is needed
3796#    bge $t8,$zero,gcSkip5 # # words in negative-offset portion
3797##...slt $at,$t8,$zero
3801##...beq $at,$zero,3816
3804#    and $t8,0xff # mask off hash bits
3805##...lui $at,0
3809##...ori $at,$at,0xff
3813##...and $t8,$t8,$at

3816:  gcSkip5:
3816#    sll $t8,$t8,2 # bytes in negative-offset portion ...
3820#    addu $t8,$t8,8 # ... add in bytes for header-words
3824#    subu $t4,$t1,$t8 # address of first word of source object
3828#    lw $t3,-4($t1) # # words in positive-offset portion
3832#    bge $t3,$zero,gcNoNeg
3833##...slt $at,$t3,$zero
3837##...beq $at,$zero,3844
3840#    move $t3,$zero # negative treated as zero
3844:  gcNoNeg:
3844#    sll $t3,$t3,2 # bytes in negative-offset portion
3848#    addu $t3,$t3,$t1 # address one word past last word of source

3852#    addu $t8,$s3,$t8 # pointer to target object

    #########################################################
    # At this point:
    # - $t0 contains the address of the stack slot we'll
    #   process next
    # - $t1 contains the contents of the stack slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $t8 contains the pointer to the target object
    # - $s1 contains the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0, $t9
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger"
3856#    lw $s0,($t4)
3860#    lw $t9,-8($t1)
3864#    sw $t9,($t4)
3868#    sw $s0,-8($t1)

    # copy all source bytes to the target
3872:  gCinnerCopy2:
3872#    lw $s0,($t4)
3876#    sw $s0,($s3)
3880#    addu $t4,$t4,4
3884#    addu $s3,$s3,4
3888#    bltu $t4,$t3,gCinnerCopy2
3889##...sltu $at,$t4,$t3
3893##...bne $at,$zero,3872

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
3896#    sw $zero,-8($t1) # 0 in first header-slot
3900#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
3904#    sw $t8,($t0)

3908:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
3908#    addu $t0,$t0,4
3912#    bltu $t0,$s1,gcNextPointerInObject
3913##...sltu $at,$t0,$s1
3917##...bne $at,$zero,3756

3920:  gcTestIterDone2:
3920#    bltu $t0,$s3,gcHeapCopyLoop
3921##...sltu $at,$t0,$s3
3925##...bne $at,$zero,3640

    ###### end outer loop to copy all non-stack-direct objects ######

3928:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
3928#    lw $s2,($sp)
3932#    addu $sp,$sp,4

    # mark us as having already GC'd
3936#    move $t5,$s5

    # go try and allocate again
3940#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
3944:vm_init:

    # mark bottom of stack
3944#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
3948#    move $s2,$zero

    #set up the "five" register
3952#    li $s5,5

3956#    la $s3,seg0_start
3960#    la $s4,seg0_end
3961##...lui $s4,16
3965##...addiu $s4,$s4,4808
    
    # return
3968#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3972:divide:
    # get parameters; abort if divisor zero
3972#    lw $t0,($sp)
3976#    lw $t1,8($sp)
3980#    beq $t0,$zero,divByZeroError
    
    # perform division
3984#    div $t1,$t0
3988#    mflo $t0

    # store result, adjust stack and return
3992#    addu $sp,$sp,8 # adjust stack
3996#    sw $t0,($sp) # store result
4000#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4004:remainder:
    # get parameters; abort if divisor zero
4004#    lw $t0,($sp)
4008#    lw $t1,8($sp)
4012#    beq $t0,$zero,divByZeroError
    
    # perform division
4016#    div $t1,$t0
4020#    mfhi $t0

    # store result, adjust stack and return
4024#    addu $sp,$sp,8 # adjust stack
4028#    sw $t0,($sp) # store result
4032#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
4036:checkCast:
    # get object, allow immediately if null
4036#    lw $t2,($sp)
4040#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
4044#    lw $t2,-12($t2) # vtable address
4048#    bge $t2,$t1,castException
4049##...slt $at,$t2,$t1
4053##...beq $at,$zero,4188
4056#    blt $t2,$t0,castException
4057##...slt $at,$t2,$t0
4061##...bne $at,$zero,4188
    
    # return, leaving object unchanged on stack
4064:  checkCastReturn:    
4064#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
4068:instanceOf:
    # get object, go return false if null
4068#    lw $t2,($sp)
4072#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
4076#    lw $t2,-12($t2) # vtable address
4080#    sge $t0,$t2,$t0 # are we >= the lower limit?
4081##...slt $t0,$t2,$t0
4085##...xori $t0,$t0,0x1
4088#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
4092#    and $t2,$t0,$t1
4096#    sw $t2,($sp)
4100:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
4100#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

4104:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
4104#    li $v0,4 # syscall-code for print-string
4108#    syscall
4112:exit:
    # print termination message
4112#    li $v0,4 # syscall-code for print-string
4116#    la $a0,exitString
4120#    syscall

    # terminate execution
4124#    li $v0,10 #syscall-code for "exit"
4128#    syscall

4132:outOfHeapMemory:
4132#    la $a0,heapMemoryMsg
4136#    j exitError
4140:divByZeroError:
4140#    la $a0,divByZeroMsg
4144#    j exitError
4148:strIndexOutOfBounds:
4148#    la $a0,strIndexOutOfBoundsMsg
4152#    j exitError
4156:arrayIndexOutOfBounds:
4156#    la $a0,arrayIndexOutOfBoundsMsg
4160#    j exitError
4164:arraySizeOutOfBounds:
4164#    la $a0,arraySizeOutOfBoundsMsg
4168#    j exitError
4172:nullPtrException:
4172#    la $a0,nullPtrExceptionMsg
4176#    j exitError
4180:badIntegerFormat:
4180#    la $a0,badIntegerFormatMsg
4184#    j exitError
4188:castException:
4188#    la $a0,castExceptionMsg
4192#    j exitError
############## data section ################
    .data
4444:hexChars:
    .ascii "0123456789abcdef"
    .align 2
4460:cur_seg:
    .word 0

4464:lastCharRead:
    .word -2 # -2 => no buffered character
4468:prevHashConstant:
    .word 0x2785173c
4472:gcCount:
    .word 0

4476:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
4503:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
4526:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
4561:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
4595:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
4628:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
4659:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
4707:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
4728:gcMsg: 
      .asciiz "\nGC!\n"
4734:gcCountMsg: 
      .asciiz "Number of garbage collections: "

4766:nullStr:
    .asciiz "null"
4771:trueString:
    .asciiz "true"
4776:falseString:
    .asciiz "false"
4782:exitString:
    .ascii "Program terminated."
    #### "falls through" here
4801:newlineString:
    .asciiz "\n"
    
    .align 2
4804:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

4808:seg0_start:
    .space 0x100000
1053384:seg0_end:
1053384:seg1_start:
    .space 0x100000
2101960:seg1_end:
