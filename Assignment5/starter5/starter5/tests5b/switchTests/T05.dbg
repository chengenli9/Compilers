    # save $ra by pushing onto stack
1912#    subu $sp,$sp,4
1916#    sw $ra,($sp)

      # read the character
1920#    jal readLogicalChar

    # restore return address; put value in $t0
    # replacing this-pointer saved return address
1924#    lw $ra,($sp)
1928#    addu $sp, 4
1932#    move $t0, $v0

    # return
1936#    jr $ra
