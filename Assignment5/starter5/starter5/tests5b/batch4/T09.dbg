5836#    sll $t8,$t8,2 # bytes in negative-offset portion ...
5840#    addu $t8,$t8,8 # ... add in bytes for header-words
5844#    subu $t4,$t1,$t8 # address of first word of source object
5848#    lw $t3,-4($t1) # # words in positive-offset portion
5852#    bge $t3,$zero,gcNoNeg
5853##...slt $at,$t3,$zero
5857##...beq $at,$zero,5864
5860#    move $t3,$zero # negative treated as zero
5864:  gcNoNeg:
5864#    sll $t3,$t3,2 # bytes in negative-offset portion
5868#    addu $t3,$t3,$t1 # address one word past last word of source

5872#    addu $t8,$s3,$t8 # pointer to target object

    #########################################################
    # At this point:
    # - $t0 contains the address of the stack slot we'll
    #   process next
    # - $t1 contains the contents of the stack slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $t8 contains the pointer to the target object
    # - $s1 contains the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0, $t9
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger"
5876#    lw $s0,($t4)
5880#    lw $t9,-8($t1)
5884#    sw $t9,($t4)
5888#    sw $s0,-8($t1)

    # copy all source bytes to the target
5892:  gCinnerCopy2:
5892#    lw $s0,($t4)
5896#    sw $s0,($s3)
5900#    addu $t4,$t4,4
5904#    addu $s3,$s3,4
5908#    bltu $t4,$t3,gCinnerCopy2
5909##...sltu $at,$t4,$t3
5913##...bne $at,$zero,5892

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
5916#    sw $zero,-8($t1) # 0 in first header-slot
5920#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
5924#    sw $t8,($t0)

5928:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
5928#    addu $t0,$t0,4
5932#    bltu $t0,$s1,gcNextPointerInObject
5933##...sltu $at,$t0,$s1
5937##...bne $at,$zero,5776

5940:  gcTestIterDone2:
5940#    bltu $t0,$s3,gcHeapCopyLoop
5941##...sltu $at,$t0,$s3
5945##...bne $at,$zero,5660

    ###### end outer loop to copy all non-stack-direct objects ######

5948:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
5948#    lw $s2,($sp)
5952#    addu $sp,$sp,4

    # mark us as having already GC'd
5956#    move $t5,$s5

    # go try and allocate again
5960#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
5964:vm_init:

    # mark bottom of stack
5964#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
5968#    move $s2,$zero

    #set up the "five" register
5972#    li $s5,5

5976#    la $s3,seg0_start
5980#    la $s4,seg0_end
5981##...lui $s4,16
5985##...addiu $s4,$s4,7404
    
    # return
5988#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
5992:divide:
    # get parameters; abort if divisor zero
5992#    lw $t0,($sp)
5996#    lw $t1,8($sp)
6000#    beq $t0,$zero,divByZeroError
    
    # perform division
6004#    div $t1,$t0
6008#    mflo $t0

    # store result, adjust stack and return
6012#    addu $sp,$sp,8 # adjust stack
6016#    sw $t0,($sp) # store result
6020#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
6024:remainder:
    # get parameters; abort if divisor zero
6024#    lw $t0,($sp)
6028#    lw $t1,8($sp)
6032#    beq $t0,$zero,divByZeroError
    
    # perform division
6036#    div $t1,$t0
6040#    mfhi $t0

    # store result, adjust stack and return
6044#    addu $sp,$sp,8 # adjust stack
6048#    sw $t0,($sp) # store result
6052#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
6056:checkCast:
    # get object, allow immediately if null
6056#    lw $t2,($sp)
6060#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
6064#    lw $t2,-12($t2) # vtable address
6068#    bge $t2,$t1,castException
6069##...slt $at,$t2,$t1
6073##...beq $at,$zero,6244
6076#    blt $t2,$t0,castException
6077##...slt $at,$t2,$t0
6081##...bne $at,$zero,6244
    
    # return, leaving object unchanged on stack
6084:  checkCastReturn:    
6084#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
6088:instanceOf:
    # get object, go return false if null
6088#    lw $t2,($sp)
6092#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
6096#    lw $t2,-12($t2) # vtable address
6100#    sge $t0,$t2,$t0 # are we >= the lower limit?
6101##...slt $t0,$t2,$t0
6105##...xori $t0,$t0,0x1
6108#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
6112#    and $t2,$t0,$t1
6116#    sw $t2,($sp)
6120:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
6120#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

6124:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
6124#    li $v0,4 # syscall-code for print-string
6128#    syscall
6132:exit:
    # print termination message
6132#    li $v0,4 # syscall-code for print-string
6136#    la $a0,exitString
6140#    syscall

    # print number of garbage collections
6144#    li $v0,4 # syscall-code for print-string
6148#    la $a0,gcCountMsg
6152#    syscall # print "Number of ..."
6156#    lw $a0,gcCount # number of GC's
6160#    li $v0,1 # code for print-int
6164#    syscall
6168#    li $v0,4 # syscall-code for print-string
6172#    la $a0,newlineString
6176#    syscall # print newline

    # terminate execution
6180#    li $v0,10 #syscall-code for "exit"
6184#    syscall

6188:outOfHeapMemory:
6188#    la $a0,heapMemoryMsg
6192#    j exitError
6196:divByZeroError:
6196#    la $a0,divByZeroMsg
6200#    j exitError
6204:strIndexOutOfBounds:
6204#    la $a0,strIndexOutOfBoundsMsg
6208#    j exitError
6212:arrayIndexOutOfBounds:
6212#    la $a0,arrayIndexOutOfBoundsMsg
6216#    j exitError
6220:arraySizeOutOfBounds:
6220#    la $a0,arraySizeOutOfBoundsMsg
6224#    j exitError
6228:nullPtrException:
6228#    la $a0,nullPtrExceptionMsg
6232#    j exitError
6236:badIntegerFormat:
6236#    la $a0,badIntegerFormatMsg
6240#    j exitError
6244:castException:
6244#    la $a0,castExceptionMsg
6248#    j exitError
############## data section ################
    .data
7032:hexChars:
    .ascii "0123456789abcdef"
    .align 2
7048:cur_seg:
    .word 0

7052:lastCharRead:
    .word -2 # -2 => no buffered character
7056:prevHashConstant:
    .word 0x2785173c
7060:gcCount:
    .word 0

7064:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
7091:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
7114:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
7149:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
7183:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
7216:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
7247:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
7295:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
7316:gcMsg: 
      .asciiz "\nGC!\n"
7322:gcCountMsg: 
      .asciiz "Number of garbage collections: "

7354:nullStr:
    .asciiz "null"
7359:trueString:
    .asciiz "true"
7364:falseString:
    .asciiz "false"
7370:exitString:
    .ascii "Program execution completed."
    #### "falls through" here
7398:newlineString:
    .asciiz "\n"
    
    .align 2
7400:stack_bottom:
    .word 0
