########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
4640:vm_init:

    # mark bottom of stack
4640#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
4644#    move $s2,$zero

    #set up the "five" register
4648#    li $s5,5

4652#    la $s3,seg0_start
4656#    la $s4,seg0_end
4657##...lui $s4,16
4661##...addiu $s4,$s4,5624
    
    # return
4664#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4668:divide:
    # get parameters; abort if divisor zero
4668#    lw $t0,($sp)
4672#    lw $t1,8($sp)
4676#    beq $t0,$zero,divByZeroError
    
    # perform division
4680#    div $t1,$t0
4684#    mflo $t0

    # store result, adjust stack and return
4688#    addu $sp,$sp,8 # adjust stack
4692#    sw $t0,($sp) # store result
4696#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4700:remainder:
    # get parameters; abort if divisor zero
4700#    lw $t0,($sp)
4704#    lw $t1,8($sp)
4708#    beq $t0,$zero,divByZeroError
    
    # perform division
4712#    div $t1,$t0
4716#    mfhi $t0

    # store result, adjust stack and return
4720#    addu $sp,$sp,8 # adjust stack
4724#    sw $t0,($sp) # store result
4728#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
4732:checkCast:
    # get object, allow immediately if null
4732#    lw $t2,($sp)
4736#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
4740#    lw $t2,-12($t2) # vtable address
4744#    bge $t2,$t1,castException
4745##...slt $at,$t2,$t1
4749##...beq $at,$zero,4920
4752#    blt $t2,$t0,castException
4753##...slt $at,$t2,$t0
4757##...bne $at,$zero,4920
    
    # return, leaving object unchanged on stack
4760:  checkCastReturn:    
4760#    jr $ra    
