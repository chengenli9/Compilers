2852#    seq $t0,$t0,$zero
2853##...subu $at,$t0,$zero
2857##...sltiu $t0,$at,1

    # pop return address and return $t0
2860#    lw $ra,($sp)
2864#    addu $sp,4

2868#    jr $ra # return
    
2872:goEsFalse:
    # put 0 in $t0 and return
2872#    li $t0, 0
2876#    jr $ra # return
