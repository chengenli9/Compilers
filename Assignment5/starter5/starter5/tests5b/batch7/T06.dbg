3544:  gcSkip5:
3544#    sll $t8,$t8,2 # bytes in negative-offset portion ...
3548#    addu $t8,$t8,8 # ... add in bytes for header-words
3552#    subu $t4,$t1,$t8 # address of first word of source object
3556#    lw $t3,-4($t1) # # words in positive-offset portion
3560#    bge $t3,$zero,gcNoNeg
3561##...slt $at,$t3,$zero
3565##...beq $at,$zero,3572
3568#    move $t3,$zero # negative treated as zero
3572:  gcNoNeg:
3572#    sll $t3,$t3,2 # bytes in negative-offset portion
3576#    addu $t3,$t3,$t1 # address one word past last word of source

3580#    addu $t8,$s3,$t8 # pointer to target object

    #########################################################
    # At this point:
    # - $t0 contains the address of the stack slot we'll
    #   process next
    # - $t1 contains the contents of the stack slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $t8 contains the pointer to the target object
    # - $s1 contains the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0, $t9
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger"
3584#    lw $s0,($t4)
3588#    lw $t9,-8($t1)
3592#    sw $t9,($t4)
3596#    sw $s0,-8($t1)

    # copy all source bytes to the target
3600:  gCinnerCopy2:
3600#    lw $s0,($t4)
3604#    sw $s0,($s3)
3608#    addu $t4,$t4,4
3612#    addu $s3,$s3,4
3616#    bltu $t4,$t3,gCinnerCopy2
3617##...sltu $at,$t4,$t3
3621##...bne $at,$zero,3600

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
3624#    sw $zero,-8($t1) # 0 in first header-slot
3628#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
3632#    sw $t8,($t0)

3636:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
3636#    addu $t0,$t0,4
3640#    bltu $t0,$s1,gcNextPointerInObject
3641##...sltu $at,$t0,$s1
3645##...bne $at,$zero,3484

3648:  gcTestIterDone2:
3648#    bltu $t0,$s3,gcHeapCopyLoop
3649##...sltu $at,$t0,$s3
3653##...bne $at,$zero,3368

    ###### end outer loop to copy all non-stack-direct objects ######

3656:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
3656#    lw $s2,($sp)
3660#    addu $sp,$sp,4

    # mark us as having already GC'd
3664#    move $t5,$s5

    # go try and allocate again
3668#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
3672:vm_init:

    # mark bottom of stack
3672#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
3676#    move $s2,$zero

    #set up the "five" register
3680#    li $s5,5

3684#    la $s3,seg0_start
3688#    la $s4,seg0_end
3689##...lui $s4,16
3693##...addiu $s4,$s4,4508
    
    # return
3696#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3700:divide:
    # get parameters; abort if divisor zero
3700#    lw $t0,($sp)
3704#    lw $t1,8($sp)
3708#    beq $t0,$zero,divByZeroError
    
    # perform division
3712#    div $t1,$t0
3716#    mflo $t0

    # store result, adjust stack and return
3720#    addu $sp,$sp,8 # adjust stack
3724#    sw $t0,($sp) # store result
3728#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3732:remainder:
    # get parameters; abort if divisor zero
3732#    lw $t0,($sp)
3736#    lw $t1,8($sp)
3740#    beq $t0,$zero,divByZeroError
    
    # perform division
3744#    div $t1,$t0
3748#    mfhi $t0

    # store result, adjust stack and return
3752#    addu $sp,$sp,8 # adjust stack
3756#    sw $t0,($sp) # store result
3760#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
3764:checkCast:
    # get object, allow immediately if null
3764#    lw $t2,($sp)
3768#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
3772#    lw $t2,-12($t2) # vtable address
3776#    bge $t2,$t1,castException
3777##...slt $at,$t2,$t1
3781##...beq $at,$zero,3916
3784#    blt $t2,$t0,castException
3785##...slt $at,$t2,$t0
3789##...bne $at,$zero,3916
    
    # return, leaving object unchanged on stack
3792:  checkCastReturn:    
3792#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
3796:instanceOf:
    # get object, go return false if null
3796#    lw $t2,($sp)
3800#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
3804#    lw $t2,-12($t2) # vtable address
3808#    sge $t0,$t2,$t0 # are we >= the lower limit?
3809##...slt $t0,$t2,$t0
3813##...xori $t0,$t0,0x1
3816#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
3820#    and $t2,$t0,$t1
3824#    sw $t2,($sp)
3828:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
3828#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

3832:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
3832#    li $v0,4 # syscall-code for print-string
3836#    syscall
3840:exit:
    # print termination message
3840#    li $v0,4 # syscall-code for print-string
3844#    la $a0,exitString
3848#    syscall

    # terminate execution
3852#    li $v0,10 #syscall-code for "exit"
3856#    syscall

3860:outOfHeapMemory:
3860#    la $a0,heapMemoryMsg
3864#    j exitError
3868:divByZeroError:
3868#    la $a0,divByZeroMsg
3872#    j exitError
3876:strIndexOutOfBounds:
3876#    la $a0,strIndexOutOfBoundsMsg
3880#    j exitError
3884:arrayIndexOutOfBounds:
3884#    la $a0,arrayIndexOutOfBoundsMsg
3888#    j exitError
3892:arraySizeOutOfBounds:
3892#    la $a0,arraySizeOutOfBoundsMsg
3896#    j exitError
3900:nullPtrException:
3900#    la $a0,nullPtrExceptionMsg
3904#    j exitError
3908:badIntegerFormat:
3908#    la $a0,badIntegerFormatMsg
3912#    j exitError
3916:castException:
3916#    la $a0,castExceptionMsg
3920#    j exitError
############## data section ################
    .data
4144:hexChars:
    .ascii "0123456789abcdef"
    .align 2
4160:cur_seg:
    .word 0

4164:lastCharRead:
    .word -2 # -2 => no buffered character
4168:prevHashConstant:
    .word 0x2785173c
4172:gcCount:
    .word 0
