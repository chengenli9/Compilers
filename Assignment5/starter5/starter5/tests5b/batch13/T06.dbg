###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
1400:mth_readLine_Lib:
    
1400#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
1404#    sw $ra, 4($sp) # save $ra
1408#    move $t1,$sp # save "original" sp

1412:  doRead:

    # read the character
1412#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
1416#    subu $t2,$v0,13
1420#    bne $t2,$zero,notReturnRL
1424#    jal readLogicalChar
1428#    subu $t2,$v0,10 # check for newline
1432#    beq $t2,$zero,foundNewLine
1436#    sw $v0,lastCharRead # push back character into queue
1440#    j foundNewLine # go process the line

1444:  notReturnRL:

    # at this point, $v0 has our character

1444#    subu $t0,$v0,10
1448#    beq $t0,$zero,foundNewLine
1452#    blt $v0,$zero,foundEof
1453##...slt $at,$v0,$zero
1457##...bne $at,$zero,1472

    # we have a character, so push it onto stack
1460#    subu $sp,$sp,4
1464#    sw $v0,($sp)

    # loop back up to get next character
1468#    j doRead

1472:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
1472#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
1476#    li $s7, 0 # return-value: null
1480#    j rlReturn # return

1484:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
1484#    subu $t0,$t1,$sp # number of chars we read (times 4)
1488#    srl $s6,$t0,2 # number of words on stack with chars
1492#    subu $sp,$sp,4 # push char-count ...
1496#    sw $s6,($sp) # ... onto stack
1500#    addu $t2,$t0,5 # GC tag, incl. for count-word
1504#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
1508#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
1512#    srl $s6,$s6,2  # data words in object
1516#    move $s7,$zero # object words in object
1520#    jal newObject  # allocate space
    
    # store header words
1524#    la $t0,CLASS_String
1528#    sw $t0,-12($s7)# store class tag (String) into object
1532#    lw $t2,4($sp) # char-count
1536#    sll $t1,$t2,2 # 4 times number of chars
1540#    subu $t2,$zero,$t2 # negative of char-count
1544#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
1548#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
1552#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
1553##...slt $at,$t0,$zero
1557##...beq $at,$zero,1576
1560#    and $t0,0xff # mask off object's hash value ...
1561##...lui $at,0
1565##...ori $at,$at,0xff
1569##...and $t0,$t0,$at
1572#    sw $t0,-8($s7) # ... and store back into -8 header-word
1576:  skipMask_readLine:

1576#    sll $t0,$t0,2 # data bytes in object
1580#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
1584#    subu $t0,$t0,$t2 # place to store last character (plus 9)
1588#    addu $sp,$sp,8 # pop redundant object-pointer and count
1592#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

1596#    beq $sp,$t1,rlReturn
1600:  charCopyLoop:
1600#    lw $t2,($sp)
1604#    sb $t2,-9($t0)
1608#    addu $sp,$sp,4
1612#    subu $t0,$t0,1
1616#    bne $sp,$t1,charCopyLoop
1620:  rlReturn:

1620#    lw $ra, 4($sp)
1624#    addu $sp, 8   # pop $ra and pointless word off stack
1628#    move $t0, $s7 # return string we allocated in $s7
1632#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
1636:mth_readInt_Lib:

    # save $ra by pushing onto stack
1636#    subu $sp,$sp,4
1640#    sw $ra,($sp)

1644:  riSkipWhiteLoop:
    # read a character
1644#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
1648#    subu $t0,$v0,32
1652#    bgt $t0,$zero,nonWhite
1653##...slt $at,$zero,$t0
1657##...bne $at,$zero,1700
1660#    beq $t0,$zero,riSkipWhiteLoop # start over if space
1664#    subu $t0,$v0,10
1668#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
1672#    subu $t0,$v0,9
1676#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
1680#    subu $t0,$v0,13
1684#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
1688#    subu $t0,$v0,12
1692#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
1696#    j badIntegerFormat # illegal integer char: abort program

1700:  nonWhite:
1700#    subu $t0,$v0,'-'
1704#    li $t4,1 # final multiplier
1708#    bne $t0,$zero,helpReadInt # go read
1712#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
1716#    jal readLogicalChar

1720:  helpReadInt:
1720#    li $t2,10
1724#    subu $t1,$v0,'0' # convert digit to 0-9 value
1728#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
1729##...sltu $at,$t1,$t2
1733##...beq $at,$zero,4016
1736#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

1740:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

1740#    jal readLogicalChar # read next character
1744#    subu $t1,$v0,'0' # convert digit to 0-9 value
1748#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
1749##...sltu $at,$t1,$t2
1753##...beq $at,$zero,1772

1756#    mul $t3,$t3,$t2 # multiply old value by 10
1757##...mult $t3,$t2
1761##...mflo $t3
1764#    addu $t3,$t3,$t1 # add in value of new digit
1768#    j digitLoop

1772:  doneDigitLoop:

    # "push back" unused character into queue
1772#    sw $v0,lastCharRead
