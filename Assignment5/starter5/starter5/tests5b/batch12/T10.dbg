########################################################
# str.substring(n, k) - library method (class String)
# takes a substring of a string: Java: str.substring(n, k)
# - parameters after pushing RA:
#   - ($sp) - k: one beyond index of last char in subrange
#   - 4($sp) - GC tag
#   - 8($sp) - n: index of first char in subrange
#   - 12($sp) - GC tag
#   - 16($sp) - old this pointer
# - return value:
#  - $t0 - substring
########################################################
1440:mth_substring_String:

    # save $ra by pushing onto stack
1440#    subu $sp,$sp,4
1444#    sw $ra,($sp)

    # get string from this, we probably don't need the null check.
1448#    move $t0,$s2
1452#    beq $t0,$zero,nullPtrException

    # get both indices and string length, and ensure that
    #   0 <= n <= k <= length
1456#    lw $t0,-4($t0) # negative of string length
1460#    subu $t0,$zero,$t0 # string length
1464#    lw $t1,4($sp) # k
1468#    lw $t2,12($sp) # n
1472#    bgt $zero,$t2,strIndexOutOfBounds
1473##...slt $at,$t2,$zero
1477##...bne $at,$zero,3400
1480#    bgt $t2,$t1,strIndexOutOfBounds
1481##...slt $at,$t1,$t2
1485##...bne $at,$zero,3400
1488#    bgt $t1,$t0,strIndexOutOfBounds
1489##...slt $at,$t0,$t1
1493##...bne $at,$zero,3400

    # allocate memory
1496#    subu $s6,$t1,$t2 # # chars in target-string
1500#    addu $s6,$s6,7 # account for extra "class" (4) word + 3 to round up
1504#    srl $s6,$s6,2 # convert bytes-count to word-count
1508#    move $s7,$zero # (no object-bytes in string)
1512#    jal newObject

    # store "String" tag in object-type field
1516#    la $t0,CLASS_String
1520#    sw $t0,-12($s7)
    
    # mask off hash bits, if needed
1524#    lw $t4,-8($s7) # data words in source string
1528#    bge $t4,$zero,skipMask_substring # don't strip hash code if not there
1529##...slt $at,$t4,$zero
1533##...beq $at,$zero,1552
1536#    and $t4,0xff # mask off object's hash value ...
1537##...lui $at,0
1541##...ori $at,$at,0xff
1545##...and $t4,$t4,$at
1548#    sw $t4,-8($s7) # ... and store back into -8 header-word
1552:skipMask_substring:

    # store negative of count (=n-k) into object-length header-word
    # indicies have changed, because newObject is on stack
1552#    lw $t1,8($sp) # k
1556#    lw $t2,16($sp) # n
1560#    subu $t0,$t2,$t1 # value to store
1564#    sw $t0,-4($s7) # store value
    
1568#    move $t3,$s2 # source string pointer
    
    # skip byte-copy loop if length is zero
1572#    beq $zero,$t0,doneSubCopyzz

    # get pointers set up in preparation for copy
1576#    lw $t4,-8($t3) # data words in source string
1580#    sll $t4,$t4,2 # data bytes in source string (incl. padding)
1584#    subu $t3,$t3,$t4 # addr. of first data word of source string (+8)
1588#    addu $t3,$t3,$t2 # addr. of first source data byte to be copied (+8)
1592#    subu $t1,$t3,$t0 # addr. beyond last source data byte to be copied (+8)
1596#    lw $t2,-8($s7)   # data words in target string
1600#    sll $t2,$t2,2    # data bytes in target string
1604#    subu $t2,$s7,$t2 # addr. of first target data byte (+8)
    
    ############################################
    # at this point:
    # - we know that the string has a positive length
    # - $t3 contains 8 + address of the first source-byte
    # - $t1 contains 8 + limit-address of the first source-byte
    # - $t2 contains 8 + address first target byte
    ############################################

    # copy the bytes from source to target
1608:  subCopyLoopzz:
1608#    lb $t4,-8($t3)
1612#    sb $t4,-8($t2)
1616#    addu $t2,$t2,1
1620#    addu $t3,$t3,1
1624#    blt $t3,$t1,subCopyLoopzz
1625##...slt $at,$t3,$t1
1629##...bne $at,$zero,1608
    
1632:  doneSubCopyzz:
    # restore return address, store return value, pop stack
1632#    lw $ra,4($sp) # restore $ra
1636#    addu $sp,$sp,8 # pop ra, and allocated newObject
1640#    move $t0, $s7 # we're returning the string we got back
                  # from newObject
    
    # return
1644#    jr $ra

########################################################
# length() - library method (class String)
# returns length of a string: Java: str.length()
# - parameters:
#   - ($sp) - old this pointer
# - return-value:
#   - $t0 - length of string
########################################################
1648:mth_length_String:

    # the length is the negative of 4($s2)
1648#    lw $t0,-4($s2) # -length
1652#    subu $t0,$zero,$t0

    # return
1656#    jr $ra


########################################################
# str1.concat(str2) - library method (class String)
# (as in Java)
# - parameters:
#   - ($sp) - the second string
#   - 4($sp) - old this pointer
#   - $s2 - the first string (this)
# - returns:
#   - $t0 - pointer to concatenated string
########################################################
1660:mth_concat_String:
    # save $ra by pushing onto stack
1660#    subu $sp,$sp,4
1664#    sw $ra, ($sp)

    # get string pointers and check parameter for null
1668#    lw $t0,4($sp)
1672#    beq $t0,$zero,nullPtrException
1676#    move $t1,$s2
    
    # get lengths of two strings; allocate object whose size
    # is their sum divided by 4 (rounded up) plus 1
1680#    lw $t0,-4($t0) # negative size of second object
1684#    lw $t1,-4($t1) # negative size of first object
1688#    addu $s6,$t0,$t1 # sum of negative sizes
1692#    sra $s6,$s6,2 # negative word-size of char part
1696#    subu $s6,$zero,$s6 # word size of char part
1700#    addu $s6,$s6,1 # data word size, including v-table word
1704#    move $s7,$zero
