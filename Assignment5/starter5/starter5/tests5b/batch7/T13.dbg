###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
1436:mth_readLine_Lib:
    
1436#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
1440#    sw $ra, 4($sp) # save $ra
1444#    move $t1,$sp # save "original" sp

1448:  doRead:

    # read the character
1448#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
1452#    subu $t2,$v0,13
1456#    bne $t2,$zero,notReturnRL
1460#    jal readLogicalChar
1464#    subu $t2,$v0,10 # check for newline
1468#    beq $t2,$zero,foundNewLine
1472#    sw $v0,lastCharRead # push back character into queue
1476#    j foundNewLine # go process the line

1480:  notReturnRL:

    # at this point, $v0 has our character

1480#    subu $t0,$v0,10
1484#    beq $t0,$zero,foundNewLine
1488#    blt $v0,$zero,foundEof
1489##...slt $at,$v0,$zero
1493##...bne $at,$zero,1508

    # we have a character, so push it onto stack
1496#    subu $sp,$sp,4
1500#    sw $v0,($sp)

    # loop back up to get next character
1504#    j doRead

1508:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
1508#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
1512#    li $s7, 0 # return-value: null
1516#    j rlReturn # return

1520:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
1520#    subu $t0,$t1,$sp # number of chars we read (times 4)
1524#    srl $s6,$t0,2 # number of words on stack with chars
1528#    subu $sp,$sp,4 # push char-count ...
1532#    sw $s6,($sp) # ... onto stack
1536#    addu $t2,$t0,5 # GC tag, incl. for count-word
1540#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
1544#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
1548#    srl $s6,$s6,2  # data words in object
1552#    move $s7,$zero # object words in object
1556#    jal newObject  # allocate space
    
    # store header words
1560#    la $t0,CLASS_String
1564#    sw $t0,-12($s7)# store class tag (String) into object
1568#    lw $t2,4($sp) # char-count
1572#    sll $t1,$t2,2 # 4 times number of chars
1576#    subu $t2,$zero,$t2 # negative of char-count
1580#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
1584#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
1588#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
1589##...slt $at,$t0,$zero
1593##...beq $at,$zero,1612
1596#    and $t0,0xff # mask off object's hash value ...
1597##...lui $at,0
1601##...ori $at,$at,0xff
1605##...and $t0,$t0,$at
1608#    sw $t0,-8($s7) # ... and store back into -8 header-word
1612:  skipMask_readLine:

1612#    sll $t0,$t0,2 # data bytes in object
1616#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
1620#    subu $t0,$t0,$t2 # place to store last character (plus 9)
1624#    addu $sp,$sp,8 # pop redundant object-pointer and count
1628#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

1632#    beq $sp,$t1,rlReturn
1636:  charCopyLoop:
1636#    lw $t2,($sp)
1640#    sb $t2,-9($t0)
1644#    addu $sp,$sp,4
1648#    subu $t0,$t0,1
1652#    bne $sp,$t1,charCopyLoop
1656:  rlReturn:

1656#    lw $ra, 4($sp)
1660#    addu $sp, 8   # pop $ra and pointless word off stack
1664#    move $t0, $s7 # return string we allocated in $s7
1668#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
1672:mth_readInt_Lib:

    # save $ra by pushing onto stack
1672#    subu $sp,$sp,4
1676#    sw $ra,($sp)

1680:  riSkipWhiteLoop:
    # read a character
1680#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
1684#    subu $t0,$v0,32
1688#    bgt $t0,$zero,nonWhite
1689##...slt $at,$zero,$t0
1693##...bne $at,$zero,1736
1696#    beq $t0,$zero,riSkipWhiteLoop # start over if space
1700#    subu $t0,$v0,10
1704#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
1708#    subu $t0,$v0,9
1712#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
1716#    subu $t0,$v0,13
1720#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
1724#    subu $t0,$v0,12
1728#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
1732#    j badIntegerFormat # illegal integer char: abort program

1736:  nonWhite:
1736#    subu $t0,$v0,'-'
1740#    li $t4,1 # final multiplier
1744#    bne $t0,$zero,helpReadInt # go read
1748#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
1752#    jal readLogicalChar

1756:  helpReadInt:
1756#    li $t2,10
1760#    subu $t1,$v0,'0' # convert digit to 0-9 value
1764#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
1765##...sltu $at,$t1,$t2
1769##...beq $at,$zero,4016
1772#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

1776:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

1776#    jal readLogicalChar # read next character
1780#    subu $t1,$v0,'0' # convert digit to 0-9 value
1784#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
1785##...sltu $at,$t1,$t2
1789##...beq $at,$zero,1808

1792#    mul $t3,$t3,$t2 # multiply old value by 10
1793##...mult $t3,$t2
1797##...mflo $t3
1800#    addu $t3,$t3,$t1 # add in value of new digit
1804#    j digitLoop

1808:  doneDigitLoop:

    # "push back" unused character into queue
1808#    sw $v0,lastCharRead

    # restore return address
1812#    lw $ra,($sp)
1816#    addu $sp, 4
