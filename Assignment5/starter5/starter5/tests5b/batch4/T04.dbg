###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1628:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
1628#    lw $t0,-8($s2) # get word with hash bits from this
1632#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
1636#    addu $t0,$t1

1640#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1644:mth_equals_Object:
1644#    move $t0,$s2 # first pointer (this)
1648#    lw $t1,($sp) # second pointer
1652#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
1653##...subu $at,$t0,$t1
1657##...sltiu $t0,$at,1

1660#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1664:mth_hashCode_String:
1664#    move $t0,$s2 # put this pointer in t0

1668#    li $t2,0 # current hash value
1672#    lw $t1,-4($t0) # negative of number of characters in string
1676#    beq $t1,$zero,done_hashCode_String # if zero length => done
1680#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
1684#    and $t0,0xfffffffc # adjust for padding
1685##...lui $at,65535
1689##...ori $at,$at,0xfffc
1693##...and $t0,$t0,$at
1696#    subu $t1,$t0,$t1 # address at end of string +12
1700:loop_hashCode_String:    
1700#    sll $t4,$t2,5 # multiply by 32
1704#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
1708#    lbu $t3,-12($t0) # current character
1712#    addu $t2,$t3 # add in current character
1716#    addu $t0,1 # go to next character's address
1720#    bne $t0,$t1,loop_hashCode_String # loop back if more
1724:done_hashCode_String:    

    # push int on stack
1724#    move $t0, $t2 # put $t2 in return slot
1728#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
1732:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
1732#    subu $sp,4
1736#    sw $ra,($sp)
    
    # get hash value
1740#    lw $t2,-12($s2) # vtable address
1744#    lw $t0,($t2) # method address
1748#    jalr $t0
1752#    subu $sp,8 # push result (int in $t0) on stack
1756#    sw $s5,4($sp)
1760#    sw $t0,($sp)

    # compute print-size of hash value
1764#    li $t0, 1
1768#    lw $t1, ($sp)
1772#    srl $t1,$t1,4
1776#    beq $t1,$zero,toString_skip_loop
1780:toString_loop_top:
1780#    addu $t0,1
1784#    srl $t1,$t1,4
1788#    bne $t1,$zero,toString_loop_top
1792:toString_skip_loop:
1792#    subu $sp,8
1796#    sw $s5,4($sp)
1800#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
1804#    lw $t2,-12($s2) # vtable address
1808#    move $t0,$t2
1812:toString_checkTagBit:
1812#    subu $t0,1
1816#    lb $t1,($t0)
1820#    and $t1,0x80
1821##...lui $at,0
1825##...ori $at,$at,0x80
1829##...and $t1,$t1,$at
1832#    beq $t1,$zero,toString_checkTagBit
1836#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
1840#    subu $sp,8
1844#    sw $t1,($sp)
1848#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
1852#    move $s7,$zero # -4 offset header word
1856#    lw $t4,8($sp) # bytes for hash value
1860#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
1864#    addu $t4,8
1868#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
1872#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

1876#    li $t0,CLASS_String # store string vtable address into ...
1880#    sw $t0,-12($s7) # ... -12 offset in object header
1884#    lw $t2,-12($s2) # our object's vtable address
1888#    lw $t5,4($sp) # number characters in prefix
1892#    lw $t1,12($sp) # number of characters in hashcode
1896#    addu $t3,$t1,$t5 # number of characters in string ...
1900#    addu $t3,1 # ... including the '@' character
1904#    subu $t0,$zero,$t3 # store negated length into ...
1908#    sw $t0,-4($s7) # ... -4 offset header word
1912#    lw $t0,-8($s7) # get -8 offset header-word
1916#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
1917##...slt $at,$t0,$zero
1921##...beq $at,$zero,1940
1924#    and $t0,0xff # mask off object's hash value ...
1925##...lui $at,0
1929##...ori $at,$at,0xff
1933##...and $t0,$t0,$at
1936#    sw $t0,-8($s7) # ... and store back into -8 header-word
1940:skipMask_toString:
1940#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
1944#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
1948#    subu $t4,$t2,$t5
1952:toString_copyLoop:    
1952#    lb $t3,($t4)
1956#    and $t3,0x7f # mask off sign bit (in case first word)
1957##...lui $at,0
1961##...ori $at,$at,0x7f
1965##...and $t3,$t3,$at
1968#    sb $t3,-8($t0)
1972#    addu $t4,1
1976#    addu $t0,1
1980#    blt $t4,$t2,toString_copyLoop
1981##...slt $at,$t4,$t2
1985##...bne $at,$zero,1952

    # copy the '@' sign
1988#    li $t3,'@'
1992#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
1996#    addu $t2,$t0,$t1 # address of last byte in string to store +8
2000#    lw $t3,20($sp) # hash code to print
2004:toString_hashCopyLoop:
2004#    and $t4,$t3,0xf
2008#    srl $t3,4
2012#    lb $t4,hexChars($t4)
2016#    sb $t4,-8($t2)
2020#    subu $t2,$t2,1
2024#    bgt $t2,$t0,toString_hashCopyLoop
2025##...slt $at,$t0,$t2
2029##...bne $at,$zero,2004

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
2032#    addu $sp,28
2036#    lw $ra,($sp)
2040#    addu $sp,4
2044#    move $t0, $s7 # return string we created
2048#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
2052:mth_equals_String:
    
    # quick test for obvious false
2052#    lw $t0,($sp) # second parameter
2056#    beq $t0,$zero,goEsFalse # go return false if null
2060#    lw $t1,-12($t0) # vtable pointer
2064#    la $t2,CLASS_String # string vtable pointer
2068#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
2072#    subu $sp,12
2076#    sw $ra,8($sp)
2080#    sw $s2,4($sp)
2084#    sw $t0,($sp)
2088#    jal mth_compareTo_String
2092#    lw $s2, 4($sp) #restore this pointer and pop parameters
2096#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
2100#    seq $t0,$t0,$zero
2101##...subu $at,$t0,$zero
2105##...sltiu $t0,$at,1

    # pop return address and return $t0
2108#    lw $ra,($sp)
2112#    addu $sp,4

2116#    jr $ra # return
    
2120:goEsFalse:
    # put 0 in $t0 and return
2120#    li $t0, 0
2124#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
2128:mth_toString_String:
    #we are a string, so return this.
2128#    move $t0, $s2
2132#    jr $ra

###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
2136:mth_readLine_Lib:
    
2136#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
2140#    sw $ra, 4($sp) # save $ra
2144#    move $t1,$sp # save "original" sp

2148:  doRead:

    # read the character
2148#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
2152#    subu $t2,$v0,13
2156#    bne $t2,$zero,notReturnRL
2160#    jal readLogicalChar
2164#    subu $t2,$v0,10 # check for newline
2168#    beq $t2,$zero,foundNewLine
2172#    sw $v0,lastCharRead # push back character into queue
2176#    j foundNewLine # go process the line

2180:  notReturnRL:

    # at this point, $v0 has our character

2180#    subu $t0,$v0,10
2184#    beq $t0,$zero,foundNewLine
2188#    blt $v0,$zero,foundEof
2189##...slt $at,$v0,$zero
2193##...bne $at,$zero,2208

    # we have a character, so push it onto stack
2196#    subu $sp,$sp,4
2200#    sw $v0,($sp)

    # loop back up to get next character
2204#    j doRead

2208:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
2208#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
2212#    li $s7, 0 # return-value: null
2216#    j rlReturn # return

2220:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
2220#    subu $t0,$t1,$sp # number of chars we read (times 4)
2224#    srl $s6,$t0,2 # number of words on stack with chars
2228#    subu $sp,$sp,4 # push char-count ...
2232#    sw $s6,($sp) # ... onto stack
2236#    addu $t2,$t0,5 # GC tag, incl. for count-word
2240#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
2244#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
2248#    srl $s6,$s6,2  # data words in object
2252#    move $s7,$zero # object words in object
2256#    jal newObject  # allocate space
    
    # store header words
2260#    la $t0,CLASS_String
2264#    sw $t0,-12($s7)# store class tag (String) into object
2268#    lw $t2,4($sp) # char-count
2272#    sll $t1,$t2,2 # 4 times number of chars
2276#    subu $t2,$zero,$t2 # negative of char-count
