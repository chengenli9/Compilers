4549##...slt $at,$t0,$t2
4553##...bne $at,$zero,4528

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
4556#    addu $sp,28
4560#    lw $ra,($sp)
4564#    addu $sp,4
4568#    move $t0, $s7 # return string we created
4572#    jr $ra
