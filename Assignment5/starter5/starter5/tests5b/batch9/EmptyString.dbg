########################################################
# readLogicalChar (millicode)
#  - logically reads a character from standard input
#  - first checks character buffer, consuming it if possible
#  - return-result:
#    - returns character in $v0
#  - side-effects:
#    - reads a character
#    - clobbers $t0
########################################################
6432:readLogicalChar:

    # check if we already have a character
6432#    lw $v0,lastCharRead
6436#    li $t0,-2
6440#    beq $t0,$v0 doReadCh

    # we have our character from the buffer. Wipe out
    # buffer and return
6444#    sw $t0,lastCharRead # store -2 into buffer (i.e. "empty")
6448#    jr $ra # return
    
6452:  doReadCh:
    # we need to actually read a character: read and return
6452#    li $v0,12 # use system call to read a character
6456#    syscall
6460#    jr $ra # return
