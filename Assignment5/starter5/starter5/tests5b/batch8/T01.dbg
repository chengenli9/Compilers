2804#    lw $t0,($sp) # second parameter
2808#    beq $t0,$zero,goEsFalse # go return false if null
2812#    lw $t1,-12($t0) # vtable pointer
2816#    la $t2,CLASS_String # string vtable pointer
2820#    bne $t1,$t2,goEsFalse # go return false if not a string

