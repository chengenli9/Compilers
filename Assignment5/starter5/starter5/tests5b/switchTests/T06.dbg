    # therefore does not refer to an object on the heap, just go
    # loop back and do the next one
3544#    bleu $t1,$t6,gcTestIterDone1
3545##...sltu $at,$t6,$t1
3549##...beq $at,$zero,3712
3552#    bgtu $t1,$t7,gcTestIterDone1
3553##...sltu $at,$t7,$t1
3557##...bne $at,$zero,3712

    # if the object has already been moved, update the stack-value
    # via the forwarding pointer
3560#    lw $t2,-8($t1) # possible forwarding tag
3564#    bne $t2,$zero,gcNoForward1 # if not forwarding tag, go copy
3568#    lw $t2,-4($t1) # forwarding pointer: object's new address
3572#    sw $t2,4($t0) # update stack value
3576#    j gcTestIterDone1 # do next iteration

3580:  gcNoForward1:
    #########################################################
    # we actually need to copy the object into the new space
    #########################################################

    # compute the amount of space that is needed
3580#    bge $t2,$zero,gcSkip2
3581##...slt $at,$t2,$zero
3585##...beq $at,$zero,3600
3588#    and $t2,0xff #### mask off hash value
3589##...lui $at,0
3593##...ori $at,$at,0xff
3597##...and $t2,$t2,$at
    #### OLD
    #### subu $t2,$zero,$t2 # set to 1 if -1 (number of data words)

3600:  gcSkip2:
3600#    sll $t2,$t2,2
3604#    addu $t2,$t2,8
3608#    subu $t4,$t1,$t2 # address of first word of source
3612#    lw $t3,-4($t1) # number of object words (negative means zero)
3616#    bge $t3,$zero,gcH2Neg1
3617##...slt $at,$t3,$zero
3621##...beq $at,$zero,3628
3624#    move $t3,$zero
3628:  gcH2Neg1:
3628#    sll $t3,$t3,2
3632#    addu $t3,$t3,$t1 # address one word past last word of source

3636#    addu $t2,$s3,$t2 # pointer to target object

    #########################################################
    # At this point:
    # - $t0 contains the address of the stack slot we'll
    #   process next
    # - $t1 contains the contents of the stack slot we're
    #   currently working on, which is a pointer to the source
    #   object (i.e., the address just beyond the object's header)
    # - $t2 contains the pointer to the target object
    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0-2
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger" in the target space
3640#    lw $s0,($t4)
3644#    lw $s1,-8($t1)
3648#    sw $s1,($t4)
3652#    sw $s0,-8($t1)
    
    # copy all source bytes to the target
3656:  gCinnerCopy1:
3656#    lw $s0,($t4)
3660#    sw $s0,($s3)
3664#    addu $t4,$t4,4
3668#    addu $s3,$s3,4
3672#    bltu $t4,$t3,gCinnerCopy1
3673##...sltu $at,$t4,$t3
3677##...bne $at,$zero,3656

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
3680#    sw $zero,-8($t1) # 0 in first header-slot
3684#    sw $t2,-4($t1) # forwarding pointer in second header-slot

    # update the stack slot with the address in the target space
3688#    sw $t2,4($t0)
3692#    lw $zero,-8($t2)
3696#    lw $zero,-4($t2)

    # go handle next stack slot (testing if done)
3700#    j gcTestIterDone1

3704:  gcBump:
    #### we have a GC tag.  Bytes to skip: tag value + 3.
3704#    subu $t0,$t0,$t1
3708#    subu $t0,$t0,3

3712:  gcTestIterDone1:
3712#    bgeu $t0,$sp,gcStackCopyLoop
3713##...sltu $at,$t0,$sp
3717##...beq $at,$zero,3528

    ###### end outer loop to copy all stack-direct objects ######

    #############################################################
    # We have finished processing the stack elements.  Now we need
    # to update elements in the heap itself. This may itself involve
    # moving additional objects
    #############################################################

    #########################################################
    # At this point:
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # We want to set things up so that in addition:
    # - $t0 is the "trailing finger", containing the address
    #   of the first slot in target space that we have yet
    #   to process.
    # Then during processing:
    # - $t1 will contain the contents of the heap slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # And when we're actually copying an object:
    # - $t2 will contain pointer to the target object
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - available for use: $s0
    ##########################################################

    # set $t0 to be at the beginning of target-space
3720#    lw $t1,cur_seg
3724#    la $t0,seg0_start
3728#    beq $t1,$zero,gcSkip4
3732#    la $t0,seg1_start
3733##...lui $t0,16
3737##...addiu $t0,$t0,5060


3740:  gcSkip4:

    # if there were no objects put into the heap during stack
    # processing, we're done, so go finish up
3740#    bgeu $t0,$s3,gcFinishUp
3741##...sltu $at,$t0,$s3
3745##...beq $at,$zero,4036

    ###### begin outer loop to copy all non-stack-direct objects ######

3748:  gcHeapCopyLoop:
    # get data count for object; swap header-word with first word
    # of object so that they're back in the right place
3748#    lw $t1,($t0) # (what will be) first header word for current object
3752#    move $t2,$t1 # number data bytes in object (poss. w/hash bits)
3756#    bge $t2,$zero,gcSkip4a # are there hash bits?
3757##...slt $at,$t2,$zero
3761##...beq $at,$zero,3776
3764#    and $t2,0xff # mask off hash bits
3765##...lui $at,0
3769##...ori $at,$at,0xff
3773##...and $t2,$t2,$at
3776:gcSkip4a:    
3776#    sll $t2,$t2,2 # # data bytes
3780#    addu $t2,$t2,8 # to skip header words
3784#    addu $t2,$t0,$t2 # pointer to new object
3788#    lw $t3,-8($t2) # word to swap
3792#    sw $t1,-8($t2) # store header word
3796#    sw $t3,($t0) # restore first word of object

    ################################################
    # at this point:
    # - $t2 contains the pointer to our new object
    ################################################

    # check if we have a data array
3800#    lw $t1,-12($t2) # vtable pointer
3804#    li $t0,dataArrayVTableStart # address of vtable for first data array
3808#    blt $t1,$t0,gcNotDataArray # if data array, no more xforming to do
3809##...slt $at,$t1,$t0
3813##...bne $at,$zero,3832

    # We have a vtable address that is a data array.
    # we need skip over it then loop back to do next object.
3816:  skipToNextObj:
3816#    lw $t1,-4($t2) # data words in (object position of) array
    #### note: we know that it's not a string, so the value will
    #### not be artificially negative
3820#    sll $t1,$t1,2 # convert to byte-count
3824#    addu $t0,$t2,$t1 # skip over object
3828#    j gcTestIterDone2 # go do next object, if any

    ###################################################
    # at this point:
    # - the object has been restored to normal status--that is, the
    #   word-swap has been done
    # - $t2 contains a pointer to the object
    ###################################################
    
3832:  gcNotDataArray:
3832#    lw $t3,-4($t2) # # object words (negative treated as zero)
3836#    bge $t3,$zero,gcH2Neg2
3837##...slt $at,$t3,$zero
3841##...beq $at,$zero,3848
3844#    move $t3,$zero
3848:  gcH2Neg2:
3848#    sll $t3,$t3,2 # # object bytes
3852#    move $t0,$t2 # address of first pointer in object
3856#    add $s1,$t2,$t3 # limit address for this object

    #####################################################
    # At this point, we have to "translate" all pointers,
    # starting at $t0 to (but not including) $s1
    #####################################################

    # if there are no pointer-slots (i.e., $t0=$s1), skip this
    # part
3860#    beq $t0,$s1,gcTestIterDone2
    
3864:  gcNextPointerInObject:
    # get pointer from object
3864#    lw $t1,($t0)

    # if value is out of range, and is therefore does not refer
    # to an object, just go loop back and do the next one
3868#    bleu $t1,$t6,gcGoNextPointerSlot
3869##...sltu $at,$t6,$t1
3873##...beq $at,$zero,4016
3876#    bgtu $t1,$t7,gcGoNextPointerSlot
3877##...sltu $at,$t7,$t1
3881##...bne $at,$zero,4016

    # if the object has already been moved, update the stack-value
    # via the forwarding pointer
3884#    lw $t8,-8($t1) # possible forwarding tag
3888#    bne $t8,$zero,gcNoForward2 # if not forwarding tag, go copy
3892#    lw $t8,-4($t1) # forwarding pointer: object's new address
3896#    sw $t8,($t0) # update pointer in object
3900#    j gcGoNextPointerSlot # do next iteration

3904:  gcNoForward2:
    #########################################################
    # we actually need to copy the object into the new space
    #########################################################

    #########################################################
    # At this point:
    # - $t0 contains the address of the heap-slot we're translating
    # - $t1 will contain the contents of the heap-slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space, which will also be the first address
    #   of the target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # Then during processing:
    # And when we're actually copying an object:
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $t8 will contain a pointer to the target object
    # - available for use: $s0, $t8, $t9
    ##########################################################

    # compute the amount of space that is needed
3904#    bge $t8,$zero,gcSkip5 # # words in negative-offset portion
3905##...slt $at,$t8,$zero
3909##...beq $at,$zero,3924
3912#    and $t8,0xff # mask off hash bits
3913##...lui $at,0
3917##...ori $at,$at,0xff
3921##...and $t8,$t8,$at

3924:  gcSkip5:
3924#    sll $t8,$t8,2 # bytes in negative-offset portion ...
3928#    addu $t8,$t8,8 # ... add in bytes for header-words
3932#    subu $t4,$t1,$t8 # address of first word of source object
3936#    lw $t3,-4($t1) # # words in positive-offset portion
3940#    bge $t3,$zero,gcNoNeg
3941##...slt $at,$t3,$zero
3945##...beq $at,$zero,3952
3948#    move $t3,$zero # negative treated as zero
3952:  gcNoNeg:
3952#    sll $t3,$t3,2 # bytes in negative-offset portion
3956#    addu $t3,$t3,$t1 # address one word past last word of source

3960#    addu $t8,$s3,$t8 # pointer to target object

    #########################################################
    # At this point:
    # - $t0 contains the address of the stack slot we'll
    #   process next
    # - $t1 contains the contents of the stack slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $t8 contains the pointer to the target object
    # - $s1 contains the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0, $t9
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger"
3964#    lw $s0,($t4)
3968#    lw $t9,-8($t1)
3972#    sw $t9,($t4)
3976#    sw $s0,-8($t1)

    # copy all source bytes to the target
3980:  gCinnerCopy2:
3980#    lw $s0,($t4)
3984#    sw $s0,($s3)
3988#    addu $t4,$t4,4
3992#    addu $s3,$s3,4
3996#    bltu $t4,$t3,gCinnerCopy2
3997##...sltu $at,$t4,$t3
4001##...bne $at,$zero,3980

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
4004#    sw $zero,-8($t1) # 0 in first header-slot
4008#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
4012#    sw $t8,($t0)

4016:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
4016#    addu $t0,$t0,4
4020#    bltu $t0,$s1,gcNextPointerInObject
4021##...sltu $at,$t0,$s1
4025##...bne $at,$zero,3864

4028:  gcTestIterDone2:
4028#    bltu $t0,$s3,gcHeapCopyLoop
4029##...sltu $at,$t0,$s3
4033##...bne $at,$zero,3748

    ###### end outer loop to copy all non-stack-direct objects ######

4036:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
4036#    lw $s2,($sp)
4040#    addu $sp,$sp,4

    # mark us as having already GC'd
4044#    move $t5,$s5

    # go try and allocate again
4048#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
4052:vm_init:

    # mark bottom of stack
4052#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
4056#    move $s2,$zero

    #set up the "five" register
4060#    li $s5,5

4064#    la $s3,seg0_start
4068#    la $s4,seg0_end
4069##...lui $s4,16
4073##...addiu $s4,$s4,5060
    
    # return
4076#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4080:divide:
    # get parameters; abort if divisor zero
4080#    lw $t0,($sp)
4084#    lw $t1,8($sp)
4088#    beq $t0,$zero,divByZeroError
    
    # perform division
4092#    div $t1,$t0
4096#    mflo $t0

    # store result, adjust stack and return
4100#    addu $sp,$sp,8 # adjust stack
4104#    sw $t0,($sp) # store result
4108#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4112:remainder:
    # get parameters; abort if divisor zero
4112#    lw $t0,($sp)
4116#    lw $t1,8($sp)
4120#    beq $t0,$zero,divByZeroError
    
    # perform division
4124#    div $t1,$t0
4128#    mfhi $t0

    # store result, adjust stack and return
4132#    addu $sp,$sp,8 # adjust stack
4136#    sw $t0,($sp) # store result
4140#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
4144:checkCast:
    # get object, allow immediately if null
4144#    lw $t2,($sp)
4148#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
4152#    lw $t2,-12($t2) # vtable address
4156#    bge $t2,$t1,castException
4157##...slt $at,$t2,$t1
4161##...beq $at,$zero,4332
4164#    blt $t2,$t0,castException
4165##...slt $at,$t2,$t0
4169##...bne $at,$zero,4332
    
    # return, leaving object unchanged on stack
4172:  checkCastReturn:    
4172#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
4176:instanceOf:
    # get object, go return false if null
4176#    lw $t2,($sp)
4180#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
4184#    lw $t2,-12($t2) # vtable address
4188#    sge $t0,$t2,$t0 # are we >= the lower limit?
4189##...slt $t0,$t2,$t0
4193##...xori $t0,$t0,0x1
4196#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
4200#    and $t2,$t0,$t1
4204#    sw $t2,($sp)
4208:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
4208#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

4212:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
4212#    li $v0,4 # syscall-code for print-string
4216#    syscall
4220:exit:
    # print termination message
4220#    li $v0,4 # syscall-code for print-string
4224#    la $a0,exitString
4228#    syscall

    # print number of garbage collections
4232#    li $v0,4 # syscall-code for print-string
4236#    la $a0,gcCountMsg
4240#    syscall # print "Number of ..."
4244#    lw $a0,gcCount # number of GC's
4248#    li $v0,1 # code for print-int
4252#    syscall
4256#    li $v0,4 # syscall-code for print-string
4260#    la $a0,newlineString
4264#    syscall # print newline

    # terminate execution
4268#    li $v0,10 #syscall-code for "exit"
4272#    syscall

4276:outOfHeapMemory:
4276#    la $a0,heapMemoryMsg
4280#    j exitError
4284:divByZeroError:
4284#    la $a0,divByZeroMsg
4288#    j exitError
4292:strIndexOutOfBounds:
4292#    la $a0,strIndexOutOfBoundsMsg
4296#    j exitError
4300:arrayIndexOutOfBounds:
4300#    la $a0,arrayIndexOutOfBoundsMsg
4304#    j exitError
4308:arraySizeOutOfBounds:
4308#    la $a0,arraySizeOutOfBoundsMsg
4312#    j exitError
4316:nullPtrException:
4316#    la $a0,nullPtrExceptionMsg
4320#    j exitError
4324:badIntegerFormat:
4324#    la $a0,badIntegerFormatMsg
4328#    j exitError
4332:castException:
4332#    la $a0,castExceptionMsg
4336#    j exitError
############## data section ################
    .data
4688:hexChars:
    .ascii "0123456789abcdef"
    .align 2
4704:cur_seg:
    .word 0

4708:lastCharRead:
    .word -2 # -2 => no buffered character
4712:prevHashConstant:
    .word 0x2785173c
4716:gcCount:
    .word 0

4720:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
4747:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
4770:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
4805:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
4839:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
4872:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
4903:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
4951:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
4972:gcMsg: 
      .asciiz "\nGC!\n"
4978:gcCountMsg: 
      .asciiz "Number of garbage collections: "

5010:nullStr:
    .asciiz "null"
5015:trueString:
    .asciiz "true"
5020:falseString:
    .asciiz "false"
5026:exitString:
    .ascii "Program execution completed."
    #### "falls through" here
5054:newlineString:
    .asciiz "\n"
    
    .align 2
5056:stack_bottom:
    .word 0
