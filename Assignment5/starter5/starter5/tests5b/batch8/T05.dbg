###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
18176:mth_equals_String:
    
    # quick test for obvious false
18176#    lw $t0,($sp) # second parameter
18180#    beq $t0,$zero,goEsFalse # go return false if null
18184#    lw $t1,-12($t0) # vtable pointer
18188#    la $t2,CLASS_String # string vtable pointer
18192#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
18196#    subu $sp,12
18200#    sw $ra,8($sp)
18204#    sw $s2,4($sp)
18208#    sw $t0,($sp)
18212#    jal mth_compareTo_String
18216#    lw $s2, 4($sp) #restore this pointer and pop parameters
18220#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
18224#    seq $t0,$t0,$zero
18225##...subu $at,$t0,$zero
18229##...sltiu $t0,$at,1

    # pop return address and return $t0
18232#    lw $ra,($sp)
18236#    addu $sp,4

18240#    jr $ra # return
    
18244:goEsFalse:
    # put 0 in $t0 and return
18244#    li $t0, 0
18248#    jr $ra # return
