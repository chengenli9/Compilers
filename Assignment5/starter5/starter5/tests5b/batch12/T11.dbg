##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
356:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
356#    lw $t0,-8($s2) # get word with hash bits from this
360#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
364#    addu $t0,$t1

368#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
372:mth_equals_Object:
372#    move $t0,$s2 # first pointer (this)
376#    lw $t1,($sp) # second pointer
380#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
381##...subu $at,$t0,$t1
385##...sltiu $t0,$at,1

388#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
392:mth_hashCode_String:
392#    move $t0,$s2 # put this pointer in t0

396#    li $t2,0 # current hash value
400#    lw $t1,-4($t0) # negative of number of characters in string
404#    beq $t1,$zero,done_hashCode_String # if zero length => done
408#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
412#    and $t0,0xfffffffc # adjust for padding
413##...lui $at,65535
417##...ori $at,$at,0xfffc
421##...and $t0,$t0,$at
424#    subu $t1,$t0,$t1 # address at end of string +12
428:loop_hashCode_String:    
428#    sll $t4,$t2,5 # multiply by 32
432#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
436#    lbu $t3,-12($t0) # current character
440#    addu $t2,$t3 # add in current character
444#    addu $t0,1 # go to next character's address
448#    bne $t0,$t1,loop_hashCode_String # loop back if more
452:done_hashCode_String:    

    # push int on stack
452#    move $t0, $t2 # put $t2 in return slot
456#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
460:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
460#    subu $sp,4
464#    sw $ra,($sp)
    
    # get hash value
468#    lw $t2,-12($s2) # vtable address
472#    lw $t0,($t2) # method address
476#    jalr $t0
480#    subu $sp,8 # push result (int in $t0) on stack
484#    sw $s5,4($sp)
488#    sw $t0,($sp)

    # compute print-size of hash value
492#    li $t0, 1
496#    lw $t1, ($sp)
500#    srl $t1,$t1,4
504#    beq $t1,$zero,toString_skip_loop
508:toString_loop_top:
508#    addu $t0,1
512#    srl $t1,$t1,4
516#    bne $t1,$zero,toString_loop_top
520:toString_skip_loop:
520#    subu $sp,8
524#    sw $s5,4($sp)
528#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
532#    lw $t2,-12($s2) # vtable address
536#    move $t0,$t2
540:toString_checkTagBit:
540#    subu $t0,1
544#    lb $t1,($t0)
548#    and $t1,0x80
549##...lui $at,0
553##...ori $at,$at,0x80
557##...and $t1,$t1,$at
560#    beq $t1,$zero,toString_checkTagBit
564#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
568#    subu $sp,8
572#    sw $t1,($sp)
576#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
580#    move $s7,$zero # -4 offset header word
584#    lw $t4,8($sp) # bytes for hash value
588#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
592#    addu $t4,8
596#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
600#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

604#    li $t0,CLASS_String # store string vtable address into ...
608#    sw $t0,-12($s7) # ... -12 offset in object header
612#    lw $t2,-12($s2) # our object's vtable address
616#    lw $t5,4($sp) # number characters in prefix
620#    lw $t1,12($sp) # number of characters in hashcode
624#    addu $t3,$t1,$t5 # number of characters in string ...
628#    addu $t3,1 # ... including the '@' character
632#    subu $t0,$zero,$t3 # store negated length into ...
636#    sw $t0,-4($s7) # ... -4 offset header word
640#    lw $t0,-8($s7) # get -8 offset header-word
644#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
645##...slt $at,$t0,$zero
649##...beq $at,$zero,668
652#    and $t0,0xff # mask off object's hash value ...
653##...lui $at,0
657##...ori $at,$at,0xff
661##...and $t0,$t0,$at
664#    sw $t0,-8($s7) # ... and store back into -8 header-word
668:skipMask_toString:
668#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
672#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
676#    subu $t4,$t2,$t5
680:toString_copyLoop:    
680#    lb $t3,($t4)
684#    and $t3,0x7f # mask off sign bit (in case first word)
685##...lui $at,0
689##...ori $at,$at,0x7f
693##...and $t3,$t3,$at
696#    sb $t3,-8($t0)
700#    addu $t4,1
704#    addu $t0,1
708#    blt $t4,$t2,toString_copyLoop
709##...slt $at,$t4,$t2
713##...bne $at,$zero,680

    # copy the '@' sign
716#    li $t3,'@'
720#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
724#    addu $t2,$t0,$t1 # address of last byte in string to store +8
728#    lw $t3,20($sp) # hash code to print
732:toString_hashCopyLoop:
732#    and $t4,$t3,0xf
736#    srl $t3,4
740#    lb $t4,hexChars($t4)
744#    sb $t4,-8($t2)
748#    subu $t2,$t2,1
752#    bgt $t2,$t0,toString_hashCopyLoop
753##...slt $at,$t0,$t2
757##...bne $at,$zero,732

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
760#    addu $sp,28
764#    lw $ra,($sp)
768#    addu $sp,4
772#    move $t0, $s7 # return string we created
776#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
780:mth_equals_String:
    
    # quick test for obvious false
780#    lw $t0,($sp) # second parameter
784#    beq $t0,$zero,goEsFalse # go return false if null
788#    lw $t1,-12($t0) # vtable pointer
