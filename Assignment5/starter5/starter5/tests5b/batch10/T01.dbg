    #   'newObject'
    # We want to set things up so that in addition:
    # - $t0 is the "trailing finger", containing the address
    #   of the first slot in target space that we have yet
    #   to process.
    # Then during processing:
    # - $t1 will contain the contents of the heap slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # And when we're actually copying an object:
    # - $t2 will contain pointer to the target object
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - available for use: $s0
    ##########################################################

    # set $t0 to be at the beginning of target-space
3388#    lw $t1,cur_seg
3392#    la $t0,seg0_start
3396#    beq $t1,$zero,gcSkip4
3400#    la $t0,seg1_start
3401##...lui $t0,16
3405##...addiu $t0,$t0,4620


3408:  gcSkip4:

    # if there were no objects put into the heap during stack
    # processing, we're done, so go finish up
3408#    bgeu $t0,$s3,gcFinishUp
3409##...sltu $at,$t0,$s3
3413##...beq $at,$zero,3704

    ###### begin outer loop to copy all non-stack-direct objects ######

3416:  gcHeapCopyLoop:
    # get data count for object; swap header-word with first word
    # of object so that they're back in the right place
3416#    lw $t1,($t0) # (what will be) first header word for current object
3420#    move $t2,$t1 # number data bytes in object (poss. w/hash bits)
3424#    bge $t2,$zero,gcSkip4a # are there hash bits?
3425##...slt $at,$t2,$zero
3429##...beq $at,$zero,3444
3432#    and $t2,0xff # mask off hash bits
3433##...lui $at,0
3437##...ori $at,$at,0xff
3441##...and $t2,$t2,$at
3444:gcSkip4a:    
3444#    sll $t2,$t2,2 # # data bytes
3448#    addu $t2,$t2,8 # to skip header words
3452#    addu $t2,$t0,$t2 # pointer to new object
3456#    lw $t3,-8($t2) # word to swap
3460#    sw $t1,-8($t2) # store header word
3464#    sw $t3,($t0) # restore first word of object

    ################################################
    # at this point:
    # - $t2 contains the pointer to our new object
    ################################################

    # check if we have a data array
3468#    lw $t1,-12($t2) # vtable pointer
3472#    li $t0,dataArrayVTableStart # address of vtable for first data array
3476#    blt $t1,$t0,gcNotDataArray # if data array, no more xforming to do
3477##...slt $at,$t1,$t0
3481##...bne $at,$zero,3500

    # We have a vtable address that is a data array.
    # we need skip over it then loop back to do next object.
3484:  skipToNextObj:
3484#    lw $t1,-4($t2) # data words in (object position of) array
    #### note: we know that it's not a string, so the value will
    #### not be artificially negative
3488#    sll $t1,$t1,2 # convert to byte-count
3492#    addu $t0,$t2,$t1 # skip over object
3496#    j gcTestIterDone2 # go do next object, if any

    ###################################################
    # at this point:
    # - the object has been restored to normal status--that is, the
    #   word-swap has been done
    # - $t2 contains a pointer to the object
    ###################################################
    
3500:  gcNotDataArray:
3500#    lw $t3,-4($t2) # # object words (negative treated as zero)
3504#    bge $t3,$zero,gcH2Neg2
3505##...slt $at,$t3,$zero
3509##...beq $at,$zero,3516
3512#    move $t3,$zero
3516:  gcH2Neg2:
3516#    sll $t3,$t3,2 # # object bytes
3520#    move $t0,$t2 # address of first pointer in object
3524#    add $s1,$t2,$t3 # limit address for this object

    #####################################################
    # At this point, we have to "translate" all pointers,
    # starting at $t0 to (but not including) $s1
    #####################################################

    # if there are no pointer-slots (i.e., $t0=$s1), skip this
    # part
3528#    beq $t0,$s1,gcTestIterDone2
    
3532:  gcNextPointerInObject:
    # get pointer from object
3532#    lw $t1,($t0)

    # if value is out of range, and is therefore does not refer
    # to an object, just go loop back and do the next one
3536#    bleu $t1,$t6,gcGoNextPointerSlot
3537##...sltu $at,$t6,$t1
3541##...beq $at,$zero,3684
3544#    bgtu $t1,$t7,gcGoNextPointerSlot
3545##...sltu $at,$t7,$t1
3549##...bne $at,$zero,3684

    # if the object has already been moved, update the stack-value
    # via the forwarding pointer
3552#    lw $t8,-8($t1) # possible forwarding tag
3556#    bne $t8,$zero,gcNoForward2 # if not forwarding tag, go copy
3560#    lw $t8,-4($t1) # forwarding pointer: object's new address
3564#    sw $t8,($t0) # update pointer in object
3568#    j gcGoNextPointerSlot # do next iteration

3572:  gcNoForward2:
    #########################################################
    # we actually need to copy the object into the new space
    #########################################################

    #########################################################
    # At this point:
    # - $t0 contains the address of the heap-slot we're translating
    # - $t1 will contain the contents of the heap-slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space, which will also be the first address
    #   of the target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # Then during processing:
    # And when we're actually copying an object:
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $t8 will contain a pointer to the target object
    # - available for use: $s0, $t8, $t9
    ##########################################################

    # compute the amount of space that is needed
3572#    bge $t8,$zero,gcSkip5 # # words in negative-offset portion
3573##...slt $at,$t8,$zero
3577##...beq $at,$zero,3592
3580#    and $t8,0xff # mask off hash bits
3581##...lui $at,0
3585##...ori $at,$at,0xff
3589##...and $t8,$t8,$at

3592:  gcSkip5:
3592#    sll $t8,$t8,2 # bytes in negative-offset portion ...
3596#    addu $t8,$t8,8 # ... add in bytes for header-words
3600#    subu $t4,$t1,$t8 # address of first word of source object
3604#    lw $t3,-4($t1) # # words in positive-offset portion
3608#    bge $t3,$zero,gcNoNeg
3609##...slt $at,$t3,$zero
3613##...beq $at,$zero,3620
3616#    move $t3,$zero # negative treated as zero
3620:  gcNoNeg:
3620#    sll $t3,$t3,2 # bytes in negative-offset portion
3624#    addu $t3,$t3,$t1 # address one word past last word of source

3628#    addu $t8,$s3,$t8 # pointer to target object

    #########################################################
    # At this point:
    # - $t0 contains the address of the stack slot we'll
    #   process next
    # - $t1 contains the contents of the stack slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $t8 contains the pointer to the target object
    # - $s1 contains the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0, $t9
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger"
3632#    lw $s0,($t4)
3636#    lw $t9,-8($t1)
3640#    sw $t9,($t4)
3644#    sw $s0,-8($t1)

    # copy all source bytes to the target
3648:  gCinnerCopy2:
3648#    lw $s0,($t4)
3652#    sw $s0,($s3)
3656#    addu $t4,$t4,4
3660#    addu $s3,$s3,4
3664#    bltu $t4,$t3,gCinnerCopy2
3665##...sltu $at,$t4,$t3
3669##...bne $at,$zero,3648

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
3672#    sw $zero,-8($t1) # 0 in first header-slot
3676#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
3680#    sw $t8,($t0)

3684:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
3684#    addu $t0,$t0,4
3688#    bltu $t0,$s1,gcNextPointerInObject
3689##...sltu $at,$t0,$s1
3693##...bne $at,$zero,3532

3696:  gcTestIterDone2:
3696#    bltu $t0,$s3,gcHeapCopyLoop
3697##...sltu $at,$t0,$s3
3701##...bne $at,$zero,3416

    ###### end outer loop to copy all non-stack-direct objects ######

3704:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
3704#    lw $s2,($sp)
3708#    addu $sp,$sp,4

    # mark us as having already GC'd
3712#    move $t5,$s5

    # go try and allocate again
3716#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
3720:vm_init:

    # mark bottom of stack
3720#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
3724#    move $s2,$zero

    #set up the "five" register
3728#    li $s5,5

3732#    la $s3,seg0_start
3736#    la $s4,seg0_end
3737##...lui $s4,16
3741##...addiu $s4,$s4,4620
    
    # return
3744#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3748:divide:
    # get parameters; abort if divisor zero
3748#    lw $t0,($sp)
3752#    lw $t1,8($sp)
3756#    beq $t0,$zero,divByZeroError
    
    # perform division
3760#    div $t1,$t0
3764#    mflo $t0

    # store result, adjust stack and return
3768#    addu $sp,$sp,8 # adjust stack
3772#    sw $t0,($sp) # store result
3776#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3780:remainder:
    # get parameters; abort if divisor zero
3780#    lw $t0,($sp)
3784#    lw $t1,8($sp)
3788#    beq $t0,$zero,divByZeroError
    
    # perform division
3792#    div $t1,$t0
3796#    mfhi $t0

    # store result, adjust stack and return
3800#    addu $sp,$sp,8 # adjust stack
3804#    sw $t0,($sp) # store result
3808#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
3812:checkCast:
    # get object, allow immediately if null
3812#    lw $t2,($sp)
3816#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
3820#    lw $t2,-12($t2) # vtable address
3824#    bge $t2,$t1,castException
3825##...slt $at,$t2,$t1
3829##...beq $at,$zero,4000
3832#    blt $t2,$t0,castException
3833##...slt $at,$t2,$t0
3837##...bne $at,$zero,4000
    
    # return, leaving object unchanged on stack
3840:  checkCastReturn:    
3840#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
3844:instanceOf:
    # get object, go return false if null
3844#    lw $t2,($sp)
3848#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
3852#    lw $t2,-12($t2) # vtable address
3856#    sge $t0,$t2,$t0 # are we >= the lower limit?
3857##...slt $t0,$t2,$t0
3861##...xori $t0,$t0,0x1
3864#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
3868#    and $t2,$t0,$t1
3872#    sw $t2,($sp)
3876:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
3876#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

3880:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
3880#    li $v0,4 # syscall-code for print-string
3884#    syscall
3888:exit:
    # print termination message
3888#    li $v0,4 # syscall-code for print-string
3892#    la $a0,exitString
3896#    syscall

    # print number of garbage collections
3900#    li $v0,4 # syscall-code for print-string
3904#    la $a0,gcCountMsg
3908#    syscall # print "Number of ..."
3912#    lw $a0,gcCount # number of GC's
3916#    li $v0,1 # code for print-int
3920#    syscall
3924#    li $v0,4 # syscall-code for print-string
3928#    la $a0,newlineString
3932#    syscall # print newline

    # terminate execution
3936#    li $v0,10 #syscall-code for "exit"
3940#    syscall

3944:outOfHeapMemory:
3944#    la $a0,heapMemoryMsg
3948#    j exitError
3952:divByZeroError:
3952#    la $a0,divByZeroMsg
3956#    j exitError
3960:strIndexOutOfBounds:
3960#    la $a0,strIndexOutOfBoundsMsg
3964#    j exitError
3968:arrayIndexOutOfBounds:
3968#    la $a0,arrayIndexOutOfBoundsMsg
3972#    j exitError
3976:arraySizeOutOfBounds:
3976#    la $a0,arraySizeOutOfBoundsMsg
3980#    j exitError
3984:nullPtrException:
3984#    la $a0,nullPtrExceptionMsg
3988#    j exitError
3992:badIntegerFormat:
3992#    la $a0,badIntegerFormatMsg
3996#    j exitError
4000:castException:
4000#    la $a0,castExceptionMsg
4004#    j exitError
############## data section ################
    .data
4248:hexChars:
    .ascii "0123456789abcdef"
    .align 2
4264:cur_seg:
    .word 0

4268:lastCharRead:
    .word -2 # -2 => no buffered character
4272:prevHashConstant:
    .word 0x2785173c
4276:gcCount:
    .word 0

4280:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
4307:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
4330:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
4365:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
4399:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
4432:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
4463:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
4511:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
4532:gcMsg: 
      .asciiz "\nGC!\n"
4538:gcCountMsg: 
      .asciiz "Number of garbage collections: "

4570:nullStr:
    .asciiz "null"
4575:trueString:
    .asciiz "true"
4580:falseString:
    .asciiz "false"
4586:exitString:
    .ascii "Program execution completed."
    #### "falls through" here
4614:newlineString:
    .asciiz "\n"
    
    .align 2
4616:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

4620:seg0_start:
    .space 0x100000
1053196:seg0_end:
1053196:seg1_start:
    .space 0x100000
2101772:seg1_end:
