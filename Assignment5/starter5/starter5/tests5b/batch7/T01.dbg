##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
2036:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
2036#    lw $t0,-8($s2) # get word with hash bits from this
2040#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
2044#    addu $t0,$t1

2048#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
2052:mth_equals_Object:
2052#    move $t0,$s2 # first pointer (this)
2056#    lw $t1,($sp) # second pointer
2060#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
2061##...subu $at,$t0,$t1
2065##...sltiu $t0,$at,1

2068#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
2072:mth_hashCode_String:
2072#    move $t0,$s2 # put this pointer in t0

2076#    li $t2,0 # current hash value
2080#    lw $t1,-4($t0) # negative of number of characters in string
2084#    beq $t1,$zero,done_hashCode_String # if zero length => done
2088#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
2092#    and $t0,0xfffffffc # adjust for padding
2093##...lui $at,65535
2097##...ori $at,$at,0xfffc
2101##...and $t0,$t0,$at
2104#    subu $t1,$t0,$t1 # address at end of string +12
2108:loop_hashCode_String:    
2108#    sll $t4,$t2,5 # multiply by 32
2112#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
2116#    lbu $t3,-12($t0) # current character
2120#    addu $t2,$t3 # add in current character
2124#    addu $t0,1 # go to next character's address
2128#    bne $t0,$t1,loop_hashCode_String # loop back if more
2132:done_hashCode_String:    

    # push int on stack
2132#    move $t0, $t2 # put $t2 in return slot
2136#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
2140:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
2140#    subu $sp,4
2144#    sw $ra,($sp)
    
    # get hash value
2148#    lw $t2,-12($s2) # vtable address
2152#    lw $t0,($t2) # method address
2156#    jalr $t0
2160#    subu $sp,8 # push result (int in $t0) on stack
2164#    sw $s5,4($sp)
2168#    sw $t0,($sp)

    # compute print-size of hash value
2172#    li $t0, 1
2176#    lw $t1, ($sp)
2180#    srl $t1,$t1,4
2184#    beq $t1,$zero,toString_skip_loop
2188:toString_loop_top:
2188#    addu $t0,1
2192#    srl $t1,$t1,4
2196#    bne $t1,$zero,toString_loop_top
2200:toString_skip_loop:
2200#    subu $sp,8
2204#    sw $s5,4($sp)
2208#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
2212#    lw $t2,-12($s2) # vtable address
2216#    move $t0,$t2
2220:toString_checkTagBit:
2220#    subu $t0,1
2224#    lb $t1,($t0)
2228#    and $t1,0x80
2229##...lui $at,0
2233##...ori $at,$at,0x80
2237##...and $t1,$t1,$at
2240#    beq $t1,$zero,toString_checkTagBit
2244#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
2248#    subu $sp,8
2252#    sw $t1,($sp)
2256#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
2260#    move $s7,$zero # -4 offset header word
2264#    lw $t4,8($sp) # bytes for hash value
2268#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
2272#    addu $t4,8
2276#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
2280#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

2284#    li $t0,CLASS_String # store string vtable address into ...
2288#    sw $t0,-12($s7) # ... -12 offset in object header
2292#    lw $t2,-12($s2) # our object's vtable address
2296#    lw $t5,4($sp) # number characters in prefix
2300#    lw $t1,12($sp) # number of characters in hashcode
2304#    addu $t3,$t1,$t5 # number of characters in string ...
2308#    addu $t3,1 # ... including the '@' character
2312#    subu $t0,$zero,$t3 # store negated length into ...
2316#    sw $t0,-4($s7) # ... -4 offset header word
2320#    lw $t0,-8($s7) # get -8 offset header-word
2324#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
2325##...slt $at,$t0,$zero
2329##...beq $at,$zero,2348
2332#    and $t0,0xff # mask off object's hash value ...
2333##...lui $at,0
2337##...ori $at,$at,0xff
2341##...and $t0,$t0,$at
2344#    sw $t0,-8($s7) # ... and store back into -8 header-word
2348:skipMask_toString:
2348#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
2352#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
2356#    subu $t4,$t2,$t5
2360:toString_copyLoop:    
2360#    lb $t3,($t4)
2364#    and $t3,0x7f # mask off sign bit (in case first word)
2365##...lui $at,0
2369##...ori $at,$at,0x7f
2373##...and $t3,$t3,$at
2376#    sb $t3,-8($t0)
2380#    addu $t4,1
2384#    addu $t0,1
2388#    blt $t4,$t2,toString_copyLoop
2389##...slt $at,$t4,$t2
2393##...bne $at,$zero,2360

    # copy the '@' sign
2396#    li $t3,'@'
2400#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
2404#    addu $t2,$t0,$t1 # address of last byte in string to store +8
2408#    lw $t3,20($sp) # hash code to print
2412:toString_hashCopyLoop:
2412#    and $t4,$t3,0xf
2416#    srl $t3,4
2420#    lb $t4,hexChars($t4)
2424#    sb $t4,-8($t2)
2428#    subu $t2,$t2,1
2432#    bgt $t2,$t0,toString_hashCopyLoop
2433##...slt $at,$t0,$t2
2437##...bne $at,$zero,2412

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
2440#    addu $sp,28
2444#    lw $ra,($sp)
2448#    addu $sp,4
2452#    move $t0, $s7 # return string we created
2456#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
2460:mth_equals_String:
    
    # quick test for obvious false
2460#    lw $t0,($sp) # second parameter
2464#    beq $t0,$zero,goEsFalse # go return false if null
2468#    lw $t1,-12($t0) # vtable pointer
2472#    la $t2,CLASS_String # string vtable pointer
2476#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
2480#    subu $sp,12
2484#    sw $ra,8($sp)
2488#    sw $s2,4($sp)
2492#    sw $t0,($sp)
2496#    jal mth_compareTo_String
2500#    lw $s2, 4($sp) #restore this pointer and pop parameters
2504#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
2508#    seq $t0,$t0,$zero
2509##...subu $at,$t0,$zero
2513##...sltiu $t0,$at,1

    # pop return address and return $t0
2516#    lw $ra,($sp)
2520#    addu $sp,4

2524#    jr $ra # return
    
2528:goEsFalse:
    # put 0 in $t0 and return
2528#    li $t0, 0
2532#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
2536:mth_toString_String:
    #we are a string, so return this.
2536#    move $t0, $s2
2540#    jr $ra

