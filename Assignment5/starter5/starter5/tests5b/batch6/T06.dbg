2440#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
2444#    subu $t0,$v0,9
2448#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
2452#    subu $t0,$v0,13
2456#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
2460#    subu $t0,$v0,12
