##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
424:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
424#    lw $t0,-8($s2) # get word with hash bits from this
428#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
432#    addu $t0,$t1

436#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
440:mth_equals_Object:
440#    move $t0,$s2 # first pointer (this)
444#    lw $t1,($sp) # second pointer
448#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
449##...subu $at,$t0,$t1
453##...sltiu $t0,$at,1

456#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
460:mth_hashCode_String:
460#    move $t0,$s2 # put this pointer in t0

464#    li $t2,0 # current hash value
468#    lw $t1,-4($t0) # negative of number of characters in string
472#    beq $t1,$zero,done_hashCode_String # if zero length => done
476#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
480#    and $t0,0xfffffffc # adjust for padding
481##...lui $at,65535
485##...ori $at,$at,0xfffc
489##...and $t0,$t0,$at
492#    subu $t1,$t0,$t1 # address at end of string +12
496:loop_hashCode_String:    
496#    sll $t4,$t2,5 # multiply by 32
500#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
504#    lbu $t3,-12($t0) # current character
508#    addu $t2,$t3 # add in current character
512#    addu $t0,1 # go to next character's address
516#    bne $t0,$t1,loop_hashCode_String # loop back if more
520:done_hashCode_String:    

    # push int on stack
520#    move $t0, $t2 # put $t2 in return slot
524#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
528:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
528#    subu $sp,4
532#    sw $ra,($sp)
    
    # get hash value
536#    lw $t2,-12($s2) # vtable address
540#    lw $t0,($t2) # method address
544#    jalr $t0
548#    subu $sp,8 # push result (int in $t0) on stack
552#    sw $s5,4($sp)
556#    sw $t0,($sp)

    # compute print-size of hash value
560#    li $t0, 1
564#    lw $t1, ($sp)
568#    srl $t1,$t1,4
572#    beq $t1,$zero,toString_skip_loop
576:toString_loop_top:
576#    addu $t0,1
580#    srl $t1,$t1,4
584#    bne $t1,$zero,toString_loop_top
588:toString_skip_loop:
588#    subu $sp,8
592#    sw $s5,4($sp)
596#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
600#    lw $t2,-12($s2) # vtable address
604#    move $t0,$t2
608:toString_checkTagBit:
608#    subu $t0,1
612#    lb $t1,($t0)
616#    and $t1,0x80
617##...lui $at,0
621##...ori $at,$at,0x80
625##...and $t1,$t1,$at
628#    beq $t1,$zero,toString_checkTagBit
632#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
636#    subu $sp,8
640#    sw $t1,($sp)
644#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
648#    move $s7,$zero # -4 offset header word
652#    lw $t4,8($sp) # bytes for hash value
656#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
660#    addu $t4,8
664#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
668#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

672#    li $t0,CLASS_String # store string vtable address into ...
676#    sw $t0,-12($s7) # ... -12 offset in object header
680#    lw $t2,-12($s2) # our object's vtable address
684#    lw $t5,4($sp) # number characters in prefix
688#    lw $t1,12($sp) # number of characters in hashcode
692#    addu $t3,$t1,$t5 # number of characters in string ...
696#    addu $t3,1 # ... including the '@' character
700#    subu $t0,$zero,$t3 # store negated length into ...
704#    sw $t0,-4($s7) # ... -4 offset header word
708#    lw $t0,-8($s7) # get -8 offset header-word
712#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
713##...slt $at,$t0,$zero
717##...beq $at,$zero,736
720#    and $t0,0xff # mask off object's hash value ...
721##...lui $at,0
725##...ori $at,$at,0xff
729##...and $t0,$t0,$at
732#    sw $t0,-8($s7) # ... and store back into -8 header-word
736:skipMask_toString:
736#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
740#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
744#    subu $t4,$t2,$t5
748:toString_copyLoop:    
748#    lb $t3,($t4)
752#    and $t3,0x7f # mask off sign bit (in case first word)
753##...lui $at,0
757##...ori $at,$at,0x7f
761##...and $t3,$t3,$at
764#    sb $t3,-8($t0)
768#    addu $t4,1
772#    addu $t0,1
