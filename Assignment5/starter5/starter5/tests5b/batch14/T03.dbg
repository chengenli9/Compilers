5464#    subu $t0,$v0,10
5468#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
5472#    subu $t0,$v0,9
5476#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
5480#    subu $t0,$v0,13
5484#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
5488#    subu $t0,$v0,12
