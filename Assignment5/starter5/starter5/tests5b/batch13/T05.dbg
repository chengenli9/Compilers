    
    # store header words
1312#    la $t0,CLASS_String
1316#    sw $t0,-12($s7)# store class tag (String) into object
1320#    lw $t2,4($sp) # char-count
1324#    sll $t1,$t2,2 # 4 times number of chars
1328#    subu $t2,$zero,$t2 # negative of char-count
1332#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
1336#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
1340#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
1341##...slt $at,$t0,$zero
1345##...beq $at,$zero,1364
