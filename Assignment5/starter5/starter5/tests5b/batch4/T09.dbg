###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
3660:mth_readLine_Lib:
    
3660#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
3664#    sw $ra, 4($sp) # save $ra
3668#    move $t1,$sp # save "original" sp

3672:  doRead:

    # read the character
3672#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
3676#    subu $t2,$v0,13
3680#    bne $t2,$zero,notReturnRL
3684#    jal readLogicalChar
3688#    subu $t2,$v0,10 # check for newline
3692#    beq $t2,$zero,foundNewLine
3696#    sw $v0,lastCharRead # push back character into queue
3700#    j foundNewLine # go process the line

3704:  notReturnRL:

    # at this point, $v0 has our character

3704#    subu $t0,$v0,10
3708#    beq $t0,$zero,foundNewLine
3712#    blt $v0,$zero,foundEof
3713##...slt $at,$v0,$zero
3717##...bne $at,$zero,3732

    # we have a character, so push it onto stack
3720#    subu $sp,$sp,4
3724#    sw $v0,($sp)

    # loop back up to get next character
3728#    j doRead

3732:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
3732#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
3736#    li $s7, 0 # return-value: null
3740#    j rlReturn # return

3744:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
3744#    subu $t0,$t1,$sp # number of chars we read (times 4)
3748#    srl $s6,$t0,2 # number of words on stack with chars
3752#    subu $sp,$sp,4 # push char-count ...
3756#    sw $s6,($sp) # ... onto stack
3760#    addu $t2,$t0,5 # GC tag, incl. for count-word
3764#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
3768#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
3772#    srl $s6,$s6,2  # data words in object
3776#    move $s7,$zero # object words in object
3780#    jal newObject  # allocate space
    
    # store header words
3784#    la $t0,CLASS_String
3788#    sw $t0,-12($s7)# store class tag (String) into object
3792#    lw $t2,4($sp) # char-count
3796#    sll $t1,$t2,2 # 4 times number of chars
3800#    subu $t2,$zero,$t2 # negative of char-count
3804#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
3808#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
3812#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
3813##...slt $at,$t0,$zero
3817##...beq $at,$zero,3836
3820#    and $t0,0xff # mask off object's hash value ...
3821##...lui $at,0
3825##...ori $at,$at,0xff
3829##...and $t0,$t0,$at
3832#    sw $t0,-8($s7) # ... and store back into -8 header-word
3836:  skipMask_readLine:

3836#    sll $t0,$t0,2 # data bytes in object
3840#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
3844#    subu $t0,$t0,$t2 # place to store last character (plus 9)
3848#    addu $sp,$sp,8 # pop redundant object-pointer and count
3852#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

3856#    beq $sp,$t1,rlReturn
3860:  charCopyLoop:
3860#    lw $t2,($sp)
3864#    sb $t2,-9($t0)
3868#    addu $sp,$sp,4
3872#    subu $t0,$t0,1
3876#    bne $sp,$t1,charCopyLoop
3880:  rlReturn:

3880#    lw $ra, 4($sp)
3884#    addu $sp, 8   # pop $ra and pointless word off stack
3888#    move $t0, $s7 # return string we allocated in $s7
3892#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
3896:mth_readInt_Lib:

    # save $ra by pushing onto stack
3896#    subu $sp,$sp,4
3900#    sw $ra,($sp)

3904:  riSkipWhiteLoop:
    # read a character
3904#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
3908#    subu $t0,$v0,32
