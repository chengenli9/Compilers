###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
1728:mth_readLine_Lib:
    
1728#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
1732#    sw $ra, 4($sp) # save $ra
1736#    move $t1,$sp # save "original" sp

1740:  doRead:

    # read the character
1740#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
1744#    subu $t2,$v0,13
1748#    bne $t2,$zero,notReturnRL
1752#    jal readLogicalChar
1756#    subu $t2,$v0,10 # check for newline
1760#    beq $t2,$zero,foundNewLine
1764#    sw $v0,lastCharRead # push back character into queue
1768#    j foundNewLine # go process the line

1772:  notReturnRL:

    # at this point, $v0 has our character

1772#    subu $t0,$v0,10
1776#    beq $t0,$zero,foundNewLine
1780#    blt $v0,$zero,foundEof
1781##...slt $at,$v0,$zero
1785##...bne $at,$zero,1800

    # we have a character, so push it onto stack
1788#    subu $sp,$sp,4
1792#    sw $v0,($sp)

    # loop back up to get next character
1796#    j doRead

1800:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
1800#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
1804#    li $s7, 0 # return-value: null
1808#    j rlReturn # return

1812:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
1812#    subu $t0,$t1,$sp # number of chars we read (times 4)
1816#    srl $s6,$t0,2 # number of words on stack with chars
1820#    subu $sp,$sp,4 # push char-count ...
1824#    sw $s6,($sp) # ... onto stack
1828#    addu $t2,$t0,5 # GC tag, incl. for count-word
1832#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
1836#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
1840#    srl $s6,$s6,2  # data words in object
1844#    move $s7,$zero # object words in object
1848#    jal newObject  # allocate space
    
    # store header words
1852#    la $t0,CLASS_String
1856#    sw $t0,-12($s7)# store class tag (String) into object
1860#    lw $t2,4($sp) # char-count
1864#    sll $t1,$t2,2 # 4 times number of chars
1868#    subu $t2,$zero,$t2 # negative of char-count
1872#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
1876#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
1880#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
1881##...slt $at,$t0,$zero
1885##...beq $at,$zero,1904
1888#    and $t0,0xff # mask off object's hash value ...
1889##...lui $at,0
1893##...ori $at,$at,0xff
1897##...and $t0,$t0,$at
1900#    sw $t0,-8($s7) # ... and store back into -8 header-word
1904:  skipMask_readLine:

1904#    sll $t0,$t0,2 # data bytes in object
1908#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
1912#    subu $t0,$t0,$t2 # place to store last character (plus 9)
1916#    addu $sp,$sp,8 # pop redundant object-pointer and count
1920#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

1924#    beq $sp,$t1,rlReturn
1928:  charCopyLoop:
1928#    lw $t2,($sp)
1932#    sb $t2,-9($t0)
1936#    addu $sp,$sp,4
1940#    subu $t0,$t0,1
1944#    bne $sp,$t1,charCopyLoop
1948:  rlReturn:

1948#    lw $ra, 4($sp)
1952#    addu $sp, 8   # pop $ra and pointless word off stack
1956#    move $t0, $s7 # return string we allocated in $s7
1960#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
1964:mth_readInt_Lib:

    # save $ra by pushing onto stack
1964#    subu $sp,$sp,4
1968#    sw $ra,($sp)

1972:  riSkipWhiteLoop:
    # read a character
1972#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
1976#    subu $t0,$v0,32
1980#    bgt $t0,$zero,nonWhite
1981##...slt $at,$zero,$t0
1985##...bne $at,$zero,2028
1988#    beq $t0,$zero,riSkipWhiteLoop # start over if space
1992#    subu $t0,$v0,10
1996#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
2000#    subu $t0,$v0,9
2004#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
2008#    subu $t0,$v0,13
2012#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
2016#    subu $t0,$v0,12
2020#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
2024#    j badIntegerFormat # illegal integer char: abort program

2028:  nonWhite:
2028#    subu $t0,$v0,'-'
2032#    li $t4,1 # final multiplier
2036#    bne $t0,$zero,helpReadInt # go read
2040#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
2044#    jal readLogicalChar

2048:  helpReadInt:
2048#    li $t2,10
2052#    subu $t1,$v0,'0' # convert digit to 0-9 value
2056#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
2057##...sltu $at,$t1,$t2
2061##...beq $at,$zero,4344
2064#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

2068:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

2068#    jal readLogicalChar # read next character
2072#    subu $t1,$v0,'0' # convert digit to 0-9 value
2076#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
2077##...sltu $at,$t1,$t2
2081##...beq $at,$zero,2100

2084#    mul $t3,$t3,$t2 # multiply old value by 10
2085##...mult $t3,$t2
2089##...mflo $t3
2092#    addu $t3,$t3,$t1 # add in value of new digit
2096#    j digitLoop

2100:  doneDigitLoop:

    # "push back" unused character into queue
2100#    sw $v0,lastCharRead

    # restore return address
2104#    lw $ra,($sp)
2108#    addu $sp, 4

    # multiply by sign and put return value in $t0
2112#    mult $t3,$t4 # multiply to account for poss. minus sign
2116#    mflo $t3
2120#    move $t0, $t3
    
    # return
2124#    jr $ra
