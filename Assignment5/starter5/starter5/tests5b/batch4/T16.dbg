###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
3368:mth_readLine_Lib:
    
3368#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
3372#    sw $ra, 4($sp) # save $ra
3376#    move $t1,$sp # save "original" sp

3380:  doRead:

    # read the character
3380#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
3384#    subu $t2,$v0,13
3388#    bne $t2,$zero,notReturnRL
3392#    jal readLogicalChar
3396#    subu $t2,$v0,10 # check for newline
3400#    beq $t2,$zero,foundNewLine
3404#    sw $v0,lastCharRead # push back character into queue
3408#    j foundNewLine # go process the line

3412:  notReturnRL:

    # at this point, $v0 has our character

3412#    subu $t0,$v0,10
3416#    beq $t0,$zero,foundNewLine
3420#    blt $v0,$zero,foundEof
3421##...slt $at,$v0,$zero
3425##...bne $at,$zero,3440

    # we have a character, so push it onto stack
3428#    subu $sp,$sp,4
3432#    sw $v0,($sp)

    # loop back up to get next character
3436#    j doRead

3440:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
3440#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
3444#    li $s7, 0 # return-value: null
3448#    j rlReturn # return

3452:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
3452#    subu $t0,$t1,$sp # number of chars we read (times 4)
3456#    srl $s6,$t0,2 # number of words on stack with chars
3460#    subu $sp,$sp,4 # push char-count ...
3464#    sw $s6,($sp) # ... onto stack
3468#    addu $t2,$t0,5 # GC tag, incl. for count-word
3472#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
3476#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
3480#    srl $s6,$s6,2  # data words in object
3484#    move $s7,$zero # object words in object
3488#    jal newObject  # allocate space
    
    # store header words
3492#    la $t0,CLASS_String
3496#    sw $t0,-12($s7)# store class tag (String) into object
3500#    lw $t2,4($sp) # char-count
3504#    sll $t1,$t2,2 # 4 times number of chars
3508#    subu $t2,$zero,$t2 # negative of char-count
3512#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
3516#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
3520#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
3521##...slt $at,$t0,$zero
3525##...beq $at,$zero,3544
3528#    and $t0,0xff # mask off object's hash value ...
3529##...lui $at,0
3533##...ori $at,$at,0xff
3537##...and $t0,$t0,$at
3540#    sw $t0,-8($s7) # ... and store back into -8 header-word
3544:  skipMask_readLine:

3544#    sll $t0,$t0,2 # data bytes in object
3548#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
3552#    subu $t0,$t0,$t2 # place to store last character (plus 9)
3556#    addu $sp,$sp,8 # pop redundant object-pointer and count
3560#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

3564#    beq $sp,$t1,rlReturn
3568:  charCopyLoop:
3568#    lw $t2,($sp)
3572#    sb $t2,-9($t0)
3576#    addu $sp,$sp,4
3580#    subu $t0,$t0,1
3584#    bne $sp,$t1,charCopyLoop
3588:  rlReturn:

3588#    lw $ra, 4($sp)
3592#    addu $sp, 8   # pop $ra and pointless word off stack
3596#    move $t0, $s7 # return string we allocated in $s7
3600#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
3604:mth_readInt_Lib:

    # save $ra by pushing onto stack
3604#    subu $sp,$sp,4
3608#    sw $ra,($sp)

3612:  riSkipWhiteLoop:
    # read a character
3612#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
3616#    subu $t0,$v0,32
3620#    bgt $t0,$zero,nonWhite
3621##...slt $at,$zero,$t0
3625##...bne $at,$zero,3668
3628#    beq $t0,$zero,riSkipWhiteLoop # start over if space
3632#    subu $t0,$v0,10
3636#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
3640#    subu $t0,$v0,9
3644#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
3648#    subu $t0,$v0,13
3652#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
3656#    subu $t0,$v0,12
3660#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
3664#    j badIntegerFormat # illegal integer char: abort program

3668:  nonWhite:
3668#    subu $t0,$v0,'-'
3672#    li $t4,1 # final multiplier
3676#    bne $t0,$zero,helpReadInt # go read
3680#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
3684#    jal readLogicalChar

3688:  helpReadInt:
3688#    li $t2,10
3692#    subu $t1,$v0,'0' # convert digit to 0-9 value
3696#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
3697##...sltu $at,$t1,$t2
3701##...beq $at,$zero,5948
3704#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

3708:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

3708#    jal readLogicalChar # read next character
3712#    subu $t1,$v0,'0' # convert digit to 0-9 value
3716#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
3717##...sltu $at,$t1,$t2
3721##...beq $at,$zero,3740

3724#    mul $t3,$t3,$t2 # multiply old value by 10
3725##...mult $t3,$t2
3729##...mflo $t3
3732#    addu $t3,$t3,$t1 # add in value of new digit
3736#    j digitLoop

3740:  doneDigitLoop:

    # "push back" unused character into queue
3740#    sw $v0,lastCharRead

    # restore return address
3744#    lw $ra,($sp)
3748#    addu $sp, 4

    # multiply by sign and put return value in $t0
3752#    mult $t3,$t4 # multiply to account for poss. minus sign
3756#    mflo $t3
3760#    move $t0, $t3
    
    # return
3764#    jr $ra

