        # can be found by "trailing finger"
5144#    lw $s0,($t4)
5148#    lw $t9,-8($t1)
5152#    sw $t9,($t4)
5156#    sw $s0,-8($t1)

    # copy all source bytes to the target
5160:  gCinnerCopy2:
5160#    lw $s0,($t4)
5164#    sw $s0,($s3)
5168#    addu $t4,$t4,4
5172#    addu $s3,$s3,4
5176#    bltu $t4,$t3,gCinnerCopy2
5177##...sltu $at,$t4,$t3
5181##...bne $at,$zero,5160

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
5184#    sw $zero,-8($t1) # 0 in first header-slot
5188#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
5192#    sw $t8,($t0)

5196:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
5196#    addu $t0,$t0,4
5200#    bltu $t0,$s1,gcNextPointerInObject
5201##...sltu $at,$t0,$s1
5205##...bne $at,$zero,5044

5208:  gcTestIterDone2:
5208#    bltu $t0,$s3,gcHeapCopyLoop
5209##...sltu $at,$t0,$s3
5213##...bne $at,$zero,4928

    ###### end outer loop to copy all non-stack-direct objects ######

5216:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
5216#    lw $s2,($sp)
5220#    addu $sp,$sp,4

    # mark us as having already GC'd
5224#    move $t5,$s5

    # go try and allocate again
5228#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
5232:vm_init:

    # mark bottom of stack
5232#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
5236#    move $s2,$zero

    #set up the "five" register
5240#    li $s5,5

5244#    la $s3,seg0_start
5248#    la $s4,seg0_end
5249##...lui $s4,16
5253##...addiu $s4,$s4,6196
    
    # return
5256#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
5260:divide:
    # get parameters; abort if divisor zero
5260#    lw $t0,($sp)
5264#    lw $t1,8($sp)
5268#    beq $t0,$zero,divByZeroError
    
    # perform division
5272#    div $t1,$t0
5276#    mflo $t0

    # store result, adjust stack and return
5280#    addu $sp,$sp,8 # adjust stack
5284#    sw $t0,($sp) # store result
5288#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
5292:remainder:
    # get parameters; abort if divisor zero
5292#    lw $t0,($sp)
5296#    lw $t1,8($sp)
5300#    beq $t0,$zero,divByZeroError
    
    # perform division
5304#    div $t1,$t0
5308#    mfhi $t0

    # store result, adjust stack and return
5312#    addu $sp,$sp,8 # adjust stack
5316#    sw $t0,($sp) # store result
5320#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
5324:checkCast:
    # get object, allow immediately if null
5324#    lw $t2,($sp)
5328#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
5332#    lw $t2,-12($t2) # vtable address
5336#    bge $t2,$t1,castException
5337##...slt $at,$t2,$t1
5341##...beq $at,$zero,5512
5344#    blt $t2,$t0,castException
5345##...slt $at,$t2,$t0
5349##...bne $at,$zero,5512
    
    # return, leaving object unchanged on stack
5352:  checkCastReturn:    
5352#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
5356:instanceOf:
    # get object, go return false if null
5356#    lw $t2,($sp)
5360#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
5364#    lw $t2,-12($t2) # vtable address
5368#    sge $t0,$t2,$t0 # are we >= the lower limit?
5369##...slt $t0,$t2,$t0
5373##...xori $t0,$t0,0x1
5376#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
5380#    and $t2,$t0,$t1
5384#    sw $t2,($sp)
5388:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
5388#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

5392:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
5392#    li $v0,4 # syscall-code for print-string
5396#    syscall
5400:exit:
    # print termination message
5400#    li $v0,4 # syscall-code for print-string
5404#    la $a0,exitString
5408#    syscall

    # print number of garbage collections
5412#    li $v0,4 # syscall-code for print-string
5416#    la $a0,gcCountMsg
5420#    syscall # print "Number of ..."
5424#    lw $a0,gcCount # number of GC's
5428#    li $v0,1 # code for print-int
5432#    syscall
5436#    li $v0,4 # syscall-code for print-string
5440#    la $a0,newlineString
5444#    syscall # print newline

    # terminate execution
5448#    li $v0,10 #syscall-code for "exit"
5452#    syscall

5456:outOfHeapMemory:
5456#    la $a0,heapMemoryMsg
5460#    j exitError
5464:divByZeroError:
5464#    la $a0,divByZeroMsg
5468#    j exitError
5472:strIndexOutOfBounds:
5472#    la $a0,strIndexOutOfBoundsMsg
5476#    j exitError
5480:arrayIndexOutOfBounds:
5480#    la $a0,arrayIndexOutOfBoundsMsg
5484#    j exitError
5488:arraySizeOutOfBounds:
5488#    la $a0,arraySizeOutOfBoundsMsg
5492#    j exitError
5496:nullPtrException:
5496#    la $a0,nullPtrExceptionMsg
5500#    j exitError
5504:badIntegerFormat:
5504#    la $a0,badIntegerFormatMsg
5508#    j exitError
5512:castException:
5512#    la $a0,castExceptionMsg
5516#    j exitError
############## data section ################
    .data
5824:hexChars:
    .ascii "0123456789abcdef"
    .align 2
5840:cur_seg:
    .word 0

5844:lastCharRead:
    .word -2 # -2 => no buffered character
5848:prevHashConstant:
    .word 0x2785173c
5852:gcCount:
    .word 0

5856:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
5883:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
5906:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
5941:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
5975:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
6008:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
6039:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
6087:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
6108:gcMsg: 
      .asciiz "\nGC!\n"
6114:gcCountMsg: 
      .asciiz "Number of garbage collections: "

6146:nullStr:
    .asciiz "null"
6151:trueString:
    .asciiz "true"
6156:falseString:
    .asciiz "false"
6162:exitString:
    .ascii "Program execution completed."
    #### "falls through" here
6190:newlineString:
    .asciiz "\n"
    
    .align 2
6192:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

6196:seg0_start:
    .space 0x100000
1054772:seg0_end:
1054772:seg1_start:
    .space 0x100000
2103348:seg1_end:
