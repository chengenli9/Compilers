6929##...lui $s4,16
6933##...addiu $s4,$s4,8824
6936#    sw $zero,cur_seg
6940#    bne $t0,$zero,skipGc1
6944#    la $t6,seg0_start
6948#    la $s3,seg1_start
6949##...lui $s3,16
6953##...addiu $s3,$s3,8824
6956#    la $s4,seg1_end
6957##...lui $s4,32
6961##...addiu $s4,$s4,8824
6964#    sw $s5,cur_seg
