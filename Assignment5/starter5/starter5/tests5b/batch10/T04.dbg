7340:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
7340#    subu $t0,$t1,$sp # number of chars we read (times 4)
7344#    srl $s6,$t0,2 # number of words on stack with chars
7348#    subu $sp,$sp,4 # push char-count ...
7352#    sw $s6,($sp) # ... onto stack
7356#    addu $t2,$t0,5 # GC tag, incl. for count-word
7360#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
7364#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
7368#    srl $s6,$s6,2  # data words in object
7372#    move $s7,$zero # object words in object
7376#    jal newObject  # allocate space
    
    # store header words
7380#    la $t0,CLASS_String
7384#    sw $t0,-12($s7)# store class tag (String) into object
7388#    lw $t2,4($sp) # char-count
7392#    sll $t1,$t2,2 # 4 times number of chars
7396#    subu $t2,$zero,$t2 # negative of char-count
7400#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
7404#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
7408#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
7409##...slt $at,$t0,$zero
7413##...beq $at,$zero,7432
7416#    and $t0,0xff # mask off object's hash value ...
7417##...lui $at,0
