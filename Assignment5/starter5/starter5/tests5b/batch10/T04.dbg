4304#    addu $t0,1
4308#    srl $t1,$t1,4
4312#    bne $t1,$zero,toString_loop_top
4316:toString_skip_loop:
4316#    subu $sp,8
4320#    sw $s5,4($sp)
4324#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
4328#    lw $t2,-12($s2) # vtable address
4332#    move $t0,$t2
4336:toString_checkTagBit:
4336#    subu $t0,1
4340#    lb $t1,($t0)
4344#    and $t1,0x80
4345##...lui $at,0
4349##...ori $at,$at,0x80
4353##...and $t1,$t1,$at
4356#    beq $t1,$zero,toString_checkTagBit
4360#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
4364#    subu $sp,8
4368#    sw $t1,($sp)
4372#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
4376#    move $s7,$zero # -4 offset header word
4380#    lw $t4,8($sp) # bytes for hash value
4384#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
4388#    addu $t4,8
4392#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
4396#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

4400#    li $t0,CLASS_String # store string vtable address into ...
4404#    sw $t0,-12($s7) # ... -12 offset in object header
4408#    lw $t2,-12($s2) # our object's vtable address
4412#    lw $t5,4($sp) # number characters in prefix
4416#    lw $t1,12($sp) # number of characters in hashcode
4420#    addu $t3,$t1,$t5 # number of characters in string ...
4424#    addu $t3,1 # ... including the '@' character
4428#    subu $t0,$zero,$t3 # store negated length into ...
4432#    sw $t0,-4($s7) # ... -4 offset header word
4436#    lw $t0,-8($s7) # get -8 offset header-word
4440#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
4441##...slt $at,$t0,$zero
4445##...beq $at,$zero,4464
4448#    and $t0,0xff # mask off object's hash value ...
4449##...lui $at,0
4453##...ori $at,$at,0xff
4457##...and $t0,$t0,$at
4460#    sw $t0,-8($s7) # ... and store back into -8 header-word
4464:skipMask_toString:
4464#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
4468#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
4472#    subu $t4,$t2,$t5
4476:toString_copyLoop:    
4476#    lb $t3,($t4)
4480#    and $t3,0x7f # mask off sign bit (in case first word)
4481##...lui $at,0
4485##...ori $at,$at,0x7f
4489##...and $t3,$t3,$at
4492#    sb $t3,-8($t0)
4496#    addu $t4,1
