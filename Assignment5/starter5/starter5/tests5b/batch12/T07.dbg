###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
776:mth_readLine_Lib:
    
776#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
780#    sw $ra, 4($sp) # save $ra
784#    move $t1,$sp # save "original" sp

788:  doRead:

    # read the character
788#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
792#    subu $t2,$v0,13
796#    bne $t2,$zero,notReturnRL
800#    jal readLogicalChar
804#    subu $t2,$v0,10 # check for newline
808#    beq $t2,$zero,foundNewLine
812#    sw $v0,lastCharRead # push back character into queue
816#    j foundNewLine # go process the line

820:  notReturnRL:

    # at this point, $v0 has our character

820#    subu $t0,$v0,10
824#    beq $t0,$zero,foundNewLine
828#    blt $v0,$zero,foundEof
829##...slt $at,$v0,$zero
833##...bne $at,$zero,848

    # we have a character, so push it onto stack
836#    subu $sp,$sp,4
840#    sw $v0,($sp)

    # loop back up to get next character
844#    j doRead

848:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
848#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
852#    li $s7, 0 # return-value: null
856#    j rlReturn # return

860:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
860#    subu $t0,$t1,$sp # number of chars we read (times 4)
864#    srl $s6,$t0,2 # number of words on stack with chars
868#    subu $sp,$sp,4 # push char-count ...
872#    sw $s6,($sp) # ... onto stack
876#    addu $t2,$t0,5 # GC tag, incl. for count-word
880#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
884#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
888#    srl $s6,$s6,2  # data words in object
892#    move $s7,$zero # object words in object
896#    jal newObject  # allocate space
    
    # store header words
900#    la $t0,CLASS_String
904#    sw $t0,-12($s7)# store class tag (String) into object
908#    lw $t2,4($sp) # char-count
912#    sll $t1,$t2,2 # 4 times number of chars
916#    subu $t2,$zero,$t2 # negative of char-count
920#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
924#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
928#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
929##...slt $at,$t0,$zero
933##...beq $at,$zero,952
936#    and $t0,0xff # mask off object's hash value ...
937##...lui $at,0
941##...ori $at,$at,0xff
945##...and $t0,$t0,$at
948#    sw $t0,-8($s7) # ... and store back into -8 header-word
952:  skipMask_readLine:

952#    sll $t0,$t0,2 # data bytes in object
956#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
960#    subu $t0,$t0,$t2 # place to store last character (plus 9)
964#    addu $sp,$sp,8 # pop redundant object-pointer and count
968#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

972#    beq $sp,$t1,rlReturn
976:  charCopyLoop:
976#    lw $t2,($sp)
980#    sb $t2,-9($t0)
984#    addu $sp,$sp,4
988#    subu $t0,$t0,1
992#    bne $sp,$t1,charCopyLoop
996:  rlReturn:

996#    lw $ra, 4($sp)
1000#    addu $sp, 8   # pop $ra and pointless word off stack
1004#    move $t0, $s7 # return string we allocated in $s7
1008#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
1012:mth_readInt_Lib:

    # save $ra by pushing onto stack
1012#    subu $sp,$sp,4
1016#    sw $ra,($sp)

1020:  riSkipWhiteLoop:
    # read a character
1020#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
1024#    subu $t0,$v0,32
1028#    bgt $t0,$zero,nonWhite
1029##...slt $at,$zero,$t0
1033##...bne $at,$zero,1076
1036#    beq $t0,$zero,riSkipWhiteLoop # start over if space
1040#    subu $t0,$v0,10
1044#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
1048#    subu $t0,$v0,9
1052#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
1056#    subu $t0,$v0,13
1060#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
1064#    subu $t0,$v0,12
1068#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
1072#    j badIntegerFormat # illegal integer char: abort program

1076:  nonWhite:
1076#    subu $t0,$v0,'-'
1080#    li $t4,1 # final multiplier
1084#    bne $t0,$zero,helpReadInt # go read
1088#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
1092#    jal readLogicalChar

1096:  helpReadInt:
1096#    li $t2,10
1100#    subu $t1,$v0,'0' # convert digit to 0-9 value
1104#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
1105##...sltu $at,$t1,$t2
1109##...beq $at,$zero,3392
1112#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

1116:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

1116#    jal readLogicalChar # read next character
1120#    subu $t1,$v0,'0' # convert digit to 0-9 value
1124#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
1125##...sltu $at,$t1,$t2
1129##...beq $at,$zero,1148

1132#    mul $t3,$t3,$t2 # multiply old value by 10
1133##...mult $t3,$t2
1137##...mflo $t3
1140#    addu $t3,$t3,$t1 # add in value of new digit
1144#    j digitLoop

1148:  doneDigitLoop:

    # "push back" unused character into queue
1148#    sw $v0,lastCharRead

    # restore return address
1152#    lw $ra,($sp)
1156#    addu $sp, 4

    # multiply by sign and put return value in $t0
1160#    mult $t3,$t4 # multiply to account for poss. minus sign
1164#    mflo $t3
1168#    move $t0, $t3
    
    # return
1172#    jr $ra
