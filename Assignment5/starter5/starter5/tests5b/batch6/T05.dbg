    # save $ra by pushing onto stack
2080#    subu $sp,$sp,4
2084#    sw $ra,($sp)

      # read the character
2088#    jal readLogicalChar

    # restore return address; put value in $t0
    # replacing this-pointer saved return address
2092#    lw $ra,($sp)
2096#    addu $sp, 4
2100#    move $t0, $v0

    # return
2104#    jr $ra
