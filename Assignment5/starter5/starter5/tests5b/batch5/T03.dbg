###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
1780:mth_readLine_Lib:
    
1780#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
1784#    sw $ra, 4($sp) # save $ra
1788#    move $t1,$sp # save "original" sp

1792:  doRead:

    # read the character
1792#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
1796#    subu $t2,$v0,13
1800#    bne $t2,$zero,notReturnRL
1804#    jal readLogicalChar
1808#    subu $t2,$v0,10 # check for newline
1812#    beq $t2,$zero,foundNewLine
1816#    sw $v0,lastCharRead # push back character into queue
1820#    j foundNewLine # go process the line

1824:  notReturnRL:

    # at this point, $v0 has our character

1824#    subu $t0,$v0,10
1828#    beq $t0,$zero,foundNewLine
1832#    blt $v0,$zero,foundEof
1833##...slt $at,$v0,$zero
1837##...bne $at,$zero,1852

    # we have a character, so push it onto stack
1840#    subu $sp,$sp,4
1844#    sw $v0,($sp)

    # loop back up to get next character
1848#    j doRead

1852:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
1852#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
1856#    li $s7, 0 # return-value: null
1860#    j rlReturn # return

1864:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
1864#    subu $t0,$t1,$sp # number of chars we read (times 4)
1868#    srl $s6,$t0,2 # number of words on stack with chars
1872#    subu $sp,$sp,4 # push char-count ...
1876#    sw $s6,($sp) # ... onto stack
1880#    addu $t2,$t0,5 # GC tag, incl. for count-word
1884#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
1888#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
1892#    srl $s6,$s6,2  # data words in object
1896#    move $s7,$zero # object words in object
1900#    jal newObject  # allocate space
    
    # store header words
1904#    la $t0,CLASS_String
1908#    sw $t0,-12($s7)# store class tag (String) into object
1912#    lw $t2,4($sp) # char-count
1916#    sll $t1,$t2,2 # 4 times number of chars
1920#    subu $t2,$zero,$t2 # negative of char-count
1924#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
1928#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
1932#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
1933##...slt $at,$t0,$zero
1937##...beq $at,$zero,1956
1940#    and $t0,0xff # mask off object's hash value ...
1941##...lui $at,0
1945##...ori $at,$at,0xff
1949##...and $t0,$t0,$at
1952#    sw $t0,-8($s7) # ... and store back into -8 header-word
1956:  skipMask_readLine:

1956#    sll $t0,$t0,2 # data bytes in object
1960#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
1964#    subu $t0,$t0,$t2 # place to store last character (plus 9)
1968#    addu $sp,$sp,8 # pop redundant object-pointer and count
1972#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

1976#    beq $sp,$t1,rlReturn
1980:  charCopyLoop:
1980#    lw $t2,($sp)
1984#    sb $t2,-9($t0)
1988#    addu $sp,$sp,4
1992#    subu $t0,$t0,1
1996#    bne $sp,$t1,charCopyLoop
2000:  rlReturn:

2000#    lw $ra, 4($sp)
2004#    addu $sp, 8   # pop $ra and pointless word off stack
2008#    move $t0, $s7 # return string we allocated in $s7
2012#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
2016:mth_readInt_Lib:

    # save $ra by pushing onto stack
2016#    subu $sp,$sp,4
2020#    sw $ra,($sp)

2024:  riSkipWhiteLoop:
    # read a character
2024#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
2028#    subu $t0,$v0,32
2032#    bgt $t0,$zero,nonWhite
2033##...slt $at,$zero,$t0
2037##...bne $at,$zero,2080
2040#    beq $t0,$zero,riSkipWhiteLoop # start over if space
2044#    subu $t0,$v0,10
2048#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
2052#    subu $t0,$v0,9
2056#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
2060#    subu $t0,$v0,13
2064#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
2068#    subu $t0,$v0,12
2072#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
2076#    j badIntegerFormat # illegal integer char: abort program

2080:  nonWhite:
2080#    subu $t0,$v0,'-'
2084#    li $t4,1 # final multiplier
2088#    bne $t0,$zero,helpReadInt # go read
2092#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
2096#    jal readLogicalChar

2100:  helpReadInt:
2100#    li $t2,10
2104#    subu $t1,$v0,'0' # convert digit to 0-9 value
2108#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
2109##...sltu $at,$t1,$t2
2113##...beq $at,$zero,4360
2116#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

2120:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

2120#    jal readLogicalChar # read next character
2124#    subu $t1,$v0,'0' # convert digit to 0-9 value
2128#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
2129##...sltu $at,$t1,$t2
2133##...beq $at,$zero,2152

2136#    mul $t3,$t3,$t2 # multiply old value by 10
2137##...mult $t3,$t2
2141##...mflo $t3
2144#    addu $t3,$t3,$t1 # add in value of new digit
2148#    j digitLoop

2152:  doneDigitLoop:

    # "push back" unused character into queue
2152#    sw $v0,lastCharRead

    # restore return address
2156#    lw $ra,($sp)
2160#    addu $sp, 4

    # multiply by sign and put return value in $t0
2164#    mult $t3,$t4 # multiply to account for poss. minus sign
2168#    mflo $t3
2172#    move $t0, $t3
    
    # return
2176#    jr $ra

###################################################################
# readChar() - library method (class Lib)
# - reads a single character from standard input
# - returns the integer that is the encoding of the character
# - returns -1 if end of file was encountered
# - parameter:
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
2180:mth_readChar_Lib:

    # save $ra by pushing onto stack
2180#    subu $sp,$sp,4
2184#    sw $ra,($sp)

      # read the character
2188#    jal readLogicalChar

    # restore return address; put value in $t0
    # replacing this-pointer saved return address
2192#    lw $ra,($sp)
2196#    addu $sp, 4
2200#    move $t0, $v0

    # return
2204#    jr $ra

########################################################
# printStr(str) - library method (class Lib)
# - prints string to standard output
# parameters:
#   - ($sp) - the string to print
