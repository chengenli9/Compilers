
    # set up GC tag and char-count on stack
808#    subu $t0,$t1,$sp # number of chars we read (times 4)
812#    srl $s6,$t0,2 # number of words on stack with chars
816#    subu $sp,$sp,4 # push char-count ...
820#    sw $s6,($sp) # ... onto stack
