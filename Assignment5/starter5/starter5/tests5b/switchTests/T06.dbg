3353##...beq $at,$zero,3400
3356#    lw $t1,prevHashConstant
3360#    addu $t1,0x12b68fd2
3361##...lui $at,4791
3365##...addiu $at,$at,-28718
3369##...addu $t1,$at,$t1
3372#    sw $t1,prevHashConstant # update hash constant
3376#    or $t1,0x80000000 # set top bit
3377##...lui $at,32768
3381##...or $t1,$at,$t1
3384#    and $t1,0xffffff00 # clear low bit
3385##...lui $at,65535
3389##...ori $at,$at,0xff00
3393##...and $t1,$t1,$at
3396#    or $s6,$t1
3400:firstHeaderLarge:
3400#    sw $s6,-8($t0) # store header-1 value
3404#    lw $zero,-8($t0)

    # store second header-value
3408#    sw $s7,-4($t0)   # second header-word
3412#    lw $zero,-4($t0)
    
    # put return-value into $s7 and also push it onto top of stack
3416#    move $s7,$t0
3420#    subu $sp,$sp,4
3424#    sw $t0,($sp)
