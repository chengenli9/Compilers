3941##...lui $at,0
3945##...ori $at,$at,0x80
3949##...and $t1,$t1,$at
3952#    beq $t1,$zero,toString_checkTagBit
3956#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
3960#    subu $sp,8
3964#    sw $t1,($sp)
3968#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
3972#    move $s7,$zero # -4 offset header word
3976#    lw $t4,8($sp) # bytes for hash value
3980#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
3984#    addu $t4,8
3988#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
3992#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

3996#    li $t0,CLASS_String # store string vtable address into ...
4000#    sw $t0,-12($s7) # ... -12 offset in object header
4004#    lw $t2,-12($s2) # our object's vtable address
4008#    lw $t5,4($sp) # number characters in prefix
4012#    lw $t1,12($sp) # number of characters in hashcode
4016#    addu $t3,$t1,$t5 # number of characters in string ...
4020#    addu $t3,1 # ... including the '@' character
4024#    subu $t0,$zero,$t3 # store negated length into ...
4028#    sw $t0,-4($s7) # ... -4 offset header word
4032#    lw $t0,-8($s7) # get -8 offset header-word
