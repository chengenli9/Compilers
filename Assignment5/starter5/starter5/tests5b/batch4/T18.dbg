##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1072:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
1072#    lw $t0,-8($s2) # get word with hash bits from this
1076#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
1080#    addu $t0,$t1

1084#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1088:mth_equals_Object:
1088#    move $t0,$s2 # first pointer (this)
1092#    lw $t1,($sp) # second pointer
1096#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
1097##...subu $at,$t0,$t1
1101##...sltiu $t0,$at,1

1104#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1108:mth_hashCode_String:
1108#    move $t0,$s2 # put this pointer in t0

1112#    li $t2,0 # current hash value
1116#    lw $t1,-4($t0) # negative of number of characters in string
1120#    beq $t1,$zero,done_hashCode_String # if zero length => done
1124#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
1128#    and $t0,0xfffffffc # adjust for padding
1129##...lui $at,65535
1133##...ori $at,$at,0xfffc
1137##...and $t0,$t0,$at
1140#    subu $t1,$t0,$t1 # address at end of string +12
1144:loop_hashCode_String:    
1144#    sll $t4,$t2,5 # multiply by 32
1148#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
1152#    lbu $t3,-12($t0) # current character
1156#    addu $t2,$t3 # add in current character
1160#    addu $t0,1 # go to next character's address
1164#    bne $t0,$t1,loop_hashCode_String # loop back if more
1168:done_hashCode_String:    

    # push int on stack
1168#    move $t0, $t2 # put $t2 in return slot
1172#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
1176:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
1176#    subu $sp,4
1180#    sw $ra,($sp)
    
    # get hash value
1184#    lw $t2,-12($s2) # vtable address
1188#    lw $t0,($t2) # method address
1192#    jalr $t0
1196#    subu $sp,8 # push result (int in $t0) on stack
1200#    sw $s5,4($sp)
1204#    sw $t0,($sp)

    # compute print-size of hash value
1208#    li $t0, 1
1212#    lw $t1, ($sp)
1216#    srl $t1,$t1,4
1220#    beq $t1,$zero,toString_skip_loop
1224:toString_loop_top:
1224#    addu $t0,1
1228#    srl $t1,$t1,4
1232#    bne $t1,$zero,toString_loop_top
1236:toString_skip_loop:
1236#    subu $sp,8
1240#    sw $s5,4($sp)
1244#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
1248#    lw $t2,-12($s2) # vtable address
1252#    move $t0,$t2
1256:toString_checkTagBit:
1256#    subu $t0,1
1260#    lb $t1,($t0)
1264#    and $t1,0x80
1265##...lui $at,0
1269##...ori $at,$at,0x80
1273##...and $t1,$t1,$at
1276#    beq $t1,$zero,toString_checkTagBit
1280#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
1284#    subu $sp,8
1288#    sw $t1,($sp)
1292#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
1296#    move $s7,$zero # -4 offset header word
1300#    lw $t4,8($sp) # bytes for hash value
1304#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
1308#    addu $t4,8
1312#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
1316#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

1320#    li $t0,CLASS_String # store string vtable address into ...
1324#    sw $t0,-12($s7) # ... -12 offset in object header
1328#    lw $t2,-12($s2) # our object's vtable address
1332#    lw $t5,4($sp) # number characters in prefix
1336#    lw $t1,12($sp) # number of characters in hashcode
1340#    addu $t3,$t1,$t5 # number of characters in string ...
1344#    addu $t3,1 # ... including the '@' character
1348#    subu $t0,$zero,$t3 # store negated length into ...
1352#    sw $t0,-4($s7) # ... -4 offset header word
1356#    lw $t0,-8($s7) # get -8 offset header-word
1360#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
1361##...slt $at,$t0,$zero
1365##...beq $at,$zero,1384
1368#    and $t0,0xff # mask off object's hash value ...
1369##...lui $at,0
1373##...ori $at,$at,0xff
1377##...and $t0,$t0,$at
1380#    sw $t0,-8($s7) # ... and store back into -8 header-word
1384:skipMask_toString:
1384#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
1388#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
1392#    subu $t4,$t2,$t5
1396:toString_copyLoop:    
1396#    lb $t3,($t4)
1400#    and $t3,0x7f # mask off sign bit (in case first word)
1401##...lui $at,0
1405##...ori $at,$at,0x7f
1409##...and $t3,$t3,$at
1412#    sb $t3,-8($t0)
1416#    addu $t4,1
1420#    addu $t0,1
1424#    blt $t4,$t2,toString_copyLoop
1425##...slt $at,$t4,$t2
1429##...bne $at,$zero,1396

    # copy the '@' sign
1432#    li $t3,'@'
1436#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
1440#    addu $t2,$t0,$t1 # address of last byte in string to store +8
1444#    lw $t3,20($sp) # hash code to print
1448:toString_hashCopyLoop:
1448#    and $t4,$t3,0xf
1452#    srl $t3,4
1456#    lb $t4,hexChars($t4)
1460#    sb $t4,-8($t2)
1464#    subu $t2,$t2,1
1468#    bgt $t2,$t0,toString_hashCopyLoop
1469##...slt $at,$t0,$t2
1473##...bne $at,$zero,1448

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
1476#    addu $sp,28
1480#    lw $ra,($sp)
1484#    addu $sp,4
1488#    move $t0, $s7 # return string we created
1492#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
1496:mth_equals_String:
    
    # quick test for obvious false
1496#    lw $t0,($sp) # second parameter
1500#    beq $t0,$zero,goEsFalse # go return false if null
1504#    lw $t1,-12($t0) # vtable pointer
1508#    la $t2,CLASS_String # string vtable pointer
1512#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
1516#    subu $sp,12
1520#    sw $ra,8($sp)
1524#    sw $s2,4($sp)
1528#    sw $t0,($sp)
1532#    jal mth_compareTo_String
1536#    lw $s2, 4($sp) #restore this pointer and pop parameters
1540#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
1544#    seq $t0,$t0,$zero
1545##...subu $at,$t0,$zero
1549##...sltiu $t0,$at,1

    # pop return address and return $t0
1552#    lw $ra,($sp)
1556#    addu $sp,4

1560#    jr $ra # return
    
1564:goEsFalse:
    # put 0 in $t0 and return
1564#    li $t0, 0
1568#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
1572:mth_toString_String:
    #we are a string, so return this.
1572#    move $t0, $s2
1576#    jr $ra

###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
1580:mth_readLine_Lib:
    
1580#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
1584#    sw $ra, 4($sp) # save $ra
1588#    move $t1,$sp # save "original" sp

1592:  doRead:

    # read the character
1592#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
1596#    subu $t2,$v0,13
1600#    bne $t2,$zero,notReturnRL
1604#    jal readLogicalChar
1608#    subu $t2,$v0,10 # check for newline
1612#    beq $t2,$zero,foundNewLine
1616#    sw $v0,lastCharRead # push back character into queue
1620#    j foundNewLine # go process the line

1624:  notReturnRL:

    # at this point, $v0 has our character

1624#    subu $t0,$v0,10
1628#    beq $t0,$zero,foundNewLine
1632#    blt $v0,$zero,foundEof
1633##...slt $at,$v0,$zero
1637##...bne $at,$zero,1652

    # we have a character, so push it onto stack
1640#    subu $sp,$sp,4
1644#    sw $v0,($sp)

    # loop back up to get next character
1648#    j doRead

1652:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
1652#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
1656#    li $s7, 0 # return-value: null
1660#    j rlReturn # return

1664:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
1664#    subu $t0,$t1,$sp # number of chars we read (times 4)
1668#    srl $s6,$t0,2 # number of words on stack with chars
1672#    subu $sp,$sp,4 # push char-count ...
1676#    sw $s6,($sp) # ... onto stack
1680#    addu $t2,$t0,5 # GC tag, incl. for count-word
1684#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
1688#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
1692#    srl $s6,$s6,2  # data words in object
1696#    move $s7,$zero # object words in object
1700#    jal newObject  # allocate space
    
    # store header words
1704#    la $t0,CLASS_String
1708#    sw $t0,-12($s7)# store class tag (String) into object
1712#    lw $t2,4($sp) # char-count
1716#    sll $t1,$t2,2 # 4 times number of chars
1720#    subu $t2,$zero,$t2 # negative of char-count
1724#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
1728#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
1732#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
1733##...slt $at,$t0,$zero
1737##...beq $at,$zero,1756
1740#    and $t0,0xff # mask off object's hash value ...
1741##...lui $at,0
1745##...ori $at,$at,0xff
1749##...and $t0,$t0,$at
1752#    sw $t0,-8($s7) # ... and store back into -8 header-word
1756:  skipMask_readLine:

1756#    sll $t0,$t0,2 # data bytes in object
1760#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
1764#    subu $t0,$t0,$t2 # place to store last character (plus 9)
1768#    addu $sp,$sp,8 # pop redundant object-pointer and count
1772#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

1776#    beq $sp,$t1,rlReturn
1780:  charCopyLoop:
1780#    lw $t2,($sp)
1784#    sb $t2,-9($t0)
1788#    addu $sp,$sp,4
1792#    subu $t0,$t0,1
1796#    bne $sp,$t1,charCopyLoop
1800:  rlReturn:

1800#    lw $ra, 4($sp)
1804#    addu $sp, 8   # pop $ra and pointless word off stack
1808#    move $t0, $s7 # return string we allocated in $s7
1812#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
1816:mth_readInt_Lib:

    # save $ra by pushing onto stack
1816#    subu $sp,$sp,4
1820#    sw $ra,($sp)

1824:  riSkipWhiteLoop:
    # read a character
1824#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
1828#    subu $t0,$v0,32
1832#    bgt $t0,$zero,nonWhite
1833##...slt $at,$zero,$t0
1837##...bne $at,$zero,1880
1840#    beq $t0,$zero,riSkipWhiteLoop # start over if space
1844#    subu $t0,$v0,10
1848#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
1852#    subu $t0,$v0,9
1856#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
1860#    subu $t0,$v0,13
1864#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
1868#    subu $t0,$v0,12
1872#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
1876#    j badIntegerFormat # illegal integer char: abort program

1880:  nonWhite:
1880#    subu $t0,$v0,'-'
1884#    li $t4,1 # final multiplier
1888#    bne $t0,$zero,helpReadInt # go read
1892#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
1896#    jal readLogicalChar

1900:  helpReadInt:
1900#    li $t2,10
1904#    subu $t1,$v0,'0' # convert digit to 0-9 value
1908#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
1909##...sltu $at,$t1,$t2
1913##...beq $at,$zero,4196
1916#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

1920:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

1920#    jal readLogicalChar # read next character
1924#    subu $t1,$v0,'0' # convert digit to 0-9 value
1928#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
1929##...sltu $at,$t1,$t2
1933##...beq $at,$zero,1952

1936#    mul $t3,$t3,$t2 # multiply old value by 10
1937##...mult $t3,$t2
1941##...mflo $t3
1944#    addu $t3,$t3,$t1 # add in value of new digit
1948#    j digitLoop

1952:  doneDigitLoop:

    # "push back" unused character into queue
1952#    sw $v0,lastCharRead

    # restore return address
1956#    lw $ra,($sp)
1960#    addu $sp, 4

    # multiply by sign and put return value in $t0
1964#    mult $t3,$t4 # multiply to account for poss. minus sign
1968#    mflo $t3
1972#    move $t0, $t3
    
    # return
1976#    jr $ra

###################################################################
# readChar() - library method (class Lib)
# - reads a single character from standard input
# - returns the integer that is the encoding of the character
# - returns -1 if end of file was encountered
# - parameter:
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
1980:mth_readChar_Lib:

    # save $ra by pushing onto stack
1980#    subu $sp,$sp,4
1984#    sw $ra,($sp)

      # read the character
1988#    jal readLogicalChar

    # restore return address; put value in $t0
    # replacing this-pointer saved return address
1992#    lw $ra,($sp)
1996#    addu $sp, 4
2000#    move $t0, $v0

    # return
2004#    jr $ra

########################################################
# printStr(str) - library method (class Lib)
# - prints string to standard output
# parameters:
#   - ($sp) - the string to print
#   - 4($sp) - old-this-pointer
########################################################
2008:mth_printStr_Lib:
    # check for null, printing "(null)", if so
2008#    lw $t0,($sp)
2012#    bne $t0,$zero,psNotNull

    # print "(null)"
2016#    la $a0,nullStr
2020#    li $v0,4
2024#    syscall
2028#    j donePrintStr
    
2032:  psNotNull:
    ##### we have a non-null string #####
    # this means that:
    # - number of data words in -8($t0):
    #   - if the sign bit is 1, the low 31 bits
    #   - if the sign bit is 0, the low 8 bits
    # - negative of number of characters in string is in -4($t0)
    # - string begins at $t0-8-(#dataWords*4), stored 1 char per byte
2032#    subu $t0,$t0,8
2036#    lw $t1,($t0) # number of data words, but needs modification
2040#    blt $t1,$zero,skipPrintStr1
