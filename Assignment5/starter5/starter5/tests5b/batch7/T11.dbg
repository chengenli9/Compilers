1380#    subu $t0,$v0,10
1384#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
1388#    subu $t0,$v0,9
1392#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
1396#    subu $t0,$v0,13
1400#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
1404#    subu $t0,$v0,12
