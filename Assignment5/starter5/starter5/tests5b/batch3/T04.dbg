    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
2652#    addu $t4,8
2656#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
2660#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

2664#    li $t0,CLASS_String # store string vtable address into ...
2668#    sw $t0,-12($s7) # ... -12 offset in object header
2672#    lw $t2,-12($s2) # our object's vtable address
2676#    lw $t5,4($sp) # number characters in prefix
2680#    lw $t1,12($sp) # number of characters in hashcode
2684#    addu $t3,$t1,$t5 # number of characters in string ...
2688#    addu $t3,1 # ... including the '@' character
2692#    subu $t0,$zero,$t3 # store negated length into ...
2696#    sw $t0,-4($s7) # ... -4 offset header word
2700#    lw $t0,-8($s7) # get -8 offset header-word
2704#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
2705##...slt $at,$t0,$zero
2709##...beq $at,$zero,2728
2712#    and $t0,0xff # mask off object's hash value ...
2713##...lui $at,0
2717##...ori $at,$at,0xff
2721##...and $t0,$t0,$at
2724#    sw $t0,-8($s7) # ... and store back into -8 header-word
2728:skipMask_toString:
2728#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
2732#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
2736#    subu $t4,$t2,$t5
2740:toString_copyLoop:    
2740#    lb $t3,($t4)
2744#    and $t3,0x7f # mask off sign bit (in case first word)
2745##...lui $at,0
2749##...ori $at,$at,0x7f
2753##...and $t3,$t3,$at
2756#    sb $t3,-8($t0)
2760#    addu $t4,1
2764#    addu $t0,1
