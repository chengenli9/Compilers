929##...slt $at,$zero,$t0
933##...bne $at,$zero,976
936#    beq $t0,$zero,riSkipWhiteLoop # start over if space
940#    subu $t0,$v0,10
944#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
948#    subu $t0,$v0,9
952#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
956#    subu $t0,$v0,13
960#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
964#    subu $t0,$v0,12
968#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
