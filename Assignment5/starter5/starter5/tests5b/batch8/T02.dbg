    # if the object has already been moved, update the stack-value
    # via the forwarding pointer
4364#    lw $t8,-8($t1) # possible forwarding tag
4368#    bne $t8,$zero,gcNoForward2 # if not forwarding tag, go copy
4372#    lw $t8,-4($t1) # forwarding pointer: object's new address
4376#    sw $t8,($t0) # update pointer in object
4380#    j gcGoNextPointerSlot # do next iteration
