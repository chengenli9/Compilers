3337##...sltu $at,$t1,$t2
3341##...beq $at,$zero,5624
3344#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

3348:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

3348#    jal readLogicalChar # read next character
3352#    subu $t1,$v0,'0' # convert digit to 0-9 value
3356#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
3357##...sltu $at,$t1,$t2
3361##...beq $at,$zero,3380

3364#    mul $t3,$t3,$t2 # multiply old value by 10
3365##...mult $t3,$t2
3369##...mflo $t3
3372#    addu $t3,$t3,$t1 # add in value of new digit
3376#    j digitLoop

3380:  doneDigitLoop:
