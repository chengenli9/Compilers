##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
2308:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
2308#    lw $t0,-8($s2) # get word with hash bits from this
2312#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
2316#    addu $t0,$t1

2320#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
2324:mth_equals_Object:
2324#    move $t0,$s2 # first pointer (this)
2328#    lw $t1,($sp) # second pointer
2332#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
2333##...subu $at,$t0,$t1
2337##...sltiu $t0,$at,1

2340#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
2344:mth_hashCode_String:
2344#    move $t0,$s2 # put this pointer in t0

2348#    li $t2,0 # current hash value
2352#    lw $t1,-4($t0) # negative of number of characters in string
2356#    beq $t1,$zero,done_hashCode_String # if zero length => done
2360#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
2364#    and $t0,0xfffffffc # adjust for padding
2365##...lui $at,65535
2369##...ori $at,$at,0xfffc
2373##...and $t0,$t0,$at
2376#    subu $t1,$t0,$t1 # address at end of string +12
2380:loop_hashCode_String:    
2380#    sll $t4,$t2,5 # multiply by 32
2384#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
2388#    lbu $t3,-12($t0) # current character
2392#    addu $t2,$t3 # add in current character
2396#    addu $t0,1 # go to next character's address
2400#    bne $t0,$t1,loop_hashCode_String # loop back if more
2404:done_hashCode_String:    

    # push int on stack
2404#    move $t0, $t2 # put $t2 in return slot
2408#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
2412:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
2412#    subu $sp,4
2416#    sw $ra,($sp)
    
    # get hash value
2420#    lw $t2,-12($s2) # vtable address
2424#    lw $t0,($t2) # method address
2428#    jalr $t0
2432#    subu $sp,8 # push result (int in $t0) on stack
2436#    sw $s5,4($sp)
2440#    sw $t0,($sp)

    # compute print-size of hash value
2444#    li $t0, 1
2448#    lw $t1, ($sp)
2452#    srl $t1,$t1,4
2456#    beq $t1,$zero,toString_skip_loop
2460:toString_loop_top:
2460#    addu $t0,1
2464#    srl $t1,$t1,4
2468#    bne $t1,$zero,toString_loop_top
2472:toString_skip_loop:
2472#    subu $sp,8
2476#    sw $s5,4($sp)
2480#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
