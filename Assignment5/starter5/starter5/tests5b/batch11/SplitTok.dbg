###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
4256:mth_readLine_Lib:
    
4256#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
4260#    sw $ra, 4($sp) # save $ra
4264#    move $t1,$sp # save "original" sp

4268:  doRead:

    # read the character
4268#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
4272#    subu $t2,$v0,13
4276#    bne $t2,$zero,notReturnRL
4280#    jal readLogicalChar
4284#    subu $t2,$v0,10 # check for newline
4288#    beq $t2,$zero,foundNewLine
4292#    sw $v0,lastCharRead # push back character into queue
4296#    j foundNewLine # go process the line

4300:  notReturnRL:

    # at this point, $v0 has our character

4300#    subu $t0,$v0,10
4304#    beq $t0,$zero,foundNewLine
4308#    blt $v0,$zero,foundEof
4309##...slt $at,$v0,$zero
4313##...bne $at,$zero,4328

    # we have a character, so push it onto stack
4316#    subu $sp,$sp,4
4320#    sw $v0,($sp)

    # loop back up to get next character
4324#    j doRead

4328:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
4328#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
4332#    li $s7, 0 # return-value: null
4336#    j rlReturn # return

4340:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
4340#    subu $t0,$t1,$sp # number of chars we read (times 4)
4344#    srl $s6,$t0,2 # number of words on stack with chars
4348#    subu $sp,$sp,4 # push char-count ...
4352#    sw $s6,($sp) # ... onto stack
4356#    addu $t2,$t0,5 # GC tag, incl. for count-word
4360#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
4364#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
4368#    srl $s6,$s6,2  # data words in object
4372#    move $s7,$zero # object words in object
4376#    jal newObject  # allocate space
    
    # store header words
4380#    la $t0,CLASS_String
4384#    sw $t0,-12($s7)# store class tag (String) into object
4388#    lw $t2,4($sp) # char-count
4392#    sll $t1,$t2,2 # 4 times number of chars
4396#    subu $t2,$zero,$t2 # negative of char-count
4400#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
4404#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
4408#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
4409##...slt $at,$t0,$zero
4413##...beq $at,$zero,4432
4416#    and $t0,0xff # mask off object's hash value ...
4417##...lui $at,0
4421##...ori $at,$at,0xff
4425##...and $t0,$t0,$at
4428#    sw $t0,-8($s7) # ... and store back into -8 header-word
4432:  skipMask_readLine:

4432#    sll $t0,$t0,2 # data bytes in object
4436#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
4440#    subu $t0,$t0,$t2 # place to store last character (plus 9)
4444#    addu $sp,$sp,8 # pop redundant object-pointer and count
4448#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

4452#    beq $sp,$t1,rlReturn
4456:  charCopyLoop:
4456#    lw $t2,($sp)
4460#    sb $t2,-9($t0)
4464#    addu $sp,$sp,4
4468#    subu $t0,$t0,1
4472#    bne $sp,$t1,charCopyLoop
4476:  rlReturn:

4476#    lw $ra, 4($sp)
4480#    addu $sp, 8   # pop $ra and pointless word off stack
4484#    move $t0, $s7 # return string we allocated in $s7
4488#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
4492:mth_readInt_Lib:

    # save $ra by pushing onto stack
4492#    subu $sp,$sp,4
4496#    sw $ra,($sp)

4500:  riSkipWhiteLoop:
    # read a character
4500#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
4504#    subu $t0,$v0,32
4508#    bgt $t0,$zero,nonWhite
4509##...slt $at,$zero,$t0
4513##...bne $at,$zero,4556
4516#    beq $t0,$zero,riSkipWhiteLoop # start over if space
4520#    subu $t0,$v0,10
4524#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
4528#    subu $t0,$v0,9
4532#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
4536#    subu $t0,$v0,13
4540#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
4544#    subu $t0,$v0,12
4548#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
4552#    j badIntegerFormat # illegal integer char: abort program

4556:  nonWhite:
4556#    subu $t0,$v0,'-'
4560#    li $t4,1 # final multiplier
4564#    bne $t0,$zero,helpReadInt # go read
4568#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
4572#    jal readLogicalChar

4576:  helpReadInt:
4576#    li $t2,10
4580#    subu $t1,$v0,'0' # convert digit to 0-9 value
4584#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
4585##...sltu $at,$t1,$t2
4589##...beq $at,$zero,6872
4592#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

4596:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

4596#    jal readLogicalChar # read next character
4600#    subu $t1,$v0,'0' # convert digit to 0-9 value
4604#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
4605##...sltu $at,$t1,$t2
4609##...beq $at,$zero,4628

4612#    mul $t3,$t3,$t2 # multiply old value by 10
4613##...mult $t3,$t2
4617##...mflo $t3
4620#    addu $t3,$t3,$t1 # add in value of new digit
4624#    j digitLoop

4628:  doneDigitLoop:

    # "push back" unused character into queue
4628#    sw $v0,lastCharRead

    # restore return address
4632#    lw $ra,($sp)
4636#    addu $sp, 4

    # multiply by sign and put return value in $t0
4640#    mult $t3,$t4 # multiply to account for poss. minus sign
4644#    mflo $t3
4648#    move $t0, $t3
    
    # return
4652#    jr $ra

###################################################################
# readChar() - library method (class Lib)
# - reads a single character from standard input
# - returns the integer that is the encoding of the character
# - returns -1 if end of file was encountered
# - parameter:
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
4656:mth_readChar_Lib:
