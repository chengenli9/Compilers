##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
820:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
820#    lw $t0,-8($s2) # get word with hash bits from this
824#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
828#    addu $t0,$t1

832#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
836:mth_equals_Object:
836#    move $t0,$s2 # first pointer (this)
840#    lw $t1,($sp) # second pointer
844#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
845##...subu $at,$t0,$t1
849##...sltiu $t0,$at,1

852#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
856:mth_hashCode_String:
856#    move $t0,$s2 # put this pointer in t0

860#    li $t2,0 # current hash value
864#    lw $t1,-4($t0) # negative of number of characters in string
868#    beq $t1,$zero,done_hashCode_String # if zero length => done
872#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
876#    and $t0,0xfffffffc # adjust for padding
877##...lui $at,65535
881##...ori $at,$at,0xfffc
885##...and $t0,$t0,$at
888#    subu $t1,$t0,$t1 # address at end of string +12
892:loop_hashCode_String:    
892#    sll $t4,$t2,5 # multiply by 32
896#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
900#    lbu $t3,-12($t0) # current character
904#    addu $t2,$t3 # add in current character
908#    addu $t0,1 # go to next character's address
912#    bne $t0,$t1,loop_hashCode_String # loop back if more
916:done_hashCode_String:    

    # push int on stack
916#    move $t0, $t2 # put $t2 in return slot
920#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
924:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
924#    subu $sp,4
928#    sw $ra,($sp)
    
    # get hash value
932#    lw $t2,-12($s2) # vtable address
936#    lw $t0,($t2) # method address
940#    jalr $t0
944#    subu $sp,8 # push result (int in $t0) on stack
948#    sw $s5,4($sp)
952#    sw $t0,($sp)

    # compute print-size of hash value
956#    li $t0, 1
960#    lw $t1, ($sp)
964#    srl $t1,$t1,4
968#    beq $t1,$zero,toString_skip_loop
972:toString_loop_top:
972#    addu $t0,1
976#    srl $t1,$t1,4
980#    bne $t1,$zero,toString_loop_top
984:toString_skip_loop:
984#    subu $sp,8
988#    sw $s5,4($sp)
992#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
996#    lw $t2,-12($s2) # vtable address
1000#    move $t0,$t2
1004:toString_checkTagBit:
1004#    subu $t0,1
1008#    lb $t1,($t0)
1012#    and $t1,0x80
1013##...lui $at,0
1017##...ori $at,$at,0x80
1021##...and $t1,$t1,$at
1024#    beq $t1,$zero,toString_checkTagBit
1028#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
1032#    subu $sp,8
1036#    sw $t1,($sp)
1040#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
1044#    move $s7,$zero # -4 offset header word
1048#    lw $t4,8($sp) # bytes for hash value
1052#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
1056#    addu $t4,8
1060#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
1064#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

1068#    li $t0,CLASS_String # store string vtable address into ...
1072#    sw $t0,-12($s7) # ... -12 offset in object header
1076#    lw $t2,-12($s2) # our object's vtable address
1080#    lw $t5,4($sp) # number characters in prefix
1084#    lw $t1,12($sp) # number of characters in hashcode
1088#    addu $t3,$t1,$t5 # number of characters in string ...
1092#    addu $t3,1 # ... including the '@' character
1096#    subu $t0,$zero,$t3 # store negated length into ...
1100#    sw $t0,-4($s7) # ... -4 offset header word
1104#    lw $t0,-8($s7) # get -8 offset header-word
