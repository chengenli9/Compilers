11912#    lw $t3,-4($t1) # # words in positive-offset portion
11916#    bge $t3,$zero,gcNoNeg
11917##...slt $at,$t3,$zero
11921##...beq $at,$zero,11928
11924#    move $t3,$zero # negative treated as zero
11928:  gcNoNeg:
11928#    sll $t3,$t3,2 # bytes in negative-offset portion
11932#    addu $t3,$t3,$t1 # address one word past last word of source

11936#    addu $t8,$s3,$t8 # pointer to target object

    #########################################################
    # At this point:
    # - $t0 contains the address of the stack slot we'll
    #   process next
    # - $t1 contains the contents of the stack slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $t8 contains the pointer to the target object
    # - $s1 contains the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0, $t9
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger"
11940#    lw $s0,($t4)
11944#    lw $t9,-8($t1)
11948#    sw $t9,($t4)
11952#    sw $s0,-8($t1)

    # copy all source bytes to the target
11956:  gCinnerCopy2:
11956#    lw $s0,($t4)
11960#    sw $s0,($s3)
11964#    addu $t4,$t4,4
11968#    addu $s3,$s3,4
11972#    bltu $t4,$t3,gCinnerCopy2
11973##...sltu $at,$t4,$t3
11977##...bne $at,$zero,11956

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
11980#    sw $zero,-8($t1) # 0 in first header-slot
11984#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
11988#    sw $t8,($t0)

11992:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
11992#    addu $t0,$t0,4
11996#    bltu $t0,$s1,gcNextPointerInObject
11997##...sltu $at,$t0,$s1
12001##...bne $at,$zero,11840

12004:  gcTestIterDone2:
12004#    bltu $t0,$s3,gcHeapCopyLoop
12005##...sltu $at,$t0,$s3
12009##...bne $at,$zero,11724

    ###### end outer loop to copy all non-stack-direct objects ######

12012:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
12012#    lw $s2,($sp)
12016#    addu $sp,$sp,4

    # mark us as having already GC'd
12020#    move $t5,$s5

    # go try and allocate again
12024#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
12028:vm_init:

    # mark bottom of stack
12028#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
12032#    move $s2,$zero

    #set up the "five" register
12036#    li $s5,5

12040#    la $s3,seg0_start
12044#    la $s4,seg0_end
12045##...lui $s4,16
12049##...addiu $s4,$s4,13256
    
    # return
12052#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
12056:divide:
    # get parameters; abort if divisor zero
12056#    lw $t0,($sp)
12060#    lw $t1,8($sp)
12064#    beq $t0,$zero,divByZeroError
    
    # perform division
12068#    div $t1,$t0
12072#    mflo $t0

    # store result, adjust stack and return
12076#    addu $sp,$sp,8 # adjust stack
12080#    sw $t0,($sp) # store result
12084#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
12088:remainder:
    # get parameters; abort if divisor zero
12088#    lw $t0,($sp)
12092#    lw $t1,8($sp)
12096#    beq $t0,$zero,divByZeroError
    
    # perform division
12100#    div $t1,$t0
12104#    mfhi $t0

    # store result, adjust stack and return
12108#    addu $sp,$sp,8 # adjust stack
12112#    sw $t0,($sp) # store result
12116#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
12120:checkCast:
    # get object, allow immediately if null
12120#    lw $t2,($sp)
12124#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
12128#    lw $t2,-12($t2) # vtable address
12132#    bge $t2,$t1,castException
12133##...slt $at,$t2,$t1
12137##...beq $at,$zero,12272
12140#    blt $t2,$t0,castException
12141##...slt $at,$t2,$t0
12145##...bne $at,$zero,12272
    
    # return, leaving object unchanged on stack
12148:  checkCastReturn:    
12148#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
12152:instanceOf:
    # get object, go return false if null
12152#    lw $t2,($sp)
12156#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
12160#    lw $t2,-12($t2) # vtable address
12164#    sge $t0,$t2,$t0 # are we >= the lower limit?
12165##...slt $t0,$t2,$t0
12169##...xori $t0,$t0,0x1
12172#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
12176#    and $t2,$t0,$t1
12180#    sw $t2,($sp)
12184:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
12184#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

12188:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
12188#    li $v0,4 # syscall-code for print-string
12192#    syscall
12196:exit:
    # print termination message
12196#    li $v0,4 # syscall-code for print-string
12200#    la $a0,exitString
12204#    syscall

    # terminate execution
12208#    li $v0,10 #syscall-code for "exit"
12212#    syscall

12216:outOfHeapMemory:
12216#    la $a0,heapMemoryMsg
12220#    j exitError
12224:divByZeroError:
12224#    la $a0,divByZeroMsg
12228#    j exitError
12232:strIndexOutOfBounds:
12232#    la $a0,strIndexOutOfBoundsMsg
12236#    j exitError
12240:arrayIndexOutOfBounds:
12240#    la $a0,arrayIndexOutOfBoundsMsg
12244#    j exitError
12248:arraySizeOutOfBounds:
12248#    la $a0,arraySizeOutOfBoundsMsg
12252#    j exitError
12256:nullPtrException:
12256#    la $a0,nullPtrExceptionMsg
12260#    j exitError
12264:badIntegerFormat:
12264#    la $a0,badIntegerFormatMsg
12268#    j exitError
12272:castException:
12272#    la $a0,castExceptionMsg
12276#    j exitError
############## data section ################
    .data
12892:hexChars:
    .ascii "0123456789abcdef"
    .align 2
12908:cur_seg:
    .word 0

12912:lastCharRead:
    .word -2 # -2 => no buffered character
12916:prevHashConstant:
    .word 0x2785173c
12920:gcCount:
    .word 0

12924:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
12951:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
