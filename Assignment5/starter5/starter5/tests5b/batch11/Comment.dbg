    #### and $t2 contains the value 10

3608:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

3608#    jal readLogicalChar # read next character
3612#    subu $t1,$v0,'0' # convert digit to 0-9 value
3616#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
3617##...sltu $at,$t1,$t2
3621##...beq $at,$zero,3640

3624#    mul $t3,$t3,$t2 # multiply old value by 10
3625##...mult $t3,$t2
3629##...mflo $t3
3632#    addu $t3,$t3,$t1 # add in value of new digit
3636#    j digitLoop

3640:  doneDigitLoop:

    # "push back" unused character into queue
3640#    sw $v0,lastCharRead
