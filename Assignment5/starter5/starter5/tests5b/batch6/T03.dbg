    # if the object has already been moved, update the stack-value
    # via the forwarding pointer
3452#    lw $t2,-8($t1) # possible forwarding tag
3456#    bne $t2,$zero,gcNoForward1 # if not forwarding tag, go copy
3460#    lw $t2,-4($t1) # forwarding pointer: object's new address
3464#    sw $t2,4($t0) # update stack value
3468#    j gcTestIterDone1 # do next iteration

3472:  gcNoForward1:
    #########################################################
    # we actually need to copy the object into the new space
    #########################################################
