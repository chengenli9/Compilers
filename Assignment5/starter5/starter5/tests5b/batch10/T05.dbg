##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
2112:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
2112#    lw $t0,-8($s2) # get word with hash bits from this
2116#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
2120#    addu $t0,$t1

2124#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
2128:mth_equals_Object:
2128#    move $t0,$s2 # first pointer (this)
2132#    lw $t1,($sp) # second pointer
2136#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
2137##...subu $at,$t0,$t1
2141##...sltiu $t0,$at,1

2144#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
2148:mth_hashCode_String:
2148#    move $t0,$s2 # put this pointer in t0

2152#    li $t2,0 # current hash value
2156#    lw $t1,-4($t0) # negative of number of characters in string
2160#    beq $t1,$zero,done_hashCode_String # if zero length => done
2164#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
2168#    and $t0,0xfffffffc # adjust for padding
2169##...lui $at,65535
2173##...ori $at,$at,0xfffc
2177##...and $t0,$t0,$at
2180#    subu $t1,$t0,$t1 # address at end of string +12
2184:loop_hashCode_String:    
2184#    sll $t4,$t2,5 # multiply by 32
2188#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
2192#    lbu $t3,-12($t0) # current character
2196#    addu $t2,$t3 # add in current character
2200#    addu $t0,1 # go to next character's address
2204#    bne $t0,$t1,loop_hashCode_String # loop back if more
2208:done_hashCode_String:    

    # push int on stack
2208#    move $t0, $t2 # put $t2 in return slot
2212#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
2216:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
2216#    subu $sp,4
2220#    sw $ra,($sp)
    
    # get hash value
2224#    lw $t2,-12($s2) # vtable address
2228#    lw $t0,($t2) # method address
2232#    jalr $t0
2236#    subu $sp,8 # push result (int in $t0) on stack
2240#    sw $s5,4($sp)
2244#    sw $t0,($sp)

    # compute print-size of hash value
2248#    li $t0, 1
2252#    lw $t1, ($sp)
2256#    srl $t1,$t1,4
2260#    beq $t1,$zero,toString_skip_loop
2264:toString_loop_top:
2264#    addu $t0,1
2268#    srl $t1,$t1,4
2272#    bne $t1,$zero,toString_loop_top
2276:toString_skip_loop:
2276#    subu $sp,8
2280#    sw $s5,4($sp)
2284#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
2288#    lw $t2,-12($s2) # vtable address
2292#    move $t0,$t2
2296:toString_checkTagBit:
2296#    subu $t0,1
2300#    lb $t1,($t0)
2304#    and $t1,0x80
2305##...lui $at,0
2309##...ori $at,$at,0x80
2313##...and $t1,$t1,$at
2316#    beq $t1,$zero,toString_checkTagBit
2320#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
2324#    subu $sp,8
2328#    sw $t1,($sp)
2332#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
2336#    move $s7,$zero # -4 offset header word
2340#    lw $t4,8($sp) # bytes for hash value
2344#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
2348#    addu $t4,8
2352#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
2356#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

2360#    li $t0,CLASS_String # store string vtable address into ...
2364#    sw $t0,-12($s7) # ... -12 offset in object header
2368#    lw $t2,-12($s2) # our object's vtable address
2372#    lw $t5,4($sp) # number characters in prefix
2376#    lw $t1,12($sp) # number of characters in hashcode
2380#    addu $t3,$t1,$t5 # number of characters in string ...
2384#    addu $t3,1 # ... including the '@' character
2388#    subu $t0,$zero,$t3 # store negated length into ...
2392#    sw $t0,-4($s7) # ... -4 offset header word
2396#    lw $t0,-8($s7) # get -8 offset header-word
2400#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
2401##...slt $at,$t0,$zero
2405##...beq $at,$zero,2424
2408#    and $t0,0xff # mask off object's hash value ...
2409##...lui $at,0
2413##...ori $at,$at,0xff
2417##...and $t0,$t0,$at
2420#    sw $t0,-8($s7) # ... and store back into -8 header-word
2424:skipMask_toString:
2424#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
2428#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
2432#    subu $t4,$t2,$t5
2436:toString_copyLoop:    
2436#    lb $t3,($t4)
2440#    and $t3,0x7f # mask off sign bit (in case first word)
2441##...lui $at,0
2445##...ori $at,$at,0x7f
2449##...and $t3,$t3,$at
2452#    sb $t3,-8($t0)
2456#    addu $t4,1
2460#    addu $t0,1
2464#    blt $t4,$t2,toString_copyLoop
2465##...slt $at,$t4,$t2
2469##...bne $at,$zero,2436

    # copy the '@' sign
2472#    li $t3,'@'
2476#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
2480#    addu $t2,$t0,$t1 # address of last byte in string to store +8
2484#    lw $t3,20($sp) # hash code to print
2488:toString_hashCopyLoop:
2488#    and $t4,$t3,0xf
2492#    srl $t3,4
2496#    lb $t4,hexChars($t4)
2500#    sb $t4,-8($t2)
2504#    subu $t2,$t2,1
2508#    bgt $t2,$t0,toString_hashCopyLoop
2509##...slt $at,$t0,$t2
2513##...bne $at,$zero,2488

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
2516#    addu $sp,28
2520#    lw $ra,($sp)
2524#    addu $sp,4
2528#    move $t0, $s7 # return string we created
2532#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
2536:mth_equals_String:
    
    # quick test for obvious false
2536#    lw $t0,($sp) # second parameter
2540#    beq $t0,$zero,goEsFalse # go return false if null
2544#    lw $t1,-12($t0) # vtable pointer
2548#    la $t2,CLASS_String # string vtable pointer
2552#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
2556#    subu $sp,12
2560#    sw $ra,8($sp)
2564#    sw $s2,4($sp)
2568#    sw $t0,($sp)
2572#    jal mth_compareTo_String
2576#    lw $s2, 4($sp) #restore this pointer and pop parameters
2580#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
2584#    seq $t0,$t0,$zero
2585##...subu $at,$t0,$zero
2589##...sltiu $t0,$at,1

    # pop return address and return $t0
2592#    lw $ra,($sp)
2596#    addu $sp,4

2600#    jr $ra # return
    
2604:goEsFalse:
    # put 0 in $t0 and return
2604#    li $t0, 0
2608#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
2612:mth_toString_String:
    #we are a string, so return this.
2612#    move $t0, $s2
2616#    jr $ra

###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
2620:mth_readLine_Lib:
    
2620#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
2624#    sw $ra, 4($sp) # save $ra
2628#    move $t1,$sp # save "original" sp

2632:  doRead:

    # read the character
2632#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
2636#    subu $t2,$v0,13
2640#    bne $t2,$zero,notReturnRL
2644#    jal readLogicalChar
2648#    subu $t2,$v0,10 # check for newline
2652#    beq $t2,$zero,foundNewLine
2656#    sw $v0,lastCharRead # push back character into queue
2660#    j foundNewLine # go process the line

2664:  notReturnRL:

    # at this point, $v0 has our character

2664#    subu $t0,$v0,10
2668#    beq $t0,$zero,foundNewLine
2672#    blt $v0,$zero,foundEof
2673##...slt $at,$v0,$zero
2677##...bne $at,$zero,2692

    # we have a character, so push it onto stack
2680#    subu $sp,$sp,4
2684#    sw $v0,($sp)

    # loop back up to get next character
2688#    j doRead

2692:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
2692#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
2696#    li $s7, 0 # return-value: null
2700#    j rlReturn # return

2704:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
2704#    subu $t0,$t1,$sp # number of chars we read (times 4)
2708#    srl $s6,$t0,2 # number of words on stack with chars
2712#    subu $sp,$sp,4 # push char-count ...
2716#    sw $s6,($sp) # ... onto stack
2720#    addu $t2,$t0,5 # GC tag, incl. for count-word
2724#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
2728#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
2732#    srl $s6,$s6,2  # data words in object
2736#    move $s7,$zero # object words in object
2740#    jal newObject  # allocate space
    
    # store header words
2744#    la $t0,CLASS_String
2748#    sw $t0,-12($s7)# store class tag (String) into object
2752#    lw $t2,4($sp) # char-count
2756#    sll $t1,$t2,2 # 4 times number of chars
2760#    subu $t2,$zero,$t2 # negative of char-count
2764#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
2768#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
2772#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
2773##...slt $at,$t0,$zero
2777##...beq $at,$zero,2796
2780#    and $t0,0xff # mask off object's hash value ...
2781##...lui $at,0
2785##...ori $at,$at,0xff
2789##...and $t0,$t0,$at
2792#    sw $t0,-8($s7) # ... and store back into -8 header-word
2796:  skipMask_readLine:

2796#    sll $t0,$t0,2 # data bytes in object
2800#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
2804#    subu $t0,$t0,$t2 # place to store last character (plus 9)
2808#    addu $sp,$sp,8 # pop redundant object-pointer and count
2812#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

2816#    beq $sp,$t1,rlReturn
2820:  charCopyLoop:
2820#    lw $t2,($sp)
2824#    sb $t2,-9($t0)
2828#    addu $sp,$sp,4
2832#    subu $t0,$t0,1
2836#    bne $sp,$t1,charCopyLoop
2840:  rlReturn:

2840#    lw $ra, 4($sp)
2844#    addu $sp, 8   # pop $ra and pointless word off stack
2848#    move $t0, $s7 # return string we allocated in $s7
2852#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
2856:mth_readInt_Lib:

    # save $ra by pushing onto stack
2856#    subu $sp,$sp,4
2860#    sw $ra,($sp)

2864:  riSkipWhiteLoop:
    # read a character
2864#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
2868#    subu $t0,$v0,32
2872#    bgt $t0,$zero,nonWhite
2873##...slt $at,$zero,$t0
2877##...bne $at,$zero,2920
2880#    beq $t0,$zero,riSkipWhiteLoop # start over if space
2884#    subu $t0,$v0,10
2888#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
2892#    subu $t0,$v0,9
2896#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
2900#    subu $t0,$v0,13
2904#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
2908#    subu $t0,$v0,12
