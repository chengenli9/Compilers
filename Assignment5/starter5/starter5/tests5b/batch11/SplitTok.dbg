3912:toString_skip_loop:
3912#    subu $sp,8
3916#    sw $s5,4($sp)
3920#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
3924#    lw $t2,-12($s2) # vtable address
3928#    move $t0,$t2
