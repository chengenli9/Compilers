984#    lw $t0,($sp) # second parameter
988#    beq $t0,$zero,goEsFalse # go return false if null
992#    lw $t1,-12($t0) # vtable pointer
996#    la $t2,CLASS_String # string vtable pointer
1000#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
1004#    subu $sp,12
1008#    sw $ra,8($sp)
1012#    sw $s2,4($sp)
1016#    sw $t0,($sp)
1020#    jal mth_compareTo_String
1024#    lw $s2, 4($sp) #restore this pointer and pop parameters
1028#    addu $sp, 8 # pop parameters
