########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3224:divide:
    # get parameters; abort if divisor zero
3224#    lw $t0,($sp)
3228#    lw $t1,8($sp)
3232#    beq $t0,$zero,divByZeroError
    
    # perform division
3236#    div $t1,$t0
3240#    mflo $t0

    # store result, adjust stack and return
3244#    addu $sp,$sp,8 # adjust stack
3248#    sw $t0,($sp) # store result
3252#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3256:remainder:
    # get parameters; abort if divisor zero
3256#    lw $t0,($sp)
3260#    lw $t1,8($sp)
3264#    beq $t0,$zero,divByZeroError
    
    # perform division
3268#    div $t1,$t0
3272#    mfhi $t0

    # store result, adjust stack and return
3276#    addu $sp,$sp,8 # adjust stack
3280#    sw $t0,($sp) # store result
3284#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
3288:checkCast:
    # get object, allow immediately if null
3288#    lw $t2,($sp)
3292#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
3296#    lw $t2,-12($t2) # vtable address
3300#    bge $t2,$t1,castException
3301##...slt $at,$t2,$t1
3305##...beq $at,$zero,3440
3308#    blt $t2,$t0,castException
3309##...slt $at,$t2,$t0
3313##...bne $at,$zero,3440
    
    # return, leaving object unchanged on stack
3316:  checkCastReturn:    
3316#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
3320:instanceOf:
    # get object, go return false if null
3320#    lw $t2,($sp)
3324#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
3328#    lw $t2,-12($t2) # vtable address
3332#    sge $t0,$t2,$t0 # are we >= the lower limit?
3333##...slt $t0,$t2,$t0
3337##...xori $t0,$t0,0x1
3340#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
3344#    and $t2,$t0,$t1
3348#    sw $t2,($sp)
3352:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
3352#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

3356:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
3356#    li $v0,4 # syscall-code for print-string
3360#    syscall
3364:exit:
    # print termination message
3364#    li $v0,4 # syscall-code for print-string
3368#    la $a0,exitString
3372#    syscall

    # terminate execution
3376#    li $v0,10 #syscall-code for "exit"
3380#    syscall

3384:outOfHeapMemory:
3384#    la $a0,heapMemoryMsg
3388#    j exitError
3392:divByZeroError:
3392#    la $a0,divByZeroMsg
3396#    j exitError
3400:strIndexOutOfBounds:
3400#    la $a0,strIndexOutOfBoundsMsg
3404#    j exitError
3408:arrayIndexOutOfBounds:
3408#    la $a0,arrayIndexOutOfBoundsMsg
3412#    j exitError
3416:arraySizeOutOfBounds:
3416#    la $a0,arraySizeOutOfBoundsMsg
3420#    j exitError
3424:nullPtrException:
3424#    la $a0,nullPtrExceptionMsg
3428#    j exitError
3432:badIntegerFormat:
3432#    la $a0,badIntegerFormatMsg
3436#    j exitError
3440:castException:
3440#    la $a0,castExceptionMsg
3444#    j exitError
############## data section ################
    .data
3680:hexChars:
    .ascii "0123456789abcdef"
    .align 2
3696:cur_seg:
    .word 0

3700:lastCharRead:
    .word -2 # -2 => no buffered character
3704:prevHashConstant:
    .word 0x2785173c
3708:gcCount:
    .word 0

3712:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
3739:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
3762:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
3797:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
3831:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
3864:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
3895:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
3943:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
3964:gcMsg: 
      .asciiz "\nGC!\n"
3970:gcCountMsg: 
      .asciiz "Number of garbage collections: "

4002:nullStr:
    .asciiz "null"
4007:trueString:
    .asciiz "true"
4012:falseString:
    .asciiz "false"
4018:exitString:
    .ascii "Program terminated."
    #### "falls through" here
4037:newlineString:
    .asciiz "\n"
    
    .align 2
4040:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

4044:seg0_start:
    .space 0x100000
1052620:seg0_end:
1052620:seg1_start:
    .space 0x100000
2101196:seg1_end:
