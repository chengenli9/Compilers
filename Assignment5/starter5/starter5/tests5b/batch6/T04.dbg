2368#    subu $t0,$v0,9
2372#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
2376#    subu $t0,$v0,13
2380#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
2384#    subu $t0,$v0,12
