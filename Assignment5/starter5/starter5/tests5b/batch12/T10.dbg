###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
852:mth_readLine_Lib:
    
852#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
856#    sw $ra, 4($sp) # save $ra
860#    move $t1,$sp # save "original" sp

864:  doRead:

    # read the character
864#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
868#    subu $t2,$v0,13
872#    bne $t2,$zero,notReturnRL
876#    jal readLogicalChar
880#    subu $t2,$v0,10 # check for newline
884#    beq $t2,$zero,foundNewLine
888#    sw $v0,lastCharRead # push back character into queue
892#    j foundNewLine # go process the line

896:  notReturnRL:

    # at this point, $v0 has our character

896#    subu $t0,$v0,10
900#    beq $t0,$zero,foundNewLine
904#    blt $v0,$zero,foundEof
905##...slt $at,$v0,$zero
909##...bne $at,$zero,924

    # we have a character, so push it onto stack
912#    subu $sp,$sp,4
916#    sw $v0,($sp)

    # loop back up to get next character
920#    j doRead

924:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
924#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
928#    li $s7, 0 # return-value: null
932#    j rlReturn # return

936:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
936#    subu $t0,$t1,$sp # number of chars we read (times 4)
940#    srl $s6,$t0,2 # number of words on stack with chars
944#    subu $sp,$sp,4 # push char-count ...
948#    sw $s6,($sp) # ... onto stack
952#    addu $t2,$t0,5 # GC tag, incl. for count-word
956#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
960#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
964#    srl $s6,$s6,2  # data words in object
968#    move $s7,$zero # object words in object
972#    jal newObject  # allocate space
    
    # store header words
976#    la $t0,CLASS_String
980#    sw $t0,-12($s7)# store class tag (String) into object
984#    lw $t2,4($sp) # char-count
988#    sll $t1,$t2,2 # 4 times number of chars
992#    subu $t2,$zero,$t2 # negative of char-count
996#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
1000#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
1004#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
1005##...slt $at,$t0,$zero
1009##...beq $at,$zero,1028
1012#    and $t0,0xff # mask off object's hash value ...
1013##...lui $at,0
1017##...ori $at,$at,0xff
1021##...and $t0,$t0,$at
1024#    sw $t0,-8($s7) # ... and store back into -8 header-word
1028:  skipMask_readLine:

1028#    sll $t0,$t0,2 # data bytes in object
1032#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
1036#    subu $t0,$t0,$t2 # place to store last character (plus 9)
1040#    addu $sp,$sp,8 # pop redundant object-pointer and count
1044#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

1048#    beq $sp,$t1,rlReturn
1052:  charCopyLoop:
1052#    lw $t2,($sp)
1056#    sb $t2,-9($t0)
1060#    addu $sp,$sp,4
1064#    subu $t0,$t0,1
1068#    bne $sp,$t1,charCopyLoop
1072:  rlReturn:

1072#    lw $ra, 4($sp)
1076#    addu $sp, 8   # pop $ra and pointless word off stack
1080#    move $t0, $s7 # return string we allocated in $s7
1084#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
1088:mth_readInt_Lib:

    # save $ra by pushing onto stack
1088#    subu $sp,$sp,4
1092#    sw $ra,($sp)

1096:  riSkipWhiteLoop:
    # read a character
1096#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
1100#    subu $t0,$v0,32
1104#    bgt $t0,$zero,nonWhite
1105##...slt $at,$zero,$t0
1109##...bne $at,$zero,1152
1112#    beq $t0,$zero,riSkipWhiteLoop # start over if space
1116#    subu $t0,$v0,10
1120#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
1124#    subu $t0,$v0,9
1128#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
1132#    subu $t0,$v0,13
1136#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
1140#    subu $t0,$v0,12
1144#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
1148#    j badIntegerFormat # illegal integer char: abort program

1152:  nonWhite:
1152#    subu $t0,$v0,'-'
1156#    li $t4,1 # final multiplier
1160#    bne $t0,$zero,helpReadInt # go read
1164#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
1168#    jal readLogicalChar

1172:  helpReadInt:
1172#    li $t2,10
1176#    subu $t1,$v0,'0' # convert digit to 0-9 value
1180#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
1181##...sltu $at,$t1,$t2
1185##...beq $at,$zero,3432
1188#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

1192:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

1192#    jal readLogicalChar # read next character
1196#    subu $t1,$v0,'0' # convert digit to 0-9 value
1200#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
1201##...sltu $at,$t1,$t2
1205##...beq $at,$zero,1224

1208#    mul $t3,$t3,$t2 # multiply old value by 10
1209##...mult $t3,$t2
1213##...mflo $t3
1216#    addu $t3,$t3,$t1 # add in value of new digit
1220#    j digitLoop

1224:  doneDigitLoop:

    # "push back" unused character into queue
1224#    sw $v0,lastCharRead

    # restore return address
1228#    lw $ra,($sp)
1232#    addu $sp, 4

    # multiply by sign and put return value in $t0
1236#    mult $t3,$t4 # multiply to account for poss. minus sign
1240#    mflo $t3
1244#    move $t0, $t3
    
    # return
1248#    jr $ra

###################################################################
# readChar() - library method (class Lib)
# - reads a single character from standard input
# - returns the integer that is the encoding of the character
# - returns -1 if end of file was encountered
# - parameter:
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
1252:mth_readChar_Lib:
