960#    seq $t0,$t0,$zero
961##...subu $at,$t0,$zero
965##...sltiu $t0,$at,1

    # pop return address and return $t0
968#    lw $ra,($sp)
972#    addu $sp,4

976#    jr $ra # return
    
980:goEsFalse:
    # put 0 in $t0 and return
980#    li $t0, 0
984#    jr $ra # return
