2284#    slt $t5,$t4,$t3 # 1 if str2 > str1, else 0
2288#    sll $t5,$t5,1 # 2 if str2 > str1, else 0
2292#    subu $t5,$t5,1 # 1 if str2 > str1, else -1
2296:  cmpHitLimitzz:
2296#    move $t0, $t5 # store return value
2300#    jr $ra # return
