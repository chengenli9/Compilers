.data

# we'll use this as the input to our program.
# we can make more constants if we need them.
100:val:
.word 42

# at the end of our program we'll store the result here.
104:answer:
.word 0

.text

### Code starts here
0:main:

# answer = (val + 1) * (val - 2) 

  # (val + 1)
0#  lw $t1, val
4#  li $t2, 1
8#  addu $t0, $t1, $t2

12#  subu $sp, $sp, 4
16#  sw $t0, ($sp)

  # (val - 2) 
20#  lw $t1, val
24#  li $t2, 2
28#  subu $t0, $t1, $t2

32#  subu $sp, $sp, 4
36#  sw $t0, ($sp)

40#  lw $t2, ($sp)
44#  addu $sp, $sp, 4
48#  lw $t1, ($sp)
52#  addu $sp, $sp, 4

  # (val + 1) * (val - 2) 
56#  mul $t0, $t1, $t2
57##...mult $t1,$t2
61##...mflo $t0



64#  sw $t0, answer


  ### End of program,
  ### Print the answer, and \n, then exit

  # print value stored in answer
68#  li $v0,1
72#  lw $a0,answer
76#  syscall

  # print newline
80#  li $v0,11
84#  li $a0,10
88#  syscall

  # exit the program
92#  li $v0,10
96#  syscall
