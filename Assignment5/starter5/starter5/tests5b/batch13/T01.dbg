    #   'newObject'
    # We want to set things up so that in addition:
    # - $t0 is the "trailing finger", containing the address
    #   of the first slot in target space that we have yet
    #   to process.
    # Then during processing:
    # - $t1 will contain the contents of the heap slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # And when we're actually copying an object:
    # - $t2 will contain pointer to the target object
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - available for use: $s0
    ##########################################################

    # set $t0 to be at the beginning of target-space
3968#    lw $t1,cur_seg
3972#    la $t0,seg0_start
3976#    beq $t1,$zero,gcSkip4
3980#    la $t0,seg1_start
3981##...lui $t0,16
3985##...addiu $t0,$t0,5188


3988:  gcSkip4:

    # if there were no objects put into the heap during stack
    # processing, we're done, so go finish up
3988#    bgeu $t0,$s3,gcFinishUp
3989##...sltu $at,$t0,$s3
3993##...beq $at,$zero,4284

    ###### begin outer loop to copy all non-stack-direct objects ######

3996:  gcHeapCopyLoop:
    # get data count for object; swap header-word with first word
    # of object so that they're back in the right place
3996#    lw $t1,($t0) # (what will be) first header word for current object
4000#    move $t2,$t1 # number data bytes in object (poss. w/hash bits)
4004#    bge $t2,$zero,gcSkip4a # are there hash bits?
4005##...slt $at,$t2,$zero
4009##...beq $at,$zero,4024
4012#    and $t2,0xff # mask off hash bits
4013##...lui $at,0
4017##...ori $at,$at,0xff
4021##...and $t2,$t2,$at
4024:gcSkip4a:    
4024#    sll $t2,$t2,2 # # data bytes
4028#    addu $t2,$t2,8 # to skip header words
4032#    addu $t2,$t0,$t2 # pointer to new object
4036#    lw $t3,-8($t2) # word to swap
4040#    sw $t1,-8($t2) # store header word
4044#    sw $t3,($t0) # restore first word of object

    ################################################
    # at this point:
    # - $t2 contains the pointer to our new object
    ################################################

    # check if we have a data array
4048#    lw $t1,-12($t2) # vtable pointer
4052#    li $t0,dataArrayVTableStart # address of vtable for first data array
4056#    blt $t1,$t0,gcNotDataArray # if data array, no more xforming to do
4057##...slt $at,$t1,$t0
4061##...bne $at,$zero,4080

    # We have a vtable address that is a data array.
    # we need skip over it then loop back to do next object.
4064:  skipToNextObj:
4064#    lw $t1,-4($t2) # data words in (object position of) array
    #### note: we know that it's not a string, so the value will
    #### not be artificially negative
4068#    sll $t1,$t1,2 # convert to byte-count
4072#    addu $t0,$t2,$t1 # skip over object
4076#    j gcTestIterDone2 # go do next object, if any

    ###################################################
    # at this point:
    # - the object has been restored to normal status--that is, the
    #   word-swap has been done
    # - $t2 contains a pointer to the object
    ###################################################
    
4080:  gcNotDataArray:
4080#    lw $t3,-4($t2) # # object words (negative treated as zero)
4084#    bge $t3,$zero,gcH2Neg2
4085##...slt $at,$t3,$zero
4089##...beq $at,$zero,4096
4092#    move $t3,$zero
4096:  gcH2Neg2:
4096#    sll $t3,$t3,2 # # object bytes
4100#    move $t0,$t2 # address of first pointer in object
4104#    add $s1,$t2,$t3 # limit address for this object

    #####################################################
    # At this point, we have to "translate" all pointers,
    # starting at $t0 to (but not including) $s1
    #####################################################

    # if there are no pointer-slots (i.e., $t0=$s1), skip this
    # part
4108#    beq $t0,$s1,gcTestIterDone2
    
4112:  gcNextPointerInObject:
    # get pointer from object
4112#    lw $t1,($t0)

    # if value is out of range, and is therefore does not refer
    # to an object, just go loop back and do the next one
4116#    bleu $t1,$t6,gcGoNextPointerSlot
4117##...sltu $at,$t6,$t1
4121##...beq $at,$zero,4264
4124#    bgtu $t1,$t7,gcGoNextPointerSlot
4125##...sltu $at,$t7,$t1
4129##...bne $at,$zero,4264

    # if the object has already been moved, update the stack-value
    # via the forwarding pointer
4132#    lw $t8,-8($t1) # possible forwarding tag
4136#    bne $t8,$zero,gcNoForward2 # if not forwarding tag, go copy
4140#    lw $t8,-4($t1) # forwarding pointer: object's new address
4144#    sw $t8,($t0) # update pointer in object
4148#    j gcGoNextPointerSlot # do next iteration

4152:  gcNoForward2:
    #########################################################
    # we actually need to copy the object into the new space
    #########################################################

    #########################################################
    # At this point:
    # - $t0 contains the address of the heap-slot we're translating
    # - $t1 will contain the contents of the heap-slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space, which will also be the first address
    #   of the target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # Then during processing:
    # And when we're actually copying an object:
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $t8 will contain a pointer to the target object
    # - available for use: $s0, $t8, $t9
    ##########################################################

    # compute the amount of space that is needed
4152#    bge $t8,$zero,gcSkip5 # # words in negative-offset portion
4153##...slt $at,$t8,$zero
4157##...beq $at,$zero,4172
4160#    and $t8,0xff # mask off hash bits
4161##...lui $at,0
4165##...ori $at,$at,0xff
4169##...and $t8,$t8,$at

4172:  gcSkip5:
4172#    sll $t8,$t8,2 # bytes in negative-offset portion ...
4176#    addu $t8,$t8,8 # ... add in bytes for header-words
4180#    subu $t4,$t1,$t8 # address of first word of source object
4184#    lw $t3,-4($t1) # # words in positive-offset portion
4188#    bge $t3,$zero,gcNoNeg
4189##...slt $at,$t3,$zero
4193##...beq $at,$zero,4200
4196#    move $t3,$zero # negative treated as zero
4200:  gcNoNeg:
4200#    sll $t3,$t3,2 # bytes in negative-offset portion
4204#    addu $t3,$t3,$t1 # address one word past last word of source

4208#    addu $t8,$s3,$t8 # pointer to target object

    #########################################################
    # At this point:
    # - $t0 contains the address of the stack slot we'll
    #   process next
    # - $t1 contains the contents of the stack slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $t8 contains the pointer to the target object
    # - $s1 contains the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0, $t9
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger"
4212#    lw $s0,($t4)
4216#    lw $t9,-8($t1)
4220#    sw $t9,($t4)
4224#    sw $s0,-8($t1)

    # copy all source bytes to the target
4228:  gCinnerCopy2:
4228#    lw $s0,($t4)
4232#    sw $s0,($s3)
4236#    addu $t4,$t4,4
4240#    addu $s3,$s3,4
4244#    bltu $t4,$t3,gCinnerCopy2
4245##...sltu $at,$t4,$t3
4249##...bne $at,$zero,4228

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
4252#    sw $zero,-8($t1) # 0 in first header-slot
4256#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
4260#    sw $t8,($t0)

4264:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
4264#    addu $t0,$t0,4
4268#    bltu $t0,$s1,gcNextPointerInObject
4269##...sltu $at,$t0,$s1
4273##...bne $at,$zero,4112

4276:  gcTestIterDone2:
4276#    bltu $t0,$s3,gcHeapCopyLoop
4277##...sltu $at,$t0,$s3
4281##...bne $at,$zero,3996

    ###### end outer loop to copy all non-stack-direct objects ######

4284:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
4284#    lw $s2,($sp)
4288#    addu $sp,$sp,4

    # mark us as having already GC'd
4292#    move $t5,$s5

    # go try and allocate again
4296#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
4300:vm_init:

    # mark bottom of stack
4300#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
4304#    move $s2,$zero

    #set up the "five" register
4308#    li $s5,5

4312#    la $s3,seg0_start
4316#    la $s4,seg0_end
4317##...lui $s4,16
4321##...addiu $s4,$s4,5188
    
    # return
4324#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4328:divide:
    # get parameters; abort if divisor zero
4328#    lw $t0,($sp)
4332#    lw $t1,8($sp)
4336#    beq $t0,$zero,divByZeroError
    
    # perform division
4340#    div $t1,$t0
4344#    mflo $t0

    # store result, adjust stack and return
4348#    addu $sp,$sp,8 # adjust stack
4352#    sw $t0,($sp) # store result
4356#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4360:remainder:
    # get parameters; abort if divisor zero
4360#    lw $t0,($sp)
4364#    lw $t1,8($sp)
4368#    beq $t0,$zero,divByZeroError
    
    # perform division
4372#    div $t1,$t0
4376#    mfhi $t0

    # store result, adjust stack and return
4380#    addu $sp,$sp,8 # adjust stack
4384#    sw $t0,($sp) # store result
4388#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
4392:checkCast:
    # get object, allow immediately if null
4392#    lw $t2,($sp)
4396#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
4400#    lw $t2,-12($t2) # vtable address
4404#    bge $t2,$t1,castException
4405##...slt $at,$t2,$t1
4409##...beq $at,$zero,4580
4412#    blt $t2,$t0,castException
4413##...slt $at,$t2,$t0
4417##...bne $at,$zero,4580
    
    # return, leaving object unchanged on stack
4420:  checkCastReturn:    
4420#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
4424:instanceOf:
    # get object, go return false if null
4424#    lw $t2,($sp)
4428#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
4432#    lw $t2,-12($t2) # vtable address
4436#    sge $t0,$t2,$t0 # are we >= the lower limit?
4437##...slt $t0,$t2,$t0
4441##...xori $t0,$t0,0x1
4444#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
4448#    and $t2,$t0,$t1
4452#    sw $t2,($sp)
4456:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
4456#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

4460:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
4460#    li $v0,4 # syscall-code for print-string
4464#    syscall
4468:exit:
    # print termination message
4468#    li $v0,4 # syscall-code for print-string
4472#    la $a0,exitString
4476#    syscall

    # print number of garbage collections
4480#    li $v0,4 # syscall-code for print-string
4484#    la $a0,gcCountMsg
4488#    syscall # print "Number of ..."
4492#    lw $a0,gcCount # number of GC's
4496#    li $v0,1 # code for print-int
4500#    syscall
4504#    li $v0,4 # syscall-code for print-string
4508#    la $a0,newlineString
4512#    syscall # print newline

    # terminate execution
4516#    li $v0,10 #syscall-code for "exit"
4520#    syscall

4524:outOfHeapMemory:
4524#    la $a0,heapMemoryMsg
4528#    j exitError
4532:divByZeroError:
4532#    la $a0,divByZeroMsg
4536#    j exitError
4540:strIndexOutOfBounds:
4540#    la $a0,strIndexOutOfBoundsMsg
4544#    j exitError
4548:arrayIndexOutOfBounds:
4548#    la $a0,arrayIndexOutOfBoundsMsg
4552#    j exitError
4556:arraySizeOutOfBounds:
4556#    la $a0,arraySizeOutOfBoundsMsg
4560#    j exitError
4564:nullPtrException:
4564#    la $a0,nullPtrExceptionMsg
4568#    j exitError
4572:badIntegerFormat:
4572#    la $a0,badIntegerFormatMsg
4576#    j exitError
4580:castException:
4580#    la $a0,castExceptionMsg
4584#    j exitError
############## data section ################
    .data
4816:hexChars:
    .ascii "0123456789abcdef"
    .align 2
4832:cur_seg:
    .word 0

4836:lastCharRead:
    .word -2 # -2 => no buffered character
4840:prevHashConstant:
    .word 0x2785173c
4844:gcCount:
    .word 0

4848:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
4875:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
4898:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
4933:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
4967:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
5000:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
5031:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
5079:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
5100:gcMsg: 
      .asciiz "\nGC!\n"
5106:gcCountMsg: 
      .asciiz "Number of garbage collections: "

5138:nullStr:
    .asciiz "null"
5143:trueString:
    .asciiz "true"
5148:falseString:
    .asciiz "false"
5154:exitString:
    .ascii "Program execution completed."
    #### "falls through" here
5182:newlineString:
    .asciiz "\n"
    
    .align 2
5184:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

5188:seg0_start:
    .space 0x100000
1053764:seg0_end:
1053764:seg1_start:
    .space 0x100000
2102340:seg1_end:
