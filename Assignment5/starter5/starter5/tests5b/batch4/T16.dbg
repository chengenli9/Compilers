########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
5712:vm_init:

    # mark bottom of stack
5712#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
5716#    move $s2,$zero

    #set up the "five" register
5720#    li $s5,5

5724#    la $s3,seg0_start
5728#    la $s4,seg0_end
5729##...lui $s4,16
5733##...addiu $s4,$s4,7012
    
    # return
5736#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
5740:divide:
    # get parameters; abort if divisor zero
5740#    lw $t0,($sp)
5744#    lw $t1,8($sp)
5748#    beq $t0,$zero,divByZeroError
    
    # perform division
5752#    div $t1,$t0
5756#    mflo $t0

    # store result, adjust stack and return
5760#    addu $sp,$sp,8 # adjust stack
5764#    sw $t0,($sp) # store result
5768#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
5772:remainder:
    # get parameters; abort if divisor zero
5772#    lw $t0,($sp)
5776#    lw $t1,8($sp)
5780#    beq $t0,$zero,divByZeroError
    
    # perform division
5784#    div $t1,$t0
5788#    mfhi $t0

    # store result, adjust stack and return
5792#    addu $sp,$sp,8 # adjust stack
5796#    sw $t0,($sp) # store result
5800#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
5804:checkCast:
    # get object, allow immediately if null
5804#    lw $t2,($sp)
5808#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
5812#    lw $t2,-12($t2) # vtable address
5816#    bge $t2,$t1,castException
5817##...slt $at,$t2,$t1
5821##...beq $at,$zero,5956
5824#    blt $t2,$t0,castException
5825##...slt $at,$t2,$t0
5829##...bne $at,$zero,5956
    
    # return, leaving object unchanged on stack
5832:  checkCastReturn:    
5832#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
5836:instanceOf:
    # get object, go return false if null
5836#    lw $t2,($sp)
5840#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
5844#    lw $t2,-12($t2) # vtable address
5848#    sge $t0,$t2,$t0 # are we >= the lower limit?
5849##...slt $t0,$t2,$t0
5853##...xori $t0,$t0,0x1
5856#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
5860#    and $t2,$t0,$t1
5864#    sw $t2,($sp)
5868:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
5868#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

5872:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
5872#    li $v0,4 # syscall-code for print-string
5876#    syscall
5880:exit:
    # print termination message
5880#    li $v0,4 # syscall-code for print-string
5884#    la $a0,exitString
5888#    syscall

    # terminate execution
5892#    li $v0,10 #syscall-code for "exit"
5896#    syscall

5900:outOfHeapMemory:
5900#    la $a0,heapMemoryMsg
5904#    j exitError
5908:divByZeroError:
5908#    la $a0,divByZeroMsg
5912#    j exitError
5916:strIndexOutOfBounds:
5916#    la $a0,strIndexOutOfBoundsMsg
5920#    j exitError
5924:arrayIndexOutOfBounds:
5924#    la $a0,arrayIndexOutOfBoundsMsg
5928#    j exitError
5932:arraySizeOutOfBounds:
5932#    la $a0,arraySizeOutOfBoundsMsg
5936#    j exitError
5940:nullPtrException:
5940#    la $a0,nullPtrExceptionMsg
5944#    j exitError
5948:badIntegerFormat:
5948#    la $a0,badIntegerFormatMsg
5952#    j exitError
5956:castException:
5956#    la $a0,castExceptionMsg
5960#    j exitError
############## data section ################
    .data
6648:hexChars:
    .ascii "0123456789abcdef"
    .align 2
6664:cur_seg:
    .word 0

6668:lastCharRead:
    .word -2 # -2 => no buffered character
6672:prevHashConstant:
    .word 0x2785173c
6676:gcCount:
    .word 0

6680:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
6707:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
6730:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
6765:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
6799:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
6832:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
6863:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
6911:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
6932:gcMsg: 
      .asciiz "\nGC!\n"
6938:gcCountMsg: 
      .asciiz "Number of garbage collections: "

6970:nullStr:
    .asciiz "null"
6975:trueString:
    .asciiz "true"
6980:falseString:
    .asciiz "false"
6986:exitString:
    .ascii "Program terminated."
    #### "falls through" here
7005:newlineString:
    .asciiz "\n"
    
    .align 2
7008:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

7012:seg0_start:
    .space 0x100000
1055588:seg0_end:
1055588:seg1_start:
