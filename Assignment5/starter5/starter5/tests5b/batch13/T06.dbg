##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
892:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
892#    lw $t0,-8($s2) # get word with hash bits from this
896#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
900#    addu $t0,$t1

904#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
908:mth_equals_Object:
908#    move $t0,$s2 # first pointer (this)
912#    lw $t1,($sp) # second pointer
916#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
917##...subu $at,$t0,$t1
921##...sltiu $t0,$at,1

924#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
928:mth_hashCode_String:
928#    move $t0,$s2 # put this pointer in t0

932#    li $t2,0 # current hash value
936#    lw $t1,-4($t0) # negative of number of characters in string
940#    beq $t1,$zero,done_hashCode_String # if zero length => done
944#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
948#    and $t0,0xfffffffc # adjust for padding
949##...lui $at,65535
953##...ori $at,$at,0xfffc
957##...and $t0,$t0,$at
960#    subu $t1,$t0,$t1 # address at end of string +12
964:loop_hashCode_String:    
964#    sll $t4,$t2,5 # multiply by 32
968#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
972#    lbu $t3,-12($t0) # current character
976#    addu $t2,$t3 # add in current character
980#    addu $t0,1 # go to next character's address
984#    bne $t0,$t1,loop_hashCode_String # loop back if more
988:done_hashCode_String:    

    # push int on stack
988#    move $t0, $t2 # put $t2 in return slot
992#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
996:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
996#    subu $sp,4
1000#    sw $ra,($sp)
    
    # get hash value
1004#    lw $t2,-12($s2) # vtable address
1008#    lw $t0,($t2) # method address
1012#    jalr $t0
1016#    subu $sp,8 # push result (int in $t0) on stack
1020#    sw $s5,4($sp)
1024#    sw $t0,($sp)

    # compute print-size of hash value
1028#    li $t0, 1
1032#    lw $t1, ($sp)
1036#    srl $t1,$t1,4
1040#    beq $t1,$zero,toString_skip_loop
1044:toString_loop_top:
1044#    addu $t0,1
1048#    srl $t1,$t1,4
1052#    bne $t1,$zero,toString_loop_top
1056:toString_skip_loop:
1056#    subu $sp,8
1060#    sw $s5,4($sp)
1064#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
1068#    lw $t2,-12($s2) # vtable address
1072#    move $t0,$t2
1076:toString_checkTagBit:
1076#    subu $t0,1
1080#    lb $t1,($t0)
1084#    and $t1,0x80
1085##...lui $at,0
1089##...ori $at,$at,0x80
1093##...and $t1,$t1,$at
1096#    beq $t1,$zero,toString_checkTagBit
1100#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
1104#    subu $sp,8
1108#    sw $t1,($sp)
1112#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
1116#    move $s7,$zero # -4 offset header word
1120#    lw $t4,8($sp) # bytes for hash value
1124#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
1128#    addu $t4,8
1132#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
1136#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

1140#    li $t0,CLASS_String # store string vtable address into ...
1144#    sw $t0,-12($s7) # ... -12 offset in object header
1148#    lw $t2,-12($s2) # our object's vtable address
1152#    lw $t5,4($sp) # number characters in prefix
1156#    lw $t1,12($sp) # number of characters in hashcode
1160#    addu $t3,$t1,$t5 # number of characters in string ...
1164#    addu $t3,1 # ... including the '@' character
1168#    subu $t0,$zero,$t3 # store negated length into ...
1172#    sw $t0,-4($s7) # ... -4 offset header word
1176#    lw $t0,-8($s7) # get -8 offset header-word
