    #   middle of translating
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space, which will also be the first address
    #   of the target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # Then during processing:
    # And when we're actually copying an object:
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $t8 will contain a pointer to the target object
    # - available for use: $s0, $t8, $t9
    ##########################################################

    # compute the amount of space that is needed
14096#    bge $t8,$zero,gcSkip5 # # words in negative-offset portion
14097##...slt $at,$t8,$zero
14101##...beq $at,$zero,14116
14104#    and $t8,0xff # mask off hash bits
14105##...lui $at,0
14109##...ori $at,$at,0xff
14113##...and $t8,$t8,$at

14116:  gcSkip5:
14116#    sll $t8,$t8,2 # bytes in negative-offset portion ...
14120#    addu $t8,$t8,8 # ... add in bytes for header-words
14124#    subu $t4,$t1,$t8 # address of first word of source object
14128#    lw $t3,-4($t1) # # words in positive-offset portion
14132#    bge $t3,$zero,gcNoNeg
14133##...slt $at,$t3,$zero
14137##...beq $at,$zero,14144
14140#    move $t3,$zero # negative treated as zero
14144:  gcNoNeg:
14144#    sll $t3,$t3,2 # bytes in negative-offset portion
14148#    addu $t3,$t3,$t1 # address one word past last word of source

14152#    addu $t8,$s3,$t8 # pointer to target object

    #########################################################
    # At this point:
    # - $t0 contains the address of the stack slot we'll
    #   process next
    # - $t1 contains the contents of the stack slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $t8 contains the pointer to the target object
    # - $s1 contains the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0, $t9
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger"
14156#    lw $s0,($t4)
14160#    lw $t9,-8($t1)
14164#    sw $t9,($t4)
14168#    sw $s0,-8($t1)

    # copy all source bytes to the target
14172:  gCinnerCopy2:
14172#    lw $s0,($t4)
14176#    sw $s0,($s3)
14180#    addu $t4,$t4,4
14184#    addu $s3,$s3,4
14188#    bltu $t4,$t3,gCinnerCopy2
14189##...sltu $at,$t4,$t3
14193##...bne $at,$zero,14172

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
14196#    sw $zero,-8($t1) # 0 in first header-slot
14200#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
14204#    sw $t8,($t0)

14208:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
14208#    addu $t0,$t0,4
14212#    bltu $t0,$s1,gcNextPointerInObject
14213##...sltu $at,$t0,$s1
14217##...bne $at,$zero,14056

14220:  gcTestIterDone2:
14220#    bltu $t0,$s3,gcHeapCopyLoop
14221##...sltu $at,$t0,$s3
14225##...bne $at,$zero,13940

    ###### end outer loop to copy all non-stack-direct objects ######

14228:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
14228#    lw $s2,($sp)
14232#    addu $sp,$sp,4

    # mark us as having already GC'd
14236#    move $t5,$s5

    # go try and allocate again
14240#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
14244:vm_init:

    # mark bottom of stack
14244#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
14248#    move $s2,$zero

    #set up the "five" register
14252#    li $s5,5

14256#    la $s3,seg0_start
14260#    la $s4,seg0_end
14261##...lui $s4,16
14265##...addiu $s4,$s4,16368
    
    # return
14268#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
14272:divide:
    # get parameters; abort if divisor zero
14272#    lw $t0,($sp)
14276#    lw $t1,8($sp)
14280#    beq $t0,$zero,divByZeroError
    
    # perform division
14284#    div $t1,$t0
14288#    mflo $t0

    # store result, adjust stack and return
14292#    addu $sp,$sp,8 # adjust stack
14296#    sw $t0,($sp) # store result
14300#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
14304:remainder:
    # get parameters; abort if divisor zero
14304#    lw $t0,($sp)
14308#    lw $t1,8($sp)
14312#    beq $t0,$zero,divByZeroError
    
    # perform division
14316#    div $t1,$t0
14320#    mfhi $t0

    # store result, adjust stack and return
14324#    addu $sp,$sp,8 # adjust stack
14328#    sw $t0,($sp) # store result
14332#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
14336:checkCast:
    # get object, allow immediately if null
14336#    lw $t2,($sp)
14340#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
14344#    lw $t2,-12($t2) # vtable address
14348#    bge $t2,$t1,castException
14349##...slt $at,$t2,$t1
14353##...beq $at,$zero,14524
14356#    blt $t2,$t0,castException
14357##...slt $at,$t2,$t0
14361##...bne $at,$zero,14524
    
    # return, leaving object unchanged on stack
14364:  checkCastReturn:    
14364#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
14368:instanceOf:
    # get object, go return false if null
14368#    lw $t2,($sp)
14372#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
14376#    lw $t2,-12($t2) # vtable address
14380#    sge $t0,$t2,$t0 # are we >= the lower limit?
14381##...slt $t0,$t2,$t0
14385##...xori $t0,$t0,0x1
14388#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
14392#    and $t2,$t0,$t1
14396#    sw $t2,($sp)
14400:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
14400#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

14404:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
14404#    li $v0,4 # syscall-code for print-string
14408#    syscall
14412:exit:
    # print termination message
14412#    li $v0,4 # syscall-code for print-string
14416#    la $a0,exitString
14420#    syscall

    # print number of garbage collections
14424#    li $v0,4 # syscall-code for print-string
14428#    la $a0,gcCountMsg
14432#    syscall # print "Number of ..."
14436#    lw $a0,gcCount # number of GC's
14440#    li $v0,1 # code for print-int
14444#    syscall
14448#    li $v0,4 # syscall-code for print-string
14452#    la $a0,newlineString
14456#    syscall # print newline

    # terminate execution
14460#    li $v0,10 #syscall-code for "exit"
14464#    syscall

14468:outOfHeapMemory:
14468#    la $a0,heapMemoryMsg
14472#    j exitError
14476:divByZeroError:
14476#    la $a0,divByZeroMsg
14480#    j exitError
14484:strIndexOutOfBounds:
14484#    la $a0,strIndexOutOfBoundsMsg
14488#    j exitError
14492:arrayIndexOutOfBounds:
14492#    la $a0,arrayIndexOutOfBoundsMsg
14496#    j exitError
14500:arraySizeOutOfBounds:
14500#    la $a0,arraySizeOutOfBoundsMsg
14504#    j exitError
14508:nullPtrException:
14508#    la $a0,nullPtrExceptionMsg
14512#    j exitError
14516:badIntegerFormat:
14516#    la $a0,badIntegerFormatMsg
14520#    j exitError
14524:castException:
14524#    la $a0,castExceptionMsg
14528#    j exitError
############## data section ################
    .data
15996:hexChars:
    .ascii "0123456789abcdef"
    .align 2
16012:cur_seg:
    .word 0

16016:lastCharRead:
    .word -2 # -2 => no buffered character
16020:prevHashConstant:
    .word 0x2785173c
16024:gcCount:
    .word 0

16028:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
16055:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
16078:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
16113:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
16147:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
16180:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
16211:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
16259:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
16280:gcMsg: 
      .asciiz "\nGC!\n"
16286:gcCountMsg: 
      .asciiz "Number of garbage collections: "

16318:nullStr:
    .asciiz "null"
16323:trueString:
    .asciiz "true"
16328:falseString:
    .asciiz "false"
16334:exitString:
    .ascii "Program execution completed."
    #### "falls through" here
16362:newlineString:
    .asciiz "\n"
    
    .align 2
16364:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

16368:seg0_start:
    .space 0x100000
1064944:seg0_end:
1064944:seg1_start:
    .space 0x100000
2113520:seg1_end:
