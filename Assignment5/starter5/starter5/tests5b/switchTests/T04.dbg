2804#    lw $t0,($sp) # second string
2808#    beq $t0,$zero,nullPtrException
2812#    move $t1,$s2 # first string
    
    # get (negatives of) respective byte-lengths
2816#    lw $t2,-4($t0) # negative length of second string
2820#    lw $t3,-4($t1) # negative length of first string

