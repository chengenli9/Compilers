2609##...lui $at,0
2613##...ori $at,$at,0x80
2617##...and $t1,$t1,$at
2620#    beq $t1,$zero,toString_checkTagBit
2624#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
2628#    subu $sp,8
2632#    sw $t1,($sp)
2636#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
2640#    move $s7,$zero # -4 offset header word
2644#    lw $t4,8($sp) # bytes for hash value
2648#    addu $t4,$t1 # bytes for prefix
