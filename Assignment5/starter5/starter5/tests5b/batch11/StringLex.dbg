.globl main
0:main:
0#  jal vm_init
4#  li $s6, 1
8#  li $s7, 0
12#  jal newObject
16#  la $t0, CLASS_Main
20#  sw $t0, -12($s7)
24#  addu $sp,$sp,4
28#  move $s2, $s7
32#  subu $sp, $sp, 4
36#  sw $s2, ($sp)
40#  jal mth_main_Main
44#  addu $sp, $sp, 4
48#  li $v0, 10
52#  syscall
.globl mth_main_Main
56:mth_main_Main:
56# subu $sp, $sp, 4
60# sw $ra, ($sp)
