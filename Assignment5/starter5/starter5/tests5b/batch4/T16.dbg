
    # we have our character from the buffer. Wipe out
    # buffer and return
4916#    sw $t0,lastCharRead # store -2 into buffer (i.e. "empty")
4920#    jr $ra # return
    
4924:  doReadCh:
    # we need to actually read a character: read and return
4924#    li $v0,12 # use system call to read a character
4928#    syscall
4932#    jr $ra # return
