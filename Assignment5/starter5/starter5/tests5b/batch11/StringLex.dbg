    #   object that tells where the pointers in the object end
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0, $t9
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger"
19324#    lw $s0,($t4)
19328#    lw $t9,-8($t1)
19332#    sw $t9,($t4)
19336#    sw $s0,-8($t1)

    # copy all source bytes to the target
19340:  gCinnerCopy2:
19340#    lw $s0,($t4)
19344#    sw $s0,($s3)
19348#    addu $t4,$t4,4
19352#    addu $s3,$s3,4
19356#    bltu $t4,$t3,gCinnerCopy2
19357##...sltu $at,$t4,$t3
19361##...bne $at,$zero,19340

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
19364#    sw $zero,-8($t1) # 0 in first header-slot
19368#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
19372#    sw $t8,($t0)

19376:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
19376#    addu $t0,$t0,4
19380#    bltu $t0,$s1,gcNextPointerInObject
19381##...sltu $at,$t0,$s1
19385##...bne $at,$zero,19224

19388:  gcTestIterDone2:
19388#    bltu $t0,$s3,gcHeapCopyLoop
19389##...sltu $at,$t0,$s3
19393##...bne $at,$zero,19108

    ###### end outer loop to copy all non-stack-direct objects ######

19396:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
19396#    lw $s2,($sp)
19400#    addu $sp,$sp,4

    # mark us as having already GC'd
19404#    move $t5,$s5

    # go try and allocate again
19408#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
19412:vm_init:

    # mark bottom of stack
19412#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
19416#    move $s2,$zero

    #set up the "five" register
19420#    li $s5,5

19424#    la $s3,seg0_start
19428#    la $s4,seg0_end
19429##...lui $s4,16
19433##...addiu $s4,$s4,21956
    
    # return
19436#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
19440:divide:
    # get parameters; abort if divisor zero
19440#    lw $t0,($sp)
19444#    lw $t1,8($sp)
19448#    beq $t0,$zero,divByZeroError
    
    # perform division
19452#    div $t1,$t0
19456#    mflo $t0

    # store result, adjust stack and return
19460#    addu $sp,$sp,8 # adjust stack
19464#    sw $t0,($sp) # store result
19468#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
19472:remainder:
    # get parameters; abort if divisor zero
19472#    lw $t0,($sp)
19476#    lw $t1,8($sp)
19480#    beq $t0,$zero,divByZeroError
    
    # perform division
19484#    div $t1,$t0
19488#    mfhi $t0

    # store result, adjust stack and return
19492#    addu $sp,$sp,8 # adjust stack
19496#    sw $t0,($sp) # store result
19500#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
19504:checkCast:
    # get object, allow immediately if null
19504#    lw $t2,($sp)
19508#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
19512#    lw $t2,-12($t2) # vtable address
19516#    bge $t2,$t1,castException
19517##...slt $at,$t2,$t1
19521##...beq $at,$zero,19692
19524#    blt $t2,$t0,castException
19525##...slt $at,$t2,$t0
19529##...bne $at,$zero,19692
    
    # return, leaving object unchanged on stack
19532:  checkCastReturn:    
19532#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
19536:instanceOf:
    # get object, go return false if null
19536#    lw $t2,($sp)
19540#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
19544#    lw $t2,-12($t2) # vtable address
19548#    sge $t0,$t2,$t0 # are we >= the lower limit?
19549##...slt $t0,$t2,$t0
19553##...xori $t0,$t0,0x1
19556#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
19560#    and $t2,$t0,$t1
19564#    sw $t2,($sp)
19568:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
19568#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

19572:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
19572#    li $v0,4 # syscall-code for print-string
19576#    syscall
19580:exit:
    # print termination message
19580#    li $v0,4 # syscall-code for print-string
19584#    la $a0,exitString
19588#    syscall

    # print number of garbage collections
19592#    li $v0,4 # syscall-code for print-string
19596#    la $a0,gcCountMsg
19600#    syscall # print "Number of ..."
19604#    lw $a0,gcCount # number of GC's
19608#    li $v0,1 # code for print-int
19612#    syscall
19616#    li $v0,4 # syscall-code for print-string
19620#    la $a0,newlineString
19624#    syscall # print newline

    # terminate execution
19628#    li $v0,10 #syscall-code for "exit"
19632#    syscall

19636:outOfHeapMemory:
19636#    la $a0,heapMemoryMsg
19640#    j exitError
19644:divByZeroError:
19644#    la $a0,divByZeroMsg
19648#    j exitError
19652:strIndexOutOfBounds:
19652#    la $a0,strIndexOutOfBoundsMsg
19656#    j exitError
19660:arrayIndexOutOfBounds:
19660#    la $a0,arrayIndexOutOfBoundsMsg
19664#    j exitError
19668:arraySizeOutOfBounds:
19668#    la $a0,arraySizeOutOfBoundsMsg
19672#    j exitError
19676:nullPtrException:
19676#    la $a0,nullPtrExceptionMsg
19680#    j exitError
19684:badIntegerFormat:
19684#    la $a0,badIntegerFormatMsg
19688#    j exitError
19692:castException:
19692#    la $a0,castExceptionMsg
19696#    j exitError
############## data section ################
    .data
21584:hexChars:
    .ascii "0123456789abcdef"
    .align 2
21600:cur_seg:
    .word 0

21604:lastCharRead:
    .word -2 # -2 => no buffered character
21608:prevHashConstant:
    .word 0x2785173c
21612:gcCount:
    .word 0

21616:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
21643:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
21666:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
21701:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
21735:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
21768:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
21799:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
21847:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
21868:gcMsg: 
      .asciiz "\nGC!\n"
21874:gcCountMsg: 
      .asciiz "Number of garbage collections: "

21906:nullStr:
    .asciiz "null"
21911:trueString:
    .asciiz "true"
21916:falseString:
    .asciiz "false"
21922:exitString:
    .ascii "Program execution completed."
    #### "falls through" here
21950:newlineString:
    .asciiz "\n"
    
    .align 2
21952:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

21956:seg0_start:
    .space 0x100000
1070532:seg0_end:
1070532:seg1_start:
    .space 0x100000
2119108:seg1_end:
