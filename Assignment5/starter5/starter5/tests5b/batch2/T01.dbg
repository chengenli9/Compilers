4328#    la $s4,seg0_end
4329##...lui $s4,16
4333##...addiu $s4,$s4,5904
4336#    sw $zero,cur_seg
4340#    bne $t0,$zero,skipGc1
4344#    la $t6,seg0_start
4348#    la $s3,seg1_start
4349##...lui $s3,16
4353##...addiu $s3,$s3,5904
4356#    la $s4,seg1_end
4357##...lui $s4,32
4361##...addiu $s4,$s4,5904
4364#    sw $s5,cur_seg
