3752:  gcH2Neg2:
3752#    sll $t3,$t3,2 # # object bytes
3756#    move $t0,$t2 # address of first pointer in object
3760#    add $s1,$t2,$t3 # limit address for this object

    #####################################################
    # At this point, we have to "translate" all pointers,
    # starting at $t0 to (but not including) $s1
    #####################################################

    # if there are no pointer-slots (i.e., $t0=$s1), skip this
    # part
3764#    beq $t0,$s1,gcTestIterDone2
    
3768:  gcNextPointerInObject:
    # get pointer from object
3768#    lw $t1,($t0)

    # if value is out of range, and is therefore does not refer
    # to an object, just go loop back and do the next one
3772#    bleu $t1,$t6,gcGoNextPointerSlot
3773##...sltu $at,$t6,$t1
3777##...beq $at,$zero,3920
3780#    bgtu $t1,$t7,gcGoNextPointerSlot
3781##...sltu $at,$t7,$t1
3785##...bne $at,$zero,3920

    # if the object has already been moved, update the stack-value
    # via the forwarding pointer
3788#    lw $t8,-8($t1) # possible forwarding tag
3792#    bne $t8,$zero,gcNoForward2 # if not forwarding tag, go copy
3796#    lw $t8,-4($t1) # forwarding pointer: object's new address
3800#    sw $t8,($t0) # update pointer in object
3804#    j gcGoNextPointerSlot # do next iteration

3808:  gcNoForward2:
    #########################################################
    # we actually need to copy the object into the new space
    #########################################################

    #########################################################
    # At this point:
    # - $t0 contains the address of the heap-slot we're translating
    # - $t1 will contain the contents of the heap-slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space, which will also be the first address
    #   of the target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # Then during processing:
    # And when we're actually copying an object:
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $t8 will contain a pointer to the target object
    # - available for use: $s0, $t8, $t9
    ##########################################################

    # compute the amount of space that is needed
3808#    bge $t8,$zero,gcSkip5 # # words in negative-offset portion
3809##...slt $at,$t8,$zero
3813##...beq $at,$zero,3828
3816#    and $t8,0xff # mask off hash bits
3817##...lui $at,0
3821##...ori $at,$at,0xff
3825##...and $t8,$t8,$at

3828:  gcSkip5:
3828#    sll $t8,$t8,2 # bytes in negative-offset portion ...
3832#    addu $t8,$t8,8 # ... add in bytes for header-words
3836#    subu $t4,$t1,$t8 # address of first word of source object
3840#    lw $t3,-4($t1) # # words in positive-offset portion
3844#    bge $t3,$zero,gcNoNeg
3845##...slt $at,$t3,$zero
3849##...beq $at,$zero,3856
3852#    move $t3,$zero # negative treated as zero
3856:  gcNoNeg:
3856#    sll $t3,$t3,2 # bytes in negative-offset portion
3860#    addu $t3,$t3,$t1 # address one word past last word of source

3864#    addu $t8,$s3,$t8 # pointer to target object

    #########################################################
    # At this point:
    # - $t0 contains the address of the stack slot we'll
    #   process next
    # - $t1 contains the contents of the stack slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $t8 contains the pointer to the target object
    # - $s1 contains the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0, $t9
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger"
3868#    lw $s0,($t4)
3872#    lw $t9,-8($t1)
3876#    sw $t9,($t4)
3880#    sw $s0,-8($t1)

    # copy all source bytes to the target
3884:  gCinnerCopy2:
3884#    lw $s0,($t4)
3888#    sw $s0,($s3)
3892#    addu $t4,$t4,4
3896#    addu $s3,$s3,4
3900#    bltu $t4,$t3,gCinnerCopy2
3901##...sltu $at,$t4,$t3
3905##...bne $at,$zero,3884

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
3908#    sw $zero,-8($t1) # 0 in first header-slot
3912#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
3916#    sw $t8,($t0)

3920:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
3920#    addu $t0,$t0,4
3924#    bltu $t0,$s1,gcNextPointerInObject
3925##...sltu $at,$t0,$s1
3929##...bne $at,$zero,3768

3932:  gcTestIterDone2:
3932#    bltu $t0,$s3,gcHeapCopyLoop
3933##...sltu $at,$t0,$s3
3937##...bne $at,$zero,3652

    ###### end outer loop to copy all non-stack-direct objects ######

3940:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
3940#    lw $s2,($sp)
3944#    addu $sp,$sp,4

    # mark us as having already GC'd
3948#    move $t5,$s5

    # go try and allocate again
3952#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
3956:vm_init:

    # mark bottom of stack
3956#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
3960#    move $s2,$zero

    #set up the "five" register
3964#    li $s5,5

3968#    la $s3,seg0_start
3972#    la $s4,seg0_end
3973##...lui $s4,16
3977##...addiu $s4,$s4,4776
    
    # return
3980#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3984:divide:
    # get parameters; abort if divisor zero
3984#    lw $t0,($sp)
3988#    lw $t1,8($sp)
3992#    beq $t0,$zero,divByZeroError
    
    # perform division
3996#    div $t1,$t0
4000#    mflo $t0

    # store result, adjust stack and return
4004#    addu $sp,$sp,8 # adjust stack
4008#    sw $t0,($sp) # store result
4012#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4016:remainder:
    # get parameters; abort if divisor zero
4016#    lw $t0,($sp)
4020#    lw $t1,8($sp)
4024#    beq $t0,$zero,divByZeroError
    
    # perform division
4028#    div $t1,$t0
4032#    mfhi $t0

    # store result, adjust stack and return
4036#    addu $sp,$sp,8 # adjust stack
4040#    sw $t0,($sp) # store result
4044#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
4048:checkCast:
    # get object, allow immediately if null
4048#    lw $t2,($sp)
4052#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
4056#    lw $t2,-12($t2) # vtable address
4060#    bge $t2,$t1,castException
4061##...slt $at,$t2,$t1
4065##...beq $at,$zero,4200
4068#    blt $t2,$t0,castException
4069##...slt $at,$t2,$t0
4073##...bne $at,$zero,4200
    
    # return, leaving object unchanged on stack
4076:  checkCastReturn:    
4076#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
4080:instanceOf:
    # get object, go return false if null
4080#    lw $t2,($sp)
4084#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
4088#    lw $t2,-12($t2) # vtable address
4092#    sge $t0,$t2,$t0 # are we >= the lower limit?
4093##...slt $t0,$t2,$t0
4097##...xori $t0,$t0,0x1
4100#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
4104#    and $t2,$t0,$t1
4108#    sw $t2,($sp)
4112:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
4112#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

4116:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
4116#    li $v0,4 # syscall-code for print-string
4120#    syscall
4124:exit:
    # print termination message
4124#    li $v0,4 # syscall-code for print-string
4128#    la $a0,exitString
4132#    syscall

    # terminate execution
4136#    li $v0,10 #syscall-code for "exit"
4140#    syscall

4144:outOfHeapMemory:
4144#    la $a0,heapMemoryMsg
4148#    j exitError
4152:divByZeroError:
4152#    la $a0,divByZeroMsg
4156#    j exitError
4160:strIndexOutOfBounds:
4160#    la $a0,strIndexOutOfBoundsMsg
4164#    j exitError
4168:arrayIndexOutOfBounds:
4168#    la $a0,arrayIndexOutOfBoundsMsg
4172#    j exitError
4176:arraySizeOutOfBounds:
4176#    la $a0,arraySizeOutOfBoundsMsg
4180#    j exitError
4184:nullPtrException:
4184#    la $a0,nullPtrExceptionMsg
4188#    j exitError
4192:badIntegerFormat:
4192#    la $a0,badIntegerFormatMsg
4196#    j exitError
4200:castException:
4200#    la $a0,castExceptionMsg
4204#    j exitError
############## data section ################
    .data
4412:hexChars:
    .ascii "0123456789abcdef"
    .align 2
4428:cur_seg:
    .word 0

4432:lastCharRead:
    .word -2 # -2 => no buffered character
4436:prevHashConstant:
    .word 0x2785173c
4440:gcCount:
    .word 0

4444:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
4471:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
4494:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
4529:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
4563:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
4596:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
4627:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
4675:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
4696:gcMsg: 
      .asciiz "\nGC!\n"
4702:gcCountMsg: 
      .asciiz "Number of garbage collections: "

4734:nullStr:
    .asciiz "null"
4739:trueString:
    .asciiz "true"
4744:falseString:
    .asciiz "false"
4750:exitString:
    .ascii "Program terminated."
    #### "falls through" here
4769:newlineString:
    .asciiz "\n"
    
    .align 2
4772:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

4776:seg0_start:
    .space 0x100000
1053352:seg0_end:
1053352:seg1_start:
    .space 0x100000
2101928:seg1_end:
