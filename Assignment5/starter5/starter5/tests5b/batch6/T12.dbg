########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
3996:vm_init:

    # mark bottom of stack
3996#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
4000#    move $s2,$zero

    #set up the "five" register
4004#    li $s5,5

4008#    la $s3,seg0_start
4012#    la $s4,seg0_end
4013##...lui $s4,16
4017##...addiu $s4,$s4,5268
    
    # return
4020#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4024:divide:
    # get parameters; abort if divisor zero
4024#    lw $t0,($sp)
4028#    lw $t1,8($sp)
4032#    beq $t0,$zero,divByZeroError
    
    # perform division
4036#    div $t1,$t0
4040#    mflo $t0

    # store result, adjust stack and return
4044#    addu $sp,$sp,8 # adjust stack
4048#    sw $t0,($sp) # store result
4052#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4056:remainder:
    # get parameters; abort if divisor zero
4056#    lw $t0,($sp)
4060#    lw $t1,8($sp)
4064#    beq $t0,$zero,divByZeroError
    
    # perform division
4068#    div $t1,$t0
4072#    mfhi $t0

    # store result, adjust stack and return
4076#    addu $sp,$sp,8 # adjust stack
4080#    sw $t0,($sp) # store result
4084#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
4088:checkCast:
    # get object, allow immediately if null
4088#    lw $t2,($sp)
4092#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
4096#    lw $t2,-12($t2) # vtable address
4100#    bge $t2,$t1,castException
4101##...slt $at,$t2,$t1
4105##...beq $at,$zero,4276
4108#    blt $t2,$t0,castException
4109##...slt $at,$t2,$t0
4113##...bne $at,$zero,4276
    
    # return, leaving object unchanged on stack
4116:  checkCastReturn:    
4116#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
4120:instanceOf:
    # get object, go return false if null
4120#    lw $t2,($sp)
4124#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
4128#    lw $t2,-12($t2) # vtable address
4132#    sge $t0,$t2,$t0 # are we >= the lower limit?
4133##...slt $t0,$t2,$t0
4137##...xori $t0,$t0,0x1
4140#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
4144#    and $t2,$t0,$t1
4148#    sw $t2,($sp)
4152:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
4152#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

4156:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
4156#    li $v0,4 # syscall-code for print-string
4160#    syscall
4164:exit:
    # print termination message
4164#    li $v0,4 # syscall-code for print-string
4168#    la $a0,exitString
4172#    syscall

    # print number of garbage collections
4176#    li $v0,4 # syscall-code for print-string
4180#    la $a0,gcCountMsg
4184#    syscall # print "Number of ..."
4188#    lw $a0,gcCount # number of GC's
4192#    li $v0,1 # code for print-int
4196#    syscall
4200#    li $v0,4 # syscall-code for print-string
4204#    la $a0,newlineString
4208#    syscall # print newline

    # terminate execution
4212#    li $v0,10 #syscall-code for "exit"
4216#    syscall

4220:outOfHeapMemory:
4220#    la $a0,heapMemoryMsg
4224#    j exitError
4228:divByZeroError:
4228#    la $a0,divByZeroMsg
4232#    j exitError
4236:strIndexOutOfBounds:
4236#    la $a0,strIndexOutOfBoundsMsg
4240#    j exitError
4244:arrayIndexOutOfBounds:
4244#    la $a0,arrayIndexOutOfBoundsMsg
4248#    j exitError
4252:arraySizeOutOfBounds:
4252#    la $a0,arraySizeOutOfBoundsMsg
4256#    j exitError
4260:nullPtrException:
4260#    la $a0,nullPtrExceptionMsg
4264#    j exitError
4268:badIntegerFormat:
4268#    la $a0,badIntegerFormatMsg
4272#    j exitError
4276:castException:
4276#    la $a0,castExceptionMsg
4280#    j exitError
############## data section ################
    .data
4896:hexChars:
    .ascii "0123456789abcdef"
    .align 2
4912:cur_seg:
    .word 0

4916:lastCharRead:
    .word -2 # -2 => no buffered character
4920:prevHashConstant:
    .word 0x2785173c
4924:gcCount:
    .word 0

4928:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
4955:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
4978:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
5013:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
5047:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
5080:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
5111:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
5159:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
5180:gcMsg: 
      .asciiz "\nGC!\n"
5186:gcCountMsg: 
      .asciiz "Number of garbage collections: "

5218:nullStr:
    .asciiz "null"
5223:trueString:
    .asciiz "true"
5228:falseString:
    .asciiz "false"
5234:exitString:
    .ascii "Program execution completed."
    #### "falls through" here
5262:newlineString:
    .asciiz "\n"
    
    .align 2
5264:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

5268:seg0_start:
    .space 0x100000
1053844:seg0_end:
1053844:seg1_start:
    .space 0x100000
2102420:seg1_end:
