    # buffer and return
6568#    sw $t0,lastCharRead # store -2 into buffer (i.e. "empty")
6572#    jr $ra # return
    
6576:  doReadCh:
    # we need to actually read a character: read and return
6576#    li $v0,12 # use system call to read a character
6580#    syscall
6584#    jr $ra # return
