2856#    lw $t0,($sp) # second string
2860#    beq $t0,$zero,nullPtrException
2864#    move $t1,$s2 # first string
    
    # get (negatives of) respective byte-lengths
2868#    lw $t2,-4($t0) # negative length of second string
2872#    lw $t3,-4($t1) # negative length of first string

