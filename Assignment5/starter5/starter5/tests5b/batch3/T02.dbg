8440#    bgt $t1,$t0,strIndexOutOfBounds
8441##...slt $at,$t0,$t1
8445##...bne $at,$zero,10388

    # allocate memory
8448#    subu $s6,$t1,$t2 # # chars in target-string
8452#    addu $s6,$s6,7 # account for extra "class" (4) word + 3 to round up
8456#    srl $s6,$s6,2 # convert bytes-count to word-count
8460#    move $s7,$zero # (no object-bytes in string)
