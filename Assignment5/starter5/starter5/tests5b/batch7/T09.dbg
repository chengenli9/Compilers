1297##...sltu $at,$t1,$t2
1301##...beq $at,$zero,3584
1304#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

1308:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

1308#    jal readLogicalChar # read next character
1312#    subu $t1,$v0,'0' # convert digit to 0-9 value
1316#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
1317##...sltu $at,$t1,$t2
1321##...beq $at,$zero,1340

1324#    mul $t3,$t3,$t2 # multiply old value by 10
1325##...mult $t3,$t2
1329##...mflo $t3
1332#    addu $t3,$t3,$t1 # add in value of new digit
1336#    j digitLoop

1340:  doneDigitLoop:

    # "push back" unused character into queue
