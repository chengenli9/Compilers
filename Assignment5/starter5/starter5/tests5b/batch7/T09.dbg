    # swap first header word and first data word so that header
        # can be found by "trailing finger"
3224#    lw $s0,($t4)
3228#    lw $t9,-8($t1)
3232#    sw $t9,($t4)
3236#    sw $s0,-8($t1)

    # copy all source bytes to the target
3240:  gCinnerCopy2:
3240#    lw $s0,($t4)
3244#    sw $s0,($s3)
3248#    addu $t4,$t4,4
3252#    addu $s3,$s3,4
3256#    bltu $t4,$t3,gCinnerCopy2
3257##...sltu $at,$t4,$t3
3261##...bne $at,$zero,3240

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
3264#    sw $zero,-8($t1) # 0 in first header-slot
3268#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
3272#    sw $t8,($t0)

3276:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
3276#    addu $t0,$t0,4
3280#    bltu $t0,$s1,gcNextPointerInObject
3281##...sltu $at,$t0,$s1
3285##...bne $at,$zero,3124

3288:  gcTestIterDone2:
3288#    bltu $t0,$s3,gcHeapCopyLoop
3289##...sltu $at,$t0,$s3
3293##...bne $at,$zero,3008

    ###### end outer loop to copy all non-stack-direct objects ######

3296:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
3296#    lw $s2,($sp)
3300#    addu $sp,$sp,4

    # mark us as having already GC'd
3304#    move $t5,$s5

    # go try and allocate again
3308#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
3312:vm_init:

    # mark bottom of stack
3312#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
3316#    move $s2,$zero

    #set up the "five" register
3320#    li $s5,5

3324#    la $s3,seg0_start
3328#    la $s4,seg0_end
3329##...lui $s4,16
3333##...addiu $s4,$s4,4284
    
    # return
3336#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3340:divide:
    # get parameters; abort if divisor zero
3340#    lw $t0,($sp)
3344#    lw $t1,8($sp)
3348#    beq $t0,$zero,divByZeroError
    
    # perform division
3352#    div $t1,$t0
3356#    mflo $t0

    # store result, adjust stack and return
3360#    addu $sp,$sp,8 # adjust stack
3364#    sw $t0,($sp) # store result
3368#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3372:remainder:
    # get parameters; abort if divisor zero
3372#    lw $t0,($sp)
3376#    lw $t1,8($sp)
3380#    beq $t0,$zero,divByZeroError
    
    # perform division
3384#    div $t1,$t0
3388#    mfhi $t0

    # store result, adjust stack and return
3392#    addu $sp,$sp,8 # adjust stack
3396#    sw $t0,($sp) # store result
3400#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
3404:checkCast:
    # get object, allow immediately if null
3404#    lw $t2,($sp)
3408#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
3412#    lw $t2,-12($t2) # vtable address
3416#    bge $t2,$t1,castException
3417##...slt $at,$t2,$t1
3421##...beq $at,$zero,3592
3424#    blt $t2,$t0,castException
3425##...slt $at,$t2,$t0
3429##...bne $at,$zero,3592
    
    # return, leaving object unchanged on stack
3432:  checkCastReturn:    
3432#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
3436:instanceOf:
    # get object, go return false if null
3436#    lw $t2,($sp)
3440#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
3444#    lw $t2,-12($t2) # vtable address
3448#    sge $t0,$t2,$t0 # are we >= the lower limit?
3449##...slt $t0,$t2,$t0
3453##...xori $t0,$t0,0x1
3456#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
3460#    and $t2,$t0,$t1
3464#    sw $t2,($sp)
3468:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
3468#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

3472:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
3472#    li $v0,4 # syscall-code for print-string
3476#    syscall
3480:exit:
    # print termination message
3480#    li $v0,4 # syscall-code for print-string
3484#    la $a0,exitString
3488#    syscall

    # print number of garbage collections
3492#    li $v0,4 # syscall-code for print-string
3496#    la $a0,gcCountMsg
3500#    syscall # print "Number of ..."
3504#    lw $a0,gcCount # number of GC's
3508#    li $v0,1 # code for print-int
3512#    syscall
3516#    li $v0,4 # syscall-code for print-string
3520#    la $a0,newlineString
3524#    syscall # print newline

    # terminate execution
3528#    li $v0,10 #syscall-code for "exit"
3532#    syscall

3536:outOfHeapMemory:
3536#    la $a0,heapMemoryMsg
3540#    j exitError
3544:divByZeroError:
3544#    la $a0,divByZeroMsg
3548#    j exitError
3552:strIndexOutOfBounds:
3552#    la $a0,strIndexOutOfBoundsMsg
3556#    j exitError
3560:arrayIndexOutOfBounds:
3560#    la $a0,arrayIndexOutOfBoundsMsg
3564#    j exitError
3568:arraySizeOutOfBounds:
3568#    la $a0,arraySizeOutOfBoundsMsg
3572#    j exitError
3576:nullPtrException:
3576#    la $a0,nullPtrExceptionMsg
3580#    j exitError
3584:badIntegerFormat:
3584#    la $a0,badIntegerFormatMsg
3588#    j exitError
3592:castException:
3592#    la $a0,castExceptionMsg
3596#    j exitError
############## data section ################
    .data
3912:hexChars:
    .ascii "0123456789abcdef"
    .align 2
3928:cur_seg:
    .word 0

3932:lastCharRead:
    .word -2 # -2 => no buffered character
3936:prevHashConstant:
    .word 0x2785173c
3940:gcCount:
    .word 0

3944:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
3971:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
3994:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
4029:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
4063:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
4096:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
4127:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
4175:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
4196:gcMsg: 
      .asciiz "\nGC!\n"
4202:gcCountMsg: 
      .asciiz "Number of garbage collections: "

4234:nullStr:
    .asciiz "null"
4239:trueString:
    .asciiz "true"
4244:falseString:
    .asciiz "false"
4250:exitString:
    .ascii "Program execution completed."
    #### "falls through" here
4278:newlineString:
    .asciiz "\n"
    
    .align 2
4280:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

4284:seg0_start:
    .space 0x100000
1052860:seg0_end:
1052860:seg1_start:
    .space 0x100000
2101436:seg1_end:
