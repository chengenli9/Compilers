3481##...lui $at,0
3485##...ori $at,$at,0xff
3489##...and $t2,$t2,$at
    #### OLD
    #### subu $t2,$zero,$t2 # set to 1 if -1 (number of data words)

3492:  gcSkip2:
3492#    sll $t2,$t2,2
3496#    addu $t2,$t2,8
3500#    subu $t4,$t1,$t2 # address of first word of source
3504#    lw $t3,-4($t1) # number of object words (negative means zero)
