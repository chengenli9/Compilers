
    # determine if we have enough memory available
9384#    addu $t0,$s6,$s7
9388#    sll $t0,$t0,2
9392#    addu $t0,$t0,8 # amount of memory needed
9396#    addu $t1,$t0,$s3
9400#    bgtu $t1,$s4,doGC
