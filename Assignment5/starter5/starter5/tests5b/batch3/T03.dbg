    # restore return address
10060#    lw $ra,($sp)
10064#    addu $sp, 4

    # multiply by sign and put return value in $t0
10068#    mult $t3,$t4 # multiply to account for poss. minus sign
10072#    mflo $t3
10076#    move $t0, $t3
    
    # return
10080#    jr $ra

###################################################################
