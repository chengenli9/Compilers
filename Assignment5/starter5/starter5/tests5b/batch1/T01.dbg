##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
168:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
168#    lw $t0,-8($s2) # get word with hash bits from this
172#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
176#    addu $t0,$t1

180#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
184:mth_equals_Object:
184#    move $t0,$s2 # first pointer (this)
188#    lw $t1,($sp) # second pointer
192#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
193##...subu $at,$t0,$t1
197##...sltiu $t0,$at,1

200#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
204:mth_hashCode_String:
204#    move $t0,$s2 # put this pointer in t0

208#    li $t2,0 # current hash value
212#    lw $t1,-4($t0) # negative of number of characters in string
216#    beq $t1,$zero,done_hashCode_String # if zero length => done
220#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
224#    and $t0,0xfffffffc # adjust for padding
225##...lui $at,65535
229##...ori $at,$at,0xfffc
233##...and $t0,$t0,$at
236#    subu $t1,$t0,$t1 # address at end of string +12
240:loop_hashCode_String:    
240#    sll $t4,$t2,5 # multiply by 32
244#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
248#    lbu $t3,-12($t0) # current character
252#    addu $t2,$t3 # add in current character
256#    addu $t0,1 # go to next character's address
260#    bne $t0,$t1,loop_hashCode_String # loop back if more
264:done_hashCode_String:    

    # push int on stack
264#    move $t0, $t2 # put $t2 in return slot
268#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
272:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
272#    subu $sp,4
276#    sw $ra,($sp)
    
    # get hash value
280#    lw $t2,-12($s2) # vtable address
284#    lw $t0,($t2) # method address
288#    jalr $t0
292#    subu $sp,8 # push result (int in $t0) on stack
296#    sw $s5,4($sp)
300#    sw $t0,($sp)

    # compute print-size of hash value
304#    li $t0, 1
308#    lw $t1, ($sp)
312#    srl $t1,$t1,4
316#    beq $t1,$zero,toString_skip_loop
320:toString_loop_top:
320#    addu $t0,1
324#    srl $t1,$t1,4
328#    bne $t1,$zero,toString_loop_top
332:toString_skip_loop:
332#    subu $sp,8
336#    sw $s5,4($sp)
340#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
344#    lw $t2,-12($s2) # vtable address
348#    move $t0,$t2
352:toString_checkTagBit:
352#    subu $t0,1
356#    lb $t1,($t0)
360#    and $t1,0x80
361##...lui $at,0
365##...ori $at,$at,0x80
369##...and $t1,$t1,$at
372#    beq $t1,$zero,toString_checkTagBit
376#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
380#    subu $sp,8
384#    sw $t1,($sp)
388#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
392#    move $s7,$zero # -4 offset header word
396#    lw $t4,8($sp) # bytes for hash value
400#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
404#    addu $t4,8
408#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
412#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

416#    li $t0,CLASS_String # store string vtable address into ...
420#    sw $t0,-12($s7) # ... -12 offset in object header
424#    lw $t2,-12($s2) # our object's vtable address
428#    lw $t5,4($sp) # number characters in prefix
432#    lw $t1,12($sp) # number of characters in hashcode
436#    addu $t3,$t1,$t5 # number of characters in string ...
440#    addu $t3,1 # ... including the '@' character
444#    subu $t0,$zero,$t3 # store negated length into ...
448#    sw $t0,-4($s7) # ... -4 offset header word
452#    lw $t0,-8($s7) # get -8 offset header-word
456#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
457##...slt $at,$t0,$zero
461##...beq $at,$zero,480
464#    and $t0,0xff # mask off object's hash value ...
465##...lui $at,0
469##...ori $at,$at,0xff
473##...and $t0,$t0,$at
476#    sw $t0,-8($s7) # ... and store back into -8 header-word
480:skipMask_toString:
480#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
484#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
488#    subu $t4,$t2,$t5
492:toString_copyLoop:    
492#    lb $t3,($t4)
496#    and $t3,0x7f # mask off sign bit (in case first word)
497##...lui $at,0
501##...ori $at,$at,0x7f
505##...and $t3,$t3,$at
508#    sb $t3,-8($t0)
512#    addu $t4,1
516#    addu $t0,1
520#    blt $t4,$t2,toString_copyLoop
521##...slt $at,$t4,$t2
525##...bne $at,$zero,492

    # copy the '@' sign
528#    li $t3,'@'
532#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
536#    addu $t2,$t0,$t1 # address of last byte in string to store +8
540#    lw $t3,20($sp) # hash code to print
544:toString_hashCopyLoop:
544#    and $t4,$t3,0xf
548#    srl $t3,4
552#    lb $t4,hexChars($t4)
556#    sb $t4,-8($t2)
560#    subu $t2,$t2,1
564#    bgt $t2,$t0,toString_hashCopyLoop
565##...slt $at,$t0,$t2
569##...bne $at,$zero,544

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
572#    addu $sp,28
576#    lw $ra,($sp)
580#    addu $sp,4
584#    move $t0, $s7 # return string we created
588#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
592:mth_equals_String:
    
    # quick test for obvious false
592#    lw $t0,($sp) # second parameter
596#    beq $t0,$zero,goEsFalse # go return false if null
600#    lw $t1,-12($t0) # vtable pointer
604#    la $t2,CLASS_String # string vtable pointer
608#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
612#    subu $sp,12
616#    sw $ra,8($sp)
620#    sw $s2,4($sp)
624#    sw $t0,($sp)
628#    jal mth_compareTo_String
632#    lw $s2, 4($sp) #restore this pointer and pop parameters
636#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
640#    seq $t0,$t0,$zero
641##...subu $at,$t0,$zero
645##...sltiu $t0,$at,1

    # pop return address and return $t0
648#    lw $ra,($sp)
652#    addu $sp,4

656#    jr $ra # return
    
660:goEsFalse:
    # put 0 in $t0 and return
660#    li $t0, 0
664#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
668:mth_toString_String:
    #we are a string, so return this.
668#    move $t0, $s2
672#    jr $ra

###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
676:mth_readLine_Lib:
    
676#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
680#    sw $ra, 4($sp) # save $ra
684#    move $t1,$sp # save "original" sp

