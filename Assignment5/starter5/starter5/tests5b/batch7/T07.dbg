########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
3128:vm_init:

    # mark bottom of stack
3128#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
3132#    move $s2,$zero

    #set up the "five" register
3136#    li $s5,5

3140#    la $s3,seg0_start
3144#    la $s4,seg0_end
3145##...lui $s4,16
3149##...addiu $s4,$s4,4060
    
    # return
3152#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3156:divide:
    # get parameters; abort if divisor zero
3156#    lw $t0,($sp)
3160#    lw $t1,8($sp)
3164#    beq $t0,$zero,divByZeroError
    
    # perform division
3168#    div $t1,$t0
3172#    mflo $t0

    # store result, adjust stack and return
3176#    addu $sp,$sp,8 # adjust stack
3180#    sw $t0,($sp) # store result
3184#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3188:remainder:
    # get parameters; abort if divisor zero
3188#    lw $t0,($sp)
3192#    lw $t1,8($sp)
3196#    beq $t0,$zero,divByZeroError
    
    # perform division
3200#    div $t1,$t0
3204#    mfhi $t0

    # store result, adjust stack and return
3208#    addu $sp,$sp,8 # adjust stack
3212#    sw $t0,($sp) # store result
3216#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
3220:checkCast:
    # get object, allow immediately if null
3220#    lw $t2,($sp)
3224#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
3228#    lw $t2,-12($t2) # vtable address
3232#    bge $t2,$t1,castException
3233##...slt $at,$t2,$t1
3237##...beq $at,$zero,3408
3240#    blt $t2,$t0,castException
3241##...slt $at,$t2,$t0
3245##...bne $at,$zero,3408
    
    # return, leaving object unchanged on stack
3248:  checkCastReturn:    
3248#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
3252:instanceOf:
    # get object, go return false if null
3252#    lw $t2,($sp)
3256#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
3260#    lw $t2,-12($t2) # vtable address
3264#    sge $t0,$t2,$t0 # are we >= the lower limit?
3265##...slt $t0,$t2,$t0
3269##...xori $t0,$t0,0x1
3272#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
3276#    and $t2,$t0,$t1
3280#    sw $t2,($sp)
3284:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
3284#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

3288:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
3288#    li $v0,4 # syscall-code for print-string
3292#    syscall
3296:exit:
    # print termination message
3296#    li $v0,4 # syscall-code for print-string
3300#    la $a0,exitString
3304#    syscall

    # print number of garbage collections
3308#    li $v0,4 # syscall-code for print-string
3312#    la $a0,gcCountMsg
3316#    syscall # print "Number of ..."
3320#    lw $a0,gcCount # number of GC's
3324#    li $v0,1 # code for print-int
3328#    syscall
3332#    li $v0,4 # syscall-code for print-string
3336#    la $a0,newlineString
3340#    syscall # print newline

    # terminate execution
3344#    li $v0,10 #syscall-code for "exit"
3348#    syscall

3352:outOfHeapMemory:
3352#    la $a0,heapMemoryMsg
3356#    j exitError
3360:divByZeroError:
3360#    la $a0,divByZeroMsg
3364#    j exitError
3368:strIndexOutOfBounds:
3368#    la $a0,strIndexOutOfBoundsMsg
3372#    j exitError
3376:arrayIndexOutOfBounds:
3376#    la $a0,arrayIndexOutOfBoundsMsg
3380#    j exitError
3384:arraySizeOutOfBounds:
3384#    la $a0,arraySizeOutOfBoundsMsg
3388#    j exitError
3392:nullPtrException:
3392#    la $a0,nullPtrExceptionMsg
3396#    j exitError
3400:badIntegerFormat:
3400#    la $a0,badIntegerFormatMsg
3404#    j exitError
3408:castException:
3408#    la $a0,castExceptionMsg
3412#    j exitError
############## data section ################
    .data
