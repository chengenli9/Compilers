932#    and $t1,0x80
933##...lui $at,0
937##...ori $at,$at,0x80
941##...and $t1,$t1,$at
944#    beq $t1,$zero,toString_checkTagBit
948#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
952#    subu $sp,8
956#    sw $t1,($sp)
960#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
964#    move $s7,$zero # -4 offset header word
968#    lw $t4,8($sp) # bytes for hash value
972#    addu $t4,$t1 # bytes for prefix
