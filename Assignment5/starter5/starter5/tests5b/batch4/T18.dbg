    #####################################################
    # At this point, we have to "translate" all pointers,
    # starting at $t0 to (but not including) $s1
    #####################################################

    # if there are no pointer-slots (i.e., $t0=$s1), skip this
    # part
3732#    beq $t0,$s1,gcTestIterDone2
    
3736:  gcNextPointerInObject:
    # get pointer from object
3736#    lw $t1,($t0)

    # if value is out of range, and is therefore does not refer
    # to an object, just go loop back and do the next one
3740#    bleu $t1,$t6,gcGoNextPointerSlot
3741##...sltu $at,$t6,$t1
3745##...beq $at,$zero,3888
3748#    bgtu $t1,$t7,gcGoNextPointerSlot
3749##...sltu $at,$t7,$t1
3753##...bne $at,$zero,3888

    # if the object has already been moved, update the stack-value
    # via the forwarding pointer
3756#    lw $t8,-8($t1) # possible forwarding tag
3760#    bne $t8,$zero,gcNoForward2 # if not forwarding tag, go copy
3764#    lw $t8,-4($t1) # forwarding pointer: object's new address
3768#    sw $t8,($t0) # update pointer in object
3772#    j gcGoNextPointerSlot # do next iteration

3776:  gcNoForward2:
    #########################################################
    # we actually need to copy the object into the new space
    #########################################################

    #########################################################
    # At this point:
    # - $t0 contains the address of the heap-slot we're translating
    # - $t1 will contain the contents of the heap-slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space, which will also be the first address
    #   of the target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # Then during processing:
    # And when we're actually copying an object:
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $t8 will contain a pointer to the target object
    # - available for use: $s0, $t8, $t9
    ##########################################################

    # compute the amount of space that is needed
3776#    bge $t8,$zero,gcSkip5 # # words in negative-offset portion
3777##...slt $at,$t8,$zero
3781##...beq $at,$zero,3796
3784#    and $t8,0xff # mask off hash bits
3785##...lui $at,0
3789##...ori $at,$at,0xff
3793##...and $t8,$t8,$at

3796:  gcSkip5:
3796#    sll $t8,$t8,2 # bytes in negative-offset portion ...
3800#    addu $t8,$t8,8 # ... add in bytes for header-words
3804#    subu $t4,$t1,$t8 # address of first word of source object
3808#    lw $t3,-4($t1) # # words in positive-offset portion
3812#    bge $t3,$zero,gcNoNeg
3813##...slt $at,$t3,$zero
3817##...beq $at,$zero,3824
3820#    move $t3,$zero # negative treated as zero
3824:  gcNoNeg:
3824#    sll $t3,$t3,2 # bytes in negative-offset portion
3828#    addu $t3,$t3,$t1 # address one word past last word of source

3832#    addu $t8,$s3,$t8 # pointer to target object

    #########################################################
    # At this point:
    # - $t0 contains the address of the stack slot we'll
    #   process next
    # - $t1 contains the contents of the stack slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $t8 contains the pointer to the target object
    # - $s1 contains the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0, $t9
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger"
3836#    lw $s0,($t4)
3840#    lw $t9,-8($t1)
3844#    sw $t9,($t4)
3848#    sw $s0,-8($t1)

    # copy all source bytes to the target
3852:  gCinnerCopy2:
3852#    lw $s0,($t4)
3856#    sw $s0,($s3)
3860#    addu $t4,$t4,4
3864#    addu $s3,$s3,4
3868#    bltu $t4,$t3,gCinnerCopy2
3869##...sltu $at,$t4,$t3
3873##...bne $at,$zero,3852

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
3876#    sw $zero,-8($t1) # 0 in first header-slot
3880#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
3884#    sw $t8,($t0)

3888:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
3888#    addu $t0,$t0,4
3892#    bltu $t0,$s1,gcNextPointerInObject
3893##...sltu $at,$t0,$s1
3897##...bne $at,$zero,3736

3900:  gcTestIterDone2:
3900#    bltu $t0,$s3,gcHeapCopyLoop
3901##...sltu $at,$t0,$s3
3905##...bne $at,$zero,3620

    ###### end outer loop to copy all non-stack-direct objects ######

3908:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
3908#    lw $s2,($sp)
3912#    addu $sp,$sp,4

    # mark us as having already GC'd
3916#    move $t5,$s5

    # go try and allocate again
3920#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
3924:vm_init:

    # mark bottom of stack
3924#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
3928#    move $s2,$zero

    #set up the "five" register
3932#    li $s5,5

3936#    la $s3,seg0_start
3940#    la $s4,seg0_end
3941##...lui $s4,16
3945##...addiu $s4,$s4,4812
    
    # return
3948#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3952:divide:
    # get parameters; abort if divisor zero
3952#    lw $t0,($sp)
3956#    lw $t1,8($sp)
3960#    beq $t0,$zero,divByZeroError
    
    # perform division
3964#    div $t1,$t0
3968#    mflo $t0

    # store result, adjust stack and return
3972#    addu $sp,$sp,8 # adjust stack
3976#    sw $t0,($sp) # store result
3980#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3984:remainder:
    # get parameters; abort if divisor zero
3984#    lw $t0,($sp)
3988#    lw $t1,8($sp)
3992#    beq $t0,$zero,divByZeroError
    
    # perform division
3996#    div $t1,$t0
4000#    mfhi $t0

    # store result, adjust stack and return
4004#    addu $sp,$sp,8 # adjust stack
4008#    sw $t0,($sp) # store result
4012#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
4016:checkCast:
    # get object, allow immediately if null
4016#    lw $t2,($sp)
4020#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
4024#    lw $t2,-12($t2) # vtable address
4028#    bge $t2,$t1,castException
4029##...slt $at,$t2,$t1
4033##...beq $at,$zero,4204
4036#    blt $t2,$t0,castException
4037##...slt $at,$t2,$t0
4041##...bne $at,$zero,4204
    
    # return, leaving object unchanged on stack
4044:  checkCastReturn:    
4044#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
4048:instanceOf:
    # get object, go return false if null
4048#    lw $t2,($sp)
4052#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
4056#    lw $t2,-12($t2) # vtable address
4060#    sge $t0,$t2,$t0 # are we >= the lower limit?
4061##...slt $t0,$t2,$t0
4065##...xori $t0,$t0,0x1
4068#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
4072#    and $t2,$t0,$t1
4076#    sw $t2,($sp)
4080:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
4080#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

4084:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
4084#    li $v0,4 # syscall-code for print-string
4088#    syscall
4092:exit:
    # print termination message
4092#    li $v0,4 # syscall-code for print-string
4096#    la $a0,exitString
4100#    syscall

    # print number of garbage collections
4104#    li $v0,4 # syscall-code for print-string
4108#    la $a0,gcCountMsg
4112#    syscall # print "Number of ..."
4116#    lw $a0,gcCount # number of GC's
4120#    li $v0,1 # code for print-int
4124#    syscall
4128#    li $v0,4 # syscall-code for print-string
4132#    la $a0,newlineString
4136#    syscall # print newline

    # terminate execution
4140#    li $v0,10 #syscall-code for "exit"
4144#    syscall

4148:outOfHeapMemory:
4148#    la $a0,heapMemoryMsg
4152#    j exitError
4156:divByZeroError:
4156#    la $a0,divByZeroMsg
4160#    j exitError
4164:strIndexOutOfBounds:
4164#    la $a0,strIndexOutOfBoundsMsg
4168#    j exitError
4172:arrayIndexOutOfBounds:
4172#    la $a0,arrayIndexOutOfBoundsMsg
4176#    j exitError
4180:arraySizeOutOfBounds:
4180#    la $a0,arraySizeOutOfBoundsMsg
4184#    j exitError
4188:nullPtrException:
4188#    la $a0,nullPtrExceptionMsg
4192#    j exitError
4196:badIntegerFormat:
4196#    la $a0,badIntegerFormatMsg
4200#    j exitError
4204:castException:
4204#    la $a0,castExceptionMsg
4208#    j exitError
############## data section ################
    .data
4440:hexChars:
    .ascii "0123456789abcdef"
    .align 2
4456:cur_seg:
    .word 0

4460:lastCharRead:
    .word -2 # -2 => no buffered character
4464:prevHashConstant:
    .word 0x2785173c
4468:gcCount:
    .word 0

4472:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
4499:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
4522:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
4557:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
4591:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
4624:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
4655:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
4703:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
4724:gcMsg: 
      .asciiz "\nGC!\n"
4730:gcCountMsg: 
      .asciiz "Number of garbage collections: "

4762:nullStr:
    .asciiz "null"
4767:trueString:
    .asciiz "true"
4772:falseString:
    .asciiz "false"
4778:exitString:
    .ascii "Program execution completed."
    #### "falls through" here
4806:newlineString:
    .asciiz "\n"
    
    .align 2
4808:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

4812:seg0_start:
    .space 0x100000
1053388:seg0_end:
1053388:seg1_start:
    .space 0x100000
2101964:seg1_end:
