##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
2052:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
2052#    lw $t0,-8($s2) # get word with hash bits from this
2056#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
2060#    addu $t0,$t1

2064#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
2068:mth_equals_Object:
2068#    move $t0,$s2 # first pointer (this)
2072#    lw $t1,($sp) # second pointer
2076#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
2077##...subu $at,$t0,$t1
2081##...sltiu $t0,$at,1

2084#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
2088:mth_hashCode_String:
2088#    move $t0,$s2 # put this pointer in t0

2092#    li $t2,0 # current hash value
2096#    lw $t1,-4($t0) # negative of number of characters in string
2100#    beq $t1,$zero,done_hashCode_String # if zero length => done
2104#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
2108#    and $t0,0xfffffffc # adjust for padding
2109##...lui $at,65535
2113##...ori $at,$at,0xfffc
2117##...and $t0,$t0,$at
2120#    subu $t1,$t0,$t1 # address at end of string +12
2124:loop_hashCode_String:    
2124#    sll $t4,$t2,5 # multiply by 32
2128#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
2132#    lbu $t3,-12($t0) # current character
2136#    addu $t2,$t3 # add in current character
2140#    addu $t0,1 # go to next character's address
2144#    bne $t0,$t1,loop_hashCode_String # loop back if more
2148:done_hashCode_String:    

    # push int on stack
2148#    move $t0, $t2 # put $t2 in return slot
2152#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
2156:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
2156#    subu $sp,4
2160#    sw $ra,($sp)
    
    # get hash value
2164#    lw $t2,-12($s2) # vtable address
2168#    lw $t0,($t2) # method address
2172#    jalr $t0
2176#    subu $sp,8 # push result (int in $t0) on stack
2180#    sw $s5,4($sp)
2184#    sw $t0,($sp)

    # compute print-size of hash value
2188#    li $t0, 1
2192#    lw $t1, ($sp)
2196#    srl $t1,$t1,4
2200#    beq $t1,$zero,toString_skip_loop
2204:toString_loop_top:
2204#    addu $t0,1
2208#    srl $t1,$t1,4
2212#    bne $t1,$zero,toString_loop_top
2216:toString_skip_loop:
2216#    subu $sp,8
2220#    sw $s5,4($sp)
2224#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
2228#    lw $t2,-12($s2) # vtable address
2232#    move $t0,$t2
2236:toString_checkTagBit:
2236#    subu $t0,1
2240#    lb $t1,($t0)
2244#    and $t1,0x80
2245##...lui $at,0
2249##...ori $at,$at,0x80
2253##...and $t1,$t1,$at
2256#    beq $t1,$zero,toString_checkTagBit
2260#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
2264#    subu $sp,8
2268#    sw $t1,($sp)
2272#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
2276#    move $s7,$zero # -4 offset header word
2280#    lw $t4,8($sp) # bytes for hash value
2284#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
2288#    addu $t4,8
2292#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
2296#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

2300#    li $t0,CLASS_String # store string vtable address into ...
2304#    sw $t0,-12($s7) # ... -12 offset in object header
2308#    lw $t2,-12($s2) # our object's vtable address
2312#    lw $t5,4($sp) # number characters in prefix
2316#    lw $t1,12($sp) # number of characters in hashcode
2320#    addu $t3,$t1,$t5 # number of characters in string ...
2324#    addu $t3,1 # ... including the '@' character
2328#    subu $t0,$zero,$t3 # store negated length into ...
2332#    sw $t0,-4($s7) # ... -4 offset header word
2336#    lw $t0,-8($s7) # get -8 offset header-word
2340#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
2341##...slt $at,$t0,$zero
2345##...beq $at,$zero,2364
2348#    and $t0,0xff # mask off object's hash value ...
2349##...lui $at,0
2353##...ori $at,$at,0xff
2357##...and $t0,$t0,$at
2360#    sw $t0,-8($s7) # ... and store back into -8 header-word
2364:skipMask_toString:
2364#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
2368#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
2372#    subu $t4,$t2,$t5
2376:toString_copyLoop:    
2376#    lb $t3,($t4)
2380#    and $t3,0x7f # mask off sign bit (in case first word)
2381##...lui $at,0
2385##...ori $at,$at,0x7f
2389##...and $t3,$t3,$at
2392#    sb $t3,-8($t0)
2396#    addu $t4,1
2400#    addu $t0,1
2404#    blt $t4,$t2,toString_copyLoop
2405##...slt $at,$t4,$t2
2409##...bne $at,$zero,2376

    # copy the '@' sign
2412#    li $t3,'@'
2416#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
2420#    addu $t2,$t0,$t1 # address of last byte in string to store +8
2424#    lw $t3,20($sp) # hash code to print
2428:toString_hashCopyLoop:
2428#    and $t4,$t3,0xf
2432#    srl $t3,4
2436#    lb $t4,hexChars($t4)
2440#    sb $t4,-8($t2)
2444#    subu $t2,$t2,1
2448#    bgt $t2,$t0,toString_hashCopyLoop
2449##...slt $at,$t0,$t2
2453##...bne $at,$zero,2428

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
2456#    addu $sp,28
2460#    lw $ra,($sp)
2464#    addu $sp,4
2468#    move $t0, $s7 # return string we created
2472#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
2476:mth_equals_String:
    
    # quick test for obvious false
2476#    lw $t0,($sp) # second parameter
2480#    beq $t0,$zero,goEsFalse # go return false if null
2484#    lw $t1,-12($t0) # vtable pointer
2488#    la $t2,CLASS_String # string vtable pointer
2492#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
2496#    subu $sp,12
2500#    sw $ra,8($sp)
2504#    sw $s2,4($sp)
2508#    sw $t0,($sp)
2512#    jal mth_compareTo_String
2516#    lw $s2, 4($sp) #restore this pointer and pop parameters
2520#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
2524#    seq $t0,$t0,$zero
2525##...subu $at,$t0,$zero
2529##...sltiu $t0,$at,1

    # pop return address and return $t0
2532#    lw $ra,($sp)
2536#    addu $sp,4

2540#    jr $ra # return
    
2544:goEsFalse:
    # put 0 in $t0 and return
2544#    li $t0, 0
2548#    jr $ra # return

