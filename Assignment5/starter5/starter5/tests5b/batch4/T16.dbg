##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
2860:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
2860#    lw $t0,-8($s2) # get word with hash bits from this
2864#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
2868#    addu $t0,$t1

2872#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
2876:mth_equals_Object:
2876#    move $t0,$s2 # first pointer (this)
2880#    lw $t1,($sp) # second pointer
2884#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
2885##...subu $at,$t0,$t1
2889##...sltiu $t0,$at,1

2892#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
2896:mth_hashCode_String:
2896#    move $t0,$s2 # put this pointer in t0

2900#    li $t2,0 # current hash value
2904#    lw $t1,-4($t0) # negative of number of characters in string
2908#    beq $t1,$zero,done_hashCode_String # if zero length => done
2912#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
2916#    and $t0,0xfffffffc # adjust for padding
2917##...lui $at,65535
2921##...ori $at,$at,0xfffc
2925##...and $t0,$t0,$at
2928#    subu $t1,$t0,$t1 # address at end of string +12
2932:loop_hashCode_String:    
2932#    sll $t4,$t2,5 # multiply by 32
2936#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
2940#    lbu $t3,-12($t0) # current character
2944#    addu $t2,$t3 # add in current character
2948#    addu $t0,1 # go to next character's address
2952#    bne $t0,$t1,loop_hashCode_String # loop back if more
2956:done_hashCode_String:    

    # push int on stack
2956#    move $t0, $t2 # put $t2 in return slot
2960#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
2964:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
2964#    subu $sp,4
2968#    sw $ra,($sp)
    
    # get hash value
2972#    lw $t2,-12($s2) # vtable address
2976#    lw $t0,($t2) # method address
2980#    jalr $t0
2984#    subu $sp,8 # push result (int in $t0) on stack
2988#    sw $s5,4($sp)
2992#    sw $t0,($sp)

    # compute print-size of hash value
2996#    li $t0, 1
3000#    lw $t1, ($sp)
3004#    srl $t1,$t1,4
3008#    beq $t1,$zero,toString_skip_loop
3012:toString_loop_top:
3012#    addu $t0,1
3016#    srl $t1,$t1,4
3020#    bne $t1,$zero,toString_loop_top
3024:toString_skip_loop:
3024#    subu $sp,8
3028#    sw $s5,4($sp)
3032#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
3036#    lw $t2,-12($s2) # vtable address
3040#    move $t0,$t2
3044:toString_checkTagBit:
3044#    subu $t0,1
3048#    lb $t1,($t0)
3052#    and $t1,0x80
3053##...lui $at,0
3057##...ori $at,$at,0x80
3061##...and $t1,$t1,$at
3064#    beq $t1,$zero,toString_checkTagBit
3068#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
3072#    subu $sp,8
3076#    sw $t1,($sp)
3080#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
3084#    move $s7,$zero # -4 offset header word
3088#    lw $t4,8($sp) # bytes for hash value
3092#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
3096#    addu $t4,8
3100#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
3104#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

3108#    li $t0,CLASS_String # store string vtable address into ...
3112#    sw $t0,-12($s7) # ... -12 offset in object header
3116#    lw $t2,-12($s2) # our object's vtable address
3120#    lw $t5,4($sp) # number characters in prefix
3124#    lw $t1,12($sp) # number of characters in hashcode
3128#    addu $t3,$t1,$t5 # number of characters in string ...
3132#    addu $t3,1 # ... including the '@' character
3136#    subu $t0,$zero,$t3 # store negated length into ...
3140#    sw $t0,-4($s7) # ... -4 offset header word
3144#    lw $t0,-8($s7) # get -8 offset header-word
3148#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
3149##...slt $at,$t0,$zero
3153##...beq $at,$zero,3172
3156#    and $t0,0xff # mask off object's hash value ...
3157##...lui $at,0
3161##...ori $at,$at,0xff
3165##...and $t0,$t0,$at
3168#    sw $t0,-8($s7) # ... and store back into -8 header-word
3172:skipMask_toString:
3172#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
3176#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
3180#    subu $t4,$t2,$t5
3184:toString_copyLoop:    
3184#    lb $t3,($t4)
3188#    and $t3,0x7f # mask off sign bit (in case first word)
3189##...lui $at,0
3193##...ori $at,$at,0x7f
3197##...and $t3,$t3,$at
3200#    sb $t3,-8($t0)
3204#    addu $t4,1
3208#    addu $t0,1
3212#    blt $t4,$t2,toString_copyLoop
3213##...slt $at,$t4,$t2
3217##...bne $at,$zero,3184

    # copy the '@' sign
3220#    li $t3,'@'
3224#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
3228#    addu $t2,$t0,$t1 # address of last byte in string to store +8
3232#    lw $t3,20($sp) # hash code to print
3236:toString_hashCopyLoop:
3236#    and $t4,$t3,0xf
3240#    srl $t3,4
3244#    lb $t4,hexChars($t4)
3248#    sb $t4,-8($t2)
3252#    subu $t2,$t2,1
3256#    bgt $t2,$t0,toString_hashCopyLoop
3257##...slt $at,$t0,$t2
3261##...bne $at,$zero,3236

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
3264#    addu $sp,28
3268#    lw $ra,($sp)
3272#    addu $sp,4
3276#    move $t0, $s7 # return string we created
3280#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
3284:mth_equals_String:
    
    # quick test for obvious false
3284#    lw $t0,($sp) # second parameter
3288#    beq $t0,$zero,goEsFalse # go return false if null
3292#    lw $t1,-12($t0) # vtable pointer
3296#    la $t2,CLASS_String # string vtable pointer
3300#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
3304#    subu $sp,12
3308#    sw $ra,8($sp)
3312#    sw $s2,4($sp)
3316#    sw $t0,($sp)
3320#    jal mth_compareTo_String
3324#    lw $s2, 4($sp) #restore this pointer and pop parameters
3328#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
3332#    seq $t0,$t0,$zero
3333##...subu $at,$t0,$zero
3337##...sltiu $t0,$at,1

    # pop return address and return $t0
3340#    lw $ra,($sp)
3344#    addu $sp,4

3348#    jr $ra # return
    
3352:goEsFalse:
