5795:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
5816:gcMsg: 
      .asciiz "\nGC!\n"
5822:gcCountMsg: 
      .asciiz "Number of garbage collections: "

5854:nullStr:
    .asciiz "null"
5859:trueString:
    .asciiz "true"
5864:falseString:
    .asciiz "false"
5870:exitString:
    .ascii "Program execution completed."
    #### "falls through" here
5898:newlineString:
    .asciiz "\n"
    
    .align 2
5900:stack_bottom:
    .word 0
