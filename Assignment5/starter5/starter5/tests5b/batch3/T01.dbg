##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
2008:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
2008#    lw $t0,-8($s2) # get word with hash bits from this
2012#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
2016#    addu $t0,$t1

2020#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
2024:mth_equals_Object:
2024#    move $t0,$s2 # first pointer (this)
2028#    lw $t1,($sp) # second pointer
2032#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
2033##...subu $at,$t0,$t1
2037##...sltiu $t0,$at,1

2040#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
2044:mth_hashCode_String:
2044#    move $t0,$s2 # put this pointer in t0

2048#    li $t2,0 # current hash value
2052#    lw $t1,-4($t0) # negative of number of characters in string
2056#    beq $t1,$zero,done_hashCode_String # if zero length => done
2060#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
2064#    and $t0,0xfffffffc # adjust for padding
2065##...lui $at,65535
2069##...ori $at,$at,0xfffc
2073##...and $t0,$t0,$at
2076#    subu $t1,$t0,$t1 # address at end of string +12
2080:loop_hashCode_String:    
2080#    sll $t4,$t2,5 # multiply by 32
2084#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
2088#    lbu $t3,-12($t0) # current character
2092#    addu $t2,$t3 # add in current character
2096#    addu $t0,1 # go to next character's address
2100#    bne $t0,$t1,loop_hashCode_String # loop back if more
2104:done_hashCode_String:    

    # push int on stack
2104#    move $t0, $t2 # put $t2 in return slot
2108#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
2112:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
2112#    subu $sp,4
2116#    sw $ra,($sp)
    
    # get hash value
2120#    lw $t2,-12($s2) # vtable address
2124#    lw $t0,($t2) # method address
2128#    jalr $t0
2132#    subu $sp,8 # push result (int in $t0) on stack
2136#    sw $s5,4($sp)
2140#    sw $t0,($sp)

    # compute print-size of hash value
2144#    li $t0, 1
2148#    lw $t1, ($sp)
2152#    srl $t1,$t1,4
2156#    beq $t1,$zero,toString_skip_loop
2160:toString_loop_top:
2160#    addu $t0,1
2164#    srl $t1,$t1,4
2168#    bne $t1,$zero,toString_loop_top
2172:toString_skip_loop:
2172#    subu $sp,8
2176#    sw $s5,4($sp)
2180#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
2184#    lw $t2,-12($s2) # vtable address
2188#    move $t0,$t2
2192:toString_checkTagBit:
2192#    subu $t0,1
2196#    lb $t1,($t0)
2200#    and $t1,0x80
2201##...lui $at,0
2205##...ori $at,$at,0x80
2209##...and $t1,$t1,$at
2212#    beq $t1,$zero,toString_checkTagBit
2216#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
2220#    subu $sp,8
2224#    sw $t1,($sp)
2228#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
2232#    move $s7,$zero # -4 offset header word
2236#    lw $t4,8($sp) # bytes for hash value
2240#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
2244#    addu $t4,8
2248#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
2252#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

2256#    li $t0,CLASS_String # store string vtable address into ...
2260#    sw $t0,-12($s7) # ... -12 offset in object header
2264#    lw $t2,-12($s2) # our object's vtable address
2268#    lw $t5,4($sp) # number characters in prefix
2272#    lw $t1,12($sp) # number of characters in hashcode
2276#    addu $t3,$t1,$t5 # number of characters in string ...
2280#    addu $t3,1 # ... including the '@' character
2284#    subu $t0,$zero,$t3 # store negated length into ...
2288#    sw $t0,-4($s7) # ... -4 offset header word
2292#    lw $t0,-8($s7) # get -8 offset header-word
2296#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
2297##...slt $at,$t0,$zero
2301##...beq $at,$zero,2320
2304#    and $t0,0xff # mask off object's hash value ...
2305##...lui $at,0
2309##...ori $at,$at,0xff
2313##...and $t0,$t0,$at
2316#    sw $t0,-8($s7) # ... and store back into -8 header-word
2320:skipMask_toString:
2320#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
2324#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
2328#    subu $t4,$t2,$t5
2332:toString_copyLoop:    
2332#    lb $t3,($t4)
2336#    and $t3,0x7f # mask off sign bit (in case first word)
2337##...lui $at,0
2341##...ori $at,$at,0x7f
2345##...and $t3,$t3,$at
2348#    sb $t3,-8($t0)
2352#    addu $t4,1
2356#    addu $t0,1
2360#    blt $t4,$t2,toString_copyLoop
2361##...slt $at,$t4,$t2
2365##...bne $at,$zero,2332

    # copy the '@' sign
2368#    li $t3,'@'
2372#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
2376#    addu $t2,$t0,$t1 # address of last byte in string to store +8
2380#    lw $t3,20($sp) # hash code to print
2384:toString_hashCopyLoop:
2384#    and $t4,$t3,0xf
2388#    srl $t3,4
2392#    lb $t4,hexChars($t4)
2396#    sb $t4,-8($t2)
2400#    subu $t2,$t2,1
2404#    bgt $t2,$t0,toString_hashCopyLoop
2405##...slt $at,$t0,$t2
2409##...bne $at,$zero,2384

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
2412#    addu $sp,28
2416#    lw $ra,($sp)
2420#    addu $sp,4
2424#    move $t0, $s7 # return string we created
2428#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
2432:mth_equals_String:
    
    # quick test for obvious false
2432#    lw $t0,($sp) # second parameter
2436#    beq $t0,$zero,goEsFalse # go return false if null
2440#    lw $t1,-12($t0) # vtable pointer
2444#    la $t2,CLASS_String # string vtable pointer
2448#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
2452#    subu $sp,12
2456#    sw $ra,8($sp)
2460#    sw $s2,4($sp)
2464#    sw $t0,($sp)
2468#    jal mth_compareTo_String
2472#    lw $s2, 4($sp) #restore this pointer and pop parameters
2476#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
2480#    seq $t0,$t0,$zero
2481##...subu $at,$t0,$zero
2485##...sltiu $t0,$at,1

    # pop return address and return $t0
2488#    lw $ra,($sp)
2492#    addu $sp,4

2496#    jr $ra # return
    
2500:goEsFalse:
    # put 0 in $t0 and return
2500#    li $t0, 0
2504#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
2508:mth_toString_String:
