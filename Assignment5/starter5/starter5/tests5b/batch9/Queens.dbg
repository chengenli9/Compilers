4388:  psNotNull:
    ##### we have a non-null string #####
    # this means that:
    # - number of data words in -8($t0):
    #   - if the sign bit is 1, the low 31 bits
    #   - if the sign bit is 0, the low 8 bits
    # - negative of number of characters in string is in -4($t0)
    # - string begins at $t0-8-(#dataWords*4), stored 1 char per byte
4388#    subu $t0,$t0,8
4392#    lw $t1,($t0) # number of data words, but needs modification
4396#    blt $t1,$zero,skipPrintStr1
4397##...slt $at,$t1,$zero
4401##...bne $at,$zero,4420
4404#    and $t1,0xff # mask out all but low byte
4405##...lui $at,0
4409##...ori $at,$at,0xff
4413##...and $t1,$t1,$at
4416#    b skipPrintStr2
4420:skipPrintStr1:
4420#    and $t1,0x7ffffff
4421##...lui $at,2047
4425##...ori $at,$at,0xffff
4429##...and $t1,$t1,$at
4432:skipPrintStr2:    
4432#    sll $t1,$t1,2
4436#    subu $t1,$t0,$t1 # first word in string
4440#    lw $t0,4($t0) # negative of string-length
4444#    subu $t0,$t1,$t0 # byte just beyond last char in string

    # print the chars in the string
4448#    beq $t0,$t1,donePrintStr
