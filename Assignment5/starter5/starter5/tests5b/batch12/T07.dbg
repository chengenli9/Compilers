########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
3120:vm_init:

    # mark bottom of stack
3120#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
3124#    move $s2,$zero

    #set up the "five" register
3128#    li $s5,5

3132#    la $s3,seg0_start
3136#    la $s4,seg0_end
3137##...lui $s4,16
3141##...addiu $s4,$s4,4012
    
    # return
3144#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3148:divide:
    # get parameters; abort if divisor zero
3148#    lw $t0,($sp)
3152#    lw $t1,8($sp)
3156#    beq $t0,$zero,divByZeroError
    
    # perform division
3160#    div $t1,$t0
3164#    mflo $t0

    # store result, adjust stack and return
3168#    addu $sp,$sp,8 # adjust stack
3172#    sw $t0,($sp) # store result
3176#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3180:remainder:
    # get parameters; abort if divisor zero
3180#    lw $t0,($sp)
3184#    lw $t1,8($sp)
3188#    beq $t0,$zero,divByZeroError
    
    # perform division
3192#    div $t1,$t0
3196#    mfhi $t0

    # store result, adjust stack and return
3200#    addu $sp,$sp,8 # adjust stack
3204#    sw $t0,($sp) # store result
3208#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
3212:checkCast:
    # get object, allow immediately if null
3212#    lw $t2,($sp)
3216#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
3220#    lw $t2,-12($t2) # vtable address
3224#    bge $t2,$t1,castException
3225##...slt $at,$t2,$t1
3229##...beq $at,$zero,3400
3232#    blt $t2,$t0,castException
3233##...slt $at,$t2,$t0
3237##...bne $at,$zero,3400
    
    # return, leaving object unchanged on stack
3240:  checkCastReturn:    
3240#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
3244:instanceOf:
    # get object, go return false if null
3244#    lw $t2,($sp)
3248#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
3252#    lw $t2,-12($t2) # vtable address
3256#    sge $t0,$t2,$t0 # are we >= the lower limit?
3257##...slt $t0,$t2,$t0
3261##...xori $t0,$t0,0x1
3264#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
3268#    and $t2,$t0,$t1
3272#    sw $t2,($sp)
3276:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
3276#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

3280:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
3280#    li $v0,4 # syscall-code for print-string
3284#    syscall
3288:exit:
    # print termination message
3288#    li $v0,4 # syscall-code for print-string
3292#    la $a0,exitString
3296#    syscall

    # print number of garbage collections
3300#    li $v0,4 # syscall-code for print-string
3304#    la $a0,gcCountMsg
3308#    syscall # print "Number of ..."
3312#    lw $a0,gcCount # number of GC's
3316#    li $v0,1 # code for print-int
3320#    syscall
3324#    li $v0,4 # syscall-code for print-string
3328#    la $a0,newlineString
3332#    syscall # print newline

    # terminate execution
3336#    li $v0,10 #syscall-code for "exit"
3340#    syscall

3344:outOfHeapMemory:
3344#    la $a0,heapMemoryMsg
3348#    j exitError
3352:divByZeroError:
3352#    la $a0,divByZeroMsg
3356#    j exitError
3360:strIndexOutOfBounds:
3360#    la $a0,strIndexOutOfBoundsMsg
3364#    j exitError
3368:arrayIndexOutOfBounds:
3368#    la $a0,arrayIndexOutOfBoundsMsg
3372#    j exitError
3376:arraySizeOutOfBounds:
3376#    la $a0,arraySizeOutOfBoundsMsg
3380#    j exitError
3384:nullPtrException:
3384#    la $a0,nullPtrExceptionMsg
3388#    j exitError
3392:badIntegerFormat:
3392#    la $a0,badIntegerFormatMsg
3396#    j exitError
3400:castException:
3400#    la $a0,castExceptionMsg
3404#    j exitError
############## data section ################
    .data
3640:hexChars:
    .ascii "0123456789abcdef"
    .align 2
3656:cur_seg:
    .word 0

3660:lastCharRead:
    .word -2 # -2 => no buffered character
3664:prevHashConstant:
    .word 0x2785173c
3668:gcCount:
    .word 0

3672:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
3699:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
3722:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
3757:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
3791:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
3824:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
3855:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
3903:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
3924:gcMsg: 
      .asciiz "\nGC!\n"
3930:gcCountMsg: 
      .asciiz "Number of garbage collections: "

3962:nullStr:
    .asciiz "null"
3967:trueString:
    .asciiz "true"
3972:falseString:
    .asciiz "false"
3978:exitString:
    .ascii "Program execution completed."
    #### "falls through" here
4006:newlineString:
    .asciiz "\n"
    
    .align 2
4008:stack_bottom:
    .word 0

