    # save $ra by pushing onto stack
2004#    subu $sp,$sp,4
2008#    sw $ra,($sp)

      # read the character
2012#    jal readLogicalChar

    # restore return address; put value in $t0
    # replacing this-pointer saved return address
2016#    lw $ra,($sp)
2020#    addu $sp, 4
2024#    move $t0, $v0

    # return
2028#    jr $ra
