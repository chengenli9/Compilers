3877##...lui $at,0
3881##...ori $at,$at,0xff
3885##...and $t2,$t2,$at
    #### OLD
    #### subu $t2,$zero,$t2 # set to 1 if -1 (number of data words)

3888:  gcSkip2:
3888#    sll $t2,$t2,2
3892#    addu $t2,$t2,8
