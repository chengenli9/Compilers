    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
3984#    sw $zero,-8($t1) # 0 in first header-slot
3988#    sw $t2,-4($t1) # forwarding pointer in second header-slot

    # update the stack slot with the address in the target space
3992#    sw $t2,4($t0)
3996#    lw $zero,-8($t2)
4000#    lw $zero,-4($t2)

    # go handle next stack slot (testing if done)
4004#    j gcTestIterDone1

4008:  gcBump:
    #### we have a GC tag.  Bytes to skip: tag value + 3.
4008#    subu $t0,$t0,$t1
4012#    subu $t0,$t0,3

4016:  gcTestIterDone1:
4016#    bgeu $t0,$sp,gcStackCopyLoop
4017##...sltu $at,$t0,$sp
4021##...beq $at,$zero,3832

    ###### end outer loop to copy all stack-direct objects ######

    #############################################################
    # We have finished processing the stack elements.  Now we need
    # to update elements in the heap itself. This may itself involve
    # moving additional objects
    #############################################################

    #########################################################
    # At this point:
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # We want to set things up so that in addition:
    # - $t0 is the "trailing finger", containing the address
    #   of the first slot in target space that we have yet
    #   to process.
    # Then during processing:
    # - $t1 will contain the contents of the heap slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # And when we're actually copying an object:
    # - $t2 will contain pointer to the target object
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - available for use: $s0
    ##########################################################

    # set $t0 to be at the beginning of target-space
4024#    lw $t1,cur_seg
4028#    la $t0,seg0_start
4032#    beq $t1,$zero,gcSkip4
4036#    la $t0,seg1_start
4037##...lui $t0,16
4041##...addiu $t0,$t0,5212


4044:  gcSkip4:

    # if there were no objects put into the heap during stack
    # processing, we're done, so go finish up
4044#    bgeu $t0,$s3,gcFinishUp
4045##...sltu $at,$t0,$s3
4049##...beq $at,$zero,4340

    ###### begin outer loop to copy all non-stack-direct objects ######

4052:  gcHeapCopyLoop:
    # get data count for object; swap header-word with first word
    # of object so that they're back in the right place
4052#    lw $t1,($t0) # (what will be) first header word for current object
4056#    move $t2,$t1 # number data bytes in object (poss. w/hash bits)
4060#    bge $t2,$zero,gcSkip4a # are there hash bits?
4061##...slt $at,$t2,$zero
4065##...beq $at,$zero,4080
4068#    and $t2,0xff # mask off hash bits
4069##...lui $at,0
4073##...ori $at,$at,0xff
4077##...and $t2,$t2,$at
4080:gcSkip4a:    
4080#    sll $t2,$t2,2 # # data bytes
4084#    addu $t2,$t2,8 # to skip header words
4088#    addu $t2,$t0,$t2 # pointer to new object
4092#    lw $t3,-8($t2) # word to swap
4096#    sw $t1,-8($t2) # store header word
4100#    sw $t3,($t0) # restore first word of object

    ################################################
    # at this point:
    # - $t2 contains the pointer to our new object
    ################################################

    # check if we have a data array
4104#    lw $t1,-12($t2) # vtable pointer
4108#    li $t0,dataArrayVTableStart # address of vtable for first data array
4112#    blt $t1,$t0,gcNotDataArray # if data array, no more xforming to do
4113##...slt $at,$t1,$t0
4117##...bne $at,$zero,4136

    # We have a vtable address that is a data array.
    # we need skip over it then loop back to do next object.
4120:  skipToNextObj:
4120#    lw $t1,-4($t2) # data words in (object position of) array
    #### note: we know that it's not a string, so the value will
    #### not be artificially negative
4124#    sll $t1,$t1,2 # convert to byte-count
4128#    addu $t0,$t2,$t1 # skip over object
4132#    j gcTestIterDone2 # go do next object, if any

    ###################################################
    # at this point:
    # - the object has been restored to normal status--that is, the
    #   word-swap has been done
    # - $t2 contains a pointer to the object
    ###################################################
    
4136:  gcNotDataArray:
4136#    lw $t3,-4($t2) # # object words (negative treated as zero)
4140#    bge $t3,$zero,gcH2Neg2
4141##...slt $at,$t3,$zero
4145##...beq $at,$zero,4152
4148#    move $t3,$zero
4152:  gcH2Neg2:
4152#    sll $t3,$t3,2 # # object bytes
4156#    move $t0,$t2 # address of first pointer in object
4160#    add $s1,$t2,$t3 # limit address for this object

    #####################################################
    # At this point, we have to "translate" all pointers,
    # starting at $t0 to (but not including) $s1
    #####################################################

    # if there are no pointer-slots (i.e., $t0=$s1), skip this
    # part
4164#    beq $t0,$s1,gcTestIterDone2
    
4168:  gcNextPointerInObject:
    # get pointer from object
4168#    lw $t1,($t0)

    # if value is out of range, and is therefore does not refer
    # to an object, just go loop back and do the next one
4172#    bleu $t1,$t6,gcGoNextPointerSlot
4173##...sltu $at,$t6,$t1
4177##...beq $at,$zero,4320
4180#    bgtu $t1,$t7,gcGoNextPointerSlot
4181##...sltu $at,$t7,$t1
4185##...bne $at,$zero,4320

    # if the object has already been moved, update the stack-value
    # via the forwarding pointer
4188#    lw $t8,-8($t1) # possible forwarding tag
4192#    bne $t8,$zero,gcNoForward2 # if not forwarding tag, go copy
4196#    lw $t8,-4($t1) # forwarding pointer: object's new address
4200#    sw $t8,($t0) # update pointer in object
4204#    j gcGoNextPointerSlot # do next iteration

4208:  gcNoForward2:
    #########################################################
    # we actually need to copy the object into the new space
    #########################################################

    #########################################################
    # At this point:
    # - $t0 contains the address of the heap-slot we're translating
    # - $t1 will contain the contents of the heap-slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space, which will also be the first address
    #   of the target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # Then during processing:
    # And when we're actually copying an object:
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $t8 will contain a pointer to the target object
    # - available for use: $s0, $t8, $t9
    ##########################################################

    # compute the amount of space that is needed
4208#    bge $t8,$zero,gcSkip5 # # words in negative-offset portion
4209##...slt $at,$t8,$zero
4213##...beq $at,$zero,4228
4216#    and $t8,0xff # mask off hash bits
4217##...lui $at,0
4221##...ori $at,$at,0xff
4225##...and $t8,$t8,$at

4228:  gcSkip5:
4228#    sll $t8,$t8,2 # bytes in negative-offset portion ...
4232#    addu $t8,$t8,8 # ... add in bytes for header-words
4236#    subu $t4,$t1,$t8 # address of first word of source object
4240#    lw $t3,-4($t1) # # words in positive-offset portion
4244#    bge $t3,$zero,gcNoNeg
4245##...slt $at,$t3,$zero
4249##...beq $at,$zero,4256
4252#    move $t3,$zero # negative treated as zero
4256:  gcNoNeg:
4256#    sll $t3,$t3,2 # bytes in negative-offset portion
4260#    addu $t3,$t3,$t1 # address one word past last word of source

4264#    addu $t8,$s3,$t8 # pointer to target object

    #########################################################
    # At this point:
    # - $t0 contains the address of the stack slot we'll
    #   process next
    # - $t1 contains the contents of the stack slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $t8 contains the pointer to the target object
    # - $s1 contains the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0, $t9
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger"
4268#    lw $s0,($t4)
4272#    lw $t9,-8($t1)
4276#    sw $t9,($t4)
4280#    sw $s0,-8($t1)

    # copy all source bytes to the target
4284:  gCinnerCopy2:
4284#    lw $s0,($t4)
4288#    sw $s0,($s3)
4292#    addu $t4,$t4,4
4296#    addu $s3,$s3,4
4300#    bltu $t4,$t3,gCinnerCopy2
4301##...sltu $at,$t4,$t3
4305##...bne $at,$zero,4284

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
4308#    sw $zero,-8($t1) # 0 in first header-slot
4312#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
4316#    sw $t8,($t0)

4320:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
4320#    addu $t0,$t0,4
4324#    bltu $t0,$s1,gcNextPointerInObject
4325##...sltu $at,$t0,$s1
4329##...bne $at,$zero,4168

4332:  gcTestIterDone2:
4332#    bltu $t0,$s3,gcHeapCopyLoop
4333##...sltu $at,$t0,$s3
4337##...bne $at,$zero,4052

    ###### end outer loop to copy all non-stack-direct objects ######

4340:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
4340#    lw $s2,($sp)
4344#    addu $sp,$sp,4

    # mark us as having already GC'd
4348#    move $t5,$s5

    # go try and allocate again
4352#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
4356:vm_init:

    # mark bottom of stack
4356#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
4360#    move $s2,$zero

    #set up the "five" register
4364#    li $s5,5

4368#    la $s3,seg0_start
4372#    la $s4,seg0_end
4373##...lui $s4,16
4377##...addiu $s4,$s4,5212
    
    # return
4380#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4384:divide:
    # get parameters; abort if divisor zero
4384#    lw $t0,($sp)
4388#    lw $t1,8($sp)
4392#    beq $t0,$zero,divByZeroError
    
    # perform division
4396#    div $t1,$t0
4400#    mflo $t0

    # store result, adjust stack and return
4404#    addu $sp,$sp,8 # adjust stack
4408#    sw $t0,($sp) # store result
4412#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4416:remainder:
    # get parameters; abort if divisor zero
4416#    lw $t0,($sp)
4420#    lw $t1,8($sp)
4424#    beq $t0,$zero,divByZeroError
    
    # perform division
4428#    div $t1,$t0
4432#    mfhi $t0

    # store result, adjust stack and return
4436#    addu $sp,$sp,8 # adjust stack
4440#    sw $t0,($sp) # store result
4444#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
4448:checkCast:
    # get object, allow immediately if null
4448#    lw $t2,($sp)
4452#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
4456#    lw $t2,-12($t2) # vtable address
4460#    bge $t2,$t1,castException
4461##...slt $at,$t2,$t1
4465##...beq $at,$zero,4636
4468#    blt $t2,$t0,castException
4469##...slt $at,$t2,$t0
4473##...bne $at,$zero,4636
    
    # return, leaving object unchanged on stack
4476:  checkCastReturn:    
4476#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
4480:instanceOf:
    # get object, go return false if null
4480#    lw $t2,($sp)
4484#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
4488#    lw $t2,-12($t2) # vtable address
4492#    sge $t0,$t2,$t0 # are we >= the lower limit?
4493##...slt $t0,$t2,$t0
4497##...xori $t0,$t0,0x1
4500#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
4504#    and $t2,$t0,$t1
4508#    sw $t2,($sp)
4512:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
4512#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

4516:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
4516#    li $v0,4 # syscall-code for print-string
4520#    syscall
4524:exit:
    # print termination message
4524#    li $v0,4 # syscall-code for print-string
4528#    la $a0,exitString
4532#    syscall

    # print number of garbage collections
4536#    li $v0,4 # syscall-code for print-string
4540#    la $a0,gcCountMsg
4544#    syscall # print "Number of ..."
4548#    lw $a0,gcCount # number of GC's
4552#    li $v0,1 # code for print-int
4556#    syscall
4560#    li $v0,4 # syscall-code for print-string
4564#    la $a0,newlineString
4568#    syscall # print newline

    # terminate execution
4572#    li $v0,10 #syscall-code for "exit"
4576#    syscall

4580:outOfHeapMemory:
4580#    la $a0,heapMemoryMsg
4584#    j exitError
4588:divByZeroError:
4588#    la $a0,divByZeroMsg
4592#    j exitError
4596:strIndexOutOfBounds:
4596#    la $a0,strIndexOutOfBoundsMsg
4600#    j exitError
4604:arrayIndexOutOfBounds:
4604#    la $a0,arrayIndexOutOfBoundsMsg
4608#    j exitError
4612:arraySizeOutOfBounds:
4612#    la $a0,arraySizeOutOfBoundsMsg
4616#    j exitError
4620:nullPtrException:
4620#    la $a0,nullPtrExceptionMsg
4624#    j exitError
4628:badIntegerFormat:
4628#    la $a0,badIntegerFormatMsg
4632#    j exitError
4636:castException:
4636#    la $a0,castExceptionMsg
4640#    j exitError
############## data section ################
    .data
4840:hexChars:
    .ascii "0123456789abcdef"
    .align 2
4856:cur_seg:
    .word 0

4860:lastCharRead:
    .word -2 # -2 => no buffered character
4864:prevHashConstant:
    .word 0x2785173c
4868:gcCount:
    .word 0

4872:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
4899:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
4922:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
4957:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
4991:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
5024:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
5055:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
5103:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
5124:gcMsg: 
      .asciiz "\nGC!\n"
5130:gcCountMsg: 
      .asciiz "Number of garbage collections: "
