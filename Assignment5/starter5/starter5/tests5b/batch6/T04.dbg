########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
4440:vm_init:

    # mark bottom of stack
4440#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
4444#    move $s2,$zero

    #set up the "five" register
4448#    li $s5,5

4452#    la $s3,seg0_start
4456#    la $s4,seg0_end
4457##...lui $s4,16
4461##...addiu $s4,$s4,5412
    
    # return
4464#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4468:divide:
    # get parameters; abort if divisor zero
4468#    lw $t0,($sp)
4472#    lw $t1,8($sp)
4476#    beq $t0,$zero,divByZeroError
    
    # perform division
4480#    div $t1,$t0
4484#    mflo $t0

    # store result, adjust stack and return
4488#    addu $sp,$sp,8 # adjust stack
4492#    sw $t0,($sp) # store result
4496#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4500:remainder:
    # get parameters; abort if divisor zero
4500#    lw $t0,($sp)
4504#    lw $t1,8($sp)
4508#    beq $t0,$zero,divByZeroError
    
    # perform division
4512#    div $t1,$t0
4516#    mfhi $t0

    # store result, adjust stack and return
4520#    addu $sp,$sp,8 # adjust stack
4524#    sw $t0,($sp) # store result
4528#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
4532:checkCast:
    # get object, allow immediately if null
4532#    lw $t2,($sp)
4536#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
4540#    lw $t2,-12($t2) # vtable address
4544#    bge $t2,$t1,castException
4545##...slt $at,$t2,$t1
4549##...beq $at,$zero,4720
4552#    blt $t2,$t0,castException
4553##...slt $at,$t2,$t0
4557##...bne $at,$zero,4720
    
    # return, leaving object unchanged on stack
4560:  checkCastReturn:    
4560#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
4564:instanceOf:
    # get object, go return false if null
4564#    lw $t2,($sp)
4568#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
4572#    lw $t2,-12($t2) # vtable address
4576#    sge $t0,$t2,$t0 # are we >= the lower limit?
4577##...slt $t0,$t2,$t0
4581##...xori $t0,$t0,0x1
4584#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
4588#    and $t2,$t0,$t1
4592#    sw $t2,($sp)
4596:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
4596#    jr $ra

