##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
276:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
276#    lw $t0,-8($s2) # get word with hash bits from this
280#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
284#    addu $t0,$t1

288#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
292:mth_equals_Object:
292#    move $t0,$s2 # first pointer (this)
296#    lw $t1,($sp) # second pointer
300#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
301##...subu $at,$t0,$t1
305##...sltiu $t0,$at,1

308#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
312:mth_hashCode_String:
312#    move $t0,$s2 # put this pointer in t0

316#    li $t2,0 # current hash value
320#    lw $t1,-4($t0) # negative of number of characters in string
324#    beq $t1,$zero,done_hashCode_String # if zero length => done
328#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
332#    and $t0,0xfffffffc # adjust for padding
333##...lui $at,65535
337##...ori $at,$at,0xfffc
341##...and $t0,$t0,$at
344#    subu $t1,$t0,$t1 # address at end of string +12
348:loop_hashCode_String:    
348#    sll $t4,$t2,5 # multiply by 32
352#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
356#    lbu $t3,-12($t0) # current character
360#    addu $t2,$t3 # add in current character
364#    addu $t0,1 # go to next character's address
368#    bne $t0,$t1,loop_hashCode_String # loop back if more
372:done_hashCode_String:    

    # push int on stack
372#    move $t0, $t2 # put $t2 in return slot
376#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
380:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
380#    subu $sp,4
384#    sw $ra,($sp)
    
    # get hash value
388#    lw $t2,-12($s2) # vtable address
392#    lw $t0,($t2) # method address
396#    jalr $t0
400#    subu $sp,8 # push result (int in $t0) on stack
404#    sw $s5,4($sp)
408#    sw $t0,($sp)

    # compute print-size of hash value
412#    li $t0, 1
416#    lw $t1, ($sp)
420#    srl $t1,$t1,4
424#    beq $t1,$zero,toString_skip_loop
428:toString_loop_top:
428#    addu $t0,1
432#    srl $t1,$t1,4
436#    bne $t1,$zero,toString_loop_top
440:toString_skip_loop:
440#    subu $sp,8
444#    sw $s5,4($sp)
448#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
452#    lw $t2,-12($s2) # vtable address
456#    move $t0,$t2
460:toString_checkTagBit:
460#    subu $t0,1
464#    lb $t1,($t0)
468#    and $t1,0x80
469##...lui $at,0
473##...ori $at,$at,0x80
477##...and $t1,$t1,$at
480#    beq $t1,$zero,toString_checkTagBit
484#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
488#    subu $sp,8
492#    sw $t1,($sp)
496#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
500#    move $s7,$zero # -4 offset header word
504#    lw $t4,8($sp) # bytes for hash value
508#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
512#    addu $t4,8
516#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
520#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

524#    li $t0,CLASS_String # store string vtable address into ...
528#    sw $t0,-12($s7) # ... -12 offset in object header
532#    lw $t2,-12($s2) # our object's vtable address
536#    lw $t5,4($sp) # number characters in prefix
540#    lw $t1,12($sp) # number of characters in hashcode
544#    addu $t3,$t1,$t5 # number of characters in string ...
548#    addu $t3,1 # ... including the '@' character
552#    subu $t0,$zero,$t3 # store negated length into ...
556#    sw $t0,-4($s7) # ... -4 offset header word
560#    lw $t0,-8($s7) # get -8 offset header-word
564#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
565##...slt $at,$t0,$zero
569##...beq $at,$zero,588
572#    and $t0,0xff # mask off object's hash value ...
573##...lui $at,0
577##...ori $at,$at,0xff
581##...and $t0,$t0,$at
584#    sw $t0,-8($s7) # ... and store back into -8 header-word
588:skipMask_toString:
588#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
592#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
596#    subu $t4,$t2,$t5
600:toString_copyLoop:    
600#    lb $t3,($t4)
604#    and $t3,0x7f # mask off sign bit (in case first word)
605##...lui $at,0
609##...ori $at,$at,0x7f
613##...and $t3,$t3,$at
616#    sb $t3,-8($t0)
620#    addu $t4,1
624#    addu $t0,1
628#    blt $t4,$t2,toString_copyLoop
629##...slt $at,$t4,$t2
633##...bne $at,$zero,600

    # copy the '@' sign
636#    li $t3,'@'
640#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
644#    addu $t2,$t0,$t1 # address of last byte in string to store +8
648#    lw $t3,20($sp) # hash code to print
652:toString_hashCopyLoop:
652#    and $t4,$t3,0xf
656#    srl $t3,4
660#    lb $t4,hexChars($t4)
664#    sb $t4,-8($t2)
668#    subu $t2,$t2,1
672#    bgt $t2,$t0,toString_hashCopyLoop
673##...slt $at,$t0,$t2
677##...bne $at,$zero,652

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
680#    addu $sp,28
684#    lw $ra,($sp)
688#    addu $sp,4
692#    move $t0, $s7 # return string we created
696#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
700:mth_equals_String:
    
    # quick test for obvious false
700#    lw $t0,($sp) # second parameter
704#    beq $t0,$zero,goEsFalse # go return false if null
708#    lw $t1,-12($t0) # vtable pointer
