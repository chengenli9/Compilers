3248#    lw $t2,($sp)
3252#    sb $t2,-9($t0)
3256#    addu $sp,$sp,4
3260#    subu $t0,$t0,1
3264#    bne $sp,$t1,charCopyLoop
3268:  rlReturn:

3268#    lw $ra, 4($sp)
3272#    addu $sp, 8   # pop $ra and pointless word off stack
3276#    move $t0, $s7 # return string we allocated in $s7
3280#    jr $ra

