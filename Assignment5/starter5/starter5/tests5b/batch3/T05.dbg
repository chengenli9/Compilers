    # At this point:
    # - $t0 contains the address of the heap-slot we're translating
    # - $t1 will contain the contents of the heap-slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space, which will also be the first address
    #   of the target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # Then during processing:
    # And when we're actually copying an object:
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $t8 will contain a pointer to the target object
    # - available for use: $s0, $t8, $t9
    ##########################################################

    # compute the amount of space that is needed
5012#    bge $t8,$zero,gcSkip5 # # words in negative-offset portion
5013##...slt $at,$t8,$zero
5017##...beq $at,$zero,5032
5020#    and $t8,0xff # mask off hash bits
5021##...lui $at,0
5025##...ori $at,$at,0xff
5029##...and $t8,$t8,$at

5032:  gcSkip5:
5032#    sll $t8,$t8,2 # bytes in negative-offset portion ...
5036#    addu $t8,$t8,8 # ... add in bytes for header-words
5040#    subu $t4,$t1,$t8 # address of first word of source object
5044#    lw $t3,-4($t1) # # words in positive-offset portion
5048#    bge $t3,$zero,gcNoNeg
5049##...slt $at,$t3,$zero
5053##...beq $at,$zero,5060
5056#    move $t3,$zero # negative treated as zero
5060:  gcNoNeg:
5060#    sll $t3,$t3,2 # bytes in negative-offset portion
5064#    addu $t3,$t3,$t1 # address one word past last word of source

5068#    addu $t8,$s3,$t8 # pointer to target object

    #########################################################
    # At this point:
    # - $t0 contains the address of the stack slot we'll
    #   process next
    # - $t1 contains the contents of the stack slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $t8 contains the pointer to the target object
    # - $s1 contains the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0, $t9
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger"
5072#    lw $s0,($t4)
5076#    lw $t9,-8($t1)
5080#    sw $t9,($t4)
5084#    sw $s0,-8($t1)

    # copy all source bytes to the target
5088:  gCinnerCopy2:
5088#    lw $s0,($t4)
5092#    sw $s0,($s3)
5096#    addu $t4,$t4,4
5100#    addu $s3,$s3,4
5104#    bltu $t4,$t3,gCinnerCopy2
5105##...sltu $at,$t4,$t3
5109##...bne $at,$zero,5088

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
5112#    sw $zero,-8($t1) # 0 in first header-slot
5116#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
5120#    sw $t8,($t0)

5124:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
5124#    addu $t0,$t0,4
5128#    bltu $t0,$s1,gcNextPointerInObject
5129##...sltu $at,$t0,$s1
5133##...bne $at,$zero,4972

5136:  gcTestIterDone2:
5136#    bltu $t0,$s3,gcHeapCopyLoop
5137##...sltu $at,$t0,$s3
5141##...bne $at,$zero,4856

    ###### end outer loop to copy all non-stack-direct objects ######

5144:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
5144#    lw $s2,($sp)
5148#    addu $sp,$sp,4

    # mark us as having already GC'd
5152#    move $t5,$s5

    # go try and allocate again
5156#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
5160:vm_init:

    # mark bottom of stack
5160#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
5164#    move $s2,$zero

    #set up the "five" register
5168#    li $s5,5

5172#    la $s3,seg0_start
5176#    la $s4,seg0_end
5177##...lui $s4,16
5181##...addiu $s4,$s4,6260
    
    # return
5184#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
5188:divide:
    # get parameters; abort if divisor zero
5188#    lw $t0,($sp)
5192#    lw $t1,8($sp)
5196#    beq $t0,$zero,divByZeroError
    
    # perform division
5200#    div $t1,$t0
5204#    mflo $t0

    # store result, adjust stack and return
5208#    addu $sp,$sp,8 # adjust stack
5212#    sw $t0,($sp) # store result
5216#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
5220:remainder:
    # get parameters; abort if divisor zero
5220#    lw $t0,($sp)
5224#    lw $t1,8($sp)
5228#    beq $t0,$zero,divByZeroError
    
    # perform division
5232#    div $t1,$t0
5236#    mfhi $t0

    # store result, adjust stack and return
5240#    addu $sp,$sp,8 # adjust stack
5244#    sw $t0,($sp) # store result
5248#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
5252:checkCast:
    # get object, allow immediately if null
5252#    lw $t2,($sp)
5256#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
5260#    lw $t2,-12($t2) # vtable address
5264#    bge $t2,$t1,castException
5265##...slt $at,$t2,$t1
5269##...beq $at,$zero,5404
5272#    blt $t2,$t0,castException
5273##...slt $at,$t2,$t0
5277##...bne $at,$zero,5404
    
    # return, leaving object unchanged on stack
5280:  checkCastReturn:    
5280#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
5284:instanceOf:
    # get object, go return false if null
5284#    lw $t2,($sp)
5288#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
5292#    lw $t2,-12($t2) # vtable address
5296#    sge $t0,$t2,$t0 # are we >= the lower limit?
5297##...slt $t0,$t2,$t0
5301##...xori $t0,$t0,0x1
5304#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
5308#    and $t2,$t0,$t1
5312#    sw $t2,($sp)
5316:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
5316#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

5320:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
5320#    li $v0,4 # syscall-code for print-string
5324#    syscall
5328:exit:
    # print termination message
5328#    li $v0,4 # syscall-code for print-string
5332#    la $a0,exitString
5336#    syscall

    # terminate execution
5340#    li $v0,10 #syscall-code for "exit"
5344#    syscall

5348:outOfHeapMemory:
5348#    la $a0,heapMemoryMsg
5352#    j exitError
5356:divByZeroError:
5356#    la $a0,divByZeroMsg
5360#    j exitError
5364:strIndexOutOfBounds:
5364#    la $a0,strIndexOutOfBoundsMsg
5368#    j exitError
5372:arrayIndexOutOfBounds:
5372#    la $a0,arrayIndexOutOfBoundsMsg
5376#    j exitError
5380:arraySizeOutOfBounds:
5380#    la $a0,arraySizeOutOfBoundsMsg
5384#    j exitError
5388:nullPtrException:
5388#    la $a0,nullPtrExceptionMsg
5392#    j exitError
5396:badIntegerFormat:
5396#    la $a0,badIntegerFormatMsg
5400#    j exitError
5404:castException:
5404#    la $a0,castExceptionMsg
5408#    j exitError
############## data section ################
    .data
5896:hexChars:
    .ascii "0123456789abcdef"
    .align 2
5912:cur_seg:
    .word 0

5916:lastCharRead:
    .word -2 # -2 => no buffered character
5920:prevHashConstant:
    .word 0x2785173c
5924:gcCount:
    .word 0

5928:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
5955:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
5978:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
6013:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
6047:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
6080:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
6111:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
6159:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
6180:gcMsg: 
      .asciiz "\nGC!\n"
6186:gcCountMsg: 
      .asciiz "Number of garbage collections: "

6218:nullStr:
    .asciiz "null"
6223:trueString:
    .asciiz "true"
6228:falseString:
    .asciiz "false"
6234:exitString:
    .ascii "Program terminated."
    #### "falls through" here
6253:newlineString:
    .asciiz "\n"
    
    .align 2
6256:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

6260:seg0_start:
    .space 0x100000
1054836:seg0_end:
1054836:seg1_start:
    .space 0x100000
2103412:seg1_end:
