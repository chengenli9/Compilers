    # greater
3156#    slt $t5,$t4,$t3 # 1 if str2 > str1, else 0
3160#    sll $t5,$t5,1 # 2 if str2 > str1, else 0
3164#    subu $t5,$t5,1 # 1 if str2 > str1, else -1
3168:  cmpHitLimitzz:
3168#    move $t0, $t5 # store return value
3172#    jr $ra # return
