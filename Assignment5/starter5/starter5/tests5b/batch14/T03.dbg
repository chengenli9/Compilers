########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
7544:vm_init:

    # mark bottom of stack
7544#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
7548#    move $s2,$zero

    #set up the "five" register
7552#    li $s5,5

7556#    la $s3,seg0_start
7560#    la $s4,seg0_end
7561##...lui $s4,16
7565##...addiu $s4,$s4,8864
    
    # return
7568#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
7572:divide:
    # get parameters; abort if divisor zero
7572#    lw $t0,($sp)
7576#    lw $t1,8($sp)
7580#    beq $t0,$zero,divByZeroError
    
    # perform division
7584#    div $t1,$t0
7588#    mflo $t0

    # store result, adjust stack and return
7592#    addu $sp,$sp,8 # adjust stack
7596#    sw $t0,($sp) # store result
7600#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
7604:remainder:
    # get parameters; abort if divisor zero
7604#    lw $t0,($sp)
7608#    lw $t1,8($sp)
7612#    beq $t0,$zero,divByZeroError
    
    # perform division
7616#    div $t1,$t0
7620#    mfhi $t0

    # store result, adjust stack and return
7624#    addu $sp,$sp,8 # adjust stack
7628#    sw $t0,($sp) # store result
7632#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
7636:checkCast:
    # get object, allow immediately if null
7636#    lw $t2,($sp)
7640#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
7644#    lw $t2,-12($t2) # vtable address
7648#    bge $t2,$t1,castException
7649##...slt $at,$t2,$t1
7653##...beq $at,$zero,7824
7656#    blt $t2,$t0,castException
7657##...slt $at,$t2,$t0
7661##...bne $at,$zero,7824
    
    # return, leaving object unchanged on stack
7664:  checkCastReturn:    
7664#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
7668:instanceOf:
    # get object, go return false if null
7668#    lw $t2,($sp)
7672#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
7676#    lw $t2,-12($t2) # vtable address
7680#    sge $t0,$t2,$t0 # are we >= the lower limit?
7681##...slt $t0,$t2,$t0
7685##...xori $t0,$t0,0x1
7688#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
7692#    and $t2,$t0,$t1
7696#    sw $t2,($sp)
7700:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
7700#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

7704:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
7704#    li $v0,4 # syscall-code for print-string
7708#    syscall
7712:exit:
    # print termination message
7712#    li $v0,4 # syscall-code for print-string
7716#    la $a0,exitString
7720#    syscall

    # print number of garbage collections
7724#    li $v0,4 # syscall-code for print-string
7728#    la $a0,gcCountMsg
7732#    syscall # print "Number of ..."
7736#    lw $a0,gcCount # number of GC's
7740#    li $v0,1 # code for print-int
7744#    syscall
7748#    li $v0,4 # syscall-code for print-string
7752#    la $a0,newlineString
7756#    syscall # print newline

    # terminate execution
7760#    li $v0,10 #syscall-code for "exit"
7764#    syscall

7768:outOfHeapMemory:
7768#    la $a0,heapMemoryMsg
7772#    j exitError
7776:divByZeroError:
7776#    la $a0,divByZeroMsg
7780#    j exitError
