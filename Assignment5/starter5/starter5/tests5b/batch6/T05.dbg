    #### note: we know that it's not a string, so the value will
    #### not be artificially negative
3752#    sll $t1,$t1,2 # convert to byte-count
3756#    addu $t0,$t2,$t1 # skip over object
3760#    j gcTestIterDone2 # go do next object, if any

    ###################################################
    # at this point:
    # - the object has been restored to normal status--that is, the
    #   word-swap has been done
    # - $t2 contains a pointer to the object
    ###################################################
    
3764:  gcNotDataArray:
3764#    lw $t3,-4($t2) # # object words (negative treated as zero)
3768#    bge $t3,$zero,gcH2Neg2
3769##...slt $at,$t3,$zero
3773##...beq $at,$zero,3780
3776#    move $t3,$zero
3780:  gcH2Neg2:
3780#    sll $t3,$t3,2 # # object bytes
3784#    move $t0,$t2 # address of first pointer in object
3788#    add $s1,$t2,$t3 # limit address for this object

    #####################################################
    # At this point, we have to "translate" all pointers,
    # starting at $t0 to (but not including) $s1
    #####################################################

    # if there are no pointer-slots (i.e., $t0=$s1), skip this
    # part
3792#    beq $t0,$s1,gcTestIterDone2
    
3796:  gcNextPointerInObject:
    # get pointer from object
3796#    lw $t1,($t0)

    # if value is out of range, and is therefore does not refer
    # to an object, just go loop back and do the next one
3800#    bleu $t1,$t6,gcGoNextPointerSlot
3801##...sltu $at,$t6,$t1
3805##...beq $at,$zero,3948
3808#    bgtu $t1,$t7,gcGoNextPointerSlot
3809##...sltu $at,$t7,$t1
3813##...bne $at,$zero,3948

    # if the object has already been moved, update the stack-value
    # via the forwarding pointer
3816#    lw $t8,-8($t1) # possible forwarding tag
3820#    bne $t8,$zero,gcNoForward2 # if not forwarding tag, go copy
3824#    lw $t8,-4($t1) # forwarding pointer: object's new address
3828#    sw $t8,($t0) # update pointer in object
3832#    j gcGoNextPointerSlot # do next iteration

3836:  gcNoForward2:
    #########################################################
    # we actually need to copy the object into the new space
    #########################################################

    #########################################################
    # At this point:
    # - $t0 contains the address of the heap-slot we're translating
    # - $t1 will contain the contents of the heap-slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space, which will also be the first address
    #   of the target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # Then during processing:
    # And when we're actually copying an object:
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $t8 will contain a pointer to the target object
    # - available for use: $s0, $t8, $t9
    ##########################################################

    # compute the amount of space that is needed
3836#    bge $t8,$zero,gcSkip5 # # words in negative-offset portion
3837##...slt $at,$t8,$zero
3841##...beq $at,$zero,3856
3844#    and $t8,0xff # mask off hash bits
3845##...lui $at,0
3849##...ori $at,$at,0xff
3853##...and $t8,$t8,$at

3856:  gcSkip5:
3856#    sll $t8,$t8,2 # bytes in negative-offset portion ...
3860#    addu $t8,$t8,8 # ... add in bytes for header-words
3864#    subu $t4,$t1,$t8 # address of first word of source object
3868#    lw $t3,-4($t1) # # words in positive-offset portion
3872#    bge $t3,$zero,gcNoNeg
3873##...slt $at,$t3,$zero
3877##...beq $at,$zero,3884
3880#    move $t3,$zero # negative treated as zero
3884:  gcNoNeg:
3884#    sll $t3,$t3,2 # bytes in negative-offset portion
3888#    addu $t3,$t3,$t1 # address one word past last word of source

3892#    addu $t8,$s3,$t8 # pointer to target object

    #########################################################
    # At this point:
    # - $t0 contains the address of the stack slot we'll
    #   process next
    # - $t1 contains the contents of the stack slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $t8 contains the pointer to the target object
    # - $s1 contains the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0, $t9
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger"
3896#    lw $s0,($t4)
3900#    lw $t9,-8($t1)
3904#    sw $t9,($t4)
3908#    sw $s0,-8($t1)

    # copy all source bytes to the target
3912:  gCinnerCopy2:
3912#    lw $s0,($t4)
3916#    sw $s0,($s3)
3920#    addu $t4,$t4,4
3924#    addu $s3,$s3,4
3928#    bltu $t4,$t3,gCinnerCopy2
3929##...sltu $at,$t4,$t3
3933##...bne $at,$zero,3912

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
3936#    sw $zero,-8($t1) # 0 in first header-slot
3940#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
3944#    sw $t8,($t0)

3948:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
3948#    addu $t0,$t0,4
3952#    bltu $t0,$s1,gcNextPointerInObject
3953##...sltu $at,$t0,$s1
3957##...bne $at,$zero,3796

3960:  gcTestIterDone2:
3960#    bltu $t0,$s3,gcHeapCopyLoop
3961##...sltu $at,$t0,$s3
3965##...bne $at,$zero,3680

    ###### end outer loop to copy all non-stack-direct objects ######

3968:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
3968#    lw $s2,($sp)
3972#    addu $sp,$sp,4

    # mark us as having already GC'd
3976#    move $t5,$s5

    # go try and allocate again
3980#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
3984:vm_init:

    # mark bottom of stack
3984#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
3988#    move $s2,$zero

    #set up the "five" register
3992#    li $s5,5

3996#    la $s3,seg0_start
4000#    la $s4,seg0_end
4001##...lui $s4,16
4005##...addiu $s4,$s4,4892
    
    # return
4008#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4012:divide:
    # get parameters; abort if divisor zero
4012#    lw $t0,($sp)
4016#    lw $t1,8($sp)
4020#    beq $t0,$zero,divByZeroError
    
    # perform division
4024#    div $t1,$t0
4028#    mflo $t0

    # store result, adjust stack and return
4032#    addu $sp,$sp,8 # adjust stack
4036#    sw $t0,($sp) # store result
4040#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4044:remainder:
    # get parameters; abort if divisor zero
4044#    lw $t0,($sp)
4048#    lw $t1,8($sp)
4052#    beq $t0,$zero,divByZeroError
    
    # perform division
4056#    div $t1,$t0
4060#    mfhi $t0

    # store result, adjust stack and return
4064#    addu $sp,$sp,8 # adjust stack
4068#    sw $t0,($sp) # store result
4072#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
4076:checkCast:
    # get object, allow immediately if null
4076#    lw $t2,($sp)
4080#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
4084#    lw $t2,-12($t2) # vtable address
4088#    bge $t2,$t1,castException
4089##...slt $at,$t2,$t1
4093##...beq $at,$zero,4264
4096#    blt $t2,$t0,castException
4097##...slt $at,$t2,$t0
4101##...bne $at,$zero,4264
    
    # return, leaving object unchanged on stack
4104:  checkCastReturn:    
4104#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
4108:instanceOf:
    # get object, go return false if null
4108#    lw $t2,($sp)
4112#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
4116#    lw $t2,-12($t2) # vtable address
4120#    sge $t0,$t2,$t0 # are we >= the lower limit?
4121##...slt $t0,$t2,$t0
4125##...xori $t0,$t0,0x1
4128#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
4132#    and $t2,$t0,$t1
4136#    sw $t2,($sp)
4140:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
4140#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

4144:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
4144#    li $v0,4 # syscall-code for print-string
4148#    syscall
4152:exit:
    # print termination message
4152#    li $v0,4 # syscall-code for print-string
4156#    la $a0,exitString
4160#    syscall

    # print number of garbage collections
4164#    li $v0,4 # syscall-code for print-string
4168#    la $a0,gcCountMsg
4172#    syscall # print "Number of ..."
4176#    lw $a0,gcCount # number of GC's
4180#    li $v0,1 # code for print-int
4184#    syscall
4188#    li $v0,4 # syscall-code for print-string
4192#    la $a0,newlineString
4196#    syscall # print newline

    # terminate execution
4200#    li $v0,10 #syscall-code for "exit"
4204#    syscall

4208:outOfHeapMemory:
4208#    la $a0,heapMemoryMsg
4212#    j exitError
4216:divByZeroError:
4216#    la $a0,divByZeroMsg
4220#    j exitError
4224:strIndexOutOfBounds:
4224#    la $a0,strIndexOutOfBoundsMsg
4228#    j exitError
4232:arrayIndexOutOfBounds:
4232#    la $a0,arrayIndexOutOfBoundsMsg
4236#    j exitError
4240:arraySizeOutOfBounds:
4240#    la $a0,arraySizeOutOfBoundsMsg
4244#    j exitError
4248:nullPtrException:
4248#    la $a0,nullPtrExceptionMsg
4252#    j exitError
4256:badIntegerFormat:
4256#    la $a0,badIntegerFormatMsg
4260#    j exitError
4264:castException:
4264#    la $a0,castExceptionMsg
4268#    j exitError
############## data section ################
    .data
4520:hexChars:
    .ascii "0123456789abcdef"
    .align 2
4536:cur_seg:
    .word 0

4540:lastCharRead:
    .word -2 # -2 => no buffered character
4544:prevHashConstant:
    .word 0x2785173c
4548:gcCount:
    .word 0

4552:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
4579:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
4602:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
4637:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
4671:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
4704:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
4735:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
4783:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
4804:gcMsg: 
      .asciiz "\nGC!\n"
4810:gcCountMsg: 
      .asciiz "Number of garbage collections: "

4842:nullStr:
    .asciiz "null"
4847:trueString:
    .asciiz "true"
4852:falseString:
    .asciiz "false"
4858:exitString:
    .ascii "Program execution completed."
    #### "falls through" here
4886:newlineString:
    .asciiz "\n"
    
    .align 2
4888:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

4892:seg0_start:
    .space 0x100000
1053468:seg0_end:
1053468:seg1_start:
    .space 0x100000
2102044:seg1_end:
