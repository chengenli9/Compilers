2900#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
2904#    subu $t0,$v0,9
2908#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
2912#    subu $t0,$v0,13
2916#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
2920#    subu $t0,$v0,12
