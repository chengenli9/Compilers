##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
2124:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
2124#    lw $t0,-8($s2) # get word with hash bits from this
2128#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
2132#    addu $t0,$t1

2136#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
2140:mth_equals_Object:
2140#    move $t0,$s2 # first pointer (this)
2144#    lw $t1,($sp) # second pointer
2148#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
2149##...subu $at,$t0,$t1
2153##...sltiu $t0,$at,1

2156#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
2160:mth_hashCode_String:
2160#    move $t0,$s2 # put this pointer in t0

2164#    li $t2,0 # current hash value
2168#    lw $t1,-4($t0) # negative of number of characters in string
2172#    beq $t1,$zero,done_hashCode_String # if zero length => done
2176#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
2180#    and $t0,0xfffffffc # adjust for padding
2181##...lui $at,65535
2185##...ori $at,$at,0xfffc
2189##...and $t0,$t0,$at
2192#    subu $t1,$t0,$t1 # address at end of string +12
2196:loop_hashCode_String:    
2196#    sll $t4,$t2,5 # multiply by 32
2200#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
2204#    lbu $t3,-12($t0) # current character
2208#    addu $t2,$t3 # add in current character
2212#    addu $t0,1 # go to next character's address
2216#    bne $t0,$t1,loop_hashCode_String # loop back if more
2220:done_hashCode_String:    

    # push int on stack
2220#    move $t0, $t2 # put $t2 in return slot
2224#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
2228:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
2228#    subu $sp,4
2232#    sw $ra,($sp)
    
    # get hash value
2236#    lw $t2,-12($s2) # vtable address
2240#    lw $t0,($t2) # method address
2244#    jalr $t0
2248#    subu $sp,8 # push result (int in $t0) on stack
2252#    sw $s5,4($sp)
2256#    sw $t0,($sp)

    # compute print-size of hash value
2260#    li $t0, 1
2264#    lw $t1, ($sp)
2268#    srl $t1,$t1,4
2272#    beq $t1,$zero,toString_skip_loop
2276:toString_loop_top:
2276#    addu $t0,1
2280#    srl $t1,$t1,4
2284#    bne $t1,$zero,toString_loop_top
2288:toString_skip_loop:
2288#    subu $sp,8
2292#    sw $s5,4($sp)
2296#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
2300#    lw $t2,-12($s2) # vtable address
2304#    move $t0,$t2
2308:toString_checkTagBit:
2308#    subu $t0,1
2312#    lb $t1,($t0)
2316#    and $t1,0x80
2317##...lui $at,0
2321##...ori $at,$at,0x80
2325##...and $t1,$t1,$at
2328#    beq $t1,$zero,toString_checkTagBit
2332#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
2336#    subu $sp,8
2340#    sw $t1,($sp)
2344#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
2348#    move $s7,$zero # -4 offset header word
2352#    lw $t4,8($sp) # bytes for hash value
2356#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
2360#    addu $t4,8
2364#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
2368#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

2372#    li $t0,CLASS_String # store string vtable address into ...
2376#    sw $t0,-12($s7) # ... -12 offset in object header
2380#    lw $t2,-12($s2) # our object's vtable address
2384#    lw $t5,4($sp) # number characters in prefix
2388#    lw $t1,12($sp) # number of characters in hashcode
2392#    addu $t3,$t1,$t5 # number of characters in string ...
2396#    addu $t3,1 # ... including the '@' character
2400#    subu $t0,$zero,$t3 # store negated length into ...
2404#    sw $t0,-4($s7) # ... -4 offset header word
2408#    lw $t0,-8($s7) # get -8 offset header-word
2412#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
2413##...slt $at,$t0,$zero
2417##...beq $at,$zero,2436
2420#    and $t0,0xff # mask off object's hash value ...
2421##...lui $at,0
2425##...ori $at,$at,0xff
2429##...and $t0,$t0,$at
2432#    sw $t0,-8($s7) # ... and store back into -8 header-word
2436:skipMask_toString:
2436#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
2440#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
2444#    subu $t4,$t2,$t5
2448:toString_copyLoop:    
2448#    lb $t3,($t4)
2452#    and $t3,0x7f # mask off sign bit (in case first word)
2453##...lui $at,0
2457##...ori $at,$at,0x7f
2461##...and $t3,$t3,$at
2464#    sb $t3,-8($t0)
2468#    addu $t4,1
2472#    addu $t0,1
2476#    blt $t4,$t2,toString_copyLoop
2477##...slt $at,$t4,$t2
2481##...bne $at,$zero,2448

    # copy the '@' sign
2484#    li $t3,'@'
2488#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
2492#    addu $t2,$t0,$t1 # address of last byte in string to store +8
2496#    lw $t3,20($sp) # hash code to print
2500:toString_hashCopyLoop:
2500#    and $t4,$t3,0xf
2504#    srl $t3,4
2508#    lb $t4,hexChars($t4)
2512#    sb $t4,-8($t2)
2516#    subu $t2,$t2,1
2520#    bgt $t2,$t0,toString_hashCopyLoop
2521##...slt $at,$t0,$t2
2525##...bne $at,$zero,2500

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
2528#    addu $sp,28
2532#    lw $ra,($sp)
2536#    addu $sp,4
2540#    move $t0, $s7 # return string we created
2544#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
2548:mth_equals_String:
    
    # quick test for obvious false
2548#    lw $t0,($sp) # second parameter
2552#    beq $t0,$zero,goEsFalse # go return false if null
2556#    lw $t1,-12($t0) # vtable pointer
2560#    la $t2,CLASS_String # string vtable pointer
2564#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
2568#    subu $sp,12
2572#    sw $ra,8($sp)
2576#    sw $s2,4($sp)
2580#    sw $t0,($sp)
2584#    jal mth_compareTo_String
2588#    lw $s2, 4($sp) #restore this pointer and pop parameters
2592#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
2596#    seq $t0,$t0,$zero
2597##...subu $at,$t0,$zero
