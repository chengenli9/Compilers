###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1308:mth_hashCode_String:
1308#    move $t0,$s2 # put this pointer in t0

1312#    li $t2,0 # current hash value
1316#    lw $t1,-4($t0) # negative of number of characters in string
1320#    beq $t1,$zero,done_hashCode_String # if zero length => done
1324#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
1328#    and $t0,0xfffffffc # adjust for padding
1329##...lui $at,65535
1333##...ori $at,$at,0xfffc
1337##...and $t0,$t0,$at
1340#    subu $t1,$t0,$t1 # address at end of string +12
1344:loop_hashCode_String:    
1344#    sll $t4,$t2,5 # multiply by 32
1348#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
1352#    lbu $t3,-12($t0) # current character
1356#    addu $t2,$t3 # add in current character
1360#    addu $t0,1 # go to next character's address
1364#    bne $t0,$t1,loop_hashCode_String # loop back if more
1368:done_hashCode_String:    

    # push int on stack
1368#    move $t0, $t2 # put $t2 in return slot
1372#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
1376:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
1376#    subu $sp,4
1380#    sw $ra,($sp)
    
    # get hash value
1384#    lw $t2,-12($s2) # vtable address
1388#    lw $t0,($t2) # method address
1392#    jalr $t0
1396#    subu $sp,8 # push result (int in $t0) on stack
1400#    sw $s5,4($sp)
1404#    sw $t0,($sp)

    # compute print-size of hash value
1408#    li $t0, 1
1412#    lw $t1, ($sp)
1416#    srl $t1,$t1,4
1420#    beq $t1,$zero,toString_skip_loop
1424:toString_loop_top:
1424#    addu $t0,1
1428#    srl $t1,$t1,4
1432#    bne $t1,$zero,toString_loop_top
1436:toString_skip_loop:
1436#    subu $sp,8
1440#    sw $s5,4($sp)
1444#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
1448#    lw $t2,-12($s2) # vtable address
1452#    move $t0,$t2
1456:toString_checkTagBit:
1456#    subu $t0,1
1460#    lb $t1,($t0)
1464#    and $t1,0x80
1465##...lui $at,0
1469##...ori $at,$at,0x80
1473##...and $t1,$t1,$at
1476#    beq $t1,$zero,toString_checkTagBit
1480#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
1484#    subu $sp,8
1488#    sw $t1,($sp)
1492#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
1496#    move $s7,$zero # -4 offset header word
1500#    lw $t4,8($sp) # bytes for hash value
1504#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
1508#    addu $t4,8
1512#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
1516#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

1520#    li $t0,CLASS_String # store string vtable address into ...
1524#    sw $t0,-12($s7) # ... -12 offset in object header
1528#    lw $t2,-12($s2) # our object's vtable address
1532#    lw $t5,4($sp) # number characters in prefix
1536#    lw $t1,12($sp) # number of characters in hashcode
1540#    addu $t3,$t1,$t5 # number of characters in string ...
1544#    addu $t3,1 # ... including the '@' character
1548#    subu $t0,$zero,$t3 # store negated length into ...
1552#    sw $t0,-4($s7) # ... -4 offset header word
1556#    lw $t0,-8($s7) # get -8 offset header-word
1560#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
1561##...slt $at,$t0,$zero
1565##...beq $at,$zero,1584
1568#    and $t0,0xff # mask off object's hash value ...
1569##...lui $at,0
1573##...ori $at,$at,0xff
1577##...and $t0,$t0,$at
1580#    sw $t0,-8($s7) # ... and store back into -8 header-word
1584:skipMask_toString:
1584#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
1588#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
1592#    subu $t4,$t2,$t5
1596:toString_copyLoop:    
1596#    lb $t3,($t4)
1600#    and $t3,0x7f # mask off sign bit (in case first word)
1601##...lui $at,0
1605##...ori $at,$at,0x7f
1609##...and $t3,$t3,$at
1612#    sb $t3,-8($t0)
1616#    addu $t4,1
1620#    addu $t0,1
1624#    blt $t4,$t2,toString_copyLoop
1625##...slt $at,$t4,$t2
1629##...bne $at,$zero,1596

    # copy the '@' sign
1632#    li $t3,'@'
1636#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
1640#    addu $t2,$t0,$t1 # address of last byte in string to store +8
1644#    lw $t3,20($sp) # hash code to print
1648:toString_hashCopyLoop:
1648#    and $t4,$t3,0xf
1652#    srl $t3,4
1656#    lb $t4,hexChars($t4)
1660#    sb $t4,-8($t2)
1664#    subu $t2,$t2,1
1668#    bgt $t2,$t0,toString_hashCopyLoop
1669##...slt $at,$t0,$t2
1673##...bne $at,$zero,1648

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
1676#    addu $sp,28
1680#    lw $ra,($sp)
1684#    addu $sp,4
1688#    move $t0, $s7 # return string we created
1692#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
1696:mth_equals_String:
    
    # quick test for obvious false
1696#    lw $t0,($sp) # second parameter
1700#    beq $t0,$zero,goEsFalse # go return false if null
1704#    lw $t1,-12($t0) # vtable pointer
1708#    la $t2,CLASS_String # string vtable pointer
1712#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
1716#    subu $sp,12
1720#    sw $ra,8($sp)
1724#    sw $s2,4($sp)
1728#    sw $t0,($sp)
1732#    jal mth_compareTo_String
1736#    lw $s2, 4($sp) #restore this pointer and pop parameters
1740#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
1744#    seq $t0,$t0,$zero
1745##...subu $at,$t0,$zero
1749##...sltiu $t0,$at,1

    # pop return address and return $t0
1752#    lw $ra,($sp)
1756#    addu $sp,4

1760#    jr $ra # return
    
1764:goEsFalse:
    # put 0 in $t0 and return
1764#    li $t0, 0
1768#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
1772:mth_toString_String:
    #we are a string, so return this.
1772#    move $t0, $s2
1776#    jr $ra
