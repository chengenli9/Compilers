2341##...slt $at,$zero,$t0
2345##...bne $at,$zero,2388
2348#    beq $t0,$zero,riSkipWhiteLoop # start over if space
2352#    subu $t0,$v0,10
2356#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
2360#    subu $t0,$v0,9
2364#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
2368#    subu $t0,$v0,13
2372#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
2376#    subu $t0,$v0,12
2380#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
2384#    j badIntegerFormat # illegal integer char: abort program

2388:  nonWhite:
