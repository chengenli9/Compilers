# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1360:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
1360#    lw $t0,-8($s2) # get word with hash bits from this
1364#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
1368#    addu $t0,$t1

1372#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1376:mth_equals_Object:
1376#    move $t0,$s2 # first pointer (this)
1380#    lw $t1,($sp) # second pointer
1384#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
1385##...subu $at,$t0,$t1
1389##...sltiu $t0,$at,1

1392#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1396:mth_hashCode_String:
1396#    move $t0,$s2 # put this pointer in t0

1400#    li $t2,0 # current hash value
1404#    lw $t1,-4($t0) # negative of number of characters in string
1408#    beq $t1,$zero,done_hashCode_String # if zero length => done
1412#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
1416#    and $t0,0xfffffffc # adjust for padding
1417##...lui $at,65535
1421##...ori $at,$at,0xfffc
1425##...and $t0,$t0,$at
1428#    subu $t1,$t0,$t1 # address at end of string +12
1432:loop_hashCode_String:    
1432#    sll $t4,$t2,5 # multiply by 32
1436#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
1440#    lbu $t3,-12($t0) # current character
1444#    addu $t2,$t3 # add in current character
1448#    addu $t0,1 # go to next character's address
1452#    bne $t0,$t1,loop_hashCode_String # loop back if more
1456:done_hashCode_String:    

    # push int on stack
1456#    move $t0, $t2 # put $t2 in return slot
1460#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
1464:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
1464#    subu $sp,4
1468#    sw $ra,($sp)
    
    # get hash value
1472#    lw $t2,-12($s2) # vtable address
1476#    lw $t0,($t2) # method address
1480#    jalr $t0
1484#    subu $sp,8 # push result (int in $t0) on stack
1488#    sw $s5,4($sp)
1492#    sw $t0,($sp)

    # compute print-size of hash value
1496#    li $t0, 1
1500#    lw $t1, ($sp)
1504#    srl $t1,$t1,4
1508#    beq $t1,$zero,toString_skip_loop
1512:toString_loop_top:
1512#    addu $t0,1
1516#    srl $t1,$t1,4
1520#    bne $t1,$zero,toString_loop_top
1524:toString_skip_loop:
1524#    subu $sp,8
1528#    sw $s5,4($sp)
1532#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
1536#    lw $t2,-12($s2) # vtable address
1540#    move $t0,$t2
1544:toString_checkTagBit:
1544#    subu $t0,1
1548#    lb $t1,($t0)
1552#    and $t1,0x80
1553##...lui $at,0
1557##...ori $at,$at,0x80
1561##...and $t1,$t1,$at
1564#    beq $t1,$zero,toString_checkTagBit
1568#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
1572#    subu $sp,8
1576#    sw $t1,($sp)
1580#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
1584#    move $s7,$zero # -4 offset header word
1588#    lw $t4,8($sp) # bytes for hash value
1592#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
1596#    addu $t4,8
1600#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
1604#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

1608#    li $t0,CLASS_String # store string vtable address into ...
1612#    sw $t0,-12($s7) # ... -12 offset in object header
1616#    lw $t2,-12($s2) # our object's vtable address
1620#    lw $t5,4($sp) # number characters in prefix
1624#    lw $t1,12($sp) # number of characters in hashcode
1628#    addu $t3,$t1,$t5 # number of characters in string ...
1632#    addu $t3,1 # ... including the '@' character
1636#    subu $t0,$zero,$t3 # store negated length into ...
1640#    sw $t0,-4($s7) # ... -4 offset header word
1644#    lw $t0,-8($s7) # get -8 offset header-word
1648#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
1649##...slt $at,$t0,$zero
1653##...beq $at,$zero,1672
1656#    and $t0,0xff # mask off object's hash value ...
1657##...lui $at,0
1661##...ori $at,$at,0xff
1665##...and $t0,$t0,$at
1668#    sw $t0,-8($s7) # ... and store back into -8 header-word
1672:skipMask_toString:
1672#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
1676#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
1680#    subu $t4,$t2,$t5
1684:toString_copyLoop:    
1684#    lb $t3,($t4)
1688#    and $t3,0x7f # mask off sign bit (in case first word)
1689##...lui $at,0
1693##...ori $at,$at,0x7f
1697##...and $t3,$t3,$at
1700#    sb $t3,-8($t0)
1704#    addu $t4,1
1708#    addu $t0,1
1712#    blt $t4,$t2,toString_copyLoop
1713##...slt $at,$t4,$t2
1717##...bne $at,$zero,1684

    # copy the '@' sign
1720#    li $t3,'@'
1724#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
1728#    addu $t2,$t0,$t1 # address of last byte in string to store +8
1732#    lw $t3,20($sp) # hash code to print
1736:toString_hashCopyLoop:
1736#    and $t4,$t3,0xf
1740#    srl $t3,4
1744#    lb $t4,hexChars($t4)
1748#    sb $t4,-8($t2)
1752#    subu $t2,$t2,1
1756#    bgt $t2,$t0,toString_hashCopyLoop
1757##...slt $at,$t0,$t2
1761##...bne $at,$zero,1736

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
1764#    addu $sp,28
1768#    lw $ra,($sp)
1772#    addu $sp,4
1776#    move $t0, $s7 # return string we created
1780#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
1784:mth_equals_String:
    
    # quick test for obvious false
1784#    lw $t0,($sp) # second parameter
1788#    beq $t0,$zero,goEsFalse # go return false if null
1792#    lw $t1,-12($t0) # vtable pointer
1796#    la $t2,CLASS_String # string vtable pointer
1800#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
1804#    subu $sp,12
1808#    sw $ra,8($sp)
1812#    sw $s2,4($sp)
1816#    sw $t0,($sp)
1820#    jal mth_compareTo_String
1824#    lw $s2, 4($sp) #restore this pointer and pop parameters
1828#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
1832#    seq $t0,$t0,$zero
1833##...subu $at,$t0,$zero
1837##...sltiu $t0,$at,1

    # pop return address and return $t0
1840#    lw $ra,($sp)
1844#    addu $sp,4

1848#    jr $ra # return
    
1852:goEsFalse:
    # put 0 in $t0 and return
1852#    li $t0, 0
1856#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
1860:mth_toString_String:
    #we are a string, so return this.
1860#    move $t0, $s2
1864#    jr $ra

###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
1868:mth_readLine_Lib:
    
1868#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
1872#    sw $ra, 4($sp) # save $ra
1876#    move $t1,$sp # save "original" sp

1880:  doRead:

    # read the character
1880#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
1884#    subu $t2,$v0,13
1888#    bne $t2,$zero,notReturnRL
1892#    jal readLogicalChar
1896#    subu $t2,$v0,10 # check for newline
1900#    beq $t2,$zero,foundNewLine
1904#    sw $v0,lastCharRead # push back character into queue
1908#    j foundNewLine # go process the line

1912:  notReturnRL:

    # at this point, $v0 has our character

1912#    subu $t0,$v0,10
1916#    beq $t0,$zero,foundNewLine
1920#    blt $v0,$zero,foundEof
1921##...slt $at,$v0,$zero
1925##...bne $at,$zero,1940

    # we have a character, so push it onto stack
1928#    subu $sp,$sp,4
1932#    sw $v0,($sp)

    # loop back up to get next character
1936#    j doRead

1940:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
1940#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
1944#    li $s7, 0 # return-value: null
1948#    j rlReturn # return

1952:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
1952#    subu $t0,$t1,$sp # number of chars we read (times 4)
1956#    srl $s6,$t0,2 # number of words on stack with chars
1960#    subu $sp,$sp,4 # push char-count ...
1964#    sw $s6,($sp) # ... onto stack
1968#    addu $t2,$t0,5 # GC tag, incl. for count-word
1972#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
1976#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
1980#    srl $s6,$s6,2  # data words in object
1984#    move $s7,$zero # object words in object
1988#    jal newObject  # allocate space
    
    # store header words
1992#    la $t0,CLASS_String
1996#    sw $t0,-12($s7)# store class tag (String) into object
2000#    lw $t2,4($sp) # char-count
2004#    sll $t1,$t2,2 # 4 times number of chars
2008#    subu $t2,$zero,$t2 # negative of char-count
2012#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
2016#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
2020#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
2021##...slt $at,$t0,$zero
2025##...beq $at,$zero,2044
2028#    and $t0,0xff # mask off object's hash value ...
2029##...lui $at,0
2033##...ori $at,$at,0xff
2037##...and $t0,$t0,$at
2040#    sw $t0,-8($s7) # ... and store back into -8 header-word
2044:  skipMask_readLine:

2044#    sll $t0,$t0,2 # data bytes in object
2048#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
2052#    subu $t0,$t0,$t2 # place to store last character (plus 9)
2056#    addu $sp,$sp,8 # pop redundant object-pointer and count
2060#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

2064#    beq $sp,$t1,rlReturn
2068:  charCopyLoop:
2068#    lw $t2,($sp)
2072#    sb $t2,-9($t0)
2076#    addu $sp,$sp,4
2080#    subu $t0,$t0,1
2084#    bne $sp,$t1,charCopyLoop
2088:  rlReturn:

2088#    lw $ra, 4($sp)
2092#    addu $sp, 8   # pop $ra and pointless word off stack
2096#    move $t0, $s7 # return string we allocated in $s7
2100#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
2104:mth_readInt_Lib:

    # save $ra by pushing onto stack
2104#    subu $sp,$sp,4
2108#    sw $ra,($sp)

2112:  riSkipWhiteLoop:
    # read a character
2112#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
2116#    subu $t0,$v0,32
2120#    bgt $t0,$zero,nonWhite
2121##...slt $at,$zero,$t0
2125##...bne $at,$zero,2168
2128#    beq $t0,$zero,riSkipWhiteLoop # start over if space
2132#    subu $t0,$v0,10
2136#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
2140#    subu $t0,$v0,9
2144#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
2148#    subu $t0,$v0,13
2152#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
2156#    subu $t0,$v0,12
2160#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
2164#    j badIntegerFormat # illegal integer char: abort program

2168:  nonWhite:
2168#    subu $t0,$v0,'-'
2172#    li $t4,1 # final multiplier
2176#    bne $t0,$zero,helpReadInt # go read
2180#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
2184#    jal readLogicalChar

2188:  helpReadInt:
2188#    li $t2,10
2192#    subu $t1,$v0,'0' # convert digit to 0-9 value
2196#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
2197##...sltu $at,$t1,$t2
2201##...beq $at,$zero,4484
2204#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

2208:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

