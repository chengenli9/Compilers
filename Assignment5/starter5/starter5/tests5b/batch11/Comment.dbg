5749##...slt $t0,$t2,$t0
5753##...xori $t0,$t0,0x1
5756#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
5760#    and $t2,$t0,$t1
5764#    sw $t2,($sp)
5768:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
5768#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

5772:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
5772#    li $v0,4 # syscall-code for print-string
5776#    syscall
5780:exit:
    # print termination message
5780#    li $v0,4 # syscall-code for print-string
5784#    la $a0,exitString
5788#    syscall

    # terminate execution
5792#    li $v0,10 #syscall-code for "exit"
5796#    syscall

5800:outOfHeapMemory:
5800#    la $a0,heapMemoryMsg
5804#    j exitError
5808:divByZeroError:
5808#    la $a0,divByZeroMsg
5812#    j exitError
5816:strIndexOutOfBounds:
5816#    la $a0,strIndexOutOfBoundsMsg
5820#    j exitError
5824:arrayIndexOutOfBounds:
5824#    la $a0,arrayIndexOutOfBoundsMsg
5828#    j exitError
5832:arraySizeOutOfBounds:
5832#    la $a0,arraySizeOutOfBoundsMsg
5836#    j exitError
5840:nullPtrException:
5840#    la $a0,nullPtrExceptionMsg
5844#    j exitError
5848:badIntegerFormat:
5848#    la $a0,badIntegerFormatMsg
5852#    j exitError
5856:castException:
5856#    la $a0,castExceptionMsg
5860#    j exitError
############## data section ################
    .data
6460:hexChars:
    .ascii "0123456789abcdef"
    .align 2
6476:cur_seg:
    .word 0

6480:lastCharRead:
    .word -2 # -2 => no buffered character
6484:prevHashConstant:
    .word 0x2785173c
6488:gcCount:
    .word 0

6492:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
6519:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
6542:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
6577:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
6611:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
6644:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
6675:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
6723:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
6744:gcMsg: 
      .asciiz "\nGC!\n"
6750:gcCountMsg: 
      .asciiz "Number of garbage collections: "

6782:nullStr:
    .asciiz "null"
6787:trueString:
    .asciiz "true"
6792:falseString:
    .asciiz "false"
6798:exitString:
    .ascii "Program terminated."
    #### "falls through" here
6817:newlineString:
    .asciiz "\n"
    
    .align 2
6820:stack_bottom:
    .word 0

