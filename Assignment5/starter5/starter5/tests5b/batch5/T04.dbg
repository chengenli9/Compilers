##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
2756:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
2756#    lw $t0,-8($s2) # get word with hash bits from this
2760#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
2764#    addu $t0,$t1

2768#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
2772:mth_equals_Object:
2772#    move $t0,$s2 # first pointer (this)
2776#    lw $t1,($sp) # second pointer
2780#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
2781##...subu $at,$t0,$t1
2785##...sltiu $t0,$at,1

2788#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
2792:mth_hashCode_String:
2792#    move $t0,$s2 # put this pointer in t0

2796#    li $t2,0 # current hash value
2800#    lw $t1,-4($t0) # negative of number of characters in string
2804#    beq $t1,$zero,done_hashCode_String # if zero length => done
2808#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
2812#    and $t0,0xfffffffc # adjust for padding
2813##...lui $at,65535
2817##...ori $at,$at,0xfffc
2821##...and $t0,$t0,$at
2824#    subu $t1,$t0,$t1 # address at end of string +12
2828:loop_hashCode_String:    
2828#    sll $t4,$t2,5 # multiply by 32
2832#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
2836#    lbu $t3,-12($t0) # current character
2840#    addu $t2,$t3 # add in current character
2844#    addu $t0,1 # go to next character's address
2848#    bne $t0,$t1,loop_hashCode_String # loop back if more
2852:done_hashCode_String:    

    # push int on stack
2852#    move $t0, $t2 # put $t2 in return slot
2856#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
2860:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
2860#    subu $sp,4
2864#    sw $ra,($sp)
    
    # get hash value
2868#    lw $t2,-12($s2) # vtable address
2872#    lw $t0,($t2) # method address
2876#    jalr $t0
2880#    subu $sp,8 # push result (int in $t0) on stack
2884#    sw $s5,4($sp)
2888#    sw $t0,($sp)

    # compute print-size of hash value
2892#    li $t0, 1
2896#    lw $t1, ($sp)
2900#    srl $t1,$t1,4
2904#    beq $t1,$zero,toString_skip_loop
2908:toString_loop_top:
2908#    addu $t0,1
2912#    srl $t1,$t1,4
2916#    bne $t1,$zero,toString_loop_top
2920:toString_skip_loop:
2920#    subu $sp,8
2924#    sw $s5,4($sp)
2928#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
2932#    lw $t2,-12($s2) # vtable address
2936#    move $t0,$t2
2940:toString_checkTagBit:
2940#    subu $t0,1
2944#    lb $t1,($t0)
2948#    and $t1,0x80
2949##...lui $at,0
2953##...ori $at,$at,0x80
2957##...and $t1,$t1,$at
2960#    beq $t1,$zero,toString_checkTagBit
2964#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
2968#    subu $sp,8
2972#    sw $t1,($sp)
2976#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
2980#    move $s7,$zero # -4 offset header word
2984#    lw $t4,8($sp) # bytes for hash value
2988#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
2992#    addu $t4,8
2996#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
3000#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

3004#    li $t0,CLASS_String # store string vtable address into ...
3008#    sw $t0,-12($s7) # ... -12 offset in object header
3012#    lw $t2,-12($s2) # our object's vtable address
3016#    lw $t5,4($sp) # number characters in prefix
3020#    lw $t1,12($sp) # number of characters in hashcode
3024#    addu $t3,$t1,$t5 # number of characters in string ...
3028#    addu $t3,1 # ... including the '@' character
3032#    subu $t0,$zero,$t3 # store negated length into ...
3036#    sw $t0,-4($s7) # ... -4 offset header word
3040#    lw $t0,-8($s7) # get -8 offset header-word
3044#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
3045##...slt $at,$t0,$zero
3049##...beq $at,$zero,3068
3052#    and $t0,0xff # mask off object's hash value ...
3053##...lui $at,0
3057##...ori $at,$at,0xff
3061##...and $t0,$t0,$at
3064#    sw $t0,-8($s7) # ... and store back into -8 header-word
3068:skipMask_toString:
3068#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
3072#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
3076#    subu $t4,$t2,$t5
3080:toString_copyLoop:    
3080#    lb $t3,($t4)
3084#    and $t3,0x7f # mask off sign bit (in case first word)
3085##...lui $at,0
3089##...ori $at,$at,0x7f
3093##...and $t3,$t3,$at
3096#    sb $t3,-8($t0)
3100#    addu $t4,1
3104#    addu $t0,1
3108#    blt $t4,$t2,toString_copyLoop
3109##...slt $at,$t4,$t2
3113##...bne $at,$zero,3080

    # copy the '@' sign
3116#    li $t3,'@'
3120#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
3124#    addu $t2,$t0,$t1 # address of last byte in string to store +8
3128#    lw $t3,20($sp) # hash code to print
3132:toString_hashCopyLoop:
3132#    and $t4,$t3,0xf
3136#    srl $t3,4
3140#    lb $t4,hexChars($t4)
3144#    sb $t4,-8($t2)
3148#    subu $t2,$t2,1
3152#    bgt $t2,$t0,toString_hashCopyLoop
3153##...slt $at,$t0,$t2
3157##...bne $at,$zero,3132

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
3160#    addu $sp,28
3164#    lw $ra,($sp)
3168#    addu $sp,4
3172#    move $t0, $s7 # return string we created
3176#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
3180:mth_equals_String:
    
    # quick test for obvious false
3180#    lw $t0,($sp) # second parameter
3184#    beq $t0,$zero,goEsFalse # go return false if null
3188#    lw $t1,-12($t0) # vtable pointer
3192#    la $t2,CLASS_String # string vtable pointer
3196#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
3200#    subu $sp,12
3204#    sw $ra,8($sp)
3208#    sw $s2,4($sp)
3212#    sw $t0,($sp)
3216#    jal mth_compareTo_String
3220#    lw $s2, 4($sp) #restore this pointer and pop parameters
3224#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
3228#    seq $t0,$t0,$zero
3229##...subu $at,$t0,$zero
3233##...sltiu $t0,$at,1

    # pop return address and return $t0
3236#    lw $ra,($sp)
3240#    addu $sp,4

3244#    jr $ra # return
    
3248:goEsFalse:
    # put 0 in $t0 and return
3248#    li $t0, 0
3252#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
3256:mth_toString_String:
    #we are a string, so return this.
3256#    move $t0, $s2
3260#    jr $ra

###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
3264:mth_readLine_Lib:
    
3264#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
3268#    sw $ra, 4($sp) # save $ra
3272#    move $t1,$sp # save "original" sp

3276:  doRead:

    # read the character
3276#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
3280#    subu $t2,$v0,13
3284#    bne $t2,$zero,notReturnRL
3288#    jal readLogicalChar
3292#    subu $t2,$v0,10 # check for newline
3296#    beq $t2,$zero,foundNewLine
3300#    sw $v0,lastCharRead # push back character into queue
3304#    j foundNewLine # go process the line

3308:  notReturnRL:

    # at this point, $v0 has our character

3308#    subu $t0,$v0,10
3312#    beq $t0,$zero,foundNewLine
3316#    blt $v0,$zero,foundEof
3317##...slt $at,$v0,$zero
3321##...bne $at,$zero,3336

    # we have a character, so push it onto stack
3324#    subu $sp,$sp,4
3328#    sw $v0,($sp)

    # loop back up to get next character
3332#    j doRead

3336:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
3336#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
3340#    li $s7, 0 # return-value: null
3344#    j rlReturn # return

3348:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
3348#    subu $t0,$t1,$sp # number of chars we read (times 4)
3352#    srl $s6,$t0,2 # number of words on stack with chars
3356#    subu $sp,$sp,4 # push char-count ...
3360#    sw $s6,($sp) # ... onto stack
3364#    addu $t2,$t0,5 # GC tag, incl. for count-word
3368#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
3372#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
3376#    srl $s6,$s6,2  # data words in object
3380#    move $s7,$zero # object words in object
3384#    jal newObject  # allocate space
    
    # store header words
3388#    la $t0,CLASS_String
3392#    sw $t0,-12($s7)# store class tag (String) into object
3396#    lw $t2,4($sp) # char-count
3400#    sll $t1,$t2,2 # 4 times number of chars
3404#    subu $t2,$zero,$t2 # negative of char-count
3408#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
3412#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
3416#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
3417##...slt $at,$t0,$zero
3421##...beq $at,$zero,3440
3424#    and $t0,0xff # mask off object's hash value ...
3425##...lui $at,0
3429##...ori $at,$at,0xff
3433##...and $t0,$t0,$at
3436#    sw $t0,-8($s7) # ... and store back into -8 header-word
3440:  skipMask_readLine:

3440#    sll $t0,$t0,2 # data bytes in object
3444#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
3448#    subu $t0,$t0,$t2 # place to store last character (plus 9)
3452#    addu $sp,$sp,8 # pop redundant object-pointer and count
3456#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

3460#    beq $sp,$t1,rlReturn
3464:  charCopyLoop:
3464#    lw $t2,($sp)
3468#    sb $t2,-9($t0)
3472#    addu $sp,$sp,4
3476#    subu $t0,$t0,1
3480#    bne $sp,$t1,charCopyLoop
3484:  rlReturn:

3484#    lw $ra, 4($sp)
3488#    addu $sp, 8   # pop $ra and pointless word off stack
3492#    move $t0, $s7 # return string we allocated in $s7
3496#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
