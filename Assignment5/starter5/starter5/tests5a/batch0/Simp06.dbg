3085##...beq $at,$zero,3256
3088#    blt $t2,$t0,castException
3089##...slt $at,$t2,$t0
3093##...bne $at,$zero,3256
    
    # return, leaving object unchanged on stack
3096:  checkCastReturn:    
3096#    jr $ra    
