##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1540:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
1540#    lw $t0,-8($s2) # get word with hash bits from this
1544#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
1548#    addu $t0,$t1

1552#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1556:mth_equals_Object:
1556#    move $t0,$s2 # first pointer (this)
1560#    lw $t1,($sp) # second pointer
1564#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
1565##...subu $at,$t0,$t1
1569##...sltiu $t0,$at,1

1572#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1576:mth_hashCode_String:
1576#    move $t0,$s2 # put this pointer in t0

1580#    li $t2,0 # current hash value
1584#    lw $t1,-4($t0) # negative of number of characters in string
1588#    beq $t1,$zero,done_hashCode_String # if zero length => done
1592#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
1596#    and $t0,0xfffffffc # adjust for padding
1597##...lui $at,65535
1601##...ori $at,$at,0xfffc
1605##...and $t0,$t0,$at
1608#    subu $t1,$t0,$t1 # address at end of string +12
1612:loop_hashCode_String:    
1612#    sll $t4,$t2,5 # multiply by 32
1616#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
1620#    lbu $t3,-12($t0) # current character
1624#    addu $t2,$t3 # add in current character
1628#    addu $t0,1 # go to next character's address
1632#    bne $t0,$t1,loop_hashCode_String # loop back if more
1636:done_hashCode_String:    

    # push int on stack
1636#    move $t0, $t2 # put $t2 in return slot
1640#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
1644:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
1644#    subu $sp,4
1648#    sw $ra,($sp)
    
    # get hash value
1652#    lw $t2,-12($s2) # vtable address
1656#    lw $t0,($t2) # method address
1660#    jalr $t0
1664#    subu $sp,8 # push result (int in $t0) on stack
1668#    sw $s5,4($sp)
1672#    sw $t0,($sp)

    # compute print-size of hash value
1676#    li $t0, 1
1680#    lw $t1, ($sp)
1684#    srl $t1,$t1,4
1688#    beq $t1,$zero,toString_skip_loop
1692:toString_loop_top:
1692#    addu $t0,1
1696#    srl $t1,$t1,4
1700#    bne $t1,$zero,toString_loop_top
1704:toString_skip_loop:
1704#    subu $sp,8
1708#    sw $s5,4($sp)
1712#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
1716#    lw $t2,-12($s2) # vtable address
1720#    move $t0,$t2
1724:toString_checkTagBit:
1724#    subu $t0,1
1728#    lb $t1,($t0)
1732#    and $t1,0x80
1733##...lui $at,0
1737##...ori $at,$at,0x80
1741##...and $t1,$t1,$at
1744#    beq $t1,$zero,toString_checkTagBit
1748#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
1752#    subu $sp,8
1756#    sw $t1,($sp)
1760#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
1764#    move $s7,$zero # -4 offset header word
1768#    lw $t4,8($sp) # bytes for hash value
1772#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
1776#    addu $t4,8
1780#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
1784#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

1788#    li $t0,CLASS_String # store string vtable address into ...
1792#    sw $t0,-12($s7) # ... -12 offset in object header
1796#    lw $t2,-12($s2) # our object's vtable address
1800#    lw $t5,4($sp) # number characters in prefix
1804#    lw $t1,12($sp) # number of characters in hashcode
1808#    addu $t3,$t1,$t5 # number of characters in string ...
1812#    addu $t3,1 # ... including the '@' character
1816#    subu $t0,$zero,$t3 # store negated length into ...
1820#    sw $t0,-4($s7) # ... -4 offset header word
1824#    lw $t0,-8($s7) # get -8 offset header-word
1828#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
1829##...slt $at,$t0,$zero
1833##...beq $at,$zero,1852
1836#    and $t0,0xff # mask off object's hash value ...
1837##...lui $at,0
1841##...ori $at,$at,0xff
1845##...and $t0,$t0,$at
1848#    sw $t0,-8($s7) # ... and store back into -8 header-word
1852:skipMask_toString:
1852#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
1856#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
1860#    subu $t4,$t2,$t5
1864:toString_copyLoop:    
1864#    lb $t3,($t4)
1868#    and $t3,0x7f # mask off sign bit (in case first word)
1869##...lui $at,0
1873##...ori $at,$at,0x7f
1877##...and $t3,$t3,$at
1880#    sb $t3,-8($t0)
1884#    addu $t4,1
1888#    addu $t0,1
1892#    blt $t4,$t2,toString_copyLoop
1893##...slt $at,$t4,$t2
1897##...bne $at,$zero,1864

    # copy the '@' sign
1900#    li $t3,'@'
1904#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
1908#    addu $t2,$t0,$t1 # address of last byte in string to store +8
1912#    lw $t3,20($sp) # hash code to print
1916:toString_hashCopyLoop:
1916#    and $t4,$t3,0xf
1920#    srl $t3,4
1924#    lb $t4,hexChars($t4)
1928#    sb $t4,-8($t2)
1932#    subu $t2,$t2,1
1936#    bgt $t2,$t0,toString_hashCopyLoop
1937##...slt $at,$t0,$t2
1941##...bne $at,$zero,1916

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
1944#    addu $sp,28
1948#    lw $ra,($sp)
1952#    addu $sp,4
1956#    move $t0, $s7 # return string we created
1960#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
1964:mth_equals_String:
    
    # quick test for obvious false
1964#    lw $t0,($sp) # second parameter
1968#    beq $t0,$zero,goEsFalse # go return false if null
1972#    lw $t1,-12($t0) # vtable pointer
1976#    la $t2,CLASS_String # string vtable pointer
1980#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
1984#    subu $sp,12
1988#    sw $ra,8($sp)
1992#    sw $s2,4($sp)
1996#    sw $t0,($sp)
2000#    jal mth_compareTo_String
2004#    lw $s2, 4($sp) #restore this pointer and pop parameters
2008#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
2012#    seq $t0,$t0,$zero
2013##...subu $at,$t0,$zero
2017##...sltiu $t0,$at,1

    # pop return address and return $t0
2020#    lw $ra,($sp)
2024#    addu $sp,4

2028#    jr $ra # return
    
2032:goEsFalse:
    # put 0 in $t0 and return
2032#    li $t0, 0
2036#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
2040:mth_toString_String:
    #we are a string, so return this.
2040#    move $t0, $s2
2044#    jr $ra

###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
2048:mth_readLine_Lib:
    
2048#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
2052#    sw $ra, 4($sp) # save $ra
2056#    move $t1,$sp # save "original" sp

2060:  doRead:

    # read the character
2060#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
2064#    subu $t2,$v0,13
2068#    bne $t2,$zero,notReturnRL
2072#    jal readLogicalChar
2076#    subu $t2,$v0,10 # check for newline
2080#    beq $t2,$zero,foundNewLine
2084#    sw $v0,lastCharRead # push back character into queue
2088#    j foundNewLine # go process the line

2092:  notReturnRL:

    # at this point, $v0 has our character

2092#    subu $t0,$v0,10
2096#    beq $t0,$zero,foundNewLine
2100#    blt $v0,$zero,foundEof
2101##...slt $at,$v0,$zero
2105##...bne $at,$zero,2120

    # we have a character, so push it onto stack
2108#    subu $sp,$sp,4
2112#    sw $v0,($sp)

    # loop back up to get next character
2116#    j doRead

2120:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
2120#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
2124#    li $s7, 0 # return-value: null
2128#    j rlReturn # return

2132:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
2132#    subu $t0,$t1,$sp # number of chars we read (times 4)
2136#    srl $s6,$t0,2 # number of words on stack with chars
2140#    subu $sp,$sp,4 # push char-count ...
2144#    sw $s6,($sp) # ... onto stack
2148#    addu $t2,$t0,5 # GC tag, incl. for count-word
2152#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
2156#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
2160#    srl $s6,$s6,2  # data words in object
2164#    move $s7,$zero # object words in object
2168#    jal newObject  # allocate space
    
    # store header words
2172#    la $t0,CLASS_String
2176#    sw $t0,-12($s7)# store class tag (String) into object
2180#    lw $t2,4($sp) # char-count
2184#    sll $t1,$t2,2 # 4 times number of chars
2188#    subu $t2,$zero,$t2 # negative of char-count
2192#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
2196#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
2200#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
2201##...slt $at,$t0,$zero
2205##...beq $at,$zero,2224
2208#    and $t0,0xff # mask off object's hash value ...
2209##...lui $at,0
2213##...ori $at,$at,0xff
2217##...and $t0,$t0,$at
2220#    sw $t0,-8($s7) # ... and store back into -8 header-word
2224:  skipMask_readLine:

2224#    sll $t0,$t0,2 # data bytes in object
2228#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
2232#    subu $t0,$t0,$t2 # place to store last character (plus 9)
2236#    addu $sp,$sp,8 # pop redundant object-pointer and count
2240#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

2244#    beq $sp,$t1,rlReturn
2248:  charCopyLoop:
2248#    lw $t2,($sp)
2252#    sb $t2,-9($t0)
2256#    addu $sp,$sp,4
2260#    subu $t0,$t0,1
2264#    bne $sp,$t1,charCopyLoop
2268:  rlReturn:

2268#    lw $ra, 4($sp)
2272#    addu $sp, 8   # pop $ra and pointless word off stack
2276#    move $t0, $s7 # return string we allocated in $s7
2280#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
