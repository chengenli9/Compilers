6013##...lui $s4,16
6017##...addiu $s4,$s4,7448
6020#    sw $zero,cur_seg
6024#    bne $t0,$zero,skipGc1
6028#    la $t6,seg0_start
6032#    la $s3,seg1_start
6033##...lui $s3,16
6037##...addiu $s3,$s3,7448
6040#    la $s4,seg1_end
6041##...lui $s4,32
6045##...addiu $s4,$s4,7448
6048#    sw $s5,cur_seg
