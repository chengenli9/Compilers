##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1200:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
1200#    lw $t0,-8($s2) # get word with hash bits from this
1204#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
1208#    addu $t0,$t1

1212#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1216:mth_equals_Object:
1216#    move $t0,$s2 # first pointer (this)
1220#    lw $t1,($sp) # second pointer
1224#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
1225##...subu $at,$t0,$t1
1229##...sltiu $t0,$at,1

1232#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1236:mth_hashCode_String:
1236#    move $t0,$s2 # put this pointer in t0

1240#    li $t2,0 # current hash value
1244#    lw $t1,-4($t0) # negative of number of characters in string
1248#    beq $t1,$zero,done_hashCode_String # if zero length => done
1252#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
1256#    and $t0,0xfffffffc # adjust for padding
1257##...lui $at,65535
1261##...ori $at,$at,0xfffc
1265##...and $t0,$t0,$at
1268#    subu $t1,$t0,$t1 # address at end of string +12
1272:loop_hashCode_String:    
1272#    sll $t4,$t2,5 # multiply by 32
1276#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
1280#    lbu $t3,-12($t0) # current character
1284#    addu $t2,$t3 # add in current character
1288#    addu $t0,1 # go to next character's address
1292#    bne $t0,$t1,loop_hashCode_String # loop back if more
1296:done_hashCode_String:    

    # push int on stack
1296#    move $t0, $t2 # put $t2 in return slot
1300#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
1304:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
1304#    subu $sp,4
1308#    sw $ra,($sp)
    
    # get hash value
1312#    lw $t2,-12($s2) # vtable address
1316#    lw $t0,($t2) # method address
1320#    jalr $t0
1324#    subu $sp,8 # push result (int in $t0) on stack
1328#    sw $s5,4($sp)
1332#    sw $t0,($sp)

    # compute print-size of hash value
1336#    li $t0, 1
1340#    lw $t1, ($sp)
1344#    srl $t1,$t1,4
1348#    beq $t1,$zero,toString_skip_loop
1352:toString_loop_top:
1352#    addu $t0,1
1356#    srl $t1,$t1,4
1360#    bne $t1,$zero,toString_loop_top
1364:toString_skip_loop:
1364#    subu $sp,8
1368#    sw $s5,4($sp)
1372#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
1376#    lw $t2,-12($s2) # vtable address
1380#    move $t0,$t2
1384:toString_checkTagBit:
1384#    subu $t0,1
1388#    lb $t1,($t0)
1392#    and $t1,0x80
1393##...lui $at,0
1397##...ori $at,$at,0x80
1401##...and $t1,$t1,$at
1404#    beq $t1,$zero,toString_checkTagBit
1408#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
1412#    subu $sp,8
1416#    sw $t1,($sp)
1420#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
1424#    move $s7,$zero # -4 offset header word
1428#    lw $t4,8($sp) # bytes for hash value
1432#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
1436#    addu $t4,8
1440#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
1444#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

1448#    li $t0,CLASS_String # store string vtable address into ...
1452#    sw $t0,-12($s7) # ... -12 offset in object header
1456#    lw $t2,-12($s2) # our object's vtable address
1460#    lw $t5,4($sp) # number characters in prefix
1464#    lw $t1,12($sp) # number of characters in hashcode
1468#    addu $t3,$t1,$t5 # number of characters in string ...
1472#    addu $t3,1 # ... including the '@' character
1476#    subu $t0,$zero,$t3 # store negated length into ...
1480#    sw $t0,-4($s7) # ... -4 offset header word
1484#    lw $t0,-8($s7) # get -8 offset header-word
1488#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
1489##...slt $at,$t0,$zero
1493##...beq $at,$zero,1512
1496#    and $t0,0xff # mask off object's hash value ...
1497##...lui $at,0
1501##...ori $at,$at,0xff
1505##...and $t0,$t0,$at
1508#    sw $t0,-8($s7) # ... and store back into -8 header-word
1512:skipMask_toString:
1512#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
1516#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
1520#    subu $t4,$t2,$t5
1524:toString_copyLoop:    
1524#    lb $t3,($t4)
1528#    and $t3,0x7f # mask off sign bit (in case first word)
1529##...lui $at,0
1533##...ori $at,$at,0x7f
1537##...and $t3,$t3,$at
1540#    sb $t3,-8($t0)
1544#    addu $t4,1
1548#    addu $t0,1
1552#    blt $t4,$t2,toString_copyLoop
1553##...slt $at,$t4,$t2
1557##...bne $at,$zero,1524

    # copy the '@' sign
1560#    li $t3,'@'
1564#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
1568#    addu $t2,$t0,$t1 # address of last byte in string to store +8
1572#    lw $t3,20($sp) # hash code to print
1576:toString_hashCopyLoop:
1576#    and $t4,$t3,0xf
1580#    srl $t3,4
1584#    lb $t4,hexChars($t4)
1588#    sb $t4,-8($t2)
1592#    subu $t2,$t2,1
1596#    bgt $t2,$t0,toString_hashCopyLoop
1597##...slt $at,$t0,$t2
1601##...bne $at,$zero,1576

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
1604#    addu $sp,28
1608#    lw $ra,($sp)
1612#    addu $sp,4
1616#    move $t0, $s7 # return string we created
1620#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
1624:mth_equals_String:
    
    # quick test for obvious false
1624#    lw $t0,($sp) # second parameter
1628#    beq $t0,$zero,goEsFalse # go return false if null
1632#    lw $t1,-12($t0) # vtable pointer
1636#    la $t2,CLASS_String # string vtable pointer
1640#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
1644#    subu $sp,12
1648#    sw $ra,8($sp)
1652#    sw $s2,4($sp)
1656#    sw $t0,($sp)
1660#    jal mth_compareTo_String
1664#    lw $s2, 4($sp) #restore this pointer and pop parameters
1668#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
1672#    seq $t0,$t0,$zero
1673##...subu $at,$t0,$zero
1677##...sltiu $t0,$at,1

    # pop return address and return $t0
1680#    lw $ra,($sp)
1684#    addu $sp,4

1688#    jr $ra # return
    
1692:goEsFalse:
    # put 0 in $t0 and return
1692#    li $t0, 0
1696#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
1700:mth_toString_String:
    #we are a string, so return this.
1700#    move $t0, $s2
1704#    jr $ra

###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
1708:mth_readLine_Lib:
    
1708#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
1712#    sw $ra, 4($sp) # save $ra
1716#    move $t1,$sp # save "original" sp

1720:  doRead:

    # read the character
1720#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
1724#    subu $t2,$v0,13
1728#    bne $t2,$zero,notReturnRL
1732#    jal readLogicalChar
1736#    subu $t2,$v0,10 # check for newline
1740#    beq $t2,$zero,foundNewLine
1744#    sw $v0,lastCharRead # push back character into queue
1748#    j foundNewLine # go process the line

1752:  notReturnRL:

    # at this point, $v0 has our character

1752#    subu $t0,$v0,10
1756#    beq $t0,$zero,foundNewLine
1760#    blt $v0,$zero,foundEof
1761##...slt $at,$v0,$zero
1765##...bne $at,$zero,1780

    # we have a character, so push it onto stack
1768#    subu $sp,$sp,4
1772#    sw $v0,($sp)

    # loop back up to get next character
1776#    j doRead

1780:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
1780#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
1784#    li $s7, 0 # return-value: null
1788#    j rlReturn # return

1792:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
1792#    subu $t0,$t1,$sp # number of chars we read (times 4)
1796#    srl $s6,$t0,2 # number of words on stack with chars
1800#    subu $sp,$sp,4 # push char-count ...
1804#    sw $s6,($sp) # ... onto stack
1808#    addu $t2,$t0,5 # GC tag, incl. for count-word
1812#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
1816#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
1820#    srl $s6,$s6,2  # data words in object
1824#    move $s7,$zero # object words in object
1828#    jal newObject  # allocate space
    
    # store header words
1832#    la $t0,CLASS_String
1836#    sw $t0,-12($s7)# store class tag (String) into object
1840#    lw $t2,4($sp) # char-count
1844#    sll $t1,$t2,2 # 4 times number of chars
1848#    subu $t2,$zero,$t2 # negative of char-count
1852#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
1856#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
1860#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
1861##...slt $at,$t0,$zero
1865##...beq $at,$zero,1884
1868#    and $t0,0xff # mask off object's hash value ...
1869##...lui $at,0
1873##...ori $at,$at,0xff
1877##...and $t0,$t0,$at
1880#    sw $t0,-8($s7) # ... and store back into -8 header-word
1884:  skipMask_readLine:

1884#    sll $t0,$t0,2 # data bytes in object
1888#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
1892#    subu $t0,$t0,$t2 # place to store last character (plus 9)
1896#    addu $sp,$sp,8 # pop redundant object-pointer and count
1900#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

1904#    beq $sp,$t1,rlReturn
1908:  charCopyLoop:
1908#    lw $t2,($sp)
1912#    sb $t2,-9($t0)
1916#    addu $sp,$sp,4
1920#    subu $t0,$t0,1
1924#    bne $sp,$t1,charCopyLoop
1928:  rlReturn:

1928#    lw $ra, 4($sp)
1932#    addu $sp, 8   # pop $ra and pointless word off stack
1936#    move $t0, $s7 # return string we allocated in $s7
1940#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
1944:mth_readInt_Lib:

    # save $ra by pushing onto stack
1944#    subu $sp,$sp,4
1948#    sw $ra,($sp)

1952:  riSkipWhiteLoop:
    # read a character
1952#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
1956#    subu $t0,$v0,32
1960#    bgt $t0,$zero,nonWhite
1961##...slt $at,$zero,$t0
1965##...bne $at,$zero,2008
1968#    beq $t0,$zero,riSkipWhiteLoop # start over if space
1972#    subu $t0,$v0,10
1976#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
1980#    subu $t0,$v0,9
1984#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
1988#    subu $t0,$v0,13
1992#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
1996#    subu $t0,$v0,12
2000#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
2004#    j badIntegerFormat # illegal integer char: abort program

2008:  nonWhite:
2008#    subu $t0,$v0,'-'
2012#    li $t4,1 # final multiplier
2016#    bne $t0,$zero,helpReadInt # go read
2020#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
2024#    jal readLogicalChar

2028:  helpReadInt:
