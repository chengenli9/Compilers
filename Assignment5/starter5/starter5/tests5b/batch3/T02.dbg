8621##...bne $at,$zero,8600
    
8624:  doneSubCopyzz:
    # restore return address, store return value, pop stack
8624#    lw $ra,4($sp) # restore $ra
8628#    addu $sp,$sp,8 # pop ra, and allocated newObject
8632#    move $t0, $s7 # we're returning the string we got back
                  # from newObject
    
    # return
8636#    jr $ra
