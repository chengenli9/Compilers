    #   object that tells where the pointers in the object end
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0, $t9
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger"
3444#    lw $s0,($t4)
3448#    lw $t9,-8($t1)
3452#    sw $t9,($t4)
3456#    sw $s0,-8($t1)

    # copy all source bytes to the target
3460:  gCinnerCopy2:
3460#    lw $s0,($t4)
3464#    sw $s0,($s3)
3468#    addu $t4,$t4,4
3472#    addu $s3,$s3,4
3476#    bltu $t4,$t3,gCinnerCopy2
3477##...sltu $at,$t4,$t3
3481##...bne $at,$zero,3460

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
3484#    sw $zero,-8($t1) # 0 in first header-slot
3488#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
3492#    sw $t8,($t0)

3496:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
3496#    addu $t0,$t0,4
3500#    bltu $t0,$s1,gcNextPointerInObject
3501##...sltu $at,$t0,$s1
3505##...bne $at,$zero,3344

3508:  gcTestIterDone2:
3508#    bltu $t0,$s3,gcHeapCopyLoop
3509##...sltu $at,$t0,$s3
3513##...bne $at,$zero,3228

    ###### end outer loop to copy all non-stack-direct objects ######

3516:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
3516#    lw $s2,($sp)
3520#    addu $sp,$sp,4

    # mark us as having already GC'd
3524#    move $t5,$s5

    # go try and allocate again
3528#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
3532:vm_init:

    # mark bottom of stack
3532#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
3536#    move $s2,$zero

    #set up the "five" register
3540#    li $s5,5

3544#    la $s3,seg0_start
3548#    la $s4,seg0_end
3549##...lui $s4,16
3553##...addiu $s4,$s4,4412
    
    # return
3556#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3560:divide:
    # get parameters; abort if divisor zero
3560#    lw $t0,($sp)
3564#    lw $t1,8($sp)
3568#    beq $t0,$zero,divByZeroError
    
    # perform division
3572#    div $t1,$t0
3576#    mflo $t0

    # store result, adjust stack and return
3580#    addu $sp,$sp,8 # adjust stack
3584#    sw $t0,($sp) # store result
3588#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3592:remainder:
    # get parameters; abort if divisor zero
3592#    lw $t0,($sp)
3596#    lw $t1,8($sp)
3600#    beq $t0,$zero,divByZeroError
    
    # perform division
3604#    div $t1,$t0
3608#    mfhi $t0

    # store result, adjust stack and return
3612#    addu $sp,$sp,8 # adjust stack
3616#    sw $t0,($sp) # store result
3620#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
3624:checkCast:
    # get object, allow immediately if null
3624#    lw $t2,($sp)
3628#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
3632#    lw $t2,-12($t2) # vtable address
3636#    bge $t2,$t1,castException
3637##...slt $at,$t2,$t1
3641##...beq $at,$zero,3812
3644#    blt $t2,$t0,castException
3645##...slt $at,$t2,$t0
3649##...bne $at,$zero,3812
    
    # return, leaving object unchanged on stack
3652:  checkCastReturn:    
3652#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
3656:instanceOf:
    # get object, go return false if null
3656#    lw $t2,($sp)
3660#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
3664#    lw $t2,-12($t2) # vtable address
3668#    sge $t0,$t2,$t0 # are we >= the lower limit?
3669##...slt $t0,$t2,$t0
3673##...xori $t0,$t0,0x1
3676#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
3680#    and $t2,$t0,$t1
3684#    sw $t2,($sp)
3688:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
3688#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

3692:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
3692#    li $v0,4 # syscall-code for print-string
3696#    syscall
3700:exit:
    # print termination message
3700#    li $v0,4 # syscall-code for print-string
3704#    la $a0,exitString
3708#    syscall

    # print number of garbage collections
3712#    li $v0,4 # syscall-code for print-string
3716#    la $a0,gcCountMsg
3720#    syscall # print "Number of ..."
3724#    lw $a0,gcCount # number of GC's
3728#    li $v0,1 # code for print-int
3732#    syscall
3736#    li $v0,4 # syscall-code for print-string
3740#    la $a0,newlineString
3744#    syscall # print newline

    # terminate execution
3748#    li $v0,10 #syscall-code for "exit"
3752#    syscall

3756:outOfHeapMemory:
3756#    la $a0,heapMemoryMsg
3760#    j exitError
3764:divByZeroError:
3764#    la $a0,divByZeroMsg
3768#    j exitError
3772:strIndexOutOfBounds:
3772#    la $a0,strIndexOutOfBoundsMsg
3776#    j exitError
3780:arrayIndexOutOfBounds:
3780#    la $a0,arrayIndexOutOfBoundsMsg
3784#    j exitError
3788:arraySizeOutOfBounds:
3788#    la $a0,arraySizeOutOfBoundsMsg
3792#    j exitError
3796:nullPtrException:
3796#    la $a0,nullPtrExceptionMsg
3800#    j exitError
3804:badIntegerFormat:
3804#    la $a0,badIntegerFormatMsg
3808#    j exitError
3812:castException:
3812#    la $a0,castExceptionMsg
3816#    j exitError
############## data section ################
    .data
4040:hexChars:
    .ascii "0123456789abcdef"
    .align 2
4056:cur_seg:
    .word 0

4060:lastCharRead:
    .word -2 # -2 => no buffered character
4064:prevHashConstant:
    .word 0x2785173c
4068:gcCount:
    .word 0

4072:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
4099:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
4122:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
4157:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
4191:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
4224:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
4255:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
4303:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
4324:gcMsg: 
      .asciiz "\nGC!\n"
4330:gcCountMsg: 
      .asciiz "Number of garbage collections: "

4362:nullStr:
    .asciiz "null"
4367:trueString:
    .asciiz "true"
4372:falseString:
    .asciiz "false"
4378:exitString:
    .ascii "Program execution completed."
    #### "falls through" here
4406:newlineString:
    .asciiz "\n"
    
    .align 2
4408:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

4412:seg0_start:
    .space 0x100000
1052988:seg0_end:
1052988:seg1_start:
    .space 0x100000
2101564:seg1_end:
