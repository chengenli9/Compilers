
5224:  gcSkip5:
5224#    sll $t8,$t8,2 # bytes in negative-offset portion ...
5228#    addu $t8,$t8,8 # ... add in bytes for header-words
5232#    subu $t4,$t1,$t8 # address of first word of source object
5236#    lw $t3,-4($t1) # # words in positive-offset portion
5240#    bge $t3,$zero,gcNoNeg
5241##...slt $at,$t3,$zero
5245##...beq $at,$zero,5252
5248#    move $t3,$zero # negative treated as zero
5252:  gcNoNeg:
5252#    sll $t3,$t3,2 # bytes in negative-offset portion
5256#    addu $t3,$t3,$t1 # address one word past last word of source

5260#    addu $t8,$s3,$t8 # pointer to target object

    #########################################################
    # At this point:
    # - $t0 contains the address of the stack slot we'll
    #   process next
    # - $t1 contains the contents of the stack slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $t8 contains the pointer to the target object
    # - $s1 contains the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0, $t9
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger"
5264#    lw $s0,($t4)
5268#    lw $t9,-8($t1)
5272#    sw $t9,($t4)
5276#    sw $s0,-8($t1)

    # copy all source bytes to the target
5280:  gCinnerCopy2:
5280#    lw $s0,($t4)
5284#    sw $s0,($s3)
5288#    addu $t4,$t4,4
5292#    addu $s3,$s3,4
5296#    bltu $t4,$t3,gCinnerCopy2
5297##...sltu $at,$t4,$t3
5301##...bne $at,$zero,5280

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
5304#    sw $zero,-8($t1) # 0 in first header-slot
5308#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
5312#    sw $t8,($t0)

5316:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
5316#    addu $t0,$t0,4
5320#    bltu $t0,$s1,gcNextPointerInObject
5321##...sltu $at,$t0,$s1
5325##...bne $at,$zero,5164

5328:  gcTestIterDone2:
5328#    bltu $t0,$s3,gcHeapCopyLoop
5329##...sltu $at,$t0,$s3
5333##...bne $at,$zero,5048

    ###### end outer loop to copy all non-stack-direct objects ######

5336:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
5336#    lw $s2,($sp)
5340#    addu $sp,$sp,4

    # mark us as having already GC'd
5344#    move $t5,$s5

    # go try and allocate again
5348#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
5352:vm_init:

    # mark bottom of stack
5352#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
5356#    move $s2,$zero

    #set up the "five" register
5360#    li $s5,5

5364#    la $s3,seg0_start
5368#    la $s4,seg0_end
5369##...lui $s4,16
5373##...addiu $s4,$s4,6384
    
    # return
5376#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
5380:divide:
    # get parameters; abort if divisor zero
5380#    lw $t0,($sp)
5384#    lw $t1,8($sp)
5388#    beq $t0,$zero,divByZeroError
    
    # perform division
5392#    div $t1,$t0
5396#    mflo $t0

    # store result, adjust stack and return
5400#    addu $sp,$sp,8 # adjust stack
5404#    sw $t0,($sp) # store result
5408#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
5412:remainder:
    # get parameters; abort if divisor zero
5412#    lw $t0,($sp)
5416#    lw $t1,8($sp)
5420#    beq $t0,$zero,divByZeroError
    
    # perform division
5424#    div $t1,$t0
5428#    mfhi $t0

    # store result, adjust stack and return
5432#    addu $sp,$sp,8 # adjust stack
5436#    sw $t0,($sp) # store result
5440#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
5444:checkCast:
    # get object, allow immediately if null
5444#    lw $t2,($sp)
5448#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
5452#    lw $t2,-12($t2) # vtable address
5456#    bge $t2,$t1,castException
5457##...slt $at,$t2,$t1
5461##...beq $at,$zero,5632
5464#    blt $t2,$t0,castException
5465##...slt $at,$t2,$t0
5469##...bne $at,$zero,5632
    
    # return, leaving object unchanged on stack
5472:  checkCastReturn:    
5472#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
5476:instanceOf:
    # get object, go return false if null
5476#    lw $t2,($sp)
5480#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
5484#    lw $t2,-12($t2) # vtable address
5488#    sge $t0,$t2,$t0 # are we >= the lower limit?
5489##...slt $t0,$t2,$t0
5493##...xori $t0,$t0,0x1
5496#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
5500#    and $t2,$t0,$t1
5504#    sw $t2,($sp)
5508:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
5508#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

5512:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
5512#    li $v0,4 # syscall-code for print-string
5516#    syscall
5520:exit:
    # print termination message
5520#    li $v0,4 # syscall-code for print-string
5524#    la $a0,exitString
5528#    syscall

    # print number of garbage collections
5532#    li $v0,4 # syscall-code for print-string
5536#    la $a0,gcCountMsg
5540#    syscall # print "Number of ..."
5544#    lw $a0,gcCount # number of GC's
5548#    li $v0,1 # code for print-int
5552#    syscall
5556#    li $v0,4 # syscall-code for print-string
5560#    la $a0,newlineString
5564#    syscall # print newline

    # terminate execution
5568#    li $v0,10 #syscall-code for "exit"
5572#    syscall

5576:outOfHeapMemory:
5576#    la $a0,heapMemoryMsg
5580#    j exitError
5584:divByZeroError:
5584#    la $a0,divByZeroMsg
5588#    j exitError
5592:strIndexOutOfBounds:
5592#    la $a0,strIndexOutOfBoundsMsg
5596#    j exitError
5600:arrayIndexOutOfBounds:
5600#    la $a0,arrayIndexOutOfBoundsMsg
5604#    j exitError
5608:arraySizeOutOfBounds:
5608#    la $a0,arraySizeOutOfBoundsMsg
5612#    j exitError
5616:nullPtrException:
5616#    la $a0,nullPtrExceptionMsg
5620#    j exitError
5624:badIntegerFormat:
5624#    la $a0,badIntegerFormatMsg
5628#    j exitError
5632:castException:
5632#    la $a0,castExceptionMsg
5636#    j exitError
############## data section ################
    .data
6012:hexChars:
    .ascii "0123456789abcdef"
    .align 2
6028:cur_seg:
    .word 0

6032:lastCharRead:
    .word -2 # -2 => no buffered character
6036:prevHashConstant:
    .word 0x2785173c
6040:gcCount:
    .word 0

6044:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
6071:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
6094:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
6129:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
6163:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
6196:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
6227:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
6275:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
6296:gcMsg: 
      .asciiz "\nGC!\n"
6302:gcCountMsg: 
      .asciiz "Number of garbage collections: "

6334:nullStr:
    .asciiz "null"
6339:trueString:
    .asciiz "true"
6344:falseString:
    .asciiz "false"
6350:exitString:
    .ascii "Program execution completed."
    #### "falls through" here
6378:newlineString:
    .asciiz "\n"
    
    .align 2
6380:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

6384:seg0_start:
    .space 0x100000
1054960:seg0_end:
1054960:seg1_start:
    .space 0x100000
2103536:seg1_end:
