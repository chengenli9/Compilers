12160#    beq $t0,$zero,riSkipWhiteLoop # start over if space
12164#    subu $t0,$v0,10
12168#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
12172#    subu $t0,$v0,9
12176#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
12180#    subu $t0,$v0,13
12184#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
12188#    subu $t0,$v0,12
12192#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
12196#    j badIntegerFormat # illegal integer char: abort program

12200:  nonWhite:
12200#    subu $t0,$v0,'-'
12204#    li $t4,1 # final multiplier
12208#    bne $t0,$zero,helpReadInt # go read
12212#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
12216#    jal readLogicalChar

12220:  helpReadInt:
12220#    li $t2,10
12224#    subu $t1,$v0,'0' # convert digit to 0-9 value
12228#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
12229##...sltu $at,$t1,$t2
12233##...beq $at,$zero,14516
12236#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

12240:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

12240#    jal readLogicalChar # read next character
12244#    subu $t1,$v0,'0' # convert digit to 0-9 value
12248#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
12249##...sltu $at,$t1,$t2
12253##...beq $at,$zero,12272

12256#    mul $t3,$t3,$t2 # multiply old value by 10
12257##...mult $t3,$t2
12261##...mflo $t3
12264#    addu $t3,$t3,$t1 # add in value of new digit
12268#    j digitLoop
