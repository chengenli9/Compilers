########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
6588:vm_init:

    # mark bottom of stack
6588#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
6592#    move $s2,$zero

    #set up the "five" register
6596#    li $s5,5

6600#    la $s3,seg0_start
6604#    la $s4,seg0_end
6605##...lui $s4,16
6609##...addiu $s4,$s4,7448
    
    # return
6612#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
6616:divide:
    # get parameters; abort if divisor zero
6616#    lw $t0,($sp)
6620#    lw $t1,8($sp)
6624#    beq $t0,$zero,divByZeroError
    
    # perform division
6628#    div $t1,$t0
6632#    mflo $t0

    # store result, adjust stack and return
6636#    addu $sp,$sp,8 # adjust stack
6640#    sw $t0,($sp) # store result
6644#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
6648:remainder:
    # get parameters; abort if divisor zero
6648#    lw $t0,($sp)
6652#    lw $t1,8($sp)
6656#    beq $t0,$zero,divByZeroError
    
    # perform division
6660#    div $t1,$t0
6664#    mfhi $t0

    # store result, adjust stack and return
6668#    addu $sp,$sp,8 # adjust stack
6672#    sw $t0,($sp) # store result
6676#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
6680:checkCast:
    # get object, allow immediately if null
6680#    lw $t2,($sp)
6684#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
6688#    lw $t2,-12($t2) # vtable address
6692#    bge $t2,$t1,castException
6693##...slt $at,$t2,$t1
6697##...beq $at,$zero,6868
6700#    blt $t2,$t0,castException
6701##...slt $at,$t2,$t0
6705##...bne $at,$zero,6868
    
    # return, leaving object unchanged on stack
6708:  checkCastReturn:    
6708#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
6712:instanceOf:
    # get object, go return false if null
6712#    lw $t2,($sp)
6716#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
6720#    lw $t2,-12($t2) # vtable address
6724#    sge $t0,$t2,$t0 # are we >= the lower limit?
6725##...slt $t0,$t2,$t0
6729##...xori $t0,$t0,0x1
6732#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
6736#    and $t2,$t0,$t1
6740#    sw $t2,($sp)
6744:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
6744#    jr $ra

