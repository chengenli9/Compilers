1373##...slt $at,$zero,$t0
1377##...bne $at,$zero,1420
1380#    beq $t0,$zero,riSkipWhiteLoop # start over if space
1384#    subu $t0,$v0,10
1388#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
1392#    subu $t0,$v0,9
1396#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
1400#    subu $t0,$v0,13
1404#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
1408#    subu $t0,$v0,12
1412#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
1416#    j badIntegerFormat # illegal integer char: abort program

1420:  nonWhite:
1420#    subu $t0,$v0,'-'
1424#    li $t4,1 # final multiplier
1428#    bne $t0,$zero,helpReadInt # go read
1432#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
1436#    jal readLogicalChar

1440:  helpReadInt:
1440#    li $t2,10
1444#    subu $t1,$v0,'0' # convert digit to 0-9 value
