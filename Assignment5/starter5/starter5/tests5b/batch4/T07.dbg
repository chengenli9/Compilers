3820#    lw $t1,-12($t2) # vtable pointer
3824#    li $t0,dataArrayVTableStart # address of vtable for first data array
3828#    blt $t1,$t0,gcNotDataArray # if data array, no more xforming to do
3829##...slt $at,$t1,$t0
3833##...bne $at,$zero,3852

    # We have a vtable address that is a data array.
    # we need skip over it then loop back to do next object.
3836:  skipToNextObj:
3836#    lw $t1,-4($t2) # data words in (object position of) array
    #### note: we know that it's not a string, so the value will
    #### not be artificially negative
3840#    sll $t1,$t1,2 # convert to byte-count
3844#    addu $t0,$t2,$t1 # skip over object
3848#    j gcTestIterDone2 # go do next object, if any

    ###################################################
    # at this point:
    # - the object has been restored to normal status--that is, the
    #   word-swap has been done
    # - $t2 contains a pointer to the object
    ###################################################
    
3852:  gcNotDataArray:
3852#    lw $t3,-4($t2) # # object words (negative treated as zero)
3856#    bge $t3,$zero,gcH2Neg2
3857##...slt $at,$t3,$zero
3861##...beq $at,$zero,3868
3864#    move $t3,$zero
3868:  gcH2Neg2:
3868#    sll $t3,$t3,2 # # object bytes
3872#    move $t0,$t2 # address of first pointer in object
3876#    add $s1,$t2,$t3 # limit address for this object

    #####################################################
    # At this point, we have to "translate" all pointers,
    # starting at $t0 to (but not including) $s1
    #####################################################

    # if there are no pointer-slots (i.e., $t0=$s1), skip this
    # part
3880#    beq $t0,$s1,gcTestIterDone2
    
3884:  gcNextPointerInObject:
    # get pointer from object
3884#    lw $t1,($t0)

    # if value is out of range, and is therefore does not refer
    # to an object, just go loop back and do the next one
3888#    bleu $t1,$t6,gcGoNextPointerSlot
3889##...sltu $at,$t6,$t1
3893##...beq $at,$zero,4036
3896#    bgtu $t1,$t7,gcGoNextPointerSlot
3897##...sltu $at,$t7,$t1
3901##...bne $at,$zero,4036

    # if the object has already been moved, update the stack-value
    # via the forwarding pointer
3904#    lw $t8,-8($t1) # possible forwarding tag
3908#    bne $t8,$zero,gcNoForward2 # if not forwarding tag, go copy
3912#    lw $t8,-4($t1) # forwarding pointer: object's new address
3916#    sw $t8,($t0) # update pointer in object
3920#    j gcGoNextPointerSlot # do next iteration

3924:  gcNoForward2:
    #########################################################
    # we actually need to copy the object into the new space
    #########################################################

    #########################################################
    # At this point:
    # - $t0 contains the address of the heap-slot we're translating
    # - $t1 will contain the contents of the heap-slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space, which will also be the first address
    #   of the target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # Then during processing:
    # And when we're actually copying an object:
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $t8 will contain a pointer to the target object
    # - available for use: $s0, $t8, $t9
    ##########################################################

    # compute the amount of space that is needed
3924#    bge $t8,$zero,gcSkip5 # # words in negative-offset portion
3925##...slt $at,$t8,$zero
3929##...beq $at,$zero,3944
3932#    and $t8,0xff # mask off hash bits
3933##...lui $at,0
3937##...ori $at,$at,0xff
3941##...and $t8,$t8,$at

3944:  gcSkip5:
3944#    sll $t8,$t8,2 # bytes in negative-offset portion ...
3948#    addu $t8,$t8,8 # ... add in bytes for header-words
3952#    subu $t4,$t1,$t8 # address of first word of source object
3956#    lw $t3,-4($t1) # # words in positive-offset portion
3960#    bge $t3,$zero,gcNoNeg
3961##...slt $at,$t3,$zero
3965##...beq $at,$zero,3972
3968#    move $t3,$zero # negative treated as zero
3972:  gcNoNeg:
3972#    sll $t3,$t3,2 # bytes in negative-offset portion
3976#    addu $t3,$t3,$t1 # address one word past last word of source

3980#    addu $t8,$s3,$t8 # pointer to target object

    #########################################################
    # At this point:
    # - $t0 contains the address of the stack slot we'll
    #   process next
    # - $t1 contains the contents of the stack slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $t8 contains the pointer to the target object
    # - $s1 contains the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0, $t9
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger"
3984#    lw $s0,($t4)
3988#    lw $t9,-8($t1)
3992#    sw $t9,($t4)
3996#    sw $s0,-8($t1)

    # copy all source bytes to the target
4000:  gCinnerCopy2:
4000#    lw $s0,($t4)
4004#    sw $s0,($s3)
4008#    addu $t4,$t4,4
4012#    addu $s3,$s3,4
4016#    bltu $t4,$t3,gCinnerCopy2
4017##...sltu $at,$t4,$t3
4021##...bne $at,$zero,4000

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
4024#    sw $zero,-8($t1) # 0 in first header-slot
4028#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
4032#    sw $t8,($t0)

4036:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
4036#    addu $t0,$t0,4
4040#    bltu $t0,$s1,gcNextPointerInObject
4041##...sltu $at,$t0,$s1
4045##...bne $at,$zero,3884

4048:  gcTestIterDone2:
4048#    bltu $t0,$s3,gcHeapCopyLoop
4049##...sltu $at,$t0,$s3
4053##...bne $at,$zero,3768

    ###### end outer loop to copy all non-stack-direct objects ######

4056:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
4056#    lw $s2,($sp)
4060#    addu $sp,$sp,4

    # mark us as having already GC'd
4064#    move $t5,$s5

    # go try and allocate again
4068#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
4072:vm_init:

    # mark bottom of stack
4072#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
4076#    move $s2,$zero

    #set up the "five" register
4080#    li $s5,5

4084#    la $s3,seg0_start
4088#    la $s4,seg0_end
4089##...lui $s4,16
4093##...addiu $s4,$s4,4960
    
    # return
4096#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4100:divide:
    # get parameters; abort if divisor zero
4100#    lw $t0,($sp)
4104#    lw $t1,8($sp)
4108#    beq $t0,$zero,divByZeroError
    
    # perform division
4112#    div $t1,$t0
4116#    mflo $t0

    # store result, adjust stack and return
4120#    addu $sp,$sp,8 # adjust stack
4124#    sw $t0,($sp) # store result
4128#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4132:remainder:
    # get parameters; abort if divisor zero
4132#    lw $t0,($sp)
4136#    lw $t1,8($sp)
4140#    beq $t0,$zero,divByZeroError
    
    # perform division
4144#    div $t1,$t0
4148#    mfhi $t0

    # store result, adjust stack and return
4152#    addu $sp,$sp,8 # adjust stack
4156#    sw $t0,($sp) # store result
4160#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
4164:checkCast:
    # get object, allow immediately if null
4164#    lw $t2,($sp)
4168#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
4172#    lw $t2,-12($t2) # vtable address
4176#    bge $t2,$t1,castException
4177##...slt $at,$t2,$t1
4181##...beq $at,$zero,4352
4184#    blt $t2,$t0,castException
4185##...slt $at,$t2,$t0
4189##...bne $at,$zero,4352
    
    # return, leaving object unchanged on stack
4192:  checkCastReturn:    
4192#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
4196:instanceOf:
    # get object, go return false if null
4196#    lw $t2,($sp)
4200#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
4204#    lw $t2,-12($t2) # vtable address
4208#    sge $t0,$t2,$t0 # are we >= the lower limit?
4209##...slt $t0,$t2,$t0
4213##...xori $t0,$t0,0x1
4216#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
4220#    and $t2,$t0,$t1
4224#    sw $t2,($sp)
4228:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
4228#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

4232:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
4232#    li $v0,4 # syscall-code for print-string
4236#    syscall
4240:exit:
    # print termination message
4240#    li $v0,4 # syscall-code for print-string
4244#    la $a0,exitString
4248#    syscall

    # print number of garbage collections
4252#    li $v0,4 # syscall-code for print-string
4256#    la $a0,gcCountMsg
4260#    syscall # print "Number of ..."
4264#    lw $a0,gcCount # number of GC's
4268#    li $v0,1 # code for print-int
4272#    syscall
4276#    li $v0,4 # syscall-code for print-string
4280#    la $a0,newlineString
4284#    syscall # print newline

    # terminate execution
4288#    li $v0,10 #syscall-code for "exit"
4292#    syscall

4296:outOfHeapMemory:
4296#    la $a0,heapMemoryMsg
4300#    j exitError
4304:divByZeroError:
4304#    la $a0,divByZeroMsg
4308#    j exitError
4312:strIndexOutOfBounds:
4312#    la $a0,strIndexOutOfBoundsMsg
4316#    j exitError
4320:arrayIndexOutOfBounds:
4320#    la $a0,arrayIndexOutOfBoundsMsg
4324#    j exitError
4328:arraySizeOutOfBounds:
4328#    la $a0,arraySizeOutOfBoundsMsg
4332#    j exitError
4336:nullPtrException:
4336#    la $a0,nullPtrExceptionMsg
4340#    j exitError
4344:badIntegerFormat:
4344#    la $a0,badIntegerFormatMsg
4348#    j exitError
4352:castException:
4352#    la $a0,castExceptionMsg
4356#    j exitError
############## data section ################
    .data
4588:hexChars:
    .ascii "0123456789abcdef"
    .align 2
4604:cur_seg:
    .word 0

4608:lastCharRead:
    .word -2 # -2 => no buffered character
4612:prevHashConstant:
    .word 0x2785173c
4616:gcCount:
    .word 0

4620:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
4647:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
4670:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
4705:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
4739:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
4772:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
4803:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
4851:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
4872:gcMsg: 
      .asciiz "\nGC!\n"
4878:gcCountMsg: 
      .asciiz "Number of garbage collections: "

4910:nullStr:
    .asciiz "null"
4915:trueString:
    .asciiz "true"
4920:falseString:
    .asciiz "false"
4926:exitString:
    .ascii "Program execution completed."
    #### "falls through" here
4954:newlineString:
    .asciiz "\n"
    
    .align 2
4956:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

4960:seg0_start:
    .space 0x100000
1053536:seg0_end:
1053536:seg1_start:
    .space 0x100000
2102112:seg1_end:
