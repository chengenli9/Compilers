4025##...sltu $at,$t6,$t1
4029##...beq $at,$zero,4192
4032#    bgtu $t1,$t7,gcTestIterDone1
4033##...sltu $at,$t7,$t1
4037##...bne $at,$zero,4192

    # if the object has already been moved, update the stack-value
    # via the forwarding pointer
4040#    lw $t2,-8($t1) # possible forwarding tag
4044#    bne $t2,$zero,gcNoForward1 # if not forwarding tag, go copy
4048#    lw $t2,-4($t1) # forwarding pointer: object's new address
4052#    sw $t2,4($t0) # update stack value
4056#    j gcTestIterDone1 # do next iteration

4060:  gcNoForward1:
    #########################################################
    # we actually need to copy the object into the new space
    #########################################################
