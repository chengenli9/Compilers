    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
1180#    addu $t4,8
1184#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
1188#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

1192#    li $t0,CLASS_String # store string vtable address into ...
1196#    sw $t0,-12($s7) # ... -12 offset in object header
1200#    lw $t2,-12($s2) # our object's vtable address
1204#    lw $t5,4($sp) # number characters in prefix
1208#    lw $t1,12($sp) # number of characters in hashcode
1212#    addu $t3,$t1,$t5 # number of characters in string ...
1216#    addu $t3,1 # ... including the '@' character
1220#    subu $t0,$zero,$t3 # store negated length into ...
1224#    sw $t0,-4($s7) # ... -4 offset header word
1228#    lw $t0,-8($s7) # get -8 offset header-word
1232#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
1233##...slt $at,$t0,$zero
1237##...beq $at,$zero,1256
1240#    and $t0,0xff # mask off object's hash value ...
1241##...lui $at,0
1245##...ori $at,$at,0xff
1249##...and $t0,$t0,$at
1252#    sw $t0,-8($s7) # ... and store back into -8 header-word
1256:skipMask_toString:
1256#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
1260#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
1264#    subu $t4,$t2,$t5
1268:toString_copyLoop:    
1268#    lb $t3,($t4)
1272#    and $t3,0x7f # mask off sign bit (in case first word)
1273##...lui $at,0
1277##...ori $at,$at,0x7f
1281##...and $t3,$t3,$at
1284#    sb $t3,-8($t0)
1288#    addu $t4,1
1292#    addu $t0,1
1296#    blt $t4,$t2,toString_copyLoop
1297##...slt $at,$t4,$t2
1301##...bne $at,$zero,1268
