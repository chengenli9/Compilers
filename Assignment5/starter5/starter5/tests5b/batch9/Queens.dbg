########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
6280:vm_init:

    # mark bottom of stack
6280#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
6284#    move $s2,$zero

    #set up the "five" register
6288#    li $s5,5

6292#    la $s3,seg0_start
6296#    la $s4,seg0_end
6297##...lui $s4,16
6301##...addiu $s4,$s4,7176
    
    # return
6304#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
6308:divide:
    # get parameters; abort if divisor zero
6308#    lw $t0,($sp)
6312#    lw $t1,8($sp)
6316#    beq $t0,$zero,divByZeroError
    
    # perform division
6320#    div $t1,$t0
6324#    mflo $t0

    # store result, adjust stack and return
6328#    addu $sp,$sp,8 # adjust stack
6332#    sw $t0,($sp) # store result
6336#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
6340:remainder:
    # get parameters; abort if divisor zero
6340#    lw $t0,($sp)
6344#    lw $t1,8($sp)
6348#    beq $t0,$zero,divByZeroError
    
    # perform division
6352#    div $t1,$t0
6356#    mfhi $t0

    # store result, adjust stack and return
6360#    addu $sp,$sp,8 # adjust stack
6364#    sw $t0,($sp) # store result
6368#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
6372:checkCast:
    # get object, allow immediately if null
6372#    lw $t2,($sp)
6376#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
6380#    lw $t2,-12($t2) # vtable address
6384#    bge $t2,$t1,castException
6385##...slt $at,$t2,$t1
6389##...beq $at,$zero,6560
6392#    blt $t2,$t0,castException
6393##...slt $at,$t2,$t0
6397##...bne $at,$zero,6560
    
    # return, leaving object unchanged on stack
6400:  checkCastReturn:    
6400#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
6404:instanceOf:
    # get object, go return false if null
6404#    lw $t2,($sp)
6408#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
6412#    lw $t2,-12($t2) # vtable address
6416#    sge $t0,$t2,$t0 # are we >= the lower limit?
6417##...slt $t0,$t2,$t0
6421##...xori $t0,$t0,0x1
6424#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
6428#    and $t2,$t0,$t1
6432#    sw $t2,($sp)
6436:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
6436#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

6440:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
6440#    li $v0,4 # syscall-code for print-string
6444#    syscall
6448:exit:
    # print termination message
6448#    li $v0,4 # syscall-code for print-string
6452#    la $a0,exitString
6456#    syscall

    # print number of garbage collections
6460#    li $v0,4 # syscall-code for print-string
6464#    la $a0,gcCountMsg
6468#    syscall # print "Number of ..."
6472#    lw $a0,gcCount # number of GC's
6476#    li $v0,1 # code for print-int
6480#    syscall
6484#    li $v0,4 # syscall-code for print-string
6488#    la $a0,newlineString
6492#    syscall # print newline

    # terminate execution
6496#    li $v0,10 #syscall-code for "exit"
6500#    syscall

6504:outOfHeapMemory:
6504#    la $a0,heapMemoryMsg
6508#    j exitError
6512:divByZeroError:
6512#    la $a0,divByZeroMsg
6516#    j exitError
6520:strIndexOutOfBounds:
6520#    la $a0,strIndexOutOfBoundsMsg
6524#    j exitError
6528:arrayIndexOutOfBounds:
6528#    la $a0,arrayIndexOutOfBoundsMsg
6532#    j exitError
6536:arraySizeOutOfBounds:
