##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
584:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
584#    lw $t0,-8($s2) # get word with hash bits from this
588#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
592#    addu $t0,$t1

596#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
600:mth_equals_Object:
600#    move $t0,$s2 # first pointer (this)
604#    lw $t1,($sp) # second pointer
608#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
609##...subu $at,$t0,$t1
613##...sltiu $t0,$at,1

616#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
620:mth_hashCode_String:
620#    move $t0,$s2 # put this pointer in t0

624#    li $t2,0 # current hash value
628#    lw $t1,-4($t0) # negative of number of characters in string
632#    beq $t1,$zero,done_hashCode_String # if zero length => done
636#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
640#    and $t0,0xfffffffc # adjust for padding
641##...lui $at,65535
645##...ori $at,$at,0xfffc
649##...and $t0,$t0,$at
652#    subu $t1,$t0,$t1 # address at end of string +12
656:loop_hashCode_String:    
656#    sll $t4,$t2,5 # multiply by 32
660#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
664#    lbu $t3,-12($t0) # current character
668#    addu $t2,$t3 # add in current character
672#    addu $t0,1 # go to next character's address
676#    bne $t0,$t1,loop_hashCode_String # loop back if more
680:done_hashCode_String:    

    # push int on stack
680#    move $t0, $t2 # put $t2 in return slot
684#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
688:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
688#    subu $sp,4
692#    sw $ra,($sp)
    
    # get hash value
696#    lw $t2,-12($s2) # vtable address
700#    lw $t0,($t2) # method address
704#    jalr $t0
708#    subu $sp,8 # push result (int in $t0) on stack
712#    sw $s5,4($sp)
716#    sw $t0,($sp)

    # compute print-size of hash value
720#    li $t0, 1
724#    lw $t1, ($sp)
728#    srl $t1,$t1,4
732#    beq $t1,$zero,toString_skip_loop
736:toString_loop_top:
736#    addu $t0,1
740#    srl $t1,$t1,4
744#    bne $t1,$zero,toString_loop_top
748:toString_skip_loop:
748#    subu $sp,8
752#    sw $s5,4($sp)
756#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################
