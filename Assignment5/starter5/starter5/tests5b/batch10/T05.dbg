5945##...addiu $s4,$s4,7436
5948#    sw $zero,cur_seg
5952#    bne $t0,$zero,skipGc1
5956#    la $t6,seg0_start
5960#    la $s3,seg1_start
5961##...lui $s3,16
5965##...addiu $s3,$s3,7436
5968#    la $s4,seg1_end
5969##...lui $s4,32
5973##...addiu $s4,$s4,7436
