########################################################
# readLogicalChar (millicode)
#  - logically reads a character from standard input
#  - first checks character buffer, consuming it if possible
#  - return-result:
#    - returns character in $v0
#  - side-effects:
#    - reads a character
#    - clobbers $t0
########################################################
3632:readLogicalChar:

    # check if we already have a character
3632#    lw $v0,lastCharRead
3636#    li $t0,-2
3640#    beq $t0,$v0 doReadCh

    # we have our character from the buffer. Wipe out
    # buffer and return
3644#    sw $t0,lastCharRead # store -2 into buffer (i.e. "empty")
3648#    jr $ra # return
    
3652:  doReadCh:
    # we need to actually read a character: read and return
3652#    li $v0,12 # use system call to read a character
3656#    syscall
3660#    jr $ra # return
