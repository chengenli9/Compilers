5100#    lw $t8,-8($t1) # possible forwarding tag
5104#    bne $t8,$zero,gcNoForward2 # if not forwarding tag, go copy
5108#    lw $t8,-4($t1) # forwarding pointer: object's new address
5112#    sw $t8,($t0) # update pointer in object
5116#    j gcGoNextPointerSlot # do next iteration

5120:  gcNoForward2:
    #########################################################
    # we actually need to copy the object into the new space
    #########################################################

    #########################################################
    # At this point:
    # - $t0 contains the address of the heap-slot we're translating
    # - $t1 will contain the contents of the heap-slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space, which will also be the first address
    #   of the target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # Then during processing:
    # And when we're actually copying an object:
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $t8 will contain a pointer to the target object
    # - available for use: $s0, $t8, $t9
    ##########################################################

    # compute the amount of space that is needed
5120#    bge $t8,$zero,gcSkip5 # # words in negative-offset portion
5121##...slt $at,$t8,$zero
5125##...beq $at,$zero,5140
5128#    and $t8,0xff # mask off hash bits
5129##...lui $at,0
5133##...ori $at,$at,0xff
5137##...and $t8,$t8,$at

5140:  gcSkip5:
5140#    sll $t8,$t8,2 # bytes in negative-offset portion ...
5144#    addu $t8,$t8,8 # ... add in bytes for header-words
5148#    subu $t4,$t1,$t8 # address of first word of source object
5152#    lw $t3,-4($t1) # # words in positive-offset portion
5156#    bge $t3,$zero,gcNoNeg
5157##...slt $at,$t3,$zero
5161##...beq $at,$zero,5168
5164#    move $t3,$zero # negative treated as zero
5168:  gcNoNeg:
5168#    sll $t3,$t3,2 # bytes in negative-offset portion
5172#    addu $t3,$t3,$t1 # address one word past last word of source

5176#    addu $t8,$s3,$t8 # pointer to target object

    #########################################################
    # At this point:
    # - $t0 contains the address of the stack slot we'll
    #   process next
    # - $t1 contains the contents of the stack slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $t8 contains the pointer to the target object
    # - $s1 contains the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0, $t9
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger"
5180#    lw $s0,($t4)
5184#    lw $t9,-8($t1)
5188#    sw $t9,($t4)
5192#    sw $s0,-8($t1)

    # copy all source bytes to the target
5196:  gCinnerCopy2:
5196#    lw $s0,($t4)
5200#    sw $s0,($s3)
5204#    addu $t4,$t4,4
5208#    addu $s3,$s3,4
5212#    bltu $t4,$t3,gCinnerCopy2
5213##...sltu $at,$t4,$t3
5217##...bne $at,$zero,5196

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
5220#    sw $zero,-8($t1) # 0 in first header-slot
5224#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
5228#    sw $t8,($t0)

5232:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
5232#    addu $t0,$t0,4
5236#    bltu $t0,$s1,gcNextPointerInObject
5237##...sltu $at,$t0,$s1
5241##...bne $at,$zero,5080

5244:  gcTestIterDone2:
5244#    bltu $t0,$s3,gcHeapCopyLoop
5245##...sltu $at,$t0,$s3
5249##...bne $at,$zero,4964

    ###### end outer loop to copy all non-stack-direct objects ######

5252:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
5252#    lw $s2,($sp)
5256#    addu $sp,$sp,4

    # mark us as having already GC'd
5260#    move $t5,$s5

    # go try and allocate again
5264#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
5268:vm_init:

    # mark bottom of stack
5268#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
5272#    move $s2,$zero

    #set up the "five" register
5276#    li $s5,5

5280#    la $s3,seg0_start
5284#    la $s4,seg0_end
5285##...lui $s4,16
5289##...addiu $s4,$s4,6304
    
    # return
5292#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
5296:divide:
    # get parameters; abort if divisor zero
5296#    lw $t0,($sp)
5300#    lw $t1,8($sp)
5304#    beq $t0,$zero,divByZeroError
    
    # perform division
5308#    div $t1,$t0
5312#    mflo $t0

    # store result, adjust stack and return
5316#    addu $sp,$sp,8 # adjust stack
5320#    sw $t0,($sp) # store result
5324#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
5328:remainder:
    # get parameters; abort if divisor zero
5328#    lw $t0,($sp)
5332#    lw $t1,8($sp)
5336#    beq $t0,$zero,divByZeroError
    
    # perform division
5340#    div $t1,$t0
5344#    mfhi $t0

    # store result, adjust stack and return
5348#    addu $sp,$sp,8 # adjust stack
5352#    sw $t0,($sp) # store result
5356#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
5360:checkCast:
    # get object, allow immediately if null
5360#    lw $t2,($sp)
5364#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
5368#    lw $t2,-12($t2) # vtable address
5372#    bge $t2,$t1,castException
5373##...slt $at,$t2,$t1
5377##...beq $at,$zero,5512
5380#    blt $t2,$t0,castException
5381##...slt $at,$t2,$t0
5385##...bne $at,$zero,5512
    
    # return, leaving object unchanged on stack
5388:  checkCastReturn:    
5388#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
5392:instanceOf:
    # get object, go return false if null
5392#    lw $t2,($sp)
5396#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
5400#    lw $t2,-12($t2) # vtable address
5404#    sge $t0,$t2,$t0 # are we >= the lower limit?
5405##...slt $t0,$t2,$t0
5409##...xori $t0,$t0,0x1
5412#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
5416#    and $t2,$t0,$t1
5420#    sw $t2,($sp)
5424:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
5424#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

5428:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
5428#    li $v0,4 # syscall-code for print-string
5432#    syscall
5436:exit:
    # print termination message
5436#    li $v0,4 # syscall-code for print-string
5440#    la $a0,exitString
5444#    syscall

    # terminate execution
5448#    li $v0,10 #syscall-code for "exit"
5452#    syscall

5456:outOfHeapMemory:
5456#    la $a0,heapMemoryMsg
5460#    j exitError
5464:divByZeroError:
5464#    la $a0,divByZeroMsg
5468#    j exitError
5472:strIndexOutOfBounds:
5472#    la $a0,strIndexOutOfBoundsMsg
5476#    j exitError
5480:arrayIndexOutOfBounds:
5480#    la $a0,arrayIndexOutOfBoundsMsg
5484#    j exitError
5488:arraySizeOutOfBounds:
5488#    la $a0,arraySizeOutOfBoundsMsg
5492#    j exitError
5496:nullPtrException:
5496#    la $a0,nullPtrExceptionMsg
5500#    j exitError
5504:badIntegerFormat:
5504#    la $a0,badIntegerFormatMsg
5508#    j exitError
5512:castException:
5512#    la $a0,castExceptionMsg
5516#    j exitError
############## data section ################
    .data
5940:hexChars:
    .ascii "0123456789abcdef"
    .align 2
5956:cur_seg:
    .word 0

5960:lastCharRead:
    .word -2 # -2 => no buffered character
5964:prevHashConstant:
    .word 0x2785173c
5968:gcCount:
    .word 0

5972:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
5999:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
6022:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
6057:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
6091:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
6124:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
6155:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
6203:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
6224:gcMsg: 
      .asciiz "\nGC!\n"
6230:gcCountMsg: 
      .asciiz "Number of garbage collections: "

6262:nullStr:
    .asciiz "null"
6267:trueString:
    .asciiz "true"
6272:falseString:
    .asciiz "false"
6278:exitString:
    .ascii "Program terminated."
    #### "falls through" here
6297:newlineString:
    .asciiz "\n"
    
    .align 2
6300:stack_bottom:
    .word 0
