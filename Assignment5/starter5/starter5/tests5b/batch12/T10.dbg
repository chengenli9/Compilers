##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
344:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
344#    lw $t0,-8($s2) # get word with hash bits from this
348#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
352#    addu $t0,$t1

356#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
360:mth_equals_Object:
360#    move $t0,$s2 # first pointer (this)
364#    lw $t1,($sp) # second pointer
368#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
369##...subu $at,$t0,$t1
373##...sltiu $t0,$at,1

376#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
380:mth_hashCode_String:
380#    move $t0,$s2 # put this pointer in t0

384#    li $t2,0 # current hash value
388#    lw $t1,-4($t0) # negative of number of characters in string
392#    beq $t1,$zero,done_hashCode_String # if zero length => done
396#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
400#    and $t0,0xfffffffc # adjust for padding
401##...lui $at,65535
405##...ori $at,$at,0xfffc
409##...and $t0,$t0,$at
412#    subu $t1,$t0,$t1 # address at end of string +12
416:loop_hashCode_String:    
416#    sll $t4,$t2,5 # multiply by 32
420#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
424#    lbu $t3,-12($t0) # current character
428#    addu $t2,$t3 # add in current character
432#    addu $t0,1 # go to next character's address
436#    bne $t0,$t1,loop_hashCode_String # loop back if more
440:done_hashCode_String:    

    # push int on stack
440#    move $t0, $t2 # put $t2 in return slot
444#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
448:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
448#    subu $sp,4
452#    sw $ra,($sp)
    
    # get hash value
456#    lw $t2,-12($s2) # vtable address
460#    lw $t0,($t2) # method address
464#    jalr $t0
468#    subu $sp,8 # push result (int in $t0) on stack
472#    sw $s5,4($sp)
476#    sw $t0,($sp)

    # compute print-size of hash value
480#    li $t0, 1
484#    lw $t1, ($sp)
488#    srl $t1,$t1,4
492#    beq $t1,$zero,toString_skip_loop
496:toString_loop_top:
496#    addu $t0,1
500#    srl $t1,$t1,4
504#    bne $t1,$zero,toString_loop_top
508:toString_skip_loop:
508#    subu $sp,8
512#    sw $s5,4($sp)
516#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
520#    lw $t2,-12($s2) # vtable address
524#    move $t0,$t2
528:toString_checkTagBit:
528#    subu $t0,1
532#    lb $t1,($t0)
536#    and $t1,0x80
537##...lui $at,0
541##...ori $at,$at,0x80
545##...and $t1,$t1,$at
548#    beq $t1,$zero,toString_checkTagBit
552#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
556#    subu $sp,8
560#    sw $t1,($sp)
564#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
568#    move $s7,$zero # -4 offset header word
572#    lw $t4,8($sp) # bytes for hash value
576#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
580#    addu $t4,8
584#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
588#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

592#    li $t0,CLASS_String # store string vtable address into ...
596#    sw $t0,-12($s7) # ... -12 offset in object header
600#    lw $t2,-12($s2) # our object's vtable address
604#    lw $t5,4($sp) # number characters in prefix
608#    lw $t1,12($sp) # number of characters in hashcode
612#    addu $t3,$t1,$t5 # number of characters in string ...
616#    addu $t3,1 # ... including the '@' character
620#    subu $t0,$zero,$t3 # store negated length into ...
624#    sw $t0,-4($s7) # ... -4 offset header word
628#    lw $t0,-8($s7) # get -8 offset header-word
632#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
633##...slt $at,$t0,$zero
637##...beq $at,$zero,656
640#    and $t0,0xff # mask off object's hash value ...
641##...lui $at,0
645##...ori $at,$at,0xff
649##...and $t0,$t0,$at
652#    sw $t0,-8($s7) # ... and store back into -8 header-word
656:skipMask_toString:
656#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
660#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
664#    subu $t4,$t2,$t5
668:toString_copyLoop:    
668#    lb $t3,($t4)
672#    and $t3,0x7f # mask off sign bit (in case first word)
673##...lui $at,0
677##...ori $at,$at,0x7f
681##...and $t3,$t3,$at
684#    sb $t3,-8($t0)
688#    addu $t4,1
692#    addu $t0,1
696#    blt $t4,$t2,toString_copyLoop
697##...slt $at,$t4,$t2
701##...bne $at,$zero,668

    # copy the '@' sign
704#    li $t3,'@'
708#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
712#    addu $t2,$t0,$t1 # address of last byte in string to store +8
716#    lw $t3,20($sp) # hash code to print
720:toString_hashCopyLoop:
720#    and $t4,$t3,0xf
724#    srl $t3,4
728#    lb $t4,hexChars($t4)
732#    sb $t4,-8($t2)
736#    subu $t2,$t2,1
740#    bgt $t2,$t0,toString_hashCopyLoop
741##...slt $at,$t0,$t2
745##...bne $at,$zero,720

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
748#    addu $sp,28
752#    lw $ra,($sp)
756#    addu $sp,4
760#    move $t0, $s7 # return string we created
764#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
768:mth_equals_String:
    
    # quick test for obvious false
768#    lw $t0,($sp) # second parameter
772#    beq $t0,$zero,goEsFalse # go return false if null
776#    lw $t1,-12($t0) # vtable pointer
780#    la $t2,CLASS_String # string vtable pointer
784#    bne $t1,$t2,goEsFalse # go return false if not a string

