1468#  addu $sp, $sp, 4
1472#  addu $sp, $sp, 16
1476#  lw $ra, ($sp)
1480#  addu $sp, $sp, 4
1484#  jr $ra
##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1488:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
1488#    lw $t0,-8($s2) # get word with hash bits from this
1492#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
1496#    addu $t0,$t1

1500#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1504:mth_equals_Object:
1504#    move $t0,$s2 # first pointer (this)
1508#    lw $t1,($sp) # second pointer
1512#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
1513##...subu $at,$t0,$t1
1517##...sltiu $t0,$at,1

1520#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1524:mth_hashCode_String:
1524#    move $t0,$s2 # put this pointer in t0

1528#    li $t2,0 # current hash value
1532#    lw $t1,-4($t0) # negative of number of characters in string
1536#    beq $t1,$zero,done_hashCode_String # if zero length => done
1540#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
1544#    and $t0,0xfffffffc # adjust for padding
1545##...lui $at,65535
1549##...ori $at,$at,0xfffc
1553##...and $t0,$t0,$at
1556#    subu $t1,$t0,$t1 # address at end of string +12
1560:loop_hashCode_String:    
1560#    sll $t4,$t2,5 # multiply by 32
1564#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
1568#    lbu $t3,-12($t0) # current character
1572#    addu $t2,$t3 # add in current character
1576#    addu $t0,1 # go to next character's address
1580#    bne $t0,$t1,loop_hashCode_String # loop back if more
1584:done_hashCode_String:    

    # push int on stack
1584#    move $t0, $t2 # put $t2 in return slot
1588#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
1592:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
1592#    subu $sp,4
1596#    sw $ra,($sp)
    
    # get hash value
1600#    lw $t2,-12($s2) # vtable address
1604#    lw $t0,($t2) # method address
1608#    jalr $t0
1612#    subu $sp,8 # push result (int in $t0) on stack
1616#    sw $s5,4($sp)
1620#    sw $t0,($sp)

    # compute print-size of hash value
1624#    li $t0, 1
1628#    lw $t1, ($sp)
1632#    srl $t1,$t1,4
1636#    beq $t1,$zero,toString_skip_loop
1640:toString_loop_top:
1640#    addu $t0,1
1644#    srl $t1,$t1,4
1648#    bne $t1,$zero,toString_loop_top
1652:toString_skip_loop:
1652#    subu $sp,8
1656#    sw $s5,4($sp)
1660#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
1664#    lw $t2,-12($s2) # vtable address
1668#    move $t0,$t2
1672:toString_checkTagBit:
1672#    subu $t0,1
1676#    lb $t1,($t0)
1680#    and $t1,0x80
1681##...lui $at,0
1685##...ori $at,$at,0x80
1689##...and $t1,$t1,$at
1692#    beq $t1,$zero,toString_checkTagBit
1696#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
1700#    subu $sp,8
1704#    sw $t1,($sp)
1708#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
1712#    move $s7,$zero # -4 offset header word
1716#    lw $t4,8($sp) # bytes for hash value
1720#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
1724#    addu $t4,8
1728#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
1732#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

1736#    li $t0,CLASS_String # store string vtable address into ...
1740#    sw $t0,-12($s7) # ... -12 offset in object header
1744#    lw $t2,-12($s2) # our object's vtable address
1748#    lw $t5,4($sp) # number characters in prefix
1752#    lw $t1,12($sp) # number of characters in hashcode
1756#    addu $t3,$t1,$t5 # number of characters in string ...
1760#    addu $t3,1 # ... including the '@' character
1764#    subu $t0,$zero,$t3 # store negated length into ...
1768#    sw $t0,-4($s7) # ... -4 offset header word
1772#    lw $t0,-8($s7) # get -8 offset header-word
1776#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
1777##...slt $at,$t0,$zero
1781##...beq $at,$zero,1800
1784#    and $t0,0xff # mask off object's hash value ...
1785##...lui $at,0
1789##...ori $at,$at,0xff
1793##...and $t0,$t0,$at
1796#    sw $t0,-8($s7) # ... and store back into -8 header-word
1800:skipMask_toString:
1800#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
1804#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
1808#    subu $t4,$t2,$t5
1812:toString_copyLoop:    
1812#    lb $t3,($t4)
1816#    and $t3,0x7f # mask off sign bit (in case first word)
1817##...lui $at,0
1821##...ori $at,$at,0x7f
1825##...and $t3,$t3,$at
1828#    sb $t3,-8($t0)
1832#    addu $t4,1
1836#    addu $t0,1
1840#    blt $t4,$t2,toString_copyLoop
1841##...slt $at,$t4,$t2
1845##...bne $at,$zero,1812

    # copy the '@' sign
1848#    li $t3,'@'
1852#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
1856#    addu $t2,$t0,$t1 # address of last byte in string to store +8
1860#    lw $t3,20($sp) # hash code to print
1864:toString_hashCopyLoop:
1864#    and $t4,$t3,0xf
1868#    srl $t3,4
1872#    lb $t4,hexChars($t4)
1876#    sb $t4,-8($t2)
1880#    subu $t2,$t2,1
1884#    bgt $t2,$t0,toString_hashCopyLoop
1885##...slt $at,$t0,$t2
1889##...bne $at,$zero,1864

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
1892#    addu $sp,28
1896#    lw $ra,($sp)
1900#    addu $sp,4
1904#    move $t0, $s7 # return string we created
1908#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
1912:mth_equals_String:
    
    # quick test for obvious false
1912#    lw $t0,($sp) # second parameter
1916#    beq $t0,$zero,goEsFalse # go return false if null
1920#    lw $t1,-12($t0) # vtable pointer
1924#    la $t2,CLASS_String # string vtable pointer
1928#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
1932#    subu $sp,12
1936#    sw $ra,8($sp)
1940#    sw $s2,4($sp)
1944#    sw $t0,($sp)
1948#    jal mth_compareTo_String
1952#    lw $s2, 4($sp) #restore this pointer and pop parameters
1956#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
1960#    seq $t0,$t0,$zero
1961##...subu $at,$t0,$zero
1965##...sltiu $t0,$at,1

    # pop return address and return $t0
1968#    lw $ra,($sp)
1972#    addu $sp,4

1976#    jr $ra # return
    
1980:goEsFalse:
    # put 0 in $t0 and return
1980#    li $t0, 0
1984#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
1988:mth_toString_String:
    #we are a string, so return this.
1988#    move $t0, $s2
1992#    jr $ra

###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
1996:mth_readLine_Lib:
    
1996#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
2000#    sw $ra, 4($sp) # save $ra
2004#    move $t1,$sp # save "original" sp

2008:  doRead:

    # read the character
2008#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
2012#    subu $t2,$v0,13
2016#    bne $t2,$zero,notReturnRL
2020#    jal readLogicalChar
2024#    subu $t2,$v0,10 # check for newline
2028#    beq $t2,$zero,foundNewLine
2032#    sw $v0,lastCharRead # push back character into queue
2036#    j foundNewLine # go process the line

2040:  notReturnRL:

    # at this point, $v0 has our character

2040#    subu $t0,$v0,10
2044#    beq $t0,$zero,foundNewLine
2048#    blt $v0,$zero,foundEof
2049##...slt $at,$v0,$zero
2053##...bne $at,$zero,2068

    # we have a character, so push it onto stack
2056#    subu $sp,$sp,4
2060#    sw $v0,($sp)

    # loop back up to get next character
2064#    j doRead

2068:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
2068#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
2072#    li $s7, 0 # return-value: null
2076#    j rlReturn # return

2080:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
2080#    subu $t0,$t1,$sp # number of chars we read (times 4)
2084#    srl $s6,$t0,2 # number of words on stack with chars
2088#    subu $sp,$sp,4 # push char-count ...
2092#    sw $s6,($sp) # ... onto stack
2096#    addu $t2,$t0,5 # GC tag, incl. for count-word
2100#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
2104#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
2108#    srl $s6,$s6,2  # data words in object
2112#    move $s7,$zero # object words in object
2116#    jal newObject  # allocate space
    
    # store header words
2120#    la $t0,CLASS_String
2124#    sw $t0,-12($s7)# store class tag (String) into object
2128#    lw $t2,4($sp) # char-count
2132#    sll $t1,$t2,2 # 4 times number of chars
2136#    subu $t2,$zero,$t2 # negative of char-count
2140#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
2144#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
2148#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
2149##...slt $at,$t0,$zero
2153##...beq $at,$zero,2172
2156#    and $t0,0xff # mask off object's hash value ...
2157##...lui $at,0
2161##...ori $at,$at,0xff
2165##...and $t0,$t0,$at
2168#    sw $t0,-8($s7) # ... and store back into -8 header-word
2172:  skipMask_readLine:

2172#    sll $t0,$t0,2 # data bytes in object
2176#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
2180#    subu $t0,$t0,$t2 # place to store last character (plus 9)
2184#    addu $sp,$sp,8 # pop redundant object-pointer and count
2188#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

2192#    beq $sp,$t1,rlReturn
2196:  charCopyLoop:
2196#    lw $t2,($sp)
2200#    sb $t2,-9($t0)
2204#    addu $sp,$sp,4
2208#    subu $t0,$t0,1
2212#    bne $sp,$t1,charCopyLoop
2216:  rlReturn:

2216#    lw $ra, 4($sp)
2220#    addu $sp, 8   # pop $ra and pointless word off stack
2224#    move $t0, $s7 # return string we allocated in $s7
2228#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
2232:mth_readInt_Lib:

    # save $ra by pushing onto stack
2232#    subu $sp,$sp,4
2236#    sw $ra,($sp)

2240:  riSkipWhiteLoop:
    # read a character
2240#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
2244#    subu $t0,$v0,32
2248#    bgt $t0,$zero,nonWhite
2249##...slt $at,$zero,$t0
2253##...bne $at,$zero,2296
2256#    beq $t0,$zero,riSkipWhiteLoop # start over if space
2260#    subu $t0,$v0,10
2264#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
2268#    subu $t0,$v0,9
2272#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
2276#    subu $t0,$v0,13
2280#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
2284#    subu $t0,$v0,12
2288#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
2292#    j badIntegerFormat # illegal integer char: abort program

2296:  nonWhite:
2296#    subu $t0,$v0,'-'
2300#    li $t4,1 # final multiplier
2304#    bne $t0,$zero,helpReadInt # go read
2308#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
2312#    jal readLogicalChar

2316:  helpReadInt:
2316#    li $t2,10
2320#    subu $t1,$v0,'0' # convert digit to 0-9 value
2324#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
2325##...sltu $at,$t1,$t2
2329##...beq $at,$zero,4576
2332#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

2336:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
