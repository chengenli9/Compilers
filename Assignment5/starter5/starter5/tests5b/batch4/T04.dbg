#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1668:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
1668#    lw $t0,-8($s2) # get word with hash bits from this
1672#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
1676#    addu $t0,$t1

1680#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1684:mth_equals_Object:
1684#    move $t0,$s2 # first pointer (this)
1688#    lw $t1,($sp) # second pointer
1692#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
1693##...subu $at,$t0,$t1
1697##...sltiu $t0,$at,1

1700#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1704:mth_hashCode_String:
1704#    move $t0,$s2 # put this pointer in t0

1708#    li $t2,0 # current hash value
1712#    lw $t1,-4($t0) # negative of number of characters in string
1716#    beq $t1,$zero,done_hashCode_String # if zero length => done
1720#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
1724#    and $t0,0xfffffffc # adjust for padding
1725##...lui $at,65535
1729##...ori $at,$at,0xfffc
1733##...and $t0,$t0,$at
1736#    subu $t1,$t0,$t1 # address at end of string +12
1740:loop_hashCode_String:    
1740#    sll $t4,$t2,5 # multiply by 32
1744#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
1748#    lbu $t3,-12($t0) # current character
1752#    addu $t2,$t3 # add in current character
1756#    addu $t0,1 # go to next character's address
1760#    bne $t0,$t1,loop_hashCode_String # loop back if more
1764:done_hashCode_String:    

    # push int on stack
1764#    move $t0, $t2 # put $t2 in return slot
1768#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
1772:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
1772#    subu $sp,4
1776#    sw $ra,($sp)
    
    # get hash value
1780#    lw $t2,-12($s2) # vtable address
1784#    lw $t0,($t2) # method address
1788#    jalr $t0
1792#    subu $sp,8 # push result (int in $t0) on stack
1796#    sw $s5,4($sp)
1800#    sw $t0,($sp)

    # compute print-size of hash value
1804#    li $t0, 1
1808#    lw $t1, ($sp)
1812#    srl $t1,$t1,4
1816#    beq $t1,$zero,toString_skip_loop
1820:toString_loop_top:
1820#    addu $t0,1
1824#    srl $t1,$t1,4
1828#    bne $t1,$zero,toString_loop_top
1832:toString_skip_loop:
1832#    subu $sp,8
1836#    sw $s5,4($sp)
1840#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
1844#    lw $t2,-12($s2) # vtable address
1848#    move $t0,$t2
1852:toString_checkTagBit:
1852#    subu $t0,1
1856#    lb $t1,($t0)
1860#    and $t1,0x80
1861##...lui $at,0
1865##...ori $at,$at,0x80
1869##...and $t1,$t1,$at
1872#    beq $t1,$zero,toString_checkTagBit
1876#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
1880#    subu $sp,8
1884#    sw $t1,($sp)
1888#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
1892#    move $s7,$zero # -4 offset header word
1896#    lw $t4,8($sp) # bytes for hash value
1900#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
1904#    addu $t4,8
1908#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
1912#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

1916#    li $t0,CLASS_String # store string vtable address into ...
1920#    sw $t0,-12($s7) # ... -12 offset in object header
1924#    lw $t2,-12($s2) # our object's vtable address
1928#    lw $t5,4($sp) # number characters in prefix
1932#    lw $t1,12($sp) # number of characters in hashcode
1936#    addu $t3,$t1,$t5 # number of characters in string ...
1940#    addu $t3,1 # ... including the '@' character
1944#    subu $t0,$zero,$t3 # store negated length into ...
1948#    sw $t0,-4($s7) # ... -4 offset header word
1952#    lw $t0,-8($s7) # get -8 offset header-word
1956#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
1957##...slt $at,$t0,$zero
1961##...beq $at,$zero,1980
1964#    and $t0,0xff # mask off object's hash value ...
1965##...lui $at,0
1969##...ori $at,$at,0xff
1973##...and $t0,$t0,$at
1976#    sw $t0,-8($s7) # ... and store back into -8 header-word
1980:skipMask_toString:
1980#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
1984#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
1988#    subu $t4,$t2,$t5
1992:toString_copyLoop:    
1992#    lb $t3,($t4)
1996#    and $t3,0x7f # mask off sign bit (in case first word)
1997##...lui $at,0
2001##...ori $at,$at,0x7f
2005##...and $t3,$t3,$at
2008#    sb $t3,-8($t0)
2012#    addu $t4,1
2016#    addu $t0,1
2020#    blt $t4,$t2,toString_copyLoop
2021##...slt $at,$t4,$t2
2025##...bne $at,$zero,1992

    # copy the '@' sign
2028#    li $t3,'@'
2032#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
2036#    addu $t2,$t0,$t1 # address of last byte in string to store +8
2040#    lw $t3,20($sp) # hash code to print
2044:toString_hashCopyLoop:
2044#    and $t4,$t3,0xf
2048#    srl $t3,4
2052#    lb $t4,hexChars($t4)
2056#    sb $t4,-8($t2)
2060#    subu $t2,$t2,1
2064#    bgt $t2,$t0,toString_hashCopyLoop
2065##...slt $at,$t0,$t2
2069##...bne $at,$zero,2044

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
2072#    addu $sp,28
2076#    lw $ra,($sp)
2080#    addu $sp,4
2084#    move $t0, $s7 # return string we created
2088#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
2092:mth_equals_String:
    
    # quick test for obvious false
2092#    lw $t0,($sp) # second parameter
2096#    beq $t0,$zero,goEsFalse # go return false if null
2100#    lw $t1,-12($t0) # vtable pointer
2104#    la $t2,CLASS_String # string vtable pointer
2108#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
2112#    subu $sp,12
2116#    sw $ra,8($sp)
2120#    sw $s2,4($sp)
2124#    sw $t0,($sp)
2128#    jal mth_compareTo_String
2132#    lw $s2, 4($sp) #restore this pointer and pop parameters
2136#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
2140#    seq $t0,$t0,$zero
2141##...subu $at,$t0,$zero
2145##...sltiu $t0,$at,1

    # pop return address and return $t0
2148#    lw $ra,($sp)
2152#    addu $sp,4

2156#    jr $ra # return
    
2160:goEsFalse:
    # put 0 in $t0 and return
2160#    li $t0, 0
2164#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
2168:mth_toString_String:
    #we are a string, so return this.
2168#    move $t0, $s2
2172#    jr $ra

###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
2176:mth_readLine_Lib:
    
2176#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
2180#    sw $ra, 4($sp) # save $ra
2184#    move $t1,$sp # save "original" sp

2188:  doRead:

    # read the character
2188#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
2192#    subu $t2,$v0,13
2196#    bne $t2,$zero,notReturnRL
2200#    jal readLogicalChar
2204#    subu $t2,$v0,10 # check for newline
2208#    beq $t2,$zero,foundNewLine
2212#    sw $v0,lastCharRead # push back character into queue
2216#    j foundNewLine # go process the line

2220:  notReturnRL:

    # at this point, $v0 has our character

2220#    subu $t0,$v0,10
2224#    beq $t0,$zero,foundNewLine
2228#    blt $v0,$zero,foundEof
2229##...slt $at,$v0,$zero
2233##...bne $at,$zero,2248

    # we have a character, so push it onto stack
2236#    subu $sp,$sp,4
2240#    sw $v0,($sp)

    # loop back up to get next character
2244#    j doRead

2248:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
2248#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
2252#    li $s7, 0 # return-value: null
2256#    j rlReturn # return

2260:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
2260#    subu $t0,$t1,$sp # number of chars we read (times 4)
2264#    srl $s6,$t0,2 # number of words on stack with chars
2268#    subu $sp,$sp,4 # push char-count ...
2272#    sw $s6,($sp) # ... onto stack
2276#    addu $t2,$t0,5 # GC tag, incl. for count-word
2280#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
2284#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
2288#    srl $s6,$s6,2  # data words in object
