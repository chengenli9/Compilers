6224#    beq $sp,$t1,rlReturn
6228:  charCopyLoop:
6228#    lw $t2,($sp)
6232#    sb $t2,-9($t0)
6236#    addu $sp,$sp,4
6240#    subu $t0,$t0,1
6244#    bne $sp,$t1,charCopyLoop
6248:  rlReturn:

6248#    lw $ra, 4($sp)
6252#    addu $sp, 8   # pop $ra and pointless word off stack
6256#    move $t0, $s7 # return string we allocated in $s7
6260#    jr $ra

