###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
18260:mth_readLine_Lib:
    
18260#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
18264#    sw $ra, 4($sp) # save $ra
18268#    move $t1,$sp # save "original" sp

18272:  doRead:

    # read the character
18272#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
18276#    subu $t2,$v0,13
18280#    bne $t2,$zero,notReturnRL
18284#    jal readLogicalChar
18288#    subu $t2,$v0,10 # check for newline
18292#    beq $t2,$zero,foundNewLine
18296#    sw $v0,lastCharRead # push back character into queue
18300#    j foundNewLine # go process the line

18304:  notReturnRL:

    # at this point, $v0 has our character

18304#    subu $t0,$v0,10
18308#    beq $t0,$zero,foundNewLine
18312#    blt $v0,$zero,foundEof
18313##...slt $at,$v0,$zero
18317##...bne $at,$zero,18332

    # we have a character, so push it onto stack
18320#    subu $sp,$sp,4
18324#    sw $v0,($sp)

    # loop back up to get next character
18328#    j doRead

18332:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
18332#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
18336#    li $s7, 0 # return-value: null
18340#    j rlReturn # return

18344:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
18344#    subu $t0,$t1,$sp # number of chars we read (times 4)
18348#    srl $s6,$t0,2 # number of words on stack with chars
18352#    subu $sp,$sp,4 # push char-count ...
18356#    sw $s6,($sp) # ... onto stack
18360#    addu $t2,$t0,5 # GC tag, incl. for count-word
18364#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
18368#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
18372#    srl $s6,$s6,2  # data words in object
18376#    move $s7,$zero # object words in object
18380#    jal newObject  # allocate space
    
    # store header words
18384#    la $t0,CLASS_String
18388#    sw $t0,-12($s7)# store class tag (String) into object
18392#    lw $t2,4($sp) # char-count
18396#    sll $t1,$t2,2 # 4 times number of chars
18400#    subu $t2,$zero,$t2 # negative of char-count
18404#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
18408#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
18412#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
18413##...slt $at,$t0,$zero
18417##...beq $at,$zero,18436
18420#    and $t0,0xff # mask off object's hash value ...
18421##...lui $at,0
18425##...ori $at,$at,0xff
18429##...and $t0,$t0,$at
18432#    sw $t0,-8($s7) # ... and store back into -8 header-word
18436:  skipMask_readLine:

18436#    sll $t0,$t0,2 # data bytes in object
18440#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
18444#    subu $t0,$t0,$t2 # place to store last character (plus 9)
18448#    addu $sp,$sp,8 # pop redundant object-pointer and count
18452#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character
