    # check if we have a data array
3772#    lw $t1,-12($t2) # vtable pointer
3776#    li $t0,dataArrayVTableStart # address of vtable for first data array
3780#    blt $t1,$t0,gcNotDataArray # if data array, no more xforming to do
3781##...slt $at,$t1,$t0
3785##...bne $at,$zero,3804

    # We have a vtable address that is a data array.
    # we need skip over it then loop back to do next object.
3788:  skipToNextObj:
3788#    lw $t1,-4($t2) # data words in (object position of) array
    #### note: we know that it's not a string, so the value will
    #### not be artificially negative
3792#    sll $t1,$t1,2 # convert to byte-count
3796#    addu $t0,$t2,$t1 # skip over object
3800#    j gcTestIterDone2 # go do next object, if any

    ###################################################
    # at this point:
    # - the object has been restored to normal status--that is, the
    #   word-swap has been done
    # - $t2 contains a pointer to the object
    ###################################################
    
3804:  gcNotDataArray:
3804#    lw $t3,-4($t2) # # object words (negative treated as zero)
3808#    bge $t3,$zero,gcH2Neg2
3809##...slt $at,$t3,$zero
3813##...beq $at,$zero,3820
3816#    move $t3,$zero
3820:  gcH2Neg2:
3820#    sll $t3,$t3,2 # # object bytes
3824#    move $t0,$t2 # address of first pointer in object
3828#    add $s1,$t2,$t3 # limit address for this object

    #####################################################
    # At this point, we have to "translate" all pointers,
    # starting at $t0 to (but not including) $s1
    #####################################################

    # if there are no pointer-slots (i.e., $t0=$s1), skip this
    # part
3832#    beq $t0,$s1,gcTestIterDone2
    
3836:  gcNextPointerInObject:
    # get pointer from object
3836#    lw $t1,($t0)

    # if value is out of range, and is therefore does not refer
    # to an object, just go loop back and do the next one
3840#    bleu $t1,$t6,gcGoNextPointerSlot
3841##...sltu $at,$t6,$t1
3845##...beq $at,$zero,3988
3848#    bgtu $t1,$t7,gcGoNextPointerSlot
3849##...sltu $at,$t7,$t1
3853##...bne $at,$zero,3988

    # if the object has already been moved, update the stack-value
    # via the forwarding pointer
3856#    lw $t8,-8($t1) # possible forwarding tag
3860#    bne $t8,$zero,gcNoForward2 # if not forwarding tag, go copy
3864#    lw $t8,-4($t1) # forwarding pointer: object's new address
3868#    sw $t8,($t0) # update pointer in object
3872#    j gcGoNextPointerSlot # do next iteration

3876:  gcNoForward2:
    #########################################################
    # we actually need to copy the object into the new space
    #########################################################

    #########################################################
    # At this point:
    # - $t0 contains the address of the heap-slot we're translating
    # - $t1 will contain the contents of the heap-slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space, which will also be the first address
    #   of the target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # Then during processing:
    # And when we're actually copying an object:
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $t8 will contain a pointer to the target object
    # - available for use: $s0, $t8, $t9
    ##########################################################

    # compute the amount of space that is needed
3876#    bge $t8,$zero,gcSkip5 # # words in negative-offset portion
3877##...slt $at,$t8,$zero
3881##...beq $at,$zero,3896
3884#    and $t8,0xff # mask off hash bits
3885##...lui $at,0
3889##...ori $at,$at,0xff
3893##...and $t8,$t8,$at

3896:  gcSkip5:
3896#    sll $t8,$t8,2 # bytes in negative-offset portion ...
3900#    addu $t8,$t8,8 # ... add in bytes for header-words
3904#    subu $t4,$t1,$t8 # address of first word of source object
3908#    lw $t3,-4($t1) # # words in positive-offset portion
3912#    bge $t3,$zero,gcNoNeg
3913##...slt $at,$t3,$zero
3917##...beq $at,$zero,3924
3920#    move $t3,$zero # negative treated as zero
3924:  gcNoNeg:
3924#    sll $t3,$t3,2 # bytes in negative-offset portion
3928#    addu $t3,$t3,$t1 # address one word past last word of source

3932#    addu $t8,$s3,$t8 # pointer to target object

    #########################################################
    # At this point:
    # - $t0 contains the address of the stack slot we'll
    #   process next
    # - $t1 contains the contents of the stack slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $t8 contains the pointer to the target object
    # - $s1 contains the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0, $t9
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger"
3936#    lw $s0,($t4)
3940#    lw $t9,-8($t1)
3944#    sw $t9,($t4)
3948#    sw $s0,-8($t1)

    # copy all source bytes to the target
3952:  gCinnerCopy2:
3952#    lw $s0,($t4)
3956#    sw $s0,($s3)
3960#    addu $t4,$t4,4
3964#    addu $s3,$s3,4
3968#    bltu $t4,$t3,gCinnerCopy2
3969##...sltu $at,$t4,$t3
3973##...bne $at,$zero,3952

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
3976#    sw $zero,-8($t1) # 0 in first header-slot
3980#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
3984#    sw $t8,($t0)

3988:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
3988#    addu $t0,$t0,4
3992#    bltu $t0,$s1,gcNextPointerInObject
3993##...sltu $at,$t0,$s1
3997##...bne $at,$zero,3836

4000:  gcTestIterDone2:
4000#    bltu $t0,$s3,gcHeapCopyLoop
4001##...sltu $at,$t0,$s3
4005##...bne $at,$zero,3720

    ###### end outer loop to copy all non-stack-direct objects ######

4008:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
4008#    lw $s2,($sp)
4012#    addu $sp,$sp,4

    # mark us as having already GC'd
4016#    move $t5,$s5

    # go try and allocate again
4020#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
4024:vm_init:

    # mark bottom of stack
4024#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
4028#    move $s2,$zero

    #set up the "five" register
4032#    li $s5,5

4036#    la $s3,seg0_start
4040#    la $s4,seg0_end
4041##...lui $s4,16
4045##...addiu $s4,$s4,4932
    
    # return
4048#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4052:divide:
    # get parameters; abort if divisor zero
4052#    lw $t0,($sp)
4056#    lw $t1,8($sp)
4060#    beq $t0,$zero,divByZeroError
    
    # perform division
4064#    div $t1,$t0
4068#    mflo $t0

    # store result, adjust stack and return
4072#    addu $sp,$sp,8 # adjust stack
4076#    sw $t0,($sp) # store result
4080#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4084:remainder:
    # get parameters; abort if divisor zero
4084#    lw $t0,($sp)
4088#    lw $t1,8($sp)
4092#    beq $t0,$zero,divByZeroError
    
    # perform division
4096#    div $t1,$t0
4100#    mfhi $t0

    # store result, adjust stack and return
4104#    addu $sp,$sp,8 # adjust stack
4108#    sw $t0,($sp) # store result
4112#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
4116:checkCast:
    # get object, allow immediately if null
4116#    lw $t2,($sp)
4120#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
4124#    lw $t2,-12($t2) # vtable address
4128#    bge $t2,$t1,castException
4129##...slt $at,$t2,$t1
4133##...beq $at,$zero,4304
4136#    blt $t2,$t0,castException
4137##...slt $at,$t2,$t0
4141##...bne $at,$zero,4304
    
    # return, leaving object unchanged on stack
4144:  checkCastReturn:    
4144#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
4148:instanceOf:
    # get object, go return false if null
4148#    lw $t2,($sp)
4152#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
4156#    lw $t2,-12($t2) # vtable address
4160#    sge $t0,$t2,$t0 # are we >= the lower limit?
4161##...slt $t0,$t2,$t0
4165##...xori $t0,$t0,0x1
4168#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
4172#    and $t2,$t0,$t1
4176#    sw $t2,($sp)
4180:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
4180#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

4184:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
4184#    li $v0,4 # syscall-code for print-string
4188#    syscall
4192:exit:
    # print termination message
4192#    li $v0,4 # syscall-code for print-string
4196#    la $a0,exitString
4200#    syscall

    # print number of garbage collections
4204#    li $v0,4 # syscall-code for print-string
4208#    la $a0,gcCountMsg
4212#    syscall # print "Number of ..."
4216#    lw $a0,gcCount # number of GC's
4220#    li $v0,1 # code for print-int
4224#    syscall
4228#    li $v0,4 # syscall-code for print-string
4232#    la $a0,newlineString
4236#    syscall # print newline

    # terminate execution
4240#    li $v0,10 #syscall-code for "exit"
4244#    syscall

4248:outOfHeapMemory:
4248#    la $a0,heapMemoryMsg
4252#    j exitError
4256:divByZeroError:
4256#    la $a0,divByZeroMsg
4260#    j exitError
4264:strIndexOutOfBounds:
4264#    la $a0,strIndexOutOfBoundsMsg
4268#    j exitError
4272:arrayIndexOutOfBounds:
4272#    la $a0,arrayIndexOutOfBoundsMsg
4276#    j exitError
4280:arraySizeOutOfBounds:
4280#    la $a0,arraySizeOutOfBoundsMsg
4284#    j exitError
4288:nullPtrException:
4288#    la $a0,nullPtrExceptionMsg
4292#    j exitError
4296:badIntegerFormat:
4296#    la $a0,badIntegerFormatMsg
4300#    j exitError
4304:castException:
4304#    la $a0,castExceptionMsg
4308#    j exitError
############## data section ################
    .data
4560:hexChars:
    .ascii "0123456789abcdef"
    .align 2
4576:cur_seg:
    .word 0

4580:lastCharRead:
    .word -2 # -2 => no buffered character
4584:prevHashConstant:
    .word 0x2785173c
4588:gcCount:
    .word 0

4592:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
4619:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
4642:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
4677:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
4711:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
4744:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
4775:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
4823:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
4844:gcMsg: 
      .asciiz "\nGC!\n"
4850:gcCountMsg: 
      .asciiz "Number of garbage collections: "

4882:nullStr:
    .asciiz "null"
4887:trueString:
    .asciiz "true"
4892:falseString:
    .asciiz "false"
4898:exitString:
    .ascii "Program execution completed."
    #### "falls through" here
4926:newlineString:
    .asciiz "\n"
    
    .align 2
4928:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

4932:seg0_start:
    .space 0x100000
1053508:seg0_end:
1053508:seg1_start:
    .space 0x100000
2102084:seg1_end:
