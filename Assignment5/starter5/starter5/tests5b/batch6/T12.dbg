##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1144:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
1144#    lw $t0,-8($s2) # get word with hash bits from this
1148#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
1152#    addu $t0,$t1

1156#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1160:mth_equals_Object:
1160#    move $t0,$s2 # first pointer (this)
1164#    lw $t1,($sp) # second pointer
1168#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
1169##...subu $at,$t0,$t1
1173##...sltiu $t0,$at,1

1176#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1180:mth_hashCode_String:
1180#    move $t0,$s2 # put this pointer in t0

1184#    li $t2,0 # current hash value
1188#    lw $t1,-4($t0) # negative of number of characters in string
1192#    beq $t1,$zero,done_hashCode_String # if zero length => done
1196#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
1200#    and $t0,0xfffffffc # adjust for padding
1201##...lui $at,65535
1205##...ori $at,$at,0xfffc
1209##...and $t0,$t0,$at
1212#    subu $t1,$t0,$t1 # address at end of string +12
1216:loop_hashCode_String:    
1216#    sll $t4,$t2,5 # multiply by 32
1220#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
1224#    lbu $t3,-12($t0) # current character
1228#    addu $t2,$t3 # add in current character
1232#    addu $t0,1 # go to next character's address
1236#    bne $t0,$t1,loop_hashCode_String # loop back if more
1240:done_hashCode_String:    

    # push int on stack
1240#    move $t0, $t2 # put $t2 in return slot
1244#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
1248:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
1248#    subu $sp,4
1252#    sw $ra,($sp)
    
    # get hash value
1256#    lw $t2,-12($s2) # vtable address
1260#    lw $t0,($t2) # method address
1264#    jalr $t0
1268#    subu $sp,8 # push result (int in $t0) on stack
1272#    sw $s5,4($sp)
1276#    sw $t0,($sp)

    # compute print-size of hash value
1280#    li $t0, 1
1284#    lw $t1, ($sp)
1288#    srl $t1,$t1,4
1292#    beq $t1,$zero,toString_skip_loop
1296:toString_loop_top:
1296#    addu $t0,1
1300#    srl $t1,$t1,4
1304#    bne $t1,$zero,toString_loop_top
1308:toString_skip_loop:
1308#    subu $sp,8
1312#    sw $s5,4($sp)
1316#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
1320#    lw $t2,-12($s2) # vtable address
1324#    move $t0,$t2
1328:toString_checkTagBit:
1328#    subu $t0,1
1332#    lb $t1,($t0)
1336#    and $t1,0x80
1337##...lui $at,0
1341##...ori $at,$at,0x80
1345##...and $t1,$t1,$at
1348#    beq $t1,$zero,toString_checkTagBit
1352#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
1356#    subu $sp,8
1360#    sw $t1,($sp)
1364#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
1368#    move $s7,$zero # -4 offset header word
1372#    lw $t4,8($sp) # bytes for hash value
1376#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
1380#    addu $t4,8
1384#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
1388#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

1392#    li $t0,CLASS_String # store string vtable address into ...
1396#    sw $t0,-12($s7) # ... -12 offset in object header
1400#    lw $t2,-12($s2) # our object's vtable address
1404#    lw $t5,4($sp) # number characters in prefix
1408#    lw $t1,12($sp) # number of characters in hashcode
1412#    addu $t3,$t1,$t5 # number of characters in string ...
1416#    addu $t3,1 # ... including the '@' character
1420#    subu $t0,$zero,$t3 # store negated length into ...
1424#    sw $t0,-4($s7) # ... -4 offset header word
1428#    lw $t0,-8($s7) # get -8 offset header-word
1432#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
1433##...slt $at,$t0,$zero
1437##...beq $at,$zero,1456
1440#    and $t0,0xff # mask off object's hash value ...
1441##...lui $at,0
1445##...ori $at,$at,0xff
1449##...and $t0,$t0,$at
1452#    sw $t0,-8($s7) # ... and store back into -8 header-word
1456:skipMask_toString:
1456#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
1460#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
1464#    subu $t4,$t2,$t5
1468:toString_copyLoop:    
1468#    lb $t3,($t4)
1472#    and $t3,0x7f # mask off sign bit (in case first word)
1473##...lui $at,0
1477##...ori $at,$at,0x7f
1481##...and $t3,$t3,$at
1484#    sb $t3,-8($t0)
1488#    addu $t4,1
1492#    addu $t0,1
1496#    blt $t4,$t2,toString_copyLoop
1497##...slt $at,$t4,$t2
1501##...bne $at,$zero,1468

    # copy the '@' sign
1504#    li $t3,'@'
1508#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
1512#    addu $t2,$t0,$t1 # address of last byte in string to store +8
1516#    lw $t3,20($sp) # hash code to print
1520:toString_hashCopyLoop:
1520#    and $t4,$t3,0xf
1524#    srl $t3,4
1528#    lb $t4,hexChars($t4)
1532#    sb $t4,-8($t2)
1536#    subu $t2,$t2,1
1540#    bgt $t2,$t0,toString_hashCopyLoop
1541##...slt $at,$t0,$t2
1545##...bne $at,$zero,1520

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
1548#    addu $sp,28
1552#    lw $ra,($sp)
1556#    addu $sp,4
1560#    move $t0, $s7 # return string we created
1564#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
1568:mth_equals_String:
    
    # quick test for obvious false
1568#    lw $t0,($sp) # second parameter
1572#    beq $t0,$zero,goEsFalse # go return false if null
1576#    lw $t1,-12($t0) # vtable pointer
1580#    la $t2,CLASS_String # string vtable pointer
1584#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
1588#    subu $sp,12
1592#    sw $ra,8($sp)
1596#    sw $s2,4($sp)
1600#    sw $t0,($sp)
1604#    jal mth_compareTo_String
1608#    lw $s2, 4($sp) #restore this pointer and pop parameters
1612#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
1616#    seq $t0,$t0,$zero
1617##...subu $at,$t0,$zero
1621##...sltiu $t0,$at,1

    # pop return address and return $t0
1624#    lw $ra,($sp)
1628#    addu $sp,4

1632#    jr $ra # return
    
1636:goEsFalse:
    # put 0 in $t0 and return
1636#    li $t0, 0
1640#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
1644:mth_toString_String:
    #we are a string, so return this.
1644#    move $t0, $s2
1648#    jr $ra

###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
1652:mth_readLine_Lib:
    
1652#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
1656#    sw $ra, 4($sp) # save $ra
1660#    move $t1,$sp # save "original" sp

1664:  doRead:

    # read the character
1664#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
1668#    subu $t2,$v0,13
1672#    bne $t2,$zero,notReturnRL
1676#    jal readLogicalChar
1680#    subu $t2,$v0,10 # check for newline
1684#    beq $t2,$zero,foundNewLine
1688#    sw $v0,lastCharRead # push back character into queue
1692#    j foundNewLine # go process the line

1696:  notReturnRL:

    # at this point, $v0 has our character

1696#    subu $t0,$v0,10
1700#    beq $t0,$zero,foundNewLine
1704#    blt $v0,$zero,foundEof
1705##...slt $at,$v0,$zero
1709##...bne $at,$zero,1724

    # we have a character, so push it onto stack
1712#    subu $sp,$sp,4
1716#    sw $v0,($sp)

    # loop back up to get next character
1720#    j doRead

1724:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
1724#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
1728#    li $s7, 0 # return-value: null
1732#    j rlReturn # return

1736:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
1736#    subu $t0,$t1,$sp # number of chars we read (times 4)
1740#    srl $s6,$t0,2 # number of words on stack with chars
1744#    subu $sp,$sp,4 # push char-count ...
1748#    sw $s6,($sp) # ... onto stack
1752#    addu $t2,$t0,5 # GC tag, incl. for count-word
1756#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
1760#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
1764#    srl $s6,$s6,2  # data words in object
1768#    move $s7,$zero # object words in object
1772#    jal newObject  # allocate space
    
    # store header words
1776#    la $t0,CLASS_String
1780#    sw $t0,-12($s7)# store class tag (String) into object
1784#    lw $t2,4($sp) # char-count
1788#    sll $t1,$t2,2 # 4 times number of chars
1792#    subu $t2,$zero,$t2 # negative of char-count
1796#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
1800#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
1804#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
1805##...slt $at,$t0,$zero
1809##...beq $at,$zero,1828
1812#    and $t0,0xff # mask off object's hash value ...
1813##...lui $at,0
1817##...ori $at,$at,0xff
1821##...and $t0,$t0,$at
1824#    sw $t0,-8($s7) # ... and store back into -8 header-word
1828:  skipMask_readLine:

1828#    sll $t0,$t0,2 # data bytes in object
1832#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
1836#    subu $t0,$t0,$t2 # place to store last character (plus 9)
1840#    addu $sp,$sp,8 # pop redundant object-pointer and count
1844#    addu $t1,$t1,$sp # first non-char spot on stack
