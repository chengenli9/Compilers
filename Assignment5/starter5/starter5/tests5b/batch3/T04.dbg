    # store String vtable address in vtable address field
3784#    la $t0,CLASS_String
3788#    sw $t0,-12($s7)
        
    # mask off hash bits, if needed
3792#    lw $t4,-8($s7) # # data words in source string
3796#    bge $t4,$zero,skipMask_concat # don't strip hash code if not there
3797##...slt $at,$t4,$zero
3801##...beq $at,$zero,3820
3804#    and $t4,0xff # mask off object's hash value ...
3805##...lui $at,0
3809##...ori $at,$at,0xff
