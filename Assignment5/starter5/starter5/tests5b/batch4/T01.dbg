###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
3008:mth_readLine_Lib:
    
3008#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
3012#    sw $ra, 4($sp) # save $ra
3016#    move $t1,$sp # save "original" sp

3020:  doRead:

    # read the character
3020#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
3024#    subu $t2,$v0,13
3028#    bne $t2,$zero,notReturnRL
3032#    jal readLogicalChar
3036#    subu $t2,$v0,10 # check for newline
3040#    beq $t2,$zero,foundNewLine
3044#    sw $v0,lastCharRead # push back character into queue
3048#    j foundNewLine # go process the line

3052:  notReturnRL:

    # at this point, $v0 has our character

3052#    subu $t0,$v0,10
3056#    beq $t0,$zero,foundNewLine
3060#    blt $v0,$zero,foundEof
3061##...slt $at,$v0,$zero
3065##...bne $at,$zero,3080

    # we have a character, so push it onto stack
3068#    subu $sp,$sp,4
3072#    sw $v0,($sp)

    # loop back up to get next character
3076#    j doRead

3080:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
3080#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
3084#    li $s7, 0 # return-value: null
3088#    j rlReturn # return

3092:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
3092#    subu $t0,$t1,$sp # number of chars we read (times 4)
3096#    srl $s6,$t0,2 # number of words on stack with chars
3100#    subu $sp,$sp,4 # push char-count ...
3104#    sw $s6,($sp) # ... onto stack
3108#    addu $t2,$t0,5 # GC tag, incl. for count-word
3112#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
3116#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
3120#    srl $s6,$s6,2  # data words in object
3124#    move $s7,$zero # object words in object
3128#    jal newObject  # allocate space
    
    # store header words
3132#    la $t0,CLASS_String
3136#    sw $t0,-12($s7)# store class tag (String) into object
3140#    lw $t2,4($sp) # char-count
3144#    sll $t1,$t2,2 # 4 times number of chars
3148#    subu $t2,$zero,$t2 # negative of char-count
3152#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
3156#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
3160#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
3161##...slt $at,$t0,$zero
3165##...beq $at,$zero,3184
3168#    and $t0,0xff # mask off object's hash value ...
3169##...lui $at,0
3173##...ori $at,$at,0xff
3177##...and $t0,$t0,$at
3180#    sw $t0,-8($s7) # ... and store back into -8 header-word
3184:  skipMask_readLine:

3184#    sll $t0,$t0,2 # data bytes in object
3188#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
3192#    subu $t0,$t0,$t2 # place to store last character (plus 9)
3196#    addu $sp,$sp,8 # pop redundant object-pointer and count
3200#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

3204#    beq $sp,$t1,rlReturn
3208:  charCopyLoop:
3208#    lw $t2,($sp)
3212#    sb $t2,-9($t0)
3216#    addu $sp,$sp,4
3220#    subu $t0,$t0,1
3224#    bne $sp,$t1,charCopyLoop
3228:  rlReturn:

3228#    lw $ra, 4($sp)
3232#    addu $sp, 8   # pop $ra and pointless word off stack
3236#    move $t0, $s7 # return string we allocated in $s7
3240#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
3244:mth_readInt_Lib:

    # save $ra by pushing onto stack
3244#    subu $sp,$sp,4
3248#    sw $ra,($sp)
