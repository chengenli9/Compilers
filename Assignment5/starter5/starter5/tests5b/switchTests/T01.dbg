##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
488:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
488#    lw $t0,-8($s2) # get word with hash bits from this
492#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
496#    addu $t0,$t1

500#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
504:mth_equals_Object:
504#    move $t0,$s2 # first pointer (this)
508#    lw $t1,($sp) # second pointer
512#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
513##...subu $at,$t0,$t1
517##...sltiu $t0,$at,1

520#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
524:mth_hashCode_String:
524#    move $t0,$s2 # put this pointer in t0

528#    li $t2,0 # current hash value
532#    lw $t1,-4($t0) # negative of number of characters in string
536#    beq $t1,$zero,done_hashCode_String # if zero length => done
540#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
544#    and $t0,0xfffffffc # adjust for padding
545##...lui $at,65535
549##...ori $at,$at,0xfffc
553##...and $t0,$t0,$at
556#    subu $t1,$t0,$t1 # address at end of string +12
560:loop_hashCode_String:    
560#    sll $t4,$t2,5 # multiply by 32
564#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
568#    lbu $t3,-12($t0) # current character
572#    addu $t2,$t3 # add in current character
576#    addu $t0,1 # go to next character's address
580#    bne $t0,$t1,loop_hashCode_String # loop back if more
584:done_hashCode_String:    

    # push int on stack
584#    move $t0, $t2 # put $t2 in return slot
588#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
592:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
592#    subu $sp,4
596#    sw $ra,($sp)
    
    # get hash value
600#    lw $t2,-12($s2) # vtable address
604#    lw $t0,($t2) # method address
608#    jalr $t0
612#    subu $sp,8 # push result (int in $t0) on stack
616#    sw $s5,4($sp)
620#    sw $t0,($sp)

    # compute print-size of hash value
624#    li $t0, 1
628#    lw $t1, ($sp)
632#    srl $t1,$t1,4
636#    beq $t1,$zero,toString_skip_loop
640:toString_loop_top:
640#    addu $t0,1
644#    srl $t1,$t1,4
648#    bne $t1,$zero,toString_loop_top
652:toString_skip_loop:
652#    subu $sp,8
656#    sw $s5,4($sp)
660#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
664#    lw $t2,-12($s2) # vtable address
668#    move $t0,$t2
672:toString_checkTagBit:
672#    subu $t0,1
676#    lb $t1,($t0)
680#    and $t1,0x80
681##...lui $at,0
685##...ori $at,$at,0x80
689##...and $t1,$t1,$at
692#    beq $t1,$zero,toString_checkTagBit
696#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
700#    subu $sp,8
704#    sw $t1,($sp)
708#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
712#    move $s7,$zero # -4 offset header word
716#    lw $t4,8($sp) # bytes for hash value
720#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
724#    addu $t4,8
728#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
732#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

736#    li $t0,CLASS_String # store string vtable address into ...
740#    sw $t0,-12($s7) # ... -12 offset in object header
744#    lw $t2,-12($s2) # our object's vtable address
748#    lw $t5,4($sp) # number characters in prefix
752#    lw $t1,12($sp) # number of characters in hashcode
756#    addu $t3,$t1,$t5 # number of characters in string ...
760#    addu $t3,1 # ... including the '@' character
764#    subu $t0,$zero,$t3 # store negated length into ...
768#    sw $t0,-4($s7) # ... -4 offset header word
772#    lw $t0,-8($s7) # get -8 offset header-word
776#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
777##...slt $at,$t0,$zero
781##...beq $at,$zero,800
784#    and $t0,0xff # mask off object's hash value ...
785##...lui $at,0
789##...ori $at,$at,0xff
793##...and $t0,$t0,$at
796#    sw $t0,-8($s7) # ... and store back into -8 header-word
800:skipMask_toString:
800#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
804#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
808#    subu $t4,$t2,$t5
812:toString_copyLoop:    
812#    lb $t3,($t4)
816#    and $t3,0x7f # mask off sign bit (in case first word)
817##...lui $at,0
821##...ori $at,$at,0x7f
825##...and $t3,$t3,$at
828#    sb $t3,-8($t0)
832#    addu $t4,1
836#    addu $t0,1
840#    blt $t4,$t2,toString_copyLoop
841##...slt $at,$t4,$t2
845##...bne $at,$zero,812

    # copy the '@' sign
848#    li $t3,'@'
852#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
