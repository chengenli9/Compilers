    # return value is 1 iff result is 0; else 0
1032#    seq $t0,$t0,$zero
1033##...subu $at,$t0,$zero
1037##...sltiu $t0,$at,1

    # pop return address and return $t0
1040#    lw $ra,($sp)
1044#    addu $sp,4

1048#    jr $ra # return
    
1052:goEsFalse:
    # put 0 in $t0 and return
1052#    li $t0, 0
1056#    jr $ra # return
