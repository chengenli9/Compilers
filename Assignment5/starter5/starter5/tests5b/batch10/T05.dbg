
    # determine if we have enough memory available
5752#    addu $t0,$s6,$s7
5756#    sll $t0,$t0,2
5760#    addu $t0,$t0,8 # amount of memory needed
5764#    addu $t1,$t0,$s3
5768#    bgtu $t1,$s4,doGC
