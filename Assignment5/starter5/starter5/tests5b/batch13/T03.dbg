###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
1008:mth_equals_String:
    
    # quick test for obvious false
1008#    lw $t0,($sp) # second parameter
1012#    beq $t0,$zero,goEsFalse # go return false if null
1016#    lw $t1,-12($t0) # vtable pointer
1020#    la $t2,CLASS_String # string vtable pointer
1024#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
1028#    subu $sp,12
1032#    sw $ra,8($sp)
1036#    sw $s2,4($sp)
1040#    sw $t0,($sp)
1044#    jal mth_compareTo_String
1048#    lw $s2, 4($sp) #restore this pointer and pop parameters
1052#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
1056#    seq $t0,$t0,$zero
1057##...subu $at,$t0,$zero
1061##...sltiu $t0,$at,1

    # pop return address and return $t0
1064#    lw $ra,($sp)
1068#    addu $sp,4

1072#    jr $ra # return
    
1076:goEsFalse:
    # put 0 in $t0 and return
1076#    li $t0, 0
1080#    jr $ra # return

