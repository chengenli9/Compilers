    #   object that tells where the pointers in the object end
    # - $t8 will contain a pointer to the target object
    # - available for use: $s0, $t8, $t9
    ##########################################################

    # compute the amount of space that is needed
12444#    bge $t8,$zero,gcSkip5 # # words in negative-offset portion
12445##...slt $at,$t8,$zero
12449##...beq $at,$zero,12464
12452#    and $t8,0xff # mask off hash bits
12453##...lui $at,0
12457##...ori $at,$at,0xff
12461##...and $t8,$t8,$at

12464:  gcSkip5:
12464#    sll $t8,$t8,2 # bytes in negative-offset portion ...
12468#    addu $t8,$t8,8 # ... add in bytes for header-words
12472#    subu $t4,$t1,$t8 # address of first word of source object
12476#    lw $t3,-4($t1) # # words in positive-offset portion
12480#    bge $t3,$zero,gcNoNeg
12481##...slt $at,$t3,$zero
12485##...beq $at,$zero,12492
12488#    move $t3,$zero # negative treated as zero
12492:  gcNoNeg:
12492#    sll $t3,$t3,2 # bytes in negative-offset portion
12496#    addu $t3,$t3,$t1 # address one word past last word of source

12500#    addu $t8,$s3,$t8 # pointer to target object

    #########################################################
    # At this point:
    # - $t0 contains the address of the stack slot we'll
    #   process next
    # - $t1 contains the contents of the stack slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $t8 contains the pointer to the target object
    # - $s1 contains the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0, $t9
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger"
12504#    lw $s0,($t4)
12508#    lw $t9,-8($t1)
12512#    sw $t9,($t4)
12516#    sw $s0,-8($t1)

    # copy all source bytes to the target
12520:  gCinnerCopy2:
12520#    lw $s0,($t4)
12524#    sw $s0,($s3)
12528#    addu $t4,$t4,4
12532#    addu $s3,$s3,4
12536#    bltu $t4,$t3,gCinnerCopy2
12537##...sltu $at,$t4,$t3
12541##...bne $at,$zero,12520

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
12544#    sw $zero,-8($t1) # 0 in first header-slot
12548#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
12552#    sw $t8,($t0)

12556:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
12556#    addu $t0,$t0,4
12560#    bltu $t0,$s1,gcNextPointerInObject
12561##...sltu $at,$t0,$s1
12565##...bne $at,$zero,12404

12568:  gcTestIterDone2:
12568#    bltu $t0,$s3,gcHeapCopyLoop
12569##...sltu $at,$t0,$s3
12573##...bne $at,$zero,12288

    ###### end outer loop to copy all non-stack-direct objects ######

12576:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
12576#    lw $s2,($sp)
12580#    addu $sp,$sp,4

    # mark us as having already GC'd
12584#    move $t5,$s5

    # go try and allocate again
12588#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
12592:vm_init:

    # mark bottom of stack
12592#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
12596#    move $s2,$zero

    #set up the "five" register
12600#    li $s5,5

12604#    la $s3,seg0_start
12608#    la $s4,seg0_end
12609##...lui $s4,16
12613##...addiu $s4,$s4,15136
    
    # return
12616#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
12620:divide:
    # get parameters; abort if divisor zero
12620#    lw $t0,($sp)
12624#    lw $t1,8($sp)
12628#    beq $t0,$zero,divByZeroError
    
    # perform division
12632#    div $t1,$t0
12636#    mflo $t0

    # store result, adjust stack and return
12640#    addu $sp,$sp,8 # adjust stack
12644#    sw $t0,($sp) # store result
12648#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
12652:remainder:
    # get parameters; abort if divisor zero
12652#    lw $t0,($sp)
12656#    lw $t1,8($sp)
12660#    beq $t0,$zero,divByZeroError
    
    # perform division
12664#    div $t1,$t0
12668#    mfhi $t0

    # store result, adjust stack and return
12672#    addu $sp,$sp,8 # adjust stack
12676#    sw $t0,($sp) # store result
12680#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
12684:checkCast:
    # get object, allow immediately if null
12684#    lw $t2,($sp)
12688#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
12692#    lw $t2,-12($t2) # vtable address
12696#    bge $t2,$t1,castException
12697##...slt $at,$t2,$t1
12701##...beq $at,$zero,12872
12704#    blt $t2,$t0,castException
12705##...slt $at,$t2,$t0
12709##...bne $at,$zero,12872
    
    # return, leaving object unchanged on stack
12712:  checkCastReturn:    
12712#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
12716:instanceOf:
    # get object, go return false if null
12716#    lw $t2,($sp)
12720#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
12724#    lw $t2,-12($t2) # vtable address
12728#    sge $t0,$t2,$t0 # are we >= the lower limit?
12729##...slt $t0,$t2,$t0
12733##...xori $t0,$t0,0x1
12736#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
12740#    and $t2,$t0,$t1
12744#    sw $t2,($sp)
12748:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
12748#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

12752:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
12752#    li $v0,4 # syscall-code for print-string
12756#    syscall
12760:exit:
    # print termination message
12760#    li $v0,4 # syscall-code for print-string
12764#    la $a0,exitString
12768#    syscall

    # print number of garbage collections
12772#    li $v0,4 # syscall-code for print-string
12776#    la $a0,gcCountMsg
12780#    syscall # print "Number of ..."
12784#    lw $a0,gcCount # number of GC's
12788#    li $v0,1 # code for print-int
12792#    syscall
12796#    li $v0,4 # syscall-code for print-string
12800#    la $a0,newlineString
12804#    syscall # print newline

    # terminate execution
12808#    li $v0,10 #syscall-code for "exit"
12812#    syscall

12816:outOfHeapMemory:
12816#    la $a0,heapMemoryMsg
12820#    j exitError
12824:divByZeroError:
12824#    la $a0,divByZeroMsg
12828#    j exitError
12832:strIndexOutOfBounds:
12832#    la $a0,strIndexOutOfBoundsMsg
12836#    j exitError
12840:arrayIndexOutOfBounds:
12840#    la $a0,arrayIndexOutOfBoundsMsg
12844#    j exitError
12848:arraySizeOutOfBounds:
12848#    la $a0,arraySizeOutOfBoundsMsg
12852#    j exitError
12856:nullPtrException:
12856#    la $a0,nullPtrExceptionMsg
12860#    j exitError
12864:badIntegerFormat:
12864#    la $a0,badIntegerFormatMsg
12868#    j exitError
12872:castException:
12872#    la $a0,castExceptionMsg
12876#    j exitError
############## data section ################
    .data
14764:hexChars:
    .ascii "0123456789abcdef"
    .align 2
14780:cur_seg:
    .word 0

14784:lastCharRead:
    .word -2 # -2 => no buffered character
14788:prevHashConstant:
    .word 0x2785173c
14792:gcCount:
    .word 0

14796:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
14823:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
14846:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
14881:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
14915:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
14948:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
14979:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
15027:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
15048:gcMsg: 
      .asciiz "\nGC!\n"
15054:gcCountMsg: 
      .asciiz "Number of garbage collections: "

15086:nullStr:
    .asciiz "null"
15091:trueString:
    .asciiz "true"
15096:falseString:
    .asciiz "false"
15102:exitString:
    .ascii "Program execution completed."
    #### "falls through" here
15130:newlineString:
    .asciiz "\n"
    
    .align 2
15132:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

15136:seg0_start:
    .space 0x100000
1063712:seg0_end:
1063712:seg1_start:
    .space 0x100000
2112288:seg1_end:
