1312#    seq $t0,$t0,$zero
1313##...subu $at,$t0,$zero
1317##...sltiu $t0,$at,1

    # pop return address and return $t0
1320#    lw $ra,($sp)
1324#    addu $sp,4

1328#    jr $ra # return
    
1332:goEsFalse:
    # put 0 in $t0 and return
1332#    li $t0, 0
1336#    jr $ra # return
