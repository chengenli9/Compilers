###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
904:mth_readLine_Lib:
    
904#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
908#    sw $ra, 4($sp) # save $ra
912#    move $t1,$sp # save "original" sp

916:  doRead:

    # read the character
916#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
920#    subu $t2,$v0,13
924#    bne $t2,$zero,notReturnRL
928#    jal readLogicalChar
932#    subu $t2,$v0,10 # check for newline
936#    beq $t2,$zero,foundNewLine
940#    sw $v0,lastCharRead # push back character into queue
944#    j foundNewLine # go process the line

948:  notReturnRL:

    # at this point, $v0 has our character

948#    subu $t0,$v0,10
952#    beq $t0,$zero,foundNewLine
956#    blt $v0,$zero,foundEof
957##...slt $at,$v0,$zero
961##...bne $at,$zero,976

    # we have a character, so push it onto stack
964#    subu $sp,$sp,4
968#    sw $v0,($sp)

    # loop back up to get next character
972#    j doRead

976:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
976#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
980#    li $s7, 0 # return-value: null
984#    j rlReturn # return

988:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
988#    subu $t0,$t1,$sp # number of chars we read (times 4)
992#    srl $s6,$t0,2 # number of words on stack with chars
996#    subu $sp,$sp,4 # push char-count ...
1000#    sw $s6,($sp) # ... onto stack
1004#    addu $t2,$t0,5 # GC tag, incl. for count-word
1008#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
1012#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
1016#    srl $s6,$s6,2  # data words in object
1020#    move $s7,$zero # object words in object
1024#    jal newObject  # allocate space
    
    # store header words
1028#    la $t0,CLASS_String
1032#    sw $t0,-12($s7)# store class tag (String) into object
1036#    lw $t2,4($sp) # char-count
1040#    sll $t1,$t2,2 # 4 times number of chars
1044#    subu $t2,$zero,$t2 # negative of char-count
1048#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
1052#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
1056#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
1057##...slt $at,$t0,$zero
1061##...beq $at,$zero,1080
1064#    and $t0,0xff # mask off object's hash value ...
1065##...lui $at,0
1069##...ori $at,$at,0xff
1073##...and $t0,$t0,$at
1076#    sw $t0,-8($s7) # ... and store back into -8 header-word
1080:  skipMask_readLine:

1080#    sll $t0,$t0,2 # data bytes in object
1084#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
1088#    subu $t0,$t0,$t2 # place to store last character (plus 9)
1092#    addu $sp,$sp,8 # pop redundant object-pointer and count
1096#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

1100#    beq $sp,$t1,rlReturn
1104:  charCopyLoop:
1104#    lw $t2,($sp)
1108#    sb $t2,-9($t0)
1112#    addu $sp,$sp,4
1116#    subu $t0,$t0,1
1120#    bne $sp,$t1,charCopyLoop
1124:  rlReturn:

1124#    lw $ra, 4($sp)
1128#    addu $sp, 8   # pop $ra and pointless word off stack
1132#    move $t0, $s7 # return string we allocated in $s7
1136#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
1140:mth_readInt_Lib:

    # save $ra by pushing onto stack
1140#    subu $sp,$sp,4
1144#    sw $ra,($sp)

1148:  riSkipWhiteLoop:
    # read a character
1148#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
1152#    subu $t0,$v0,32
1156#    bgt $t0,$zero,nonWhite
1157##...slt $at,$zero,$t0
1161##...bne $at,$zero,1204
1164#    beq $t0,$zero,riSkipWhiteLoop # start over if space
1168#    subu $t0,$v0,10
1172#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
1176#    subu $t0,$v0,9
1180#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
1184#    subu $t0,$v0,13
1188#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
1192#    subu $t0,$v0,12
1196#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
1200#    j badIntegerFormat # illegal integer char: abort program

1204:  nonWhite:
1204#    subu $t0,$v0,'-'
1208#    li $t4,1 # final multiplier
1212#    bne $t0,$zero,helpReadInt # go read
1216#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
1220#    jal readLogicalChar

1224:  helpReadInt:
1224#    li $t2,10
1228#    subu $t1,$v0,'0' # convert digit to 0-9 value
1232#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
1233##...sltu $at,$t1,$t2
1237##...beq $at,$zero,3484
1240#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

1244:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

1244#    jal readLogicalChar # read next character
1248#    subu $t1,$v0,'0' # convert digit to 0-9 value
1252#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
1253##...sltu $at,$t1,$t2
1257##...beq $at,$zero,1276

1260#    mul $t3,$t3,$t2 # multiply old value by 10
1261##...mult $t3,$t2
1265##...mflo $t3
1268#    addu $t3,$t3,$t1 # add in value of new digit
1272#    j digitLoop

1276:  doneDigitLoop:

    # "push back" unused character into queue
1276#    sw $v0,lastCharRead
