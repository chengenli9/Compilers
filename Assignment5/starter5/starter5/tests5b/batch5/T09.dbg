1360#    lw $t2,($sp)
1364#    sb $t2,-9($t0)
1368#    addu $sp,$sp,4
1372#    subu $t0,$t0,1
1376#    bne $sp,$t1,charCopyLoop
1380:  rlReturn:

1380#    lw $ra, 4($sp)
1384#    addu $sp, 8   # pop $ra and pointless word off stack
1388#    move $t0, $s7 # return string we allocated in $s7
1392#    jr $ra
