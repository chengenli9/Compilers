3088#    lw $t2,($sp)
3092#    sb $t2,-9($t0)
3096#    addu $sp,$sp,4
3100#    subu $t0,$t0,1
3104#    bne $sp,$t1,charCopyLoop
3108:  rlReturn:

3108#    lw $ra, 4($sp)
3112#    addu $sp, 8   # pop $ra and pointless word off stack
3116#    move $t0, $s7 # return string we allocated in $s7
3120#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
