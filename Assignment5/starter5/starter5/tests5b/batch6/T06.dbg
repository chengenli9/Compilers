##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1664:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
1664#    lw $t0,-8($s2) # get word with hash bits from this
1668#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
1672#    addu $t0,$t1

1676#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1680:mth_equals_Object:
1680#    move $t0,$s2 # first pointer (this)
1684#    lw $t1,($sp) # second pointer
1688#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
1689##...subu $at,$t0,$t1
1693##...sltiu $t0,$at,1

1696#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1700:mth_hashCode_String:
1700#    move $t0,$s2 # put this pointer in t0

1704#    li $t2,0 # current hash value
1708#    lw $t1,-4($t0) # negative of number of characters in string
1712#    beq $t1,$zero,done_hashCode_String # if zero length => done
1716#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
1720#    and $t0,0xfffffffc # adjust for padding
1721##...lui $at,65535
1725##...ori $at,$at,0xfffc
1729##...and $t0,$t0,$at
1732#    subu $t1,$t0,$t1 # address at end of string +12
1736:loop_hashCode_String:    
1736#    sll $t4,$t2,5 # multiply by 32
1740#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
1744#    lbu $t3,-12($t0) # current character
1748#    addu $t2,$t3 # add in current character
1752#    addu $t0,1 # go to next character's address
1756#    bne $t0,$t1,loop_hashCode_String # loop back if more
1760:done_hashCode_String:    

    # push int on stack
1760#    move $t0, $t2 # put $t2 in return slot
1764#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
1768:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
1768#    subu $sp,4
1772#    sw $ra,($sp)
    
    # get hash value
1776#    lw $t2,-12($s2) # vtable address
1780#    lw $t0,($t2) # method address
1784#    jalr $t0
1788#    subu $sp,8 # push result (int in $t0) on stack
1792#    sw $s5,4($sp)
1796#    sw $t0,($sp)

    # compute print-size of hash value
1800#    li $t0, 1
1804#    lw $t1, ($sp)
1808#    srl $t1,$t1,4
1812#    beq $t1,$zero,toString_skip_loop
1816:toString_loop_top:
1816#    addu $t0,1
1820#    srl $t1,$t1,4
1824#    bne $t1,$zero,toString_loop_top
1828:toString_skip_loop:
1828#    subu $sp,8
1832#    sw $s5,4($sp)
1836#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
1840#    lw $t2,-12($s2) # vtable address
1844#    move $t0,$t2
1848:toString_checkTagBit:
1848#    subu $t0,1
1852#    lb $t1,($t0)
1856#    and $t1,0x80
1857##...lui $at,0
1861##...ori $at,$at,0x80
1865##...and $t1,$t1,$at
1868#    beq $t1,$zero,toString_checkTagBit
1872#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
1876#    subu $sp,8
1880#    sw $t1,($sp)
1884#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
1888#    move $s7,$zero # -4 offset header word
1892#    lw $t4,8($sp) # bytes for hash value
1896#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
1900#    addu $t4,8
1904#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
1908#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

1912#    li $t0,CLASS_String # store string vtable address into ...
1916#    sw $t0,-12($s7) # ... -12 offset in object header
1920#    lw $t2,-12($s2) # our object's vtable address
1924#    lw $t5,4($sp) # number characters in prefix
1928#    lw $t1,12($sp) # number of characters in hashcode
1932#    addu $t3,$t1,$t5 # number of characters in string ...
1936#    addu $t3,1 # ... including the '@' character
1940#    subu $t0,$zero,$t3 # store negated length into ...
1944#    sw $t0,-4($s7) # ... -4 offset header word
1948#    lw $t0,-8($s7) # get -8 offset header-word
1952#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
1953##...slt $at,$t0,$zero
1957##...beq $at,$zero,1976
1960#    and $t0,0xff # mask off object's hash value ...
1961##...lui $at,0
1965##...ori $at,$at,0xff
1969##...and $t0,$t0,$at
1972#    sw $t0,-8($s7) # ... and store back into -8 header-word
1976:skipMask_toString:
1976#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
1980#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
1984#    subu $t4,$t2,$t5
1988:toString_copyLoop:    
1988#    lb $t3,($t4)
1992#    and $t3,0x7f # mask off sign bit (in case first word)
1993##...lui $at,0
1997##...ori $at,$at,0x7f
2001##...and $t3,$t3,$at
2004#    sb $t3,-8($t0)
2008#    addu $t4,1
2012#    addu $t0,1
2016#    blt $t4,$t2,toString_copyLoop
2017##...slt $at,$t4,$t2
2021##...bne $at,$zero,1988

    # copy the '@' sign
2024#    li $t3,'@'
2028#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
2032#    addu $t2,$t0,$t1 # address of last byte in string to store +8
2036#    lw $t3,20($sp) # hash code to print
2040:toString_hashCopyLoop:
2040#    and $t4,$t3,0xf
2044#    srl $t3,4
2048#    lb $t4,hexChars($t4)
2052#    sb $t4,-8($t2)
2056#    subu $t2,$t2,1
2060#    bgt $t2,$t0,toString_hashCopyLoop
2061##...slt $at,$t0,$t2
2065##...bne $at,$zero,2040

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
2068#    addu $sp,28
2072#    lw $ra,($sp)
2076#    addu $sp,4
2080#    move $t0, $s7 # return string we created
2084#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
2088:mth_equals_String:
    
    # quick test for obvious false
2088#    lw $t0,($sp) # second parameter
2092#    beq $t0,$zero,goEsFalse # go return false if null
2096#    lw $t1,-12($t0) # vtable pointer
2100#    la $t2,CLASS_String # string vtable pointer
2104#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
2108#    subu $sp,12
2112#    sw $ra,8($sp)
2116#    sw $s2,4($sp)
2120#    sw $t0,($sp)
2124#    jal mth_compareTo_String
2128#    lw $s2, 4($sp) #restore this pointer and pop parameters
2132#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
2136#    seq $t0,$t0,$zero
2137##...subu $at,$t0,$zero
2141##...sltiu $t0,$at,1

    # pop return address and return $t0
2144#    lw $ra,($sp)
2148#    addu $sp,4

2152#    jr $ra # return
    
2156:goEsFalse:
    # put 0 in $t0 and return
2156#    li $t0, 0
2160#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
2164:mth_toString_String:
    #we are a string, so return this.
2164#    move $t0, $s2
2168#    jr $ra

###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
2172:mth_readLine_Lib:
    
2172#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
