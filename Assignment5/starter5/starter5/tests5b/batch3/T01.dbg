3016#    subu $t1,$t0,$t1 # first word in string
3020#    lw $t0,4($t0) # negative of string-length
3024#    subu $t0,$t1,$t0 # byte just beyond last char in string

    # print the chars in the string
3028#    beq $t0,$t1,donePrintStr
