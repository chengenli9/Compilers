###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
4576:mth_equals_String:
    
    # quick test for obvious false
4576#    lw $t0,($sp) # second parameter
4580#    beq $t0,$zero,goEsFalse # go return false if null
4584#    lw $t1,-12($t0) # vtable pointer
4588#    la $t2,CLASS_String # string vtable pointer
4592#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
4596#    subu $sp,12
4600#    sw $ra,8($sp)
4604#    sw $s2,4($sp)
4608#    sw $t0,($sp)
4612#    jal mth_compareTo_String
4616#    lw $s2, 4($sp) #restore this pointer and pop parameters
4620#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
4624#    seq $t0,$t0,$zero
4625##...subu $at,$t0,$zero
4629##...sltiu $t0,$at,1

    # pop return address and return $t0
4632#    lw $ra,($sp)
4636#    addu $sp,4

4640#    jr $ra # return
    
4644:goEsFalse:
    # put 0 in $t0 and return
4644#    li $t0, 0
4648#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
