5520#    subu $t1,$t0,$t1 # first word in string
5524#    lw $t0,4($t0) # negative of string-length
5528#    subu $t0,$t1,$t0 # byte just beyond last char in string

    # print the chars in the string
5532#    beq $t0,$t1,donePrintStr
5536:  psLoop:
5536#    lb $a0,($t1) # next byte
5540#    li $v0,11 # code for printing char
