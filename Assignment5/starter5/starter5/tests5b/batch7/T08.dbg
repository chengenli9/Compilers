3204:  gCinnerCopy2:
3204#    lw $s0,($t4)
3208#    sw $s0,($s3)
3212#    addu $t4,$t4,4
3216#    addu $s3,$s3,4
3220#    bltu $t4,$t3,gCinnerCopy2
3221##...sltu $at,$t4,$t3
3225##...bne $at,$zero,3204

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
3228#    sw $zero,-8($t1) # 0 in first header-slot
3232#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
3236#    sw $t8,($t0)

3240:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
3240#    addu $t0,$t0,4
3244#    bltu $t0,$s1,gcNextPointerInObject
3245##...sltu $at,$t0,$s1
3249##...bne $at,$zero,3088

3252:  gcTestIterDone2:
3252#    bltu $t0,$s3,gcHeapCopyLoop
3253##...sltu $at,$t0,$s3
3257##...bne $at,$zero,2972

    ###### end outer loop to copy all non-stack-direct objects ######

3260:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
3260#    lw $s2,($sp)
3264#    addu $sp,$sp,4

    # mark us as having already GC'd
3268#    move $t5,$s5

    # go try and allocate again
3272#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
3276:vm_init:

    # mark bottom of stack
3276#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
3280#    move $s2,$zero

    #set up the "five" register
3284#    li $s5,5

3288#    la $s3,seg0_start
3292#    la $s4,seg0_end
3293##...lui $s4,16
3297##...addiu $s4,$s4,4236
    
    # return
3300#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3304:divide:
    # get parameters; abort if divisor zero
3304#    lw $t0,($sp)
3308#    lw $t1,8($sp)
3312#    beq $t0,$zero,divByZeroError
    
    # perform division
3316#    div $t1,$t0
3320#    mflo $t0

    # store result, adjust stack and return
3324#    addu $sp,$sp,8 # adjust stack
3328#    sw $t0,($sp) # store result
3332#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3336:remainder:
    # get parameters; abort if divisor zero
3336#    lw $t0,($sp)
3340#    lw $t1,8($sp)
3344#    beq $t0,$zero,divByZeroError
    
    # perform division
3348#    div $t1,$t0
3352#    mfhi $t0

    # store result, adjust stack and return
3356#    addu $sp,$sp,8 # adjust stack
3360#    sw $t0,($sp) # store result
3364#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
3368:checkCast:
    # get object, allow immediately if null
3368#    lw $t2,($sp)
3372#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
3376#    lw $t2,-12($t2) # vtable address
3380#    bge $t2,$t1,castException
3381##...slt $at,$t2,$t1
3385##...beq $at,$zero,3556
3388#    blt $t2,$t0,castException
3389##...slt $at,$t2,$t0
3393##...bne $at,$zero,3556
    
    # return, leaving object unchanged on stack
3396:  checkCastReturn:    
3396#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
3400:instanceOf:
    # get object, go return false if null
3400#    lw $t2,($sp)
3404#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
3408#    lw $t2,-12($t2) # vtable address
3412#    sge $t0,$t2,$t0 # are we >= the lower limit?
3413##...slt $t0,$t2,$t0
3417##...xori $t0,$t0,0x1
3420#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
3424#    and $t2,$t0,$t1
3428#    sw $t2,($sp)
3432:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
3432#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

3436:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
3436#    li $v0,4 # syscall-code for print-string
3440#    syscall
3444:exit:
    # print termination message
3444#    li $v0,4 # syscall-code for print-string
3448#    la $a0,exitString
3452#    syscall

    # print number of garbage collections
3456#    li $v0,4 # syscall-code for print-string
3460#    la $a0,gcCountMsg
3464#    syscall # print "Number of ..."
3468#    lw $a0,gcCount # number of GC's
3472#    li $v0,1 # code for print-int
3476#    syscall
3480#    li $v0,4 # syscall-code for print-string
3484#    la $a0,newlineString
3488#    syscall # print newline

    # terminate execution
3492#    li $v0,10 #syscall-code for "exit"
3496#    syscall

3500:outOfHeapMemory:
3500#    la $a0,heapMemoryMsg
3504#    j exitError
3508:divByZeroError:
3508#    la $a0,divByZeroMsg
3512#    j exitError
3516:strIndexOutOfBounds:
3516#    la $a0,strIndexOutOfBoundsMsg
3520#    j exitError
3524:arrayIndexOutOfBounds:
3524#    la $a0,arrayIndexOutOfBoundsMsg
3528#    j exitError
3532:arraySizeOutOfBounds:
3532#    la $a0,arraySizeOutOfBoundsMsg
3536#    j exitError
3540:nullPtrException:
3540#    la $a0,nullPtrExceptionMsg
3544#    j exitError
3548:badIntegerFormat:
3548#    la $a0,badIntegerFormatMsg
3552#    j exitError
3556:castException:
3556#    la $a0,castExceptionMsg
3560#    j exitError
############## data section ################
    .data
3864:hexChars:
    .ascii "0123456789abcdef"
    .align 2
3880:cur_seg:
    .word 0

3884:lastCharRead:
    .word -2 # -2 => no buffered character
3888:prevHashConstant:
    .word 0x2785173c
3892:gcCount:
    .word 0

3896:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
