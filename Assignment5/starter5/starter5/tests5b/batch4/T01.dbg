##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
2500:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
2500#    lw $t0,-8($s2) # get word with hash bits from this
2504#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
2508#    addu $t0,$t1

2512#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
2516:mth_equals_Object:
2516#    move $t0,$s2 # first pointer (this)
2520#    lw $t1,($sp) # second pointer
2524#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
2525##...subu $at,$t0,$t1
2529##...sltiu $t0,$at,1

2532#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
2536:mth_hashCode_String:
2536#    move $t0,$s2 # put this pointer in t0

2540#    li $t2,0 # current hash value
2544#    lw $t1,-4($t0) # negative of number of characters in string
2548#    beq $t1,$zero,done_hashCode_String # if zero length => done
2552#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
2556#    and $t0,0xfffffffc # adjust for padding
2557##...lui $at,65535
2561##...ori $at,$at,0xfffc
2565##...and $t0,$t0,$at
2568#    subu $t1,$t0,$t1 # address at end of string +12
2572:loop_hashCode_String:    
2572#    sll $t4,$t2,5 # multiply by 32
2576#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
2580#    lbu $t3,-12($t0) # current character
2584#    addu $t2,$t3 # add in current character
2588#    addu $t0,1 # go to next character's address
2592#    bne $t0,$t1,loop_hashCode_String # loop back if more
2596:done_hashCode_String:    

    # push int on stack
2596#    move $t0, $t2 # put $t2 in return slot
2600#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
2604:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
2604#    subu $sp,4
2608#    sw $ra,($sp)
    
    # get hash value
2612#    lw $t2,-12($s2) # vtable address
2616#    lw $t0,($t2) # method address
2620#    jalr $t0
2624#    subu $sp,8 # push result (int in $t0) on stack
2628#    sw $s5,4($sp)
2632#    sw $t0,($sp)

    # compute print-size of hash value
2636#    li $t0, 1
2640#    lw $t1, ($sp)
2644#    srl $t1,$t1,4
2648#    beq $t1,$zero,toString_skip_loop
2652:toString_loop_top:
2652#    addu $t0,1
2656#    srl $t1,$t1,4
2660#    bne $t1,$zero,toString_loop_top
2664:toString_skip_loop:
2664#    subu $sp,8
2668#    sw $s5,4($sp)
2672#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
2676#    lw $t2,-12($s2) # vtable address
2680#    move $t0,$t2
2684:toString_checkTagBit:
2684#    subu $t0,1
2688#    lb $t1,($t0)
2692#    and $t1,0x80
2693##...lui $at,0
2697##...ori $at,$at,0x80
2701##...and $t1,$t1,$at
2704#    beq $t1,$zero,toString_checkTagBit
2708#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
2712#    subu $sp,8
2716#    sw $t1,($sp)
2720#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
2724#    move $s7,$zero # -4 offset header word
2728#    lw $t4,8($sp) # bytes for hash value
2732#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
2736#    addu $t4,8
2740#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
2744#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

2748#    li $t0,CLASS_String # store string vtable address into ...
2752#    sw $t0,-12($s7) # ... -12 offset in object header
2756#    lw $t2,-12($s2) # our object's vtable address
2760#    lw $t5,4($sp) # number characters in prefix
2764#    lw $t1,12($sp) # number of characters in hashcode
2768#    addu $t3,$t1,$t5 # number of characters in string ...
2772#    addu $t3,1 # ... including the '@' character
2776#    subu $t0,$zero,$t3 # store negated length into ...
2780#    sw $t0,-4($s7) # ... -4 offset header word
2784#    lw $t0,-8($s7) # get -8 offset header-word
