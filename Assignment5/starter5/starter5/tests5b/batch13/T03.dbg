###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
1092:mth_readLine_Lib:
    
1092#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
1096#    sw $ra, 4($sp) # save $ra
1100#    move $t1,$sp # save "original" sp

1104:  doRead:

    # read the character
1104#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
1108#    subu $t2,$v0,13
1112#    bne $t2,$zero,notReturnRL
1116#    jal readLogicalChar
1120#    subu $t2,$v0,10 # check for newline
1124#    beq $t2,$zero,foundNewLine
1128#    sw $v0,lastCharRead # push back character into queue
1132#    j foundNewLine # go process the line

1136:  notReturnRL:

    # at this point, $v0 has our character

1136#    subu $t0,$v0,10
1140#    beq $t0,$zero,foundNewLine
1144#    blt $v0,$zero,foundEof
1145##...slt $at,$v0,$zero
1149##...bne $at,$zero,1164

    # we have a character, so push it onto stack
1152#    subu $sp,$sp,4
1156#    sw $v0,($sp)

    # loop back up to get next character
1160#    j doRead

1164:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
1164#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
1168#    li $s7, 0 # return-value: null
1172#    j rlReturn # return

1176:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
1176#    subu $t0,$t1,$sp # number of chars we read (times 4)
1180#    srl $s6,$t0,2 # number of words on stack with chars
1184#    subu $sp,$sp,4 # push char-count ...
1188#    sw $s6,($sp) # ... onto stack
1192#    addu $t2,$t0,5 # GC tag, incl. for count-word
1196#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
1200#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
1204#    srl $s6,$s6,2  # data words in object
1208#    move $s7,$zero # object words in object
1212#    jal newObject  # allocate space
    
    # store header words
1216#    la $t0,CLASS_String
1220#    sw $t0,-12($s7)# store class tag (String) into object
1224#    lw $t2,4($sp) # char-count
1228#    sll $t1,$t2,2 # 4 times number of chars
1232#    subu $t2,$zero,$t2 # negative of char-count
1236#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
1240#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
1244#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
1245##...slt $at,$t0,$zero
1249##...beq $at,$zero,1268
1252#    and $t0,0xff # mask off object's hash value ...
1253##...lui $at,0
1257##...ori $at,$at,0xff
1261##...and $t0,$t0,$at
1264#    sw $t0,-8($s7) # ... and store back into -8 header-word
1268:  skipMask_readLine:

1268#    sll $t0,$t0,2 # data bytes in object
1272#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
1276#    subu $t0,$t0,$t2 # place to store last character (plus 9)
1280#    addu $sp,$sp,8 # pop redundant object-pointer and count
1284#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

1288#    beq $sp,$t1,rlReturn
1292:  charCopyLoop:
1292#    lw $t2,($sp)
1296#    sb $t2,-9($t0)
1300#    addu $sp,$sp,4
1304#    subu $t0,$t0,1
1308#    bne $sp,$t1,charCopyLoop
1312:  rlReturn:

1312#    lw $ra, 4($sp)
1316#    addu $sp, 8   # pop $ra and pointless word off stack
1320#    move $t0, $s7 # return string we allocated in $s7
1324#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
1328:mth_readInt_Lib:

    # save $ra by pushing onto stack
1328#    subu $sp,$sp,4
1332#    sw $ra,($sp)

1336:  riSkipWhiteLoop:
    # read a character
1336#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
1340#    subu $t0,$v0,32
1344#    bgt $t0,$zero,nonWhite
1345##...slt $at,$zero,$t0
1349##...bne $at,$zero,1392
1352#    beq $t0,$zero,riSkipWhiteLoop # start over if space
1356#    subu $t0,$v0,10
1360#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
1364#    subu $t0,$v0,9
1368#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
1372#    subu $t0,$v0,13
1376#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
1380#    subu $t0,$v0,12
1384#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
1388#    j badIntegerFormat # illegal integer char: abort program

1392:  nonWhite:
1392#    subu $t0,$v0,'-'
1396#    li $t4,1 # final multiplier
1400#    bne $t0,$zero,helpReadInt # go read
1404#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
1408#    jal readLogicalChar

1412:  helpReadInt:
1412#    li $t2,10
1416#    subu $t1,$v0,'0' # convert digit to 0-9 value
1420#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
1421##...sltu $at,$t1,$t2
1425##...beq $at,$zero,3708
1428#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

1432:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

1432#    jal readLogicalChar # read next character
1436#    subu $t1,$v0,'0' # convert digit to 0-9 value
1440#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
1441##...sltu $at,$t1,$t2
1445##...beq $at,$zero,1464

1448#    mul $t3,$t3,$t2 # multiply old value by 10
1449##...mult $t3,$t2
1453##...mflo $t3
1456#    addu $t3,$t3,$t1 # add in value of new digit
1460#    j digitLoop

1464:  doneDigitLoop:

    # "push back" unused character into queue
1464#    sw $v0,lastCharRead

    # restore return address
1468#    lw $ra,($sp)
1472#    addu $sp, 4

    # multiply by sign and put return value in $t0
1476#    mult $t3,$t4 # multiply to account for poss. minus sign
1480#    mflo $t3
1484#    move $t0, $t3
    
    # return
1488#    jr $ra
