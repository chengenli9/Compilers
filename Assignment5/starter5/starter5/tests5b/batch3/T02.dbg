    
    # quick test for obvious false
7720#    lw $t0,($sp) # second parameter
7724#    beq $t0,$zero,goEsFalse # go return false if null
7728#    lw $t1,-12($t0) # vtable pointer
7732#    la $t2,CLASS_String # string vtable pointer
7736#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
7740#    subu $sp,12
7744#    sw $ra,8($sp)
