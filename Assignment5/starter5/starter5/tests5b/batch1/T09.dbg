########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
3068:vm_init:

    # mark bottom of stack
3068#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
3072#    move $s2,$zero

    #set up the "five" register
3076#    li $s5,5

3080#    la $s3,seg0_start
3084#    la $s4,seg0_end
3085##...lui $s4,16
3089##...addiu $s4,$s4,3864
    
    # return
3092#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3096:divide:
    # get parameters; abort if divisor zero
3096#    lw $t0,($sp)
3100#    lw $t1,8($sp)
3104#    beq $t0,$zero,divByZeroError
    
    # perform division
3108#    div $t1,$t0
3112#    mflo $t0

    # store result, adjust stack and return
3116#    addu $sp,$sp,8 # adjust stack
3120#    sw $t0,($sp) # store result
3124#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3128:remainder:
    # get parameters; abort if divisor zero
3128#    lw $t0,($sp)
3132#    lw $t1,8($sp)
3136#    beq $t0,$zero,divByZeroError
    
    # perform division
3140#    div $t1,$t0
3144#    mfhi $t0

    # store result, adjust stack and return
3148#    addu $sp,$sp,8 # adjust stack
3152#    sw $t0,($sp) # store result
3156#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
3160:checkCast:
    # get object, allow immediately if null
3160#    lw $t2,($sp)
3164#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
3168#    lw $t2,-12($t2) # vtable address
3172#    bge $t2,$t1,castException
3173##...slt $at,$t2,$t1
3177##...beq $at,$zero,3312
3180#    blt $t2,$t0,castException
3181##...slt $at,$t2,$t0
3185##...bne $at,$zero,3312
    
    # return, leaving object unchanged on stack
3188:  checkCastReturn:    
3188#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
3192:instanceOf:
    # get object, go return false if null
3192#    lw $t2,($sp)
3196#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
3200#    lw $t2,-12($t2) # vtable address
3204#    sge $t0,$t2,$t0 # are we >= the lower limit?
3205##...slt $t0,$t2,$t0
3209##...xori $t0,$t0,0x1
3212#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
3216#    and $t2,$t0,$t1
3220#    sw $t2,($sp)
3224:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
3224#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

3228:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
3228#    li $v0,4 # syscall-code for print-string
3232#    syscall
3236:exit:
    # print termination message
3236#    li $v0,4 # syscall-code for print-string
3240#    la $a0,exitString
3244#    syscall

    # terminate execution
3248#    li $v0,10 #syscall-code for "exit"
3252#    syscall

3256:outOfHeapMemory:
3256#    la $a0,heapMemoryMsg
3260#    j exitError
3264:divByZeroError:
3264#    la $a0,divByZeroMsg
3268#    j exitError
3272:strIndexOutOfBounds:
3272#    la $a0,strIndexOutOfBoundsMsg
3276#    j exitError
3280:arrayIndexOutOfBounds:
3280#    la $a0,arrayIndexOutOfBoundsMsg
3284#    j exitError
3288:arraySizeOutOfBounds:
3288#    la $a0,arraySizeOutOfBoundsMsg
3292#    j exitError
3296:nullPtrException:
3296#    la $a0,nullPtrExceptionMsg
3300#    j exitError
3304:badIntegerFormat:
3304#    la $a0,badIntegerFormatMsg
3308#    j exitError
3312:castException:
3312#    la $a0,castExceptionMsg
3316#    j exitError
############## data section ################
    .data
3500:hexChars:
    .ascii "0123456789abcdef"
    .align 2
3516:cur_seg:
    .word 0

3520:lastCharRead:
    .word -2 # -2 => no buffered character
3524:prevHashConstant:
    .word 0x2785173c
3528:gcCount:
    .word 0

3532:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
3559:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
3582:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
3617:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
3651:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
3684:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
3715:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
3763:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
3784:gcMsg: 
      .asciiz "\nGC!\n"
3790:gcCountMsg: 
      .asciiz "Number of garbage collections: "

3822:nullStr:
    .asciiz "null"
3827:trueString:
    .asciiz "true"
3832:falseString:
    .asciiz "false"
3838:exitString:
    .ascii "Program terminated."
    #### "falls through" here
3857:newlineString:
    .asciiz "\n"
    
    .align 2
3860:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

3864:seg0_start:
    .space 0x100000
1052440:seg0_end:
1052440:seg1_start:
    .space 0x100000
2101016:seg1_end:
