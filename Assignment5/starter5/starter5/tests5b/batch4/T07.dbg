###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
1284:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
1284#    subu $sp,4
1288#    sw $ra,($sp)
    
    # get hash value
1292#    lw $t2,-12($s2) # vtable address
1296#    lw $t0,($t2) # method address
1300#    jalr $t0
1304#    subu $sp,8 # push result (int in $t0) on stack
1308#    sw $s5,4($sp)
1312#    sw $t0,($sp)

    # compute print-size of hash value
1316#    li $t0, 1
1320#    lw $t1, ($sp)
1324#    srl $t1,$t1,4
1328#    beq $t1,$zero,toString_skip_loop
1332:toString_loop_top:
1332#    addu $t0,1
1336#    srl $t1,$t1,4
1340#    bne $t1,$zero,toString_loop_top
1344:toString_skip_loop:
1344#    subu $sp,8
1348#    sw $s5,4($sp)
1352#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
1356#    lw $t2,-12($s2) # vtable address
1360#    move $t0,$t2
1364:toString_checkTagBit:
1364#    subu $t0,1
1368#    lb $t1,($t0)
1372#    and $t1,0x80
1373##...lui $at,0
1377##...ori $at,$at,0x80
1381##...and $t1,$t1,$at
1384#    beq $t1,$zero,toString_checkTagBit
1388#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
1392#    subu $sp,8
1396#    sw $t1,($sp)
1400#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
1404#    move $s7,$zero # -4 offset header word
1408#    lw $t4,8($sp) # bytes for hash value
1412#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
1416#    addu $t4,8
1420#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
1424#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

1428#    li $t0,CLASS_String # store string vtable address into ...
1432#    sw $t0,-12($s7) # ... -12 offset in object header
1436#    lw $t2,-12($s2) # our object's vtable address
1440#    lw $t5,4($sp) # number characters in prefix
1444#    lw $t1,12($sp) # number of characters in hashcode
1448#    addu $t3,$t1,$t5 # number of characters in string ...
1452#    addu $t3,1 # ... including the '@' character
1456#    subu $t0,$zero,$t3 # store negated length into ...
1460#    sw $t0,-4($s7) # ... -4 offset header word
1464#    lw $t0,-8($s7) # get -8 offset header-word
1468#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
1469##...slt $at,$t0,$zero
1473##...beq $at,$zero,1492
1476#    and $t0,0xff # mask off object's hash value ...
1477##...lui $at,0
1481##...ori $at,$at,0xff
1485##...and $t0,$t0,$at
1488#    sw $t0,-8($s7) # ... and store back into -8 header-word
1492:skipMask_toString:
1492#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
1496#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
1500#    subu $t4,$t2,$t5
1504:toString_copyLoop:    
1504#    lb $t3,($t4)
1508#    and $t3,0x7f # mask off sign bit (in case first word)
1509##...lui $at,0
1513##...ori $at,$at,0x7f
1517##...and $t3,$t3,$at
1520#    sb $t3,-8($t0)
1524#    addu $t4,1
1528#    addu $t0,1
1532#    blt $t4,$t2,toString_copyLoop
1533##...slt $at,$t4,$t2
1537##...bne $at,$zero,1504

    # copy the '@' sign
1540#    li $t3,'@'
1544#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
1548#    addu $t2,$t0,$t1 # address of last byte in string to store +8
1552#    lw $t3,20($sp) # hash code to print
1556:toString_hashCopyLoop:
1556#    and $t4,$t3,0xf
1560#    srl $t3,4
1564#    lb $t4,hexChars($t4)
1568#    sb $t4,-8($t2)
1572#    subu $t2,$t2,1
1576#    bgt $t2,$t0,toString_hashCopyLoop
1577##...slt $at,$t0,$t2
1581##...bne $at,$zero,1556

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
1584#    addu $sp,28
1588#    lw $ra,($sp)
1592#    addu $sp,4
1596#    move $t0, $s7 # return string we created
1600#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
1604:mth_equals_String:
    
    # quick test for obvious false
1604#    lw $t0,($sp) # second parameter
1608#    beq $t0,$zero,goEsFalse # go return false if null
1612#    lw $t1,-12($t0) # vtable pointer
1616#    la $t2,CLASS_String # string vtable pointer
1620#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
1624#    subu $sp,12
1628#    sw $ra,8($sp)
1632#    sw $s2,4($sp)
1636#    sw $t0,($sp)
1640#    jal mth_compareTo_String
1644#    lw $s2, 4($sp) #restore this pointer and pop parameters
1648#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
1652#    seq $t0,$t0,$zero
1653##...subu $at,$t0,$zero
1657##...sltiu $t0,$at,1

    # pop return address and return $t0
1660#    lw $ra,($sp)
1664#    addu $sp,4

1668#    jr $ra # return
    
1672:goEsFalse:
    # put 0 in $t0 and return
1672#    li $t0, 0
1676#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
