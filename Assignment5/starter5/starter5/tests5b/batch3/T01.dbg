########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
4860:vm_init:

    # mark bottom of stack
4860#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
4864#    move $s2,$zero

    #set up the "five" register
4868#    li $s5,5

4872#    la $s3,seg0_start
4876#    la $s4,seg0_end
4877##...lui $s4,16
4881##...addiu $s4,$s4,5836
    
    # return
4884#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4888:divide:
    # get parameters; abort if divisor zero
4888#    lw $t0,($sp)
4892#    lw $t1,8($sp)
4896#    beq $t0,$zero,divByZeroError
    
    # perform division
4900#    div $t1,$t0
4904#    mflo $t0

    # store result, adjust stack and return
4908#    addu $sp,$sp,8 # adjust stack
4912#    sw $t0,($sp) # store result
4916#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4920:remainder:
    # get parameters; abort if divisor zero
4920#    lw $t0,($sp)
4924#    lw $t1,8($sp)
4928#    beq $t0,$zero,divByZeroError
    
    # perform division
4932#    div $t1,$t0
4936#    mfhi $t0

    # store result, adjust stack and return
4940#    addu $sp,$sp,8 # adjust stack
4944#    sw $t0,($sp) # store result
4948#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
4952:checkCast:
    # get object, allow immediately if null
4952#    lw $t2,($sp)
4956#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
4960#    lw $t2,-12($t2) # vtable address
4964#    bge $t2,$t1,castException
4965##...slt $at,$t2,$t1
4969##...beq $at,$zero,5140
4972#    blt $t2,$t0,castException
4973##...slt $at,$t2,$t0
4977##...bne $at,$zero,5140
    
    # return, leaving object unchanged on stack
4980:  checkCastReturn:    
4980#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
4984:instanceOf:
    # get object, go return false if null
4984#    lw $t2,($sp)
4988#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
4992#    lw $t2,-12($t2) # vtable address
4996#    sge $t0,$t2,$t0 # are we >= the lower limit?
4997##...slt $t0,$t2,$t0
5001##...xori $t0,$t0,0x1
5004#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
5008#    and $t2,$t0,$t1
5012#    sw $t2,($sp)
5016:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
5016#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

5020:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
5020#    li $v0,4 # syscall-code for print-string
5024#    syscall
5028:exit:
    # print termination message
5028#    li $v0,4 # syscall-code for print-string
5032#    la $a0,exitString
5036#    syscall

    # print number of garbage collections
5040#    li $v0,4 # syscall-code for print-string
5044#    la $a0,gcCountMsg
5048#    syscall # print "Number of ..."
5052#    lw $a0,gcCount # number of GC's
5056#    li $v0,1 # code for print-int
5060#    syscall
5064#    li $v0,4 # syscall-code for print-string
5068#    la $a0,newlineString
5072#    syscall # print newline

    # terminate execution
5076#    li $v0,10 #syscall-code for "exit"
5080#    syscall

5084:outOfHeapMemory:
5084#    la $a0,heapMemoryMsg
5088#    j exitError
5092:divByZeroError:
5092#    la $a0,divByZeroMsg
5096#    j exitError
5100:strIndexOutOfBounds:
5100#    la $a0,strIndexOutOfBoundsMsg
5104#    j exitError
5108:arrayIndexOutOfBounds:
5108#    la $a0,arrayIndexOutOfBoundsMsg
5112#    j exitError
5116:arraySizeOutOfBounds:
5116#    la $a0,arraySizeOutOfBoundsMsg
5120#    j exitError
5124:nullPtrException:
5124#    la $a0,nullPtrExceptionMsg
5128#    j exitError
5132:badIntegerFormat:
5132#    la $a0,badIntegerFormatMsg
5136#    j exitError
5140:castException:
5140#    la $a0,castExceptionMsg
5144#    j exitError
############## data section ################
    .data
5464:hexChars:
    .ascii "0123456789abcdef"
    .align 2
5480:cur_seg:
    .word 0

5484:lastCharRead:
    .word -2 # -2 => no buffered character
5488:prevHashConstant:
    .word 0x2785173c
5492:gcCount:
    .word 0

5496:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
5523:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
5546:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
5581:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
5615:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
5648:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
5679:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
5727:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
5748:gcMsg: 
      .asciiz "\nGC!\n"
5754:gcCountMsg: 
      .asciiz "Number of garbage collections: "

5786:nullStr:
    .asciiz "null"
5791:trueString:
    .asciiz "true"
5796:falseString:
    .asciiz "false"
5802:exitString:
    .ascii "Program execution completed."
    #### "falls through" here
5830:newlineString:
    .asciiz "\n"
    
    .align 2
5832:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

5836:seg0_start:
    .space 0x100000
1054412:seg0_end:
1054412:seg1_start:
    .space 0x100000
2102988:seg1_end:
