6289##...sltu $at,$t0,$s1
6293##...bne $at,$zero,6132

6296:  gcTestIterDone2:
6296#    bltu $t0,$s3,gcHeapCopyLoop
6297##...sltu $at,$t0,$s3
6301##...bne $at,$zero,6016
