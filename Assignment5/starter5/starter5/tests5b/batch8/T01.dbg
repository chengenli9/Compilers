###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
2888:mth_readLine_Lib:
    
2888#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
2892#    sw $ra, 4($sp) # save $ra
2896#    move $t1,$sp # save "original" sp

2900:  doRead:

    # read the character
2900#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
2904#    subu $t2,$v0,13
2908#    bne $t2,$zero,notReturnRL
2912#    jal readLogicalChar
2916#    subu $t2,$v0,10 # check for newline
2920#    beq $t2,$zero,foundNewLine
2924#    sw $v0,lastCharRead # push back character into queue
2928#    j foundNewLine # go process the line

2932:  notReturnRL:

    # at this point, $v0 has our character

2932#    subu $t0,$v0,10
2936#    beq $t0,$zero,foundNewLine
2940#    blt $v0,$zero,foundEof
2941##...slt $at,$v0,$zero
2945##...bne $at,$zero,2960

    # we have a character, so push it onto stack
2948#    subu $sp,$sp,4
2952#    sw $v0,($sp)

    # loop back up to get next character
2956#    j doRead

2960:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
2960#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
2964#    li $s7, 0 # return-value: null
2968#    j rlReturn # return

2972:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
2972#    subu $t0,$t1,$sp # number of chars we read (times 4)
2976#    srl $s6,$t0,2 # number of words on stack with chars
2980#    subu $sp,$sp,4 # push char-count ...
2984#    sw $s6,($sp) # ... onto stack
2988#    addu $t2,$t0,5 # GC tag, incl. for count-word
2992#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
2996#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
3000#    srl $s6,$s6,2  # data words in object
3004#    move $s7,$zero # object words in object
3008#    jal newObject  # allocate space
    
    # store header words
3012#    la $t0,CLASS_String
3016#    sw $t0,-12($s7)# store class tag (String) into object
3020#    lw $t2,4($sp) # char-count
3024#    sll $t1,$t2,2 # 4 times number of chars
3028#    subu $t2,$zero,$t2 # negative of char-count
3032#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
3036#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
3040#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
3041##...slt $at,$t0,$zero
3045##...beq $at,$zero,3064
3048#    and $t0,0xff # mask off object's hash value ...
3049##...lui $at,0
3053##...ori $at,$at,0xff
3057##...and $t0,$t0,$at
3060#    sw $t0,-8($s7) # ... and store back into -8 header-word
3064:  skipMask_readLine:

3064#    sll $t0,$t0,2 # data bytes in object
3068#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
3072#    subu $t0,$t0,$t2 # place to store last character (plus 9)
3076#    addu $sp,$sp,8 # pop redundant object-pointer and count
3080#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack
