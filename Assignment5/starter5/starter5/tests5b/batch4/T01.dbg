2796#    and $t0,0xff # mask off object's hash value ...
2797##...lui $at,0
2801##...ori $at,$at,0xff
2805##...and $t0,$t0,$at
2808#    sw $t0,-8($s7) # ... and store back into -8 header-word
2812:skipMask_toString:
2812#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
2816#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
2820#    subu $t4,$t2,$t5
2824:toString_copyLoop:    
2824#    lb $t3,($t4)
2828#    and $t3,0x7f # mask off sign bit (in case first word)
2829##...lui $at,0
2833##...ori $at,$at,0x7f
2837##...and $t3,$t3,$at
2840#    sb $t3,-8($t0)
