7428#    sw $t0,-8($s7) # ... and store back into -8 header-word
7432:  skipMask_readLine:

7432#    sll $t0,$t0,2 # data bytes in object
7436#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
7440#    subu $t0,$t0,$t2 # place to store last character (plus 9)
