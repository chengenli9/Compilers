716:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
716#    subu $t0,$t1,$sp # number of chars we read (times 4)
720#    srl $s6,$t0,2 # number of words on stack with chars
724#    subu $sp,$sp,4 # push char-count ...
728#    sw $s6,($sp) # ... onto stack
732#    addu $t2,$t0,5 # GC tag, incl. for count-word
736#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
740#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
744#    srl $s6,$s6,2  # data words in object
748#    move $s7,$zero # object words in object
752#    jal newObject  # allocate space
    
    # store header words
756#    la $t0,CLASS_String
760#    sw $t0,-12($s7)# store class tag (String) into object
764#    lw $t2,4($sp) # char-count
768#    sll $t1,$t2,2 # 4 times number of chars
772#    subu $t2,$zero,$t2 # negative of char-count
776#    sw $t2,-4($s7) # store negative char-count as header-word 2

