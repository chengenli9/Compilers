1221##...slt $at,$zero,$t0
1225##...bne $at,$zero,1268
1228#    beq $t0,$zero,riSkipWhiteLoop # start over if space
1232#    subu $t0,$v0,10
1236#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
1240#    subu $t0,$v0,9
1244#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
1248#    subu $t0,$v0,13
1252#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
1256#    subu $t0,$v0,12
1260#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
1264#    j badIntegerFormat # illegal integer char: abort program

1268:  nonWhite:
1268#    subu $t0,$v0,'-'
1272#    li $t4,1 # final multiplier
1276#    bne $t0,$zero,helpReadInt # go read
1280#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
1284#    jal readLogicalChar

1288:  helpReadInt:
1288#    li $t2,10
1292#    subu $t1,$v0,'0' # convert digit to 0-9 value
