    ###########################################################

    # set up the forwarding pointer
12148#    sw $zero,-8($t1) # 0 in first header-slot
12152#    sw $t2,-4($t1) # forwarding pointer in second header-slot

    # update the stack slot with the address in the target space
12156#    sw $t2,4($t0)
12160#    lw $zero,-8($t2)
12164#    lw $zero,-4($t2)

    # go handle next stack slot (testing if done)
12168#    j gcTestIterDone1

12172:  gcBump:
    #### we have a GC tag.  Bytes to skip: tag value + 3.
12172#    subu $t0,$t0,$t1
12176#    subu $t0,$t0,3

12180:  gcTestIterDone1:
12180#    bgeu $t0,$sp,gcStackCopyLoop
12181##...sltu $at,$t0,$sp
12185##...beq $at,$zero,11996

    ###### end outer loop to copy all stack-direct objects ######

    #############################################################
    # We have finished processing the stack elements.  Now we need
    # to update elements in the heap itself. This may itself involve
    # moving additional objects
    #############################################################

    #########################################################
    # At this point:
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # We want to set things up so that in addition:
    # - $t0 is the "trailing finger", containing the address
    #   of the first slot in target space that we have yet
    #   to process.
    # Then during processing:
    # - $t1 will contain the contents of the heap slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # And when we're actually copying an object:
    # - $t2 will contain pointer to the target object
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - available for use: $s0
    ##########################################################

    # set $t0 to be at the beginning of target-space
12188#    lw $t1,cur_seg
12192#    la $t0,seg0_start
12196#    beq $t1,$zero,gcSkip4
12200#    la $t0,seg1_start
12201##...lui $t0,16
12205##...addiu $t0,$t0,13952


12208:  gcSkip4:

    # if there were no objects put into the heap during stack
    # processing, we're done, so go finish up
12208#    bgeu $t0,$s3,gcFinishUp
12209##...sltu $at,$t0,$s3
12213##...beq $at,$zero,12504

    ###### begin outer loop to copy all non-stack-direct objects ######

12216:  gcHeapCopyLoop:
    # get data count for object; swap header-word with first word
    # of object so that they're back in the right place
12216#    lw $t1,($t0) # (what will be) first header word for current object
12220#    move $t2,$t1 # number data bytes in object (poss. w/hash bits)
12224#    bge $t2,$zero,gcSkip4a # are there hash bits?
12225##...slt $at,$t2,$zero
12229##...beq $at,$zero,12244
12232#    and $t2,0xff # mask off hash bits
12233##...lui $at,0
12237##...ori $at,$at,0xff
12241##...and $t2,$t2,$at
12244:gcSkip4a:    
12244#    sll $t2,$t2,2 # # data bytes
12248#    addu $t2,$t2,8 # to skip header words
12252#    addu $t2,$t0,$t2 # pointer to new object
12256#    lw $t3,-8($t2) # word to swap
12260#    sw $t1,-8($t2) # store header word
12264#    sw $t3,($t0) # restore first word of object

    ################################################
    # at this point:
    # - $t2 contains the pointer to our new object
    ################################################

    # check if we have a data array
12268#    lw $t1,-12($t2) # vtable pointer
12272#    li $t0,dataArrayVTableStart # address of vtable for first data array
12276#    blt $t1,$t0,gcNotDataArray # if data array, no more xforming to do
12277##...slt $at,$t1,$t0
12281##...bne $at,$zero,12300

    # We have a vtable address that is a data array.
    # we need skip over it then loop back to do next object.
12284:  skipToNextObj:
12284#    lw $t1,-4($t2) # data words in (object position of) array
    #### note: we know that it's not a string, so the value will
    #### not be artificially negative
12288#    sll $t1,$t1,2 # convert to byte-count
12292#    addu $t0,$t2,$t1 # skip over object
12296#    j gcTestIterDone2 # go do next object, if any

    ###################################################
    # at this point:
    # - the object has been restored to normal status--that is, the
    #   word-swap has been done
    # - $t2 contains a pointer to the object
    ###################################################
    
12300:  gcNotDataArray:
12300#    lw $t3,-4($t2) # # object words (negative treated as zero)
12304#    bge $t3,$zero,gcH2Neg2
12305##...slt $at,$t3,$zero
12309##...beq $at,$zero,12316
12312#    move $t3,$zero
12316:  gcH2Neg2:
12316#    sll $t3,$t3,2 # # object bytes
12320#    move $t0,$t2 # address of first pointer in object
12324#    add $s1,$t2,$t3 # limit address for this object

    #####################################################
    # At this point, we have to "translate" all pointers,
    # starting at $t0 to (but not including) $s1
    #####################################################

    # if there are no pointer-slots (i.e., $t0=$s1), skip this
    # part
12328#    beq $t0,$s1,gcTestIterDone2
    
12332:  gcNextPointerInObject:
    # get pointer from object
12332#    lw $t1,($t0)

    # if value is out of range, and is therefore does not refer
    # to an object, just go loop back and do the next one
12336#    bleu $t1,$t6,gcGoNextPointerSlot
12337##...sltu $at,$t6,$t1
12341##...beq $at,$zero,12484
12344#    bgtu $t1,$t7,gcGoNextPointerSlot
12345##...sltu $at,$t7,$t1
12349##...bne $at,$zero,12484

    # if the object has already been moved, update the stack-value
    # via the forwarding pointer
12352#    lw $t8,-8($t1) # possible forwarding tag
12356#    bne $t8,$zero,gcNoForward2 # if not forwarding tag, go copy
12360#    lw $t8,-4($t1) # forwarding pointer: object's new address
12364#    sw $t8,($t0) # update pointer in object
12368#    j gcGoNextPointerSlot # do next iteration

12372:  gcNoForward2:
    #########################################################
    # we actually need to copy the object into the new space
    #########################################################

    #########################################################
    # At this point:
    # - $t0 contains the address of the heap-slot we're translating
    # - $t1 will contain the contents of the heap-slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space, which will also be the first address
    #   of the target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # Then during processing:
    # And when we're actually copying an object:
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $t8 will contain a pointer to the target object
    # - available for use: $s0, $t8, $t9
    ##########################################################

    # compute the amount of space that is needed
12372#    bge $t8,$zero,gcSkip5 # # words in negative-offset portion
12373##...slt $at,$t8,$zero
12377##...beq $at,$zero,12392
12380#    and $t8,0xff # mask off hash bits
12381##...lui $at,0
12385##...ori $at,$at,0xff
12389##...and $t8,$t8,$at

12392:  gcSkip5:
12392#    sll $t8,$t8,2 # bytes in negative-offset portion ...
12396#    addu $t8,$t8,8 # ... add in bytes for header-words
12400#    subu $t4,$t1,$t8 # address of first word of source object
12404#    lw $t3,-4($t1) # # words in positive-offset portion
12408#    bge $t3,$zero,gcNoNeg
12409##...slt $at,$t3,$zero
12413##...beq $at,$zero,12420
12416#    move $t3,$zero # negative treated as zero
12420:  gcNoNeg:
12420#    sll $t3,$t3,2 # bytes in negative-offset portion
12424#    addu $t3,$t3,$t1 # address one word past last word of source

12428#    addu $t8,$s3,$t8 # pointer to target object

    #########################################################
    # At this point:
    # - $t0 contains the address of the stack slot we'll
    #   process next
    # - $t1 contains the contents of the stack slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $t8 contains the pointer to the target object
    # - $s1 contains the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0, $t9
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger"
12432#    lw $s0,($t4)
12436#    lw $t9,-8($t1)
12440#    sw $t9,($t4)
12444#    sw $s0,-8($t1)

    # copy all source bytes to the target
12448:  gCinnerCopy2:
12448#    lw $s0,($t4)
12452#    sw $s0,($s3)
12456#    addu $t4,$t4,4
12460#    addu $s3,$s3,4
12464#    bltu $t4,$t3,gCinnerCopy2
12465##...sltu $at,$t4,$t3
12469##...bne $at,$zero,12448

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
12472#    sw $zero,-8($t1) # 0 in first header-slot
12476#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
12480#    sw $t8,($t0)

12484:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
12484#    addu $t0,$t0,4
12488#    bltu $t0,$s1,gcNextPointerInObject
12489##...sltu $at,$t0,$s1
12493##...bne $at,$zero,12332

12496:  gcTestIterDone2:
12496#    bltu $t0,$s3,gcHeapCopyLoop
12497##...sltu $at,$t0,$s3
12501##...bne $at,$zero,12216

    ###### end outer loop to copy all non-stack-direct objects ######

12504:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
12504#    lw $s2,($sp)
12508#    addu $sp,$sp,4

    # mark us as having already GC'd
12512#    move $t5,$s5

    # go try and allocate again
12516#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
12520:vm_init:

    # mark bottom of stack
12520#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
12524#    move $s2,$zero

    #set up the "five" register
12528#    li $s5,5

12532#    la $s3,seg0_start
12536#    la $s4,seg0_end
12537##...lui $s4,16
12541##...addiu $s4,$s4,13952
    
    # return
12544#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
12548:divide:
    # get parameters; abort if divisor zero
12548#    lw $t0,($sp)
12552#    lw $t1,8($sp)
12556#    beq $t0,$zero,divByZeroError
    
    # perform division
12560#    div $t1,$t0
12564#    mflo $t0

    # store result, adjust stack and return
12568#    addu $sp,$sp,8 # adjust stack
12572#    sw $t0,($sp) # store result
12576#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
12580:remainder:
    # get parameters; abort if divisor zero
12580#    lw $t0,($sp)
12584#    lw $t1,8($sp)
12588#    beq $t0,$zero,divByZeroError
    
    # perform division
12592#    div $t1,$t0
12596#    mfhi $t0

    # store result, adjust stack and return
12600#    addu $sp,$sp,8 # adjust stack
12604#    sw $t0,($sp) # store result
12608#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
12612:checkCast:
    # get object, allow immediately if null
12612#    lw $t2,($sp)
12616#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
12620#    lw $t2,-12($t2) # vtable address
12624#    bge $t2,$t1,castException
12625##...slt $at,$t2,$t1
12629##...beq $at,$zero,12764
12632#    blt $t2,$t0,castException
12633##...slt $at,$t2,$t0
12637##...bne $at,$zero,12764
    
    # return, leaving object unchanged on stack
12640:  checkCastReturn:    
12640#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
12644:instanceOf:
    # get object, go return false if null
12644#    lw $t2,($sp)
12648#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
12652#    lw $t2,-12($t2) # vtable address
12656#    sge $t0,$t2,$t0 # are we >= the lower limit?
12657##...slt $t0,$t2,$t0
12661##...xori $t0,$t0,0x1
12664#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
12668#    and $t2,$t0,$t1
12672#    sw $t2,($sp)
12676:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
12676#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

12680:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
12680#    li $v0,4 # syscall-code for print-string
12684#    syscall
12688:exit:
    # print termination message
12688#    li $v0,4 # syscall-code for print-string
12692#    la $a0,exitString
12696#    syscall

    # terminate execution
12700#    li $v0,10 #syscall-code for "exit"
12704#    syscall

12708:outOfHeapMemory:
12708#    la $a0,heapMemoryMsg
12712#    j exitError
12716:divByZeroError:
12716#    la $a0,divByZeroMsg
12720#    j exitError
12724:strIndexOutOfBounds:
12724#    la $a0,strIndexOutOfBoundsMsg
12728#    j exitError
12732:arrayIndexOutOfBounds:
12732#    la $a0,arrayIndexOutOfBoundsMsg
12736#    j exitError
12740:arraySizeOutOfBounds:
12740#    la $a0,arraySizeOutOfBoundsMsg
12744#    j exitError
12748:nullPtrException:
12748#    la $a0,nullPtrExceptionMsg
12752#    j exitError
12756:badIntegerFormat:
12756#    la $a0,badIntegerFormatMsg
12760#    j exitError
12764:castException:
12764#    la $a0,castExceptionMsg
12768#    j exitError
############## data section ################
    .data
13588:hexChars:
    .ascii "0123456789abcdef"
    .align 2
13604:cur_seg:
    .word 0

13608:lastCharRead:
    .word -2 # -2 => no buffered character
13612:prevHashConstant:
    .word 0x2785173c
13616:gcCount:
    .word 0

13620:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
13647:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
13670:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
13705:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
13739:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
13772:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
13803:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
13851:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
13872:gcMsg: 
      .asciiz "\nGC!\n"
13878:gcCountMsg: 
      .asciiz "Number of garbage collections: "

13910:nullStr:
    .asciiz "null"
13915:trueString:
    .asciiz "true"
13920:falseString:
    .asciiz "false"
