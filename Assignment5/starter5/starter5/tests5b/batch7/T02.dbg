    # store data in string
9808#    sb $t1,-16($s7)
    
    # store negative of size in header-word 2
9812#    li $t0,-1
9816#    sw $t0,-4($s7)

    # we're returning $s7
9820#    move $t0, $s7

    # restore $ra, and pop return address and return string off stack
9824#    lw $ra,4($sp)
9828#    addu $sp,$sp,8

    # return
9832#    jr $ra
