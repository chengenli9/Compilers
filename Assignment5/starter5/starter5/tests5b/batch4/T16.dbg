###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
3328:mth_readLine_Lib:
    
3328#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
3332#    sw $ra, 4($sp) # save $ra
3336#    move $t1,$sp # save "original" sp

3340:  doRead:

    # read the character
3340#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
3344#    subu $t2,$v0,13
3348#    bne $t2,$zero,notReturnRL
3352#    jal readLogicalChar
3356#    subu $t2,$v0,10 # check for newline
3360#    beq $t2,$zero,foundNewLine
3364#    sw $v0,lastCharRead # push back character into queue
3368#    j foundNewLine # go process the line

3372:  notReturnRL:

    # at this point, $v0 has our character

3372#    subu $t0,$v0,10
3376#    beq $t0,$zero,foundNewLine
3380#    blt $v0,$zero,foundEof
3381##...slt $at,$v0,$zero
3385##...bne $at,$zero,3400

    # we have a character, so push it onto stack
3388#    subu $sp,$sp,4
3392#    sw $v0,($sp)

    # loop back up to get next character
3396#    j doRead

3400:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
3400#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
3404#    li $s7, 0 # return-value: null
3408#    j rlReturn # return

3412:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
3412#    subu $t0,$t1,$sp # number of chars we read (times 4)
3416#    srl $s6,$t0,2 # number of words on stack with chars
3420#    subu $sp,$sp,4 # push char-count ...
3424#    sw $s6,($sp) # ... onto stack
3428#    addu $t2,$t0,5 # GC tag, incl. for count-word
3432#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
3436#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
3440#    srl $s6,$s6,2  # data words in object
3444#    move $s7,$zero # object words in object
3448#    jal newObject  # allocate space
    
    # store header words
3452#    la $t0,CLASS_String
3456#    sw $t0,-12($s7)# store class tag (String) into object
3460#    lw $t2,4($sp) # char-count
3464#    sll $t1,$t2,2 # 4 times number of chars
3468#    subu $t2,$zero,$t2 # negative of char-count
3472#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
3476#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
3480#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
3481##...slt $at,$t0,$zero
3485##...beq $at,$zero,3504
3488#    and $t0,0xff # mask off object's hash value ...
3489##...lui $at,0
3493##...ori $at,$at,0xff
3497##...and $t0,$t0,$at
3500#    sw $t0,-8($s7) # ... and store back into -8 header-word
3504:  skipMask_readLine:

3504#    sll $t0,$t0,2 # data bytes in object
3508#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
3512#    subu $t0,$t0,$t2 # place to store last character (plus 9)
3516#    addu $sp,$sp,8 # pop redundant object-pointer and count
3520#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

3524#    beq $sp,$t1,rlReturn
3528:  charCopyLoop:
3528#    lw $t2,($sp)
3532#    sb $t2,-9($t0)
3536#    addu $sp,$sp,4
3540#    subu $t0,$t0,1
3544#    bne $sp,$t1,charCopyLoop
3548:  rlReturn:

3548#    lw $ra, 4($sp)
3552#    addu $sp, 8   # pop $ra and pointless word off stack
3556#    move $t0, $s7 # return string we allocated in $s7
3560#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
3564:mth_readInt_Lib:

    # save $ra by pushing onto stack
3564#    subu $sp,$sp,4
3568#    sw $ra,($sp)

3572:  riSkipWhiteLoop:
    # read a character
3572#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
3576#    subu $t0,$v0,32
3580#    bgt $t0,$zero,nonWhite
3581##...slt $at,$zero,$t0
3585##...bne $at,$zero,3628
3588#    beq $t0,$zero,riSkipWhiteLoop # start over if space
3592#    subu $t0,$v0,10
3596#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
3600#    subu $t0,$v0,9
3604#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
3608#    subu $t0,$v0,13
3612#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
3616#    subu $t0,$v0,12
3620#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
3624#    j badIntegerFormat # illegal integer char: abort program

3628:  nonWhite:
3628#    subu $t0,$v0,'-'
3632#    li $t4,1 # final multiplier
3636#    bne $t0,$zero,helpReadInt # go read
3640#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
3644#    jal readLogicalChar

3648:  helpReadInt:
3648#    li $t2,10
3652#    subu $t1,$v0,'0' # convert digit to 0-9 value
3656#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
3657##...sltu $at,$t1,$t2
3661##...beq $at,$zero,5944
3664#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

3668:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

3668#    jal readLogicalChar # read next character
3672#    subu $t1,$v0,'0' # convert digit to 0-9 value
3676#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
3677##...sltu $at,$t1,$t2
3681##...beq $at,$zero,3700

3684#    mul $t3,$t3,$t2 # multiply old value by 10
3685##...mult $t3,$t2
3689##...mflo $t3
3692#    addu $t3,$t3,$t1 # add in value of new digit
3696#    j digitLoop

3700:  doneDigitLoop:

    # "push back" unused character into queue
3700#    sw $v0,lastCharRead

    # restore return address
3704#    lw $ra,($sp)
3708#    addu $sp, 4

    # multiply by sign and put return value in $t0
3712#    mult $t3,$t4 # multiply to account for poss. minus sign
3716#    mflo $t3
3720#    move $t0, $t3
    
    # return
3724#    jr $ra

###################################################################
# readChar() - library method (class Lib)
# - reads a single character from standard input
# - returns the integer that is the encoding of the character
# - returns -1 if end of file was encountered
# - parameter:
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
3728:mth_readChar_Lib:
