4257##...sltu $at,$t6,$t1
4261##...beq $at,$zero,4404
4264#    bgtu $t1,$t7,gcGoNextPointerSlot
4265##...sltu $at,$t7,$t1
4269##...bne $at,$zero,4404

    # if the object has already been moved, update the stack-value
    # via the forwarding pointer
4272#    lw $t8,-8($t1) # possible forwarding tag
4276#    bne $t8,$zero,gcNoForward2 # if not forwarding tag, go copy
