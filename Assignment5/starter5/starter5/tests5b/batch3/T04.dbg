########################################################
# intToString(n) - library method (class Lib)
# converts int to string: Java: ""+n
# - parameters:
#   - ($sp) - the value to convert, n
#   - 4($sp) - GC tag
#   - 8($sp) - old-this-pointer
#   - $s2 - this-pointer
# - returns:
#   - $t0 - the string, which is the string representation of
#     the integer
########################################################
4012:mth_intToString_Lib:

    # save return address on stack; allocate space for dummy GC tag
4012#    subu $sp,$sp,8
4016#    sw $ra,4($sp)

    # save current sp
4020#    move $t0,$sp

    # move constant 10 into $t3 
    # (Good, I didn't know what li did, I'm glad this comment was here)
    # * slams head through wall *
4024#    li $t3,10

    # get argument, negate if negative
4028#    lw $t1,8($sp)
4032#    bge $t1,$zero,itsNonNegLoop
4033##...slt $at,$t1,$zero
4037##...beq $at,$zero,4044
4040#    subu $t1,$zero,$t1

    # loop through, computing unsigned remainder by 10, and
    # storing digits on stack until we reach 0
4044:  itsNonNegLoop:
4044#    divu $t1,$t3
4048#    mflo $t1 # quotient
4052#    mfhi $t4 # remainder
4056#    addu $t4,$t4,'0' # turn remainder into digit
4060#    subu $sp,$sp,4
4064#    sw $t4,($sp) # push digit onto stack
4068#    bne $t1,$zero,itsNonNegLoop

    # push '-' if negative
4072#    lw $t4,8($t0)
4076#    bge $t4,$zero,itsSkipNeg
4077##...slt $at,$t4,$zero
4081##...beq $at,$zero,4096
4084#    li $t4,'-'
4088#    subu $sp,$sp,4
4092#    sw $t4,($sp)
4096:  itsSkipNeg:

    ################################################
    # At this point, all of our digits have been pushed
    # onto the stack.  $sp points to the first one;
    # $t0 contains the limit-pointer (into which we need to
    # write a GC tag).
    ################################################

    # compute number of characters on stack (one word per character);
    # write GC tag onto stack; push char-count onto stack
4096#    subu $s6,$t0,$sp
4100#    addu $t3,$s6,5 # GC tag (including for count-word, about to be pushed)
4104#    sw $t3,($t0)
4108#    srl $s6,$s6,2
4112#    subu $sp,$sp,4
4116#    sw $s6,($sp)
    
    # allocate memory
4120#    addu $s6,$s6,7 # 3 to round up, plus 4 for vtable word
4124#    srl $s6,$s6,2
4128#    move $s7,$zero # no "object" words in object
4132#    jal newObject

    # restore char-count; pop it and return value from 'newObject'
4136#    lw $t0,4($sp)
4140#    addu $sp,$sp,8

    # store "String" tag into class field
4144#    subu $s7,$s7,8 # address of header-1 word
4148#    la $t1,CLASS_String
4152#    sw $t1,-4($s7)
        
    # mask off hash bits, if needed
4156#    lw $t4,($s7) # # data words in source string
4160#    bge $t4,$zero,skipMask_intToString # don't strip hash code if not there
4161##...slt $at,$t4,$zero
4165##...beq $at,$zero,4184
4168#    and $t4,0xff # mask off object's hash value ...
4169##...lui $at,0
4173##...ori $at,$at,0xff
4177##...and $t4,$t4,$at
4180#    sw $t4,($s7) # ... and store back into -8 header-word
4184:skipMask_intToString:
    
    # store negative of char-count into header-2 word
4184#    subu $t0,$zero,$t0
4188#    sw $t0,4($s7)

4192#    lw $t1,($s7) # number of data words in string
4196#    sll $t1,$t1,2 # number data bytes in string
4200#    subu $t1,$s7,$t1 # first location to store chars in string
4204#    subu $t0,$t1,$t0 # limit address for chars in string

    ####################################################
    # at this point:
    # - $sp contains first source character address
    # - $t1 contains first target character address
    # - $t0 contains target-limit address
    ####################################################

    # loop through and copy all elements as we pop them off the stack.
    # (In this case, we know that there is it least one.)
4208:  itsLoop:
4208#    lw $t2,($sp)
4212#    addu $sp,$sp,4
