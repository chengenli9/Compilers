###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
1612:mth_readLine_Lib:
    
1612#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
1616#    sw $ra, 4($sp) # save $ra
1620#    move $t1,$sp # save "original" sp

1624:  doRead:

    # read the character
1624#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
1628#    subu $t2,$v0,13
1632#    bne $t2,$zero,notReturnRL
1636#    jal readLogicalChar
1640#    subu $t2,$v0,10 # check for newline
1644#    beq $t2,$zero,foundNewLine
1648#    sw $v0,lastCharRead # push back character into queue
1652#    j foundNewLine # go process the line

1656:  notReturnRL:

    # at this point, $v0 has our character

1656#    subu $t0,$v0,10
1660#    beq $t0,$zero,foundNewLine
1664#    blt $v0,$zero,foundEof
1665##...slt $at,$v0,$zero
1669##...bne $at,$zero,1684

    # we have a character, so push it onto stack
1672#    subu $sp,$sp,4
1676#    sw $v0,($sp)

    # loop back up to get next character
1680#    j doRead

1684:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
1684#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
1688#    li $s7, 0 # return-value: null
1692#    j rlReturn # return

1696:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
1696#    subu $t0,$t1,$sp # number of chars we read (times 4)
1700#    srl $s6,$t0,2 # number of words on stack with chars
1704#    subu $sp,$sp,4 # push char-count ...
1708#    sw $s6,($sp) # ... onto stack
1712#    addu $t2,$t0,5 # GC tag, incl. for count-word
1716#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
1720#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
1724#    srl $s6,$s6,2  # data words in object
1728#    move $s7,$zero # object words in object
1732#    jal newObject  # allocate space
    
    # store header words
1736#    la $t0,CLASS_String
1740#    sw $t0,-12($s7)# store class tag (String) into object
1744#    lw $t2,4($sp) # char-count
1748#    sll $t1,$t2,2 # 4 times number of chars
1752#    subu $t2,$zero,$t2 # negative of char-count
1756#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
1760#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
1764#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
1765##...slt $at,$t0,$zero
1769##...beq $at,$zero,1788
1772#    and $t0,0xff # mask off object's hash value ...
1773##...lui $at,0
1777##...ori $at,$at,0xff
1781##...and $t0,$t0,$at
1784#    sw $t0,-8($s7) # ... and store back into -8 header-word
1788:  skipMask_readLine:

1788#    sll $t0,$t0,2 # data bytes in object
1792#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
1796#    subu $t0,$t0,$t2 # place to store last character (plus 9)
1800#    addu $sp,$sp,8 # pop redundant object-pointer and count
1804#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

1808#    beq $sp,$t1,rlReturn
1812:  charCopyLoop:
1812#    lw $t2,($sp)
1816#    sb $t2,-9($t0)
1820#    addu $sp,$sp,4
1824#    subu $t0,$t0,1
1828#    bne $sp,$t1,charCopyLoop
1832:  rlReturn:

1832#    lw $ra, 4($sp)
1836#    addu $sp, 8   # pop $ra and pointless word off stack
1840#    move $t0, $s7 # return string we allocated in $s7
1844#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
1848:mth_readInt_Lib:

    # save $ra by pushing onto stack
1848#    subu $sp,$sp,4
1852#    sw $ra,($sp)

1856:  riSkipWhiteLoop:
    # read a character
1856#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
1860#    subu $t0,$v0,32
1864#    bgt $t0,$zero,nonWhite
1865##...slt $at,$zero,$t0
1869##...bne $at,$zero,1912
1872#    beq $t0,$zero,riSkipWhiteLoop # start over if space
1876#    subu $t0,$v0,10
1880#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
1884#    subu $t0,$v0,9
1888#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
1892#    subu $t0,$v0,13
1896#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
1900#    subu $t0,$v0,12
1904#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
1908#    j badIntegerFormat # illegal integer char: abort program

1912:  nonWhite:
1912#    subu $t0,$v0,'-'
1916#    li $t4,1 # final multiplier
1920#    bne $t0,$zero,helpReadInt # go read
1924#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
1928#    jal readLogicalChar

1932:  helpReadInt:
1932#    li $t2,10
1936#    subu $t1,$v0,'0' # convert digit to 0-9 value
1940#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
1941##...sltu $at,$t1,$t2
1945##...beq $at,$zero,4192
1948#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

1952:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

1952#    jal readLogicalChar # read next character
1956#    subu $t1,$v0,'0' # convert digit to 0-9 value
1960#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
1961##...sltu $at,$t1,$t2
1965##...beq $at,$zero,1984

1968#    mul $t3,$t3,$t2 # multiply old value by 10
1969##...mult $t3,$t2
1973##...mflo $t3
1976#    addu $t3,$t3,$t1 # add in value of new digit
1980#    j digitLoop

1984:  doneDigitLoop:

    # "push back" unused character into queue
1984#    sw $v0,lastCharRead

    # restore return address
1988#    lw $ra,($sp)
1992#    addu $sp, 4

    # multiply by sign and put return value in $t0
1996#    mult $t3,$t4 # multiply to account for poss. minus sign
2000#    mflo $t3
2004#    move $t0, $t3
    
    # return
2008#    jr $ra

###################################################################
# readChar() - library method (class Lib)
# - reads a single character from standard input
# - returns the integer that is the encoding of the character
# - returns -1 if end of file was encountered
# - parameter:
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
2012:mth_readChar_Lib:

    # save $ra by pushing onto stack
2012#    subu $sp,$sp,4
2016#    sw $ra,($sp)

      # read the character
2020#    jal readLogicalChar

    # restore return address; put value in $t0
    # replacing this-pointer saved return address
2024#    lw $ra,($sp)
2028#    addu $sp, 4
2032#    move $t0, $v0

    # return
2036#    jr $ra

########################################################
# printStr(str) - library method (class Lib)
# - prints string to standard output
# parameters:
#   - ($sp) - the string to print
#   - 4($sp) - old-this-pointer
########################################################
2040:mth_printStr_Lib:
    # check for null, printing "(null)", if so
2040#    lw $t0,($sp)
2044#    bne $t0,$zero,psNotNull

    # print "(null)"
2048#    la $a0,nullStr
2052#    li $v0,4
2056#    syscall
2060#    j donePrintStr
    
2064:  psNotNull:
    ##### we have a non-null string #####
    # this means that:
    # - number of data words in -8($t0):
    #   - if the sign bit is 1, the low 31 bits
    #   - if the sign bit is 0, the low 8 bits
    # - negative of number of characters in string is in -4($t0)
    # - string begins at $t0-8-(#dataWords*4), stored 1 char per byte
2064#    subu $t0,$t0,8
2068#    lw $t1,($t0) # number of data words, but needs modification
2072#    blt $t1,$zero,skipPrintStr1
