4152#    bne $t2,$zero,gcNoForward1 # if not forwarding tag, go copy
4156#    lw $t2,-4($t1) # forwarding pointer: object's new address
4160#    sw $t2,4($t0) # update stack value
4164#    j gcTestIterDone1 # do next iteration
