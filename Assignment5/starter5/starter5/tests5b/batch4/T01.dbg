3012#    seq $t0,$t0,$zero
3013##...subu $at,$t0,$zero
3017##...sltiu $t0,$at,1

    # pop return address and return $t0
3020#    lw $ra,($sp)
3024#    addu $sp,4

3028#    jr $ra # return
    
3032:goEsFalse:
    # put 0 in $t0 and return
3032#    li $t0, 0
