6396:  gcH2Neg2:
6396#    sll $t3,$t3,2 # # object bytes
6400#    move $t0,$t2 # address of first pointer in object
6404#    add $s1,$t2,$t3 # limit address for this object

    #####################################################
    # At this point, we have to "translate" all pointers,
    # starting at $t0 to (but not including) $s1
    #####################################################

    # if there are no pointer-slots (i.e., $t0=$s1), skip this
    # part
6408#    beq $t0,$s1,gcTestIterDone2
    
6412:  gcNextPointerInObject:
    # get pointer from object
6412#    lw $t1,($t0)

    # if value is out of range, and is therefore does not refer
    # to an object, just go loop back and do the next one
6416#    bleu $t1,$t6,gcGoNextPointerSlot
6417##...sltu $at,$t6,$t1
6421##...beq $at,$zero,6564
6424#    bgtu $t1,$t7,gcGoNextPointerSlot
6425##...sltu $at,$t7,$t1
6429##...bne $at,$zero,6564

    # if the object has already been moved, update the stack-value
    # via the forwarding pointer
6432#    lw $t8,-8($t1) # possible forwarding tag
6436#    bne $t8,$zero,gcNoForward2 # if not forwarding tag, go copy
6440#    lw $t8,-4($t1) # forwarding pointer: object's new address
6444#    sw $t8,($t0) # update pointer in object
6448#    j gcGoNextPointerSlot # do next iteration

6452:  gcNoForward2:
    #########################################################
    # we actually need to copy the object into the new space
    #########################################################

    #########################################################
    # At this point:
    # - $t0 contains the address of the heap-slot we're translating
    # - $t1 will contain the contents of the heap-slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space, which will also be the first address
    #   of the target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # Then during processing:
    # And when we're actually copying an object:
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $t8 will contain a pointer to the target object
    # - available for use: $s0, $t8, $t9
    ##########################################################

    # compute the amount of space that is needed
6452#    bge $t8,$zero,gcSkip5 # # words in negative-offset portion
6453##...slt $at,$t8,$zero
6457##...beq $at,$zero,6472
6460#    and $t8,0xff # mask off hash bits
6461##...lui $at,0
6465##...ori $at,$at,0xff
6469##...and $t8,$t8,$at

6472:  gcSkip5:
6472#    sll $t8,$t8,2 # bytes in negative-offset portion ...
6476#    addu $t8,$t8,8 # ... add in bytes for header-words
6480#    subu $t4,$t1,$t8 # address of first word of source object
6484#    lw $t3,-4($t1) # # words in positive-offset portion
6488#    bge $t3,$zero,gcNoNeg
6489##...slt $at,$t3,$zero
6493##...beq $at,$zero,6500
6496#    move $t3,$zero # negative treated as zero
6500:  gcNoNeg:
6500#    sll $t3,$t3,2 # bytes in negative-offset portion
6504#    addu $t3,$t3,$t1 # address one word past last word of source

6508#    addu $t8,$s3,$t8 # pointer to target object

    #########################################################
    # At this point:
    # - $t0 contains the address of the stack slot we'll
    #   process next
    # - $t1 contains the contents of the stack slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $t8 contains the pointer to the target object
    # - $s1 contains the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0, $t9
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger"
6512#    lw $s0,($t4)
6516#    lw $t9,-8($t1)
6520#    sw $t9,($t4)
6524#    sw $s0,-8($t1)

    # copy all source bytes to the target
6528:  gCinnerCopy2:
6528#    lw $s0,($t4)
6532#    sw $s0,($s3)
6536#    addu $t4,$t4,4
6540#    addu $s3,$s3,4
6544#    bltu $t4,$t3,gCinnerCopy2
6545##...sltu $at,$t4,$t3
6549##...bne $at,$zero,6528

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
6552#    sw $zero,-8($t1) # 0 in first header-slot
6556#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
6560#    sw $t8,($t0)

6564:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
6564#    addu $t0,$t0,4
6568#    bltu $t0,$s1,gcNextPointerInObject
6569##...sltu $at,$t0,$s1
6573##...bne $at,$zero,6412

6576:  gcTestIterDone2:
6576#    bltu $t0,$s3,gcHeapCopyLoop
6577##...sltu $at,$t0,$s3
6581##...bne $at,$zero,6296

    ###### end outer loop to copy all non-stack-direct objects ######

6584:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
6584#    lw $s2,($sp)
6588#    addu $sp,$sp,4

    # mark us as having already GC'd
6592#    move $t5,$s5

    # go try and allocate again
6596#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
6600:vm_init:

    # mark bottom of stack
6600#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
6604#    move $s2,$zero

    #set up the "five" register
6608#    li $s5,5

6612#    la $s3,seg0_start
6616#    la $s4,seg0_end
6617##...lui $s4,16
6621##...addiu $s4,$s4,7936
    
    # return
6624#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
6628:divide:
    # get parameters; abort if divisor zero
6628#    lw $t0,($sp)
6632#    lw $t1,8($sp)
6636#    beq $t0,$zero,divByZeroError
    
    # perform division
6640#    div $t1,$t0
6644#    mflo $t0

    # store result, adjust stack and return
6648#    addu $sp,$sp,8 # adjust stack
6652#    sw $t0,($sp) # store result
6656#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
6660:remainder:
    # get parameters; abort if divisor zero
6660#    lw $t0,($sp)
6664#    lw $t1,8($sp)
6668#    beq $t0,$zero,divByZeroError
    
    # perform division
6672#    div $t1,$t0
6676#    mfhi $t0

    # store result, adjust stack and return
6680#    addu $sp,$sp,8 # adjust stack
6684#    sw $t0,($sp) # store result
6688#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
6692:checkCast:
    # get object, allow immediately if null
6692#    lw $t2,($sp)
6696#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
6700#    lw $t2,-12($t2) # vtable address
6704#    bge $t2,$t1,castException
6705##...slt $at,$t2,$t1
6709##...beq $at,$zero,6880
6712#    blt $t2,$t0,castException
6713##...slt $at,$t2,$t0
6717##...bne $at,$zero,6880
    
    # return, leaving object unchanged on stack
6720:  checkCastReturn:    
6720#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
6724:instanceOf:
    # get object, go return false if null
6724#    lw $t2,($sp)
6728#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
6732#    lw $t2,-12($t2) # vtable address
6736#    sge $t0,$t2,$t0 # are we >= the lower limit?
6737##...slt $t0,$t2,$t0
6741##...xori $t0,$t0,0x1
6744#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
6748#    and $t2,$t0,$t1
6752#    sw $t2,($sp)
6756:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
6756#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

6760:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
6760#    li $v0,4 # syscall-code for print-string
6764#    syscall
6768:exit:
    # print termination message
6768#    li $v0,4 # syscall-code for print-string
6772#    la $a0,exitString
6776#    syscall

    # print number of garbage collections
6780#    li $v0,4 # syscall-code for print-string
6784#    la $a0,gcCountMsg
6788#    syscall # print "Number of ..."
6792#    lw $a0,gcCount # number of GC's
6796#    li $v0,1 # code for print-int
6800#    syscall
6804#    li $v0,4 # syscall-code for print-string
6808#    la $a0,newlineString
6812#    syscall # print newline

    # terminate execution
6816#    li $v0,10 #syscall-code for "exit"
6820#    syscall

6824:outOfHeapMemory:
6824#    la $a0,heapMemoryMsg
6828#    j exitError
6832:divByZeroError:
6832#    la $a0,divByZeroMsg
6836#    j exitError
6840:strIndexOutOfBounds:
6840#    la $a0,strIndexOutOfBoundsMsg
6844#    j exitError
6848:arrayIndexOutOfBounds:
6848#    la $a0,arrayIndexOutOfBoundsMsg
6852#    j exitError
6856:arraySizeOutOfBounds:
6856#    la $a0,arraySizeOutOfBoundsMsg
6860#    j exitError
6864:nullPtrException:
6864#    la $a0,nullPtrExceptionMsg
6868#    j exitError
6872:badIntegerFormat:
6872#    la $a0,badIntegerFormatMsg
6876#    j exitError
6880:castException:
6880#    la $a0,castExceptionMsg
6884#    j exitError
############## data section ################
    .data
7564:hexChars:
    .ascii "0123456789abcdef"
    .align 2
7580:cur_seg:
    .word 0

7584:lastCharRead:
    .word -2 # -2 => no buffered character
7588:prevHashConstant:
    .word 0x2785173c
7592:gcCount:
    .word 0

7596:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
7623:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
7646:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
7681:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
7715:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
7748:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
7779:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
7827:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
7848:gcMsg: 
      .asciiz "\nGC!\n"
7854:gcCountMsg: 
      .asciiz "Number of garbage collections: "

7886:nullStr:
    .asciiz "null"
7891:trueString:
    .asciiz "true"
7896:falseString:
    .asciiz "false"
7902:exitString:
    .ascii "Program execution completed."
    #### "falls through" here
7930:newlineString:
    .asciiz "\n"
    
    .align 2
7932:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

7936:seg0_start:
    .space 0x100000
1056512:seg0_end:
1056512:seg1_start:
    .space 0x100000
2105088:seg1_end:
