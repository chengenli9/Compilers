7513##...sltu $at,$t0,$s1
7517##...bne $at,$zero,7356

7520:  gcTestIterDone2:
7520#    bltu $t0,$s3,gcHeapCopyLoop
7521##...sltu $at,$t0,$s3
7525##...bne $at,$zero,7240
