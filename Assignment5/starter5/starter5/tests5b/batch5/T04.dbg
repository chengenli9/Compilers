4501##...slt $at,$t4,$zero
4505##...beq $at,$zero,4524
4508#    and $t4,0xff # mask off object's hash value ...
4509##...lui $at,0
4513##...ori $at,$at,0xff
4517##...and $t4,$t4,$at
4520#    sw $t4,($s7) # ... and store back into -8 header-word
4524:skipMask_intToString:
    
    # store negative of char-count into header-2 word
4524#    subu $t0,$zero,$t0
