###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
3620:mth_readLine_Lib:
    
3620#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
3624#    sw $ra, 4($sp) # save $ra
3628#    move $t1,$sp # save "original" sp

3632:  doRead:

    # read the character
3632#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
3636#    subu $t2,$v0,13
3640#    bne $t2,$zero,notReturnRL
3644#    jal readLogicalChar
3648#    subu $t2,$v0,10 # check for newline
3652#    beq $t2,$zero,foundNewLine
3656#    sw $v0,lastCharRead # push back character into queue
3660#    j foundNewLine # go process the line

3664:  notReturnRL:

    # at this point, $v0 has our character

3664#    subu $t0,$v0,10
3668#    beq $t0,$zero,foundNewLine
3672#    blt $v0,$zero,foundEof
3673##...slt $at,$v0,$zero
3677##...bne $at,$zero,3692

    # we have a character, so push it onto stack
3680#    subu $sp,$sp,4
3684#    sw $v0,($sp)

    # loop back up to get next character
3688#    j doRead

3692:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
3692#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
3696#    li $s7, 0 # return-value: null
3700#    j rlReturn # return

3704:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
3704#    subu $t0,$t1,$sp # number of chars we read (times 4)
3708#    srl $s6,$t0,2 # number of words on stack with chars
3712#    subu $sp,$sp,4 # push char-count ...
3716#    sw $s6,($sp) # ... onto stack
3720#    addu $t2,$t0,5 # GC tag, incl. for count-word
3724#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
3728#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
3732#    srl $s6,$s6,2  # data words in object
3736#    move $s7,$zero # object words in object
3740#    jal newObject  # allocate space
    
    # store header words
3744#    la $t0,CLASS_String
3748#    sw $t0,-12($s7)# store class tag (String) into object
3752#    lw $t2,4($sp) # char-count
3756#    sll $t1,$t2,2 # 4 times number of chars
3760#    subu $t2,$zero,$t2 # negative of char-count
3764#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
3768#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
3772#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
3773##...slt $at,$t0,$zero
3777##...beq $at,$zero,3796
3780#    and $t0,0xff # mask off object's hash value ...
3781##...lui $at,0
3785##...ori $at,$at,0xff
3789##...and $t0,$t0,$at
3792#    sw $t0,-8($s7) # ... and store back into -8 header-word
3796:  skipMask_readLine:

3796#    sll $t0,$t0,2 # data bytes in object
3800#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
3804#    subu $t0,$t0,$t2 # place to store last character (plus 9)
3808#    addu $sp,$sp,8 # pop redundant object-pointer and count
3812#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

3816#    beq $sp,$t1,rlReturn
3820:  charCopyLoop:
3820#    lw $t2,($sp)
3824#    sb $t2,-9($t0)
3828#    addu $sp,$sp,4
3832#    subu $t0,$t0,1
3836#    bne $sp,$t1,charCopyLoop
3840:  rlReturn:

3840#    lw $ra, 4($sp)
3844#    addu $sp, 8   # pop $ra and pointless word off stack
3848#    move $t0, $s7 # return string we allocated in $s7
3852#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
3856:mth_readInt_Lib:

    # save $ra by pushing onto stack
3856#    subu $sp,$sp,4
3860#    sw $ra,($sp)

3864:  riSkipWhiteLoop:
    # read a character
3864#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
3868#    subu $t0,$v0,32
3872#    bgt $t0,$zero,nonWhite
3873##...slt $at,$zero,$t0
3877##...bne $at,$zero,3920
3880#    beq $t0,$zero,riSkipWhiteLoop # start over if space
3884#    subu $t0,$v0,10
3888#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
3892#    subu $t0,$v0,9
3896#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
3900#    subu $t0,$v0,13
3904#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
3908#    subu $t0,$v0,12
3912#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
3916#    j badIntegerFormat # illegal integer char: abort program

3920:  nonWhite:
3920#    subu $t0,$v0,'-'
3924#    li $t4,1 # final multiplier
3928#    bne $t0,$zero,helpReadInt # go read
3932#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
3936#    jal readLogicalChar

3940:  helpReadInt:
3940#    li $t2,10
3944#    subu $t1,$v0,'0' # convert digit to 0-9 value
3948#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
3949##...sltu $at,$t1,$t2
3953##...beq $at,$zero,6236
3956#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

3960:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

3960#    jal readLogicalChar # read next character
3964#    subu $t1,$v0,'0' # convert digit to 0-9 value
3968#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
3969##...sltu $at,$t1,$t2
3973##...beq $at,$zero,3992

3976#    mul $t3,$t3,$t2 # multiply old value by 10
3977##...mult $t3,$t2
3981##...mflo $t3
3984#    addu $t3,$t3,$t1 # add in value of new digit
3988#    j digitLoop

3992:  doneDigitLoop:

    # "push back" unused character into queue
3992#    sw $v0,lastCharRead

    # restore return address
3996#    lw $ra,($sp)
4000#    addu $sp, 4

    # multiply by sign and put return value in $t0
4004#    mult $t3,$t4 # multiply to account for poss. minus sign
4008#    mflo $t3
4012#    move $t0, $t3
    
    # return
4016#    jr $ra

###################################################################
# readChar() - library method (class Lib)
# - reads a single character from standard input
# - returns the integer that is the encoding of the character
# - returns -1 if end of file was encountered
# - parameter:
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
4020:mth_readChar_Lib:
