########################################################
# intToChar(n) - library method (class Lib)
# converts int to a one-character string: Java: ""+(char)(n&0xff)
# - parameters:
#   - ($sp) - the value to convert, n
#   - 4($sp) - GC tag
#   - 8($sp) - old-this-pointer
# - returns:
#   - $t0 - the string, which is the converted character
# - note: only the low 8 bits of the value n are used
########################################################
4596:mth_intToChar_Lib:
    # save return address
4596#    subu $sp,$sp,4
4600#    sw $ra,($sp)

    # allocate object
4604#    li $s6,2
4608#    move $s7,$zero
4612#    jal newObject

    # get n from string.
4616#    lw $t1,8($sp)

    # store "String" tag into class field
4620#    la $t0,CLASS_String
4624#    sw $t0,-12($s7)
        
    # mask off hash bits, if needed
4628#    lw $t4,-8($s7) # # data words in source string
4632#    bge $t4,$zero,skipMask_intToChar # don't strip hash code if not there
4633##...slt $at,$t4,$zero
4637##...beq $at,$zero,4656
4640#    and $t4,0xff # mask off object's hash value ...
4641##...lui $at,0
4645##...ori $at,$at,0xff
4649##...and $t4,$t4,$at
4652#    sw $t4,-8($s7) # ... and store back into -8 header-word
4656:  skipMask_intToChar:

    # store data in string
4656#    sb $t1,-16($s7)
    
    # store negative of size in header-word 2
4660#    li $t0,-1
4664#    sw $t0,-4($s7)

    # we're returning $s7
4668#    move $t0, $s7

    # restore $ra, and pop return address and return string off stack
4672#    lw $ra,4($sp)
4676#    addu $sp,$sp,8

    # return
4680#    jr $ra

########################################################
# str1.compareTo(str2) - library method (class String)
# compares two strings as in Java
# - parameters:
#   - ($sp) - second string
#   - 4($sp) - old this pointer
#   - $s2 - first string (this)
# - returns:
#   - $t0 - -1, 0, or 1 depending on whether str1 is
#       lexographically less than, equal to or greater than str2
########################################################
4684:mth_compareTo_String:
    # get string pointers and check parameter for null
4684#    lw $t0,($sp) # second string
4688#    beq $t0,$zero,nullPtrException
4692#    move $t1,$s2 # first string
    
    # get (negatives of) respective byte-lengths
4696#    lw $t2,-4($t0) # negative length of second string
4700#    lw $t3,-4($t1) # negative length of first string

    # put tentative return value in $t5.
    # The tentative return value is the one that we will use if we get
    # to the end of the shorter string during our comparison-loop.
4704#    slt $t4,$t3,$t2
4708#    slt $t5,$t2,$t3
4712#    subu $t5,$t5,$t4
    
    # at this point:
    # - $t0 contains the pointer to the second string object
    # - $t1 contains the pointer to the first string object
    # - $t5 contains the value to return if the strings compare equal up
    #   to the length of the shortest word

    # get begin-of-string addresses
4716#    lw $t2,-8($t0) # # data words in second string
4720#    lw $t3,-8($t1) # # data words in first string
4724#    sll $t2,$t2,2 # byte-offset to beginning of str2 (+8)
4728#    sll $t3,$t3,2 # byte-offset to beginning of str1 (+8)
4732#    subu $t0,$t0,$t2 # beginning of str1 address (+8)
4736#    subu $t1,$t1,$t3 # beginning of str2 address (+8)
    
    # put $t1-limit into $t2
4740#    beq $zero,$t5,skipStrCmpLenzz
4744#    move $t2,$t3
4748:  skipStrCmpLenzz:
4748#    add $t2,$t1,$t2
    
    # at this point:
    # - $t0 contains 8 plus the address of the first data-byte of str2
    # - $t1 contains 8 plus the address of the first data-byte of str1
    # - $t2 contains 8 plus the address of the last data-type of str1
    # - $t5 contains the value to return if the strings compare equal up
    #   to the length of the shortest word

    #######################################################
    # at this point, we have
    # - $t5 containing the tentative return-value
    # - $t1 containing address of first char in str2
    # - $t2 containing limit for $t1
    # - $t0 containing address of first char in str1
    #######################################################

    # loop through, until we find unequal words or we hit
    # our limit    
4752:  cmpLoopzz:
4752#    lw $t3,-8($t1) # word from str2
4756#    lw $t4,-8($t0) # word from str1
4760#    bne $t3,$t4,cmpNotEqualzz
4764#    addu $t1,$t1,4
4768#    addu $t0,$t0,4
4772#    bne $t1,$t2,cmpLoopzz

    # # got to the end of one string: go set up return
4776#    j cmpHitLimitzz

4780:  cmpNotEqualzz:
    # found unequal characters: return -1 or 1, depending on which is
    # greater
4780#    slt $t5,$t4,$t3 # 1 if str2 > str1, else 0
4784#    sll $t5,$t5,1 # 2 if str2 > str1, else 0
4788#    subu $t5,$t5,1 # 1 if str2 > str1, else -1
4792:  cmpHitLimitzz:
4792#    move $t0, $t5 # store return value
4796#    jr $ra # return

########################################################
# readLogicalChar (millicode)
#  - logically reads a character from standard input
#  - first checks character buffer, consuming it if possible
#  - return-result:
#    - returns character in $v0
#  - side-effects:
#    - reads a character
#    - clobbers $t0
########################################################
4800:readLogicalChar:

    # check if we already have a character
4800#    lw $v0,lastCharRead
4804#    li $t0,-2
4808#    beq $t0,$v0 doReadCh

    # we have our character from the buffer. Wipe out
    # buffer and return
4812#    sw $t0,lastCharRead # store -2 into buffer (i.e. "empty")
4816#    jr $ra # return
    
4820:  doReadCh:
    # we need to actually read a character: read and return
4820#    li $v0,12 # use system call to read a character
4824#    syscall
4828#    jr $ra # return

########################################################
# newObject (millicode)
#  - allocates a new object on the heap
#  - two-word header is set up properly
#  - all non-header words in object are set to zero
#  - parameters:
#    - $s6 = the number of data words in the negative-offset portion of
#      the object (including the vtable pointer); this value is 1 if the
#      object is an array; this should always be at least 1
#    - $s7 - second header-word, which is the number of object
#      words in the object
#      - $s7 may not be negative (this is checked); if so, the program is
#        aborted with an "array size of out bounds" error message
#      is treated as if it were zero
#  - return-result:
#    - returned in $s7
#    - and pushed on the stack
#  - side-effects:
#  - may trash all $tx registers and all $sx registers, except the
#    "permanent" ones, which get updated with values that are
#    consistent with the new space
########################################################
4832:newObject:
    # $s6 = # data words
    # $s7 = # object words (# data words if data-array allocation,
    # where a negative number is treated as 0)
    # $ra = return address
    # on return, pointer to new memory in two places:
    # - pushed onto top of stack
    # - in $s7
    
    # if the object-portion size is negative, abort with error
4832#    blt $s7,$zero arraySizeOutOfBounds
4833##...slt $at,$s7,$zero
4837##...bne $at,$zero,5828

    # mark the fact that we have not yet GC'd for this allocation
4840#    move $t5,$zero

    ###### TEMPORARY #######
    # for now, go a GC unconditionally, so that a full GC occurs
    # every time we allocate an object
    ### let's not do that for now
    # j doGC

4844:  gcJoin:

    # at this point:
    #  $s6 contains the before-header word count
    #  $s7 contains the second header word, which is also the
    #    after-header word count
    #  $t5 is zero iff we have not GC'd for this allocation

    # determine if we have enough memory available
4844#    addu $t0,$s6,$s7
4848#    sll $t0,$t0,2
4852#    addu $t0,$t0,8 # amount of memory needed
4856#    addu $t1,$t0,$s3
4860#    bgtu $t1,$s4,doGC
4861##...sltu $at,$s4,$t1
4865##...bne $at,$zero,4988

    # at this point:
    #  $s3 points to beginning of segment, and
    #  $t1 points just past the end

    # zero out the memory
4868#    move $t2,$s3
4872:  zeroObjLoop:
4872#    sw $zero,($s3)
4876#    lw $zero,($s3)

4880#    addu $s3,4
4884#    bltu $s3,$t1,zeroObjLoop
4885##...sltu $at,$s3,$t1
4889##...bne $at,$zero,4872

    # at this point:
    #  $s3 has been updated to point to the next free slot,
    #    which is also the points just past our object

    # compute pointer value and set up header-words
4892#    sll $t0,$s7,2    # number of post-header bytes
4896#    subu $t0,$s3,$t0 # pointer that we will return

    # determine the value to store in the first header-word:
    # if <= 255 (unsigned):
    #  - it goes into low byte
    #  - hash bits go into high three bytes, with top bit being 1
    # if >255 (unsigned)
    #  - it goes into full word (with a 0 in the high bit)
    
4900#    li $t2,255
4904#    bgeu $s6,$t2 firstHeaderLarge
4905##...sltu $at,$s6,$t2
4909##...beq $at,$zero,4956
4912#    lw $t1,prevHashConstant
4916#    addu $t1,0x12b68fd2
4917##...lui $at,4791
4921##...addiu $at,$at,-28718
4925##...addu $t1,$at,$t1
4928#    sw $t1,prevHashConstant # update hash constant
4932#    or $t1,0x80000000 # set top bit
4933##...lui $at,32768
4937##...or $t1,$at,$t1
4940#    and $t1,0xffffff00 # clear low bit
4941##...lui $at,65535
4945##...ori $at,$at,0xff00
4949##...and $t1,$t1,$at
4952#    or $s6,$t1
4956:firstHeaderLarge:
4956#    sw $s6,-8($t0) # store header-1 value
4960#    lw $zero,-8($t0)

    # store second header-value
4964#    sw $s7,-4($t0)   # second header-word
4968#    lw $zero,-4($t0)
    
    # put return-value into $s7 and also push it onto top of stack
4972#    move $s7,$t0
4976#    subu $sp,$sp,4
4980#    sw $t0,($sp)

4984#    jr $ra
    
4988:  doGC:
    #####################################################
    # We need to do a garbage-collect
    #####################################################
 
     ####### print that we are doing a GC ########
     ####### THESE THREE LINES WILL NORMALLY BE COMMENTED OUT #######
#         la $a0,gcMsg # prints message: "GC!" 
#         li $v0,4 # syscall-code for print-string 
#         syscall 
       

    # if we've already done a GC for this allocation, then
    # we are actually out heap-memory: abort program
4988#    bne $t5,$zero,outOfHeapMemory
      
    # increment the number of times we've done a GC, for later reporting
4992#    lw $t5,gcCount
4996#    addu $t5,1
5000#    sw $t5,gcCount

    # save $s2 (our only rooted register) on the stack
    # so that the garbage collector processes it
5004#    subu $sp,$sp,4
5008#    sw $s2,($sp)

    # set $s3 to the address of the new segment and the
    # end-limit of the new segment, respectively,
    # Also, update cur_seg to refer to the other segment
5012#    lw $t0,cur_seg
5016#    move $t7,$s4
5020#    la $t6,seg1_start
5021##...lui $t6,16
5025##...addiu $t6,$t6,6820
5028#    la $s3,seg0_start
5032#    la $s4,seg0_end
5033##...lui $s4,16
5037##...addiu $s4,$s4,6820
5040#    sw $zero,cur_seg
5044#    bne $t0,$zero,skipGc1
5048#    la $t6,seg0_start
5052#    la $s3,seg1_start
5053##...lui $s3,16
5057##...addiu $s3,$s3,6820
5060#    la $s4,seg1_end
5061##...lui $s4,32
5065##...addiu $s4,$s4,6820
5068#    sw $s5,cur_seg
5072:  skipGc1:
5072#    li $t5,0x80000000
5076#    lw $t0,stack_bottom
5080#    subu $t0,4


    ###############################################################
    # at this point:
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first address of the target space
    # - $s4 contains the limit address of the target space
    # - cur_seg has been updated to refer to the target space
    # - $t0 contains the address of the deepest stack element
    # - $sp contains the address of the top stack element
    # - $s2 is available for use, having been pushed onto the stack
    # - $t5 contains the value 0x80000000
    ###############################################################

    ###### begin outer loop to copy all stack-direct objects ######

5084:  gcStackCopyLoop:
5084#    lw $t1,($t0) # current stack element

    # test if we have a GC tag
5088#    sll $t2,$t1,31 # zero iff low bit was zero
5092#    bne $t2,$zero,gcBump # go skip data values if low bit not zero

    # bump stack-address pointer
5096#    subu $t0,$t0,4

    # if value is out of range (which includes null=0), and is
    # therefore does not refer to an object on the heap, just go
    # loop back and do the next one
5100#    bleu $t1,$t6,gcTestIterDone1
5101##...sltu $at,$t6,$t1
5105##...beq $at,$zero,5268
5108#    bgtu $t1,$t7,gcTestIterDone1
5109##...sltu $at,$t7,$t1
5113##...bne $at,$zero,5268

    # if the object has already been moved, update the stack-value
    # via the forwarding pointer
5116#    lw $t2,-8($t1) # possible forwarding tag
5120#    bne $t2,$zero,gcNoForward1 # if not forwarding tag, go copy
5124#    lw $t2,-4($t1) # forwarding pointer: object's new address
5128#    sw $t2,4($t0) # update stack value
5132#    j gcTestIterDone1 # do next iteration

5136:  gcNoForward1:
    #########################################################
    # we actually need to copy the object into the new space
    #########################################################

    # compute the amount of space that is needed
5136#    bge $t2,$zero,gcSkip2
5137##...slt $at,$t2,$zero
5141##...beq $at,$zero,5156
5144#    and $t2,0xff #### mask off hash value
5145##...lui $at,0
5149##...ori $at,$at,0xff
5153##...and $t2,$t2,$at
    #### OLD
    #### subu $t2,$zero,$t2 # set to 1 if -1 (number of data words)

5156:  gcSkip2:
5156#    sll $t2,$t2,2
5160#    addu $t2,$t2,8
5164#    subu $t4,$t1,$t2 # address of first word of source
5168#    lw $t3,-4($t1) # number of object words (negative means zero)
5172#    bge $t3,$zero,gcH2Neg1
5173##...slt $at,$t3,$zero
5177##...beq $at,$zero,5184
5180#    move $t3,$zero
5184:  gcH2Neg1:
5184#    sll $t3,$t3,2
5188#    addu $t3,$t3,$t1 # address one word past last word of source

5192#    addu $t2,$s3,$t2 # pointer to target object

    #########################################################
    # At this point:
    # - $t0 contains the address of the stack slot we'll
    #   process next
    # - $t1 contains the contents of the stack slot we're
    #   currently working on, which is a pointer to the source
    #   object (i.e., the address just beyond the object's header)
    # - $t2 contains the pointer to the target object
    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0-2
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger" in the target space
5196#    lw $s0,($t4)
5200#    lw $s1,-8($t1)
5204#    sw $s1,($t4)
5208#    sw $s0,-8($t1)
    
    # copy all source bytes to the target
5212:  gCinnerCopy1:
5212#    lw $s0,($t4)
5216#    sw $s0,($s3)
5220#    addu $t4,$t4,4
5224#    addu $s3,$s3,4
5228#    bltu $t4,$t3,gCinnerCopy1
5229##...sltu $at,$t4,$t3
5233##...bne $at,$zero,5212

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
5236#    sw $zero,-8($t1) # 0 in first header-slot
5240#    sw $t2,-4($t1) # forwarding pointer in second header-slot

    # update the stack slot with the address in the target space
5244#    sw $t2,4($t0)
5248#    lw $zero,-8($t2)
5252#    lw $zero,-4($t2)

    # go handle next stack slot (testing if done)
5256#    j gcTestIterDone1

5260:  gcBump:
    #### we have a GC tag.  Bytes to skip: tag value + 3.
5260#    subu $t0,$t0,$t1
5264#    subu $t0,$t0,3

5268:  gcTestIterDone1:
5268#    bgeu $t0,$sp,gcStackCopyLoop
5269##...sltu $at,$t0,$sp
5273##...beq $at,$zero,5084

    ###### end outer loop to copy all stack-direct objects ######

    #############################################################
    # We have finished processing the stack elements.  Now we need
    # to update elements in the heap itself. This may itself involve
    # moving additional objects
    #############################################################

    #########################################################
    # At this point:
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # We want to set things up so that in addition:
    # - $t0 is the "trailing finger", containing the address
    #   of the first slot in target space that we have yet
    #   to process.
    # Then during processing:
    # - $t1 will contain the contents of the heap slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # And when we're actually copying an object:
    # - $t2 will contain pointer to the target object
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - available for use: $s0
    ##########################################################

    # set $t0 to be at the beginning of target-space
5276#    lw $t1,cur_seg
5280#    la $t0,seg0_start
5284#    beq $t1,$zero,gcSkip4
5288#    la $t0,seg1_start
5289##...lui $t0,16
5293##...addiu $t0,$t0,6820


5296:  gcSkip4:

    # if there were no objects put into the heap during stack
    # processing, we're done, so go finish up
5296#    bgeu $t0,$s3,gcFinishUp
5297##...sltu $at,$t0,$s3
5301##...beq $at,$zero,5592

    ###### begin outer loop to copy all non-stack-direct objects ######

5304:  gcHeapCopyLoop:
    # get data count for object; swap header-word with first word
    # of object so that they're back in the right place
5304#    lw $t1,($t0) # (what will be) first header word for current object
5308#    move $t2,$t1 # number data bytes in object (poss. w/hash bits)
5312#    bge $t2,$zero,gcSkip4a # are there hash bits?
5313##...slt $at,$t2,$zero
5317##...beq $at,$zero,5332
5320#    and $t2,0xff # mask off hash bits
5321##...lui $at,0
5325##...ori $at,$at,0xff
5329##...and $t2,$t2,$at
5332:gcSkip4a:    
5332#    sll $t2,$t2,2 # # data bytes
5336#    addu $t2,$t2,8 # to skip header words
5340#    addu $t2,$t0,$t2 # pointer to new object
5344#    lw $t3,-8($t2) # word to swap
5348#    sw $t1,-8($t2) # store header word
5352#    sw $t3,($t0) # restore first word of object

    ################################################
    # at this point:
    # - $t2 contains the pointer to our new object
    ################################################

    # check if we have a data array
5356#    lw $t1,-12($t2) # vtable pointer
5360#    li $t0,dataArrayVTableStart # address of vtable for first data array
5364#    blt $t1,$t0,gcNotDataArray # if data array, no more xforming to do
5365##...slt $at,$t1,$t0
5369##...bne $at,$zero,5388

    # We have a vtable address that is a data array.
    # we need skip over it then loop back to do next object.
5372:  skipToNextObj:
5372#    lw $t1,-4($t2) # data words in (object position of) array
    #### note: we know that it's not a string, so the value will
    #### not be artificially negative
5376#    sll $t1,$t1,2 # convert to byte-count
5380#    addu $t0,$t2,$t1 # skip over object
5384#    j gcTestIterDone2 # go do next object, if any

    ###################################################
    # at this point:
    # - the object has been restored to normal status--that is, the
    #   word-swap has been done
    # - $t2 contains a pointer to the object
    ###################################################
    
5388:  gcNotDataArray:
5388#    lw $t3,-4($t2) # # object words (negative treated as zero)
5392#    bge $t3,$zero,gcH2Neg2
5393##...slt $at,$t3,$zero
5397##...beq $at,$zero,5404
5400#    move $t3,$zero
5404:  gcH2Neg2:
5404#    sll $t3,$t3,2 # # object bytes
5408#    move $t0,$t2 # address of first pointer in object
5412#    add $s1,$t2,$t3 # limit address for this object

    #####################################################
    # At this point, we have to "translate" all pointers,
    # starting at $t0 to (but not including) $s1
    #####################################################

    # if there are no pointer-slots (i.e., $t0=$s1), skip this
    # part
5416#    beq $t0,$s1,gcTestIterDone2
    
5420:  gcNextPointerInObject:
    # get pointer from object
5420#    lw $t1,($t0)

    # if value is out of range, and is therefore does not refer
    # to an object, just go loop back and do the next one
5424#    bleu $t1,$t6,gcGoNextPointerSlot
5425##...sltu $at,$t6,$t1
5429##...beq $at,$zero,5572
5432#    bgtu $t1,$t7,gcGoNextPointerSlot
5433##...sltu $at,$t7,$t1
5437##...bne $at,$zero,5572

    # if the object has already been moved, update the stack-value
    # via the forwarding pointer
5440#    lw $t8,-8($t1) # possible forwarding tag
5444#    bne $t8,$zero,gcNoForward2 # if not forwarding tag, go copy
5448#    lw $t8,-4($t1) # forwarding pointer: object's new address
5452#    sw $t8,($t0) # update pointer in object
5456#    j gcGoNextPointerSlot # do next iteration

5460:  gcNoForward2:
    #########################################################
    # we actually need to copy the object into the new space
    #########################################################

    #########################################################
    # At this point:
    # - $t0 contains the address of the heap-slot we're translating
    # - $t1 will contain the contents of the heap-slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space, which will also be the first address
    #   of the target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # Then during processing:
    # And when we're actually copying an object:
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $t8 will contain a pointer to the target object
    # - available for use: $s0, $t8, $t9
    ##########################################################

    # compute the amount of space that is needed
5460#    bge $t8,$zero,gcSkip5 # # words in negative-offset portion
5461##...slt $at,$t8,$zero
5465##...beq $at,$zero,5480
5468#    and $t8,0xff # mask off hash bits
5469##...lui $at,0
5473##...ori $at,$at,0xff
5477##...and $t8,$t8,$at

5480:  gcSkip5:
5480#    sll $t8,$t8,2 # bytes in negative-offset portion ...
5484#    addu $t8,$t8,8 # ... add in bytes for header-words
5488#    subu $t4,$t1,$t8 # address of first word of source object
5492#    lw $t3,-4($t1) # # words in positive-offset portion
5496#    bge $t3,$zero,gcNoNeg
5497##...slt $at,$t3,$zero
5501##...beq $at,$zero,5508
5504#    move $t3,$zero # negative treated as zero
5508:  gcNoNeg:
5508#    sll $t3,$t3,2 # bytes in negative-offset portion
5512#    addu $t3,$t3,$t1 # address one word past last word of source

5516#    addu $t8,$s3,$t8 # pointer to target object

    #########################################################
    # At this point:
    # - $t0 contains the address of the stack slot we'll
    #   process next
    # - $t1 contains the contents of the stack slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $t8 contains the pointer to the target object
    # - $s1 contains the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0, $t9
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger"
5520#    lw $s0,($t4)
5524#    lw $t9,-8($t1)
5528#    sw $t9,($t4)
5532#    sw $s0,-8($t1)

    # copy all source bytes to the target
5536:  gCinnerCopy2:
5536#    lw $s0,($t4)
5540#    sw $s0,($s3)
5544#    addu $t4,$t4,4
5548#    addu $s3,$s3,4
5552#    bltu $t4,$t3,gCinnerCopy2
5553##...sltu $at,$t4,$t3
5557##...bne $at,$zero,5536

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
5560#    sw $zero,-8($t1) # 0 in first header-slot
5564#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
5568#    sw $t8,($t0)

5572:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
5572#    addu $t0,$t0,4
5576#    bltu $t0,$s1,gcNextPointerInObject
5577##...sltu $at,$t0,$s1
5581##...bne $at,$zero,5420

5584:  gcTestIterDone2:
5584#    bltu $t0,$s3,gcHeapCopyLoop
5585##...sltu $at,$t0,$s3
5589##...bne $at,$zero,5304

    ###### end outer loop to copy all non-stack-direct objects ######

5592:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
5592#    lw $s2,($sp)
5596#    addu $sp,$sp,4

    # mark us as having already GC'd
5600#    move $t5,$s5

    # go try and allocate again
5604#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
5608:vm_init:

    # mark bottom of stack
5608#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
5612#    move $s2,$zero

    #set up the "five" register
5616#    li $s5,5

5620#    la $s3,seg0_start
5624#    la $s4,seg0_end
5625##...lui $s4,16
5629##...addiu $s4,$s4,6820
    
    # return
5632#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
5636:divide:
    # get parameters; abort if divisor zero
5636#    lw $t0,($sp)
5640#    lw $t1,8($sp)
5644#    beq $t0,$zero,divByZeroError
    
    # perform division
5648#    div $t1,$t0
5652#    mflo $t0

    # store result, adjust stack and return
5656#    addu $sp,$sp,8 # adjust stack
5660#    sw $t0,($sp) # store result
5664#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
5668:remainder:
    # get parameters; abort if divisor zero
5668#    lw $t0,($sp)
5672#    lw $t1,8($sp)
5676#    beq $t0,$zero,divByZeroError
    
    # perform division
5680#    div $t1,$t0
5684#    mfhi $t0

    # store result, adjust stack and return
5688#    addu $sp,$sp,8 # adjust stack
5692#    sw $t0,($sp) # store result
5696#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
5700:checkCast:
    # get object, allow immediately if null
5700#    lw $t2,($sp)
5704#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
5708#    lw $t2,-12($t2) # vtable address
5712#    bge $t2,$t1,castException
5713##...slt $at,$t2,$t1
5717##...beq $at,$zero,5852
5720#    blt $t2,$t0,castException
5721##...slt $at,$t2,$t0
5725##...bne $at,$zero,5852
    
    # return, leaving object unchanged on stack
5728:  checkCastReturn:    
5728#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
5732:instanceOf:
    # get object, go return false if null
5732#    lw $t2,($sp)
5736#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
5740#    lw $t2,-12($t2) # vtable address
5744#    sge $t0,$t2,$t0 # are we >= the lower limit?
5745##...slt $t0,$t2,$t0
5749##...xori $t0,$t0,0x1
5752#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
5756#    and $t2,$t0,$t1
5760#    sw $t2,($sp)
5764:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
5764#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

5768:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
5768#    li $v0,4 # syscall-code for print-string
5772#    syscall
5776:exit:
    # print termination message
5776#    li $v0,4 # syscall-code for print-string
5780#    la $a0,exitString
5784#    syscall

    # terminate execution
5788#    li $v0,10 #syscall-code for "exit"
5792#    syscall

5796:outOfHeapMemory:
5796#    la $a0,heapMemoryMsg
5800#    j exitError
5804:divByZeroError:
5804#    la $a0,divByZeroMsg
5808#    j exitError
5812:strIndexOutOfBounds:
5812#    la $a0,strIndexOutOfBoundsMsg
5816#    j exitError
5820:arrayIndexOutOfBounds:
5820#    la $a0,arrayIndexOutOfBoundsMsg
5824#    j exitError
5828:arraySizeOutOfBounds:
5828#    la $a0,arraySizeOutOfBoundsMsg
5832#    j exitError
5836:nullPtrException:
5836#    la $a0,nullPtrExceptionMsg
5840#    j exitError
5844:badIntegerFormat:
5844#    la $a0,badIntegerFormatMsg
5848#    j exitError
5852:castException:
5852#    la $a0,castExceptionMsg
5856#    j exitError
############## data section ################
    .data
6456:hexChars:
    .ascii "0123456789abcdef"
    .align 2
6472:cur_seg:
    .word 0

6476:lastCharRead:
    .word -2 # -2 => no buffered character
6480:prevHashConstant:
    .word 0x2785173c
6484:gcCount:
    .word 0

6488:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
