###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
6068:mth_readLine_Lib:
    
6068#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
6072#    sw $ra, 4($sp) # save $ra
6076#    move $t1,$sp # save "original" sp

6080:  doRead:

    # read the character
6080#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
6084#    subu $t2,$v0,13
6088#    bne $t2,$zero,notReturnRL
6092#    jal readLogicalChar
6096#    subu $t2,$v0,10 # check for newline
6100#    beq $t2,$zero,foundNewLine
6104#    sw $v0,lastCharRead # push back character into queue
6108#    j foundNewLine # go process the line

6112:  notReturnRL:

    # at this point, $v0 has our character

6112#    subu $t0,$v0,10
6116#    beq $t0,$zero,foundNewLine
6120#    blt $v0,$zero,foundEof
6121##...slt $at,$v0,$zero
6125##...bne $at,$zero,6140

    # we have a character, so push it onto stack
6128#    subu $sp,$sp,4
6132#    sw $v0,($sp)

    # loop back up to get next character
6136#    j doRead

6140:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
6140#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
6144#    li $s7, 0 # return-value: null
6148#    j rlReturn # return

6152:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
6152#    subu $t0,$t1,$sp # number of chars we read (times 4)
6156#    srl $s6,$t0,2 # number of words on stack with chars
6160#    subu $sp,$sp,4 # push char-count ...
6164#    sw $s6,($sp) # ... onto stack
6168#    addu $t2,$t0,5 # GC tag, incl. for count-word
6172#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
6176#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
6180#    srl $s6,$s6,2  # data words in object
6184#    move $s7,$zero # object words in object
6188#    jal newObject  # allocate space
    
    # store header words
6192#    la $t0,CLASS_String
6196#    sw $t0,-12($s7)# store class tag (String) into object
6200#    lw $t2,4($sp) # char-count
6204#    sll $t1,$t2,2 # 4 times number of chars
6208#    subu $t2,$zero,$t2 # negative of char-count
6212#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
6216#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
6220#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
6221##...slt $at,$t0,$zero
6225##...beq $at,$zero,6244
6228#    and $t0,0xff # mask off object's hash value ...
6229##...lui $at,0
6233##...ori $at,$at,0xff
6237##...and $t0,$t0,$at
6240#    sw $t0,-8($s7) # ... and store back into -8 header-word
6244:  skipMask_readLine:

6244#    sll $t0,$t0,2 # data bytes in object
6248#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
6252#    subu $t0,$t0,$t2 # place to store last character (plus 9)
6256#    addu $sp,$sp,8 # pop redundant object-pointer and count
6260#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

6264#    beq $sp,$t1,rlReturn
