###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
1276:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
1276#    subu $sp,4
1280#    sw $ra,($sp)
    
    # get hash value
1284#    lw $t2,-12($s2) # vtable address
1288#    lw $t0,($t2) # method address
1292#    jalr $t0
1296#    subu $sp,8 # push result (int in $t0) on stack
1300#    sw $s5,4($sp)
1304#    sw $t0,($sp)

    # compute print-size of hash value
1308#    li $t0, 1
1312#    lw $t1, ($sp)
1316#    srl $t1,$t1,4
1320#    beq $t1,$zero,toString_skip_loop
1324:toString_loop_top:
1324#    addu $t0,1
1328#    srl $t1,$t1,4
1332#    bne $t1,$zero,toString_loop_top
1336:toString_skip_loop:
1336#    subu $sp,8
1340#    sw $s5,4($sp)
1344#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
1348#    lw $t2,-12($s2) # vtable address
1352#    move $t0,$t2
1356:toString_checkTagBit:
1356#    subu $t0,1
1360#    lb $t1,($t0)
1364#    and $t1,0x80
1365##...lui $at,0
1369##...ori $at,$at,0x80
1373##...and $t1,$t1,$at
1376#    beq $t1,$zero,toString_checkTagBit
1380#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
1384#    subu $sp,8
1388#    sw $t1,($sp)
1392#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
1396#    move $s7,$zero # -4 offset header word
1400#    lw $t4,8($sp) # bytes for hash value
1404#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
1408#    addu $t4,8
1412#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
1416#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

1420#    li $t0,CLASS_String # store string vtable address into ...
1424#    sw $t0,-12($s7) # ... -12 offset in object header
1428#    lw $t2,-12($s2) # our object's vtable address
1432#    lw $t5,4($sp) # number characters in prefix
1436#    lw $t1,12($sp) # number of characters in hashcode
1440#    addu $t3,$t1,$t5 # number of characters in string ...
1444#    addu $t3,1 # ... including the '@' character
1448#    subu $t0,$zero,$t3 # store negated length into ...
1452#    sw $t0,-4($s7) # ... -4 offset header word
1456#    lw $t0,-8($s7) # get -8 offset header-word
1460#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
1461##...slt $at,$t0,$zero
1465##...beq $at,$zero,1484
1468#    and $t0,0xff # mask off object's hash value ...
1469##...lui $at,0
1473##...ori $at,$at,0xff
1477##...and $t0,$t0,$at
1480#    sw $t0,-8($s7) # ... and store back into -8 header-word
1484:skipMask_toString:
1484#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
1488#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
1492#    subu $t4,$t2,$t5
1496:toString_copyLoop:    
1496#    lb $t3,($t4)
1500#    and $t3,0x7f # mask off sign bit (in case first word)
1501##...lui $at,0
1505##...ori $at,$at,0x7f
1509##...and $t3,$t3,$at
1512#    sb $t3,-8($t0)
1516#    addu $t4,1
