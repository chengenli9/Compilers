##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
3736:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
3736#    lw $t0,-8($s2) # get word with hash bits from this
3740#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
3744#    addu $t0,$t1

3748#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
3752:mth_equals_Object:
3752#    move $t0,$s2 # first pointer (this)
3756#    lw $t1,($sp) # second pointer
3760#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
3761##...subu $at,$t0,$t1
3765##...sltiu $t0,$at,1

3768#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
3772:mth_hashCode_String:
3772#    move $t0,$s2 # put this pointer in t0

3776#    li $t2,0 # current hash value
3780#    lw $t1,-4($t0) # negative of number of characters in string
3784#    beq $t1,$zero,done_hashCode_String # if zero length => done
3788#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
3792#    and $t0,0xfffffffc # adjust for padding
3793##...lui $at,65535
3797##...ori $at,$at,0xfffc
3801##...and $t0,$t0,$at
3804#    subu $t1,$t0,$t1 # address at end of string +12
3808:loop_hashCode_String:    
3808#    sll $t4,$t2,5 # multiply by 32
3812#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
3816#    lbu $t3,-12($t0) # current character
3820#    addu $t2,$t3 # add in current character
3824#    addu $t0,1 # go to next character's address
3828#    bne $t0,$t1,loop_hashCode_String # loop back if more
3832:done_hashCode_String:    

    # push int on stack
3832#    move $t0, $t2 # put $t2 in return slot
3836#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
3840:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
3840#    subu $sp,4
3844#    sw $ra,($sp)
    
    # get hash value
3848#    lw $t2,-12($s2) # vtable address
3852#    lw $t0,($t2) # method address
3856#    jalr $t0
3860#    subu $sp,8 # push result (int in $t0) on stack
3864#    sw $s5,4($sp)
3868#    sw $t0,($sp)

    # compute print-size of hash value
3872#    li $t0, 1
3876#    lw $t1, ($sp)
3880#    srl $t1,$t1,4
3884#    beq $t1,$zero,toString_skip_loop
3888:toString_loop_top:
3888#    addu $t0,1
3892#    srl $t1,$t1,4
3896#    bne $t1,$zero,toString_loop_top
3900:toString_skip_loop:
3900#    subu $sp,8
3904#    sw $s5,4($sp)
3908#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
3912#    lw $t2,-12($s2) # vtable address
3916#    move $t0,$t2
3920:toString_checkTagBit:
3920#    subu $t0,1
3924#    lb $t1,($t0)
3928#    and $t1,0x80
3929##...lui $at,0
3933##...ori $at,$at,0x80
3937##...and $t1,$t1,$at
3940#    beq $t1,$zero,toString_checkTagBit
3944#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
3948#    subu $sp,8
3952#    sw $t1,($sp)
3956#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
3960#    move $s7,$zero # -4 offset header word
3964#    lw $t4,8($sp) # bytes for hash value
3968#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
3972#    addu $t4,8
3976#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
3980#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

3984#    li $t0,CLASS_String # store string vtable address into ...
3988#    sw $t0,-12($s7) # ... -12 offset in object header
3992#    lw $t2,-12($s2) # our object's vtable address
3996#    lw $t5,4($sp) # number characters in prefix
4000#    lw $t1,12($sp) # number of characters in hashcode
4004#    addu $t3,$t1,$t5 # number of characters in string ...
4008#    addu $t3,1 # ... including the '@' character
4012#    subu $t0,$zero,$t3 # store negated length into ...
4016#    sw $t0,-4($s7) # ... -4 offset header word
4020#    lw $t0,-8($s7) # get -8 offset header-word
4024#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
4025##...slt $at,$t0,$zero
4029##...beq $at,$zero,4048
4032#    and $t0,0xff # mask off object's hash value ...
4033##...lui $at,0
4037##...ori $at,$at,0xff
4041##...and $t0,$t0,$at
4044#    sw $t0,-8($s7) # ... and store back into -8 header-word
4048:skipMask_toString:
4048#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
4052#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
4056#    subu $t4,$t2,$t5
4060:toString_copyLoop:    
4060#    lb $t3,($t4)
4064#    and $t3,0x7f # mask off sign bit (in case first word)
4065##...lui $at,0
4069##...ori $at,$at,0x7f
4073##...and $t3,$t3,$at
4076#    sb $t3,-8($t0)
4080#    addu $t4,1
4084#    addu $t0,1
4088#    blt $t4,$t2,toString_copyLoop
4089##...slt $at,$t4,$t2
4093##...bne $at,$zero,4060

    # copy the '@' sign
4096#    li $t3,'@'
4100#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
4104#    addu $t2,$t0,$t1 # address of last byte in string to store +8
4108#    lw $t3,20($sp) # hash code to print
4112:toString_hashCopyLoop:
4112#    and $t4,$t3,0xf
4116#    srl $t3,4
4120#    lb $t4,hexChars($t4)
4124#    sb $t4,-8($t2)
4128#    subu $t2,$t2,1
4132#    bgt $t2,$t0,toString_hashCopyLoop
4133##...slt $at,$t0,$t2
4137##...bne $at,$zero,4112

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
4140#    addu $sp,28
4144#    lw $ra,($sp)
4148#    addu $sp,4
4152#    move $t0, $s7 # return string we created
4156#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
4160:mth_equals_String:
    
    # quick test for obvious false
4160#    lw $t0,($sp) # second parameter
4164#    beq $t0,$zero,goEsFalse # go return false if null
4168#    lw $t1,-12($t0) # vtable pointer
4172#    la $t2,CLASS_String # string vtable pointer
4176#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
4180#    subu $sp,12
4184#    sw $ra,8($sp)
4188#    sw $s2,4($sp)
4192#    sw $t0,($sp)
4196#    jal mth_compareTo_String
4200#    lw $s2, 4($sp) #restore this pointer and pop parameters
4204#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
4208#    seq $t0,$t0,$zero
4209##...subu $at,$t0,$zero
4213##...sltiu $t0,$at,1

    # pop return address and return $t0
4216#    lw $ra,($sp)
4220#    addu $sp,4

4224#    jr $ra # return
    
4228:goEsFalse:
    # put 0 in $t0 and return
4228#    li $t0, 0
4232#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
4236:mth_toString_String:
    #we are a string, so return this.
4236#    move $t0, $s2
4240#    jr $ra

###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
4244:mth_readLine_Lib:
    
4244#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
4248#    sw $ra, 4($sp) # save $ra
4252#    move $t1,$sp # save "original" sp

4256:  doRead:

    # read the character
4256#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
4260#    subu $t2,$v0,13
4264#    bne $t2,$zero,notReturnRL
4268#    jal readLogicalChar
4272#    subu $t2,$v0,10 # check for newline
4276#    beq $t2,$zero,foundNewLine
4280#    sw $v0,lastCharRead # push back character into queue
4284#    j foundNewLine # go process the line

4288:  notReturnRL:

    # at this point, $v0 has our character

4288#    subu $t0,$v0,10
4292#    beq $t0,$zero,foundNewLine
4296#    blt $v0,$zero,foundEof
4297##...slt $at,$v0,$zero
4301##...bne $at,$zero,4316

    # we have a character, so push it onto stack
4304#    subu $sp,$sp,4
4308#    sw $v0,($sp)

    # loop back up to get next character
4312#    j doRead

4316:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
4316#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
4320#    li $s7, 0 # return-value: null
4324#    j rlReturn # return

4328:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
4328#    subu $t0,$t1,$sp # number of chars we read (times 4)
4332#    srl $s6,$t0,2 # number of words on stack with chars
4336#    subu $sp,$sp,4 # push char-count ...
4340#    sw $s6,($sp) # ... onto stack
4344#    addu $t2,$t0,5 # GC tag, incl. for count-word
4348#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
4352#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
4356#    srl $s6,$s6,2  # data words in object
4360#    move $s7,$zero # object words in object
4364#    jal newObject  # allocate space
    
    # store header words
4368#    la $t0,CLASS_String
4372#    sw $t0,-12($s7)# store class tag (String) into object
4376#    lw $t2,4($sp) # char-count
4380#    sll $t1,$t2,2 # 4 times number of chars
4384#    subu $t2,$zero,$t2 # negative of char-count
4388#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
4392#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
4396#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
4397##...slt $at,$t0,$zero
4401##...beq $at,$zero,4420
4404#    and $t0,0xff # mask off object's hash value ...
4405##...lui $at,0
4409##...ori $at,$at,0xff
4413##...and $t0,$t0,$at
4416#    sw $t0,-8($s7) # ... and store back into -8 header-word
4420:  skipMask_readLine:

4420#    sll $t0,$t0,2 # data bytes in object
4424#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
4428#    subu $t0,$t0,$t2 # place to store last character (plus 9)
4432#    addu $sp,$sp,8 # pop redundant object-pointer and count
4436#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
