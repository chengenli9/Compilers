    # buffer and return
5804#    sw $t0,lastCharRead # store -2 into buffer (i.e. "empty")
5808#    jr $ra # return
    
5812:  doReadCh:
    # we need to actually read a character: read and return
5812#    li $v0,12 # use system call to read a character
5816#    syscall
5820#    jr $ra # return
