##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
944:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
944#    lw $t0,-8($s2) # get word with hash bits from this
948#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
952#    addu $t0,$t1

956#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
960:mth_equals_Object:
960#    move $t0,$s2 # first pointer (this)
964#    lw $t1,($sp) # second pointer
968#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
969##...subu $at,$t0,$t1
973##...sltiu $t0,$at,1

976#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
980:mth_hashCode_String:
980#    move $t0,$s2 # put this pointer in t0

984#    li $t2,0 # current hash value
988#    lw $t1,-4($t0) # negative of number of characters in string
992#    beq $t1,$zero,done_hashCode_String # if zero length => done
996#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
1000#    and $t0,0xfffffffc # adjust for padding
1001##...lui $at,65535
1005##...ori $at,$at,0xfffc
1009##...and $t0,$t0,$at
1012#    subu $t1,$t0,$t1 # address at end of string +12
1016:loop_hashCode_String:    
1016#    sll $t4,$t2,5 # multiply by 32
1020#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
1024#    lbu $t3,-12($t0) # current character
1028#    addu $t2,$t3 # add in current character
1032#    addu $t0,1 # go to next character's address
1036#    bne $t0,$t1,loop_hashCode_String # loop back if more
1040:done_hashCode_String:    

    # push int on stack
1040#    move $t0, $t2 # put $t2 in return slot
1044#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
1048:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
1048#    subu $sp,4
1052#    sw $ra,($sp)
    
    # get hash value
1056#    lw $t2,-12($s2) # vtable address
1060#    lw $t0,($t2) # method address
1064#    jalr $t0
1068#    subu $sp,8 # push result (int in $t0) on stack
1072#    sw $s5,4($sp)
1076#    sw $t0,($sp)

    # compute print-size of hash value
1080#    li $t0, 1
1084#    lw $t1, ($sp)
1088#    srl $t1,$t1,4
1092#    beq $t1,$zero,toString_skip_loop
1096:toString_loop_top:
1096#    addu $t0,1
1100#    srl $t1,$t1,4
1104#    bne $t1,$zero,toString_loop_top
1108:toString_skip_loop:
1108#    subu $sp,8
1112#    sw $s5,4($sp)
1116#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
1120#    lw $t2,-12($s2) # vtable address
1124#    move $t0,$t2
1128:toString_checkTagBit:
1128#    subu $t0,1
1132#    lb $t1,($t0)
1136#    and $t1,0x80
1137##...lui $at,0
1141##...ori $at,$at,0x80
1145##...and $t1,$t1,$at
1148#    beq $t1,$zero,toString_checkTagBit
1152#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
1156#    subu $sp,8
1160#    sw $t1,($sp)
1164#    sw $s5,4($sp) # push size onto stack
