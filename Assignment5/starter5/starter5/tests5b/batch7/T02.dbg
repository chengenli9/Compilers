    #############################################################
    # We have finished processing the stack elements.  Now we need
    # to update elements in the heap itself. This may itself involve
    # moving additional objects
    #############################################################

    #########################################################
    # At this point:
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # We want to set things up so that in addition:
    # - $t0 is the "trailing finger", containing the address
    #   of the first slot in target space that we have yet
    #   to process.
    # Then during processing:
    # - $t1 will contain the contents of the heap slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # And when we're actually copying an object:
    # - $t2 will contain pointer to the target object
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - available for use: $s0
    ##########################################################

    # set $t0 to be at the beginning of target-space
10428#    lw $t1,cur_seg
10432#    la $t0,seg0_start
10436#    beq $t1,$zero,gcSkip4
10440#    la $t0,seg1_start
10441##...lui $t0,16
10445##...addiu $t0,$t0,12252


10448:  gcSkip4:

    # if there were no objects put into the heap during stack
    # processing, we're done, so go finish up
10448#    bgeu $t0,$s3,gcFinishUp
10449##...sltu $at,$t0,$s3
10453##...beq $at,$zero,10744

    ###### begin outer loop to copy all non-stack-direct objects ######

10456:  gcHeapCopyLoop:
    # get data count for object; swap header-word with first word
    # of object so that they're back in the right place
10456#    lw $t1,($t0) # (what will be) first header word for current object
10460#    move $t2,$t1 # number data bytes in object (poss. w/hash bits)
10464#    bge $t2,$zero,gcSkip4a # are there hash bits?
10465##...slt $at,$t2,$zero
10469##...beq $at,$zero,10484
10472#    and $t2,0xff # mask off hash bits
10473##...lui $at,0
10477##...ori $at,$at,0xff
10481##...and $t2,$t2,$at
10484:gcSkip4a:    
10484#    sll $t2,$t2,2 # # data bytes
10488#    addu $t2,$t2,8 # to skip header words
10492#    addu $t2,$t0,$t2 # pointer to new object
10496#    lw $t3,-8($t2) # word to swap
10500#    sw $t1,-8($t2) # store header word
10504#    sw $t3,($t0) # restore first word of object

    ################################################
    # at this point:
    # - $t2 contains the pointer to our new object
    ################################################

    # check if we have a data array
10508#    lw $t1,-12($t2) # vtable pointer
10512#    li $t0,dataArrayVTableStart # address of vtable for first data array
10516#    blt $t1,$t0,gcNotDataArray # if data array, no more xforming to do
10517##...slt $at,$t1,$t0
10521##...bne $at,$zero,10540

    # We have a vtable address that is a data array.
    # we need skip over it then loop back to do next object.
10524:  skipToNextObj:
10524#    lw $t1,-4($t2) # data words in (object position of) array
    #### note: we know that it's not a string, so the value will
    #### not be artificially negative
10528#    sll $t1,$t1,2 # convert to byte-count
10532#    addu $t0,$t2,$t1 # skip over object
10536#    j gcTestIterDone2 # go do next object, if any

    ###################################################
    # at this point:
    # - the object has been restored to normal status--that is, the
    #   word-swap has been done
    # - $t2 contains a pointer to the object
    ###################################################
    
10540:  gcNotDataArray:
10540#    lw $t3,-4($t2) # # object words (negative treated as zero)
10544#    bge $t3,$zero,gcH2Neg2
10545##...slt $at,$t3,$zero
10549##...beq $at,$zero,10556
10552#    move $t3,$zero
10556:  gcH2Neg2:
10556#    sll $t3,$t3,2 # # object bytes
10560#    move $t0,$t2 # address of first pointer in object
10564#    add $s1,$t2,$t3 # limit address for this object

    #####################################################
    # At this point, we have to "translate" all pointers,
    # starting at $t0 to (but not including) $s1
    #####################################################

    # if there are no pointer-slots (i.e., $t0=$s1), skip this
    # part
10568#    beq $t0,$s1,gcTestIterDone2
    
10572:  gcNextPointerInObject:
    # get pointer from object
10572#    lw $t1,($t0)

    # if value is out of range, and is therefore does not refer
    # to an object, just go loop back and do the next one
10576#    bleu $t1,$t6,gcGoNextPointerSlot
10577##...sltu $at,$t6,$t1
10581##...beq $at,$zero,10724
10584#    bgtu $t1,$t7,gcGoNextPointerSlot
10585##...sltu $at,$t7,$t1
10589##...bne $at,$zero,10724

    # if the object has already been moved, update the stack-value
    # via the forwarding pointer
10592#    lw $t8,-8($t1) # possible forwarding tag
10596#    bne $t8,$zero,gcNoForward2 # if not forwarding tag, go copy
10600#    lw $t8,-4($t1) # forwarding pointer: object's new address
10604#    sw $t8,($t0) # update pointer in object
10608#    j gcGoNextPointerSlot # do next iteration

10612:  gcNoForward2:
    #########################################################
    # we actually need to copy the object into the new space
    #########################################################

    #########################################################
    # At this point:
    # - $t0 contains the address of the heap-slot we're translating
    # - $t1 will contain the contents of the heap-slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space, which will also be the first address
    #   of the target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # Then during processing:
    # And when we're actually copying an object:
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $t8 will contain a pointer to the target object
    # - available for use: $s0, $t8, $t9
    ##########################################################

    # compute the amount of space that is needed
10612#    bge $t8,$zero,gcSkip5 # # words in negative-offset portion
10613##...slt $at,$t8,$zero
10617##...beq $at,$zero,10632
10620#    and $t8,0xff # mask off hash bits
10621##...lui $at,0
10625##...ori $at,$at,0xff
10629##...and $t8,$t8,$at

10632:  gcSkip5:
10632#    sll $t8,$t8,2 # bytes in negative-offset portion ...
10636#    addu $t8,$t8,8 # ... add in bytes for header-words
10640#    subu $t4,$t1,$t8 # address of first word of source object
10644#    lw $t3,-4($t1) # # words in positive-offset portion
10648#    bge $t3,$zero,gcNoNeg
10649##...slt $at,$t3,$zero
10653##...beq $at,$zero,10660
10656#    move $t3,$zero # negative treated as zero
10660:  gcNoNeg:
10660#    sll $t3,$t3,2 # bytes in negative-offset portion
10664#    addu $t3,$t3,$t1 # address one word past last word of source

10668#    addu $t8,$s3,$t8 # pointer to target object

    #########################################################
    # At this point:
    # - $t0 contains the address of the stack slot we'll
    #   process next
    # - $t1 contains the contents of the stack slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $t8 contains the pointer to the target object
    # - $s1 contains the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0, $t9
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger"
10672#    lw $s0,($t4)
10676#    lw $t9,-8($t1)
10680#    sw $t9,($t4)
10684#    sw $s0,-8($t1)

    # copy all source bytes to the target
10688:  gCinnerCopy2:
10688#    lw $s0,($t4)
10692#    sw $s0,($s3)
10696#    addu $t4,$t4,4
10700#    addu $s3,$s3,4
10704#    bltu $t4,$t3,gCinnerCopy2
10705##...sltu $at,$t4,$t3
10709##...bne $at,$zero,10688

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
10712#    sw $zero,-8($t1) # 0 in first header-slot
10716#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
10720#    sw $t8,($t0)

10724:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
10724#    addu $t0,$t0,4
10728#    bltu $t0,$s1,gcNextPointerInObject
10729##...sltu $at,$t0,$s1
10733##...bne $at,$zero,10572

10736:  gcTestIterDone2:
10736#    bltu $t0,$s3,gcHeapCopyLoop
10737##...sltu $at,$t0,$s3
10741##...bne $at,$zero,10456

    ###### end outer loop to copy all non-stack-direct objects ######

10744:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
10744#    lw $s2,($sp)
10748#    addu $sp,$sp,4

    # mark us as having already GC'd
10752#    move $t5,$s5

    # go try and allocate again
10756#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
10760:vm_init:

    # mark bottom of stack
10760#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
10764#    move $s2,$zero

    #set up the "five" register
10768#    li $s5,5

10772#    la $s3,seg0_start
10776#    la $s4,seg0_end
10777##...lui $s4,16
10781##...addiu $s4,$s4,12252
    
    # return
10784#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
10788:divide:
    # get parameters; abort if divisor zero
10788#    lw $t0,($sp)
10792#    lw $t1,8($sp)
10796#    beq $t0,$zero,divByZeroError
    
    # perform division
10800#    div $t1,$t0
10804#    mflo $t0

    # store result, adjust stack and return
10808#    addu $sp,$sp,8 # adjust stack
10812#    sw $t0,($sp) # store result
10816#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
10820:remainder:
    # get parameters; abort if divisor zero
10820#    lw $t0,($sp)
10824#    lw $t1,8($sp)
10828#    beq $t0,$zero,divByZeroError
    
    # perform division
10832#    div $t1,$t0
10836#    mfhi $t0

    # store result, adjust stack and return
10840#    addu $sp,$sp,8 # adjust stack
10844#    sw $t0,($sp) # store result
10848#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
10852:checkCast:
    # get object, allow immediately if null
10852#    lw $t2,($sp)
10856#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
10860#    lw $t2,-12($t2) # vtable address
10864#    bge $t2,$t1,castException
10865##...slt $at,$t2,$t1
10869##...beq $at,$zero,11040
10872#    blt $t2,$t0,castException
10873##...slt $at,$t2,$t0
10877##...bne $at,$zero,11040
    
    # return, leaving object unchanged on stack
10880:  checkCastReturn:    
10880#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
10884:instanceOf:
    # get object, go return false if null
10884#    lw $t2,($sp)
10888#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
10892#    lw $t2,-12($t2) # vtable address
10896#    sge $t0,$t2,$t0 # are we >= the lower limit?
10897##...slt $t0,$t2,$t0
10901##...xori $t0,$t0,0x1
10904#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
10908#    and $t2,$t0,$t1
10912#    sw $t2,($sp)
10916:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
10916#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

10920:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
10920#    li $v0,4 # syscall-code for print-string
10924#    syscall
10928:exit:
    # print termination message
10928#    li $v0,4 # syscall-code for print-string
10932#    la $a0,exitString
10936#    syscall

    # print number of garbage collections
10940#    li $v0,4 # syscall-code for print-string
10944#    la $a0,gcCountMsg
10948#    syscall # print "Number of ..."
10952#    lw $a0,gcCount # number of GC's
10956#    li $v0,1 # code for print-int
10960#    syscall
10964#    li $v0,4 # syscall-code for print-string
10968#    la $a0,newlineString
10972#    syscall # print newline

    # terminate execution
10976#    li $v0,10 #syscall-code for "exit"
10980#    syscall

10984:outOfHeapMemory:
10984#    la $a0,heapMemoryMsg
10988#    j exitError
10992:divByZeroError:
10992#    la $a0,divByZeroMsg
10996#    j exitError
11000:strIndexOutOfBounds:
11000#    la $a0,strIndexOutOfBoundsMsg
11004#    j exitError
11008:arrayIndexOutOfBounds:
11008#    la $a0,arrayIndexOutOfBoundsMsg
11012#    j exitError
11016:arraySizeOutOfBounds:
11016#    la $a0,arraySizeOutOfBoundsMsg
11020#    j exitError
11024:nullPtrException:
11024#    la $a0,nullPtrExceptionMsg
11028#    j exitError
11032:badIntegerFormat:
11032#    la $a0,badIntegerFormatMsg
11036#    j exitError
11040:castException:
11040#    la $a0,castExceptionMsg
11044#    j exitError
############## data section ################
    .data
11880:hexChars:
    .ascii "0123456789abcdef"
    .align 2
11896:cur_seg:
    .word 0

11900:lastCharRead:
    .word -2 # -2 => no buffered character
11904:prevHashConstant:
    .word 0x2785173c
11908:gcCount:
    .word 0

11912:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
11939:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
11962:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
11997:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
12031:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
12064:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
12095:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
12143:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
12164:gcMsg: 
      .asciiz "\nGC!\n"
12170:gcCountMsg: 
      .asciiz "Number of garbage collections: "

12202:nullStr:
    .asciiz "null"
12207:trueString:
    .asciiz "true"
12212:falseString:
    .asciiz "false"
12218:exitString:
    .ascii "Program execution completed."
    #### "falls through" here
12246:newlineString:
    .asciiz "\n"
    
    .align 2
12248:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

12252:seg0_start:
    .space 0x100000
1060828:seg0_end:
1060828:seg1_start:
    .space 0x100000
2109404:seg1_end:
