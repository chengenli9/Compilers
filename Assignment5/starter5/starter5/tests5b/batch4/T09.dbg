##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
3152:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
3152#    lw $t0,-8($s2) # get word with hash bits from this
3156#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
3160#    addu $t0,$t1

3164#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
3168:mth_equals_Object:
3168#    move $t0,$s2 # first pointer (this)
3172#    lw $t1,($sp) # second pointer
3176#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
3177##...subu $at,$t0,$t1
3181##...sltiu $t0,$at,1

3184#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
3188:mth_hashCode_String:
3188#    move $t0,$s2 # put this pointer in t0

3192#    li $t2,0 # current hash value
3196#    lw $t1,-4($t0) # negative of number of characters in string
3200#    beq $t1,$zero,done_hashCode_String # if zero length => done
3204#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
3208#    and $t0,0xfffffffc # adjust for padding
3209##...lui $at,65535
3213##...ori $at,$at,0xfffc
3217##...and $t0,$t0,$at
3220#    subu $t1,$t0,$t1 # address at end of string +12
3224:loop_hashCode_String:    
3224#    sll $t4,$t2,5 # multiply by 32
3228#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
3232#    lbu $t3,-12($t0) # current character
3236#    addu $t2,$t3 # add in current character
3240#    addu $t0,1 # go to next character's address
3244#    bne $t0,$t1,loop_hashCode_String # loop back if more
3248:done_hashCode_String:    

    # push int on stack
3248#    move $t0, $t2 # put $t2 in return slot
3252#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
3256:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
3256#    subu $sp,4
3260#    sw $ra,($sp)
    
    # get hash value
3264#    lw $t2,-12($s2) # vtable address
3268#    lw $t0,($t2) # method address
3272#    jalr $t0
3276#    subu $sp,8 # push result (int in $t0) on stack
3280#    sw $s5,4($sp)
3284#    sw $t0,($sp)

    # compute print-size of hash value
3288#    li $t0, 1
3292#    lw $t1, ($sp)
3296#    srl $t1,$t1,4
3300#    beq $t1,$zero,toString_skip_loop
3304:toString_loop_top:
3304#    addu $t0,1
3308#    srl $t1,$t1,4
3312#    bne $t1,$zero,toString_loop_top
3316:toString_skip_loop:
3316#    subu $sp,8
3320#    sw $s5,4($sp)
3324#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
3328#    lw $t2,-12($s2) # vtable address
3332#    move $t0,$t2
3336:toString_checkTagBit:
3336#    subu $t0,1
3340#    lb $t1,($t0)
3344#    and $t1,0x80
3345##...lui $at,0
3349##...ori $at,$at,0x80
3353##...and $t1,$t1,$at
3356#    beq $t1,$zero,toString_checkTagBit
3360#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
3364#    subu $sp,8
3368#    sw $t1,($sp)
3372#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
3376#    move $s7,$zero # -4 offset header word
3380#    lw $t4,8($sp) # bytes for hash value
3384#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
3388#    addu $t4,8
3392#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
3396#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

3400#    li $t0,CLASS_String # store string vtable address into ...
3404#    sw $t0,-12($s7) # ... -12 offset in object header
3408#    lw $t2,-12($s2) # our object's vtable address
3412#    lw $t5,4($sp) # number characters in prefix
3416#    lw $t1,12($sp) # number of characters in hashcode
3420#    addu $t3,$t1,$t5 # number of characters in string ...
3424#    addu $t3,1 # ... including the '@' character
3428#    subu $t0,$zero,$t3 # store negated length into ...
3432#    sw $t0,-4($s7) # ... -4 offset header word
3436#    lw $t0,-8($s7) # get -8 offset header-word
3440#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
3441##...slt $at,$t0,$zero
3445##...beq $at,$zero,3464
3448#    and $t0,0xff # mask off object's hash value ...
3449##...lui $at,0
3453##...ori $at,$at,0xff
3457##...and $t0,$t0,$at
3460#    sw $t0,-8($s7) # ... and store back into -8 header-word
3464:skipMask_toString:
3464#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
3468#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
3472#    subu $t4,$t2,$t5
3476:toString_copyLoop:    
3476#    lb $t3,($t4)
3480#    and $t3,0x7f # mask off sign bit (in case first word)
3481##...lui $at,0
3485##...ori $at,$at,0x7f
3489##...and $t3,$t3,$at
3492#    sb $t3,-8($t0)
3496#    addu $t4,1
3500#    addu $t0,1
3504#    blt $t4,$t2,toString_copyLoop
3505##...slt $at,$t4,$t2
3509##...bne $at,$zero,3476

    # copy the '@' sign
3512#    li $t3,'@'
3516#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
3520#    addu $t2,$t0,$t1 # address of last byte in string to store +8
3524#    lw $t3,20($sp) # hash code to print
3528:toString_hashCopyLoop:
3528#    and $t4,$t3,0xf
3532#    srl $t3,4
3536#    lb $t4,hexChars($t4)
3540#    sb $t4,-8($t2)
3544#    subu $t2,$t2,1
3548#    bgt $t2,$t0,toString_hashCopyLoop
3549##...slt $at,$t0,$t2
3553##...bne $at,$zero,3528

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
3556#    addu $sp,28
3560#    lw $ra,($sp)
3564#    addu $sp,4
3568#    move $t0, $s7 # return string we created
3572#    jr $ra
