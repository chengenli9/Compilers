2917##...lui $at,32768
2921##...or $t1,$at,$t1
2924#    and $t1,0xffffff00 # clear low bit
2925##...lui $at,65535
2929##...ori $at,$at,0xff00
2933##...and $t1,$t1,$at
2936#    or $s6,$t1
2940:firstHeaderLarge:
