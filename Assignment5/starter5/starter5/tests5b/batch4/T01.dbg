##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
2540:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
2540#    lw $t0,-8($s2) # get word with hash bits from this
2544#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
2548#    addu $t0,$t1

2552#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
2556:mth_equals_Object:
2556#    move $t0,$s2 # first pointer (this)
2560#    lw $t1,($sp) # second pointer
2564#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
2565##...subu $at,$t0,$t1
2569##...sltiu $t0,$at,1

2572#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
2576:mth_hashCode_String:
2576#    move $t0,$s2 # put this pointer in t0

2580#    li $t2,0 # current hash value
2584#    lw $t1,-4($t0) # negative of number of characters in string
2588#    beq $t1,$zero,done_hashCode_String # if zero length => done
2592#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
2596#    and $t0,0xfffffffc # adjust for padding
2597##...lui $at,65535
2601##...ori $at,$at,0xfffc
2605##...and $t0,$t0,$at
2608#    subu $t1,$t0,$t1 # address at end of string +12
2612:loop_hashCode_String:    
2612#    sll $t4,$t2,5 # multiply by 32
2616#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
2620#    lbu $t3,-12($t0) # current character
2624#    addu $t2,$t3 # add in current character
2628#    addu $t0,1 # go to next character's address
2632#    bne $t0,$t1,loop_hashCode_String # loop back if more
2636:done_hashCode_String:    

    # push int on stack
2636#    move $t0, $t2 # put $t2 in return slot
2640#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
2644:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
2644#    subu $sp,4
2648#    sw $ra,($sp)
    
    # get hash value
2652#    lw $t2,-12($s2) # vtable address
2656#    lw $t0,($t2) # method address
2660#    jalr $t0
2664#    subu $sp,8 # push result (int in $t0) on stack
2668#    sw $s5,4($sp)
2672#    sw $t0,($sp)

    # compute print-size of hash value
2676#    li $t0, 1
2680#    lw $t1, ($sp)
2684#    srl $t1,$t1,4
2688#    beq $t1,$zero,toString_skip_loop
2692:toString_loop_top:
2692#    addu $t0,1
2696#    srl $t1,$t1,4
2700#    bne $t1,$zero,toString_loop_top
2704:toString_skip_loop:
2704#    subu $sp,8
2708#    sw $s5,4($sp)
2712#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
2716#    lw $t2,-12($s2) # vtable address
2720#    move $t0,$t2
2724:toString_checkTagBit:
2724#    subu $t0,1
2728#    lb $t1,($t0)
2732#    and $t1,0x80
2733##...lui $at,0
2737##...ori $at,$at,0x80
2741##...and $t1,$t1,$at
2744#    beq $t1,$zero,toString_checkTagBit
2748#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
2752#    subu $sp,8
2756#    sw $t1,($sp)
2760#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
2764#    move $s7,$zero # -4 offset header word
2768#    lw $t4,8($sp) # bytes for hash value
2772#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
2776#    addu $t4,8
