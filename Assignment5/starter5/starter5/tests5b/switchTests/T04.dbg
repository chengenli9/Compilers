###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
980:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
980#    subu $sp,4
984#    sw $ra,($sp)
    
    # get hash value
988#    lw $t2,-12($s2) # vtable address
992#    lw $t0,($t2) # method address
996#    jalr $t0
1000#    subu $sp,8 # push result (int in $t0) on stack
1004#    sw $s5,4($sp)
1008#    sw $t0,($sp)

    # compute print-size of hash value
1012#    li $t0, 1
1016#    lw $t1, ($sp)
1020#    srl $t1,$t1,4
1024#    beq $t1,$zero,toString_skip_loop
1028:toString_loop_top:
1028#    addu $t0,1
1032#    srl $t1,$t1,4
1036#    bne $t1,$zero,toString_loop_top
1040:toString_skip_loop:
1040#    subu $sp,8
1044#    sw $s5,4($sp)
1048#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
1052#    lw $t2,-12($s2) # vtable address
1056#    move $t0,$t2
1060:toString_checkTagBit:
1060#    subu $t0,1
1064#    lb $t1,($t0)
1068#    and $t1,0x80
1069##...lui $at,0
1073##...ori $at,$at,0x80
1077##...and $t1,$t1,$at
1080#    beq $t1,$zero,toString_checkTagBit
1084#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
1088#    subu $sp,8
1092#    sw $t1,($sp)
1096#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
1100#    move $s7,$zero # -4 offset header word
1104#    lw $t4,8($sp) # bytes for hash value
1108#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
1112#    addu $t4,8
1116#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
1120#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

1124#    li $t0,CLASS_String # store string vtable address into ...
1128#    sw $t0,-12($s7) # ... -12 offset in object header
1132#    lw $t2,-12($s2) # our object's vtable address
1136#    lw $t5,4($sp) # number characters in prefix
1140#    lw $t1,12($sp) # number of characters in hashcode
1144#    addu $t3,$t1,$t5 # number of characters in string ...
1148#    addu $t3,1 # ... including the '@' character
1152#    subu $t0,$zero,$t3 # store negated length into ...
1156#    sw $t0,-4($s7) # ... -4 offset header word
1160#    lw $t0,-8($s7) # get -8 offset header-word
1164#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
1165##...slt $at,$t0,$zero
1169##...beq $at,$zero,1188
1172#    and $t0,0xff # mask off object's hash value ...
1173##...lui $at,0
1177##...ori $at,$at,0xff
1181##...and $t0,$t0,$at
1184#    sw $t0,-8($s7) # ... and store back into -8 header-word
1188:skipMask_toString:
1188#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
1192#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
1196#    subu $t4,$t2,$t5
1200:toString_copyLoop:    
1200#    lb $t3,($t4)
1204#    and $t3,0x7f # mask off sign bit (in case first word)
1205##...lui $at,0
1209##...ori $at,$at,0x7f
1213##...and $t3,$t3,$at
1216#    sb $t3,-8($t0)
1220#    addu $t4,1
1224#    addu $t0,1
1228#    blt $t4,$t2,toString_copyLoop
1229##...slt $at,$t4,$t2
1233##...bne $at,$zero,1200

    # copy the '@' sign
1236#    li $t3,'@'
1240#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
1244#    addu $t2,$t0,$t1 # address of last byte in string to store +8
1248#    lw $t3,20($sp) # hash code to print
1252:toString_hashCopyLoop:
1252#    and $t4,$t3,0xf
1256#    srl $t3,4
1260#    lb $t4,hexChars($t4)
1264#    sb $t4,-8($t2)
1268#    subu $t2,$t2,1
1272#    bgt $t2,$t0,toString_hashCopyLoop
1273##...slt $at,$t0,$t2
1277##...bne $at,$zero,1252

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
1280#    addu $sp,28
1284#    lw $ra,($sp)
1288#    addu $sp,4
1292#    move $t0, $s7 # return string we created
1296#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
1300:mth_equals_String:
    
    # quick test for obvious false
1300#    lw $t0,($sp) # second parameter
1304#    beq $t0,$zero,goEsFalse # go return false if null
1308#    lw $t1,-12($t0) # vtable pointer
1312#    la $t2,CLASS_String # string vtable pointer
1316#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
1320#    subu $sp,12
1324#    sw $ra,8($sp)
1328#    sw $s2,4($sp)
1332#    sw $t0,($sp)
1336#    jal mth_compareTo_String
1340#    lw $s2, 4($sp) #restore this pointer and pop parameters
1344#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
1348#    seq $t0,$t0,$zero
1349##...subu $at,$t0,$zero
1353##...sltiu $t0,$at,1

    # pop return address and return $t0
1356#    lw $ra,($sp)
1360#    addu $sp,4

1364#    jr $ra # return
    
1368:goEsFalse:
    # put 0 in $t0 and return
1368#    li $t0, 0
1372#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
1376:mth_toString_String:
    #we are a string, so return this.
1376#    move $t0, $s2
1380#    jr $ra

###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
1384:mth_readLine_Lib:
    
1384#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
1388#    sw $ra, 4($sp) # save $ra
1392#    move $t1,$sp # save "original" sp

1396:  doRead:

    # read the character
1396#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
1400#    subu $t2,$v0,13
1404#    bne $t2,$zero,notReturnRL
1408#    jal readLogicalChar
1412#    subu $t2,$v0,10 # check for newline
1416#    beq $t2,$zero,foundNewLine
1420#    sw $v0,lastCharRead # push back character into queue
1424#    j foundNewLine # go process the line

1428:  notReturnRL:

    # at this point, $v0 has our character

1428#    subu $t0,$v0,10
1432#    beq $t0,$zero,foundNewLine
1436#    blt $v0,$zero,foundEof
1437##...slt $at,$v0,$zero
1441##...bne $at,$zero,1456

    # we have a character, so push it onto stack
1444#    subu $sp,$sp,4
1448#    sw $v0,($sp)

    # loop back up to get next character
1452#    j doRead

1456:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
1456#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
1460#    li $s7, 0 # return-value: null
1464#    j rlReturn # return

1468:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
1468#    subu $t0,$t1,$sp # number of chars we read (times 4)
1472#    srl $s6,$t0,2 # number of words on stack with chars
1476#    subu $sp,$sp,4 # push char-count ...
1480#    sw $s6,($sp) # ... onto stack
1484#    addu $t2,$t0,5 # GC tag, incl. for count-word
1488#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
1492#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
1496#    srl $s6,$s6,2  # data words in object
1500#    move $s7,$zero # object words in object
1504#    jal newObject  # allocate space
    
    # store header words
1508#    la $t0,CLASS_String
1512#    sw $t0,-12($s7)# store class tag (String) into object
1516#    lw $t2,4($sp) # char-count
1520#    sll $t1,$t2,2 # 4 times number of chars
1524#    subu $t2,$zero,$t2 # negative of char-count
1528#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
1532#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
1536#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
1537##...slt $at,$t0,$zero
1541##...beq $at,$zero,1560
1544#    and $t0,0xff # mask off object's hash value ...
1545##...lui $at,0
1549##...ori $at,$at,0xff
1553##...and $t0,$t0,$at
1556#    sw $t0,-8($s7) # ... and store back into -8 header-word
1560:  skipMask_readLine:

1560#    sll $t0,$t0,2 # data bytes in object
1564#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
1568#    subu $t0,$t0,$t2 # place to store last character (plus 9)
1572#    addu $sp,$sp,8 # pop redundant object-pointer and count
1576#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

1580#    beq $sp,$t1,rlReturn
1584:  charCopyLoop:
1584#    lw $t2,($sp)
1588#    sb $t2,-9($t0)
1592#    addu $sp,$sp,4
1596#    subu $t0,$t0,1
1600#    bne $sp,$t1,charCopyLoop
1604:  rlReturn:

1604#    lw $ra, 4($sp)
1608#    addu $sp, 8   # pop $ra and pointless word off stack
1612#    move $t0, $s7 # return string we allocated in $s7
1616#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
1620:mth_readInt_Lib:

    # save $ra by pushing onto stack
1620#    subu $sp,$sp,4
1624#    sw $ra,($sp)

1628:  riSkipWhiteLoop:
    # read a character
1628#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
1632#    subu $t0,$v0,32
1636#    bgt $t0,$zero,nonWhite
1637##...slt $at,$zero,$t0
1641##...bne $at,$zero,1684
1644#    beq $t0,$zero,riSkipWhiteLoop # start over if space
1648#    subu $t0,$v0,10
1652#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
1656#    subu $t0,$v0,9
1660#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
1664#    subu $t0,$v0,13
1668#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
1672#    subu $t0,$v0,12
1676#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
1680#    j badIntegerFormat # illegal integer char: abort program

1684:  nonWhite:
1684#    subu $t0,$v0,'-'
1688#    li $t4,1 # final multiplier
1692#    bne $t0,$zero,helpReadInt # go read
1696#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
1700#    jal readLogicalChar

1704:  helpReadInt:
1704#    li $t2,10
1708#    subu $t1,$v0,'0' # convert digit to 0-9 value
1712#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
1713##...sltu $at,$t1,$t2
1717##...beq $at,$zero,3964
1720#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

1724:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

1724#    jal readLogicalChar # read next character
1728#    subu $t1,$v0,'0' # convert digit to 0-9 value
1732#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
1733##...sltu $at,$t1,$t2
1737##...beq $at,$zero,1756

1740#    mul $t3,$t3,$t2 # multiply old value by 10
1741##...mult $t3,$t2
1745##...mflo $t3
1748#    addu $t3,$t3,$t1 # add in value of new digit
1752#    j digitLoop

1756:  doneDigitLoop:

    # "push back" unused character into queue
1756#    sw $v0,lastCharRead

    # restore return address
1760#    lw $ra,($sp)
1764#    addu $sp, 4

    # multiply by sign and put return value in $t0
1768#    mult $t3,$t4 # multiply to account for poss. minus sign
1772#    mflo $t3
1776#    move $t0, $t3
    
    # return
1780#    jr $ra

###################################################################
# readChar() - library method (class Lib)
# - reads a single character from standard input
# - returns the integer that is the encoding of the character
# - returns -1 if end of file was encountered
# - parameter:
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
1784:mth_readChar_Lib:

    # save $ra by pushing onto stack
1784#    subu $sp,$sp,4
1788#    sw $ra,($sp)

      # read the character
1792#    jal readLogicalChar

    # restore return address; put value in $t0
    # replacing this-pointer saved return address
1796#    lw $ra,($sp)
1800#    addu $sp, 4
1804#    move $t0, $v0

    # return
1808#    jr $ra

########################################################
# printStr(str) - library method (class Lib)
# - prints string to standard output
# parameters:
#   - ($sp) - the string to print
#   - 4($sp) - old-this-pointer
########################################################
1812:mth_printStr_Lib:
    # check for null, printing "(null)", if so
1812#    lw $t0,($sp)
1816#    bne $t0,$zero,psNotNull

    # print "(null)"
1820#    la $a0,nullStr
1824#    li $v0,4
1828#    syscall
1832#    j donePrintStr
    
1836:  psNotNull:
    ##### we have a non-null string #####
    # this means that:
    # - number of data words in -8($t0):
    #   - if the sign bit is 1, the low 31 bits
