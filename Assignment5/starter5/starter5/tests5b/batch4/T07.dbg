    #### not be artificially negative
3800#    sll $t1,$t1,2 # convert to byte-count
3804#    addu $t0,$t2,$t1 # skip over object
3808#    j gcTestIterDone2 # go do next object, if any

    ###################################################
    # at this point:
    # - the object has been restored to normal status--that is, the
    #   word-swap has been done
    # - $t2 contains a pointer to the object
    ###################################################
    
3812:  gcNotDataArray:
3812#    lw $t3,-4($t2) # # object words (negative treated as zero)
3816#    bge $t3,$zero,gcH2Neg2
3817##...slt $at,$t3,$zero
3821##...beq $at,$zero,3828
3824#    move $t3,$zero
3828:  gcH2Neg2:
3828#    sll $t3,$t3,2 # # object bytes
3832#    move $t0,$t2 # address of first pointer in object
3836#    add $s1,$t2,$t3 # limit address for this object

    #####################################################
    # At this point, we have to "translate" all pointers,
    # starting at $t0 to (but not including) $s1
    #####################################################

    # if there are no pointer-slots (i.e., $t0=$s1), skip this
    # part
3840#    beq $t0,$s1,gcTestIterDone2
    
3844:  gcNextPointerInObject:
    # get pointer from object
3844#    lw $t1,($t0)

    # if value is out of range, and is therefore does not refer
    # to an object, just go loop back and do the next one
3848#    bleu $t1,$t6,gcGoNextPointerSlot
3849##...sltu $at,$t6,$t1
3853##...beq $at,$zero,3996
3856#    bgtu $t1,$t7,gcGoNextPointerSlot
3857##...sltu $at,$t7,$t1
3861##...bne $at,$zero,3996

    # if the object has already been moved, update the stack-value
    # via the forwarding pointer
3864#    lw $t8,-8($t1) # possible forwarding tag
3868#    bne $t8,$zero,gcNoForward2 # if not forwarding tag, go copy
3872#    lw $t8,-4($t1) # forwarding pointer: object's new address
3876#    sw $t8,($t0) # update pointer in object
3880#    j gcGoNextPointerSlot # do next iteration

3884:  gcNoForward2:
    #########################################################
    # we actually need to copy the object into the new space
    #########################################################

    #########################################################
    # At this point:
    # - $t0 contains the address of the heap-slot we're translating
    # - $t1 will contain the contents of the heap-slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space, which will also be the first address
    #   of the target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # Then during processing:
    # And when we're actually copying an object:
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $t8 will contain a pointer to the target object
    # - available for use: $s0, $t8, $t9
    ##########################################################

    # compute the amount of space that is needed
3884#    bge $t8,$zero,gcSkip5 # # words in negative-offset portion
3885##...slt $at,$t8,$zero
3889##...beq $at,$zero,3904
3892#    and $t8,0xff # mask off hash bits
3893##...lui $at,0
3897##...ori $at,$at,0xff
3901##...and $t8,$t8,$at

3904:  gcSkip5:
3904#    sll $t8,$t8,2 # bytes in negative-offset portion ...
3908#    addu $t8,$t8,8 # ... add in bytes for header-words
3912#    subu $t4,$t1,$t8 # address of first word of source object
3916#    lw $t3,-4($t1) # # words in positive-offset portion
3920#    bge $t3,$zero,gcNoNeg
3921##...slt $at,$t3,$zero
3925##...beq $at,$zero,3932
3928#    move $t3,$zero # negative treated as zero
3932:  gcNoNeg:
3932#    sll $t3,$t3,2 # bytes in negative-offset portion
3936#    addu $t3,$t3,$t1 # address one word past last word of source

3940#    addu $t8,$s3,$t8 # pointer to target object

    #########################################################
    # At this point:
    # - $t0 contains the address of the stack slot we'll
    #   process next
    # - $t1 contains the contents of the stack slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $t8 contains the pointer to the target object
    # - $s1 contains the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0, $t9
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger"
3944#    lw $s0,($t4)
3948#    lw $t9,-8($t1)
3952#    sw $t9,($t4)
3956#    sw $s0,-8($t1)

    # copy all source bytes to the target
3960:  gCinnerCopy2:
3960#    lw $s0,($t4)
3964#    sw $s0,($s3)
3968#    addu $t4,$t4,4
3972#    addu $s3,$s3,4
3976#    bltu $t4,$t3,gCinnerCopy2
3977##...sltu $at,$t4,$t3
3981##...bne $at,$zero,3960

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
3984#    sw $zero,-8($t1) # 0 in first header-slot
3988#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
3992#    sw $t8,($t0)

3996:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
3996#    addu $t0,$t0,4
4000#    bltu $t0,$s1,gcNextPointerInObject
4001##...sltu $at,$t0,$s1
4005##...bne $at,$zero,3844

4008:  gcTestIterDone2:
4008#    bltu $t0,$s3,gcHeapCopyLoop
4009##...sltu $at,$t0,$s3
4013##...bne $at,$zero,3728

    ###### end outer loop to copy all non-stack-direct objects ######

4016:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
4016#    lw $s2,($sp)
4020#    addu $sp,$sp,4

    # mark us as having already GC'd
4024#    move $t5,$s5

    # go try and allocate again
4028#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
4032:vm_init:

    # mark bottom of stack
4032#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
4036#    move $s2,$zero

    #set up the "five" register
4040#    li $s5,5

4044#    la $s3,seg0_start
4048#    la $s4,seg0_end
4049##...lui $s4,16
4053##...addiu $s4,$s4,4920
    
    # return
4056#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4060:divide:
    # get parameters; abort if divisor zero
4060#    lw $t0,($sp)
4064#    lw $t1,8($sp)
4068#    beq $t0,$zero,divByZeroError
    
    # perform division
4072#    div $t1,$t0
4076#    mflo $t0

    # store result, adjust stack and return
4080#    addu $sp,$sp,8 # adjust stack
4084#    sw $t0,($sp) # store result
4088#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4092:remainder:
    # get parameters; abort if divisor zero
4092#    lw $t0,($sp)
4096#    lw $t1,8($sp)
4100#    beq $t0,$zero,divByZeroError
    
    # perform division
4104#    div $t1,$t0
4108#    mfhi $t0

    # store result, adjust stack and return
4112#    addu $sp,$sp,8 # adjust stack
4116#    sw $t0,($sp) # store result
4120#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
4124:checkCast:
    # get object, allow immediately if null
4124#    lw $t2,($sp)
4128#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
4132#    lw $t2,-12($t2) # vtable address
4136#    bge $t2,$t1,castException
4137##...slt $at,$t2,$t1
4141##...beq $at,$zero,4312
4144#    blt $t2,$t0,castException
4145##...slt $at,$t2,$t0
4149##...bne $at,$zero,4312
    
    # return, leaving object unchanged on stack
4152:  checkCastReturn:    
4152#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
4156:instanceOf:
    # get object, go return false if null
4156#    lw $t2,($sp)
4160#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
4164#    lw $t2,-12($t2) # vtable address
4168#    sge $t0,$t2,$t0 # are we >= the lower limit?
4169##...slt $t0,$t2,$t0
4173##...xori $t0,$t0,0x1
4176#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
4180#    and $t2,$t0,$t1
4184#    sw $t2,($sp)
4188:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
4188#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

4192:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
4192#    li $v0,4 # syscall-code for print-string
4196#    syscall
4200:exit:
    # print termination message
4200#    li $v0,4 # syscall-code for print-string
4204#    la $a0,exitString
4208#    syscall

    # print number of garbage collections
4212#    li $v0,4 # syscall-code for print-string
4216#    la $a0,gcCountMsg
4220#    syscall # print "Number of ..."
4224#    lw $a0,gcCount # number of GC's
4228#    li $v0,1 # code for print-int
4232#    syscall
4236#    li $v0,4 # syscall-code for print-string
4240#    la $a0,newlineString
4244#    syscall # print newline

    # terminate execution
4248#    li $v0,10 #syscall-code for "exit"
4252#    syscall

4256:outOfHeapMemory:
4256#    la $a0,heapMemoryMsg
4260#    j exitError
4264:divByZeroError:
4264#    la $a0,divByZeroMsg
4268#    j exitError
4272:strIndexOutOfBounds:
4272#    la $a0,strIndexOutOfBoundsMsg
4276#    j exitError
4280:arrayIndexOutOfBounds:
4280#    la $a0,arrayIndexOutOfBoundsMsg
4284#    j exitError
4288:arraySizeOutOfBounds:
4288#    la $a0,arraySizeOutOfBoundsMsg
4292#    j exitError
4296:nullPtrException:
4296#    la $a0,nullPtrExceptionMsg
4300#    j exitError
4304:badIntegerFormat:
4304#    la $a0,badIntegerFormatMsg
4308#    j exitError
4312:castException:
4312#    la $a0,castExceptionMsg
4316#    j exitError
############## data section ################
    .data
4548:hexChars:
    .ascii "0123456789abcdef"
    .align 2
4564:cur_seg:
    .word 0

4568:lastCharRead:
    .word -2 # -2 => no buffered character
4572:prevHashConstant:
    .word 0x2785173c
4576:gcCount:
    .word 0

4580:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
4607:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
4630:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
4665:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
4699:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
4732:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
4763:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
4811:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
4832:gcMsg: 
      .asciiz "\nGC!\n"
4838:gcCountMsg: 
      .asciiz "Number of garbage collections: "

4870:nullStr:
    .asciiz "null"
4875:trueString:
    .asciiz "true"
4880:falseString:
    .asciiz "false"
4886:exitString:
    .ascii "Program execution completed."
    #### "falls through" here
4914:newlineString:
    .asciiz "\n"
    
    .align 2
4916:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

4920:seg0_start:
    .space 0x100000
1053496:seg0_end:
1053496:seg1_start:
    .space 0x100000
2102072:seg1_end:
