##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1764:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
1764#    lw $t0,-8($s2) # get word with hash bits from this
1768#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
1772#    addu $t0,$t1

1776#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1780:mth_equals_Object:
1780#    move $t0,$s2 # first pointer (this)
1784#    lw $t1,($sp) # second pointer
1788#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
1789##...subu $at,$t0,$t1
1793##...sltiu $t0,$at,1

1796#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1800:mth_hashCode_String:
1800#    move $t0,$s2 # put this pointer in t0

1804#    li $t2,0 # current hash value
1808#    lw $t1,-4($t0) # negative of number of characters in string
1812#    beq $t1,$zero,done_hashCode_String # if zero length => done
1816#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
1820#    and $t0,0xfffffffc # adjust for padding
1821##...lui $at,65535
1825##...ori $at,$at,0xfffc
1829##...and $t0,$t0,$at
1832#    subu $t1,$t0,$t1 # address at end of string +12
1836:loop_hashCode_String:    
1836#    sll $t4,$t2,5 # multiply by 32
1840#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
1844#    lbu $t3,-12($t0) # current character
1848#    addu $t2,$t3 # add in current character
1852#    addu $t0,1 # go to next character's address
1856#    bne $t0,$t1,loop_hashCode_String # loop back if more
1860:done_hashCode_String:    

    # push int on stack
1860#    move $t0, $t2 # put $t2 in return slot
1864#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
1868:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
1868#    subu $sp,4
1872#    sw $ra,($sp)
    
    # get hash value
1876#    lw $t2,-12($s2) # vtable address
1880#    lw $t0,($t2) # method address
1884#    jalr $t0
1888#    subu $sp,8 # push result (int in $t0) on stack
1892#    sw $s5,4($sp)
1896#    sw $t0,($sp)

    # compute print-size of hash value
1900#    li $t0, 1
1904#    lw $t1, ($sp)
1908#    srl $t1,$t1,4
1912#    beq $t1,$zero,toString_skip_loop
1916:toString_loop_top:
1916#    addu $t0,1
1920#    srl $t1,$t1,4
1924#    bne $t1,$zero,toString_loop_top
1928:toString_skip_loop:
1928#    subu $sp,8
1932#    sw $s5,4($sp)
1936#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
1940#    lw $t2,-12($s2) # vtable address
1944#    move $t0,$t2
1948:toString_checkTagBit:
1948#    subu $t0,1
1952#    lb $t1,($t0)
1956#    and $t1,0x80
1957##...lui $at,0
1961##...ori $at,$at,0x80
1965##...and $t1,$t1,$at
1968#    beq $t1,$zero,toString_checkTagBit
1972#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
1976#    subu $sp,8
1980#    sw $t1,($sp)
1984#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
1988#    move $s7,$zero # -4 offset header word
1992#    lw $t4,8($sp) # bytes for hash value
1996#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
2000#    addu $t4,8
2004#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
2008#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

2012#    li $t0,CLASS_String # store string vtable address into ...
2016#    sw $t0,-12($s7) # ... -12 offset in object header
2020#    lw $t2,-12($s2) # our object's vtable address
2024#    lw $t5,4($sp) # number characters in prefix
2028#    lw $t1,12($sp) # number of characters in hashcode
2032#    addu $t3,$t1,$t5 # number of characters in string ...
2036#    addu $t3,1 # ... including the '@' character
2040#    subu $t0,$zero,$t3 # store negated length into ...
2044#    sw $t0,-4($s7) # ... -4 offset header word
2048#    lw $t0,-8($s7) # get -8 offset header-word
2052#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
2053##...slt $at,$t0,$zero
2057##...beq $at,$zero,2076
2060#    and $t0,0xff # mask off object's hash value ...
2061##...lui $at,0
2065##...ori $at,$at,0xff
2069##...and $t0,$t0,$at
2072#    sw $t0,-8($s7) # ... and store back into -8 header-word
2076:skipMask_toString:
2076#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
2080#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
2084#    subu $t4,$t2,$t5
2088:toString_copyLoop:    
2088#    lb $t3,($t4)
2092#    and $t3,0x7f # mask off sign bit (in case first word)
2093##...lui $at,0
2097##...ori $at,$at,0x7f
2101##...and $t3,$t3,$at
2104#    sb $t3,-8($t0)
2108#    addu $t4,1
2112#    addu $t0,1
2116#    blt $t4,$t2,toString_copyLoop
2117##...slt $at,$t4,$t2
2121##...bne $at,$zero,2088

    # copy the '@' sign
2124#    li $t3,'@'
2128#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
2132#    addu $t2,$t0,$t1 # address of last byte in string to store +8
2136#    lw $t3,20($sp) # hash code to print
2140:toString_hashCopyLoop:
2140#    and $t4,$t3,0xf
2144#    srl $t3,4
2148#    lb $t4,hexChars($t4)
2152#    sb $t4,-8($t2)
2156#    subu $t2,$t2,1
2160#    bgt $t2,$t0,toString_hashCopyLoop
2161##...slt $at,$t0,$t2
2165##...bne $at,$zero,2140

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
2168#    addu $sp,28
2172#    lw $ra,($sp)
2176#    addu $sp,4
2180#    move $t0, $s7 # return string we created
2184#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
2188:mth_equals_String:
    
    # quick test for obvious false
2188#    lw $t0,($sp) # second parameter
2192#    beq $t0,$zero,goEsFalse # go return false if null
2196#    lw $t1,-12($t0) # vtable pointer
2200#    la $t2,CLASS_String # string vtable pointer
2204#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
2208#    subu $sp,12
2212#    sw $ra,8($sp)
2216#    sw $s2,4($sp)
2220#    sw $t0,($sp)
2224#    jal mth_compareTo_String
2228#    lw $s2, 4($sp) #restore this pointer and pop parameters
2232#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
2236#    seq $t0,$t0,$zero
2237##...subu $at,$t0,$zero
2241##...sltiu $t0,$at,1

    # pop return address and return $t0
2244#    lw $ra,($sp)
2248#    addu $sp,4

2252#    jr $ra # return
    
2256:goEsFalse:
    # put 0 in $t0 and return
2256#    li $t0, 0
2260#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
2264:mth_toString_String:
    #we are a string, so return this.
2264#    move $t0, $s2
2268#    jr $ra

###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
2272:mth_readLine_Lib:
    
2272#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
2276#    sw $ra, 4($sp) # save $ra
2280#    move $t1,$sp # save "original" sp

2284:  doRead:

    # read the character
2284#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
2288#    subu $t2,$v0,13
2292#    bne $t2,$zero,notReturnRL
2296#    jal readLogicalChar
2300#    subu $t2,$v0,10 # check for newline
2304#    beq $t2,$zero,foundNewLine
2308#    sw $v0,lastCharRead # push back character into queue
2312#    j foundNewLine # go process the line

2316:  notReturnRL:

    # at this point, $v0 has our character

2316#    subu $t0,$v0,10
2320#    beq $t0,$zero,foundNewLine
2324#    blt $v0,$zero,foundEof
2325##...slt $at,$v0,$zero
2329##...bne $at,$zero,2344

    # we have a character, so push it onto stack
2332#    subu $sp,$sp,4
2336#    sw $v0,($sp)

    # loop back up to get next character
2340#    j doRead

2344:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
2344#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
2348#    li $s7, 0 # return-value: null
2352#    j rlReturn # return

2356:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
2356#    subu $t0,$t1,$sp # number of chars we read (times 4)
2360#    srl $s6,$t0,2 # number of words on stack with chars
2364#    subu $sp,$sp,4 # push char-count ...
2368#    sw $s6,($sp) # ... onto stack
2372#    addu $t2,$t0,5 # GC tag, incl. for count-word
2376#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
2380#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
2384#    srl $s6,$s6,2  # data words in object
2388#    move $s7,$zero # object words in object
2392#    jal newObject  # allocate space
    
    # store header words
