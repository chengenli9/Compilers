1164#    seq $t0,$t0,$zero
1165##...subu $at,$t0,$zero
1169##...sltiu $t0,$at,1

    # pop return address and return $t0
1172#    lw $ra,($sp)
1176#    addu $sp,4

1180#    jr $ra # return
    
1184:goEsFalse:
    # put 0 in $t0 and return
1184#    li $t0, 0
1188#    jr $ra # return
