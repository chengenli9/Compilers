6308#    sw $ra,($sp)

6312:  riSkipWhiteLoop:
    # read a character
6312#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
6316#    subu $t0,$v0,32
6320#    bgt $t0,$zero,nonWhite
6321##...slt $at,$zero,$t0
6325##...bne $at,$zero,6368
6328#    beq $t0,$zero,riSkipWhiteLoop # start over if space
6332#    subu $t0,$v0,10
6336#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
6340#    subu $t0,$v0,9
6344#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
6348#    subu $t0,$v0,13
6352#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
6356#    subu $t0,$v0,12
6360#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
6364#    j badIntegerFormat # illegal integer char: abort program

6368:  nonWhite:
6368#    subu $t0,$v0,'-'
6372#    li $t4,1 # final multiplier
6376#    bne $t0,$zero,helpReadInt # go read
6380#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
6384#    jal readLogicalChar

6388:  helpReadInt:
6388#    li $t2,10
6392#    subu $t1,$v0,'0' # convert digit to 0-9 value
6396#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
6397##...sltu $at,$t1,$t2
6401##...beq $at,$zero,8648
6404#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

6408:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

6408#    jal readLogicalChar # read next character
6412#    subu $t1,$v0,'0' # convert digit to 0-9 value
6416#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
6417##...sltu $at,$t1,$t2
6421##...beq $at,$zero,6440

6424#    mul $t3,$t3,$t2 # multiply old value by 10
