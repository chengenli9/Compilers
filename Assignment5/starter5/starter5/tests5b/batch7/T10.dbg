1029##...slt $at,$t0,$zero
1033##...beq $at,$zero,1052
1036#    and $t0,0xff # mask off object's hash value ...
1037##...lui $at,0
1041##...ori $at,$at,0xff
1045##...and $t0,$t0,$at
1048#    sw $t0,-8($s7) # ... and store back into -8 header-word
1052:skipMask_toString:
