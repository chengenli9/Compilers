    # end-limit of the new segment, respectively,
    # Also, update cur_seg to refer to the other segment
5484#    lw $t0,cur_seg
5488#    move $t7,$s4
5492#    la $t6,seg1_start
5493##...lui $t6,16
5497##...addiu $t6,$t6,7024
5500#    la $s3,seg0_start
5504#    la $s4,seg0_end
5505##...lui $s4,16
5509##...addiu $s4,$s4,7024
5512#    sw $zero,cur_seg
5516#    bne $t0,$zero,skipGc1
5520#    la $t6,seg0_start
5524#    la $s3,seg1_start
5525##...lui $s3,16
5529##...addiu $s3,$s3,7024
5532#    la $s4,seg1_end
5533##...lui $s4,32
5537##...addiu $s4,$s4,7024
5540#    sw $s5,cur_seg
5544:  skipGc1:
5544#    li $t5,0x80000000
5548#    lw $t0,stack_bottom
5552#    subu $t0,4


    ###############################################################
    # at this point:
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first address of the target space
    # - $s4 contains the limit address of the target space
    # - cur_seg has been updated to refer to the target space
    # - $t0 contains the address of the deepest stack element
    # - $sp contains the address of the top stack element
    # - $s2 is available for use, having been pushed onto the stack
    # - $t5 contains the value 0x80000000
    ###############################################################

    ###### begin outer loop to copy all stack-direct objects ######

5556:  gcStackCopyLoop:
5556#    lw $t1,($t0) # current stack element

    # test if we have a GC tag
5560#    sll $t2,$t1,31 # zero iff low bit was zero
5564#    bne $t2,$zero,gcBump # go skip data values if low bit not zero

    # bump stack-address pointer
5568#    subu $t0,$t0,4

    # if value is out of range (which includes null=0), and is
    # therefore does not refer to an object on the heap, just go
    # loop back and do the next one
5572#    bleu $t1,$t6,gcTestIterDone1
5573##...sltu $at,$t6,$t1
5577##...beq $at,$zero,5740
5580#    bgtu $t1,$t7,gcTestIterDone1
5581##...sltu $at,$t7,$t1
5585##...bne $at,$zero,5740

    # if the object has already been moved, update the stack-value
    # via the forwarding pointer
5588#    lw $t2,-8($t1) # possible forwarding tag
5592#    bne $t2,$zero,gcNoForward1 # if not forwarding tag, go copy
5596#    lw $t2,-4($t1) # forwarding pointer: object's new address
5600#    sw $t2,4($t0) # update stack value
5604#    j gcTestIterDone1 # do next iteration

5608:  gcNoForward1:
    #########################################################
    # we actually need to copy the object into the new space
    #########################################################

    # compute the amount of space that is needed
5608#    bge $t2,$zero,gcSkip2
5609##...slt $at,$t2,$zero
5613##...beq $at,$zero,5628
5616#    and $t2,0xff #### mask off hash value
5617##...lui $at,0
5621##...ori $at,$at,0xff
5625##...and $t2,$t2,$at
    #### OLD
    #### subu $t2,$zero,$t2 # set to 1 if -1 (number of data words)

5628:  gcSkip2:
5628#    sll $t2,$t2,2
5632#    addu $t2,$t2,8
5636#    subu $t4,$t1,$t2 # address of first word of source
5640#    lw $t3,-4($t1) # number of object words (negative means zero)
5644#    bge $t3,$zero,gcH2Neg1
5645##...slt $at,$t3,$zero
5649##...beq $at,$zero,5656
5652#    move $t3,$zero
5656:  gcH2Neg1:
5656#    sll $t3,$t3,2
5660#    addu $t3,$t3,$t1 # address one word past last word of source

5664#    addu $t2,$s3,$t2 # pointer to target object

    #########################################################
    # At this point:
    # - $t0 contains the address of the stack slot we'll
    #   process next
    # - $t1 contains the contents of the stack slot we're
    #   currently working on, which is a pointer to the source
    #   object (i.e., the address just beyond the object's header)
    # - $t2 contains the pointer to the target object
    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0-2
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger" in the target space
5668#    lw $s0,($t4)
5672#    lw $s1,-8($t1)
5676#    sw $s1,($t4)
5680#    sw $s0,-8($t1)
    
    # copy all source bytes to the target
5684:  gCinnerCopy1:
5684#    lw $s0,($t4)
5688#    sw $s0,($s3)
5692#    addu $t4,$t4,4
5696#    addu $s3,$s3,4
5700#    bltu $t4,$t3,gCinnerCopy1
5701##...sltu $at,$t4,$t3
5705##...bne $at,$zero,5684

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
5708#    sw $zero,-8($t1) # 0 in first header-slot
5712#    sw $t2,-4($t1) # forwarding pointer in second header-slot

    # update the stack slot with the address in the target space
5716#    sw $t2,4($t0)
5720#    lw $zero,-8($t2)
5724#    lw $zero,-4($t2)

    # go handle next stack slot (testing if done)
5728#    j gcTestIterDone1

5732:  gcBump:
    #### we have a GC tag.  Bytes to skip: tag value + 3.
5732#    subu $t0,$t0,$t1
5736#    subu $t0,$t0,3

5740:  gcTestIterDone1:
5740#    bgeu $t0,$sp,gcStackCopyLoop
5741##...sltu $at,$t0,$sp
5745##...beq $at,$zero,5556

    ###### end outer loop to copy all stack-direct objects ######

    #############################################################
    # We have finished processing the stack elements.  Now we need
    # to update elements in the heap itself. This may itself involve
    # moving additional objects
    #############################################################

    #########################################################
    # At this point:
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # We want to set things up so that in addition:
    # - $t0 is the "trailing finger", containing the address
    #   of the first slot in target space that we have yet
    #   to process.
    # Then during processing:
    # - $t1 will contain the contents of the heap slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # And when we're actually copying an object:
    # - $t2 will contain pointer to the target object
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - available for use: $s0
    ##########################################################

    # set $t0 to be at the beginning of target-space
5748#    lw $t1,cur_seg
5752#    la $t0,seg0_start
5756#    beq $t1,$zero,gcSkip4
5760#    la $t0,seg1_start
5761##...lui $t0,16
5765##...addiu $t0,$t0,7024


5768:  gcSkip4:

    # if there were no objects put into the heap during stack
    # processing, we're done, so go finish up
5768#    bgeu $t0,$s3,gcFinishUp
5769##...sltu $at,$t0,$s3
5773##...beq $at,$zero,6064

    ###### begin outer loop to copy all non-stack-direct objects ######

5776:  gcHeapCopyLoop:
    # get data count for object; swap header-word with first word
    # of object so that they're back in the right place
5776#    lw $t1,($t0) # (what will be) first header word for current object
5780#    move $t2,$t1 # number data bytes in object (poss. w/hash bits)
5784#    bge $t2,$zero,gcSkip4a # are there hash bits?
5785##...slt $at,$t2,$zero
5789##...beq $at,$zero,5804
5792#    and $t2,0xff # mask off hash bits
5793##...lui $at,0
5797##...ori $at,$at,0xff
5801##...and $t2,$t2,$at
5804:gcSkip4a:    
5804#    sll $t2,$t2,2 # # data bytes
5808#    addu $t2,$t2,8 # to skip header words
5812#    addu $t2,$t0,$t2 # pointer to new object
5816#    lw $t3,-8($t2) # word to swap
5820#    sw $t1,-8($t2) # store header word
5824#    sw $t3,($t0) # restore first word of object

    ################################################
    # at this point:
    # - $t2 contains the pointer to our new object
    ################################################

    # check if we have a data array
5828#    lw $t1,-12($t2) # vtable pointer
5832#    li $t0,dataArrayVTableStart # address of vtable for first data array
5836#    blt $t1,$t0,gcNotDataArray # if data array, no more xforming to do
5837##...slt $at,$t1,$t0
5841##...bne $at,$zero,5860

    # We have a vtable address that is a data array.
    # we need skip over it then loop back to do next object.
5844:  skipToNextObj:
5844#    lw $t1,-4($t2) # data words in (object position of) array
    #### note: we know that it's not a string, so the value will
    #### not be artificially negative
5848#    sll $t1,$t1,2 # convert to byte-count
5852#    addu $t0,$t2,$t1 # skip over object
5856#    j gcTestIterDone2 # go do next object, if any

    ###################################################
    # at this point:
    # - the object has been restored to normal status--that is, the
    #   word-swap has been done
    # - $t2 contains a pointer to the object
    ###################################################
    
5860:  gcNotDataArray:
5860#    lw $t3,-4($t2) # # object words (negative treated as zero)
5864#    bge $t3,$zero,gcH2Neg2
5865##...slt $at,$t3,$zero
5869##...beq $at,$zero,5876
5872#    move $t3,$zero
5876:  gcH2Neg2:
5876#    sll $t3,$t3,2 # # object bytes
5880#    move $t0,$t2 # address of first pointer in object
5884#    add $s1,$t2,$t3 # limit address for this object

    #####################################################
    # At this point, we have to "translate" all pointers,
    # starting at $t0 to (but not including) $s1
    #####################################################

    # if there are no pointer-slots (i.e., $t0=$s1), skip this
    # part
5888#    beq $t0,$s1,gcTestIterDone2
    
5892:  gcNextPointerInObject:
    # get pointer from object
5892#    lw $t1,($t0)

    # if value is out of range, and is therefore does not refer
    # to an object, just go loop back and do the next one
5896#    bleu $t1,$t6,gcGoNextPointerSlot
5897##...sltu $at,$t6,$t1
5901##...beq $at,$zero,6044
5904#    bgtu $t1,$t7,gcGoNextPointerSlot
5905##...sltu $at,$t7,$t1
5909##...bne $at,$zero,6044

    # if the object has already been moved, update the stack-value
    # via the forwarding pointer
5912#    lw $t8,-8($t1) # possible forwarding tag
5916#    bne $t8,$zero,gcNoForward2 # if not forwarding tag, go copy
5920#    lw $t8,-4($t1) # forwarding pointer: object's new address
5924#    sw $t8,($t0) # update pointer in object
5928#    j gcGoNextPointerSlot # do next iteration

5932:  gcNoForward2:
    #########################################################
    # we actually need to copy the object into the new space
    #########################################################

    #########################################################
    # At this point:
    # - $t0 contains the address of the heap-slot we're translating
    # - $t1 will contain the contents of the heap-slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space, which will also be the first address
    #   of the target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # Then during processing:
    # And when we're actually copying an object:
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $t8 will contain a pointer to the target object
    # - available for use: $s0, $t8, $t9
    ##########################################################

    # compute the amount of space that is needed
5932#    bge $t8,$zero,gcSkip5 # # words in negative-offset portion
5933##...slt $at,$t8,$zero
5937##...beq $at,$zero,5952
5940#    and $t8,0xff # mask off hash bits
5941##...lui $at,0
5945##...ori $at,$at,0xff
5949##...and $t8,$t8,$at

5952:  gcSkip5:
5952#    sll $t8,$t8,2 # bytes in negative-offset portion ...
5956#    addu $t8,$t8,8 # ... add in bytes for header-words
5960#    subu $t4,$t1,$t8 # address of first word of source object
5964#    lw $t3,-4($t1) # # words in positive-offset portion
5968#    bge $t3,$zero,gcNoNeg
5969##...slt $at,$t3,$zero
5973##...beq $at,$zero,5980
5976#    move $t3,$zero # negative treated as zero
5980:  gcNoNeg:
5980#    sll $t3,$t3,2 # bytes in negative-offset portion
5984#    addu $t3,$t3,$t1 # address one word past last word of source

5988#    addu $t8,$s3,$t8 # pointer to target object

    #########################################################
    # At this point:
    # - $t0 contains the address of the stack slot we'll
    #   process next
    # - $t1 contains the contents of the stack slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $t8 contains the pointer to the target object
    # - $s1 contains the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0, $t9
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger"
5992#    lw $s0,($t4)
5996#    lw $t9,-8($t1)
6000#    sw $t9,($t4)
6004#    sw $s0,-8($t1)

    # copy all source bytes to the target
6008:  gCinnerCopy2:
6008#    lw $s0,($t4)
6012#    sw $s0,($s3)
6016#    addu $t4,$t4,4
6020#    addu $s3,$s3,4
6024#    bltu $t4,$t3,gCinnerCopy2
6025##...sltu $at,$t4,$t3
6029##...bne $at,$zero,6008

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
6032#    sw $zero,-8($t1) # 0 in first header-slot
6036#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
6040#    sw $t8,($t0)

6044:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
6044#    addu $t0,$t0,4
6048#    bltu $t0,$s1,gcNextPointerInObject
6049##...sltu $at,$t0,$s1
6053##...bne $at,$zero,5892

6056:  gcTestIterDone2:
6056#    bltu $t0,$s3,gcHeapCopyLoop
6057##...sltu $at,$t0,$s3
6061##...bne $at,$zero,5776

    ###### end outer loop to copy all non-stack-direct objects ######

6064:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
6064#    lw $s2,($sp)
6068#    addu $sp,$sp,4

    # mark us as having already GC'd
6072#    move $t5,$s5

    # go try and allocate again
6076#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
6080:vm_init:

    # mark bottom of stack
6080#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
6084#    move $s2,$zero

    #set up the "five" register
6088#    li $s5,5

6092#    la $s3,seg0_start
6096#    la $s4,seg0_end
6097##...lui $s4,16
6101##...addiu $s4,$s4,7024
    
    # return
6104#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
6108:divide:
    # get parameters; abort if divisor zero
6108#    lw $t0,($sp)
6112#    lw $t1,8($sp)
6116#    beq $t0,$zero,divByZeroError
    
    # perform division
6120#    div $t1,$t0
6124#    mflo $t0

    # store result, adjust stack and return
6128#    addu $sp,$sp,8 # adjust stack
6132#    sw $t0,($sp) # store result
6136#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
6140:remainder:
    # get parameters; abort if divisor zero
6140#    lw $t0,($sp)
6144#    lw $t1,8($sp)
6148#    beq $t0,$zero,divByZeroError
    
    # perform division
6152#    div $t1,$t0
6156#    mfhi $t0

    # store result, adjust stack and return
6160#    addu $sp,$sp,8 # adjust stack
6164#    sw $t0,($sp) # store result
6168#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
6172:checkCast:
    # get object, allow immediately if null
6172#    lw $t2,($sp)
6176#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
6180#    lw $t2,-12($t2) # vtable address
6184#    bge $t2,$t1,castException
6185##...slt $at,$t2,$t1
6189##...beq $at,$zero,6360
6192#    blt $t2,$t0,castException
6193##...slt $at,$t2,$t0
6197##...bne $at,$zero,6360
    
    # return, leaving object unchanged on stack
6200:  checkCastReturn:    
6200#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
6204:instanceOf:
    # get object, go return false if null
6204#    lw $t2,($sp)
6208#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
6212#    lw $t2,-12($t2) # vtable address
6216#    sge $t0,$t2,$t0 # are we >= the lower limit?
6217##...slt $t0,$t2,$t0
6221##...xori $t0,$t0,0x1
6224#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
6228#    and $t2,$t0,$t1
6232#    sw $t2,($sp)
6236:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
6236#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

6240:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
6240#    li $v0,4 # syscall-code for print-string
6244#    syscall
6248:exit:
    # print termination message
6248#    li $v0,4 # syscall-code for print-string
6252#    la $a0,exitString
6256#    syscall

    # print number of garbage collections
6260#    li $v0,4 # syscall-code for print-string
6264#    la $a0,gcCountMsg
6268#    syscall # print "Number of ..."
6272#    lw $a0,gcCount # number of GC's
6276#    li $v0,1 # code for print-int
6280#    syscall
6284#    li $v0,4 # syscall-code for print-string
6288#    la $a0,newlineString
6292#    syscall # print newline

    # terminate execution
6296#    li $v0,10 #syscall-code for "exit"
6300#    syscall

6304:outOfHeapMemory:
6304#    la $a0,heapMemoryMsg
6308#    j exitError
6312:divByZeroError:
6312#    la $a0,divByZeroMsg
6316#    j exitError
6320:strIndexOutOfBounds:
6320#    la $a0,strIndexOutOfBoundsMsg
6324#    j exitError
6328:arrayIndexOutOfBounds:
6328#    la $a0,arrayIndexOutOfBoundsMsg
6332#    j exitError
6336:arraySizeOutOfBounds:
6336#    la $a0,arraySizeOutOfBoundsMsg
6340#    j exitError
6344:nullPtrException:
6344#    la $a0,nullPtrExceptionMsg
6348#    j exitError
6352:badIntegerFormat:
6352#    la $a0,badIntegerFormatMsg
6356#    j exitError
6360:castException:
6360#    la $a0,castExceptionMsg
6364#    j exitError
############## data section ################
    .data
6652:hexChars:
    .ascii "0123456789abcdef"
    .align 2
6668:cur_seg:
    .word 0

6672:lastCharRead:
    .word -2 # -2 => no buffered character
6676:prevHashConstant:
    .word 0x2785173c
6680:gcCount:
    .word 0

6684:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
6711:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
6734:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
6769:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
6803:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
6836:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
6867:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
6915:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
6936:gcMsg: 
      .asciiz "\nGC!\n"
6942:gcCountMsg: 
      .asciiz "Number of garbage collections: "

6974:nullStr:
    .asciiz "null"
6979:trueString:
    .asciiz "true"
6984:falseString:
    .asciiz "false"
6990:exitString:
    .ascii "Program execution completed."
    #### "falls through" here
7018:newlineString:
    .asciiz "\n"
    
    .align 2
7020:stack_bottom:
    .word 0
