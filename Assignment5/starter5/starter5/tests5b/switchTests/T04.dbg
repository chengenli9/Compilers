    # - $t2 contains the pointer to our new object
    ################################################

    # check if we have a data array
3476#    lw $t1,-12($t2) # vtable pointer
3480#    li $t0,dataArrayVTableStart # address of vtable for first data array
3484#    blt $t1,$t0,gcNotDataArray # if data array, no more xforming to do
3485##...slt $at,$t1,$t0
3489##...bne $at,$zero,3508

    # We have a vtable address that is a data array.
    # we need skip over it then loop back to do next object.
3492:  skipToNextObj:
3492#    lw $t1,-4($t2) # data words in (object position of) array
    #### note: we know that it's not a string, so the value will
    #### not be artificially negative
3496#    sll $t1,$t1,2 # convert to byte-count
3500#    addu $t0,$t2,$t1 # skip over object
3504#    j gcTestIterDone2 # go do next object, if any

    ###################################################
    # at this point:
    # - the object has been restored to normal status--that is, the
    #   word-swap has been done
    # - $t2 contains a pointer to the object
    ###################################################
    
3508:  gcNotDataArray:
3508#    lw $t3,-4($t2) # # object words (negative treated as zero)
3512#    bge $t3,$zero,gcH2Neg2
3513##...slt $at,$t3,$zero
3517##...beq $at,$zero,3524
3520#    move $t3,$zero
3524:  gcH2Neg2:
3524#    sll $t3,$t3,2 # # object bytes
3528#    move $t0,$t2 # address of first pointer in object
3532#    add $s1,$t2,$t3 # limit address for this object

    #####################################################
    # At this point, we have to "translate" all pointers,
    # starting at $t0 to (but not including) $s1
    #####################################################

    # if there are no pointer-slots (i.e., $t0=$s1), skip this
    # part
3536#    beq $t0,$s1,gcTestIterDone2
    
3540:  gcNextPointerInObject:
    # get pointer from object
3540#    lw $t1,($t0)

    # if value is out of range, and is therefore does not refer
    # to an object, just go loop back and do the next one
3544#    bleu $t1,$t6,gcGoNextPointerSlot
3545##...sltu $at,$t6,$t1
3549##...beq $at,$zero,3692
3552#    bgtu $t1,$t7,gcGoNextPointerSlot
3553##...sltu $at,$t7,$t1
3557##...bne $at,$zero,3692

    # if the object has already been moved, update the stack-value
    # via the forwarding pointer
3560#    lw $t8,-8($t1) # possible forwarding tag
3564#    bne $t8,$zero,gcNoForward2 # if not forwarding tag, go copy
3568#    lw $t8,-4($t1) # forwarding pointer: object's new address
3572#    sw $t8,($t0) # update pointer in object
3576#    j gcGoNextPointerSlot # do next iteration

3580:  gcNoForward2:
    #########################################################
    # we actually need to copy the object into the new space
    #########################################################

    #########################################################
    # At this point:
    # - $t0 contains the address of the heap-slot we're translating
    # - $t1 will contain the contents of the heap-slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space, which will also be the first address
    #   of the target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # Then during processing:
    # And when we're actually copying an object:
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $t8 will contain a pointer to the target object
    # - available for use: $s0, $t8, $t9
    ##########################################################

    # compute the amount of space that is needed
3580#    bge $t8,$zero,gcSkip5 # # words in negative-offset portion
3581##...slt $at,$t8,$zero
3585##...beq $at,$zero,3600
3588#    and $t8,0xff # mask off hash bits
3589##...lui $at,0
3593##...ori $at,$at,0xff
3597##...and $t8,$t8,$at

3600:  gcSkip5:
3600#    sll $t8,$t8,2 # bytes in negative-offset portion ...
3604#    addu $t8,$t8,8 # ... add in bytes for header-words
3608#    subu $t4,$t1,$t8 # address of first word of source object
3612#    lw $t3,-4($t1) # # words in positive-offset portion
3616#    bge $t3,$zero,gcNoNeg
3617##...slt $at,$t3,$zero
3621##...beq $at,$zero,3628
3624#    move $t3,$zero # negative treated as zero
3628:  gcNoNeg:
3628#    sll $t3,$t3,2 # bytes in negative-offset portion
3632#    addu $t3,$t3,$t1 # address one word past last word of source

3636#    addu $t8,$s3,$t8 # pointer to target object

    #########################################################
    # At this point:
    # - $t0 contains the address of the stack slot we'll
    #   process next
    # - $t1 contains the contents of the stack slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $t8 contains the pointer to the target object
    # - $s1 contains the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0, $t9
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger"
3640#    lw $s0,($t4)
3644#    lw $t9,-8($t1)
3648#    sw $t9,($t4)
3652#    sw $s0,-8($t1)

    # copy all source bytes to the target
3656:  gCinnerCopy2:
3656#    lw $s0,($t4)
3660#    sw $s0,($s3)
3664#    addu $t4,$t4,4
3668#    addu $s3,$s3,4
3672#    bltu $t4,$t3,gCinnerCopy2
3673##...sltu $at,$t4,$t3
3677##...bne $at,$zero,3656

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
3680#    sw $zero,-8($t1) # 0 in first header-slot
3684#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
3688#    sw $t8,($t0)

3692:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
3692#    addu $t0,$t0,4
3696#    bltu $t0,$s1,gcNextPointerInObject
3697##...sltu $at,$t0,$s1
3701##...bne $at,$zero,3540

3704:  gcTestIterDone2:
3704#    bltu $t0,$s3,gcHeapCopyLoop
3705##...sltu $at,$t0,$s3
3709##...bne $at,$zero,3424

    ###### end outer loop to copy all non-stack-direct objects ######

3712:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
3712#    lw $s2,($sp)
3716#    addu $sp,$sp,4

    # mark us as having already GC'd
3720#    move $t5,$s5

    # go try and allocate again
3724#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
3728:vm_init:

    # mark bottom of stack
3728#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
3732#    move $s2,$zero

    #set up the "five" register
3736#    li $s5,5

3740#    la $s3,seg0_start
3744#    la $s4,seg0_end
3745##...lui $s4,16
3749##...addiu $s4,$s4,4684
    
    # return
3752#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3756:divide:
    # get parameters; abort if divisor zero
3756#    lw $t0,($sp)
3760#    lw $t1,8($sp)
3764#    beq $t0,$zero,divByZeroError
    
    # perform division
3768#    div $t1,$t0
3772#    mflo $t0

    # store result, adjust stack and return
3776#    addu $sp,$sp,8 # adjust stack
3780#    sw $t0,($sp) # store result
3784#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3788:remainder:
    # get parameters; abort if divisor zero
3788#    lw $t0,($sp)
3792#    lw $t1,8($sp)
3796#    beq $t0,$zero,divByZeroError
    
    # perform division
3800#    div $t1,$t0
3804#    mfhi $t0

    # store result, adjust stack and return
3808#    addu $sp,$sp,8 # adjust stack
3812#    sw $t0,($sp) # store result
3816#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
3820:checkCast:
    # get object, allow immediately if null
3820#    lw $t2,($sp)
3824#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
3828#    lw $t2,-12($t2) # vtable address
3832#    bge $t2,$t1,castException
3833##...slt $at,$t2,$t1
3837##...beq $at,$zero,3972
3840#    blt $t2,$t0,castException
3841##...slt $at,$t2,$t0
3845##...bne $at,$zero,3972
    
    # return, leaving object unchanged on stack
3848:  checkCastReturn:    
3848#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
3852:instanceOf:
    # get object, go return false if null
3852#    lw $t2,($sp)
3856#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
3860#    lw $t2,-12($t2) # vtable address
3864#    sge $t0,$t2,$t0 # are we >= the lower limit?
3865##...slt $t0,$t2,$t0
3869##...xori $t0,$t0,0x1
3872#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
3876#    and $t2,$t0,$t1
3880#    sw $t2,($sp)
3884:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
3884#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

3888:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
3888#    li $v0,4 # syscall-code for print-string
3892#    syscall
3896:exit:
    # print termination message
3896#    li $v0,4 # syscall-code for print-string
3900#    la $a0,exitString
3904#    syscall

    # terminate execution
3908#    li $v0,10 #syscall-code for "exit"
3912#    syscall

3916:outOfHeapMemory:
3916#    la $a0,heapMemoryMsg
3920#    j exitError
3924:divByZeroError:
3924#    la $a0,divByZeroMsg
3928#    j exitError
3932:strIndexOutOfBounds:
3932#    la $a0,strIndexOutOfBoundsMsg
3936#    j exitError
3940:arrayIndexOutOfBounds:
3940#    la $a0,arrayIndexOutOfBoundsMsg
3944#    j exitError
3948:arraySizeOutOfBounds:
3948#    la $a0,arraySizeOutOfBoundsMsg
3952#    j exitError
3956:nullPtrException:
3956#    la $a0,nullPtrExceptionMsg
3960#    j exitError
3964:badIntegerFormat:
3964#    la $a0,badIntegerFormatMsg
3968#    j exitError
3972:castException:
3972#    la $a0,castExceptionMsg
3976#    j exitError
############## data section ################
    .data
4320:hexChars:
    .ascii "0123456789abcdef"
    .align 2
4336:cur_seg:
    .word 0

4340:lastCharRead:
    .word -2 # -2 => no buffered character
4344:prevHashConstant:
    .word 0x2785173c
4348:gcCount:
    .word 0

4352:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
4379:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
4402:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
4437:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
4471:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
4504:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
4535:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
4583:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
4604:gcMsg: 
      .asciiz "\nGC!\n"
4610:gcCountMsg: 
      .asciiz "Number of garbage collections: "

4642:nullStr:
    .asciiz "null"
4647:trueString:
    .asciiz "true"
4652:falseString:
    .asciiz "false"
4658:exitString:
    .ascii "Program terminated."
    #### "falls through" here
4677:newlineString:
    .asciiz "\n"
    
    .align 2
4680:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

4684:seg0_start:
    .space 0x100000
1053260:seg0_end:
1053260:seg1_start:
    .space 0x100000
2101836:seg1_end:
