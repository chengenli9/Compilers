3929:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
3963:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
3996:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
4027:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
4075:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
4096:gcMsg: 
      .asciiz "\nGC!\n"
4102:gcCountMsg: 
      .asciiz "Number of garbage collections: "

4134:nullStr:
    .asciiz "null"
4139:trueString:
    .asciiz "true"
4144:falseString:
    .asciiz "false"
4150:exitString:
