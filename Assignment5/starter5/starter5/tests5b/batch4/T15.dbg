##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
492:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
492#    lw $t0,-8($s2) # get word with hash bits from this
496#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
500#    addu $t0,$t1

504#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
508:mth_equals_Object:
508#    move $t0,$s2 # first pointer (this)
512#    lw $t1,($sp) # second pointer
516#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
517##...subu $at,$t0,$t1
521##...sltiu $t0,$at,1

524#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
528:mth_hashCode_String:
528#    move $t0,$s2 # put this pointer in t0

532#    li $t2,0 # current hash value
536#    lw $t1,-4($t0) # negative of number of characters in string
540#    beq $t1,$zero,done_hashCode_String # if zero length => done
544#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
548#    and $t0,0xfffffffc # adjust for padding
549##...lui $at,65535
553##...ori $at,$at,0xfffc
557##...and $t0,$t0,$at
560#    subu $t1,$t0,$t1 # address at end of string +12
564:loop_hashCode_String:    
564#    sll $t4,$t2,5 # multiply by 32
568#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
572#    lbu $t3,-12($t0) # current character
576#    addu $t2,$t3 # add in current character
580#    addu $t0,1 # go to next character's address
584#    bne $t0,$t1,loop_hashCode_String # loop back if more
588:done_hashCode_String:    

    # push int on stack
588#    move $t0, $t2 # put $t2 in return slot
592#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
596:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
596#    subu $sp,4
600#    sw $ra,($sp)
    
    # get hash value
604#    lw $t2,-12($s2) # vtable address
608#    lw $t0,($t2) # method address
612#    jalr $t0
616#    subu $sp,8 # push result (int in $t0) on stack
620#    sw $s5,4($sp)
624#    sw $t0,($sp)

    # compute print-size of hash value
628#    li $t0, 1
632#    lw $t1, ($sp)
636#    srl $t1,$t1,4
640#    beq $t1,$zero,toString_skip_loop
644:toString_loop_top:
644#    addu $t0,1
648#    srl $t1,$t1,4
652#    bne $t1,$zero,toString_loop_top
656:toString_skip_loop:
656#    subu $sp,8
660#    sw $s5,4($sp)
664#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
668#    lw $t2,-12($s2) # vtable address
672#    move $t0,$t2
676:toString_checkTagBit:
676#    subu $t0,1
680#    lb $t1,($t0)
684#    and $t1,0x80
685##...lui $at,0
689##...ori $at,$at,0x80
693##...and $t1,$t1,$at
696#    beq $t1,$zero,toString_checkTagBit
700#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
704#    subu $sp,8
708#    sw $t1,($sp)
712#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
716#    move $s7,$zero # -4 offset header word
720#    lw $t4,8($sp) # bytes for hash value
724#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
728#    addu $t4,8
732#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
736#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

740#    li $t0,CLASS_String # store string vtable address into ...
744#    sw $t0,-12($s7) # ... -12 offset in object header
748#    lw $t2,-12($s2) # our object's vtable address
752#    lw $t5,4($sp) # number characters in prefix
756#    lw $t1,12($sp) # number of characters in hashcode
760#    addu $t3,$t1,$t5 # number of characters in string ...
764#    addu $t3,1 # ... including the '@' character
768#    subu $t0,$zero,$t3 # store negated length into ...
772#    sw $t0,-4($s7) # ... -4 offset header word
776#    lw $t0,-8($s7) # get -8 offset header-word
780#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
781##...slt $at,$t0,$zero
785##...beq $at,$zero,804
788#    and $t0,0xff # mask off object's hash value ...
789##...lui $at,0
793##...ori $at,$at,0xff
797##...and $t0,$t0,$at
800#    sw $t0,-8($s7) # ... and store back into -8 header-word
804:skipMask_toString:
