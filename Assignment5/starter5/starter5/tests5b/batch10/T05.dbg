########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
6516:vm_init:

    # mark bottom of stack
6516#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
6520#    move $s2,$zero

    #set up the "five" register
6524#    li $s5,5

6528#    la $s3,seg0_start
6532#    la $s4,seg0_end
6533##...lui $s4,16
6537##...addiu $s4,$s4,7436
    
    # return
6540#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
6544:divide:
    # get parameters; abort if divisor zero
6544#    lw $t0,($sp)
6548#    lw $t1,8($sp)
6552#    beq $t0,$zero,divByZeroError
    
    # perform division
6556#    div $t1,$t0
6560#    mflo $t0

    # store result, adjust stack and return
6564#    addu $sp,$sp,8 # adjust stack
6568#    sw $t0,($sp) # store result
6572#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
6576:remainder:
    # get parameters; abort if divisor zero
6576#    lw $t0,($sp)
6580#    lw $t1,8($sp)
6584#    beq $t0,$zero,divByZeroError
    
    # perform division
6588#    div $t1,$t0
6592#    mfhi $t0

    # store result, adjust stack and return
6596#    addu $sp,$sp,8 # adjust stack
6600#    sw $t0,($sp) # store result
6604#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
6608:checkCast:
    # get object, allow immediately if null
6608#    lw $t2,($sp)
6612#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
6616#    lw $t2,-12($t2) # vtable address
6620#    bge $t2,$t1,castException
6621##...slt $at,$t2,$t1
6625##...beq $at,$zero,6760
6628#    blt $t2,$t0,castException
6629##...slt $at,$t2,$t0
6633##...bne $at,$zero,6760
    
    # return, leaving object unchanged on stack
6636:  checkCastReturn:    
6636#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
6640:instanceOf:
    # get object, go return false if null
6640#    lw $t2,($sp)
6644#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
6648#    lw $t2,-12($t2) # vtable address
6652#    sge $t0,$t2,$t0 # are we >= the lower limit?
6653##...slt $t0,$t2,$t0
6657##...xori $t0,$t0,0x1
6660#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
6664#    and $t2,$t0,$t1
6668#    sw $t2,($sp)
6672:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
6672#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

6676:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
6676#    li $v0,4 # syscall-code for print-string
6680#    syscall
6684:exit:
    # print termination message
6684#    li $v0,4 # syscall-code for print-string
6688#    la $a0,exitString
6692#    syscall

    # terminate execution
6696#    li $v0,10 #syscall-code for "exit"
6700#    syscall

6704:outOfHeapMemory:
6704#    la $a0,heapMemoryMsg
6708#    j exitError
6712:divByZeroError:
6712#    la $a0,divByZeroMsg
6716#    j exitError
6720:strIndexOutOfBounds:
6720#    la $a0,strIndexOutOfBoundsMsg
6724#    j exitError
6728:arrayIndexOutOfBounds:
6728#    la $a0,arrayIndexOutOfBoundsMsg
6732#    j exitError
6736:arraySizeOutOfBounds:
6736#    la $a0,arraySizeOutOfBoundsMsg
6740#    j exitError
6744:nullPtrException:
6744#    la $a0,nullPtrExceptionMsg
6748#    j exitError
6752:badIntegerFormat:
6752#    la $a0,badIntegerFormatMsg
6756#    j exitError
6760:castException:
6760#    la $a0,castExceptionMsg
6764#    j exitError
############## data section ################
    .data
7072:hexChars:
    .ascii "0123456789abcdef"
    .align 2
7088:cur_seg:
    .word 0

7092:lastCharRead:
    .word -2 # -2 => no buffered character
7096:prevHashConstant:
    .word 0x2785173c
7100:gcCount:
    .word 0

7104:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
7131:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
7154:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
7189:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
7223:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
7256:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
7287:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
7335:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
7356:gcMsg: 
      .asciiz "\nGC!\n"
7362:gcCountMsg: 
      .asciiz "Number of garbage collections: "

7394:nullStr:
    .asciiz "null"
7399:trueString:
    .asciiz "true"
7404:falseString:
    .asciiz "false"
7410:exitString:
    .ascii "Program terminated."
    #### "falls through" here
7429:newlineString:
    .asciiz "\n"
    
    .align 2
7432:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

7436:seg0_start:
    .space 0x100000
1056012:seg0_end:
1056012:seg1_start:
    .space 0x100000
2104588:seg1_end:
