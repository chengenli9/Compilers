#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
3100:instanceOf:
    # get object, go return false if null
3100#    lw $t2,($sp)
3104#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
3108#    lw $t2,-12($t2) # vtable address
3112#    sge $t0,$t2,$t0 # are we >= the lower limit?
3113##...slt $t0,$t2,$t0
3117##...xori $t0,$t0,0x1
3120#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
3124#    and $t2,$t0,$t1
3128#    sw $t2,($sp)
3132:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
3132#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

3136:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
3136#    li $v0,4 # syscall-code for print-string
3140#    syscall
3144:exit:
    # print termination message
3144#    li $v0,4 # syscall-code for print-string
3148#    la $a0,exitString
3152#    syscall

    # print number of garbage collections
3156#    li $v0,4 # syscall-code for print-string
3160#    la $a0,gcCountMsg
3164#    syscall # print "Number of ..."
3168#    lw $a0,gcCount # number of GC's
3172#    li $v0,1 # code for print-int
3176#    syscall
3180#    li $v0,4 # syscall-code for print-string
3184#    la $a0,newlineString
3188#    syscall # print newline

    # terminate execution
3192#    li $v0,10 #syscall-code for "exit"
3196#    syscall

3200:outOfHeapMemory:
3200#    la $a0,heapMemoryMsg
3204#    j exitError
3208:divByZeroError:
3208#    la $a0,divByZeroMsg
3212#    j exitError
3216:strIndexOutOfBounds:
3216#    la $a0,strIndexOutOfBoundsMsg
3220#    j exitError
3224:arrayIndexOutOfBounds:
3224#    la $a0,arrayIndexOutOfBoundsMsg
3228#    j exitError
3232:arraySizeOutOfBounds:
3232#    la $a0,arraySizeOutOfBoundsMsg
3236#    j exitError
3240:nullPtrException:
3240#    la $a0,nullPtrExceptionMsg
3244#    j exitError
3248:badIntegerFormat:
3248#    la $a0,badIntegerFormatMsg
3252#    j exitError
3256:castException:
3256#    la $a0,castExceptionMsg
3260#    j exitError
############## data section ################
    .data
3444:hexChars:
    .ascii "0123456789abcdef"
    .align 2
3460:cur_seg:
    .word 0

3464:lastCharRead:
    .word -2 # -2 => no buffered character
3468:prevHashConstant:
    .word 0x2785173c
3472:gcCount:
    .word 0

3476:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
3503:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
3526:strIndexOutOfBoundsMsg:
