##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
9668:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
9668#    lw $t0,-8($s2) # get word with hash bits from this
9672#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
9676#    addu $t0,$t1

9680#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
9684:mth_equals_Object:
9684#    move $t0,$s2 # first pointer (this)
9688#    lw $t1,($sp) # second pointer
9692#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
9693##...subu $at,$t0,$t1
9697##...sltiu $t0,$at,1

9700#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
9704:mth_hashCode_String:
9704#    move $t0,$s2 # put this pointer in t0

9708#    li $t2,0 # current hash value
9712#    lw $t1,-4($t0) # negative of number of characters in string
9716#    beq $t1,$zero,done_hashCode_String # if zero length => done
9720#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
9724#    and $t0,0xfffffffc # adjust for padding
9725##...lui $at,65535
9729##...ori $at,$at,0xfffc
9733##...and $t0,$t0,$at
9736#    subu $t1,$t0,$t1 # address at end of string +12
9740:loop_hashCode_String:    
9740#    sll $t4,$t2,5 # multiply by 32
9744#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
9748#    lbu $t3,-12($t0) # current character
9752#    addu $t2,$t3 # add in current character
9756#    addu $t0,1 # go to next character's address
9760#    bne $t0,$t1,loop_hashCode_String # loop back if more
9764:done_hashCode_String:    

    # push int on stack
9764#    move $t0, $t2 # put $t2 in return slot
9768#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
9772:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
9772#    subu $sp,4
9776#    sw $ra,($sp)
    
    # get hash value
9780#    lw $t2,-12($s2) # vtable address
9784#    lw $t0,($t2) # method address
9788#    jalr $t0
9792#    subu $sp,8 # push result (int in $t0) on stack
9796#    sw $s5,4($sp)
9800#    sw $t0,($sp)

    # compute print-size of hash value
9804#    li $t0, 1
9808#    lw $t1, ($sp)
9812#    srl $t1,$t1,4
9816#    beq $t1,$zero,toString_skip_loop
9820:toString_loop_top:
9820#    addu $t0,1
9824#    srl $t1,$t1,4
9828#    bne $t1,$zero,toString_loop_top
9832:toString_skip_loop:
9832#    subu $sp,8
9836#    sw $s5,4($sp)
9840#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
9844#    lw $t2,-12($s2) # vtable address
9848#    move $t0,$t2
9852:toString_checkTagBit:
9852#    subu $t0,1
9856#    lb $t1,($t0)
9860#    and $t1,0x80
9861##...lui $at,0
9865##...ori $at,$at,0x80
9869##...and $t1,$t1,$at
9872#    beq $t1,$zero,toString_checkTagBit
9876#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
9880#    subu $sp,8
9884#    sw $t1,($sp)
9888#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
9892#    move $s7,$zero # -4 offset header word
9896#    lw $t4,8($sp) # bytes for hash value
9900#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
9904#    addu $t4,8
9908#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
9912#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

9916#    li $t0,CLASS_String # store string vtable address into ...
9920#    sw $t0,-12($s7) # ... -12 offset in object header
9924#    lw $t2,-12($s2) # our object's vtable address
9928#    lw $t5,4($sp) # number characters in prefix
9932#    lw $t1,12($sp) # number of characters in hashcode
9936#    addu $t3,$t1,$t5 # number of characters in string ...
9940#    addu $t3,1 # ... including the '@' character
9944#    subu $t0,$zero,$t3 # store negated length into ...
9948#    sw $t0,-4($s7) # ... -4 offset header word
9952#    lw $t0,-8($s7) # get -8 offset header-word
9956#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
9957##...slt $at,$t0,$zero
9961##...beq $at,$zero,9980
9964#    and $t0,0xff # mask off object's hash value ...
9965##...lui $at,0
9969##...ori $at,$at,0xff
9973##...and $t0,$t0,$at
9976#    sw $t0,-8($s7) # ... and store back into -8 header-word
9980:skipMask_toString:
9980#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
9984#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
9988#    subu $t4,$t2,$t5
9992:toString_copyLoop:    
9992#    lb $t3,($t4)
9996#    and $t3,0x7f # mask off sign bit (in case first word)
9997##...lui $at,0
10001##...ori $at,$at,0x7f
10005##...and $t3,$t3,$at
10008#    sb $t3,-8($t0)
10012#    addu $t4,1
10016#    addu $t0,1
10020#    blt $t4,$t2,toString_copyLoop
10021##...slt $at,$t4,$t2
10025##...bne $at,$zero,9992

    # copy the '@' sign
10028#    li $t3,'@'
10032#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
10036#    addu $t2,$t0,$t1 # address of last byte in string to store +8
10040#    lw $t3,20($sp) # hash code to print
10044:toString_hashCopyLoop:
10044#    and $t4,$t3,0xf
10048#    srl $t3,4
10052#    lb $t4,hexChars($t4)
10056#    sb $t4,-8($t2)
10060#    subu $t2,$t2,1
10064#    bgt $t2,$t0,toString_hashCopyLoop
10065##...slt $at,$t0,$t2
10069##...bne $at,$zero,10044

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
10072#    addu $sp,28
10076#    lw $ra,($sp)
10080#    addu $sp,4
10084#    move $t0, $s7 # return string we created
10088#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
10092:mth_equals_String:
    
    # quick test for obvious false
10092#    lw $t0,($sp) # second parameter
10096#    beq $t0,$zero,goEsFalse # go return false if null
10100#    lw $t1,-12($t0) # vtable pointer
10104#    la $t2,CLASS_String # string vtable pointer
10108#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
10112#    subu $sp,12
10116#    sw $ra,8($sp)
10120#    sw $s2,4($sp)
10124#    sw $t0,($sp)
10128#    jal mth_compareTo_String
10132#    lw $s2, 4($sp) #restore this pointer and pop parameters
10136#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
10140#    seq $t0,$t0,$zero
10141##...subu $at,$t0,$zero
10145##...sltiu $t0,$at,1

    # pop return address and return $t0
10148#    lw $ra,($sp)
10152#    addu $sp,4

10156#    jr $ra # return
    
10160:goEsFalse:
    # put 0 in $t0 and return
10160#    li $t0, 0
10164#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
10168:mth_toString_String:
    #we are a string, so return this.
10168#    move $t0, $s2
10172#    jr $ra

###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
10176:mth_readLine_Lib:
    
10176#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
10180#    sw $ra, 4($sp) # save $ra
10184#    move $t1,$sp # save "original" sp

10188:  doRead:

    # read the character
10188#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
10192#    subu $t2,$v0,13
10196#    bne $t2,$zero,notReturnRL
10200#    jal readLogicalChar
10204#    subu $t2,$v0,10 # check for newline
10208#    beq $t2,$zero,foundNewLine
10212#    sw $v0,lastCharRead # push back character into queue
10216#    j foundNewLine # go process the line

10220:  notReturnRL:

    # at this point, $v0 has our character

10220#    subu $t0,$v0,10
10224#    beq $t0,$zero,foundNewLine
10228#    blt $v0,$zero,foundEof
10229##...slt $at,$v0,$zero
10233##...bne $at,$zero,10248

    # we have a character, so push it onto stack
10236#    subu $sp,$sp,4
10240#    sw $v0,($sp)

    # loop back up to get next character
10244#    j doRead

10248:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
10248#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
10252#    li $s7, 0 # return-value: null
10256#    j rlReturn # return

10260:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
10260#    subu $t0,$t1,$sp # number of chars we read (times 4)
10264#    srl $s6,$t0,2 # number of words on stack with chars
10268#    subu $sp,$sp,4 # push char-count ...
10272#    sw $s6,($sp) # ... onto stack
10276#    addu $t2,$t0,5 # GC tag, incl. for count-word
10280#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
10284#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
10288#    srl $s6,$s6,2  # data words in object
10292#    move $s7,$zero # object words in object
10296#    jal newObject  # allocate space
    
    # store header words
10300#    la $t0,CLASS_String
10304#    sw $t0,-12($s7)# store class tag (String) into object
10308#    lw $t2,4($sp) # char-count
10312#    sll $t1,$t2,2 # 4 times number of chars
10316#    subu $t2,$zero,$t2 # negative of char-count
10320#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
10324#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
10328#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
10329##...slt $at,$t0,$zero
10333##...beq $at,$zero,10352
10336#    and $t0,0xff # mask off object's hash value ...
10337##...lui $at,0
10341##...ori $at,$at,0xff
10345##...and $t0,$t0,$at
10348#    sw $t0,-8($s7) # ... and store back into -8 header-word
10352:  skipMask_readLine:

10352#    sll $t0,$t0,2 # data bytes in object
10356#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
10360#    subu $t0,$t0,$t2 # place to store last character (plus 9)
10364#    addu $sp,$sp,8 # pop redundant object-pointer and count
10368#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

10372#    beq $sp,$t1,rlReturn
10376:  charCopyLoop:
10376#    lw $t2,($sp)
10380#    sb $t2,-9($t0)
10384#    addu $sp,$sp,4
10388#    subu $t0,$t0,1
10392#    bne $sp,$t1,charCopyLoop
10396:  rlReturn:

10396#    lw $ra, 4($sp)
10400#    addu $sp, 8   # pop $ra and pointless word off stack
10404#    move $t0, $s7 # return string we allocated in $s7
10408#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
10412:mth_readInt_Lib:

    # save $ra by pushing onto stack
10412#    subu $sp,$sp,4
10416#    sw $ra,($sp)

10420:  riSkipWhiteLoop:
    # read a character
10420#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
10424#    subu $t0,$v0,32
10428#    bgt $t0,$zero,nonWhite
10429##...slt $at,$zero,$t0
10433##...bne $at,$zero,10476
10436#    beq $t0,$zero,riSkipWhiteLoop # start over if space
10440#    subu $t0,$v0,10
10444#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
10448#    subu $t0,$v0,9
10452#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
10456#    subu $t0,$v0,13
10460#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
10464#    subu $t0,$v0,12
