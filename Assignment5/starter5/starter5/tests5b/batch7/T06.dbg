###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
1328:mth_readLine_Lib:
    
1328#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
1332#    sw $ra, 4($sp) # save $ra
1336#    move $t1,$sp # save "original" sp

1340:  doRead:

    # read the character
1340#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
1344#    subu $t2,$v0,13
1348#    bne $t2,$zero,notReturnRL
1352#    jal readLogicalChar
1356#    subu $t2,$v0,10 # check for newline
1360#    beq $t2,$zero,foundNewLine
1364#    sw $v0,lastCharRead # push back character into queue
1368#    j foundNewLine # go process the line

1372:  notReturnRL:

    # at this point, $v0 has our character

1372#    subu $t0,$v0,10
1376#    beq $t0,$zero,foundNewLine
1380#    blt $v0,$zero,foundEof
1381##...slt $at,$v0,$zero
1385##...bne $at,$zero,1400

    # we have a character, so push it onto stack
1388#    subu $sp,$sp,4
1392#    sw $v0,($sp)

    # loop back up to get next character
1396#    j doRead

1400:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
1400#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
1404#    li $s7, 0 # return-value: null
1408#    j rlReturn # return

1412:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
1412#    subu $t0,$t1,$sp # number of chars we read (times 4)
1416#    srl $s6,$t0,2 # number of words on stack with chars
1420#    subu $sp,$sp,4 # push char-count ...
1424#    sw $s6,($sp) # ... onto stack
1428#    addu $t2,$t0,5 # GC tag, incl. for count-word
1432#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
1436#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
1440#    srl $s6,$s6,2  # data words in object
1444#    move $s7,$zero # object words in object
1448#    jal newObject  # allocate space
    
    # store header words
1452#    la $t0,CLASS_String
1456#    sw $t0,-12($s7)# store class tag (String) into object
1460#    lw $t2,4($sp) # char-count
1464#    sll $t1,$t2,2 # 4 times number of chars
1468#    subu $t2,$zero,$t2 # negative of char-count
1472#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
1476#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
1480#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
1481##...slt $at,$t0,$zero
1485##...beq $at,$zero,1504
1488#    and $t0,0xff # mask off object's hash value ...
1489##...lui $at,0
1493##...ori $at,$at,0xff
1497##...and $t0,$t0,$at
1500#    sw $t0,-8($s7) # ... and store back into -8 header-word
1504:  skipMask_readLine:

1504#    sll $t0,$t0,2 # data bytes in object
1508#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
1512#    subu $t0,$t0,$t2 # place to store last character (plus 9)
1516#    addu $sp,$sp,8 # pop redundant object-pointer and count
1520#    addu $t1,$t1,$sp # first non-char spot on stack
