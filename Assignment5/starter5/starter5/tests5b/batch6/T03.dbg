##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1092:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
1092#    lw $t0,-8($s2) # get word with hash bits from this
1096#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
1100#    addu $t0,$t1

1104#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1108:mth_equals_Object:
1108#    move $t0,$s2 # first pointer (this)
1112#    lw $t1,($sp) # second pointer
1116#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
1117##...subu $at,$t0,$t1
1121##...sltiu $t0,$at,1

1124#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1128:mth_hashCode_String:
1128#    move $t0,$s2 # put this pointer in t0

1132#    li $t2,0 # current hash value
1136#    lw $t1,-4($t0) # negative of number of characters in string
1140#    beq $t1,$zero,done_hashCode_String # if zero length => done
1144#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
1148#    and $t0,0xfffffffc # adjust for padding
1149##...lui $at,65535
1153##...ori $at,$at,0xfffc
1157##...and $t0,$t0,$at
1160#    subu $t1,$t0,$t1 # address at end of string +12
1164:loop_hashCode_String:    
1164#    sll $t4,$t2,5 # multiply by 32
1168#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
1172#    lbu $t3,-12($t0) # current character
1176#    addu $t2,$t3 # add in current character
1180#    addu $t0,1 # go to next character's address
1184#    bne $t0,$t1,loop_hashCode_String # loop back if more
1188:done_hashCode_String:    

    # push int on stack
1188#    move $t0, $t2 # put $t2 in return slot
1192#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
1196:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
1196#    subu $sp,4
1200#    sw $ra,($sp)
    
    # get hash value
1204#    lw $t2,-12($s2) # vtable address
1208#    lw $t0,($t2) # method address
1212#    jalr $t0
1216#    subu $sp,8 # push result (int in $t0) on stack
1220#    sw $s5,4($sp)
1224#    sw $t0,($sp)

    # compute print-size of hash value
1228#    li $t0, 1
1232#    lw $t1, ($sp)
1236#    srl $t1,$t1,4
1240#    beq $t1,$zero,toString_skip_loop
1244:toString_loop_top:
1244#    addu $t0,1
1248#    srl $t1,$t1,4
1252#    bne $t1,$zero,toString_loop_top
1256:toString_skip_loop:
1256#    subu $sp,8
1260#    sw $s5,4($sp)
1264#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
1268#    lw $t2,-12($s2) # vtable address
1272#    move $t0,$t2
1276:toString_checkTagBit:
1276#    subu $t0,1
1280#    lb $t1,($t0)
1284#    and $t1,0x80
1285##...lui $at,0
1289##...ori $at,$at,0x80
1293##...and $t1,$t1,$at
1296#    beq $t1,$zero,toString_checkTagBit
1300#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
1304#    subu $sp,8
1308#    sw $t1,($sp)
1312#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
1316#    move $s7,$zero # -4 offset header word
1320#    lw $t4,8($sp) # bytes for hash value
1324#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
1328#    addu $t4,8
1332#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
1336#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

1340#    li $t0,CLASS_String # store string vtable address into ...
1344#    sw $t0,-12($s7) # ... -12 offset in object header
1348#    lw $t2,-12($s2) # our object's vtable address
1352#    lw $t5,4($sp) # number characters in prefix
1356#    lw $t1,12($sp) # number of characters in hashcode
1360#    addu $t3,$t1,$t5 # number of characters in string ...
1364#    addu $t3,1 # ... including the '@' character
1368#    subu $t0,$zero,$t3 # store negated length into ...
1372#    sw $t0,-4($s7) # ... -4 offset header word
1376#    lw $t0,-8($s7) # get -8 offset header-word
1380#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
1381##...slt $at,$t0,$zero
1385##...beq $at,$zero,1404
1388#    and $t0,0xff # mask off object's hash value ...
1389##...lui $at,0
1393##...ori $at,$at,0xff
1397##...and $t0,$t0,$at
1400#    sw $t0,-8($s7) # ... and store back into -8 header-word
1404:skipMask_toString:
1404#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
1408#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
1412#    subu $t4,$t2,$t5
1416:toString_copyLoop:    
1416#    lb $t3,($t4)
1420#    and $t3,0x7f # mask off sign bit (in case first word)
1421##...lui $at,0
1425##...ori $at,$at,0x7f
1429##...and $t3,$t3,$at
1432#    sb $t3,-8($t0)
1436#    addu $t4,1
1440#    addu $t0,1
1444#    blt $t4,$t2,toString_copyLoop
1445##...slt $at,$t4,$t2
1449##...bne $at,$zero,1416

    # copy the '@' sign
1452#    li $t3,'@'
1456#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
1460#    addu $t2,$t0,$t1 # address of last byte in string to store +8
1464#    lw $t3,20($sp) # hash code to print
1468:toString_hashCopyLoop:
1468#    and $t4,$t3,0xf
1472#    srl $t3,4
1476#    lb $t4,hexChars($t4)
1480#    sb $t4,-8($t2)
1484#    subu $t2,$t2,1
1488#    bgt $t2,$t0,toString_hashCopyLoop
1489##...slt $at,$t0,$t2
1493##...bne $at,$zero,1468

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
1496#    addu $sp,28
1500#    lw $ra,($sp)
1504#    addu $sp,4
1508#    move $t0, $s7 # return string we created
1512#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
1516:mth_equals_String:
    
    # quick test for obvious false
1516#    lw $t0,($sp) # second parameter
1520#    beq $t0,$zero,goEsFalse # go return false if null
1524#    lw $t1,-12($t0) # vtable pointer
1528#    la $t2,CLASS_String # string vtable pointer
1532#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
1536#    subu $sp,12
1540#    sw $ra,8($sp)
1544#    sw $s2,4($sp)
1548#    sw $t0,($sp)
1552#    jal mth_compareTo_String
1556#    lw $s2, 4($sp) #restore this pointer and pop parameters
1560#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
1564#    seq $t0,$t0,$zero
1565##...subu $at,$t0,$zero
1569##...sltiu $t0,$at,1

    # pop return address and return $t0
1572#    lw $ra,($sp)
1576#    addu $sp,4

1580#    jr $ra # return
    
1584:goEsFalse:
    # put 0 in $t0 and return
1584#    li $t0, 0
1588#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
1592:mth_toString_String:
    #we are a string, so return this.
1592#    move $t0, $s2
1596#    jr $ra

###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
1600:mth_readLine_Lib:
    
1600#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
1604#    sw $ra, 4($sp) # save $ra
1608#    move $t1,$sp # save "original" sp

1612:  doRead:

    # read the character
1612#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
1616#    subu $t2,$v0,13
1620#    bne $t2,$zero,notReturnRL
1624#    jal readLogicalChar
1628#    subu $t2,$v0,10 # check for newline
1632#    beq $t2,$zero,foundNewLine
1636#    sw $v0,lastCharRead # push back character into queue
1640#    j foundNewLine # go process the line

1644:  notReturnRL:

    # at this point, $v0 has our character

1644#    subu $t0,$v0,10
1648#    beq $t0,$zero,foundNewLine
1652#    blt $v0,$zero,foundEof
1653##...slt $at,$v0,$zero
1657##...bne $at,$zero,1672

    # we have a character, so push it onto stack
1660#    subu $sp,$sp,4
1664#    sw $v0,($sp)

    # loop back up to get next character
1668#    j doRead

1672:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
1672#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
1676#    li $s7, 0 # return-value: null
1680#    j rlReturn # return

1684:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
1684#    subu $t0,$t1,$sp # number of chars we read (times 4)
1688#    srl $s6,$t0,2 # number of words on stack with chars
1692#    subu $sp,$sp,4 # push char-count ...
1696#    sw $s6,($sp) # ... onto stack
1700#    addu $t2,$t0,5 # GC tag, incl. for count-word
1704#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
1708#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
1712#    srl $s6,$s6,2  # data words in object
1716#    move $s7,$zero # object words in object
1720#    jal newObject  # allocate space
    
    # store header words
1724#    la $t0,CLASS_String
1728#    sw $t0,-12($s7)# store class tag (String) into object
1732#    lw $t2,4($sp) # char-count
1736#    sll $t1,$t2,2 # 4 times number of chars
1740#    subu $t2,$zero,$t2 # negative of char-count
1744#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
1748#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
1752#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
1753##...slt $at,$t0,$zero
1757##...beq $at,$zero,1776
1760#    and $t0,0xff # mask off object's hash value ...
1761##...lui $at,0
1765##...ori $at,$at,0xff
1769##...and $t0,$t0,$at
1772#    sw $t0,-8($s7) # ... and store back into -8 header-word
1776:  skipMask_readLine:

1776#    sll $t0,$t0,2 # data bytes in object
1780#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
1784#    subu $t0,$t0,$t2 # place to store last character (plus 9)
1788#    addu $sp,$sp,8 # pop redundant object-pointer and count
1792#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

1796#    beq $sp,$t1,rlReturn
1800:  charCopyLoop:
1800#    lw $t2,($sp)
1804#    sb $t2,-9($t0)
1808#    addu $sp,$sp,4
1812#    subu $t0,$t0,1
1816#    bne $sp,$t1,charCopyLoop
1820:  rlReturn:

1820#    lw $ra, 4($sp)
1824#    addu $sp, 8   # pop $ra and pointless word off stack
1828#    move $t0, $s7 # return string we allocated in $s7
1832#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
1836:mth_readInt_Lib:

    # save $ra by pushing onto stack
1836#    subu $sp,$sp,4
1840#    sw $ra,($sp)

1844:  riSkipWhiteLoop:
    # read a character
1844#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
1848#    subu $t0,$v0,32
1852#    bgt $t0,$zero,nonWhite
1853##...slt $at,$zero,$t0
1857##...bne $at,$zero,1900
1860#    beq $t0,$zero,riSkipWhiteLoop # start over if space
1864#    subu $t0,$v0,10
1868#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
1872#    subu $t0,$v0,9
1876#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
1880#    subu $t0,$v0,13
1884#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
1888#    subu $t0,$v0,12
1892#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
1896#    j badIntegerFormat # illegal integer char: abort program

1900:  nonWhite:
1900#    subu $t0,$v0,'-'
1904#    li $t4,1 # final multiplier
1908#    bne $t0,$zero,helpReadInt # go read
1912#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
1916#    jal readLogicalChar

1920:  helpReadInt:
1920#    li $t2,10
1924#    subu $t1,$v0,'0' # convert digit to 0-9 value
1928#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
1929##...sltu $at,$t1,$t2
1933##...beq $at,$zero,4180
1936#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

1940:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

1940#    jal readLogicalChar # read next character
1944#    subu $t1,$v0,'0' # convert digit to 0-9 value
1948#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
1949##...sltu $at,$t1,$t2
1953##...beq $at,$zero,1972

1956#    mul $t3,$t3,$t2 # multiply old value by 10
1957##...mult $t3,$t2
1961##...mflo $t3
1964#    addu $t3,$t3,$t1 # add in value of new digit
1968#    j digitLoop

1972:  doneDigitLoop:

    # "push back" unused character into queue
1972#    sw $v0,lastCharRead

    # restore return address
1976#    lw $ra,($sp)
1980#    addu $sp, 4

    # multiply by sign and put return value in $t0
1984#    mult $t3,$t4 # multiply to account for poss. minus sign
1988#    mflo $t3
1992#    move $t0, $t3
    
    # return
1996#    jr $ra

###################################################################
# readChar() - library method (class Lib)
# - reads a single character from standard input
# - returns the integer that is the encoding of the character
# - returns -1 if end of file was encountered
# - parameter:
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
2000:mth_readChar_Lib:

    # save $ra by pushing onto stack
2000#    subu $sp,$sp,4
2004#    sw $ra,($sp)

      # read the character
2008#    jal readLogicalChar

    # restore return address; put value in $t0
    # replacing this-pointer saved return address
2012#    lw $ra,($sp)
2016#    addu $sp, 4
2020#    move $t0, $v0

    # return
2024#    jr $ra

########################################################
# printStr(str) - library method (class Lib)
# - prints string to standard output
# parameters:
#   - ($sp) - the string to print
#   - 4($sp) - old-this-pointer
########################################################
2028:mth_printStr_Lib:
    # check for null, printing "(null)", if so
2028#    lw $t0,($sp)
2032#    bne $t0,$zero,psNotNull

    # print "(null)"
2036#    la $a0,nullStr
2040#    li $v0,4
2044#    syscall
2048#    j donePrintStr
    
2052:  psNotNull:
    ##### we have a non-null string #####
    # this means that:
    # - number of data words in -8($t0):
    #   - if the sign bit is 1, the low 31 bits
    #   - if the sign bit is 0, the low 8 bits
    # - negative of number of characters in string is in -4($t0)
    # - string begins at $t0-8-(#dataWords*4), stored 1 char per byte
2052#    subu $t0,$t0,8
2056#    lw $t1,($t0) # number of data words, but needs modification
2060#    blt $t1,$zero,skipPrintStr1
2061##...slt $at,$t1,$zero
2065##...bne $at,$zero,2084
2068#    and $t1,0xff # mask out all but low byte
2069##...lui $at,0
2073##...ori $at,$at,0xff
2077##...and $t1,$t1,$at
2080#    b skipPrintStr2
2084:skipPrintStr1:
2084#    and $t1,0x7ffffff
2085##...lui $at,2047
2089##...ori $at,$at,0xffff
2093##...and $t1,$t1,$at
2096:skipPrintStr2:    
2096#    sll $t1,$t1,2
2100#    subu $t1,$t0,$t1 # first word in string
2104#    lw $t0,4($t0) # negative of string-length
2108#    subu $t0,$t1,$t0 # byte just beyond last char in string

    # print the chars in the string
2112#    beq $t0,$t1,donePrintStr
2116:  psLoop:
2116#    lb $a0,($t1) # next byte
