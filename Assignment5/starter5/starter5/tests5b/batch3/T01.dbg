###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
2556:mth_readLine_Lib:
    
2556#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
2560#    sw $ra, 4($sp) # save $ra
2564#    move $t1,$sp # save "original" sp

2568:  doRead:

    # read the character
2568#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
2572#    subu $t2,$v0,13
2576#    bne $t2,$zero,notReturnRL
2580#    jal readLogicalChar
2584#    subu $t2,$v0,10 # check for newline
2588#    beq $t2,$zero,foundNewLine
2592#    sw $v0,lastCharRead # push back character into queue
2596#    j foundNewLine # go process the line

2600:  notReturnRL:

    # at this point, $v0 has our character

2600#    subu $t0,$v0,10
2604#    beq $t0,$zero,foundNewLine
2608#    blt $v0,$zero,foundEof
2609##...slt $at,$v0,$zero
2613##...bne $at,$zero,2628

    # we have a character, so push it onto stack
2616#    subu $sp,$sp,4
2620#    sw $v0,($sp)

    # loop back up to get next character
2624#    j doRead

2628:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
2628#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
2632#    li $s7, 0 # return-value: null
2636#    j rlReturn # return

2640:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
2640#    subu $t0,$t1,$sp # number of chars we read (times 4)
2644#    srl $s6,$t0,2 # number of words on stack with chars
2648#    subu $sp,$sp,4 # push char-count ...
2652#    sw $s6,($sp) # ... onto stack
2656#    addu $t2,$t0,5 # GC tag, incl. for count-word
2660#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
2664#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
2668#    srl $s6,$s6,2  # data words in object
2672#    move $s7,$zero # object words in object
2676#    jal newObject  # allocate space
    
    # store header words
2680#    la $t0,CLASS_String
2684#    sw $t0,-12($s7)# store class tag (String) into object
2688#    lw $t2,4($sp) # char-count
2692#    sll $t1,$t2,2 # 4 times number of chars
2696#    subu $t2,$zero,$t2 # negative of char-count
2700#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
2704#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
2708#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
2709##...slt $at,$t0,$zero
2713##...beq $at,$zero,2732
2716#    and $t0,0xff # mask off object's hash value ...
2717##...lui $at,0
2721##...ori $at,$at,0xff
2725##...and $t0,$t0,$at
2728#    sw $t0,-8($s7) # ... and store back into -8 header-word
2732:  skipMask_readLine:

2732#    sll $t0,$t0,2 # data bytes in object
2736#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
2740#    subu $t0,$t0,$t2 # place to store last character (plus 9)
2744#    addu $sp,$sp,8 # pop redundant object-pointer and count
2748#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

2752#    beq $sp,$t1,rlReturn
2756:  charCopyLoop:
2756#    lw $t2,($sp)
2760#    sb $t2,-9($t0)
2764#    addu $sp,$sp,4
2768#    subu $t0,$t0,1
2772#    bne $sp,$t1,charCopyLoop
2776:  rlReturn:

2776#    lw $ra, 4($sp)
2780#    addu $sp, 8   # pop $ra and pointless word off stack
2784#    move $t0, $s7 # return string we allocated in $s7
2788#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
2792:mth_readInt_Lib:

    # save $ra by pushing onto stack
2792#    subu $sp,$sp,4
2796#    sw $ra,($sp)

2800:  riSkipWhiteLoop:
    # read a character
2800#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
2804#    subu $t0,$v0,32
2808#    bgt $t0,$zero,nonWhite
2809##...slt $at,$zero,$t0
2813##...bne $at,$zero,2856
2816#    beq $t0,$zero,riSkipWhiteLoop # start over if space
2820#    subu $t0,$v0,10
2824#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
2828#    subu $t0,$v0,9
2832#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
2836#    subu $t0,$v0,13
2840#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
2844#    subu $t0,$v0,12
2848#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
2852#    j badIntegerFormat # illegal integer char: abort program

2856:  nonWhite:
2856#    subu $t0,$v0,'-'
2860#    li $t4,1 # final multiplier
2864#    bne $t0,$zero,helpReadInt # go read
2868#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
2872#    jal readLogicalChar

2876:  helpReadInt:
2876#    li $t2,10
2880#    subu $t1,$v0,'0' # convert digit to 0-9 value
2884#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
2885##...sltu $at,$t1,$t2
2889##...beq $at,$zero,5172
2892#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

2896:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

2896#    jal readLogicalChar # read next character
2900#    subu $t1,$v0,'0' # convert digit to 0-9 value
2904#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
2905##...sltu $at,$t1,$t2
2909##...beq $at,$zero,2928

2912#    mul $t3,$t3,$t2 # multiply old value by 10
2913##...mult $t3,$t2
2917##...mflo $t3
2920#    addu $t3,$t3,$t1 # add in value of new digit
2924#    j digitLoop

2928:  doneDigitLoop:

    # "push back" unused character into queue
2928#    sw $v0,lastCharRead

    # restore return address
2932#    lw $ra,($sp)
2936#    addu $sp, 4

    # multiply by sign and put return value in $t0
2940#    mult $t3,$t4 # multiply to account for poss. minus sign
2944#    mflo $t3
2948#    move $t0, $t3
    
    # return
2952#    jr $ra

