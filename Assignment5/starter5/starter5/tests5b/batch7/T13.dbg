###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
1032:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
1032#    subu $sp,4
1036#    sw $ra,($sp)
    
    # get hash value
1040#    lw $t2,-12($s2) # vtable address
1044#    lw $t0,($t2) # method address
1048#    jalr $t0
1052#    subu $sp,8 # push result (int in $t0) on stack
1056#    sw $s5,4($sp)
1060#    sw $t0,($sp)

    # compute print-size of hash value
1064#    li $t0, 1
1068#    lw $t1, ($sp)
1072#    srl $t1,$t1,4
1076#    beq $t1,$zero,toString_skip_loop
1080:toString_loop_top:
1080#    addu $t0,1
1084#    srl $t1,$t1,4
1088#    bne $t1,$zero,toString_loop_top
1092:toString_skip_loop:
1092#    subu $sp,8
1096#    sw $s5,4($sp)
1100#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
1104#    lw $t2,-12($s2) # vtable address
1108#    move $t0,$t2
1112:toString_checkTagBit:
1112#    subu $t0,1
1116#    lb $t1,($t0)
1120#    and $t1,0x80
1121##...lui $at,0
1125##...ori $at,$at,0x80
1129##...and $t1,$t1,$at
1132#    beq $t1,$zero,toString_checkTagBit
1136#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
1140#    subu $sp,8
1144#    sw $t1,($sp)
1148#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
1152#    move $s7,$zero # -4 offset header word
1156#    lw $t4,8($sp) # bytes for hash value
1160#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
1164#    addu $t4,8
1168#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
1172#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

1176#    li $t0,CLASS_String # store string vtable address into ...
1180#    sw $t0,-12($s7) # ... -12 offset in object header
1184#    lw $t2,-12($s2) # our object's vtable address
1188#    lw $t5,4($sp) # number characters in prefix
1192#    lw $t1,12($sp) # number of characters in hashcode
1196#    addu $t3,$t1,$t5 # number of characters in string ...
1200#    addu $t3,1 # ... including the '@' character
1204#    subu $t0,$zero,$t3 # store negated length into ...
1208#    sw $t0,-4($s7) # ... -4 offset header word
1212#    lw $t0,-8($s7) # get -8 offset header-word
1216#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
1217##...slt $at,$t0,$zero
1221##...beq $at,$zero,1240
1224#    and $t0,0xff # mask off object's hash value ...
1225##...lui $at,0
1229##...ori $at,$at,0xff
1233##...and $t0,$t0,$at
1236#    sw $t0,-8($s7) # ... and store back into -8 header-word
1240:skipMask_toString:
1240#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
1244#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
1248#    subu $t4,$t2,$t5
1252:toString_copyLoop:    
1252#    lb $t3,($t4)
1256#    and $t3,0x7f # mask off sign bit (in case first word)
1257##...lui $at,0
1261##...ori $at,$at,0x7f
1265##...and $t3,$t3,$at
1268#    sb $t3,-8($t0)
1272#    addu $t4,1
1276#    addu $t0,1
1280#    blt $t4,$t2,toString_copyLoop
1281##...slt $at,$t4,$t2
1285##...bne $at,$zero,1252

    # copy the '@' sign
1288#    li $t3,'@'
1292#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
1296#    addu $t2,$t0,$t1 # address of last byte in string to store +8
1300#    lw $t3,20($sp) # hash code to print
1304:toString_hashCopyLoop:
1304#    and $t4,$t3,0xf
1308#    srl $t3,4
1312#    lb $t4,hexChars($t4)
1316#    sb $t4,-8($t2)
1320#    subu $t2,$t2,1
1324#    bgt $t2,$t0,toString_hashCopyLoop
1325##...slt $at,$t0,$t2
1329##...bne $at,$zero,1304

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
1332#    addu $sp,28
1336#    lw $ra,($sp)
1340#    addu $sp,4
1344#    move $t0, $s7 # return string we created
1348#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
1352:mth_equals_String:
    
    # quick test for obvious false
1352#    lw $t0,($sp) # second parameter
1356#    beq $t0,$zero,goEsFalse # go return false if null
1360#    lw $t1,-12($t0) # vtable pointer
1364#    la $t2,CLASS_String # string vtable pointer
1368#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
1372#    subu $sp,12
1376#    sw $ra,8($sp)
1380#    sw $s2,4($sp)
1384#    sw $t0,($sp)
1388#    jal mth_compareTo_String
1392#    lw $s2, 4($sp) #restore this pointer and pop parameters
1396#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
1400#    seq $t0,$t0,$zero
1401##...subu $at,$t0,$zero
1405##...sltiu $t0,$at,1

    # pop return address and return $t0
1408#    lw $ra,($sp)
1412#    addu $sp,4

1416#    jr $ra # return
    
1420:goEsFalse:
    # put 0 in $t0 and return
1420#    li $t0, 0
1424#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
