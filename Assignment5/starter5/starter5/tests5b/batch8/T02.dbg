3856#    or $t1,0x80000000 # set top bit
3857##...lui $at,32768
3861##...or $t1,$at,$t1
3864#    and $t1,0xffffff00 # clear low bit
3865##...lui $at,65535
3869##...ori $at,$at,0xff00
3873##...and $t1,$t1,$at
3876#    or $s6,$t1
3880:firstHeaderLarge:
3880#    sw $s6,-8($t0) # store header-1 value
3884#    lw $zero,-8($t0)

    # store second header-value
3888#    sw $s7,-4($t0)   # second header-word
3892#    lw $zero,-4($t0)
    
    # put return-value into $s7 and also push it onto top of stack
3896#    move $s7,$t0
3900#    subu $sp,$sp,4
3904#    sw $t0,($sp)
