###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
9560:mth_equals_String:
    
    # quick test for obvious false
9560#    lw $t0,($sp) # second parameter
9564#    beq $t0,$zero,goEsFalse # go return false if null
9568#    lw $t1,-12($t0) # vtable pointer
9572#    la $t2,CLASS_String # string vtable pointer
9576#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
9580#    subu $sp,12
9584#    sw $ra,8($sp)
9588#    sw $s2,4($sp)
9592#    sw $t0,($sp)
9596#    jal mth_compareTo_String
9600#    lw $s2, 4($sp) #restore this pointer and pop parameters
9604#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
9608#    seq $t0,$t0,$zero
9609##...subu $at,$t0,$zero
9613##...sltiu $t0,$at,1

    # pop return address and return $t0
9616#    lw $ra,($sp)
9620#    addu $sp,4

9624#    jr $ra # return
    
9628:goEsFalse:
    # put 0 in $t0 and return
9628#    li $t0, 0
9632#    jr $ra # return

