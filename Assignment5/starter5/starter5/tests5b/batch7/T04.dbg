###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
1200:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
1200#    subu $sp,4
1204#    sw $ra,($sp)
    
    # get hash value
1208#    lw $t2,-12($s2) # vtable address
1212#    lw $t0,($t2) # method address
1216#    jalr $t0
1220#    subu $sp,8 # push result (int in $t0) on stack
1224#    sw $s5,4($sp)
1228#    sw $t0,($sp)

    # compute print-size of hash value
1232#    li $t0, 1
1236#    lw $t1, ($sp)
1240#    srl $t1,$t1,4
1244#    beq $t1,$zero,toString_skip_loop
1248:toString_loop_top:
1248#    addu $t0,1
1252#    srl $t1,$t1,4
1256#    bne $t1,$zero,toString_loop_top
1260:toString_skip_loop:
1260#    subu $sp,8
1264#    sw $s5,4($sp)
1268#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
1272#    lw $t2,-12($s2) # vtable address
1276#    move $t0,$t2
1280:toString_checkTagBit:
1280#    subu $t0,1
1284#    lb $t1,($t0)
1288#    and $t1,0x80
1289##...lui $at,0
1293##...ori $at,$at,0x80
1297##...and $t1,$t1,$at
1300#    beq $t1,$zero,toString_checkTagBit
1304#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
1308#    subu $sp,8
1312#    sw $t1,($sp)
1316#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
1320#    move $s7,$zero # -4 offset header word
1324#    lw $t4,8($sp) # bytes for hash value
1328#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
1332#    addu $t4,8
1336#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
1340#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

1344#    li $t0,CLASS_String # store string vtable address into ...
1348#    sw $t0,-12($s7) # ... -12 offset in object header
1352#    lw $t2,-12($s2) # our object's vtable address
1356#    lw $t5,4($sp) # number characters in prefix
1360#    lw $t1,12($sp) # number of characters in hashcode
1364#    addu $t3,$t1,$t5 # number of characters in string ...
1368#    addu $t3,1 # ... including the '@' character
1372#    subu $t0,$zero,$t3 # store negated length into ...
1376#    sw $t0,-4($s7) # ... -4 offset header word
1380#    lw $t0,-8($s7) # get -8 offset header-word
1384#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
1385##...slt $at,$t0,$zero
1389##...beq $at,$zero,1408
1392#    and $t0,0xff # mask off object's hash value ...
1393##...lui $at,0
1397##...ori $at,$at,0xff
1401##...and $t0,$t0,$at
1404#    sw $t0,-8($s7) # ... and store back into -8 header-word
1408:skipMask_toString:
1408#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
1412#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
1416#    subu $t4,$t2,$t5
1420:toString_copyLoop:    
1420#    lb $t3,($t4)
1424#    and $t3,0x7f # mask off sign bit (in case first word)
1425##...lui $at,0
1429##...ori $at,$at,0x7f
1433##...and $t3,$t3,$at
1436#    sb $t3,-8($t0)
1440#    addu $t4,1
1444#    addu $t0,1
1448#    blt $t4,$t2,toString_copyLoop
1449##...slt $at,$t4,$t2
1453##...bne $at,$zero,1420

    # copy the '@' sign
1456#    li $t3,'@'
1460#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
1464#    addu $t2,$t0,$t1 # address of last byte in string to store +8
1468#    lw $t3,20($sp) # hash code to print
1472:toString_hashCopyLoop:
1472#    and $t4,$t3,0xf
1476#    srl $t3,4
1480#    lb $t4,hexChars($t4)
1484#    sb $t4,-8($t2)
1488#    subu $t2,$t2,1
1492#    bgt $t2,$t0,toString_hashCopyLoop
1493##...slt $at,$t0,$t2
1497##...bne $at,$zero,1472

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
1500#    addu $sp,28
1504#    lw $ra,($sp)
1508#    addu $sp,4
1512#    move $t0, $s7 # return string we created
1516#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
1520:mth_equals_String:
    
    # quick test for obvious false
1520#    lw $t0,($sp) # second parameter
1524#    beq $t0,$zero,goEsFalse # go return false if null
1528#    lw $t1,-12($t0) # vtable pointer
1532#    la $t2,CLASS_String # string vtable pointer
1536#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
1540#    subu $sp,12
1544#    sw $ra,8($sp)
1548#    sw $s2,4($sp)
1552#    sw $t0,($sp)
1556#    jal mth_compareTo_String
1560#    lw $s2, 4($sp) #restore this pointer and pop parameters
1564#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
1568#    seq $t0,$t0,$zero
1569##...subu $at,$t0,$zero
1573##...sltiu $t0,$at,1

    # pop return address and return $t0
1576#    lw $ra,($sp)
1580#    addu $sp,4

1584#    jr $ra # return
    
1588:goEsFalse:
    # put 0 in $t0 and return
1588#    li $t0, 0
1592#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
