#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
2716:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
2716#    lw $t0,-8($s2) # get word with hash bits from this
2720#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
2724#    addu $t0,$t1

2728#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
2732:mth_equals_Object:
2732#    move $t0,$s2 # first pointer (this)
2736#    lw $t1,($sp) # second pointer
2740#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
2741##...subu $at,$t0,$t1
2745##...sltiu $t0,$at,1

2748#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
2752:mth_hashCode_String:
2752#    move $t0,$s2 # put this pointer in t0

2756#    li $t2,0 # current hash value
2760#    lw $t1,-4($t0) # negative of number of characters in string
2764#    beq $t1,$zero,done_hashCode_String # if zero length => done
2768#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
2772#    and $t0,0xfffffffc # adjust for padding
2773##...lui $at,65535
2777##...ori $at,$at,0xfffc
2781##...and $t0,$t0,$at
2784#    subu $t1,$t0,$t1 # address at end of string +12
2788:loop_hashCode_String:    
2788#    sll $t4,$t2,5 # multiply by 32
2792#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
2796#    lbu $t3,-12($t0) # current character
2800#    addu $t2,$t3 # add in current character
2804#    addu $t0,1 # go to next character's address
2808#    bne $t0,$t1,loop_hashCode_String # loop back if more
2812:done_hashCode_String:    

    # push int on stack
2812#    move $t0, $t2 # put $t2 in return slot
2816#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
2820:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
2820#    subu $sp,4
2824#    sw $ra,($sp)
    
    # get hash value
2828#    lw $t2,-12($s2) # vtable address
2832#    lw $t0,($t2) # method address
2836#    jalr $t0
2840#    subu $sp,8 # push result (int in $t0) on stack
2844#    sw $s5,4($sp)
2848#    sw $t0,($sp)

    # compute print-size of hash value
2852#    li $t0, 1
2856#    lw $t1, ($sp)
2860#    srl $t1,$t1,4
2864#    beq $t1,$zero,toString_skip_loop
2868:toString_loop_top:
2868#    addu $t0,1
2872#    srl $t1,$t1,4
2876#    bne $t1,$zero,toString_loop_top
2880:toString_skip_loop:
2880#    subu $sp,8
2884#    sw $s5,4($sp)
2888#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
2892#    lw $t2,-12($s2) # vtable address
2896#    move $t0,$t2
2900:toString_checkTagBit:
2900#    subu $t0,1
2904#    lb $t1,($t0)
2908#    and $t1,0x80
2909##...lui $at,0
2913##...ori $at,$at,0x80
2917##...and $t1,$t1,$at
2920#    beq $t1,$zero,toString_checkTagBit
2924#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
2928#    subu $sp,8
2932#    sw $t1,($sp)
2936#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
2940#    move $s7,$zero # -4 offset header word
2944#    lw $t4,8($sp) # bytes for hash value
2948#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
2952#    addu $t4,8
2956#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
2960#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

2964#    li $t0,CLASS_String # store string vtable address into ...
2968#    sw $t0,-12($s7) # ... -12 offset in object header
2972#    lw $t2,-12($s2) # our object's vtable address
2976#    lw $t5,4($sp) # number characters in prefix
2980#    lw $t1,12($sp) # number of characters in hashcode
2984#    addu $t3,$t1,$t5 # number of characters in string ...
2988#    addu $t3,1 # ... including the '@' character
2992#    subu $t0,$zero,$t3 # store negated length into ...
2996#    sw $t0,-4($s7) # ... -4 offset header word
3000#    lw $t0,-8($s7) # get -8 offset header-word
3004#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
3005##...slt $at,$t0,$zero
3009##...beq $at,$zero,3028
3012#    and $t0,0xff # mask off object's hash value ...
3013##...lui $at,0
3017##...ori $at,$at,0xff
3021##...and $t0,$t0,$at
3024#    sw $t0,-8($s7) # ... and store back into -8 header-word
3028:skipMask_toString:
3028#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
3032#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
3036#    subu $t4,$t2,$t5
3040:toString_copyLoop:    
3040#    lb $t3,($t4)
3044#    and $t3,0x7f # mask off sign bit (in case first word)
3045##...lui $at,0
3049##...ori $at,$at,0x7f
3053##...and $t3,$t3,$at
3056#    sb $t3,-8($t0)
3060#    addu $t4,1
3064#    addu $t0,1
3068#    blt $t4,$t2,toString_copyLoop
3069##...slt $at,$t4,$t2
3073##...bne $at,$zero,3040

    # copy the '@' sign
3076#    li $t3,'@'
3080#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
3084#    addu $t2,$t0,$t1 # address of last byte in string to store +8
3088#    lw $t3,20($sp) # hash code to print
3092:toString_hashCopyLoop:
3092#    and $t4,$t3,0xf
3096#    srl $t3,4
3100#    lb $t4,hexChars($t4)
3104#    sb $t4,-8($t2)
3108#    subu $t2,$t2,1
3112#    bgt $t2,$t0,toString_hashCopyLoop
3113##...slt $at,$t0,$t2
3117##...bne $at,$zero,3092

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
3120#    addu $sp,28
3124#    lw $ra,($sp)
3128#    addu $sp,4
3132#    move $t0, $s7 # return string we created
3136#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
3140:mth_equals_String:
    
    # quick test for obvious false
3140#    lw $t0,($sp) # second parameter
3144#    beq $t0,$zero,goEsFalse # go return false if null
3148#    lw $t1,-12($t0) # vtable pointer
3152#    la $t2,CLASS_String # string vtable pointer
3156#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
3160#    subu $sp,12
3164#    sw $ra,8($sp)
3168#    sw $s2,4($sp)
3172#    sw $t0,($sp)
3176#    jal mth_compareTo_String
3180#    lw $s2, 4($sp) #restore this pointer and pop parameters
3184#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
3188#    seq $t0,$t0,$zero
3189##...subu $at,$t0,$zero
3193##...sltiu $t0,$at,1

    # pop return address and return $t0
3196#    lw $ra,($sp)
3200#    addu $sp,4

3204#    jr $ra # return
    
3208:goEsFalse:
    # put 0 in $t0 and return
3208#    li $t0, 0
3212#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
3216:mth_toString_String:
    #we are a string, so return this.
3216#    move $t0, $s2
3220#    jr $ra

###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
3224:mth_readLine_Lib:
    
3224#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
3228#    sw $ra, 4($sp) # save $ra
3232#    move $t1,$sp # save "original" sp

3236:  doRead:

    # read the character
3236#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
3240#    subu $t2,$v0,13
3244#    bne $t2,$zero,notReturnRL
3248#    jal readLogicalChar
3252#    subu $t2,$v0,10 # check for newline
3256#    beq $t2,$zero,foundNewLine
3260#    sw $v0,lastCharRead # push back character into queue
3264#    j foundNewLine # go process the line

3268:  notReturnRL:

    # at this point, $v0 has our character

3268#    subu $t0,$v0,10
3272#    beq $t0,$zero,foundNewLine
3276#    blt $v0,$zero,foundEof
3277##...slt $at,$v0,$zero
3281##...bne $at,$zero,3296

    # we have a character, so push it onto stack
3284#    subu $sp,$sp,4
3288#    sw $v0,($sp)

    # loop back up to get next character
3292#    j doRead

3296:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
3296#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
3300#    li $s7, 0 # return-value: null
3304#    j rlReturn # return

3308:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
3308#    subu $t0,$t1,$sp # number of chars we read (times 4)
3312#    srl $s6,$t0,2 # number of words on stack with chars
3316#    subu $sp,$sp,4 # push char-count ...
3320#    sw $s6,($sp) # ... onto stack
3324#    addu $t2,$t0,5 # GC tag, incl. for count-word
3328#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
3332#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
3336#    srl $s6,$s6,2  # data words in object
3340#    move $s7,$zero # object words in object
3344#    jal newObject  # allocate space
    
    # store header words
3348#    la $t0,CLASS_String
3352#    sw $t0,-12($s7)# store class tag (String) into object
3356#    lw $t2,4($sp) # char-count
3360#    sll $t1,$t2,2 # 4 times number of chars
3364#    subu $t2,$zero,$t2 # negative of char-count
3368#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
3372#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
3376#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
3377##...slt $at,$t0,$zero
3381##...beq $at,$zero,3400
3384#    and $t0,0xff # mask off object's hash value ...
3385##...lui $at,0
3389##...ori $at,$at,0xff
3393##...and $t0,$t0,$at
3396#    sw $t0,-8($s7) # ... and store back into -8 header-word
3400:  skipMask_readLine:

3400#    sll $t0,$t0,2 # data bytes in object
3404#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
3408#    subu $t0,$t0,$t2 # place to store last character (plus 9)
3412#    addu $sp,$sp,8 # pop redundant object-pointer and count
3416#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

3420#    beq $sp,$t1,rlReturn
3424:  charCopyLoop:
3424#    lw $t2,($sp)
3428#    sb $t2,-9($t0)
3432#    addu $sp,$sp,4
3436#    subu $t0,$t0,1
3440#    bne $sp,$t1,charCopyLoop
3444:  rlReturn:

3444#    lw $ra, 4($sp)
3448#    addu $sp, 8   # pop $ra and pointless word off stack
3452#    move $t0, $s7 # return string we allocated in $s7
3456#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
3460:mth_readInt_Lib:

    # save $ra by pushing onto stack
3460#    subu $sp,$sp,4
3464#    sw $ra,($sp)

3468:  riSkipWhiteLoop:
    # read a character
3468#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
3472#    subu $t0,$v0,32
3476#    bgt $t0,$zero,nonWhite
3477##...slt $at,$zero,$t0
