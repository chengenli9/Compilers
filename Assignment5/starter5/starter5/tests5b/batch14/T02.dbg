5588:  gcSkip4:

    # if there were no objects put into the heap during stack
    # processing, we're done, so go finish up
5588#    bgeu $t0,$s3,gcFinishUp
5589##...sltu $at,$t0,$s3
5593##...beq $at,$zero,5884

    ###### begin outer loop to copy all non-stack-direct objects ######

5596:  gcHeapCopyLoop:
    # get data count for object; swap header-word with first word
    # of object so that they're back in the right place
5596#    lw $t1,($t0) # (what will be) first header word for current object
5600#    move $t2,$t1 # number data bytes in object (poss. w/hash bits)
5604#    bge $t2,$zero,gcSkip4a # are there hash bits?
5605##...slt $at,$t2,$zero
5609##...beq $at,$zero,5624
5612#    and $t2,0xff # mask off hash bits
5613##...lui $at,0
5617##...ori $at,$at,0xff
5621##...and $t2,$t2,$at
5624:gcSkip4a:    
5624#    sll $t2,$t2,2 # # data bytes
5628#    addu $t2,$t2,8 # to skip header words
5632#    addu $t2,$t0,$t2 # pointer to new object
5636#    lw $t3,-8($t2) # word to swap
5640#    sw $t1,-8($t2) # store header word
5644#    sw $t3,($t0) # restore first word of object

    ################################################
    # at this point:
    # - $t2 contains the pointer to our new object
    ################################################

    # check if we have a data array
5648#    lw $t1,-12($t2) # vtable pointer
5652#    li $t0,dataArrayVTableStart # address of vtable for first data array
5656#    blt $t1,$t0,gcNotDataArray # if data array, no more xforming to do
5657##...slt $at,$t1,$t0
5661##...bne $at,$zero,5680

    # We have a vtable address that is a data array.
    # we need skip over it then loop back to do next object.
5664:  skipToNextObj:
5664#    lw $t1,-4($t2) # data words in (object position of) array
    #### note: we know that it's not a string, so the value will
    #### not be artificially negative
5668#    sll $t1,$t1,2 # convert to byte-count
5672#    addu $t0,$t2,$t1 # skip over object
5676#    j gcTestIterDone2 # go do next object, if any

    ###################################################
    # at this point:
    # - the object has been restored to normal status--that is, the
    #   word-swap has been done
    # - $t2 contains a pointer to the object
    ###################################################
    
5680:  gcNotDataArray:
5680#    lw $t3,-4($t2) # # object words (negative treated as zero)
5684#    bge $t3,$zero,gcH2Neg2
5685##...slt $at,$t3,$zero
5689##...beq $at,$zero,5696
5692#    move $t3,$zero
5696:  gcH2Neg2:
5696#    sll $t3,$t3,2 # # object bytes
5700#    move $t0,$t2 # address of first pointer in object
5704#    add $s1,$t2,$t3 # limit address for this object

    #####################################################
    # At this point, we have to "translate" all pointers,
    # starting at $t0 to (but not including) $s1
    #####################################################

    # if there are no pointer-slots (i.e., $t0=$s1), skip this
    # part
5708#    beq $t0,$s1,gcTestIterDone2
    
5712:  gcNextPointerInObject:
    # get pointer from object
5712#    lw $t1,($t0)

    # if value is out of range, and is therefore does not refer
    # to an object, just go loop back and do the next one
5716#    bleu $t1,$t6,gcGoNextPointerSlot
5717##...sltu $at,$t6,$t1
5721##...beq $at,$zero,5864
5724#    bgtu $t1,$t7,gcGoNextPointerSlot
5725##...sltu $at,$t7,$t1
5729##...bne $at,$zero,5864

    # if the object has already been moved, update the stack-value
    # via the forwarding pointer
5732#    lw $t8,-8($t1) # possible forwarding tag
5736#    bne $t8,$zero,gcNoForward2 # if not forwarding tag, go copy
5740#    lw $t8,-4($t1) # forwarding pointer: object's new address
5744#    sw $t8,($t0) # update pointer in object
5748#    j gcGoNextPointerSlot # do next iteration

5752:  gcNoForward2:
    #########################################################
    # we actually need to copy the object into the new space
    #########################################################

    #########################################################
    # At this point:
    # - $t0 contains the address of the heap-slot we're translating
    # - $t1 will contain the contents of the heap-slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space, which will also be the first address
    #   of the target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # Then during processing:
    # And when we're actually copying an object:
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $t8 will contain a pointer to the target object
    # - available for use: $s0, $t8, $t9
    ##########################################################

    # compute the amount of space that is needed
5752#    bge $t8,$zero,gcSkip5 # # words in negative-offset portion
5753##...slt $at,$t8,$zero
5757##...beq $at,$zero,5772
5760#    and $t8,0xff # mask off hash bits
5761##...lui $at,0
5765##...ori $at,$at,0xff
5769##...and $t8,$t8,$at

5772:  gcSkip5:
5772#    sll $t8,$t8,2 # bytes in negative-offset portion ...
5776#    addu $t8,$t8,8 # ... add in bytes for header-words
5780#    subu $t4,$t1,$t8 # address of first word of source object
5784#    lw $t3,-4($t1) # # words in positive-offset portion
5788#    bge $t3,$zero,gcNoNeg
5789##...slt $at,$t3,$zero
5793##...beq $at,$zero,5800
5796#    move $t3,$zero # negative treated as zero
5800:  gcNoNeg:
5800#    sll $t3,$t3,2 # bytes in negative-offset portion
5804#    addu $t3,$t3,$t1 # address one word past last word of source

5808#    addu $t8,$s3,$t8 # pointer to target object

    #########################################################
    # At this point:
    # - $t0 contains the address of the stack slot we'll
    #   process next
    # - $t1 contains the contents of the stack slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $t8 contains the pointer to the target object
    # - $s1 contains the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0, $t9
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger"
5812#    lw $s0,($t4)
5816#    lw $t9,-8($t1)
5820#    sw $t9,($t4)
5824#    sw $s0,-8($t1)

    # copy all source bytes to the target
5828:  gCinnerCopy2:
5828#    lw $s0,($t4)
5832#    sw $s0,($s3)
5836#    addu $t4,$t4,4
5840#    addu $s3,$s3,4
5844#    bltu $t4,$t3,gCinnerCopy2
5845##...sltu $at,$t4,$t3
5849##...bne $at,$zero,5828

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
5852#    sw $zero,-8($t1) # 0 in first header-slot
5856#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
5860#    sw $t8,($t0)

5864:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
5864#    addu $t0,$t0,4
5868#    bltu $t0,$s1,gcNextPointerInObject
5869##...sltu $at,$t0,$s1
5873##...bne $at,$zero,5712

5876:  gcTestIterDone2:
5876#    bltu $t0,$s3,gcHeapCopyLoop
5877##...sltu $at,$t0,$s3
5881##...bne $at,$zero,5596

    ###### end outer loop to copy all non-stack-direct objects ######

5884:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
5884#    lw $s2,($sp)
5888#    addu $sp,$sp,4

    # mark us as having already GC'd
5892#    move $t5,$s5

    # go try and allocate again
5896#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
5900:vm_init:

    # mark bottom of stack
5900#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
5904#    move $s2,$zero

    #set up the "five" register
5908#    li $s5,5

5912#    la $s3,seg0_start
5916#    la $s4,seg0_end
5917##...lui $s4,16
5921##...addiu $s4,$s4,6820
    
    # return
5924#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
5928:divide:
    # get parameters; abort if divisor zero
5928#    lw $t0,($sp)
5932#    lw $t1,8($sp)
5936#    beq $t0,$zero,divByZeroError
    
    # perform division
5940#    div $t1,$t0
5944#    mflo $t0

    # store result, adjust stack and return
5948#    addu $sp,$sp,8 # adjust stack
5952#    sw $t0,($sp) # store result
5956#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
5960:remainder:
    # get parameters; abort if divisor zero
5960#    lw $t0,($sp)
5964#    lw $t1,8($sp)
5968#    beq $t0,$zero,divByZeroError
    
    # perform division
5972#    div $t1,$t0
5976#    mfhi $t0

    # store result, adjust stack and return
5980#    addu $sp,$sp,8 # adjust stack
5984#    sw $t0,($sp) # store result
5988#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
5992:checkCast:
    # get object, allow immediately if null
5992#    lw $t2,($sp)
5996#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
6000#    lw $t2,-12($t2) # vtable address
6004#    bge $t2,$t1,castException
6005##...slt $at,$t2,$t1
6009##...beq $at,$zero,6144
6012#    blt $t2,$t0,castException
6013##...slt $at,$t2,$t0
6017##...bne $at,$zero,6144
    
    # return, leaving object unchanged on stack
6020:  checkCastReturn:    
6020#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
6024:instanceOf:
    # get object, go return false if null
6024#    lw $t2,($sp)
6028#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
6032#    lw $t2,-12($t2) # vtable address
6036#    sge $t0,$t2,$t0 # are we >= the lower limit?
6037##...slt $t0,$t2,$t0
6041##...xori $t0,$t0,0x1
6044#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
6048#    and $t2,$t0,$t1
6052#    sw $t2,($sp)
6056:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
6056#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

6060:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
6060#    li $v0,4 # syscall-code for print-string
6064#    syscall
6068:exit:
    # print termination message
6068#    li $v0,4 # syscall-code for print-string
6072#    la $a0,exitString
6076#    syscall

    # terminate execution
6080#    li $v0,10 #syscall-code for "exit"
6084#    syscall

6088:outOfHeapMemory:
6088#    la $a0,heapMemoryMsg
6092#    j exitError
6096:divByZeroError:
6096#    la $a0,divByZeroMsg
6100#    j exitError
6104:strIndexOutOfBounds:
6104#    la $a0,strIndexOutOfBoundsMsg
6108#    j exitError
6112:arrayIndexOutOfBounds:
6112#    la $a0,arrayIndexOutOfBoundsMsg
6116#    j exitError
6120:arraySizeOutOfBounds:
6120#    la $a0,arraySizeOutOfBoundsMsg
6124#    j exitError
6128:nullPtrException:
6128#    la $a0,nullPtrExceptionMsg
6132#    j exitError
6136:badIntegerFormat:
6136#    la $a0,badIntegerFormatMsg
6140#    j exitError
6144:castException:
6144#    la $a0,castExceptionMsg
6148#    j exitError
############## data section ################
    .data
6456:hexChars:
    .ascii "0123456789abcdef"
    .align 2
6472:cur_seg:
    .word 0

6476:lastCharRead:
    .word -2 # -2 => no buffered character
6480:prevHashConstant:
    .word 0x2785173c
6484:gcCount:
    .word 0

6488:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
6515:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
6538:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
6573:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
6607:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
6640:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
6671:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
6719:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
6740:gcMsg: 
      .asciiz "\nGC!\n"
6746:gcCountMsg: 
      .asciiz "Number of garbage collections: "

6778:nullStr:
    .asciiz "null"
6783:trueString:
    .asciiz "true"
6788:falseString:
    .asciiz "false"
6794:exitString:
    .ascii "Program terminated."
    #### "falls through" here
6813:newlineString:
    .asciiz "\n"
    
    .align 2
6816:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

6820:seg0_start:
    .space 0x100000
1055396:seg0_end:
1055396:seg1_start:
    .space 0x100000
2103972:seg1_end:
