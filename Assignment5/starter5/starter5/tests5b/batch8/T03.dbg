    # moving additional objects
    #############################################################

    #########################################################
    # At this point:
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # We want to set things up so that in addition:
    # - $t0 is the "trailing finger", containing the address
    #   of the first slot in target space that we have yet
    #   to process.
    # Then during processing:
    # - $t1 will contain the contents of the heap slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # And when we're actually copying an object:
    # - $t2 will contain pointer to the target object
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - available for use: $s0
    ##########################################################

    # set $t0 to be at the beginning of target-space
3880#    lw $t1,cur_seg
3884#    la $t0,seg0_start
3888#    beq $t1,$zero,gcSkip4
3892#    la $t0,seg1_start
3893##...lui $t0,16
3897##...addiu $t0,$t0,5132


3900:  gcSkip4:

    # if there were no objects put into the heap during stack
    # processing, we're done, so go finish up
3900#    bgeu $t0,$s3,gcFinishUp
3901##...sltu $at,$t0,$s3
3905##...beq $at,$zero,4196

    ###### begin outer loop to copy all non-stack-direct objects ######

3908:  gcHeapCopyLoop:
    # get data count for object; swap header-word with first word
    # of object so that they're back in the right place
3908#    lw $t1,($t0) # (what will be) first header word for current object
3912#    move $t2,$t1 # number data bytes in object (poss. w/hash bits)
3916#    bge $t2,$zero,gcSkip4a # are there hash bits?
3917##...slt $at,$t2,$zero
3921##...beq $at,$zero,3936
3924#    and $t2,0xff # mask off hash bits
3925##...lui $at,0
3929##...ori $at,$at,0xff
3933##...and $t2,$t2,$at
3936:gcSkip4a:    
3936#    sll $t2,$t2,2 # # data bytes
3940#    addu $t2,$t2,8 # to skip header words
3944#    addu $t2,$t0,$t2 # pointer to new object
3948#    lw $t3,-8($t2) # word to swap
3952#    sw $t1,-8($t2) # store header word
3956#    sw $t3,($t0) # restore first word of object

    ################################################
    # at this point:
    # - $t2 contains the pointer to our new object
    ################################################

    # check if we have a data array
3960#    lw $t1,-12($t2) # vtable pointer
3964#    li $t0,dataArrayVTableStart # address of vtable for first data array
3968#    blt $t1,$t0,gcNotDataArray # if data array, no more xforming to do
3969##...slt $at,$t1,$t0
3973##...bne $at,$zero,3992

    # We have a vtable address that is a data array.
    # we need skip over it then loop back to do next object.
3976:  skipToNextObj:
3976#    lw $t1,-4($t2) # data words in (object position of) array
    #### note: we know that it's not a string, so the value will
    #### not be artificially negative
3980#    sll $t1,$t1,2 # convert to byte-count
3984#    addu $t0,$t2,$t1 # skip over object
3988#    j gcTestIterDone2 # go do next object, if any

    ###################################################
    # at this point:
    # - the object has been restored to normal status--that is, the
    #   word-swap has been done
    # - $t2 contains a pointer to the object
    ###################################################
    
3992:  gcNotDataArray:
3992#    lw $t3,-4($t2) # # object words (negative treated as zero)
3996#    bge $t3,$zero,gcH2Neg2
3997##...slt $at,$t3,$zero
4001##...beq $at,$zero,4008
4004#    move $t3,$zero
4008:  gcH2Neg2:
4008#    sll $t3,$t3,2 # # object bytes
4012#    move $t0,$t2 # address of first pointer in object
4016#    add $s1,$t2,$t3 # limit address for this object

    #####################################################
    # At this point, we have to "translate" all pointers,
    # starting at $t0 to (but not including) $s1
    #####################################################

    # if there are no pointer-slots (i.e., $t0=$s1), skip this
    # part
4020#    beq $t0,$s1,gcTestIterDone2
    
4024:  gcNextPointerInObject:
    # get pointer from object
4024#    lw $t1,($t0)

    # if value is out of range, and is therefore does not refer
    # to an object, just go loop back and do the next one
4028#    bleu $t1,$t6,gcGoNextPointerSlot
4029##...sltu $at,$t6,$t1
4033##...beq $at,$zero,4176
4036#    bgtu $t1,$t7,gcGoNextPointerSlot
4037##...sltu $at,$t7,$t1
4041##...bne $at,$zero,4176

    # if the object has already been moved, update the stack-value
    # via the forwarding pointer
4044#    lw $t8,-8($t1) # possible forwarding tag
4048#    bne $t8,$zero,gcNoForward2 # if not forwarding tag, go copy
4052#    lw $t8,-4($t1) # forwarding pointer: object's new address
4056#    sw $t8,($t0) # update pointer in object
4060#    j gcGoNextPointerSlot # do next iteration

4064:  gcNoForward2:
    #########################################################
    # we actually need to copy the object into the new space
    #########################################################

    #########################################################
    # At this point:
    # - $t0 contains the address of the heap-slot we're translating
    # - $t1 will contain the contents of the heap-slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space, which will also be the first address
    #   of the target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # Then during processing:
    # And when we're actually copying an object:
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $t8 will contain a pointer to the target object
    # - available for use: $s0, $t8, $t9
    ##########################################################

    # compute the amount of space that is needed
4064#    bge $t8,$zero,gcSkip5 # # words in negative-offset portion
4065##...slt $at,$t8,$zero
4069##...beq $at,$zero,4084
4072#    and $t8,0xff # mask off hash bits
4073##...lui $at,0
4077##...ori $at,$at,0xff
4081##...and $t8,$t8,$at

4084:  gcSkip5:
4084#    sll $t8,$t8,2 # bytes in negative-offset portion ...
4088#    addu $t8,$t8,8 # ... add in bytes for header-words
4092#    subu $t4,$t1,$t8 # address of first word of source object
4096#    lw $t3,-4($t1) # # words in positive-offset portion
4100#    bge $t3,$zero,gcNoNeg
4101##...slt $at,$t3,$zero
4105##...beq $at,$zero,4112
4108#    move $t3,$zero # negative treated as zero
4112:  gcNoNeg:
4112#    sll $t3,$t3,2 # bytes in negative-offset portion
4116#    addu $t3,$t3,$t1 # address one word past last word of source

4120#    addu $t8,$s3,$t8 # pointer to target object

    #########################################################
    # At this point:
    # - $t0 contains the address of the stack slot we'll
    #   process next
    # - $t1 contains the contents of the stack slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $t8 contains the pointer to the target object
    # - $s1 contains the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0, $t9
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger"
4124#    lw $s0,($t4)
4128#    lw $t9,-8($t1)
4132#    sw $t9,($t4)
4136#    sw $s0,-8($t1)

    # copy all source bytes to the target
4140:  gCinnerCopy2:
4140#    lw $s0,($t4)
4144#    sw $s0,($s3)
4148#    addu $t4,$t4,4
4152#    addu $s3,$s3,4
4156#    bltu $t4,$t3,gCinnerCopy2
4157##...sltu $at,$t4,$t3
4161##...bne $at,$zero,4140

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
4164#    sw $zero,-8($t1) # 0 in first header-slot
4168#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
4172#    sw $t8,($t0)

4176:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
4176#    addu $t0,$t0,4
4180#    bltu $t0,$s1,gcNextPointerInObject
4181##...sltu $at,$t0,$s1
4185##...bne $at,$zero,4024

4188:  gcTestIterDone2:
4188#    bltu $t0,$s3,gcHeapCopyLoop
4189##...sltu $at,$t0,$s3
4193##...bne $at,$zero,3908

    ###### end outer loop to copy all non-stack-direct objects ######

4196:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
4196#    lw $s2,($sp)
4200#    addu $sp,$sp,4

    # mark us as having already GC'd
4204#    move $t5,$s5

    # go try and allocate again
4208#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
4212:vm_init:

    # mark bottom of stack
4212#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
4216#    move $s2,$zero

    #set up the "five" register
4220#    li $s5,5

4224#    la $s3,seg0_start
4228#    la $s4,seg0_end
4229##...lui $s4,16
4233##...addiu $s4,$s4,5132
    
    # return
4236#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4240:divide:
    # get parameters; abort if divisor zero
4240#    lw $t0,($sp)
4244#    lw $t1,8($sp)
4248#    beq $t0,$zero,divByZeroError
    
    # perform division
4252#    div $t1,$t0
4256#    mflo $t0

    # store result, adjust stack and return
4260#    addu $sp,$sp,8 # adjust stack
4264#    sw $t0,($sp) # store result
4268#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4272:remainder:
    # get parameters; abort if divisor zero
4272#    lw $t0,($sp)
4276#    lw $t1,8($sp)
4280#    beq $t0,$zero,divByZeroError
    
    # perform division
4284#    div $t1,$t0
4288#    mfhi $t0

    # store result, adjust stack and return
4292#    addu $sp,$sp,8 # adjust stack
4296#    sw $t0,($sp) # store result
4300#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
4304:checkCast:
    # get object, allow immediately if null
4304#    lw $t2,($sp)
4308#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
4312#    lw $t2,-12($t2) # vtable address
4316#    bge $t2,$t1,castException
4317##...slt $at,$t2,$t1
4321##...beq $at,$zero,4492
4324#    blt $t2,$t0,castException
4325##...slt $at,$t2,$t0
4329##...bne $at,$zero,4492
    
    # return, leaving object unchanged on stack
4332:  checkCastReturn:    
4332#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
4336:instanceOf:
    # get object, go return false if null
4336#    lw $t2,($sp)
4340#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
4344#    lw $t2,-12($t2) # vtable address
4348#    sge $t0,$t2,$t0 # are we >= the lower limit?
4349##...slt $t0,$t2,$t0
4353##...xori $t0,$t0,0x1
4356#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
4360#    and $t2,$t0,$t1
4364#    sw $t2,($sp)
4368:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
4368#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

4372:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
4372#    li $v0,4 # syscall-code for print-string
4376#    syscall
4380:exit:
    # print termination message
4380#    li $v0,4 # syscall-code for print-string
4384#    la $a0,exitString
4388#    syscall

    # print number of garbage collections
4392#    li $v0,4 # syscall-code for print-string
4396#    la $a0,gcCountMsg
4400#    syscall # print "Number of ..."
4404#    lw $a0,gcCount # number of GC's
4408#    li $v0,1 # code for print-int
4412#    syscall
4416#    li $v0,4 # syscall-code for print-string
4420#    la $a0,newlineString
4424#    syscall # print newline

    # terminate execution
4428#    li $v0,10 #syscall-code for "exit"
4432#    syscall

4436:outOfHeapMemory:
4436#    la $a0,heapMemoryMsg
4440#    j exitError
4444:divByZeroError:
4444#    la $a0,divByZeroMsg
4448#    j exitError
4452:strIndexOutOfBounds:
4452#    la $a0,strIndexOutOfBoundsMsg
4456#    j exitError
4460:arrayIndexOutOfBounds:
4460#    la $a0,arrayIndexOutOfBoundsMsg
4464#    j exitError
4468:arraySizeOutOfBounds:
4468#    la $a0,arraySizeOutOfBoundsMsg
4472#    j exitError
4476:nullPtrException:
4476#    la $a0,nullPtrExceptionMsg
4480#    j exitError
4484:badIntegerFormat:
4484#    la $a0,badIntegerFormatMsg
4488#    j exitError
4492:castException:
4492#    la $a0,castExceptionMsg
4496#    j exitError
############## data section ################
    .data
4760:hexChars:
    .ascii "0123456789abcdef"
    .align 2
4776:cur_seg:
    .word 0

4780:lastCharRead:
    .word -2 # -2 => no buffered character
4784:prevHashConstant:
    .word 0x2785173c
4788:gcCount:
    .word 0

4792:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
4819:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
4842:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
4877:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
4911:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
4944:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
4975:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
5023:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
5044:gcMsg: 
      .asciiz "\nGC!\n"
5050:gcCountMsg: 
      .asciiz "Number of garbage collections: "

5082:nullStr:
    .asciiz "null"
5087:trueString:
    .asciiz "true"
5092:falseString:
    .asciiz "false"
5098:exitString:
    .ascii "Program execution completed."
    #### "falls through" here
5126:newlineString:
    .asciiz "\n"
    
    .align 2
5128:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

5132:seg0_start:
    .space 0x100000
1053708:seg0_end:
1053708:seg1_start:
    .space 0x100000
2102284:seg1_end:
