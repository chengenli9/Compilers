    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

1688#    beq $sp,$t1,rlReturn
1692:  charCopyLoop:
1692#    lw $t2,($sp)
1696#    sb $t2,-9($t0)
1700#    addu $sp,$sp,4
1704#    subu $t0,$t0,1
1708#    bne $sp,$t1,charCopyLoop
1712:  rlReturn:

1712#    lw $ra, 4($sp)
1716#    addu $sp, 8   # pop $ra and pointless word off stack
1720#    move $t0, $s7 # return string we allocated in $s7
1724#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
1728:mth_readInt_Lib:

    # save $ra by pushing onto stack
1728#    subu $sp,$sp,4
1732#    sw $ra,($sp)

1736:  riSkipWhiteLoop:
    # read a character
1736#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
1740#    subu $t0,$v0,32
1744#    bgt $t0,$zero,nonWhite
1745##...slt $at,$zero,$t0
1749##...bne $at,$zero,1792
1752#    beq $t0,$zero,riSkipWhiteLoop # start over if space
1756#    subu $t0,$v0,10
1760#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
1764#    subu $t0,$v0,9
1768#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
1772#    subu $t0,$v0,13
1776#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
1780#    subu $t0,$v0,12
1784#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
1788#    j badIntegerFormat # illegal integer char: abort program

1792:  nonWhite:
1792#    subu $t0,$v0,'-'
1796#    li $t4,1 # final multiplier
1800#    bne $t0,$zero,helpReadInt # go read
1804#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
1808#    jal readLogicalChar

1812:  helpReadInt:
1812#    li $t2,10
1816#    subu $t1,$v0,'0' # convert digit to 0-9 value
1820#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
1821##...sltu $at,$t1,$t2
1825##...beq $at,$zero,4108
1828#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

1832:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

1832#    jal readLogicalChar # read next character
1836#    subu $t1,$v0,'0' # convert digit to 0-9 value
1840#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
1841##...sltu $at,$t1,$t2
1845##...beq $at,$zero,1864

1848#    mul $t3,$t3,$t2 # multiply old value by 10
1849##...mult $t3,$t2
1853##...mflo $t3
1856#    addu $t3,$t3,$t1 # add in value of new digit
1860#    j digitLoop

1864:  doneDigitLoop:

    # "push back" unused character into queue
1864#    sw $v0,lastCharRead
