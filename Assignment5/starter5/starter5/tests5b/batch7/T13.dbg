3548#    sll $t1,$t1,2 # convert to byte-count
3552#    addu $t0,$t2,$t1 # skip over object
3556#    j gcTestIterDone2 # go do next object, if any

    ###################################################
    # at this point:
    # - the object has been restored to normal status--that is, the
    #   word-swap has been done
    # - $t2 contains a pointer to the object
    ###################################################
    
3560:  gcNotDataArray:
3560#    lw $t3,-4($t2) # # object words (negative treated as zero)
3564#    bge $t3,$zero,gcH2Neg2
3565##...slt $at,$t3,$zero
3569##...beq $at,$zero,3576
3572#    move $t3,$zero
3576:  gcH2Neg2:
3576#    sll $t3,$t3,2 # # object bytes
3580#    move $t0,$t2 # address of first pointer in object
3584#    add $s1,$t2,$t3 # limit address for this object

    #####################################################
    # At this point, we have to "translate" all pointers,
    # starting at $t0 to (but not including) $s1
    #####################################################

    # if there are no pointer-slots (i.e., $t0=$s1), skip this
    # part
3588#    beq $t0,$s1,gcTestIterDone2
    
3592:  gcNextPointerInObject:
    # get pointer from object
3592#    lw $t1,($t0)

    # if value is out of range, and is therefore does not refer
    # to an object, just go loop back and do the next one
3596#    bleu $t1,$t6,gcGoNextPointerSlot
3597##...sltu $at,$t6,$t1
3601##...beq $at,$zero,3744
3604#    bgtu $t1,$t7,gcGoNextPointerSlot
3605##...sltu $at,$t7,$t1
3609##...bne $at,$zero,3744

    # if the object has already been moved, update the stack-value
    # via the forwarding pointer
3612#    lw $t8,-8($t1) # possible forwarding tag
3616#    bne $t8,$zero,gcNoForward2 # if not forwarding tag, go copy
3620#    lw $t8,-4($t1) # forwarding pointer: object's new address
3624#    sw $t8,($t0) # update pointer in object
3628#    j gcGoNextPointerSlot # do next iteration

3632:  gcNoForward2:
    #########################################################
    # we actually need to copy the object into the new space
    #########################################################

    #########################################################
    # At this point:
    # - $t0 contains the address of the heap-slot we're translating
    # - $t1 will contain the contents of the heap-slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space, which will also be the first address
    #   of the target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # Then during processing:
    # And when we're actually copying an object:
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $t8 will contain a pointer to the target object
    # - available for use: $s0, $t8, $t9
    ##########################################################

    # compute the amount of space that is needed
3632#    bge $t8,$zero,gcSkip5 # # words in negative-offset portion
3633##...slt $at,$t8,$zero
3637##...beq $at,$zero,3652
3640#    and $t8,0xff # mask off hash bits
3641##...lui $at,0
3645##...ori $at,$at,0xff
3649##...and $t8,$t8,$at

3652:  gcSkip5:
3652#    sll $t8,$t8,2 # bytes in negative-offset portion ...
3656#    addu $t8,$t8,8 # ... add in bytes for header-words
3660#    subu $t4,$t1,$t8 # address of first word of source object
3664#    lw $t3,-4($t1) # # words in positive-offset portion
3668#    bge $t3,$zero,gcNoNeg
3669##...slt $at,$t3,$zero
3673##...beq $at,$zero,3680
3676#    move $t3,$zero # negative treated as zero
3680:  gcNoNeg:
3680#    sll $t3,$t3,2 # bytes in negative-offset portion
3684#    addu $t3,$t3,$t1 # address one word past last word of source

3688#    addu $t8,$s3,$t8 # pointer to target object

    #########################################################
    # At this point:
    # - $t0 contains the address of the stack slot we'll
    #   process next
    # - $t1 contains the contents of the stack slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $t8 contains the pointer to the target object
    # - $s1 contains the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0, $t9
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger"
3692#    lw $s0,($t4)
3696#    lw $t9,-8($t1)
3700#    sw $t9,($t4)
3704#    sw $s0,-8($t1)

    # copy all source bytes to the target
3708:  gCinnerCopy2:
3708#    lw $s0,($t4)
3712#    sw $s0,($s3)
3716#    addu $t4,$t4,4
3720#    addu $s3,$s3,4
3724#    bltu $t4,$t3,gCinnerCopy2
3725##...sltu $at,$t4,$t3
3729##...bne $at,$zero,3708

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
3732#    sw $zero,-8($t1) # 0 in first header-slot
3736#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
3740#    sw $t8,($t0)

3744:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
3744#    addu $t0,$t0,4
3748#    bltu $t0,$s1,gcNextPointerInObject
3749##...sltu $at,$t0,$s1
3753##...bne $at,$zero,3592

3756:  gcTestIterDone2:
3756#    bltu $t0,$s3,gcHeapCopyLoop
3757##...sltu $at,$t0,$s3
3761##...bne $at,$zero,3476

    ###### end outer loop to copy all non-stack-direct objects ######

3764:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
3764#    lw $s2,($sp)
3768#    addu $sp,$sp,4

    # mark us as having already GC'd
3772#    move $t5,$s5

    # go try and allocate again
3776#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
3780:vm_init:

    # mark bottom of stack
3780#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
3784#    move $s2,$zero

    #set up the "five" register
3788#    li $s5,5

3792#    la $s3,seg0_start
3796#    la $s4,seg0_end
3797##...lui $s4,16
3801##...addiu $s4,$s4,4724
    
    # return
3804#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3808:divide:
    # get parameters; abort if divisor zero
3808#    lw $t0,($sp)
3812#    lw $t1,8($sp)
3816#    beq $t0,$zero,divByZeroError
    
    # perform division
3820#    div $t1,$t0
3824#    mflo $t0

    # store result, adjust stack and return
3828#    addu $sp,$sp,8 # adjust stack
3832#    sw $t0,($sp) # store result
3836#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3840:remainder:
    # get parameters; abort if divisor zero
3840#    lw $t0,($sp)
3844#    lw $t1,8($sp)
3848#    beq $t0,$zero,divByZeroError
    
    # perform division
3852#    div $t1,$t0
3856#    mfhi $t0

    # store result, adjust stack and return
3860#    addu $sp,$sp,8 # adjust stack
3864#    sw $t0,($sp) # store result
3868#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
3872:checkCast:
    # get object, allow immediately if null
3872#    lw $t2,($sp)
3876#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
3880#    lw $t2,-12($t2) # vtable address
3884#    bge $t2,$t1,castException
3885##...slt $at,$t2,$t1
3889##...beq $at,$zero,4024
3892#    blt $t2,$t0,castException
3893##...slt $at,$t2,$t0
3897##...bne $at,$zero,4024
    
    # return, leaving object unchanged on stack
3900:  checkCastReturn:    
3900#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
3904:instanceOf:
    # get object, go return false if null
3904#    lw $t2,($sp)
3908#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
3912#    lw $t2,-12($t2) # vtable address
3916#    sge $t0,$t2,$t0 # are we >= the lower limit?
3917##...slt $t0,$t2,$t0
3921##...xori $t0,$t0,0x1
3924#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
3928#    and $t2,$t0,$t1
3932#    sw $t2,($sp)
3936:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
3936#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

3940:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
3940#    li $v0,4 # syscall-code for print-string
3944#    syscall
3948:exit:
    # print termination message
3948#    li $v0,4 # syscall-code for print-string
3952#    la $a0,exitString
3956#    syscall

    # terminate execution
3960#    li $v0,10 #syscall-code for "exit"
3964#    syscall

3968:outOfHeapMemory:
3968#    la $a0,heapMemoryMsg
3972#    j exitError
3976:divByZeroError:
3976#    la $a0,divByZeroMsg
3980#    j exitError
3984:strIndexOutOfBounds:
3984#    la $a0,strIndexOutOfBoundsMsg
3988#    j exitError
3992:arrayIndexOutOfBounds:
3992#    la $a0,arrayIndexOutOfBoundsMsg
3996#    j exitError
4000:arraySizeOutOfBounds:
4000#    la $a0,arraySizeOutOfBoundsMsg
4004#    j exitError
4008:nullPtrException:
4008#    la $a0,nullPtrExceptionMsg
4012#    j exitError
4016:badIntegerFormat:
4016#    la $a0,badIntegerFormatMsg
4020#    j exitError
4024:castException:
4024#    la $a0,castExceptionMsg
4028#    j exitError
############## data section ################
    .data
4360:hexChars:
    .ascii "0123456789abcdef"
    .align 2
4376:cur_seg:
    .word 0

4380:lastCharRead:
    .word -2 # -2 => no buffered character
4384:prevHashConstant:
    .word 0x2785173c
4388:gcCount:
    .word 0

4392:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
4419:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
