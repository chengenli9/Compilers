########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
3208:vm_init:

    # mark bottom of stack
3208#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
3212#    move $s2,$zero

    #set up the "five" register
3216#    li $s5,5

3220#    la $s3,seg0_start
3224#    la $s4,seg0_end
3225##...lui $s4,16
3229##...addiu $s4,$s4,4056
    
    # return
3232#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3236:divide:
    # get parameters; abort if divisor zero
3236#    lw $t0,($sp)
3240#    lw $t1,8($sp)
3244#    beq $t0,$zero,divByZeroError
    
    # perform division
3248#    div $t1,$t0
3252#    mflo $t0

    # store result, adjust stack and return
3256#    addu $sp,$sp,8 # adjust stack
3260#    sw $t0,($sp) # store result
3264#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3268:remainder:
    # get parameters; abort if divisor zero
3268#    lw $t0,($sp)
3272#    lw $t1,8($sp)
3276#    beq $t0,$zero,divByZeroError
    
    # perform division
3280#    div $t1,$t0
3284#    mfhi $t0

    # store result, adjust stack and return
3288#    addu $sp,$sp,8 # adjust stack
3292#    sw $t0,($sp) # store result
3296#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
3300:checkCast:
    # get object, allow immediately if null
3300#    lw $t2,($sp)
3304#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
3308#    lw $t2,-12($t2) # vtable address
3312#    bge $t2,$t1,castException
3313##...slt $at,$t2,$t1
3317##...beq $at,$zero,3452
3320#    blt $t2,$t0,castException
3321##...slt $at,$t2,$t0
3325##...bne $at,$zero,3452
    
    # return, leaving object unchanged on stack
3328:  checkCastReturn:    
3328#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
3332:instanceOf:
    # get object, go return false if null
3332#    lw $t2,($sp)
3336#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
3340#    lw $t2,-12($t2) # vtable address
3344#    sge $t0,$t2,$t0 # are we >= the lower limit?
3345##...slt $t0,$t2,$t0
3349##...xori $t0,$t0,0x1
3352#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
3356#    and $t2,$t0,$t1
3360#    sw $t2,($sp)
3364:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
3364#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

3368:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
3368#    li $v0,4 # syscall-code for print-string
3372#    syscall
3376:exit:
    # print termination message
3376#    li $v0,4 # syscall-code for print-string
3380#    la $a0,exitString
3384#    syscall

    # terminate execution
3388#    li $v0,10 #syscall-code for "exit"
3392#    syscall

3396:outOfHeapMemory:
3396#    la $a0,heapMemoryMsg
3400#    j exitError
3404:divByZeroError:
3404#    la $a0,divByZeroMsg
3408#    j exitError
3412:strIndexOutOfBounds:
3412#    la $a0,strIndexOutOfBoundsMsg
3416#    j exitError
3420:arrayIndexOutOfBounds:
3420#    la $a0,arrayIndexOutOfBoundsMsg
3424#    j exitError
3428:arraySizeOutOfBounds:
3428#    la $a0,arraySizeOutOfBoundsMsg
3432#    j exitError
3436:nullPtrException:
3436#    la $a0,nullPtrExceptionMsg
3440#    j exitError
3444:badIntegerFormat:
3444#    la $a0,badIntegerFormatMsg
3448#    j exitError
3452:castException:
3452#    la $a0,castExceptionMsg
3456#    j exitError
############## data section ################
    .data
