###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
1108:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
1108#    subu $sp,4
1112#    sw $ra,($sp)
    
    # get hash value
1116#    lw $t2,-12($s2) # vtable address
1120#    lw $t0,($t2) # method address
1124#    jalr $t0
1128#    subu $sp,8 # push result (int in $t0) on stack
1132#    sw $s5,4($sp)
1136#    sw $t0,($sp)

    # compute print-size of hash value
1140#    li $t0, 1
1144#    lw $t1, ($sp)
1148#    srl $t1,$t1,4
1152#    beq $t1,$zero,toString_skip_loop
1156:toString_loop_top:
1156#    addu $t0,1
1160#    srl $t1,$t1,4
1164#    bne $t1,$zero,toString_loop_top
1168:toString_skip_loop:
1168#    subu $sp,8
1172#    sw $s5,4($sp)
1176#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
1180#    lw $t2,-12($s2) # vtable address
1184#    move $t0,$t2
1188:toString_checkTagBit:
1188#    subu $t0,1
1192#    lb $t1,($t0)
1196#    and $t1,0x80
1197##...lui $at,0
1201##...ori $at,$at,0x80
1205##...and $t1,$t1,$at
1208#    beq $t1,$zero,toString_checkTagBit
1212#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
1216#    subu $sp,8
1220#    sw $t1,($sp)
1224#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
1228#    move $s7,$zero # -4 offset header word
1232#    lw $t4,8($sp) # bytes for hash value
1236#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
1240#    addu $t4,8
1244#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
1248#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

1252#    li $t0,CLASS_String # store string vtable address into ...
1256#    sw $t0,-12($s7) # ... -12 offset in object header
1260#    lw $t2,-12($s2) # our object's vtable address
1264#    lw $t5,4($sp) # number characters in prefix
1268#    lw $t1,12($sp) # number of characters in hashcode
1272#    addu $t3,$t1,$t5 # number of characters in string ...
1276#    addu $t3,1 # ... including the '@' character
1280#    subu $t0,$zero,$t3 # store negated length into ...
1284#    sw $t0,-4($s7) # ... -4 offset header word
1288#    lw $t0,-8($s7) # get -8 offset header-word
1292#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
1293##...slt $at,$t0,$zero
1297##...beq $at,$zero,1316
1300#    and $t0,0xff # mask off object's hash value ...
1301##...lui $at,0
1305##...ori $at,$at,0xff
1309##...and $t0,$t0,$at
1312#    sw $t0,-8($s7) # ... and store back into -8 header-word
1316:skipMask_toString:
1316#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
1320#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
1324#    subu $t4,$t2,$t5
1328:toString_copyLoop:    
1328#    lb $t3,($t4)
1332#    and $t3,0x7f # mask off sign bit (in case first word)
1333##...lui $at,0
1337##...ori $at,$at,0x7f
1341##...and $t3,$t3,$at
1344#    sb $t3,-8($t0)
1348#    addu $t4,1
1352#    addu $t0,1
1356#    blt $t4,$t2,toString_copyLoop
1357##...slt $at,$t4,$t2
1361##...bne $at,$zero,1328

    # copy the '@' sign
1364#    li $t3,'@'
1368#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
1372#    addu $t2,$t0,$t1 # address of last byte in string to store +8
1376#    lw $t3,20($sp) # hash code to print
1380:toString_hashCopyLoop:
1380#    and $t4,$t3,0xf
1384#    srl $t3,4
1388#    lb $t4,hexChars($t4)
1392#    sb $t4,-8($t2)
1396#    subu $t2,$t2,1
1400#    bgt $t2,$t0,toString_hashCopyLoop
1401##...slt $at,$t0,$t2
1405##...bne $at,$zero,1380

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
1408#    addu $sp,28
1412#    lw $ra,($sp)
1416#    addu $sp,4
1420#    move $t0, $s7 # return string we created
1424#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
1428:mth_equals_String:
    
    # quick test for obvious false
1428#    lw $t0,($sp) # second parameter
1432#    beq $t0,$zero,goEsFalse # go return false if null
1436#    lw $t1,-12($t0) # vtable pointer
1440#    la $t2,CLASS_String # string vtable pointer
1444#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
1448#    subu $sp,12
1452#    sw $ra,8($sp)
1456#    sw $s2,4($sp)
1460#    sw $t0,($sp)
1464#    jal mth_compareTo_String
1468#    lw $s2, 4($sp) #restore this pointer and pop parameters
1472#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
1476#    seq $t0,$t0,$zero
1477##...subu $at,$t0,$zero
1481##...sltiu $t0,$at,1

    # pop return address and return $t0
1484#    lw $ra,($sp)
1488#    addu $sp,4

1492#    jr $ra # return
    
1496:goEsFalse:
    # put 0 in $t0 and return
1496#    li $t0, 0
1500#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
