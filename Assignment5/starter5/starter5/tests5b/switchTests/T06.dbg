########################################################
# readLogicalChar (millicode)
#  - logically reads a character from standard input
#  - first checks character buffer, consuming it if possible
#  - return-result:
#    - returns character in $v0
#  - side-effects:
#    - reads a character
#    - clobbers $t0
########################################################
3244:readLogicalChar:

    # check if we already have a character
3244#    lw $v0,lastCharRead
3248#    li $t0,-2
3252#    beq $t0,$v0 doReadCh

    # we have our character from the buffer. Wipe out
    # buffer and return
3256#    sw $t0,lastCharRead # store -2 into buffer (i.e. "empty")
3260#    jr $ra # return
    
3264:  doReadCh:
    # we need to actually read a character: read and return
3264#    li $v0,12 # use system call to read a character
3268#    syscall
3272#    jr $ra # return
