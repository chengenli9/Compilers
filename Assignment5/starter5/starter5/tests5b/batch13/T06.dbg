1181##...slt $at,$t0,$zero
1185##...beq $at,$zero,1204
1188#    and $t0,0xff # mask off object's hash value ...
1189##...lui $at,0
1193##...ori $at,$at,0xff
1197##...and $t0,$t0,$at
1200#    sw $t0,-8($s7) # ... and store back into -8 header-word
1204:skipMask_toString:
1204#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
1208#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
1212#    subu $t4,$t2,$t5
1216:toString_copyLoop:    
1216#    lb $t3,($t4)
1220#    and $t3,0x7f # mask off sign bit (in case first word)
1221##...lui $at,0
1225##...ori $at,$at,0x7f
1229##...and $t3,$t3,$at
1232#    sb $t3,-8($t0)
1236#    addu $t4,1
1240#    addu $t0,1
1244#    blt $t4,$t2,toString_copyLoop
1245##...slt $at,$t4,$t2
1249##...bne $at,$zero,1216

    # copy the '@' sign
1252#    li $t3,'@'
1256#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
1260#    addu $t2,$t0,$t1 # address of last byte in string to store +8
1264#    lw $t3,20($sp) # hash code to print
1268:toString_hashCopyLoop:
1268#    and $t4,$t3,0xf
1272#    srl $t3,4
1276#    lb $t4,hexChars($t4)
1280#    sb $t4,-8($t2)
1284#    subu $t2,$t2,1
1288#    bgt $t2,$t0,toString_hashCopyLoop
1289##...slt $at,$t0,$t2
1293##...bne $at,$zero,1268

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
1296#    addu $sp,28
1300#    lw $ra,($sp)
1304#    addu $sp,4
1308#    move $t0, $s7 # return string we created
1312#    jr $ra
