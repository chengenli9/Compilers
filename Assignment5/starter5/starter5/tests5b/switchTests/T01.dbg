1208#    subu $t0,$t0,1
1212#    bne $sp,$t1,charCopyLoop
1216:  rlReturn:

1216#    lw $ra, 4($sp)
1220#    addu $sp, 8   # pop $ra and pointless word off stack
1224#    move $t0, $s7 # return string we allocated in $s7
1228#    jr $ra
