4360#  sw $t0, 0($sp)
4364#  j while_cond_239
4368:break_target_239:
4368#  addu $sp, $sp, 8
4372#  addu $sp, $sp, 4
4376#  lw $ra, ($sp)
4380#  addu $sp, $sp, 4
4384#  jr $ra
##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
4388:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
4388#    lw $t0,-8($s2) # get word with hash bits from this
4392#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
4396#    addu $t0,$t1

4400#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
4404:mth_equals_Object:
4404#    move $t0,$s2 # first pointer (this)
4408#    lw $t1,($sp) # second pointer
4412#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
4413##...subu $at,$t0,$t1
4417##...sltiu $t0,$at,1

4420#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
4424:mth_hashCode_String:
4424#    move $t0,$s2 # put this pointer in t0

4428#    li $t2,0 # current hash value
4432#    lw $t1,-4($t0) # negative of number of characters in string
4436#    beq $t1,$zero,done_hashCode_String # if zero length => done
4440#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
4444#    and $t0,0xfffffffc # adjust for padding
4445##...lui $at,65535
4449##...ori $at,$at,0xfffc
4453##...and $t0,$t0,$at
4456#    subu $t1,$t0,$t1 # address at end of string +12
4460:loop_hashCode_String:    
4460#    sll $t4,$t2,5 # multiply by 32
4464#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
4468#    lbu $t3,-12($t0) # current character
4472#    addu $t2,$t3 # add in current character
4476#    addu $t0,1 # go to next character's address
4480#    bne $t0,$t1,loop_hashCode_String # loop back if more
4484:done_hashCode_String:    

    # push int on stack
4484#    move $t0, $t2 # put $t2 in return slot
4488#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
4492:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
4492#    subu $sp,4
4496#    sw $ra,($sp)
    
    # get hash value
4500#    lw $t2,-12($s2) # vtable address
4504#    lw $t0,($t2) # method address
4508#    jalr $t0
4512#    subu $sp,8 # push result (int in $t0) on stack
4516#    sw $s5,4($sp)
4520#    sw $t0,($sp)

    # compute print-size of hash value
4524#    li $t0, 1
4528#    lw $t1, ($sp)
4532#    srl $t1,$t1,4
4536#    beq $t1,$zero,toString_skip_loop
4540:toString_loop_top:
4540#    addu $t0,1
4544#    srl $t1,$t1,4
4548#    bne $t1,$zero,toString_loop_top
4552:toString_skip_loop:
4552#    subu $sp,8
4556#    sw $s5,4($sp)
4560#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
4564#    lw $t2,-12($s2) # vtable address
4568#    move $t0,$t2
4572:toString_checkTagBit:
4572#    subu $t0,1
4576#    lb $t1,($t0)
4580#    and $t1,0x80
4581##...lui $at,0
4585##...ori $at,$at,0x80
4589##...and $t1,$t1,$at
4592#    beq $t1,$zero,toString_checkTagBit
4596#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
4600#    subu $sp,8
4604#    sw $t1,($sp)
4608#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
4612#    move $s7,$zero # -4 offset header word
4616#    lw $t4,8($sp) # bytes for hash value
4620#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
4624#    addu $t4,8
4628#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
4632#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

4636#    li $t0,CLASS_String # store string vtable address into ...
4640#    sw $t0,-12($s7) # ... -12 offset in object header
4644#    lw $t2,-12($s2) # our object's vtable address
4648#    lw $t5,4($sp) # number characters in prefix
4652#    lw $t1,12($sp) # number of characters in hashcode
4656#    addu $t3,$t1,$t5 # number of characters in string ...
4660#    addu $t3,1 # ... including the '@' character
4664#    subu $t0,$zero,$t3 # store negated length into ...
4668#    sw $t0,-4($s7) # ... -4 offset header word
4672#    lw $t0,-8($s7) # get -8 offset header-word
4676#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
4677##...slt $at,$t0,$zero
4681##...beq $at,$zero,4700
4684#    and $t0,0xff # mask off object's hash value ...
4685##...lui $at,0
4689##...ori $at,$at,0xff
4693##...and $t0,$t0,$at
4696#    sw $t0,-8($s7) # ... and store back into -8 header-word
4700:skipMask_toString:
4700#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
4704#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
4708#    subu $t4,$t2,$t5
4712:toString_copyLoop:    
4712#    lb $t3,($t4)
4716#    and $t3,0x7f # mask off sign bit (in case first word)
4717##...lui $at,0
4721##...ori $at,$at,0x7f
4725##...and $t3,$t3,$at
4728#    sb $t3,-8($t0)
4732#    addu $t4,1
4736#    addu $t0,1
4740#    blt $t4,$t2,toString_copyLoop
4741##...slt $at,$t4,$t2
4745##...bne $at,$zero,4712

    # copy the '@' sign
4748#    li $t3,'@'
4752#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
4756#    addu $t2,$t0,$t1 # address of last byte in string to store +8
4760#    lw $t3,20($sp) # hash code to print
4764:toString_hashCopyLoop:
4764#    and $t4,$t3,0xf
4768#    srl $t3,4
4772#    lb $t4,hexChars($t4)
4776#    sb $t4,-8($t2)
4780#    subu $t2,$t2,1
4784#    bgt $t2,$t0,toString_hashCopyLoop
4785##...slt $at,$t0,$t2
4789##...bne $at,$zero,4764

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
4792#    addu $sp,28
4796#    lw $ra,($sp)
4800#    addu $sp,4
4804#    move $t0, $s7 # return string we created
4808#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
4812:mth_equals_String:
    
    # quick test for obvious false
4812#    lw $t0,($sp) # second parameter
4816#    beq $t0,$zero,goEsFalse # go return false if null
4820#    lw $t1,-12($t0) # vtable pointer
4824#    la $t2,CLASS_String # string vtable pointer
4828#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
4832#    subu $sp,12
4836#    sw $ra,8($sp)
4840#    sw $s2,4($sp)
4844#    sw $t0,($sp)
4848#    jal mth_compareTo_String
4852#    lw $s2, 4($sp) #restore this pointer and pop parameters
4856#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
4860#    seq $t0,$t0,$zero
4861##...subu $at,$t0,$zero
4865##...sltiu $t0,$at,1

    # pop return address and return $t0
4868#    lw $ra,($sp)
4872#    addu $sp,4

4876#    jr $ra # return
    
4880:goEsFalse:
    # put 0 in $t0 and return
4880#    li $t0, 0
4884#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
4888:mth_toString_String:
    #we are a string, so return this.
4888#    move $t0, $s2
4892#    jr $ra

###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
4896:mth_readLine_Lib:
    
4896#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
4900#    sw $ra, 4($sp) # save $ra
4904#    move $t1,$sp # save "original" sp

4908:  doRead:

    # read the character
4908#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
4912#    subu $t2,$v0,13
4916#    bne $t2,$zero,notReturnRL
4920#    jal readLogicalChar
4924#    subu $t2,$v0,10 # check for newline
4928#    beq $t2,$zero,foundNewLine
4932#    sw $v0,lastCharRead # push back character into queue
4936#    j foundNewLine # go process the line

4940:  notReturnRL:

    # at this point, $v0 has our character

4940#    subu $t0,$v0,10
4944#    beq $t0,$zero,foundNewLine
4948#    blt $v0,$zero,foundEof
4949##...slt $at,$v0,$zero
4953##...bne $at,$zero,4968

    # we have a character, so push it onto stack
4956#    subu $sp,$sp,4
4960#    sw $v0,($sp)

    # loop back up to get next character
4964#    j doRead

4968:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
4968#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
4972#    li $s7, 0 # return-value: null
4976#    j rlReturn # return

4980:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
4980#    subu $t0,$t1,$sp # number of chars we read (times 4)
4984#    srl $s6,$t0,2 # number of words on stack with chars
4988#    subu $sp,$sp,4 # push char-count ...
4992#    sw $s6,($sp) # ... onto stack
4996#    addu $t2,$t0,5 # GC tag, incl. for count-word
5000#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
5004#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
5008#    srl $s6,$s6,2  # data words in object
5012#    move $s7,$zero # object words in object
5016#    jal newObject  # allocate space
    
    # store header words
5020#    la $t0,CLASS_String
5024#    sw $t0,-12($s7)# store class tag (String) into object
5028#    lw $t2,4($sp) # char-count
5032#    sll $t1,$t2,2 # 4 times number of chars
5036#    subu $t2,$zero,$t2 # negative of char-count
5040#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
5044#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
5048#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
5049##...slt $at,$t0,$zero
5053##...beq $at,$zero,5072
5056#    and $t0,0xff # mask off object's hash value ...
5057##...lui $at,0
5061##...ori $at,$at,0xff
5065##...and $t0,$t0,$at
5068#    sw $t0,-8($s7) # ... and store back into -8 header-word
5072:  skipMask_readLine:

5072#    sll $t0,$t0,2 # data bytes in object
5076#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
5080#    subu $t0,$t0,$t2 # place to store last character (plus 9)
5084#    addu $sp,$sp,8 # pop redundant object-pointer and count
5088#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

5092#    beq $sp,$t1,rlReturn
5096:  charCopyLoop:
5096#    lw $t2,($sp)
5100#    sb $t2,-9($t0)
5104#    addu $sp,$sp,4
5108#    subu $t0,$t0,1
5112#    bne $sp,$t1,charCopyLoop
5116:  rlReturn:

5116#    lw $ra, 4($sp)
5120#    addu $sp, 8   # pop $ra and pointless word off stack
5124#    move $t0, $s7 # return string we allocated in $s7
5128#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
5132:mth_readInt_Lib:

    # save $ra by pushing onto stack
5132#    subu $sp,$sp,4
5136#    sw $ra,($sp)

5140:  riSkipWhiteLoop:
    # read a character
5140#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
5144#    subu $t0,$v0,32
5148#    bgt $t0,$zero,nonWhite
5149##...slt $at,$zero,$t0
5153##...bne $at,$zero,5196
5156#    beq $t0,$zero,riSkipWhiteLoop # start over if space
5160#    subu $t0,$v0,10
5164#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
5168#    subu $t0,$v0,9
5172#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
5176#    subu $t0,$v0,13
5180#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
5184#    subu $t0,$v0,12
5188#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
5192#    j badIntegerFormat # illegal integer char: abort program

5196:  nonWhite:
5196#    subu $t0,$v0,'-'
5200#    li $t4,1 # final multiplier
5204#    bne $t0,$zero,helpReadInt # go read
5208#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
5212#    jal readLogicalChar

5216:  helpReadInt:
5216#    li $t2,10
5220#    subu $t1,$v0,'0' # convert digit to 0-9 value
5224#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
5225##...sltu $at,$t1,$t2
5229##...beq $at,$zero,7476
5232#    move $t3,$t1 #

