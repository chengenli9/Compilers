    # buffer and return
7576#    sw $t0,lastCharRead # store -2 into buffer (i.e. "empty")
7580#    jr $ra # return
    
7584:  doReadCh:
    # we need to actually read a character: read and return
7584#    li $v0,12 # use system call to read a character
7588#    syscall
7592#    jr $ra # return
