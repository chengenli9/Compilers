########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
4480:vm_init:

    # mark bottom of stack
4480#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
4484#    move $s2,$zero

    #set up the "five" register
4488#    li $s5,5

4492#    la $s3,seg0_start
4496#    la $s4,seg0_end
4497##...lui $s4,16
4501##...addiu $s4,$s4,5460
    
    # return
4504#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4508:divide:
    # get parameters; abort if divisor zero
4508#    lw $t0,($sp)
4512#    lw $t1,8($sp)
4516#    beq $t0,$zero,divByZeroError
    
    # perform division
4520#    div $t1,$t0
4524#    mflo $t0

    # store result, adjust stack and return
4528#    addu $sp,$sp,8 # adjust stack
4532#    sw $t0,($sp) # store result
4536#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4540:remainder:
    # get parameters; abort if divisor zero
4540#    lw $t0,($sp)
4544#    lw $t1,8($sp)
4548#    beq $t0,$zero,divByZeroError
    
    # perform division
4552#    div $t1,$t0
4556#    mfhi $t0

    # store result, adjust stack and return
4560#    addu $sp,$sp,8 # adjust stack
4564#    sw $t0,($sp) # store result
4568#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
