3829##...addiu $at,$at,-28718
3833##...addu $t1,$at,$t1
3836#    sw $t1,prevHashConstant # update hash constant
3840#    or $t1,0x80000000 # set top bit
3841##...lui $at,32768
3845##...or $t1,$at,$t1
3848#    and $t1,0xffffff00 # clear low bit
3849##...lui $at,65535
3853##...ori $at,$at,0xff00
3857##...and $t1,$t1,$at
3860#    or $s6,$t1
3864:firstHeaderLarge:
3864#    sw $s6,-8($t0) # store header-1 value
3868#    lw $zero,-8($t0)

    # store second header-value
3872#    sw $s7,-4($t0)   # second header-word
3876#    lw $zero,-4($t0)
    
    # put return-value into $s7 and also push it onto top of stack
3880#    move $s7,$t0
3884#    subu $sp,$sp,4
3888#    sw $t0,($sp)
