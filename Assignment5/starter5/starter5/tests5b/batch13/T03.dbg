    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

832#    li $t0,CLASS_String # store string vtable address into ...
836#    sw $t0,-12($s7) # ... -12 offset in object header
840#    lw $t2,-12($s2) # our object's vtable address
844#    lw $t5,4($sp) # number characters in prefix
848#    lw $t1,12($sp) # number of characters in hashcode
852#    addu $t3,$t1,$t5 # number of characters in string ...
856#    addu $t3,1 # ... including the '@' character
860#    subu $t0,$zero,$t3 # store negated length into ...
864#    sw $t0,-4($s7) # ... -4 offset header word
868#    lw $t0,-8($s7) # get -8 offset header-word
