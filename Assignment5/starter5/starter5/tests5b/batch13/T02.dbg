##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1396:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
1396#    lw $t0,-8($s2) # get word with hash bits from this
1400#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
1404#    addu $t0,$t1

1408#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1412:mth_equals_Object:
1412#    move $t0,$s2 # first pointer (this)
1416#    lw $t1,($sp) # second pointer
1420#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
1421##...subu $at,$t0,$t1
1425##...sltiu $t0,$at,1

1428#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1432:mth_hashCode_String:
1432#    move $t0,$s2 # put this pointer in t0

1436#    li $t2,0 # current hash value
1440#    lw $t1,-4($t0) # negative of number of characters in string
1444#    beq $t1,$zero,done_hashCode_String # if zero length => done
1448#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
1452#    and $t0,0xfffffffc # adjust for padding
1453##...lui $at,65535
1457##...ori $at,$at,0xfffc
1461##...and $t0,$t0,$at
1464#    subu $t1,$t0,$t1 # address at end of string +12
1468:loop_hashCode_String:    
1468#    sll $t4,$t2,5 # multiply by 32
1472#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
1476#    lbu $t3,-12($t0) # current character
1480#    addu $t2,$t3 # add in current character
1484#    addu $t0,1 # go to next character's address
1488#    bne $t0,$t1,loop_hashCode_String # loop back if more
1492:done_hashCode_String:    

    # push int on stack
1492#    move $t0, $t2 # put $t2 in return slot
1496#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
1500:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
1500#    subu $sp,4
1504#    sw $ra,($sp)
    
    # get hash value
1508#    lw $t2,-12($s2) # vtable address
1512#    lw $t0,($t2) # method address
1516#    jalr $t0
1520#    subu $sp,8 # push result (int in $t0) on stack
1524#    sw $s5,4($sp)
1528#    sw $t0,($sp)

    # compute print-size of hash value
1532#    li $t0, 1
1536#    lw $t1, ($sp)
1540#    srl $t1,$t1,4
1544#    beq $t1,$zero,toString_skip_loop
1548:toString_loop_top:
1548#    addu $t0,1
1552#    srl $t1,$t1,4
1556#    bne $t1,$zero,toString_loop_top
1560:toString_skip_loop:
1560#    subu $sp,8
1564#    sw $s5,4($sp)
1568#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
1572#    lw $t2,-12($s2) # vtable address
1576#    move $t0,$t2
1580:toString_checkTagBit:
1580#    subu $t0,1
1584#    lb $t1,($t0)
1588#    and $t1,0x80
1589##...lui $at,0
1593##...ori $at,$at,0x80
1597##...and $t1,$t1,$at
1600#    beq $t1,$zero,toString_checkTagBit
1604#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
1608#    subu $sp,8
1612#    sw $t1,($sp)
1616#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
1620#    move $s7,$zero # -4 offset header word
1624#    lw $t4,8($sp) # bytes for hash value
1628#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
1632#    addu $t4,8
1636#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
1640#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

1644#    li $t0,CLASS_String # store string vtable address into ...
1648#    sw $t0,-12($s7) # ... -12 offset in object header
1652#    lw $t2,-12($s2) # our object's vtable address
1656#    lw $t5,4($sp) # number characters in prefix
1660#    lw $t1,12($sp) # number of characters in hashcode
1664#    addu $t3,$t1,$t5 # number of characters in string ...
1668#    addu $t3,1 # ... including the '@' character
1672#    subu $t0,$zero,$t3 # store negated length into ...
1676#    sw $t0,-4($s7) # ... -4 offset header word
1680#    lw $t0,-8($s7) # get -8 offset header-word
1684#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
1685##...slt $at,$t0,$zero
1689##...beq $at,$zero,1708
1692#    and $t0,0xff # mask off object's hash value ...
1693##...lui $at,0
1697##...ori $at,$at,0xff
1701##...and $t0,$t0,$at
1704#    sw $t0,-8($s7) # ... and store back into -8 header-word
1708:skipMask_toString:
1708#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
1712#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
1716#    subu $t4,$t2,$t5
1720:toString_copyLoop:    
1720#    lb $t3,($t4)
1724#    and $t3,0x7f # mask off sign bit (in case first word)
1725##...lui $at,0
1729##...ori $at,$at,0x7f
1733##...and $t3,$t3,$at
1736#    sb $t3,-8($t0)
1740#    addu $t4,1
1744#    addu $t0,1
1748#    blt $t4,$t2,toString_copyLoop
1749##...slt $at,$t4,$t2
1753##...bne $at,$zero,1720

    # copy the '@' sign
1756#    li $t3,'@'
1760#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
1764#    addu $t2,$t0,$t1 # address of last byte in string to store +8
1768#    lw $t3,20($sp) # hash code to print
1772:toString_hashCopyLoop:
1772#    and $t4,$t3,0xf
1776#    srl $t3,4
1780#    lb $t4,hexChars($t4)
1784#    sb $t4,-8($t2)
1788#    subu $t2,$t2,1
1792#    bgt $t2,$t0,toString_hashCopyLoop
1793##...slt $at,$t0,$t2
1797##...bne $at,$zero,1772

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
1800#    addu $sp,28
1804#    lw $ra,($sp)
1808#    addu $sp,4
1812#    move $t0, $s7 # return string we created
1816#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
1820:mth_equals_String:
    
    # quick test for obvious false
1820#    lw $t0,($sp) # second parameter
1824#    beq $t0,$zero,goEsFalse # go return false if null
1828#    lw $t1,-12($t0) # vtable pointer
1832#    la $t2,CLASS_String # string vtable pointer
1836#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
1840#    subu $sp,12
1844#    sw $ra,8($sp)
1848#    sw $s2,4($sp)
1852#    sw $t0,($sp)
1856#    jal mth_compareTo_String
1860#    lw $s2, 4($sp) #restore this pointer and pop parameters
1864#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
1868#    seq $t0,$t0,$zero
1869##...subu $at,$t0,$zero
1873##...sltiu $t0,$at,1

    # pop return address and return $t0
1876#    lw $ra,($sp)
1880#    addu $sp,4

1884#    jr $ra # return
    
1888:goEsFalse:
    # put 0 in $t0 and return
1888#    li $t0, 0
1892#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
1896:mth_toString_String:
    #we are a string, so return this.
1896#    move $t0, $s2
1900#    jr $ra

###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
1904:mth_readLine_Lib:
    
1904#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
1908#    sw $ra, 4($sp) # save $ra
1912#    move $t1,$sp # save "original" sp

1916:  doRead:

    # read the character
1916#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
1920#    subu $t2,$v0,13
1924#    bne $t2,$zero,notReturnRL
1928#    jal readLogicalChar
1932#    subu $t2,$v0,10 # check for newline
1936#    beq $t2,$zero,foundNewLine
1940#    sw $v0,lastCharRead # push back character into queue
1944#    j foundNewLine # go process the line

1948:  notReturnRL:

    # at this point, $v0 has our character

1948#    subu $t0,$v0,10
1952#    beq $t0,$zero,foundNewLine
1956#    blt $v0,$zero,foundEof
1957##...slt $at,$v0,$zero
1961##...bne $at,$zero,1976

    # we have a character, so push it onto stack
1964#    subu $sp,$sp,4
1968#    sw $v0,($sp)

    # loop back up to get next character
1972#    j doRead

1976:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
1976#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
1980#    li $s7, 0 # return-value: null
1984#    j rlReturn # return

1988:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
1988#    subu $t0,$t1,$sp # number of chars we read (times 4)
1992#    srl $s6,$t0,2 # number of words on stack with chars
1996#    subu $sp,$sp,4 # push char-count ...
2000#    sw $s6,($sp) # ... onto stack
2004#    addu $t2,$t0,5 # GC tag, incl. for count-word
2008#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
2012#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
2016#    srl $s6,$s6,2  # data words in object
2020#    move $s7,$zero # object words in object
2024#    jal newObject  # allocate space
    
    # store header words
2028#    la $t0,CLASS_String
2032#    sw $t0,-12($s7)# store class tag (String) into object
2036#    lw $t2,4($sp) # char-count
2040#    sll $t1,$t2,2 # 4 times number of chars
2044#    subu $t2,$zero,$t2 # negative of char-count
2048#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
2052#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
2056#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
2057##...slt $at,$t0,$zero
2061##...beq $at,$zero,2080
2064#    and $t0,0xff # mask off object's hash value ...
2065##...lui $at,0
2069##...ori $at,$at,0xff
2073##...and $t0,$t0,$at
2076#    sw $t0,-8($s7) # ... and store back into -8 header-word
2080:  skipMask_readLine:

2080#    sll $t0,$t0,2 # data bytes in object
2084#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
2088#    subu $t0,$t0,$t2 # place to store last character (plus 9)
2092#    addu $sp,$sp,8 # pop redundant object-pointer and count
2096#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

2100#    beq $sp,$t1,rlReturn
2104:  charCopyLoop:
2104#    lw $t2,($sp)
2108#    sb $t2,-9($t0)
2112#    addu $sp,$sp,4
2116#    subu $t0,$t0,1
2120#    bne $sp,$t1,charCopyLoop
2124:  rlReturn:

2124#    lw $ra, 4($sp)
2128#    addu $sp, 8   # pop $ra and pointless word off stack
2132#    move $t0, $s7 # return string we allocated in $s7
2136#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
2140:mth_readInt_Lib:

    # save $ra by pushing onto stack
2140#    subu $sp,$sp,4
2144#    sw $ra,($sp)

2148:  riSkipWhiteLoop:
    # read a character
2148#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
2152#    subu $t0,$v0,32
2156#    bgt $t0,$zero,nonWhite
2157##...slt $at,$zero,$t0
2161##...bne $at,$zero,2204
2164#    beq $t0,$zero,riSkipWhiteLoop # start over if space
2168#    subu $t0,$v0,10
2172#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
2176#    subu $t0,$v0,9
2180#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
2184#    subu $t0,$v0,13
2188#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
2192#    subu $t0,$v0,12
