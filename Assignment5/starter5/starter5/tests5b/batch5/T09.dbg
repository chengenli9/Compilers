###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
1036:mth_equals_String:
    
    # quick test for obvious false
1036#    lw $t0,($sp) # second parameter
1040#    beq $t0,$zero,goEsFalse # go return false if null
1044#    lw $t1,-12($t0) # vtable pointer
1048#    la $t2,CLASS_String # string vtable pointer
1052#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
1056#    subu $sp,12
1060#    sw $ra,8($sp)
1064#    sw $s2,4($sp)
1068#    sw $t0,($sp)
1072#    jal mth_compareTo_String
1076#    lw $s2, 4($sp) #restore this pointer and pop parameters
1080#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
1084#    seq $t0,$t0,$zero
1085##...subu $at,$t0,$zero
1089##...sltiu $t0,$at,1

    # pop return address and return $t0
1092#    lw $ra,($sp)
1096#    addu $sp,4

1100#    jr $ra # return
    
1104:goEsFalse:
    # put 0 in $t0 and return
1104#    li $t0, 0
1108#    jr $ra # return
