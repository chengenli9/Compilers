    #### we have a GC tag.  Bytes to skip: tag value + 3.
3992#    subu $t0,$t0,$t1
3996#    subu $t0,$t0,3

4000:  gcTestIterDone1:
4000#    bgeu $t0,$sp,gcStackCopyLoop
4001##...sltu $at,$t0,$sp
4005##...beq $at,$zero,3816

    ###### end outer loop to copy all stack-direct objects ######
