
3460:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
3460#    addu $t0,$t0,4
3464#    bltu $t0,$s1,gcNextPointerInObject
3465##...sltu $at,$t0,$s1
3469##...bne $at,$zero,3308

3472:  gcTestIterDone2:
3472#    bltu $t0,$s3,gcHeapCopyLoop
3473##...sltu $at,$t0,$s3
3477##...bne $at,$zero,3192

    ###### end outer loop to copy all non-stack-direct objects ######

3480:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
3480#    lw $s2,($sp)
3484#    addu $sp,$sp,4

    # mark us as having already GC'd
3488#    move $t5,$s5

    # go try and allocate again
3492#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
3496:vm_init:

    # mark bottom of stack
3496#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
3500#    move $s2,$zero

    #set up the "five" register
3504#    li $s5,5

3508#    la $s3,seg0_start
3512#    la $s4,seg0_end
3513##...lui $s4,16
3517##...addiu $s4,$s4,4296
    
    # return
3520#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3524:divide:
    # get parameters; abort if divisor zero
3524#    lw $t0,($sp)
3528#    lw $t1,8($sp)
3532#    beq $t0,$zero,divByZeroError
    
    # perform division
3536#    div $t1,$t0
3540#    mflo $t0

    # store result, adjust stack and return
3544#    addu $sp,$sp,8 # adjust stack
3548#    sw $t0,($sp) # store result
3552#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3556:remainder:
    # get parameters; abort if divisor zero
3556#    lw $t0,($sp)
3560#    lw $t1,8($sp)
3564#    beq $t0,$zero,divByZeroError
    
    # perform division
3568#    div $t1,$t0
3572#    mfhi $t0

    # store result, adjust stack and return
3576#    addu $sp,$sp,8 # adjust stack
3580#    sw $t0,($sp) # store result
3584#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
3588:checkCast:
    # get object, allow immediately if null
3588#    lw $t2,($sp)
3592#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
3596#    lw $t2,-12($t2) # vtable address
3600#    bge $t2,$t1,castException
3601##...slt $at,$t2,$t1
3605##...beq $at,$zero,3740
3608#    blt $t2,$t0,castException
3609##...slt $at,$t2,$t0
3613##...bne $at,$zero,3740
    
    # return, leaving object unchanged on stack
3616:  checkCastReturn:    
3616#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
3620:instanceOf:
    # get object, go return false if null
3620#    lw $t2,($sp)
3624#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
3628#    lw $t2,-12($t2) # vtable address
3632#    sge $t0,$t2,$t0 # are we >= the lower limit?
3633##...slt $t0,$t2,$t0
3637##...xori $t0,$t0,0x1
3640#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
3644#    and $t2,$t0,$t1
3648#    sw $t2,($sp)
3652:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
3652#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

3656:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
3656#    li $v0,4 # syscall-code for print-string
3660#    syscall
3664:exit:
    # print termination message
3664#    li $v0,4 # syscall-code for print-string
3668#    la $a0,exitString
3672#    syscall

    # terminate execution
3676#    li $v0,10 #syscall-code for "exit"
3680#    syscall

3684:outOfHeapMemory:
3684#    la $a0,heapMemoryMsg
3688#    j exitError
3692:divByZeroError:
3692#    la $a0,divByZeroMsg
3696#    j exitError
3700:strIndexOutOfBounds:
3700#    la $a0,strIndexOutOfBoundsMsg
3704#    j exitError
3708:arrayIndexOutOfBounds:
3708#    la $a0,arrayIndexOutOfBoundsMsg
3712#    j exitError
3716:arraySizeOutOfBounds:
3716#    la $a0,arraySizeOutOfBoundsMsg
3720#    j exitError
3724:nullPtrException:
3724#    la $a0,nullPtrExceptionMsg
3728#    j exitError
3732:badIntegerFormat:
3732#    la $a0,badIntegerFormatMsg
3736#    j exitError
3740:castException:
3740#    la $a0,castExceptionMsg
3744#    j exitError
############## data section ################
    .data
3932:hexChars:
    .ascii "0123456789abcdef"
    .align 2
3948:cur_seg:
    .word 0

3952:lastCharRead:
    .word -2 # -2 => no buffered character
3956:prevHashConstant:
    .word 0x2785173c
3960:gcCount:
    .word 0

3964:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
3991:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
