##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
4692:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
4692#    lw $t0,-8($s2) # get word with hash bits from this
4696#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
4700#    addu $t0,$t1

4704#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
4708:mth_equals_Object:
4708#    move $t0,$s2 # first pointer (this)
4712#    lw $t1,($sp) # second pointer
4716#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
4717##...subu $at,$t0,$t1
4721##...sltiu $t0,$at,1

4724#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
4728:mth_hashCode_String:
4728#    move $t0,$s2 # put this pointer in t0

4732#    li $t2,0 # current hash value
4736#    lw $t1,-4($t0) # negative of number of characters in string
4740#    beq $t1,$zero,done_hashCode_String # if zero length => done
4744#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
4748#    and $t0,0xfffffffc # adjust for padding
4749##...lui $at,65535
4753##...ori $at,$at,0xfffc
4757##...and $t0,$t0,$at
4760#    subu $t1,$t0,$t1 # address at end of string +12
4764:loop_hashCode_String:    
4764#    sll $t4,$t2,5 # multiply by 32
4768#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
4772#    lbu $t3,-12($t0) # current character
4776#    addu $t2,$t3 # add in current character
4780#    addu $t0,1 # go to next character's address
4784#    bne $t0,$t1,loop_hashCode_String # loop back if more
4788:done_hashCode_String:    

    # push int on stack
4788#    move $t0, $t2 # put $t2 in return slot
4792#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
4796:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
4796#    subu $sp,4
4800#    sw $ra,($sp)
    
    # get hash value
4804#    lw $t2,-12($s2) # vtable address
4808#    lw $t0,($t2) # method address
4812#    jalr $t0
4816#    subu $sp,8 # push result (int in $t0) on stack
4820#    sw $s5,4($sp)
4824#    sw $t0,($sp)

    # compute print-size of hash value
4828#    li $t0, 1
4832#    lw $t1, ($sp)
4836#    srl $t1,$t1,4
4840#    beq $t1,$zero,toString_skip_loop
4844:toString_loop_top:
4844#    addu $t0,1
4848#    srl $t1,$t1,4
4852#    bne $t1,$zero,toString_loop_top
4856:toString_skip_loop:
4856#    subu $sp,8
4860#    sw $s5,4($sp)
4864#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
4868#    lw $t2,-12($s2) # vtable address
4872#    move $t0,$t2
4876:toString_checkTagBit:
4876#    subu $t0,1
4880#    lb $t1,($t0)
4884#    and $t1,0x80
4885##...lui $at,0
4889##...ori $at,$at,0x80
4893##...and $t1,$t1,$at
4896#    beq $t1,$zero,toString_checkTagBit
4900#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
4904#    subu $sp,8
4908#    sw $t1,($sp)
4912#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
4916#    move $s7,$zero # -4 offset header word
4920#    lw $t4,8($sp) # bytes for hash value
4924#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
4928#    addu $t4,8
4932#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
4936#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

4940#    li $t0,CLASS_String # store string vtable address into ...
4944#    sw $t0,-12($s7) # ... -12 offset in object header
4948#    lw $t2,-12($s2) # our object's vtable address
4952#    lw $t5,4($sp) # number characters in prefix
4956#    lw $t1,12($sp) # number of characters in hashcode
4960#    addu $t3,$t1,$t5 # number of characters in string ...
4964#    addu $t3,1 # ... including the '@' character
4968#    subu $t0,$zero,$t3 # store negated length into ...
4972#    sw $t0,-4($s7) # ... -4 offset header word
4976#    lw $t0,-8($s7) # get -8 offset header-word
4980#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
4981##...slt $at,$t0,$zero
4985##...beq $at,$zero,5004
4988#    and $t0,0xff # mask off object's hash value ...
4989##...lui $at,0
4993##...ori $at,$at,0xff
4997##...and $t0,$t0,$at
5000#    sw $t0,-8($s7) # ... and store back into -8 header-word
5004:skipMask_toString:
5004#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
5008#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
5012#    subu $t4,$t2,$t5
5016:toString_copyLoop:    
5016#    lb $t3,($t4)
5020#    and $t3,0x7f # mask off sign bit (in case first word)
5021##...lui $at,0
5025##...ori $at,$at,0x7f
5029##...and $t3,$t3,$at
5032#    sb $t3,-8($t0)
5036#    addu $t4,1
5040#    addu $t0,1
5044#    blt $t4,$t2,toString_copyLoop
5045##...slt $at,$t4,$t2
5049##...bne $at,$zero,5016

    # copy the '@' sign
5052#    li $t3,'@'
5056#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
5060#    addu $t2,$t0,$t1 # address of last byte in string to store +8
5064#    lw $t3,20($sp) # hash code to print
5068:toString_hashCopyLoop:
5068#    and $t4,$t3,0xf
5072#    srl $t3,4
5076#    lb $t4,hexChars($t4)
5080#    sb $t4,-8($t2)
5084#    subu $t2,$t2,1
5088#    bgt $t2,$t0,toString_hashCopyLoop
5089##...slt $at,$t0,$t2
5093##...bne $at,$zero,5068

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
5096#    addu $sp,28
5100#    lw $ra,($sp)
5104#    addu $sp,4
5108#    move $t0, $s7 # return string we created
5112#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
5116:mth_equals_String:
    
    # quick test for obvious false
5116#    lw $t0,($sp) # second parameter
5120#    beq $t0,$zero,goEsFalse # go return false if null
5124#    lw $t1,-12($t0) # vtable pointer
5128#    la $t2,CLASS_String # string vtable pointer
5132#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
5136#    subu $sp,12
5140#    sw $ra,8($sp)
5144#    sw $s2,4($sp)
5148#    sw $t0,($sp)
5152#    jal mth_compareTo_String
5156#    lw $s2, 4($sp) #restore this pointer and pop parameters
5160#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
5164#    seq $t0,$t0,$zero
5165##...subu $at,$t0,$zero
5169##...sltiu $t0,$at,1

    # pop return address and return $t0
5172#    lw $ra,($sp)
5176#    addu $sp,4

5180#    jr $ra # return
    
5184:goEsFalse:
    # put 0 in $t0 and return
5184#    li $t0, 0
5188#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
5192:mth_toString_String:
    #we are a string, so return this.
5192#    move $t0, $s2
5196#    jr $ra

###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
5200:mth_readLine_Lib:
    
5200#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
5204#    sw $ra, 4($sp) # save $ra
5208#    move $t1,$sp # save "original" sp

5212:  doRead:

    # read the character
5212#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
5216#    subu $t2,$v0,13
5220#    bne $t2,$zero,notReturnRL
5224#    jal readLogicalChar
5228#    subu $t2,$v0,10 # check for newline
5232#    beq $t2,$zero,foundNewLine
5236#    sw $v0,lastCharRead # push back character into queue
5240#    j foundNewLine # go process the line

5244:  notReturnRL:

    # at this point, $v0 has our character

5244#    subu $t0,$v0,10
5248#    beq $t0,$zero,foundNewLine
5252#    blt $v0,$zero,foundEof
5253##...slt $at,$v0,$zero
5257##...bne $at,$zero,5272

    # we have a character, so push it onto stack
5260#    subu $sp,$sp,4
5264#    sw $v0,($sp)

    # loop back up to get next character
5268#    j doRead

5272:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
5272#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
5276#    li $s7, 0 # return-value: null
5280#    j rlReturn # return

5284:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
5284#    subu $t0,$t1,$sp # number of chars we read (times 4)
5288#    srl $s6,$t0,2 # number of words on stack with chars
5292#    subu $sp,$sp,4 # push char-count ...
5296#    sw $s6,($sp) # ... onto stack
5300#    addu $t2,$t0,5 # GC tag, incl. for count-word
5304#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
5308#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
5312#    srl $s6,$s6,2  # data words in object
5316#    move $s7,$zero # object words in object
5320#    jal newObject  # allocate space
    
    # store header words
5324#    la $t0,CLASS_String
5328#    sw $t0,-12($s7)# store class tag (String) into object
5332#    lw $t2,4($sp) # char-count
5336#    sll $t1,$t2,2 # 4 times number of chars
5340#    subu $t2,$zero,$t2 # negative of char-count
5344#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
5348#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
5352#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
5353##...slt $at,$t0,$zero
5357##...beq $at,$zero,5376
5360#    and $t0,0xff # mask off object's hash value ...
5361##...lui $at,0
5365##...ori $at,$at,0xff
5369##...and $t0,$t0,$at
5372#    sw $t0,-8($s7) # ... and store back into -8 header-word
5376:  skipMask_readLine:

5376#    sll $t0,$t0,2 # data bytes in object
5380#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
5384#    subu $t0,$t0,$t2 # place to store last character (plus 9)
5388#    addu $sp,$sp,8 # pop redundant object-pointer and count
5392#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

5396#    beq $sp,$t1,rlReturn
5400:  charCopyLoop:
5400#    lw $t2,($sp)
5404#    sb $t2,-9($t0)
5408#    addu $sp,$sp,4
5412#    subu $t0,$t0,1
5416#    bne $sp,$t1,charCopyLoop
5420:  rlReturn:

5420#    lw $ra, 4($sp)
