1404#  addu $sp, $sp, 4
1408#  subu $sp, $sp, 4
1412#  sw $t0, ($sp)
1416#  lw $t0, ($sp)
1420#  addu $sp, $sp, 4
1424#  subu $sp, $sp, 4
1428#  sw $s2, ($sp)
1432#  la $t0, strLit_209
1436#  subu $sp, $sp, 4
1440#  sw $t0, ($sp)
1444#  lw $t0, 4($sp)
1448#  sw $s2, 4($sp)
1452#  move $s2, $t0
1456#  jal mth_printStr_Lib
1460#  addu $sp, $sp, 4
1464#  lw $s2, ($sp)
1468#  addu $sp, $sp, 4
1472#  subu $sp, $sp, 4
1476#  sw $t0, ($sp)
