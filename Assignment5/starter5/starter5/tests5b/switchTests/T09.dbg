##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1504:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
1504#    lw $t0,-8($s2) # get word with hash bits from this
1508#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
1512#    addu $t0,$t1

1516#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1520:mth_equals_Object:
1520#    move $t0,$s2 # first pointer (this)
1524#    lw $t1,($sp) # second pointer
1528#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
1529##...subu $at,$t0,$t1
1533##...sltiu $t0,$at,1

1536#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1540:mth_hashCode_String:
1540#    move $t0,$s2 # put this pointer in t0

1544#    li $t2,0 # current hash value
1548#    lw $t1,-4($t0) # negative of number of characters in string
1552#    beq $t1,$zero,done_hashCode_String # if zero length => done
1556#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
1560#    and $t0,0xfffffffc # adjust for padding
1561##...lui $at,65535
1565##...ori $at,$at,0xfffc
1569##...and $t0,$t0,$at
1572#    subu $t1,$t0,$t1 # address at end of string +12
1576:loop_hashCode_String:    
1576#    sll $t4,$t2,5 # multiply by 32
1580#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
1584#    lbu $t3,-12($t0) # current character
1588#    addu $t2,$t3 # add in current character
1592#    addu $t0,1 # go to next character's address
1596#    bne $t0,$t1,loop_hashCode_String # loop back if more
1600:done_hashCode_String:    

    # push int on stack
1600#    move $t0, $t2 # put $t2 in return slot
1604#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
1608:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
1608#    subu $sp,4
1612#    sw $ra,($sp)
    
    # get hash value
1616#    lw $t2,-12($s2) # vtable address
1620#    lw $t0,($t2) # method address
1624#    jalr $t0
1628#    subu $sp,8 # push result (int in $t0) on stack
1632#    sw $s5,4($sp)
1636#    sw $t0,($sp)

    # compute print-size of hash value
1640#    li $t0, 1
1644#    lw $t1, ($sp)
1648#    srl $t1,$t1,4
1652#    beq $t1,$zero,toString_skip_loop
1656:toString_loop_top:
1656#    addu $t0,1
1660#    srl $t1,$t1,4
1664#    bne $t1,$zero,toString_loop_top
1668:toString_skip_loop:
1668#    subu $sp,8
1672#    sw $s5,4($sp)
1676#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
1680#    lw $t2,-12($s2) # vtable address
1684#    move $t0,$t2
1688:toString_checkTagBit:
1688#    subu $t0,1
1692#    lb $t1,($t0)
1696#    and $t1,0x80
1697##...lui $at,0
1701##...ori $at,$at,0x80
1705##...and $t1,$t1,$at
1708#    beq $t1,$zero,toString_checkTagBit
1712#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
1716#    subu $sp,8
1720#    sw $t1,($sp)
1724#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
1728#    move $s7,$zero # -4 offset header word
1732#    lw $t4,8($sp) # bytes for hash value
1736#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
1740#    addu $t4,8
1744#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
1748#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

1752#    li $t0,CLASS_String # store string vtable address into ...
1756#    sw $t0,-12($s7) # ... -12 offset in object header
1760#    lw $t2,-12($s2) # our object's vtable address
1764#    lw $t5,4($sp) # number characters in prefix
1768#    lw $t1,12($sp) # number of characters in hashcode
1772#    addu $t3,$t1,$t5 # number of characters in string ...
1776#    addu $t3,1 # ... including the '@' character
1780#    subu $t0,$zero,$t3 # store negated length into ...
1784#    sw $t0,-4($s7) # ... -4 offset header word
1788#    lw $t0,-8($s7) # get -8 offset header-word
1792#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
1793##...slt $at,$t0,$zero
1797##...beq $at,$zero,1816
1800#    and $t0,0xff # mask off object's hash value ...
1801##...lui $at,0
1805##...ori $at,$at,0xff
1809##...and $t0,$t0,$at
1812#    sw $t0,-8($s7) # ... and store back into -8 header-word
1816:skipMask_toString:
1816#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
1820#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
1824#    subu $t4,$t2,$t5
1828:toString_copyLoop:    
1828#    lb $t3,($t4)
1832#    and $t3,0x7f # mask off sign bit (in case first word)
1833##...lui $at,0
1837##...ori $at,$at,0x7f
1841##...and $t3,$t3,$at
1844#    sb $t3,-8($t0)
1848#    addu $t4,1
1852#    addu $t0,1
1856#    blt $t4,$t2,toString_copyLoop
1857##...slt $at,$t4,$t2
1861##...bne $at,$zero,1828

    # copy the '@' sign
1864#    li $t3,'@'
1868#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
1872#    addu $t2,$t0,$t1 # address of last byte in string to store +8
1876#    lw $t3,20($sp) # hash code to print
1880:toString_hashCopyLoop:
1880#    and $t4,$t3,0xf
1884#    srl $t3,4
1888#    lb $t4,hexChars($t4)
1892#    sb $t4,-8($t2)
1896#    subu $t2,$t2,1
1900#    bgt $t2,$t0,toString_hashCopyLoop
1901##...slt $at,$t0,$t2
1905##...bne $at,$zero,1880

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
1908#    addu $sp,28
1912#    lw $ra,($sp)
1916#    addu $sp,4
1920#    move $t0, $s7 # return string we created
1924#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
1928:mth_equals_String:
    
    # quick test for obvious false
1928#    lw $t0,($sp) # second parameter
1932#    beq $t0,$zero,goEsFalse # go return false if null
1936#    lw $t1,-12($t0) # vtable pointer
1940#    la $t2,CLASS_String # string vtable pointer
1944#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
1948#    subu $sp,12
1952#    sw $ra,8($sp)
1956#    sw $s2,4($sp)
1960#    sw $t0,($sp)
1964#    jal mth_compareTo_String
1968#    lw $s2, 4($sp) #restore this pointer and pop parameters
1972#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
1976#    seq $t0,$t0,$zero
1977##...subu $at,$t0,$zero
1981##...sltiu $t0,$at,1

    # pop return address and return $t0
1984#    lw $ra,($sp)
1988#    addu $sp,4

1992#    jr $ra # return
    
1996:goEsFalse:
    # put 0 in $t0 and return
1996#    li $t0, 0
2000#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
2004:mth_toString_String:
    #we are a string, so return this.
2004#    move $t0, $s2
2008#    jr $ra

###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
2012:mth_readLine_Lib:
    
2012#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
2016#    sw $ra, 4($sp) # save $ra
2020#    move $t1,$sp # save "original" sp

2024:  doRead:

    # read the character
2024#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
2028#    subu $t2,$v0,13
2032#    bne $t2,$zero,notReturnRL
2036#    jal readLogicalChar
2040#    subu $t2,$v0,10 # check for newline
2044#    beq $t2,$zero,foundNewLine
2048#    sw $v0,lastCharRead # push back character into queue
2052#    j foundNewLine # go process the line

2056:  notReturnRL:

    # at this point, $v0 has our character

2056#    subu $t0,$v0,10
2060#    beq $t0,$zero,foundNewLine
2064#    blt $v0,$zero,foundEof
2065##...slt $at,$v0,$zero
2069##...bne $at,$zero,2084

    # we have a character, so push it onto stack
2072#    subu $sp,$sp,4
2076#    sw $v0,($sp)

    # loop back up to get next character
2080#    j doRead

2084:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
2084#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
2088#    li $s7, 0 # return-value: null
2092#    j rlReturn # return

2096:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
2096#    subu $t0,$t1,$sp # number of chars we read (times 4)
2100#    srl $s6,$t0,2 # number of words on stack with chars
2104#    subu $sp,$sp,4 # push char-count ...
2108#    sw $s6,($sp) # ... onto stack
2112#    addu $t2,$t0,5 # GC tag, incl. for count-word
2116#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
2120#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
2124#    srl $s6,$s6,2  # data words in object
2128#    move $s7,$zero # object words in object
2132#    jal newObject  # allocate space
    
    # store header words
2136#    la $t0,CLASS_String
2140#    sw $t0,-12($s7)# store class tag (String) into object
2144#    lw $t2,4($sp) # char-count
2148#    sll $t1,$t2,2 # 4 times number of chars
2152#    subu $t2,$zero,$t2 # negative of char-count
2156#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
2160#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
2164#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
2165##...slt $at,$t0,$zero
2169##...beq $at,$zero,2188
2172#    and $t0,0xff # mask off object's hash value ...
2173##...lui $at,0
2177##...ori $at,$at,0xff
2181##...and $t0,$t0,$at
2184#    sw $t0,-8($s7) # ... and store back into -8 header-word
2188:  skipMask_readLine:

2188#    sll $t0,$t0,2 # data bytes in object
2192#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
2196#    subu $t0,$t0,$t2 # place to store last character (plus 9)
2200#    addu $sp,$sp,8 # pop redundant object-pointer and count
2204#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

2208#    beq $sp,$t1,rlReturn
2212:  charCopyLoop:
2212#    lw $t2,($sp)
2216#    sb $t2,-9($t0)
2220#    addu $sp,$sp,4
2224#    subu $t0,$t0,1
2228#    bne $sp,$t1,charCopyLoop
2232:  rlReturn:

2232#    lw $ra, 4($sp)
2236#    addu $sp, 8   # pop $ra and pointless word off stack
2240#    move $t0, $s7 # return string we allocated in $s7
2244#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
2248:mth_readInt_Lib:

    # save $ra by pushing onto stack
2248#    subu $sp,$sp,4
2252#    sw $ra,($sp)

2256:  riSkipWhiteLoop:
    # read a character
2256#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
2260#    subu $t0,$v0,32
2264#    bgt $t0,$zero,nonWhite
2265##...slt $at,$zero,$t0
2269##...bne $at,$zero,2312
2272#    beq $t0,$zero,riSkipWhiteLoop # start over if space
2276#    subu $t0,$v0,10
2280#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
2284#    subu $t0,$v0,9
2288#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
2292#    subu $t0,$v0,13
2296#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
2300#    subu $t0,$v0,12
2304#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
2308#    j badIntegerFormat # illegal integer char: abort program

