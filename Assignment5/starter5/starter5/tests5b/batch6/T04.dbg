###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
2012:mth_equals_String:
    
    # quick test for obvious false
2012#    lw $t0,($sp) # second parameter
2016#    beq $t0,$zero,goEsFalse # go return false if null
2020#    lw $t1,-12($t0) # vtable pointer
2024#    la $t2,CLASS_String # string vtable pointer
2028#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
2032#    subu $sp,12
2036#    sw $ra,8($sp)
2040#    sw $s2,4($sp)
2044#    sw $t0,($sp)
2048#    jal mth_compareTo_String
2052#    lw $s2, 4($sp) #restore this pointer and pop parameters
2056#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
2060#    seq $t0,$t0,$zero
2061##...subu $at,$t0,$zero
2065##...sltiu $t0,$at,1

    # pop return address and return $t0
2068#    lw $ra,($sp)
2072#    addu $sp,4

2076#    jr $ra # return
    
2080:goEsFalse:
    # put 0 in $t0 and return
2080#    li $t0, 0
2084#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
2088:mth_toString_String:
    #we are a string, so return this.
2088#    move $t0, $s2
2092#    jr $ra

###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
2096:mth_readLine_Lib:
    
2096#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
2100#    sw $ra, 4($sp) # save $ra
2104#    move $t1,$sp # save "original" sp

2108:  doRead:

    # read the character
2108#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
2112#    subu $t2,$v0,13
2116#    bne $t2,$zero,notReturnRL
2120#    jal readLogicalChar
2124#    subu $t2,$v0,10 # check for newline
2128#    beq $t2,$zero,foundNewLine
2132#    sw $v0,lastCharRead # push back character into queue
2136#    j foundNewLine # go process the line

2140:  notReturnRL:

    # at this point, $v0 has our character

2140#    subu $t0,$v0,10
2144#    beq $t0,$zero,foundNewLine
2148#    blt $v0,$zero,foundEof
2149##...slt $at,$v0,$zero
2153##...bne $at,$zero,2168

    # we have a character, so push it onto stack
2156#    subu $sp,$sp,4
2160#    sw $v0,($sp)

    # loop back up to get next character
2164#    j doRead

2168:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
2168#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
2172#    li $s7, 0 # return-value: null
2176#    j rlReturn # return

2180:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
2180#    subu $t0,$t1,$sp # number of chars we read (times 4)
2184#    srl $s6,$t0,2 # number of words on stack with chars
2188#    subu $sp,$sp,4 # push char-count ...
2192#    sw $s6,($sp) # ... onto stack
2196#    addu $t2,$t0,5 # GC tag, incl. for count-word
2200#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
2204#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
2208#    srl $s6,$s6,2  # data words in object
2212#    move $s7,$zero # object words in object
2216#    jal newObject  # allocate space
    
    # store header words
2220#    la $t0,CLASS_String
2224#    sw $t0,-12($s7)# store class tag (String) into object
2228#    lw $t2,4($sp) # char-count
2232#    sll $t1,$t2,2 # 4 times number of chars
2236#    subu $t2,$zero,$t2 # negative of char-count
2240#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
2244#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
2248#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
2249##...slt $at,$t0,$zero
2253##...beq $at,$zero,2272
2256#    and $t0,0xff # mask off object's hash value ...
2257##...lui $at,0
2261##...ori $at,$at,0xff
2265##...and $t0,$t0,$at
2268#    sw $t0,-8($s7) # ... and store back into -8 header-word
2272:  skipMask_readLine:

2272#    sll $t0,$t0,2 # data bytes in object
2276#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
2280#    subu $t0,$t0,$t2 # place to store last character (plus 9)
2284#    addu $sp,$sp,8 # pop redundant object-pointer and count
2288#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

2292#    beq $sp,$t1,rlReturn
