5857##...slt $at,$t8,$zero
5861##...beq $at,$zero,5876
5864#    and $t8,0xff # mask off hash bits
5865##...lui $at,0
5869##...ori $at,$at,0xff
5873##...and $t8,$t8,$at

5876:  gcSkip5:
5876#    sll $t8,$t8,2 # bytes in negative-offset portion ...
5880#    addu $t8,$t8,8 # ... add in bytes for header-words
5884#    subu $t4,$t1,$t8 # address of first word of source object
5888#    lw $t3,-4($t1) # # words in positive-offset portion
5892#    bge $t3,$zero,gcNoNeg
5893##...slt $at,$t3,$zero
5897##...beq $at,$zero,5904
5900#    move $t3,$zero # negative treated as zero
5904:  gcNoNeg:
5904#    sll $t3,$t3,2 # bytes in negative-offset portion
5908#    addu $t3,$t3,$t1 # address one word past last word of source

5912#    addu $t8,$s3,$t8 # pointer to target object

    #########################################################
    # At this point:
    # - $t0 contains the address of the stack slot we'll
    #   process next
    # - $t1 contains the contents of the stack slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $t8 contains the pointer to the target object
    # - $s1 contains the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0, $t9
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger"
5916#    lw $s0,($t4)
5920#    lw $t9,-8($t1)
5924#    sw $t9,($t4)
5928#    sw $s0,-8($t1)

    # copy all source bytes to the target
5932:  gCinnerCopy2:
5932#    lw $s0,($t4)
5936#    sw $s0,($s3)
5940#    addu $t4,$t4,4
5944#    addu $s3,$s3,4
5948#    bltu $t4,$t3,gCinnerCopy2
5949##...sltu $at,$t4,$t3
5953##...bne $at,$zero,5932

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
5956#    sw $zero,-8($t1) # 0 in first header-slot
5960#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
5964#    sw $t8,($t0)

5968:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
5968#    addu $t0,$t0,4
5972#    bltu $t0,$s1,gcNextPointerInObject
5973##...sltu $at,$t0,$s1
5977##...bne $at,$zero,5816

5980:  gcTestIterDone2:
5980#    bltu $t0,$s3,gcHeapCopyLoop
5981##...sltu $at,$t0,$s3
5985##...bne $at,$zero,5700

    ###### end outer loop to copy all non-stack-direct objects ######

5988:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
5988#    lw $s2,($sp)
5992#    addu $sp,$sp,4

    # mark us as having already GC'd
5996#    move $t5,$s5

    # go try and allocate again
6000#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
6004:vm_init:

    # mark bottom of stack
6004#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
6008#    move $s2,$zero

    #set up the "five" register
6012#    li $s5,5

6016#    la $s3,seg0_start
6020#    la $s4,seg0_end
6021##...lui $s4,16
6025##...addiu $s4,$s4,7400
    
    # return
6028#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
6032:divide:
    # get parameters; abort if divisor zero
6032#    lw $t0,($sp)
6036#    lw $t1,8($sp)
6040#    beq $t0,$zero,divByZeroError
    
    # perform division
6044#    div $t1,$t0
6048#    mflo $t0

    # store result, adjust stack and return
6052#    addu $sp,$sp,8 # adjust stack
6056#    sw $t0,($sp) # store result
6060#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
6064:remainder:
    # get parameters; abort if divisor zero
6064#    lw $t0,($sp)
6068#    lw $t1,8($sp)
6072#    beq $t0,$zero,divByZeroError
    
    # perform division
6076#    div $t1,$t0
6080#    mfhi $t0

    # store result, adjust stack and return
6084#    addu $sp,$sp,8 # adjust stack
6088#    sw $t0,($sp) # store result
6092#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
6096:checkCast:
    # get object, allow immediately if null
6096#    lw $t2,($sp)
6100#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
6104#    lw $t2,-12($t2) # vtable address
6108#    bge $t2,$t1,castException
6109##...slt $at,$t2,$t1
6113##...beq $at,$zero,6248
6116#    blt $t2,$t0,castException
6117##...slt $at,$t2,$t0
6121##...bne $at,$zero,6248
    
    # return, leaving object unchanged on stack
6124:  checkCastReturn:    
6124#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
6128:instanceOf:
    # get object, go return false if null
6128#    lw $t2,($sp)
6132#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
6136#    lw $t2,-12($t2) # vtable address
6140#    sge $t0,$t2,$t0 # are we >= the lower limit?
6141##...slt $t0,$t2,$t0
6145##...xori $t0,$t0,0x1
6148#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
6152#    and $t2,$t0,$t1
6156#    sw $t2,($sp)
6160:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
6160#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

6164:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
6164#    li $v0,4 # syscall-code for print-string
6168#    syscall
6172:exit:
    # print termination message
6172#    li $v0,4 # syscall-code for print-string
6176#    la $a0,exitString
6180#    syscall

    # terminate execution
6184#    li $v0,10 #syscall-code for "exit"
6188#    syscall

6192:outOfHeapMemory:
6192#    la $a0,heapMemoryMsg
6196#    j exitError
6200:divByZeroError:
6200#    la $a0,divByZeroMsg
6204#    j exitError
6208:strIndexOutOfBounds:
6208#    la $a0,strIndexOutOfBoundsMsg
6212#    j exitError
6216:arrayIndexOutOfBounds:
6216#    la $a0,arrayIndexOutOfBoundsMsg
6220#    j exitError
6224:arraySizeOutOfBounds:
6224#    la $a0,arraySizeOutOfBoundsMsg
6228#    j exitError
6232:nullPtrException:
6232#    la $a0,nullPtrExceptionMsg
6236#    j exitError
6240:badIntegerFormat:
6240#    la $a0,badIntegerFormatMsg
6244#    j exitError
6248:castException:
6248#    la $a0,castExceptionMsg
6252#    j exitError
############## data section ################
    .data
7036:hexChars:
    .ascii "0123456789abcdef"
    .align 2
7052:cur_seg:
    .word 0

7056:lastCharRead:
    .word -2 # -2 => no buffered character
7060:prevHashConstant:
    .word 0x2785173c
7064:gcCount:
    .word 0

7068:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
7095:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
7118:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
7153:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
7187:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
7220:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
7251:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
7299:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
7320:gcMsg: 
      .asciiz "\nGC!\n"
7326:gcCountMsg: 
      .asciiz "Number of garbage collections: "

7358:nullStr:
    .asciiz "null"
7363:trueString:
    .asciiz "true"
7368:falseString:
    .asciiz "false"
7374:exitString:
