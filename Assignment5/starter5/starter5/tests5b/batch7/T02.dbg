    # mask off hash bits, if needed
9780#    lw $t4,-8($s7) # # data words in source string
9784#    bge $t4,$zero,skipMask_intToChar # don't strip hash code if not there
9785##...slt $at,$t4,$zero
9789##...beq $at,$zero,9808
9792#    and $t4,0xff # mask off object's hash value ...
9793##...lui $at,0
9797##...ori $at,$at,0xff
9801##...and $t4,$t4,$at
9804#    sw $t4,-8($s7) # ... and store back into -8 header-word
9808:  skipMask_intToChar:
