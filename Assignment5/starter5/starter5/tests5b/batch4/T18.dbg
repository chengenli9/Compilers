###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
1620:mth_readLine_Lib:
    
1620#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
1624#    sw $ra, 4($sp) # save $ra
1628#    move $t1,$sp # save "original" sp

1632:  doRead:

    # read the character
1632#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
1636#    subu $t2,$v0,13
1640#    bne $t2,$zero,notReturnRL
1644#    jal readLogicalChar
1648#    subu $t2,$v0,10 # check for newline
1652#    beq $t2,$zero,foundNewLine
1656#    sw $v0,lastCharRead # push back character into queue
1660#    j foundNewLine # go process the line

1664:  notReturnRL:

    # at this point, $v0 has our character

1664#    subu $t0,$v0,10
1668#    beq $t0,$zero,foundNewLine
1672#    blt $v0,$zero,foundEof
1673##...slt $at,$v0,$zero
1677##...bne $at,$zero,1692

    # we have a character, so push it onto stack
1680#    subu $sp,$sp,4
1684#    sw $v0,($sp)

    # loop back up to get next character
1688#    j doRead

1692:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
1692#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
1696#    li $s7, 0 # return-value: null
1700#    j rlReturn # return

1704:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
1704#    subu $t0,$t1,$sp # number of chars we read (times 4)
1708#    srl $s6,$t0,2 # number of words on stack with chars
1712#    subu $sp,$sp,4 # push char-count ...
1716#    sw $s6,($sp) # ... onto stack
1720#    addu $t2,$t0,5 # GC tag, incl. for count-word
1724#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
1728#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
1732#    srl $s6,$s6,2  # data words in object
1736#    move $s7,$zero # object words in object
1740#    jal newObject  # allocate space
    
    # store header words
1744#    la $t0,CLASS_String
1748#    sw $t0,-12($s7)# store class tag (String) into object
1752#    lw $t2,4($sp) # char-count
1756#    sll $t1,$t2,2 # 4 times number of chars
1760#    subu $t2,$zero,$t2 # negative of char-count
1764#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
1768#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
1772#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
1773##...slt $at,$t0,$zero
1777##...beq $at,$zero,1796
1780#    and $t0,0xff # mask off object's hash value ...
1781##...lui $at,0
1785##...ori $at,$at,0xff
1789##...and $t0,$t0,$at
1792#    sw $t0,-8($s7) # ... and store back into -8 header-word
1796:  skipMask_readLine:

1796#    sll $t0,$t0,2 # data bytes in object
1800#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
1804#    subu $t0,$t0,$t2 # place to store last character (plus 9)
1808#    addu $sp,$sp,8 # pop redundant object-pointer and count
1812#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

1816#    beq $sp,$t1,rlReturn
1820:  charCopyLoop:
1820#    lw $t2,($sp)
1824#    sb $t2,-9($t0)
1828#    addu $sp,$sp,4
1832#    subu $t0,$t0,1
1836#    bne $sp,$t1,charCopyLoop
1840:  rlReturn:

1840#    lw $ra, 4($sp)
1844#    addu $sp, 8   # pop $ra and pointless word off stack
1848#    move $t0, $s7 # return string we allocated in $s7
1852#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
1856:mth_readInt_Lib:

    # save $ra by pushing onto stack
1856#    subu $sp,$sp,4
1860#    sw $ra,($sp)

1864:  riSkipWhiteLoop:
    # read a character
1864#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
1868#    subu $t0,$v0,32
1872#    bgt $t0,$zero,nonWhite
1873##...slt $at,$zero,$t0
1877##...bne $at,$zero,1920
1880#    beq $t0,$zero,riSkipWhiteLoop # start over if space
1884#    subu $t0,$v0,10
1888#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
1892#    subu $t0,$v0,9
1896#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
1900#    subu $t0,$v0,13
1904#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
1908#    subu $t0,$v0,12
1912#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
1916#    j badIntegerFormat # illegal integer char: abort program

1920:  nonWhite:
1920#    subu $t0,$v0,'-'
1924#    li $t4,1 # final multiplier
1928#    bne $t0,$zero,helpReadInt # go read
1932#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
1936#    jal readLogicalChar

1940:  helpReadInt:
1940#    li $t2,10
1944#    subu $t1,$v0,'0' # convert digit to 0-9 value
1948#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
1949##...sltu $at,$t1,$t2
1953##...beq $at,$zero,4236
1956#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

1960:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

1960#    jal readLogicalChar # read next character
1964#    subu $t1,$v0,'0' # convert digit to 0-9 value
1968#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
1969##...sltu $at,$t1,$t2
1973##...beq $at,$zero,1992

1976#    mul $t3,$t3,$t2 # multiply old value by 10
1977##...mult $t3,$t2
1981##...mflo $t3
1984#    addu $t3,$t3,$t1 # add in value of new digit
1988#    j digitLoop

1992:  doneDigitLoop:

    # "push back" unused character into queue
1992#    sw $v0,lastCharRead

    # restore return address
1996#    lw $ra,($sp)
2000#    addu $sp, 4

    # multiply by sign and put return value in $t0
2004#    mult $t3,$t4 # multiply to account for poss. minus sign
2008#    mflo $t3
2012#    move $t0, $t3
    
    # return
2016#    jr $ra

###################################################################
# readChar() - library method (class Lib)
# - reads a single character from standard input
# - returns the integer that is the encoding of the character
# - returns -1 if end of file was encountered
# - parameter:
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
2020:mth_readChar_Lib:

    # save $ra by pushing onto stack
2020#    subu $sp,$sp,4
2024#    sw $ra,($sp)

      # read the character
2028#    jal readLogicalChar

    # restore return address; put value in $t0
    # replacing this-pointer saved return address
2032#    lw $ra,($sp)
2036#    addu $sp, 4
2040#    move $t0, $v0

    # return
2044#    jr $ra

########################################################
# printStr(str) - library method (class Lib)
# - prints string to standard output
# parameters:
#   - ($sp) - the string to print
#   - 4($sp) - old-this-pointer
########################################################
2048:mth_printStr_Lib:
    # check for null, printing "(null)", if so
2048#    lw $t0,($sp)
2052#    bne $t0,$zero,psNotNull

    # print "(null)"
2056#    la $a0,nullStr
2060#    li $v0,4
2064#    syscall
2068#    j donePrintStr
    
2072:  psNotNull:
    ##### we have a non-null string #####
    # this means that:
    # - number of data words in -8($t0):
    #   - if the sign bit is 1, the low 31 bits
    #   - if the sign bit is 0, the low 8 bits
    # - negative of number of characters in string is in -4($t0)
    # - string begins at $t0-8-(#dataWords*4), stored 1 char per byte
2072#    subu $t0,$t0,8
2076#    lw $t1,($t0) # number of data words, but needs modification
2080#    blt $t1,$zero,skipPrintStr1
