5794:gcCountMsg: 
      .asciiz "Number of garbage collections: "

5826:nullStr:
    .asciiz "null"
5831:trueString:
    .asciiz "true"
5836:falseString:
    .asciiz "false"
5842:exitString:
    .ascii "Program execution completed."
    #### "falls through" here
5870:newlineString:
    .asciiz "\n"
    
    .align 2
5872:stack_bottom:
