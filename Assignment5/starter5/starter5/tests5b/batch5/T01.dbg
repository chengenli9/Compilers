########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
3112:vm_init:

    # mark bottom of stack
3112#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
3116#    move $s2,$zero

    #set up the "five" register
3120#    li $s5,5

3124#    la $s3,seg0_start
3128#    la $s4,seg0_end
3129##...lui $s4,16
3133##...addiu $s4,$s4,3984
    
    # return
3136#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3140:divide:
    # get parameters; abort if divisor zero
3140#    lw $t0,($sp)
3144#    lw $t1,8($sp)
3148#    beq $t0,$zero,divByZeroError
    
    # perform division
3152#    div $t1,$t0
3156#    mflo $t0

    # store result, adjust stack and return
3160#    addu $sp,$sp,8 # adjust stack
3164#    sw $t0,($sp) # store result
3168#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3172:remainder:
    # get parameters; abort if divisor zero
3172#    lw $t0,($sp)
3176#    lw $t1,8($sp)
3180#    beq $t0,$zero,divByZeroError
    
    # perform division
3184#    div $t1,$t0
3188#    mfhi $t0

    # store result, adjust stack and return
3192#    addu $sp,$sp,8 # adjust stack
3196#    sw $t0,($sp) # store result
3200#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
3204:checkCast:
    # get object, allow immediately if null
3204#    lw $t2,($sp)
3208#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
3212#    lw $t2,-12($t2) # vtable address
3216#    bge $t2,$t1,castException
3217##...slt $at,$t2,$t1
3221##...beq $at,$zero,3392
3224#    blt $t2,$t0,castException
3225##...slt $at,$t2,$t0
3229##...bne $at,$zero,3392
    
    # return, leaving object unchanged on stack
3232:  checkCastReturn:    
3232#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
3236:instanceOf:
    # get object, go return false if null
3236#    lw $t2,($sp)
3240#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
3244#    lw $t2,-12($t2) # vtable address
3248#    sge $t0,$t2,$t0 # are we >= the lower limit?
3249##...slt $t0,$t2,$t0
3253##...xori $t0,$t0,0x1
3256#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
3260#    and $t2,$t0,$t1
3264#    sw $t2,($sp)
3268:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
3268#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

3272:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
3272#    li $v0,4 # syscall-code for print-string
3276#    syscall
3280:exit:
    # print termination message
3280#    li $v0,4 # syscall-code for print-string
3284#    la $a0,exitString
3288#    syscall

    # print number of garbage collections
3292#    li $v0,4 # syscall-code for print-string
3296#    la $a0,gcCountMsg
3300#    syscall # print "Number of ..."
3304#    lw $a0,gcCount # number of GC's
3308#    li $v0,1 # code for print-int
3312#    syscall
3316#    li $v0,4 # syscall-code for print-string
3320#    la $a0,newlineString
3324#    syscall # print newline

    # terminate execution
3328#    li $v0,10 #syscall-code for "exit"
3332#    syscall

3336:outOfHeapMemory:
3336#    la $a0,heapMemoryMsg
3340#    j exitError
3344:divByZeroError:
3344#    la $a0,divByZeroMsg
3348#    j exitError
3352:strIndexOutOfBounds:
3352#    la $a0,strIndexOutOfBoundsMsg
3356#    j exitError
3360:arrayIndexOutOfBounds:
3360#    la $a0,arrayIndexOutOfBoundsMsg
3364#    j exitError
3368:arraySizeOutOfBounds:
3368#    la $a0,arraySizeOutOfBoundsMsg
3372#    j exitError
3376:nullPtrException:
3376#    la $a0,nullPtrExceptionMsg
3380#    j exitError
3384:badIntegerFormat:
3384#    la $a0,badIntegerFormatMsg
3388#    j exitError
3392:castException:
3392#    la $a0,castExceptionMsg
3396#    j exitError
############## data section ################
    .data
3612:hexChars:
    .ascii "0123456789abcdef"
    .align 2
3628:cur_seg:
    .word 0

3632:lastCharRead:
    .word -2 # -2 => no buffered character
3636:prevHashConstant:
    .word 0x2785173c
3640:gcCount:
    .word 0

3644:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
3671:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
3694:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
3729:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
3763:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
3796:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
3827:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
3875:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
3896:gcMsg: 
      .asciiz "\nGC!\n"
3902:gcCountMsg: 
      .asciiz "Number of garbage collections: "

3934:nullStr:
    .asciiz "null"
3939:trueString:
    .asciiz "true"
3944:falseString:
    .asciiz "false"
3950:exitString:
    .ascii "Program execution completed."
    #### "falls through" here
3978:newlineString:
    .asciiz "\n"
    
    .align 2
3980:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

3984:seg0_start:
    .space 0x100000
1052560:seg0_end:
1052560:seg1_start:
    .space 0x100000
2101136:seg1_end:
