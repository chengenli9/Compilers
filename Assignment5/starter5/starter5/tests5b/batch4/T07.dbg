###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
1324:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
1324#    subu $sp,4
1328#    sw $ra,($sp)
    
    # get hash value
1332#    lw $t2,-12($s2) # vtable address
1336#    lw $t0,($t2) # method address
1340#    jalr $t0
1344#    subu $sp,8 # push result (int in $t0) on stack
1348#    sw $s5,4($sp)
1352#    sw $t0,($sp)

    # compute print-size of hash value
1356#    li $t0, 1
1360#    lw $t1, ($sp)
1364#    srl $t1,$t1,4
1368#    beq $t1,$zero,toString_skip_loop
1372:toString_loop_top:
1372#    addu $t0,1
1376#    srl $t1,$t1,4
1380#    bne $t1,$zero,toString_loop_top
1384:toString_skip_loop:
1384#    subu $sp,8
1388#    sw $s5,4($sp)
1392#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
1396#    lw $t2,-12($s2) # vtable address
1400#    move $t0,$t2
1404:toString_checkTagBit:
1404#    subu $t0,1
1408#    lb $t1,($t0)
1412#    and $t1,0x80
1413##...lui $at,0
1417##...ori $at,$at,0x80
1421##...and $t1,$t1,$at
1424#    beq $t1,$zero,toString_checkTagBit
1428#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
1432#    subu $sp,8
1436#    sw $t1,($sp)
1440#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
1444#    move $s7,$zero # -4 offset header word
1448#    lw $t4,8($sp) # bytes for hash value
1452#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
1456#    addu $t4,8
1460#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
1464#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

1468#    li $t0,CLASS_String # store string vtable address into ...
1472#    sw $t0,-12($s7) # ... -12 offset in object header
1476#    lw $t2,-12($s2) # our object's vtable address
1480#    lw $t5,4($sp) # number characters in prefix
1484#    lw $t1,12($sp) # number of characters in hashcode
1488#    addu $t3,$t1,$t5 # number of characters in string ...
1492#    addu $t3,1 # ... including the '@' character
1496#    subu $t0,$zero,$t3 # store negated length into ...
1500#    sw $t0,-4($s7) # ... -4 offset header word
1504#    lw $t0,-8($s7) # get -8 offset header-word
1508#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
1509##...slt $at,$t0,$zero
1513##...beq $at,$zero,1532
1516#    and $t0,0xff # mask off object's hash value ...
1517##...lui $at,0
1521##...ori $at,$at,0xff
1525##...and $t0,$t0,$at
1528#    sw $t0,-8($s7) # ... and store back into -8 header-word
1532:skipMask_toString:
1532#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
1536#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
1540#    subu $t4,$t2,$t5
1544:toString_copyLoop:    
1544#    lb $t3,($t4)
1548#    and $t3,0x7f # mask off sign bit (in case first word)
1549##...lui $at,0
1553##...ori $at,$at,0x7f
1557##...and $t3,$t3,$at
1560#    sb $t3,-8($t0)
1564#    addu $t4,1
1568#    addu $t0,1
1572#    blt $t4,$t2,toString_copyLoop
1573##...slt $at,$t4,$t2
1577##...bne $at,$zero,1544

    # copy the '@' sign
1580#    li $t3,'@'
1584#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
1588#    addu $t2,$t0,$t1 # address of last byte in string to store +8
1592#    lw $t3,20($sp) # hash code to print
1596:toString_hashCopyLoop:
1596#    and $t4,$t3,0xf
1600#    srl $t3,4
1604#    lb $t4,hexChars($t4)
1608#    sb $t4,-8($t2)
1612#    subu $t2,$t2,1
1616#    bgt $t2,$t0,toString_hashCopyLoop
1617##...slt $at,$t0,$t2
1621##...bne $at,$zero,1596

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
1624#    addu $sp,28
1628#    lw $ra,($sp)
1632#    addu $sp,4
1636#    move $t0, $s7 # return string we created
1640#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
1644:mth_equals_String:
    
    # quick test for obvious false
1644#    lw $t0,($sp) # second parameter
1648#    beq $t0,$zero,goEsFalse # go return false if null
1652#    lw $t1,-12($t0) # vtable pointer
1656#    la $t2,CLASS_String # string vtable pointer
1660#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
1664#    subu $sp,12
1668#    sw $ra,8($sp)
1672#    sw $s2,4($sp)
1676#    sw $t0,($sp)
1680#    jal mth_compareTo_String
1684#    lw $s2, 4($sp) #restore this pointer and pop parameters
1688#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
1692#    seq $t0,$t0,$zero
1693##...subu $at,$t0,$zero
1697##...sltiu $t0,$at,1

    # pop return address and return $t0
1700#    lw $ra,($sp)
1704#    addu $sp,4

1708#    jr $ra # return
    
1712:goEsFalse:
    # put 0 in $t0 and return
1712#    li $t0, 0
1716#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
