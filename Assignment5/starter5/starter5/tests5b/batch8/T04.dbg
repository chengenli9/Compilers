4428#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
4432:vm_init:

    # mark bottom of stack
4432#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
4436#    move $s2,$zero

    #set up the "five" register
4440#    li $s5,5

4444#    la $s3,seg0_start
4448#    la $s4,seg0_end
4449##...lui $s4,16
4453##...addiu $s4,$s4,5360
    
    # return
4456#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4460:divide:
    # get parameters; abort if divisor zero
4460#    lw $t0,($sp)
4464#    lw $t1,8($sp)
4468#    beq $t0,$zero,divByZeroError
    
    # perform division
4472#    div $t1,$t0
4476#    mflo $t0

    # store result, adjust stack and return
4480#    addu $sp,$sp,8 # adjust stack
4484#    sw $t0,($sp) # store result
4488#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4492:remainder:
    # get parameters; abort if divisor zero
4492#    lw $t0,($sp)
4496#    lw $t1,8($sp)
4500#    beq $t0,$zero,divByZeroError
    
    # perform division
4504#    div $t1,$t0
4508#    mfhi $t0

    # store result, adjust stack and return
4512#    addu $sp,$sp,8 # adjust stack
4516#    sw $t0,($sp) # store result
4520#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
4524:checkCast:
    # get object, allow immediately if null
4524#    lw $t2,($sp)
4528#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
4532#    lw $t2,-12($t2) # vtable address
4536#    bge $t2,$t1,castException
4537##...slt $at,$t2,$t1
4541##...beq $at,$zero,4712
4544#    blt $t2,$t0,castException
4545##...slt $at,$t2,$t0
4549##...bne $at,$zero,4712
    
    # return, leaving object unchanged on stack
4552:  checkCastReturn:    
4552#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
4556:instanceOf:
    # get object, go return false if null
4556#    lw $t2,($sp)
4560#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
4564#    lw $t2,-12($t2) # vtable address
4568#    sge $t0,$t2,$t0 # are we >= the lower limit?
4569##...slt $t0,$t2,$t0
4573##...xori $t0,$t0,0x1
4576#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
4580#    and $t2,$t0,$t1
4584#    sw $t2,($sp)
4588:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
4588#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

4592:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
4592#    li $v0,4 # syscall-code for print-string
4596#    syscall
4600:exit:
    # print termination message
4600#    li $v0,4 # syscall-code for print-string
4604#    la $a0,exitString
4608#    syscall

    # print number of garbage collections
4612#    li $v0,4 # syscall-code for print-string
4616#    la $a0,gcCountMsg
4620#    syscall # print "Number of ..."
4624#    lw $a0,gcCount # number of GC's
4628#    li $v0,1 # code for print-int
4632#    syscall
4636#    li $v0,4 # syscall-code for print-string
4640#    la $a0,newlineString
4644#    syscall # print newline

    # terminate execution
4648#    li $v0,10 #syscall-code for "exit"
4652#    syscall

4656:outOfHeapMemory:
4656#    la $a0,heapMemoryMsg
4660#    j exitError
4664:divByZeroError:
4664#    la $a0,divByZeroMsg
4668#    j exitError
