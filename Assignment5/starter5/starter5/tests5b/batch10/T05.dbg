    ###########################################################

    # set up the forwarding pointer
4592#    sw $zero,-8($t1) # 0 in first header-slot
4596#    sw $t2,-4($t1) # forwarding pointer in second header-slot

    # update the stack slot with the address in the target space
4600#    sw $t2,4($t0)
4604#    lw $zero,-8($t2)
4608#    lw $zero,-4($t2)

    # go handle next stack slot (testing if done)
4612#    j gcTestIterDone1

4616:  gcBump:
    #### we have a GC tag.  Bytes to skip: tag value + 3.
4616#    subu $t0,$t0,$t1
4620#    subu $t0,$t0,3

4624:  gcTestIterDone1:
4624#    bgeu $t0,$sp,gcStackCopyLoop
4625##...sltu $at,$t0,$sp
4629##...beq $at,$zero,4440

    ###### end outer loop to copy all stack-direct objects ######

    #############################################################
    # We have finished processing the stack elements.  Now we need
    # to update elements in the heap itself. This may itself involve
    # moving additional objects
    #############################################################

    #########################################################
    # At this point:
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # We want to set things up so that in addition:
    # - $t0 is the "trailing finger", containing the address
    #   of the first slot in target space that we have yet
    #   to process.
    # Then during processing:
    # - $t1 will contain the contents of the heap slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # And when we're actually copying an object:
    # - $t2 will contain pointer to the target object
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - available for use: $s0
    ##########################################################

    # set $t0 to be at the beginning of target-space
4632#    lw $t1,cur_seg
4636#    la $t0,seg0_start
4640#    beq $t1,$zero,gcSkip4
4644#    la $t0,seg1_start
4645##...lui $t0,16
4649##...addiu $t0,$t0,5928


4652:  gcSkip4:

    # if there were no objects put into the heap during stack
    # processing, we're done, so go finish up
4652#    bgeu $t0,$s3,gcFinishUp
4653##...sltu $at,$t0,$s3
4657##...beq $at,$zero,4948

    ###### begin outer loop to copy all non-stack-direct objects ######

4660:  gcHeapCopyLoop:
    # get data count for object; swap header-word with first word
    # of object so that they're back in the right place
4660#    lw $t1,($t0) # (what will be) first header word for current object
4664#    move $t2,$t1 # number data bytes in object (poss. w/hash bits)
4668#    bge $t2,$zero,gcSkip4a # are there hash bits?
4669##...slt $at,$t2,$zero
4673##...beq $at,$zero,4688
4676#    and $t2,0xff # mask off hash bits
4677##...lui $at,0
4681##...ori $at,$at,0xff
4685##...and $t2,$t2,$at
4688:gcSkip4a:    
4688#    sll $t2,$t2,2 # # data bytes
4692#    addu $t2,$t2,8 # to skip header words
4696#    addu $t2,$t0,$t2 # pointer to new object
4700#    lw $t3,-8($t2) # word to swap
4704#    sw $t1,-8($t2) # store header word
4708#    sw $t3,($t0) # restore first word of object

    ################################################
    # at this point:
    # - $t2 contains the pointer to our new object
    ################################################

    # check if we have a data array
4712#    lw $t1,-12($t2) # vtable pointer
4716#    li $t0,dataArrayVTableStart # address of vtable for first data array
4720#    blt $t1,$t0,gcNotDataArray # if data array, no more xforming to do
4721##...slt $at,$t1,$t0
4725##...bne $at,$zero,4744

    # We have a vtable address that is a data array.
    # we need skip over it then loop back to do next object.
4728:  skipToNextObj:
4728#    lw $t1,-4($t2) # data words in (object position of) array
    #### note: we know that it's not a string, so the value will
    #### not be artificially negative
4732#    sll $t1,$t1,2 # convert to byte-count
4736#    addu $t0,$t2,$t1 # skip over object
4740#    j gcTestIterDone2 # go do next object, if any

    ###################################################
    # at this point:
    # - the object has been restored to normal status--that is, the
    #   word-swap has been done
    # - $t2 contains a pointer to the object
    ###################################################
    
4744:  gcNotDataArray:
4744#    lw $t3,-4($t2) # # object words (negative treated as zero)
4748#    bge $t3,$zero,gcH2Neg2
4749##...slt $at,$t3,$zero
4753##...beq $at,$zero,4760
4756#    move $t3,$zero
4760:  gcH2Neg2:
4760#    sll $t3,$t3,2 # # object bytes
4764#    move $t0,$t2 # address of first pointer in object
4768#    add $s1,$t2,$t3 # limit address for this object

    #####################################################
    # At this point, we have to "translate" all pointers,
    # starting at $t0 to (but not including) $s1
    #####################################################

    # if there are no pointer-slots (i.e., $t0=$s1), skip this
    # part
4772#    beq $t0,$s1,gcTestIterDone2
    
4776:  gcNextPointerInObject:
    # get pointer from object
4776#    lw $t1,($t0)

    # if value is out of range, and is therefore does not refer
    # to an object, just go loop back and do the next one
4780#    bleu $t1,$t6,gcGoNextPointerSlot
4781##...sltu $at,$t6,$t1
4785##...beq $at,$zero,4928
4788#    bgtu $t1,$t7,gcGoNextPointerSlot
4789##...sltu $at,$t7,$t1
4793##...bne $at,$zero,4928

    # if the object has already been moved, update the stack-value
    # via the forwarding pointer
4796#    lw $t8,-8($t1) # possible forwarding tag
4800#    bne $t8,$zero,gcNoForward2 # if not forwarding tag, go copy
4804#    lw $t8,-4($t1) # forwarding pointer: object's new address
4808#    sw $t8,($t0) # update pointer in object
4812#    j gcGoNextPointerSlot # do next iteration

4816:  gcNoForward2:
    #########################################################
    # we actually need to copy the object into the new space
    #########################################################

    #########################################################
    # At this point:
    # - $t0 contains the address of the heap-slot we're translating
    # - $t1 will contain the contents of the heap-slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space, which will also be the first address
    #   of the target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # Then during processing:
    # And when we're actually copying an object:
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $t8 will contain a pointer to the target object
    # - available for use: $s0, $t8, $t9
    ##########################################################

    # compute the amount of space that is needed
4816#    bge $t8,$zero,gcSkip5 # # words in negative-offset portion
4817##...slt $at,$t8,$zero
4821##...beq $at,$zero,4836
4824#    and $t8,0xff # mask off hash bits
4825##...lui $at,0
4829##...ori $at,$at,0xff
4833##...and $t8,$t8,$at

4836:  gcSkip5:
4836#    sll $t8,$t8,2 # bytes in negative-offset portion ...
4840#    addu $t8,$t8,8 # ... add in bytes for header-words
4844#    subu $t4,$t1,$t8 # address of first word of source object
4848#    lw $t3,-4($t1) # # words in positive-offset portion
4852#    bge $t3,$zero,gcNoNeg
4853##...slt $at,$t3,$zero
4857##...beq $at,$zero,4864
4860#    move $t3,$zero # negative treated as zero
4864:  gcNoNeg:
4864#    sll $t3,$t3,2 # bytes in negative-offset portion
4868#    addu $t3,$t3,$t1 # address one word past last word of source

4872#    addu $t8,$s3,$t8 # pointer to target object

    #########################################################
    # At this point:
    # - $t0 contains the address of the stack slot we'll
    #   process next
    # - $t1 contains the contents of the stack slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $t8 contains the pointer to the target object
    # - $s1 contains the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0, $t9
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger"
4876#    lw $s0,($t4)
4880#    lw $t9,-8($t1)
4884#    sw $t9,($t4)
4888#    sw $s0,-8($t1)

    # copy all source bytes to the target
4892:  gCinnerCopy2:
4892#    lw $s0,($t4)
4896#    sw $s0,($s3)
4900#    addu $t4,$t4,4
4904#    addu $s3,$s3,4
4908#    bltu $t4,$t3,gCinnerCopy2
4909##...sltu $at,$t4,$t3
4913##...bne $at,$zero,4892

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
4916#    sw $zero,-8($t1) # 0 in first header-slot
4920#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
4924#    sw $t8,($t0)

4928:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
4928#    addu $t0,$t0,4
4932#    bltu $t0,$s1,gcNextPointerInObject
4933##...sltu $at,$t0,$s1
4937##...bne $at,$zero,4776

4940:  gcTestIterDone2:
4940#    bltu $t0,$s3,gcHeapCopyLoop
4941##...sltu $at,$t0,$s3
4945##...bne $at,$zero,4660

    ###### end outer loop to copy all non-stack-direct objects ######

4948:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
4948#    lw $s2,($sp)
4952#    addu $sp,$sp,4

    # mark us as having already GC'd
4956#    move $t5,$s5

    # go try and allocate again
4960#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
4964:vm_init:

    # mark bottom of stack
4964#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
4968#    move $s2,$zero

    #set up the "five" register
4972#    li $s5,5

4976#    la $s3,seg0_start
4980#    la $s4,seg0_end
4981##...lui $s4,16
4985##...addiu $s4,$s4,5928
    
    # return
4988#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4992:divide:
    # get parameters; abort if divisor zero
4992#    lw $t0,($sp)
4996#    lw $t1,8($sp)
5000#    beq $t0,$zero,divByZeroError
    
    # perform division
5004#    div $t1,$t0
5008#    mflo $t0

    # store result, adjust stack and return
5012#    addu $sp,$sp,8 # adjust stack
5016#    sw $t0,($sp) # store result
5020#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
5024:remainder:
    # get parameters; abort if divisor zero
5024#    lw $t0,($sp)
5028#    lw $t1,8($sp)
5032#    beq $t0,$zero,divByZeroError
    
    # perform division
5036#    div $t1,$t0
5040#    mfhi $t0

    # store result, adjust stack and return
5044#    addu $sp,$sp,8 # adjust stack
5048#    sw $t0,($sp) # store result
5052#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
5056:checkCast:
    # get object, allow immediately if null
5056#    lw $t2,($sp)
5060#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
5064#    lw $t2,-12($t2) # vtable address
5068#    bge $t2,$t1,castException
5069##...slt $at,$t2,$t1
5073##...beq $at,$zero,5244
5076#    blt $t2,$t0,castException
5077##...slt $at,$t2,$t0
5081##...bne $at,$zero,5244
    
    # return, leaving object unchanged on stack
5084:  checkCastReturn:    
5084#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
5088:instanceOf:
    # get object, go return false if null
5088#    lw $t2,($sp)
5092#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
5096#    lw $t2,-12($t2) # vtable address
5100#    sge $t0,$t2,$t0 # are we >= the lower limit?
5101##...slt $t0,$t2,$t0
5105##...xori $t0,$t0,0x1
5108#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
5112#    and $t2,$t0,$t1
5116#    sw $t2,($sp)
5120:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
5120#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

5124:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
5124#    li $v0,4 # syscall-code for print-string
5128#    syscall
5132:exit:
    # print termination message
5132#    li $v0,4 # syscall-code for print-string
5136#    la $a0,exitString
5140#    syscall

    # print number of garbage collections
5144#    li $v0,4 # syscall-code for print-string
5148#    la $a0,gcCountMsg
5152#    syscall # print "Number of ..."
5156#    lw $a0,gcCount # number of GC's
5160#    li $v0,1 # code for print-int
5164#    syscall
5168#    li $v0,4 # syscall-code for print-string
5172#    la $a0,newlineString
5176#    syscall # print newline

    # terminate execution
5180#    li $v0,10 #syscall-code for "exit"
5184#    syscall

5188:outOfHeapMemory:
5188#    la $a0,heapMemoryMsg
5192#    j exitError
5196:divByZeroError:
5196#    la $a0,divByZeroMsg
5200#    j exitError
5204:strIndexOutOfBounds:
5204#    la $a0,strIndexOutOfBoundsMsg
5208#    j exitError
5212:arrayIndexOutOfBounds:
5212#    la $a0,arrayIndexOutOfBoundsMsg
5216#    j exitError
5220:arraySizeOutOfBounds:
5220#    la $a0,arraySizeOutOfBoundsMsg
5224#    j exitError
5228:nullPtrException:
5228#    la $a0,nullPtrExceptionMsg
5232#    j exitError
5236:badIntegerFormat:
5236#    la $a0,badIntegerFormatMsg
5240#    j exitError
5244:castException:
5244#    la $a0,castExceptionMsg
5248#    j exitError
############## data section ################
    .data
5556:hexChars:
    .ascii "0123456789abcdef"
    .align 2
5572:cur_seg:
    .word 0

5576:lastCharRead:
    .word -2 # -2 => no buffered character
5580:prevHashConstant:
    .word 0x2785173c
5584:gcCount:
    .word 0

5588:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
5615:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
5638:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
5673:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
5707:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
5740:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
5771:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
