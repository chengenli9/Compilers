########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
3248:vm_init:

    # mark bottom of stack
3248#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
3252#    move $s2,$zero

    #set up the "five" register
3256#    li $s5,5

3260#    la $s3,seg0_start
3264#    la $s4,seg0_end
3265##...lui $s4,16
3269##...addiu $s4,$s4,4064
    
    # return
3272#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3276:divide:
    # get parameters; abort if divisor zero
3276#    lw $t0,($sp)
3280#    lw $t1,8($sp)
3284#    beq $t0,$zero,divByZeroError
    
    # perform division
3288#    div $t1,$t0
3292#    mflo $t0

    # store result, adjust stack and return
3296#    addu $sp,$sp,8 # adjust stack
3300#    sw $t0,($sp) # store result
3304#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3308:remainder:
    # get parameters; abort if divisor zero
3308#    lw $t0,($sp)
3312#    lw $t1,8($sp)
3316#    beq $t0,$zero,divByZeroError
    
    # perform division
3320#    div $t1,$t0
3324#    mfhi $t0

    # store result, adjust stack and return
3328#    addu $sp,$sp,8 # adjust stack
3332#    sw $t0,($sp) # store result
3336#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
3340:checkCast:
    # get object, allow immediately if null
3340#    lw $t2,($sp)
3344#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
3348#    lw $t2,-12($t2) # vtable address
3352#    bge $t2,$t1,castException
3353##...slt $at,$t2,$t1
3357##...beq $at,$zero,3492
3360#    blt $t2,$t0,castException
3361##...slt $at,$t2,$t0
3365##...bne $at,$zero,3492
    
    # return, leaving object unchanged on stack
3368:  checkCastReturn:    
3368#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
3372:instanceOf:
    # get object, go return false if null
3372#    lw $t2,($sp)
3376#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
3380#    lw $t2,-12($t2) # vtable address
3384#    sge $t0,$t2,$t0 # are we >= the lower limit?
3385##...slt $t0,$t2,$t0
3389##...xori $t0,$t0,0x1
3392#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
3396#    and $t2,$t0,$t1
3400#    sw $t2,($sp)
3404:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
3404#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

3408:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
3408#    li $v0,4 # syscall-code for print-string
3412#    syscall
3416:exit:
    # print termination message
3416#    li $v0,4 # syscall-code for print-string
3420#    la $a0,exitString
3424#    syscall

    # terminate execution
3428#    li $v0,10 #syscall-code for "exit"
3432#    syscall

3436:outOfHeapMemory:
3436#    la $a0,heapMemoryMsg
3440#    j exitError
3444:divByZeroError:
3444#    la $a0,divByZeroMsg
3448#    j exitError
3452:strIndexOutOfBounds:
3452#    la $a0,strIndexOutOfBoundsMsg
3456#    j exitError
3460:arrayIndexOutOfBounds:
3460#    la $a0,arrayIndexOutOfBoundsMsg
3464#    j exitError
3468:arraySizeOutOfBounds:
3468#    la $a0,arraySizeOutOfBoundsMsg
3472#    j exitError
3476:nullPtrException:
3476#    la $a0,nullPtrExceptionMsg
3480#    j exitError
3484:badIntegerFormat:
3484#    la $a0,badIntegerFormatMsg
3488#    j exitError
3492:castException:
3492#    la $a0,castExceptionMsg
3496#    j exitError
############## data section ################
    .data
3700:hexChars:
    .ascii "0123456789abcdef"
    .align 2
3716:cur_seg:
    .word 0

3720:lastCharRead:
    .word -2 # -2 => no buffered character
3724:prevHashConstant:
    .word 0x2785173c
3728:gcCount:
    .word 0

3732:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
3759:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
3782:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
3817:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
3851:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
3884:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
3915:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
3963:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
3984:gcMsg: 
      .asciiz "\nGC!\n"
3990:gcCountMsg: 
      .asciiz "Number of garbage collections: "

4022:nullStr:
    .asciiz "null"
4027:trueString:
    .asciiz "true"
4032:falseString:
    .asciiz "false"
4038:exitString:
    .ascii "Program terminated."
    #### "falls through" here
4057:newlineString:
    .asciiz "\n"
    
    .align 2
4060:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

4064:seg0_start:
    .space 0x100000
1052640:seg0_end:
1052640:seg1_start:
