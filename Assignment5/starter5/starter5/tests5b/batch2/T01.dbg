########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
4904:vm_init:

    # mark bottom of stack
4904#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
4908#    move $s2,$zero

    #set up the "five" register
4912#    li $s5,5

4916#    la $s3,seg0_start
4920#    la $s4,seg0_end
4921##...lui $s4,16
4925##...addiu $s4,$s4,5904
    
    # return
4928#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4932:divide:
    # get parameters; abort if divisor zero
4932#    lw $t0,($sp)
4936#    lw $t1,8($sp)
4940#    beq $t0,$zero,divByZeroError
    
    # perform division
4944#    div $t1,$t0
4948#    mflo $t0

    # store result, adjust stack and return
4952#    addu $sp,$sp,8 # adjust stack
4956#    sw $t0,($sp) # store result
4960#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4964:remainder:
    # get parameters; abort if divisor zero
4964#    lw $t0,($sp)
4968#    lw $t1,8($sp)
4972#    beq $t0,$zero,divByZeroError
    
    # perform division
4976#    div $t1,$t0
4980#    mfhi $t0

    # store result, adjust stack and return
4984#    addu $sp,$sp,8 # adjust stack
4988#    sw $t0,($sp) # store result
4992#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
4996:checkCast:
    # get object, allow immediately if null
4996#    lw $t2,($sp)
5000#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
5004#    lw $t2,-12($t2) # vtable address
5008#    bge $t2,$t1,castException
5009##...slt $at,$t2,$t1
5013##...beq $at,$zero,5184
5016#    blt $t2,$t0,castException
5017##...slt $at,$t2,$t0
5021##...bne $at,$zero,5184
    
    # return, leaving object unchanged on stack
5024:  checkCastReturn:    
5024#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
5028:instanceOf:
    # get object, go return false if null
5028#    lw $t2,($sp)
5032#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
5036#    lw $t2,-12($t2) # vtable address
5040#    sge $t0,$t2,$t0 # are we >= the lower limit?
5041##...slt $t0,$t2,$t0
5045##...xori $t0,$t0,0x1
5048#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
5052#    and $t2,$t0,$t1
5056#    sw $t2,($sp)
5060:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
5060#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

5064:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
5064#    li $v0,4 # syscall-code for print-string
5068#    syscall
5072:exit:
    # print termination message
5072#    li $v0,4 # syscall-code for print-string
5076#    la $a0,exitString
5080#    syscall

    # print number of garbage collections
5084#    li $v0,4 # syscall-code for print-string
5088#    la $a0,gcCountMsg
5092#    syscall # print "Number of ..."
5096#    lw $a0,gcCount # number of GC's
5100#    li $v0,1 # code for print-int
5104#    syscall
5108#    li $v0,4 # syscall-code for print-string
5112#    la $a0,newlineString
5116#    syscall # print newline

    # terminate execution
5120#    li $v0,10 #syscall-code for "exit"
5124#    syscall

5128:outOfHeapMemory:
5128#    la $a0,heapMemoryMsg
5132#    j exitError
5136:divByZeroError:
5136#    la $a0,divByZeroMsg
5140#    j exitError
5144:strIndexOutOfBounds:
5144#    la $a0,strIndexOutOfBoundsMsg
5148#    j exitError
5152:arrayIndexOutOfBounds:
5152#    la $a0,arrayIndexOutOfBoundsMsg
5156#    j exitError
5160:arraySizeOutOfBounds:
5160#    la $a0,arraySizeOutOfBoundsMsg
5164#    j exitError
5168:nullPtrException:
5168#    la $a0,nullPtrExceptionMsg
5172#    j exitError
5176:badIntegerFormat:
5176#    la $a0,badIntegerFormatMsg
5180#    j exitError
5184:castException:
5184#    la $a0,castExceptionMsg
5188#    j exitError
############## data section ################
    .data
5532:hexChars:
    .ascii "0123456789abcdef"
    .align 2
5548:cur_seg:
    .word 0

5552:lastCharRead:
    .word -2 # -2 => no buffered character
5556:prevHashConstant:
    .word 0x2785173c
5560:gcCount:
    .word 0

5564:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
5591:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
5614:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
5649:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
5683:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
5716:nullPtrExceptionMsg:
