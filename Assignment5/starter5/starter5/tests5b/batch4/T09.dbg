###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
3576:mth_equals_String:
    
    # quick test for obvious false
3576#    lw $t0,($sp) # second parameter
3580#    beq $t0,$zero,goEsFalse # go return false if null
3584#    lw $t1,-12($t0) # vtable pointer
3588#    la $t2,CLASS_String # string vtable pointer
3592#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
3596#    subu $sp,12
3600#    sw $ra,8($sp)
3604#    sw $s2,4($sp)
3608#    sw $t0,($sp)
3612#    jal mth_compareTo_String
3616#    lw $s2, 4($sp) #restore this pointer and pop parameters
3620#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
3624#    seq $t0,$t0,$zero
3625##...subu $at,$t0,$zero
3629##...sltiu $t0,$at,1

    # pop return address and return $t0
3632#    lw $ra,($sp)
3636#    addu $sp,4

3640#    jr $ra # return
    
3644:goEsFalse:
    # put 0 in $t0 and return
3644#    li $t0, 0
3648#    jr $ra # return
