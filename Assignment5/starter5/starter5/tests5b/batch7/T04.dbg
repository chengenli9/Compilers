2032#    lw $t0,($sp)
2036#    bne $t0,$zero,psNotNull

    # print "(null)"
2040#    la $a0,nullStr
2044#    li $v0,4
2048#    syscall
2052#    j donePrintStr
    
2056:  psNotNull:
    ##### we have a non-null string #####
    # this means that:
    # - number of data words in -8($t0):
    #   - if the sign bit is 1, the low 31 bits
    #   - if the sign bit is 0, the low 8 bits
    # - negative of number of characters in string is in -4($t0)
    # - string begins at $t0-8-(#dataWords*4), stored 1 char per byte
2056#    subu $t0,$t0,8
2060#    lw $t1,($t0) # number of data words, but needs modification
2064#    blt $t1,$zero,skipPrintStr1
