# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
4348:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
4348#    lw $t0,-8($s2) # get word with hash bits from this
4352#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
4356#    addu $t0,$t1

4360#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
4364:mth_equals_Object:
4364#    move $t0,$s2 # first pointer (this)
4368#    lw $t1,($sp) # second pointer
4372#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
4373##...subu $at,$t0,$t1
4377##...sltiu $t0,$at,1

4380#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
4384:mth_hashCode_String:
4384#    move $t0,$s2 # put this pointer in t0

4388#    li $t2,0 # current hash value
4392#    lw $t1,-4($t0) # negative of number of characters in string
4396#    beq $t1,$zero,done_hashCode_String # if zero length => done
4400#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
4404#    and $t0,0xfffffffc # adjust for padding
4405##...lui $at,65535
4409##...ori $at,$at,0xfffc
4413##...and $t0,$t0,$at
4416#    subu $t1,$t0,$t1 # address at end of string +12
4420:loop_hashCode_String:    
4420#    sll $t4,$t2,5 # multiply by 32
4424#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
4428#    lbu $t3,-12($t0) # current character
4432#    addu $t2,$t3 # add in current character
4436#    addu $t0,1 # go to next character's address
4440#    bne $t0,$t1,loop_hashCode_String # loop back if more
4444:done_hashCode_String:    

    # push int on stack
4444#    move $t0, $t2 # put $t2 in return slot
4448#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
4452:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
4452#    subu $sp,4
4456#    sw $ra,($sp)
    
    # get hash value
4460#    lw $t2,-12($s2) # vtable address
4464#    lw $t0,($t2) # method address
4468#    jalr $t0
4472#    subu $sp,8 # push result (int in $t0) on stack
4476#    sw $s5,4($sp)
4480#    sw $t0,($sp)

    # compute print-size of hash value
4484#    li $t0, 1
4488#    lw $t1, ($sp)
4492#    srl $t1,$t1,4
4496#    beq $t1,$zero,toString_skip_loop
4500:toString_loop_top:
4500#    addu $t0,1
4504#    srl $t1,$t1,4
4508#    bne $t1,$zero,toString_loop_top
4512:toString_skip_loop:
4512#    subu $sp,8
4516#    sw $s5,4($sp)
4520#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
4524#    lw $t2,-12($s2) # vtable address
4528#    move $t0,$t2
4532:toString_checkTagBit:
4532#    subu $t0,1
4536#    lb $t1,($t0)
4540#    and $t1,0x80
4541##...lui $at,0
4545##...ori $at,$at,0x80
4549##...and $t1,$t1,$at
4552#    beq $t1,$zero,toString_checkTagBit
4556#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
4560#    subu $sp,8
4564#    sw $t1,($sp)
4568#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
4572#    move $s7,$zero # -4 offset header word
4576#    lw $t4,8($sp) # bytes for hash value
4580#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
4584#    addu $t4,8
4588#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
4592#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

4596#    li $t0,CLASS_String # store string vtable address into ...
4600#    sw $t0,-12($s7) # ... -12 offset in object header
4604#    lw $t2,-12($s2) # our object's vtable address
4608#    lw $t5,4($sp) # number characters in prefix
4612#    lw $t1,12($sp) # number of characters in hashcode
4616#    addu $t3,$t1,$t5 # number of characters in string ...
4620#    addu $t3,1 # ... including the '@' character
4624#    subu $t0,$zero,$t3 # store negated length into ...
4628#    sw $t0,-4($s7) # ... -4 offset header word
4632#    lw $t0,-8($s7) # get -8 offset header-word
4636#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
4637##...slt $at,$t0,$zero
4641##...beq $at,$zero,4660
4644#    and $t0,0xff # mask off object's hash value ...
4645##...lui $at,0
4649##...ori $at,$at,0xff
4653##...and $t0,$t0,$at
4656#    sw $t0,-8($s7) # ... and store back into -8 header-word
4660:skipMask_toString:
4660#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
4664#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
4668#    subu $t4,$t2,$t5
4672:toString_copyLoop:    
4672#    lb $t3,($t4)
4676#    and $t3,0x7f # mask off sign bit (in case first word)
4677##...lui $at,0
4681##...ori $at,$at,0x7f
4685##...and $t3,$t3,$at
4688#    sb $t3,-8($t0)
4692#    addu $t4,1
4696#    addu $t0,1
4700#    blt $t4,$t2,toString_copyLoop
4701##...slt $at,$t4,$t2
4705##...bne $at,$zero,4672

    # copy the '@' sign
4708#    li $t3,'@'
4712#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
4716#    addu $t2,$t0,$t1 # address of last byte in string to store +8
4720#    lw $t3,20($sp) # hash code to print
4724:toString_hashCopyLoop:
4724#    and $t4,$t3,0xf
4728#    srl $t3,4
4732#    lb $t4,hexChars($t4)
4736#    sb $t4,-8($t2)
4740#    subu $t2,$t2,1
4744#    bgt $t2,$t0,toString_hashCopyLoop
4745##...slt $at,$t0,$t2
4749##...bne $at,$zero,4724

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
4752#    addu $sp,28
4756#    lw $ra,($sp)
4760#    addu $sp,4
4764#    move $t0, $s7 # return string we created
4768#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
4772:mth_equals_String:
    
    # quick test for obvious false
4772#    lw $t0,($sp) # second parameter
4776#    beq $t0,$zero,goEsFalse # go return false if null
4780#    lw $t1,-12($t0) # vtable pointer
4784#    la $t2,CLASS_String # string vtable pointer
4788#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
4792#    subu $sp,12
4796#    sw $ra,8($sp)
4800#    sw $s2,4($sp)
4804#    sw $t0,($sp)
4808#    jal mth_compareTo_String
4812#    lw $s2, 4($sp) #restore this pointer and pop parameters
4816#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
4820#    seq $t0,$t0,$zero
4821##...subu $at,$t0,$zero
4825##...sltiu $t0,$at,1

    # pop return address and return $t0
4828#    lw $ra,($sp)
4832#    addu $sp,4

4836#    jr $ra # return
    
4840:goEsFalse:
    # put 0 in $t0 and return
4840#    li $t0, 0
4844#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
4848:mth_toString_String:
    #we are a string, so return this.
4848#    move $t0, $s2
4852#    jr $ra

###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
4856:mth_readLine_Lib:
    
4856#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
4860#    sw $ra, 4($sp) # save $ra
4864#    move $t1,$sp # save "original" sp

4868:  doRead:

    # read the character
4868#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
4872#    subu $t2,$v0,13
4876#    bne $t2,$zero,notReturnRL
4880#    jal readLogicalChar
4884#    subu $t2,$v0,10 # check for newline
4888#    beq $t2,$zero,foundNewLine
4892#    sw $v0,lastCharRead # push back character into queue
4896#    j foundNewLine # go process the line

4900:  notReturnRL:

    # at this point, $v0 has our character

4900#    subu $t0,$v0,10
4904#    beq $t0,$zero,foundNewLine
4908#    blt $v0,$zero,foundEof
4909##...slt $at,$v0,$zero
4913##...bne $at,$zero,4928

    # we have a character, so push it onto stack
4916#    subu $sp,$sp,4
4920#    sw $v0,($sp)

    # loop back up to get next character
4924#    j doRead

4928:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
4928#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
4932#    li $s7, 0 # return-value: null
4936#    j rlReturn # return

4940:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
4940#    subu $t0,$t1,$sp # number of chars we read (times 4)
4944#    srl $s6,$t0,2 # number of words on stack with chars
4948#    subu $sp,$sp,4 # push char-count ...
4952#    sw $s6,($sp) # ... onto stack
4956#    addu $t2,$t0,5 # GC tag, incl. for count-word
4960#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
4964#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
4968#    srl $s6,$s6,2  # data words in object
4972#    move $s7,$zero # object words in object
4976#    jal newObject  # allocate space
    
    # store header words
4980#    la $t0,CLASS_String
4984#    sw $t0,-12($s7)# store class tag (String) into object
4988#    lw $t2,4($sp) # char-count
4992#    sll $t1,$t2,2 # 4 times number of chars
4996#    subu $t2,$zero,$t2 # negative of char-count
5000#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
5004#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
5008#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
5009##...slt $at,$t0,$zero
5013##...beq $at,$zero,5032
5016#    and $t0,0xff # mask off object's hash value ...
5017##...lui $at,0
5021##...ori $at,$at,0xff
5025##...and $t0,$t0,$at
5028#    sw $t0,-8($s7) # ... and store back into -8 header-word
5032:  skipMask_readLine:

5032#    sll $t0,$t0,2 # data bytes in object
5036#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
5040#    subu $t0,$t0,$t2 # place to store last character (plus 9)
5044#    addu $sp,$sp,8 # pop redundant object-pointer and count
5048#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

5052#    beq $sp,$t1,rlReturn
5056:  charCopyLoop:
5056#    lw $t2,($sp)
5060#    sb $t2,-9($t0)
5064#    addu $sp,$sp,4
5068#    subu $t0,$t0,1
5072#    bne $sp,$t1,charCopyLoop
5076:  rlReturn:

5076#    lw $ra, 4($sp)
5080#    addu $sp, 8   # pop $ra and pointless word off stack
5084#    move $t0, $s7 # return string we allocated in $s7
5088#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
5092:mth_readInt_Lib:

    # save $ra by pushing onto stack
5092#    subu $sp,$sp,4
5096#    sw $ra,($sp)

5100:  riSkipWhiteLoop:
    # read a character
5100#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
5104#    subu $t0,$v0,32
5108#    bgt $t0,$zero,nonWhite
5109##...slt $at,$zero,$t0
5113##...bne $at,$zero,5156
5116#    beq $t0,$zero,riSkipWhiteLoop # start over if space
5120#    subu $t0,$v0,10
5124#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
5128#    subu $t0,$v0,9
5132#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
5136#    subu $t0,$v0,13
5140#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
5144#    subu $t0,$v0,12
5148#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
5152#    j badIntegerFormat # illegal integer char: abort program

5156:  nonWhite:
5156#    subu $t0,$v0,'-'
5160#    li $t4,1 # final multiplier
5164#    bne $t0,$zero,helpReadInt # go read
5168#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
5172#    jal readLogicalChar

5176:  helpReadInt:
5176#    li $t2,10
5180#    subu $t1,$v0,'0' # convert digit to 0-9 value
5184#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
5185##...sltu $at,$t1,$t2
5189##...beq $at,$zero,7472
5192#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

5196:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

5196#    jal readLogicalChar # read next character
5200#    subu $t1,$v0,'0' # convert digit to 0-9 value
5204#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
5205##...sltu $at,$t1,$t2
