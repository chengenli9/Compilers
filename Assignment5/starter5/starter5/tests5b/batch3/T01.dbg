###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
2516:mth_readLine_Lib:
    
2516#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
2520#    sw $ra, 4($sp) # save $ra
2524#    move $t1,$sp # save "original" sp

2528:  doRead:

    # read the character
2528#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
2532#    subu $t2,$v0,13
2536#    bne $t2,$zero,notReturnRL
2540#    jal readLogicalChar
2544#    subu $t2,$v0,10 # check for newline
2548#    beq $t2,$zero,foundNewLine
2552#    sw $v0,lastCharRead # push back character into queue
2556#    j foundNewLine # go process the line

2560:  notReturnRL:

    # at this point, $v0 has our character

2560#    subu $t0,$v0,10
2564#    beq $t0,$zero,foundNewLine
2568#    blt $v0,$zero,foundEof
2569##...slt $at,$v0,$zero
2573##...bne $at,$zero,2588

    # we have a character, so push it onto stack
2576#    subu $sp,$sp,4
2580#    sw $v0,($sp)

    # loop back up to get next character
2584#    j doRead

2588:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
2588#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
2592#    li $s7, 0 # return-value: null
2596#    j rlReturn # return

2600:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
2600#    subu $t0,$t1,$sp # number of chars we read (times 4)
2604#    srl $s6,$t0,2 # number of words on stack with chars
2608#    subu $sp,$sp,4 # push char-count ...
2612#    sw $s6,($sp) # ... onto stack
2616#    addu $t2,$t0,5 # GC tag, incl. for count-word
2620#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
2624#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
2628#    srl $s6,$s6,2  # data words in object
2632#    move $s7,$zero # object words in object
2636#    jal newObject  # allocate space
    
    # store header words
2640#    la $t0,CLASS_String
2644#    sw $t0,-12($s7)# store class tag (String) into object
2648#    lw $t2,4($sp) # char-count
2652#    sll $t1,$t2,2 # 4 times number of chars
2656#    subu $t2,$zero,$t2 # negative of char-count
2660#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
2664#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
2668#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
2669##...slt $at,$t0,$zero
2673##...beq $at,$zero,2692
2676#    and $t0,0xff # mask off object's hash value ...
2677##...lui $at,0
2681##...ori $at,$at,0xff
2685##...and $t0,$t0,$at
2688#    sw $t0,-8($s7) # ... and store back into -8 header-word
2692:  skipMask_readLine:

2692#    sll $t0,$t0,2 # data bytes in object
2696#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
2700#    subu $t0,$t0,$t2 # place to store last character (plus 9)
2704#    addu $sp,$sp,8 # pop redundant object-pointer and count
2708#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

2712#    beq $sp,$t1,rlReturn
2716:  charCopyLoop:
2716#    lw $t2,($sp)
2720#    sb $t2,-9($t0)
2724#    addu $sp,$sp,4
2728#    subu $t0,$t0,1
2732#    bne $sp,$t1,charCopyLoop
2736:  rlReturn:

2736#    lw $ra, 4($sp)
2740#    addu $sp, 8   # pop $ra and pointless word off stack
2744#    move $t0, $s7 # return string we allocated in $s7
2748#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
2752:mth_readInt_Lib:

    # save $ra by pushing onto stack
2752#    subu $sp,$sp,4
2756#    sw $ra,($sp)

2760:  riSkipWhiteLoop:
    # read a character
2760#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
2764#    subu $t0,$v0,32
2768#    bgt $t0,$zero,nonWhite
2769##...slt $at,$zero,$t0
2773##...bne $at,$zero,2816
2776#    beq $t0,$zero,riSkipWhiteLoop # start over if space
2780#    subu $t0,$v0,10
2784#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
2788#    subu $t0,$v0,9
2792#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
2796#    subu $t0,$v0,13
2800#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
2804#    subu $t0,$v0,12
2808#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
2812#    j badIntegerFormat # illegal integer char: abort program

2816:  nonWhite:
2816#    subu $t0,$v0,'-'
2820#    li $t4,1 # final multiplier
2824#    bne $t0,$zero,helpReadInt # go read
2828#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
2832#    jal readLogicalChar

2836:  helpReadInt:
2836#    li $t2,10
2840#    subu $t1,$v0,'0' # convert digit to 0-9 value
2844#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
2845##...sltu $at,$t1,$t2
2849##...beq $at,$zero,5132
2852#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

2856:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

2856#    jal readLogicalChar # read next character
2860#    subu $t1,$v0,'0' # convert digit to 0-9 value
2864#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
2865##...sltu $at,$t1,$t2
2869##...beq $at,$zero,2888

2872#    mul $t3,$t3,$t2 # multiply old value by 10
2873##...mult $t3,$t2
2877##...mflo $t3
2880#    addu $t3,$t3,$t1 # add in value of new digit
2884#    j digitLoop

2888:  doneDigitLoop:

    # "push back" unused character into queue
2888#    sw $v0,lastCharRead

    # restore return address
2892#    lw $ra,($sp)
2896#    addu $sp, 4

    # multiply by sign and put return value in $t0
2900#    mult $t3,$t4 # multiply to account for poss. minus sign
2904#    mflo $t3
2908#    move $t0, $t3
    
    # return
2912#    jr $ra

###################################################################
# readChar() - library method (class Lib)
# - reads a single character from standard input
# - returns the integer that is the encoding of the character
# - returns -1 if end of file was encountered
# - parameter:
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
2916:mth_readChar_Lib:

    # save $ra by pushing onto stack
2916#    subu $sp,$sp,4
2920#    sw $ra,($sp)

      # read the character
2924#    jal readLogicalChar

    # restore return address; put value in $t0
    # replacing this-pointer saved return address
2928#    lw $ra,($sp)
2932#    addu $sp, 4
2936#    move $t0, $v0

    # return
2940#    jr $ra

########################################################
# printStr(str) - library method (class Lib)
