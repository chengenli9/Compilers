1317##...bne $at,$zero,1336
1320#    and $t1,0xff # mask out all but low byte
1321##...lui $at,0
1325##...ori $at,$at,0xff
1329##...and $t1,$t1,$at
1332#    b skipPrintStr2
1336:skipPrintStr1:
1336#    and $t1,0x7ffffff
1337##...lui $at,2047
1341##...ori $at,$at,0xffff
1345##...and $t1,$t1,$at
1348:skipPrintStr2:    
1348#    sll $t1,$t1,2
1352#    subu $t1,$t0,$t1 # first word in string
1356#    lw $t0,4($t0) # negative of string-length
1360#    subu $t0,$t1,$t0 # byte just beyond last char in string

    # print the chars in the string
1364#    beq $t0,$t1,donePrintStr
1368:  psLoop:
1368#    lb $a0,($t1) # next byte
1372#    li $v0,11 # code for printing char
1376#        syscall # print the char
1380#    addu $t1,$t1,1 # go to next char
1384#    blt $t1,$t0,psLoop
1385##...slt $at,$t1,$t0
1389##...bne $at,$zero,1368

1392:  donePrintStr:
1392#    jr $ra
