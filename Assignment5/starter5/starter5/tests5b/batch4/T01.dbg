    #   object that tells where the pointers in the object end
    # - $t8 will contain a pointer to the target object
    # - available for use: $s0, $t8, $t9
    ##########################################################

    # compute the amount of space that is needed
5244#    bge $t8,$zero,gcSkip5 # # words in negative-offset portion
5245##...slt $at,$t8,$zero
5249##...beq $at,$zero,5264
5252#    and $t8,0xff # mask off hash bits
5253##...lui $at,0
5257##...ori $at,$at,0xff
5261##...and $t8,$t8,$at

5264:  gcSkip5:
5264#    sll $t8,$t8,2 # bytes in negative-offset portion ...
5268#    addu $t8,$t8,8 # ... add in bytes for header-words
5272#    subu $t4,$t1,$t8 # address of first word of source object
5276#    lw $t3,-4($t1) # # words in positive-offset portion
5280#    bge $t3,$zero,gcNoNeg
5281##...slt $at,$t3,$zero
5285##...beq $at,$zero,5292
5288#    move $t3,$zero # negative treated as zero
5292:  gcNoNeg:
5292#    sll $t3,$t3,2 # bytes in negative-offset portion
5296#    addu $t3,$t3,$t1 # address one word past last word of source

5300#    addu $t8,$s3,$t8 # pointer to target object

    #########################################################
    # At this point:
    # - $t0 contains the address of the stack slot we'll
    #   process next
    # - $t1 contains the contents of the stack slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $t8 contains the pointer to the target object
    # - $s1 contains the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0, $t9
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger"
5304#    lw $s0,($t4)
5308#    lw $t9,-8($t1)
5312#    sw $t9,($t4)
5316#    sw $s0,-8($t1)

    # copy all source bytes to the target
5320:  gCinnerCopy2:
5320#    lw $s0,($t4)
5324#    sw $s0,($s3)
5328#    addu $t4,$t4,4
5332#    addu $s3,$s3,4
5336#    bltu $t4,$t3,gCinnerCopy2
5337##...sltu $at,$t4,$t3
5341##...bne $at,$zero,5320

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
5344#    sw $zero,-8($t1) # 0 in first header-slot
5348#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
5352#    sw $t8,($t0)

5356:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
5356#    addu $t0,$t0,4
5360#    bltu $t0,$s1,gcNextPointerInObject
5361##...sltu $at,$t0,$s1
5365##...bne $at,$zero,5204

5368:  gcTestIterDone2:
5368#    bltu $t0,$s3,gcHeapCopyLoop
5369##...sltu $at,$t0,$s3
5373##...bne $at,$zero,5088

    ###### end outer loop to copy all non-stack-direct objects ######

5376:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
5376#    lw $s2,($sp)
5380#    addu $sp,$sp,4

    # mark us as having already GC'd
5384#    move $t5,$s5

    # go try and allocate again
5388#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
5392:vm_init:

    # mark bottom of stack
5392#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
5396#    move $s2,$zero

    #set up the "five" register
5400#    li $s5,5

5404#    la $s3,seg0_start
5408#    la $s4,seg0_end
5409##...lui $s4,16
5413##...addiu $s4,$s4,6380
    
    # return
5416#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
5420:divide:
    # get parameters; abort if divisor zero
5420#    lw $t0,($sp)
5424#    lw $t1,8($sp)
5428#    beq $t0,$zero,divByZeroError
    
    # perform division
5432#    div $t1,$t0
5436#    mflo $t0

    # store result, adjust stack and return
5440#    addu $sp,$sp,8 # adjust stack
5444#    sw $t0,($sp) # store result
5448#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
5452:remainder:
    # get parameters; abort if divisor zero
5452#    lw $t0,($sp)
5456#    lw $t1,8($sp)
5460#    beq $t0,$zero,divByZeroError
    
    # perform division
5464#    div $t1,$t0
5468#    mfhi $t0

    # store result, adjust stack and return
5472#    addu $sp,$sp,8 # adjust stack
5476#    sw $t0,($sp) # store result
5480#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
5484:checkCast:
    # get object, allow immediately if null
5484#    lw $t2,($sp)
5488#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
5492#    lw $t2,-12($t2) # vtable address
5496#    bge $t2,$t1,castException
5497##...slt $at,$t2,$t1
5501##...beq $at,$zero,5636
5504#    blt $t2,$t0,castException
5505##...slt $at,$t2,$t0
5509##...bne $at,$zero,5636
    
    # return, leaving object unchanged on stack
5512:  checkCastReturn:    
5512#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
5516:instanceOf:
    # get object, go return false if null
5516#    lw $t2,($sp)
5520#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
5524#    lw $t2,-12($t2) # vtable address
5528#    sge $t0,$t2,$t0 # are we >= the lower limit?
5529##...slt $t0,$t2,$t0
5533##...xori $t0,$t0,0x1
5536#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
5540#    and $t2,$t0,$t1
5544#    sw $t2,($sp)
5548:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
5548#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

5552:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
5552#    li $v0,4 # syscall-code for print-string
5556#    syscall
5560:exit:
    # print termination message
5560#    li $v0,4 # syscall-code for print-string
5564#    la $a0,exitString
5568#    syscall

    # terminate execution
5572#    li $v0,10 #syscall-code for "exit"
5576#    syscall

5580:outOfHeapMemory:
5580#    la $a0,heapMemoryMsg
5584#    j exitError
5588:divByZeroError:
5588#    la $a0,divByZeroMsg
5592#    j exitError
5596:strIndexOutOfBounds:
5596#    la $a0,strIndexOutOfBoundsMsg
5600#    j exitError
5604:arrayIndexOutOfBounds:
5604#    la $a0,arrayIndexOutOfBoundsMsg
5608#    j exitError
5612:arraySizeOutOfBounds:
5612#    la $a0,arraySizeOutOfBoundsMsg
5616#    j exitError
5620:nullPtrException:
5620#    la $a0,nullPtrExceptionMsg
5624#    j exitError
5628:badIntegerFormat:
5628#    la $a0,badIntegerFormatMsg
5632#    j exitError
5636:castException:
5636#    la $a0,castExceptionMsg
5640#    j exitError
############## data section ################
    .data
6016:hexChars:
    .ascii "0123456789abcdef"
    .align 2
6032:cur_seg:
    .word 0

6036:lastCharRead:
    .word -2 # -2 => no buffered character
6040:prevHashConstant:
    .word 0x2785173c
6044:gcCount:
    .word 0

6048:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
6075:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
6098:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
6133:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
6167:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
6200:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
6231:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
6279:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
6300:gcMsg: 
      .asciiz "\nGC!\n"
6306:gcCountMsg: 
      .asciiz "Number of garbage collections: "

6338:nullStr:
    .asciiz "null"
6343:trueString:
    .asciiz "true"
6348:falseString:
    .asciiz "false"
6354:exitString:
    .ascii "Program terminated."
    #### "falls through" here
6373:newlineString:
    .asciiz "\n"
    
    .align 2
6376:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

6380:seg0_start:
    .space 0x100000
1054956:seg0_end:
1054956:seg1_start:
    .space 0x100000
2103532:seg1_end:
