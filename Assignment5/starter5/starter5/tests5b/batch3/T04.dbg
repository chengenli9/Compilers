###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
2840:mth_equals_String:
    
    # quick test for obvious false
2840#    lw $t0,($sp) # second parameter
2844#    beq $t0,$zero,goEsFalse # go return false if null
2848#    lw $t1,-12($t0) # vtable pointer
2852#    la $t2,CLASS_String # string vtable pointer
2856#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
2860#    subu $sp,12
2864#    sw $ra,8($sp)
2868#    sw $s2,4($sp)
2872#    sw $t0,($sp)
2876#    jal mth_compareTo_String
2880#    lw $s2, 4($sp) #restore this pointer and pop parameters
2884#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
2888#    seq $t0,$t0,$zero
2889##...subu $at,$t0,$zero
2893##...sltiu $t0,$at,1

    # pop return address and return $t0
2896#    lw $ra,($sp)
2900#    addu $sp,4

2904#    jr $ra # return
    
2908:goEsFalse:
    # put 0 in $t0 and return
2908#    li $t0, 0
2912#    jr $ra # return

