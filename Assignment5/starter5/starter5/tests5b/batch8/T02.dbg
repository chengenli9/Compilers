##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1680:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
1680#    lw $t0,-8($s2) # get word with hash bits from this
1684#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
1688#    addu $t0,$t1

1692#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1696:mth_equals_Object:
1696#    move $t0,$s2 # first pointer (this)
1700#    lw $t1,($sp) # second pointer
1704#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
1705##...subu $at,$t0,$t1
1709##...sltiu $t0,$at,1

1712#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1716:mth_hashCode_String:
1716#    move $t0,$s2 # put this pointer in t0

1720#    li $t2,0 # current hash value
1724#    lw $t1,-4($t0) # negative of number of characters in string
1728#    beq $t1,$zero,done_hashCode_String # if zero length => done
1732#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
1736#    and $t0,0xfffffffc # adjust for padding
1737##...lui $at,65535
1741##...ori $at,$at,0xfffc
1745##...and $t0,$t0,$at
1748#    subu $t1,$t0,$t1 # address at end of string +12
1752:loop_hashCode_String:    
1752#    sll $t4,$t2,5 # multiply by 32
1756#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
1760#    lbu $t3,-12($t0) # current character
1764#    addu $t2,$t3 # add in current character
1768#    addu $t0,1 # go to next character's address
1772#    bne $t0,$t1,loop_hashCode_String # loop back if more
1776:done_hashCode_String:    

    # push int on stack
1776#    move $t0, $t2 # put $t2 in return slot
1780#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
1784:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
1784#    subu $sp,4
1788#    sw $ra,($sp)
    
    # get hash value
1792#    lw $t2,-12($s2) # vtable address
1796#    lw $t0,($t2) # method address
1800#    jalr $t0
1804#    subu $sp,8 # push result (int in $t0) on stack
1808#    sw $s5,4($sp)
1812#    sw $t0,($sp)

    # compute print-size of hash value
1816#    li $t0, 1
1820#    lw $t1, ($sp)
1824#    srl $t1,$t1,4
1828#    beq $t1,$zero,toString_skip_loop
1832:toString_loop_top:
1832#    addu $t0,1
1836#    srl $t1,$t1,4
1840#    bne $t1,$zero,toString_loop_top
1844:toString_skip_loop:
1844#    subu $sp,8
1848#    sw $s5,4($sp)
1852#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
1856#    lw $t2,-12($s2) # vtable address
1860#    move $t0,$t2
1864:toString_checkTagBit:
1864#    subu $t0,1
1868#    lb $t1,($t0)
1872#    and $t1,0x80
1873##...lui $at,0
1877##...ori $at,$at,0x80
1881##...and $t1,$t1,$at
1884#    beq $t1,$zero,toString_checkTagBit
1888#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
1892#    subu $sp,8
1896#    sw $t1,($sp)
1900#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
1904#    move $s7,$zero # -4 offset header word
1908#    lw $t4,8($sp) # bytes for hash value
1912#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
1916#    addu $t4,8
1920#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
1924#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

1928#    li $t0,CLASS_String # store string vtable address into ...
1932#    sw $t0,-12($s7) # ... -12 offset in object header
1936#    lw $t2,-12($s2) # our object's vtable address
1940#    lw $t5,4($sp) # number characters in prefix
1944#    lw $t1,12($sp) # number of characters in hashcode
1948#    addu $t3,$t1,$t5 # number of characters in string ...
1952#    addu $t3,1 # ... including the '@' character
1956#    subu $t0,$zero,$t3 # store negated length into ...
1960#    sw $t0,-4($s7) # ... -4 offset header word
1964#    lw $t0,-8($s7) # get -8 offset header-word
1968#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
1969##...slt $at,$t0,$zero
1973##...beq $at,$zero,1992
1976#    and $t0,0xff # mask off object's hash value ...
1977##...lui $at,0
1981##...ori $at,$at,0xff
1985##...and $t0,$t0,$at
1988#    sw $t0,-8($s7) # ... and store back into -8 header-word
1992:skipMask_toString:
1992#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
1996#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
2000#    subu $t4,$t2,$t5
2004:toString_copyLoop:    
2004#    lb $t3,($t4)
2008#    and $t3,0x7f # mask off sign bit (in case first word)
2009##...lui $at,0
2013##...ori $at,$at,0x7f
2017##...and $t3,$t3,$at
2020#    sb $t3,-8($t0)
2024#    addu $t4,1
2028#    addu $t0,1
2032#    blt $t4,$t2,toString_copyLoop
2033##...slt $at,$t4,$t2
2037##...bne $at,$zero,2004

    # copy the '@' sign
2040#    li $t3,'@'
2044#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
2048#    addu $t2,$t0,$t1 # address of last byte in string to store +8
2052#    lw $t3,20($sp) # hash code to print
2056:toString_hashCopyLoop:
2056#    and $t4,$t3,0xf
2060#    srl $t3,4
2064#    lb $t4,hexChars($t4)
2068#    sb $t4,-8($t2)
2072#    subu $t2,$t2,1
2076#    bgt $t2,$t0,toString_hashCopyLoop
2077##...slt $at,$t0,$t2
2081##...bne $at,$zero,2056

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
2084#    addu $sp,28
2088#    lw $ra,($sp)
2092#    addu $sp,4
2096#    move $t0, $s7 # return string we created
2100#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
2104:mth_equals_String:
    
    # quick test for obvious false
2104#    lw $t0,($sp) # second parameter
2108#    beq $t0,$zero,goEsFalse # go return false if null
2112#    lw $t1,-12($t0) # vtable pointer
2116#    la $t2,CLASS_String # string vtable pointer
2120#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
2124#    subu $sp,12
2128#    sw $ra,8($sp)
2132#    sw $s2,4($sp)
2136#    sw $t0,($sp)
2140#    jal mth_compareTo_String
2144#    lw $s2, 4($sp) #restore this pointer and pop parameters
2148#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
2152#    seq $t0,$t0,$zero
2153##...subu $at,$t0,$zero
2157##...sltiu $t0,$at,1

    # pop return address and return $t0
2160#    lw $ra,($sp)
2164#    addu $sp,4

2168#    jr $ra # return
    
2172:goEsFalse:
    # put 0 in $t0 and return
2172#    li $t0, 0
2176#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
2180:mth_toString_String:
    #we are a string, so return this.
2180#    move $t0, $s2
2184#    jr $ra

###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
2188:mth_readLine_Lib:
    
2188#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
2192#    sw $ra, 4($sp) # save $ra
2196#    move $t1,$sp # save "original" sp

2200:  doRead:

    # read the character
2200#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
2204#    subu $t2,$v0,13
2208#    bne $t2,$zero,notReturnRL
2212#    jal readLogicalChar
2216#    subu $t2,$v0,10 # check for newline
2220#    beq $t2,$zero,foundNewLine
2224#    sw $v0,lastCharRead # push back character into queue
2228#    j foundNewLine # go process the line

2232:  notReturnRL:

    # at this point, $v0 has our character

2232#    subu $t0,$v0,10
2236#    beq $t0,$zero,foundNewLine
2240#    blt $v0,$zero,foundEof
2241##...slt $at,$v0,$zero
2245##...bne $at,$zero,2260

    # we have a character, so push it onto stack
2248#    subu $sp,$sp,4
2252#    sw $v0,($sp)

    # loop back up to get next character
2256#    j doRead

2260:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
2260#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
2264#    li $s7, 0 # return-value: null
2268#    j rlReturn # return

2272:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
2272#    subu $t0,$t1,$sp # number of chars we read (times 4)
2276#    srl $s6,$t0,2 # number of words on stack with chars
2280#    subu $sp,$sp,4 # push char-count ...
2284#    sw $s6,($sp) # ... onto stack
2288#    addu $t2,$t0,5 # GC tag, incl. for count-word
2292#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
2296#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
2300#    srl $s6,$s6,2  # data words in object
2304#    move $s7,$zero # object words in object
2308#    jal newObject  # allocate space
    
    # store header words
2312#    la $t0,CLASS_String
2316#    sw $t0,-12($s7)# store class tag (String) into object
2320#    lw $t2,4($sp) # char-count
2324#    sll $t1,$t2,2 # 4 times number of chars
2328#    subu $t2,$zero,$t2 # negative of char-count
2332#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
2336#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
2340#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
2341##...slt $at,$t0,$zero
2345##...beq $at,$zero,2364
2348#    and $t0,0xff # mask off object's hash value ...
2349##...lui $at,0
2353##...ori $at,$at,0xff
2357##...and $t0,$t0,$at
2360#    sw $t0,-8($s7) # ... and store back into -8 header-word
2364:  skipMask_readLine:

2364#    sll $t0,$t0,2 # data bytes in object
2368#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
2372#    subu $t0,$t0,$t2 # place to store last character (plus 9)
2376#    addu $sp,$sp,8 # pop redundant object-pointer and count
2380#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

