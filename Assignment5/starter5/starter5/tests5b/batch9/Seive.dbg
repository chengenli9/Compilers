########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
4624:vm_init:

    # mark bottom of stack
4624#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
4628#    move $s2,$zero

    #set up the "five" register
4632#    li $s5,5

4636#    la $s3,seg0_start
4640#    la $s4,seg0_end
4641##...lui $s4,16
4645##...addiu $s4,$s4,5504
    
    # return
4648#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4652:divide:
    # get parameters; abort if divisor zero
4652#    lw $t0,($sp)
4656#    lw $t1,8($sp)
4660#    beq $t0,$zero,divByZeroError
    
    # perform division
4664#    div $t1,$t0
4668#    mflo $t0

    # store result, adjust stack and return
4672#    addu $sp,$sp,8 # adjust stack
4676#    sw $t0,($sp) # store result
4680#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4684:remainder:
    # get parameters; abort if divisor zero
4684#    lw $t0,($sp)
4688#    lw $t1,8($sp)
4692#    beq $t0,$zero,divByZeroError
    
    # perform division
4696#    div $t1,$t0
4700#    mfhi $t0

    # store result, adjust stack and return
4704#    addu $sp,$sp,8 # adjust stack
4708#    sw $t0,($sp) # store result
4712#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
