###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
1680:mth_readLine_Lib:
    
1680#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
1684#    sw $ra, 4($sp) # save $ra
1688#    move $t1,$sp # save "original" sp

1692:  doRead:

    # read the character
1692#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
1696#    subu $t2,$v0,13
1700#    bne $t2,$zero,notReturnRL
1704#    jal readLogicalChar
1708#    subu $t2,$v0,10 # check for newline
1712#    beq $t2,$zero,foundNewLine
1716#    sw $v0,lastCharRead # push back character into queue
1720#    j foundNewLine # go process the line

1724:  notReturnRL:

    # at this point, $v0 has our character

1724#    subu $t0,$v0,10
1728#    beq $t0,$zero,foundNewLine
1732#    blt $v0,$zero,foundEof
1733##...slt $at,$v0,$zero
1737##...bne $at,$zero,1752

    # we have a character, so push it onto stack
1740#    subu $sp,$sp,4
1744#    sw $v0,($sp)

    # loop back up to get next character
1748#    j doRead

1752:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
1752#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
1756#    li $s7, 0 # return-value: null
1760#    j rlReturn # return

1764:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
1764#    subu $t0,$t1,$sp # number of chars we read (times 4)
1768#    srl $s6,$t0,2 # number of words on stack with chars
1772#    subu $sp,$sp,4 # push char-count ...
1776#    sw $s6,($sp) # ... onto stack
1780#    addu $t2,$t0,5 # GC tag, incl. for count-word
1784#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
1788#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
1792#    srl $s6,$s6,2  # data words in object
1796#    move $s7,$zero # object words in object
1800#    jal newObject  # allocate space
    
    # store header words
1804#    la $t0,CLASS_String
1808#    sw $t0,-12($s7)# store class tag (String) into object
1812#    lw $t2,4($sp) # char-count
1816#    sll $t1,$t2,2 # 4 times number of chars
1820#    subu $t2,$zero,$t2 # negative of char-count
1824#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
1828#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
1832#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
1833##...slt $at,$t0,$zero
1837##...beq $at,$zero,1856
1840#    and $t0,0xff # mask off object's hash value ...
1841##...lui $at,0
1845##...ori $at,$at,0xff
1849##...and $t0,$t0,$at
1852#    sw $t0,-8($s7) # ... and store back into -8 header-word
1856:  skipMask_readLine:

1856#    sll $t0,$t0,2 # data bytes in object
1860#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
1864#    subu $t0,$t0,$t2 # place to store last character (plus 9)
1868#    addu $sp,$sp,8 # pop redundant object-pointer and count
1872#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

1876#    beq $sp,$t1,rlReturn
1880:  charCopyLoop:
1880#    lw $t2,($sp)
1884#    sb $t2,-9($t0)
1888#    addu $sp,$sp,4
1892#    subu $t0,$t0,1
1896#    bne $sp,$t1,charCopyLoop
1900:  rlReturn:

1900#    lw $ra, 4($sp)
1904#    addu $sp, 8   # pop $ra and pointless word off stack
1908#    move $t0, $s7 # return string we allocated in $s7
1912#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
1916:mth_readInt_Lib:

    # save $ra by pushing onto stack
1916#    subu $sp,$sp,4
1920#    sw $ra,($sp)

1924:  riSkipWhiteLoop:
    # read a character
1924#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
1928#    subu $t0,$v0,32
1932#    bgt $t0,$zero,nonWhite
1933##...slt $at,$zero,$t0
1937##...bne $at,$zero,1980
1940#    beq $t0,$zero,riSkipWhiteLoop # start over if space
1944#    subu $t0,$v0,10
1948#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
1952#    subu $t0,$v0,9
1956#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
1960#    subu $t0,$v0,13
1964#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
1968#    subu $t0,$v0,12
1972#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
1976#    j badIntegerFormat # illegal integer char: abort program

1980:  nonWhite:
1980#    subu $t0,$v0,'-'
1984#    li $t4,1 # final multiplier
1988#    bne $t0,$zero,helpReadInt # go read
1992#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
1996#    jal readLogicalChar

2000:  helpReadInt:
2000#    li $t2,10
2004#    subu $t1,$v0,'0' # convert digit to 0-9 value
2008#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
2009##...sltu $at,$t1,$t2
2013##...beq $at,$zero,4296
2016#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

2020:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

2020#    jal readLogicalChar # read next character
2024#    subu $t1,$v0,'0' # convert digit to 0-9 value
2028#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
2029##...sltu $at,$t1,$t2
2033##...beq $at,$zero,2052

2036#    mul $t3,$t3,$t2 # multiply old value by 10
2037##...mult $t3,$t2
2041##...mflo $t3
2044#    addu $t3,$t3,$t1 # add in value of new digit
2048#    j digitLoop

2052:  doneDigitLoop:

    # "push back" unused character into queue
2052#    sw $v0,lastCharRead

    # restore return address
2056#    lw $ra,($sp)
2060#    addu $sp, 4

    # multiply by sign and put return value in $t0
2064#    mult $t3,$t4 # multiply to account for poss. minus sign
2068#    mflo $t3
2072#    move $t0, $t3
    
    # return
2076#    jr $ra
