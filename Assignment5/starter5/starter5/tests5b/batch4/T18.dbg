2045##...bne $at,$zero,2064
2048#    and $t1,0xff # mask out all but low byte
2049##...lui $at,0
2053##...ori $at,$at,0xff
2057##...and $t1,$t1,$at
2060#    b skipPrintStr2
2064:skipPrintStr1:
2064#    and $t1,0x7ffffff
2065##...lui $at,2047
2069##...ori $at,$at,0xffff
2073##...and $t1,$t1,$at
2076:skipPrintStr2:    
2076#    sll $t1,$t1,2
2080#    subu $t1,$t0,$t1 # first word in string
2084#    lw $t0,4($t0) # negative of string-length
2088#    subu $t0,$t1,$t0 # byte just beyond last char in string

    # print the chars in the string
2092#    beq $t0,$t1,donePrintStr
2096:  psLoop:
2096#    lb $a0,($t1) # next byte
2100#    li $v0,11 # code for printing char
2104#        syscall # print the char
2108#    addu $t1,$t1,1 # go to next char
2112#    blt $t1,$t0,psLoop
2113##...slt $at,$t1,$t0
2117##...bne $at,$zero,2096

2120:  donePrintStr:
2120#    jr $ra

########################################################
# printInt(n) - library method (class Lib)
# - prints integer in decimal format to standard output
# - parameters:
