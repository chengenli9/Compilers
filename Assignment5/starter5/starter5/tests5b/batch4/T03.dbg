1608#    beq $t0,$zero,riSkipWhiteLoop # start over if space
1612#    subu $t0,$v0,10
1616#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
1620#    subu $t0,$v0,9
1624#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
1628#    subu $t0,$v0,13
1632#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
1636#    subu $t0,$v0,12
