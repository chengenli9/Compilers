    ###########################################################

    # set up the forwarding pointer
3876#    sw $zero,-8($t1) # 0 in first header-slot
3880#    sw $t2,-4($t1) # forwarding pointer in second header-slot

    # update the stack slot with the address in the target space
3884#    sw $t2,4($t0)
3888#    lw $zero,-8($t2)
3892#    lw $zero,-4($t2)

    # go handle next stack slot (testing if done)
3896#    j gcTestIterDone1

3900:  gcBump:
    #### we have a GC tag.  Bytes to skip: tag value + 3.
3900#    subu $t0,$t0,$t1
3904#    subu $t0,$t0,3

3908:  gcTestIterDone1:
3908#    bgeu $t0,$sp,gcStackCopyLoop
3909##...sltu $at,$t0,$sp
3913##...beq $at,$zero,3724

    ###### end outer loop to copy all stack-direct objects ######

    #############################################################
    # We have finished processing the stack elements.  Now we need
    # to update elements in the heap itself. This may itself involve
    # moving additional objects
    #############################################################

    #########################################################
    # At this point:
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # We want to set things up so that in addition:
    # - $t0 is the "trailing finger", containing the address
    #   of the first slot in target space that we have yet
    #   to process.
    # Then during processing:
    # - $t1 will contain the contents of the heap slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # And when we're actually copying an object:
    # - $t2 will contain pointer to the target object
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - available for use: $s0
    ##########################################################

    # set $t0 to be at the beginning of target-space
3916#    lw $t1,cur_seg
3920#    la $t0,seg0_start
3924#    beq $t1,$zero,gcSkip4
3928#    la $t0,seg1_start
3929##...lui $t0,16
3933##...addiu $t0,$t0,5168


3936:  gcSkip4:

    # if there were no objects put into the heap during stack
    # processing, we're done, so go finish up
3936#    bgeu $t0,$s3,gcFinishUp
3937##...sltu $at,$t0,$s3
3941##...beq $at,$zero,4232

    ###### begin outer loop to copy all non-stack-direct objects ######

3944:  gcHeapCopyLoop:
    # get data count for object; swap header-word with first word
    # of object so that they're back in the right place
3944#    lw $t1,($t0) # (what will be) first header word for current object
3948#    move $t2,$t1 # number data bytes in object (poss. w/hash bits)
3952#    bge $t2,$zero,gcSkip4a # are there hash bits?
3953##...slt $at,$t2,$zero
3957##...beq $at,$zero,3972
3960#    and $t2,0xff # mask off hash bits
3961##...lui $at,0
3965##...ori $at,$at,0xff
3969##...and $t2,$t2,$at
3972:gcSkip4a:    
3972#    sll $t2,$t2,2 # # data bytes
3976#    addu $t2,$t2,8 # to skip header words
3980#    addu $t2,$t0,$t2 # pointer to new object
3984#    lw $t3,-8($t2) # word to swap
3988#    sw $t1,-8($t2) # store header word
3992#    sw $t3,($t0) # restore first word of object

    ################################################
    # at this point:
    # - $t2 contains the pointer to our new object
    ################################################

    # check if we have a data array
3996#    lw $t1,-12($t2) # vtable pointer
4000#    li $t0,dataArrayVTableStart # address of vtable for first data array
4004#    blt $t1,$t0,gcNotDataArray # if data array, no more xforming to do
4005##...slt $at,$t1,$t0
4009##...bne $at,$zero,4028

    # We have a vtable address that is a data array.
    # we need skip over it then loop back to do next object.
4012:  skipToNextObj:
4012#    lw $t1,-4($t2) # data words in (object position of) array
    #### note: we know that it's not a string, so the value will
    #### not be artificially negative
4016#    sll $t1,$t1,2 # convert to byte-count
4020#    addu $t0,$t2,$t1 # skip over object
4024#    j gcTestIterDone2 # go do next object, if any

    ###################################################
    # at this point:
    # - the object has been restored to normal status--that is, the
    #   word-swap has been done
    # - $t2 contains a pointer to the object
    ###################################################
    
4028:  gcNotDataArray:
4028#    lw $t3,-4($t2) # # object words (negative treated as zero)
4032#    bge $t3,$zero,gcH2Neg2
4033##...slt $at,$t3,$zero
4037##...beq $at,$zero,4044
4040#    move $t3,$zero
4044:  gcH2Neg2:
4044#    sll $t3,$t3,2 # # object bytes
4048#    move $t0,$t2 # address of first pointer in object
4052#    add $s1,$t2,$t3 # limit address for this object

    #####################################################
    # At this point, we have to "translate" all pointers,
    # starting at $t0 to (but not including) $s1
    #####################################################

    # if there are no pointer-slots (i.e., $t0=$s1), skip this
    # part
4056#    beq $t0,$s1,gcTestIterDone2
    
4060:  gcNextPointerInObject:
    # get pointer from object
4060#    lw $t1,($t0)

    # if value is out of range, and is therefore does not refer
    # to an object, just go loop back and do the next one
4064#    bleu $t1,$t6,gcGoNextPointerSlot
4065##...sltu $at,$t6,$t1
4069##...beq $at,$zero,4212
4072#    bgtu $t1,$t7,gcGoNextPointerSlot
4073##...sltu $at,$t7,$t1
4077##...bne $at,$zero,4212

    # if the object has already been moved, update the stack-value
    # via the forwarding pointer
4080#    lw $t8,-8($t1) # possible forwarding tag
4084#    bne $t8,$zero,gcNoForward2 # if not forwarding tag, go copy
4088#    lw $t8,-4($t1) # forwarding pointer: object's new address
4092#    sw $t8,($t0) # update pointer in object
4096#    j gcGoNextPointerSlot # do next iteration

4100:  gcNoForward2:
    #########################################################
    # we actually need to copy the object into the new space
    #########################################################

    #########################################################
    # At this point:
    # - $t0 contains the address of the heap-slot we're translating
    # - $t1 will contain the contents of the heap-slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space, which will also be the first address
    #   of the target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # Then during processing:
    # And when we're actually copying an object:
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $t8 will contain a pointer to the target object
    # - available for use: $s0, $t8, $t9
    ##########################################################

    # compute the amount of space that is needed
4100#    bge $t8,$zero,gcSkip5 # # words in negative-offset portion
4101##...slt $at,$t8,$zero
4105##...beq $at,$zero,4120
4108#    and $t8,0xff # mask off hash bits
4109##...lui $at,0
4113##...ori $at,$at,0xff
4117##...and $t8,$t8,$at

4120:  gcSkip5:
4120#    sll $t8,$t8,2 # bytes in negative-offset portion ...
4124#    addu $t8,$t8,8 # ... add in bytes for header-words
4128#    subu $t4,$t1,$t8 # address of first word of source object
4132#    lw $t3,-4($t1) # # words in positive-offset portion
4136#    bge $t3,$zero,gcNoNeg
4137##...slt $at,$t3,$zero
4141##...beq $at,$zero,4148
4144#    move $t3,$zero # negative treated as zero
4148:  gcNoNeg:
4148#    sll $t3,$t3,2 # bytes in negative-offset portion
4152#    addu $t3,$t3,$t1 # address one word past last word of source

4156#    addu $t8,$s3,$t8 # pointer to target object

    #########################################################
    # At this point:
    # - $t0 contains the address of the stack slot we'll
    #   process next
    # - $t1 contains the contents of the stack slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $t8 contains the pointer to the target object
    # - $s1 contains the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0, $t9
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger"
4160#    lw $s0,($t4)
4164#    lw $t9,-8($t1)
4168#    sw $t9,($t4)
4172#    sw $s0,-8($t1)

    # copy all source bytes to the target
4176:  gCinnerCopy2:
4176#    lw $s0,($t4)
4180#    sw $s0,($s3)
4184#    addu $t4,$t4,4
4188#    addu $s3,$s3,4
4192#    bltu $t4,$t3,gCinnerCopy2
4193##...sltu $at,$t4,$t3
4197##...bne $at,$zero,4176

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
4200#    sw $zero,-8($t1) # 0 in first header-slot
4204#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
4208#    sw $t8,($t0)

4212:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
4212#    addu $t0,$t0,4
4216#    bltu $t0,$s1,gcNextPointerInObject
4217##...sltu $at,$t0,$s1
4221##...bne $at,$zero,4060

4224:  gcTestIterDone2:
4224#    bltu $t0,$s3,gcHeapCopyLoop
4225##...sltu $at,$t0,$s3
4229##...bne $at,$zero,3944

    ###### end outer loop to copy all non-stack-direct objects ######

4232:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
4232#    lw $s2,($sp)
4236#    addu $sp,$sp,4

    # mark us as having already GC'd
4240#    move $t5,$s5

    # go try and allocate again
4244#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
4248:vm_init:

    # mark bottom of stack
4248#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
4252#    move $s2,$zero

    #set up the "five" register
4256#    li $s5,5

4260#    la $s3,seg0_start
4264#    la $s4,seg0_end
4265##...lui $s4,16
4269##...addiu $s4,$s4,5168
    
    # return
4272#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4276:divide:
    # get parameters; abort if divisor zero
4276#    lw $t0,($sp)
4280#    lw $t1,8($sp)
4284#    beq $t0,$zero,divByZeroError
    
    # perform division
4288#    div $t1,$t0
4292#    mflo $t0

    # store result, adjust stack and return
4296#    addu $sp,$sp,8 # adjust stack
4300#    sw $t0,($sp) # store result
4304#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4308:remainder:
    # get parameters; abort if divisor zero
4308#    lw $t0,($sp)
4312#    lw $t1,8($sp)
4316#    beq $t0,$zero,divByZeroError
    
    # perform division
4320#    div $t1,$t0
4324#    mfhi $t0

    # store result, adjust stack and return
4328#    addu $sp,$sp,8 # adjust stack
4332#    sw $t0,($sp) # store result
4336#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
4340:checkCast:
    # get object, allow immediately if null
4340#    lw $t2,($sp)
4344#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
4348#    lw $t2,-12($t2) # vtable address
4352#    bge $t2,$t1,castException
4353##...slt $at,$t2,$t1
4357##...beq $at,$zero,4492
4360#    blt $t2,$t0,castException
4361##...slt $at,$t2,$t0
4365##...bne $at,$zero,4492
    
    # return, leaving object unchanged on stack
4368:  checkCastReturn:    
4368#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
4372:instanceOf:
    # get object, go return false if null
4372#    lw $t2,($sp)
4376#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
4380#    lw $t2,-12($t2) # vtable address
4384#    sge $t0,$t2,$t0 # are we >= the lower limit?
4385##...slt $t0,$t2,$t0
4389##...xori $t0,$t0,0x1
4392#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
4396#    and $t2,$t0,$t1
4400#    sw $t2,($sp)
4404:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
4404#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

4408:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
4408#    li $v0,4 # syscall-code for print-string
4412#    syscall
4416:exit:
    # print termination message
4416#    li $v0,4 # syscall-code for print-string
4420#    la $a0,exitString
4424#    syscall

    # terminate execution
4428#    li $v0,10 #syscall-code for "exit"
4432#    syscall

4436:outOfHeapMemory:
4436#    la $a0,heapMemoryMsg
4440#    j exitError
4444:divByZeroError:
4444#    la $a0,divByZeroMsg
4448#    j exitError
4452:strIndexOutOfBounds:
4452#    la $a0,strIndexOutOfBoundsMsg
4456#    j exitError
4460:arrayIndexOutOfBounds:
4460#    la $a0,arrayIndexOutOfBoundsMsg
4464#    j exitError
4468:arraySizeOutOfBounds:
4468#    la $a0,arraySizeOutOfBoundsMsg
4472#    j exitError
4476:nullPtrException:
4476#    la $a0,nullPtrExceptionMsg
4480#    j exitError
4484:badIntegerFormat:
4484#    la $a0,badIntegerFormatMsg
4488#    j exitError
4492:castException:
4492#    la $a0,castExceptionMsg
4496#    j exitError
############## data section ################
    .data
4804:hexChars:
    .ascii "0123456789abcdef"
    .align 2
4820:cur_seg:
    .word 0

4824:lastCharRead:
    .word -2 # -2 => no buffered character
4828:prevHashConstant:
    .word 0x2785173c
4832:gcCount:
    .word 0

4836:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
4863:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
4886:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
4921:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
4955:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
4988:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
5019:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
5067:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
5088:gcMsg: 
      .asciiz "\nGC!\n"
5094:gcCountMsg: 
      .asciiz "Number of garbage collections: "

5126:nullStr:
    .asciiz "null"
5131:trueString:
    .asciiz "true"
5136:falseString:
    .asciiz "false"
5142:exitString:
    .ascii "Program terminated."
