###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1588:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
1588#    lw $t0,-8($s2) # get word with hash bits from this
1592#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
1596#    addu $t0,$t1

1600#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1604:mth_equals_Object:
1604#    move $t0,$s2 # first pointer (this)
1608#    lw $t1,($sp) # second pointer
1612#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
1613##...subu $at,$t0,$t1
1617##...sltiu $t0,$at,1

1620#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1624:mth_hashCode_String:
1624#    move $t0,$s2 # put this pointer in t0

1628#    li $t2,0 # current hash value
1632#    lw $t1,-4($t0) # negative of number of characters in string
1636#    beq $t1,$zero,done_hashCode_String # if zero length => done
1640#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
1644#    and $t0,0xfffffffc # adjust for padding
1645##...lui $at,65535
1649##...ori $at,$at,0xfffc
1653##...and $t0,$t0,$at
1656#    subu $t1,$t0,$t1 # address at end of string +12
1660:loop_hashCode_String:    
1660#    sll $t4,$t2,5 # multiply by 32
1664#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
1668#    lbu $t3,-12($t0) # current character
1672#    addu $t2,$t3 # add in current character
1676#    addu $t0,1 # go to next character's address
1680#    bne $t0,$t1,loop_hashCode_String # loop back if more
1684:done_hashCode_String:    

    # push int on stack
1684#    move $t0, $t2 # put $t2 in return slot
1688#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
1692:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
1692#    subu $sp,4
1696#    sw $ra,($sp)
    
    # get hash value
1700#    lw $t2,-12($s2) # vtable address
1704#    lw $t0,($t2) # method address
1708#    jalr $t0
1712#    subu $sp,8 # push result (int in $t0) on stack
1716#    sw $s5,4($sp)
1720#    sw $t0,($sp)

    # compute print-size of hash value
1724#    li $t0, 1
1728#    lw $t1, ($sp)
1732#    srl $t1,$t1,4
1736#    beq $t1,$zero,toString_skip_loop
1740:toString_loop_top:
1740#    addu $t0,1
1744#    srl $t1,$t1,4
1748#    bne $t1,$zero,toString_loop_top
1752:toString_skip_loop:
1752#    subu $sp,8
1756#    sw $s5,4($sp)
1760#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
1764#    lw $t2,-12($s2) # vtable address
1768#    move $t0,$t2
1772:toString_checkTagBit:
1772#    subu $t0,1
1776#    lb $t1,($t0)
1780#    and $t1,0x80
1781##...lui $at,0
1785##...ori $at,$at,0x80
1789##...and $t1,$t1,$at
1792#    beq $t1,$zero,toString_checkTagBit
1796#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
1800#    subu $sp,8
1804#    sw $t1,($sp)
1808#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
1812#    move $s7,$zero # -4 offset header word
1816#    lw $t4,8($sp) # bytes for hash value
1820#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
1824#    addu $t4,8
1828#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
1832#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

1836#    li $t0,CLASS_String # store string vtable address into ...
1840#    sw $t0,-12($s7) # ... -12 offset in object header
1844#    lw $t2,-12($s2) # our object's vtable address
1848#    lw $t5,4($sp) # number characters in prefix
1852#    lw $t1,12($sp) # number of characters in hashcode
1856#    addu $t3,$t1,$t5 # number of characters in string ...
1860#    addu $t3,1 # ... including the '@' character
1864#    subu $t0,$zero,$t3 # store negated length into ...
1868#    sw $t0,-4($s7) # ... -4 offset header word
1872#    lw $t0,-8($s7) # get -8 offset header-word
1876#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
1877##...slt $at,$t0,$zero
1881##...beq $at,$zero,1900
1884#    and $t0,0xff # mask off object's hash value ...
1885##...lui $at,0
1889##...ori $at,$at,0xff
1893##...and $t0,$t0,$at
1896#    sw $t0,-8($s7) # ... and store back into -8 header-word
1900:skipMask_toString:
1900#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
1904#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
1908#    subu $t4,$t2,$t5
1912:toString_copyLoop:    
1912#    lb $t3,($t4)
1916#    and $t3,0x7f # mask off sign bit (in case first word)
1917##...lui $at,0
1921##...ori $at,$at,0x7f
1925##...and $t3,$t3,$at
1928#    sb $t3,-8($t0)
1932#    addu $t4,1
1936#    addu $t0,1
1940#    blt $t4,$t2,toString_copyLoop
1941##...slt $at,$t4,$t2
1945##...bne $at,$zero,1912

    # copy the '@' sign
1948#    li $t3,'@'
1952#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
1956#    addu $t2,$t0,$t1 # address of last byte in string to store +8
1960#    lw $t3,20($sp) # hash code to print
1964:toString_hashCopyLoop:
1964#    and $t4,$t3,0xf
1968#    srl $t3,4
1972#    lb $t4,hexChars($t4)
1976#    sb $t4,-8($t2)
1980#    subu $t2,$t2,1
1984#    bgt $t2,$t0,toString_hashCopyLoop
1985##...slt $at,$t0,$t2
1989##...bne $at,$zero,1964

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
1992#    addu $sp,28
1996#    lw $ra,($sp)
2000#    addu $sp,4
2004#    move $t0, $s7 # return string we created
2008#    jr $ra
