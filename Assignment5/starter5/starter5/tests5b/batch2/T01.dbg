###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
2560:mth_readLine_Lib:
    
2560#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
2564#    sw $ra, 4($sp) # save $ra
2568#    move $t1,$sp # save "original" sp

2572:  doRead:

    # read the character
2572#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
2576#    subu $t2,$v0,13
2580#    bne $t2,$zero,notReturnRL
2584#    jal readLogicalChar
2588#    subu $t2,$v0,10 # check for newline
2592#    beq $t2,$zero,foundNewLine
2596#    sw $v0,lastCharRead # push back character into queue
2600#    j foundNewLine # go process the line

2604:  notReturnRL:

    # at this point, $v0 has our character

2604#    subu $t0,$v0,10
2608#    beq $t0,$zero,foundNewLine
2612#    blt $v0,$zero,foundEof
2613##...slt $at,$v0,$zero
2617##...bne $at,$zero,2632

    # we have a character, so push it onto stack
2620#    subu $sp,$sp,4
2624#    sw $v0,($sp)

    # loop back up to get next character
2628#    j doRead

2632:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
2632#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
2636#    li $s7, 0 # return-value: null
2640#    j rlReturn # return

2644:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
2644#    subu $t0,$t1,$sp # number of chars we read (times 4)
2648#    srl $s6,$t0,2 # number of words on stack with chars
2652#    subu $sp,$sp,4 # push char-count ...
2656#    sw $s6,($sp) # ... onto stack
2660#    addu $t2,$t0,5 # GC tag, incl. for count-word
2664#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
2668#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
2672#    srl $s6,$s6,2  # data words in object
2676#    move $s7,$zero # object words in object
2680#    jal newObject  # allocate space
    
    # store header words
2684#    la $t0,CLASS_String
2688#    sw $t0,-12($s7)# store class tag (String) into object
2692#    lw $t2,4($sp) # char-count
2696#    sll $t1,$t2,2 # 4 times number of chars
2700#    subu $t2,$zero,$t2 # negative of char-count
2704#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
2708#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
2712#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
2713##...slt $at,$t0,$zero
2717##...beq $at,$zero,2736
2720#    and $t0,0xff # mask off object's hash value ...
2721##...lui $at,0
2725##...ori $at,$at,0xff
2729##...and $t0,$t0,$at
2732#    sw $t0,-8($s7) # ... and store back into -8 header-word
2736:  skipMask_readLine:

2736#    sll $t0,$t0,2 # data bytes in object
2740#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
2744#    subu $t0,$t0,$t2 # place to store last character (plus 9)
2748#    addu $sp,$sp,8 # pop redundant object-pointer and count
2752#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

2756#    beq $sp,$t1,rlReturn
2760:  charCopyLoop:
2760#    lw $t2,($sp)
2764#    sb $t2,-9($t0)
2768#    addu $sp,$sp,4
2772#    subu $t0,$t0,1
2776#    bne $sp,$t1,charCopyLoop
2780:  rlReturn:

2780#    lw $ra, 4($sp)
2784#    addu $sp, 8   # pop $ra and pointless word off stack
2788#    move $t0, $s7 # return string we allocated in $s7
2792#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
2796:mth_readInt_Lib:

    # save $ra by pushing onto stack
2796#    subu $sp,$sp,4
2800#    sw $ra,($sp)

2804:  riSkipWhiteLoop:
    # read a character
2804#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
2808#    subu $t0,$v0,32
2812#    bgt $t0,$zero,nonWhite
2813##...slt $at,$zero,$t0
2817##...bne $at,$zero,2860
2820#    beq $t0,$zero,riSkipWhiteLoop # start over if space
2824#    subu $t0,$v0,10
2828#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
2832#    subu $t0,$v0,9
2836#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
2840#    subu $t0,$v0,13
2844#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
2848#    subu $t0,$v0,12
2852#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
2856#    j badIntegerFormat # illegal integer char: abort program

2860:  nonWhite:
2860#    subu $t0,$v0,'-'
2864#    li $t4,1 # final multiplier
2868#    bne $t0,$zero,helpReadInt # go read
2872#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
2876#    jal readLogicalChar

2880:  helpReadInt:
2880#    li $t2,10
2884#    subu $t1,$v0,'0' # convert digit to 0-9 value
2888#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
2889##...sltu $at,$t1,$t2
2893##...beq $at,$zero,5176
2896#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

2900:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

2900#    jal readLogicalChar # read next character
2904#    subu $t1,$v0,'0' # convert digit to 0-9 value
2908#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
2909##...sltu $at,$t1,$t2
2913##...beq $at,$zero,2932

2916#    mul $t3,$t3,$t2 # multiply old value by 10
2917##...mult $t3,$t2
2921##...mflo $t3
2924#    addu $t3,$t3,$t1 # add in value of new digit
2928#    j digitLoop

2932:  doneDigitLoop:

    # "push back" unused character into queue
2932#    sw $v0,lastCharRead

    # restore return address
2936#    lw $ra,($sp)
2940#    addu $sp, 4

    # multiply by sign and put return value in $t0
2944#    mult $t3,$t4 # multiply to account for poss. minus sign
2948#    mflo $t3
2952#    move $t0, $t3
    
    # return
2956#    jr $ra

###################################################################
# readChar() - library method (class Lib)
