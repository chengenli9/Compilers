3820:skipMask_concat:

3820#    move $t9, $s7 # store return string in unused (I hope) t9 register

    #restore $t0, and $t1 after they were potentially blown
    #away by newObject
3824#    move $t1,$s2   # first object
3828#    lw $t0,8($sp) # second object
    
