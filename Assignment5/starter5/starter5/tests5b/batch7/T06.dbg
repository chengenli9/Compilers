1592#    subu $t0,$v0,10
1596#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
1600#    subu $t0,$v0,9
1604#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
1608#    subu $t0,$v0,13
1612#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
1616#    subu $t0,$v0,12
