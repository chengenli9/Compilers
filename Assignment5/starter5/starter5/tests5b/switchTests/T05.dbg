    # We have a vtable address that is a data array.
    # we need skip over it then loop back to do next object.
3620:  skipToNextObj:
3620#    lw $t1,-4($t2) # data words in (object position of) array
    #### note: we know that it's not a string, so the value will
    #### not be artificially negative
3624#    sll $t1,$t1,2 # convert to byte-count
3628#    addu $t0,$t2,$t1 # skip over object
3632#    j gcTestIterDone2 # go do next object, if any

    ###################################################
    # at this point:
    # - the object has been restored to normal status--that is, the
    #   word-swap has been done
    # - $t2 contains a pointer to the object
    ###################################################
    
3636:  gcNotDataArray:
3636#    lw $t3,-4($t2) # # object words (negative treated as zero)
3640#    bge $t3,$zero,gcH2Neg2
3641##...slt $at,$t3,$zero
3645##...beq $at,$zero,3652
3648#    move $t3,$zero
3652:  gcH2Neg2:
3652#    sll $t3,$t3,2 # # object bytes
3656#    move $t0,$t2 # address of first pointer in object
3660#    add $s1,$t2,$t3 # limit address for this object

    #####################################################
    # At this point, we have to "translate" all pointers,
    # starting at $t0 to (but not including) $s1
    #####################################################

    # if there are no pointer-slots (i.e., $t0=$s1), skip this
    # part
3664#    beq $t0,$s1,gcTestIterDone2
    
3668:  gcNextPointerInObject:
    # get pointer from object
3668#    lw $t1,($t0)

    # if value is out of range, and is therefore does not refer
    # to an object, just go loop back and do the next one
3672#    bleu $t1,$t6,gcGoNextPointerSlot
3673##...sltu $at,$t6,$t1
3677##...beq $at,$zero,3820
3680#    bgtu $t1,$t7,gcGoNextPointerSlot
3681##...sltu $at,$t7,$t1
3685##...bne $at,$zero,3820

    # if the object has already been moved, update the stack-value
    # via the forwarding pointer
3688#    lw $t8,-8($t1) # possible forwarding tag
3692#    bne $t8,$zero,gcNoForward2 # if not forwarding tag, go copy
3696#    lw $t8,-4($t1) # forwarding pointer: object's new address
3700#    sw $t8,($t0) # update pointer in object
3704#    j gcGoNextPointerSlot # do next iteration

3708:  gcNoForward2:
    #########################################################
    # we actually need to copy the object into the new space
    #########################################################

    #########################################################
    # At this point:
    # - $t0 contains the address of the heap-slot we're translating
    # - $t1 will contain the contents of the heap-slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space, which will also be the first address
    #   of the target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # Then during processing:
    # And when we're actually copying an object:
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $t8 will contain a pointer to the target object
    # - available for use: $s0, $t8, $t9
    ##########################################################

    # compute the amount of space that is needed
3708#    bge $t8,$zero,gcSkip5 # # words in negative-offset portion
3709##...slt $at,$t8,$zero
3713##...beq $at,$zero,3728
3716#    and $t8,0xff # mask off hash bits
3717##...lui $at,0
3721##...ori $at,$at,0xff
3725##...and $t8,$t8,$at

3728:  gcSkip5:
3728#    sll $t8,$t8,2 # bytes in negative-offset portion ...
3732#    addu $t8,$t8,8 # ... add in bytes for header-words
3736#    subu $t4,$t1,$t8 # address of first word of source object
3740#    lw $t3,-4($t1) # # words in positive-offset portion
3744#    bge $t3,$zero,gcNoNeg
3745##...slt $at,$t3,$zero
3749##...beq $at,$zero,3756
3752#    move $t3,$zero # negative treated as zero
3756:  gcNoNeg:
3756#    sll $t3,$t3,2 # bytes in negative-offset portion
3760#    addu $t3,$t3,$t1 # address one word past last word of source

3764#    addu $t8,$s3,$t8 # pointer to target object

    #########################################################
    # At this point:
    # - $t0 contains the address of the stack slot we'll
    #   process next
    # - $t1 contains the contents of the stack slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $t8 contains the pointer to the target object
    # - $s1 contains the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0, $t9
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger"
3768#    lw $s0,($t4)
3772#    lw $t9,-8($t1)
3776#    sw $t9,($t4)
3780#    sw $s0,-8($t1)

    # copy all source bytes to the target
3784:  gCinnerCopy2:
3784#    lw $s0,($t4)
3788#    sw $s0,($s3)
3792#    addu $t4,$t4,4
3796#    addu $s3,$s3,4
3800#    bltu $t4,$t3,gCinnerCopy2
3801##...sltu $at,$t4,$t3
3805##...bne $at,$zero,3784

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
3808#    sw $zero,-8($t1) # 0 in first header-slot
3812#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
3816#    sw $t8,($t0)

3820:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
3820#    addu $t0,$t0,4
3824#    bltu $t0,$s1,gcNextPointerInObject
3825##...sltu $at,$t0,$s1
3829##...bne $at,$zero,3668

3832:  gcTestIterDone2:
3832#    bltu $t0,$s3,gcHeapCopyLoop
3833##...sltu $at,$t0,$s3
3837##...bne $at,$zero,3552

    ###### end outer loop to copy all non-stack-direct objects ######

3840:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
3840#    lw $s2,($sp)
3844#    addu $sp,$sp,4

    # mark us as having already GC'd
3848#    move $t5,$s5

    # go try and allocate again
3852#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
3856:vm_init:

    # mark bottom of stack
3856#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
3860#    move $s2,$zero

    #set up the "five" register
3864#    li $s5,5

3868#    la $s3,seg0_start
3872#    la $s4,seg0_end
3873##...lui $s4,16
3877##...addiu $s4,$s4,4812
    
    # return
3880#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3884:divide:
    # get parameters; abort if divisor zero
3884#    lw $t0,($sp)
3888#    lw $t1,8($sp)
3892#    beq $t0,$zero,divByZeroError
    
    # perform division
3896#    div $t1,$t0
3900#    mflo $t0

    # store result, adjust stack and return
3904#    addu $sp,$sp,8 # adjust stack
3908#    sw $t0,($sp) # store result
3912#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3916:remainder:
    # get parameters; abort if divisor zero
3916#    lw $t0,($sp)
3920#    lw $t1,8($sp)
3924#    beq $t0,$zero,divByZeroError
    
    # perform division
3928#    div $t1,$t0
3932#    mfhi $t0

    # store result, adjust stack and return
3936#    addu $sp,$sp,8 # adjust stack
3940#    sw $t0,($sp) # store result
3944#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
3948:checkCast:
    # get object, allow immediately if null
3948#    lw $t2,($sp)
3952#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
3956#    lw $t2,-12($t2) # vtable address
3960#    bge $t2,$t1,castException
3961##...slt $at,$t2,$t1
3965##...beq $at,$zero,4136
3968#    blt $t2,$t0,castException
3969##...slt $at,$t2,$t0
3973##...bne $at,$zero,4136
    
    # return, leaving object unchanged on stack
3976:  checkCastReturn:    
3976#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
3980:instanceOf:
    # get object, go return false if null
3980#    lw $t2,($sp)
3984#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
3988#    lw $t2,-12($t2) # vtable address
3992#    sge $t0,$t2,$t0 # are we >= the lower limit?
3993##...slt $t0,$t2,$t0
3997##...xori $t0,$t0,0x1
4000#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
4004#    and $t2,$t0,$t1
4008#    sw $t2,($sp)
4012:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
4012#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

4016:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
4016#    li $v0,4 # syscall-code for print-string
4020#    syscall
4024:exit:
    # print termination message
4024#    li $v0,4 # syscall-code for print-string
4028#    la $a0,exitString
4032#    syscall

    # print number of garbage collections
4036#    li $v0,4 # syscall-code for print-string
4040#    la $a0,gcCountMsg
4044#    syscall # print "Number of ..."
4048#    lw $a0,gcCount # number of GC's
4052#    li $v0,1 # code for print-int
4056#    syscall
4060#    li $v0,4 # syscall-code for print-string
4064#    la $a0,newlineString
4068#    syscall # print newline

    # terminate execution
4072#    li $v0,10 #syscall-code for "exit"
4076#    syscall

4080:outOfHeapMemory:
4080#    la $a0,heapMemoryMsg
4084#    j exitError
4088:divByZeroError:
4088#    la $a0,divByZeroMsg
4092#    j exitError
4096:strIndexOutOfBounds:
4096#    la $a0,strIndexOutOfBoundsMsg
4100#    j exitError
4104:arrayIndexOutOfBounds:
4104#    la $a0,arrayIndexOutOfBoundsMsg
4108#    j exitError
4112:arraySizeOutOfBounds:
4112#    la $a0,arraySizeOutOfBoundsMsg
4116#    j exitError
4120:nullPtrException:
4120#    la $a0,nullPtrExceptionMsg
4124#    j exitError
4128:badIntegerFormat:
4128#    la $a0,badIntegerFormatMsg
4132#    j exitError
4136:castException:
4136#    la $a0,castExceptionMsg
4140#    j exitError
############## data section ################
    .data
4440:hexChars:
    .ascii "0123456789abcdef"
    .align 2
4456:cur_seg:
    .word 0

4460:lastCharRead:
    .word -2 # -2 => no buffered character
4464:prevHashConstant:
    .word 0x2785173c
4468:gcCount:
    .word 0

4472:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
4499:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
4522:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
4557:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
4591:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
4624:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
4655:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
4703:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
4724:gcMsg: 
      .asciiz "\nGC!\n"
4730:gcCountMsg: 
      .asciiz "Number of garbage collections: "

4762:nullStr:
    .asciiz "null"
4767:trueString:
    .asciiz "true"
4772:falseString:
    .asciiz "false"
4778:exitString:
    .ascii "Program execution completed."
    #### "falls through" here
4806:newlineString:
    .asciiz "\n"
    
    .align 2
4808:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

4812:seg0_start:
    .space 0x100000
1053388:seg0_end:
1053388:seg1_start:
    .space 0x100000
2101964:seg1_end:
