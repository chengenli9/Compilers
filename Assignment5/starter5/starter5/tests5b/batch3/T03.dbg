###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
9644:mth_readLine_Lib:
    
9644#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
9648#    sw $ra, 4($sp) # save $ra
9652#    move $t1,$sp # save "original" sp

9656:  doRead:

    # read the character
9656#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
9660#    subu $t2,$v0,13
9664#    bne $t2,$zero,notReturnRL
9668#    jal readLogicalChar
9672#    subu $t2,$v0,10 # check for newline
9676#    beq $t2,$zero,foundNewLine
9680#    sw $v0,lastCharRead # push back character into queue
9684#    j foundNewLine # go process the line

9688:  notReturnRL:

    # at this point, $v0 has our character

9688#    subu $t0,$v0,10
9692#    beq $t0,$zero,foundNewLine
9696#    blt $v0,$zero,foundEof
9697##...slt $at,$v0,$zero
9701##...bne $at,$zero,9716

    # we have a character, so push it onto stack
9704#    subu $sp,$sp,4
9708#    sw $v0,($sp)

    # loop back up to get next character
9712#    j doRead

9716:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
9716#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
9720#    li $s7, 0 # return-value: null
9724#    j rlReturn # return

9728:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
9728#    subu $t0,$t1,$sp # number of chars we read (times 4)
9732#    srl $s6,$t0,2 # number of words on stack with chars
9736#    subu $sp,$sp,4 # push char-count ...
9740#    sw $s6,($sp) # ... onto stack
9744#    addu $t2,$t0,5 # GC tag, incl. for count-word
9748#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
9752#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
9756#    srl $s6,$s6,2  # data words in object
9760#    move $s7,$zero # object words in object
9764#    jal newObject  # allocate space
    
    # store header words
9768#    la $t0,CLASS_String
9772#    sw $t0,-12($s7)# store class tag (String) into object
9776#    lw $t2,4($sp) # char-count
9780#    sll $t1,$t2,2 # 4 times number of chars
9784#    subu $t2,$zero,$t2 # negative of char-count
9788#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
9792#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
9796#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
9797##...slt $at,$t0,$zero
9801##...beq $at,$zero,9820
9804#    and $t0,0xff # mask off object's hash value ...
9805##...lui $at,0
9809##...ori $at,$at,0xff
9813##...and $t0,$t0,$at
9816#    sw $t0,-8($s7) # ... and store back into -8 header-word
9820:  skipMask_readLine:

9820#    sll $t0,$t0,2 # data bytes in object
9824#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
9828#    subu $t0,$t0,$t2 # place to store last character (plus 9)
9832#    addu $sp,$sp,8 # pop redundant object-pointer and count
9836#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

9840#    beq $sp,$t1,rlReturn
9844:  charCopyLoop:
9844#    lw $t2,($sp)
9848#    sb $t2,-9($t0)
9852#    addu $sp,$sp,4
9856#    subu $t0,$t0,1
9860#    bne $sp,$t1,charCopyLoop
9864:  rlReturn:

9864#    lw $ra, 4($sp)
9868#    addu $sp, 8   # pop $ra and pointless word off stack
9872#    move $t0, $s7 # return string we allocated in $s7
9876#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
9880:mth_readInt_Lib:

    # save $ra by pushing onto stack
9880#    subu $sp,$sp,4
9884#    sw $ra,($sp)

9888:  riSkipWhiteLoop:
    # read a character
9888#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
9892#    subu $t0,$v0,32
9896#    bgt $t0,$zero,nonWhite
9897##...slt $at,$zero,$t0
9901##...bne $at,$zero,9944
9904#    beq $t0,$zero,riSkipWhiteLoop # start over if space
9908#    subu $t0,$v0,10
9912#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
9916#    subu $t0,$v0,9
9920#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
9924#    subu $t0,$v0,13
9928#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
9932#    subu $t0,$v0,12
9936#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
9940#    j badIntegerFormat # illegal integer char: abort program

9944:  nonWhite:
9944#    subu $t0,$v0,'-'
9948#    li $t4,1 # final multiplier
9952#    bne $t0,$zero,helpReadInt # go read
9956#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
9960#    jal readLogicalChar

9964:  helpReadInt:
9964#    li $t2,10
9968#    subu $t1,$v0,'0' # convert digit to 0-9 value
9972#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
9973##...sltu $at,$t1,$t2
9977##...beq $at,$zero,12260
9980#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

9984:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

9984#    jal readLogicalChar # read next character
9988#    subu $t1,$v0,'0' # convert digit to 0-9 value
9992#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
9993##...sltu $at,$t1,$t2
9997##...beq $at,$zero,10016

10000#    mul $t3,$t3,$t2 # multiply old value by 10
10001##...mult $t3,$t2
10005##...mflo $t3
10008#    addu $t3,$t3,$t1 # add in value of new digit
10012#    j digitLoop

10016:  doneDigitLoop:

    # "push back" unused character into queue
10016#    sw $v0,lastCharRead
