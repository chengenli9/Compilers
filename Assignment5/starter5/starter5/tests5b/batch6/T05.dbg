###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
1640:mth_readLine_Lib:
    
1640#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
1644#    sw $ra, 4($sp) # save $ra
1648#    move $t1,$sp # save "original" sp

1652:  doRead:

    # read the character
1652#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
1656#    subu $t2,$v0,13
1660#    bne $t2,$zero,notReturnRL
1664#    jal readLogicalChar
1668#    subu $t2,$v0,10 # check for newline
1672#    beq $t2,$zero,foundNewLine
1676#    sw $v0,lastCharRead # push back character into queue
1680#    j foundNewLine # go process the line

1684:  notReturnRL:

    # at this point, $v0 has our character

1684#    subu $t0,$v0,10
1688#    beq $t0,$zero,foundNewLine
1692#    blt $v0,$zero,foundEof
1693##...slt $at,$v0,$zero
1697##...bne $at,$zero,1712

    # we have a character, so push it onto stack
1700#    subu $sp,$sp,4
1704#    sw $v0,($sp)

    # loop back up to get next character
1708#    j doRead

1712:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
1712#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
1716#    li $s7, 0 # return-value: null
1720#    j rlReturn # return

1724:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
1724#    subu $t0,$t1,$sp # number of chars we read (times 4)
1728#    srl $s6,$t0,2 # number of words on stack with chars
1732#    subu $sp,$sp,4 # push char-count ...
1736#    sw $s6,($sp) # ... onto stack
1740#    addu $t2,$t0,5 # GC tag, incl. for count-word
1744#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
1748#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
1752#    srl $s6,$s6,2  # data words in object
1756#    move $s7,$zero # object words in object
1760#    jal newObject  # allocate space
    
    # store header words
1764#    la $t0,CLASS_String
1768#    sw $t0,-12($s7)# store class tag (String) into object
1772#    lw $t2,4($sp) # char-count
1776#    sll $t1,$t2,2 # 4 times number of chars
1780#    subu $t2,$zero,$t2 # negative of char-count
1784#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
1788#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
1792#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
1793##...slt $at,$t0,$zero
1797##...beq $at,$zero,1816
1800#    and $t0,0xff # mask off object's hash value ...
1801##...lui $at,0
1805##...ori $at,$at,0xff
1809##...and $t0,$t0,$at
1812#    sw $t0,-8($s7) # ... and store back into -8 header-word
1816:  skipMask_readLine:

1816#    sll $t0,$t0,2 # data bytes in object
1820#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
1824#    subu $t0,$t0,$t2 # place to store last character (plus 9)
1828#    addu $sp,$sp,8 # pop redundant object-pointer and count
1832#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

1836#    beq $sp,$t1,rlReturn
1840:  charCopyLoop:
1840#    lw $t2,($sp)
1844#    sb $t2,-9($t0)
1848#    addu $sp,$sp,4
1852#    subu $t0,$t0,1
1856#    bne $sp,$t1,charCopyLoop
1860:  rlReturn:

1860#    lw $ra, 4($sp)
1864#    addu $sp, 8   # pop $ra and pointless word off stack
1868#    move $t0, $s7 # return string we allocated in $s7
1872#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
1876:mth_readInt_Lib:

    # save $ra by pushing onto stack
1876#    subu $sp,$sp,4
1880#    sw $ra,($sp)

1884:  riSkipWhiteLoop:
    # read a character
1884#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
1888#    subu $t0,$v0,32
1892#    bgt $t0,$zero,nonWhite
1893##...slt $at,$zero,$t0
1897##...bne $at,$zero,1940
1900#    beq $t0,$zero,riSkipWhiteLoop # start over if space
1904#    subu $t0,$v0,10
1908#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
1912#    subu $t0,$v0,9
1916#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
1920#    subu $t0,$v0,13
1924#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
1928#    subu $t0,$v0,12
1932#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
1936#    j badIntegerFormat # illegal integer char: abort program

1940:  nonWhite:
1940#    subu $t0,$v0,'-'
1944#    li $t4,1 # final multiplier
1948#    bne $t0,$zero,helpReadInt # go read
1952#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
1956#    jal readLogicalChar

1960:  helpReadInt:
1960#    li $t2,10
1964#    subu $t1,$v0,'0' # convert digit to 0-9 value
1968#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
1969##...sltu $at,$t1,$t2
1973##...beq $at,$zero,4256
1976#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

1980:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

1980#    jal readLogicalChar # read next character
1984#    subu $t1,$v0,'0' # convert digit to 0-9 value
1988#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
1989##...sltu $at,$t1,$t2
1993##...beq $at,$zero,2012

1996#    mul $t3,$t3,$t2 # multiply old value by 10
1997##...mult $t3,$t2
2001##...mflo $t3
2004#    addu $t3,$t3,$t1 # add in value of new digit
2008#    j digitLoop

2012:  doneDigitLoop:

    # "push back" unused character into queue
2012#    sw $v0,lastCharRead

    # restore return address
2016#    lw $ra,($sp)
2020#    addu $sp, 4

    # multiply by sign and put return value in $t0
2024#    mult $t3,$t4 # multiply to account for poss. minus sign
2028#    mflo $t3
2032#    move $t0, $t3
    
    # return
2036#    jr $ra
