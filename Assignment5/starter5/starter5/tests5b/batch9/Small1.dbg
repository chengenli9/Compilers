5272#    lw $v0,lastCharRead
5276#    li $t0,-2
5280#    beq $t0,$v0 doReadCh

    # we have our character from the buffer. Wipe out
    # buffer and return
5284#    sw $t0,lastCharRead # store -2 into buffer (i.e. "empty")
5288#    jr $ra # return
    
5292:  doReadCh:
    # we need to actually read a character: read and return
5292#    li $v0,12 # use system call to read a character
5296#    syscall
5300#    jr $ra # return
