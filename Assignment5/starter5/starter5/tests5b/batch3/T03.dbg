###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
9684:mth_readLine_Lib:
    
9684#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
9688#    sw $ra, 4($sp) # save $ra
9692#    move $t1,$sp # save "original" sp

9696:  doRead:

    # read the character
9696#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
9700#    subu $t2,$v0,13
9704#    bne $t2,$zero,notReturnRL
9708#    jal readLogicalChar
9712#    subu $t2,$v0,10 # check for newline
9716#    beq $t2,$zero,foundNewLine
9720#    sw $v0,lastCharRead # push back character into queue
9724#    j foundNewLine # go process the line

9728:  notReturnRL:

    # at this point, $v0 has our character

9728#    subu $t0,$v0,10
9732#    beq $t0,$zero,foundNewLine
9736#    blt $v0,$zero,foundEof
9737##...slt $at,$v0,$zero
9741##...bne $at,$zero,9756

    # we have a character, so push it onto stack
9744#    subu $sp,$sp,4
9748#    sw $v0,($sp)

    # loop back up to get next character
9752#    j doRead

9756:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
9756#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
9760#    li $s7, 0 # return-value: null
9764#    j rlReturn # return

9768:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
9768#    subu $t0,$t1,$sp # number of chars we read (times 4)
9772#    srl $s6,$t0,2 # number of words on stack with chars
9776#    subu $sp,$sp,4 # push char-count ...
9780#    sw $s6,($sp) # ... onto stack
9784#    addu $t2,$t0,5 # GC tag, incl. for count-word
9788#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
9792#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
9796#    srl $s6,$s6,2  # data words in object
9800#    move $s7,$zero # object words in object
9804#    jal newObject  # allocate space
    
    # store header words
9808#    la $t0,CLASS_String
9812#    sw $t0,-12($s7)# store class tag (String) into object
9816#    lw $t2,4($sp) # char-count
9820#    sll $t1,$t2,2 # 4 times number of chars
9824#    subu $t2,$zero,$t2 # negative of char-count
9828#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
9832#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
9836#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
9837##...slt $at,$t0,$zero
9841##...beq $at,$zero,9860
9844#    and $t0,0xff # mask off object's hash value ...
9845##...lui $at,0
9849##...ori $at,$at,0xff
9853##...and $t0,$t0,$at
9856#    sw $t0,-8($s7) # ... and store back into -8 header-word
9860:  skipMask_readLine:

9860#    sll $t0,$t0,2 # data bytes in object
9864#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
9868#    subu $t0,$t0,$t2 # place to store last character (plus 9)
9872#    addu $sp,$sp,8 # pop redundant object-pointer and count
9876#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

9880#    beq $sp,$t1,rlReturn
9884:  charCopyLoop:
9884#    lw $t2,($sp)
9888#    sb $t2,-9($t0)
9892#    addu $sp,$sp,4
9896#    subu $t0,$t0,1
9900#    bne $sp,$t1,charCopyLoop
9904:  rlReturn:

9904#    lw $ra, 4($sp)
9908#    addu $sp, 8   # pop $ra and pointless word off stack
9912#    move $t0, $s7 # return string we allocated in $s7
9916#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
9920:mth_readInt_Lib:

    # save $ra by pushing onto stack
9920#    subu $sp,$sp,4
9924#    sw $ra,($sp)

9928:  riSkipWhiteLoop:
    # read a character
9928#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
9932#    subu $t0,$v0,32
9936#    bgt $t0,$zero,nonWhite
9937##...slt $at,$zero,$t0
9941##...bne $at,$zero,9984
9944#    beq $t0,$zero,riSkipWhiteLoop # start over if space
9948#    subu $t0,$v0,10
9952#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
9956#    subu $t0,$v0,9
9960#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
9964#    subu $t0,$v0,13
9968#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
9972#    subu $t0,$v0,12
9976#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
9980#    j badIntegerFormat # illegal integer char: abort program

9984:  nonWhite:
9984#    subu $t0,$v0,'-'
9988#    li $t4,1 # final multiplier
9992#    bne $t0,$zero,helpReadInt # go read
9996#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
10000#    jal readLogicalChar

10004:  helpReadInt:
10004#    li $t2,10
10008#    subu $t1,$v0,'0' # convert digit to 0-9 value
10012#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
10013##...sltu $at,$t1,$t2
10017##...beq $at,$zero,12264
10020#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

10024:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

10024#    jal readLogicalChar # read next character
10028#    subu $t1,$v0,'0' # convert digit to 0-9 value
10032#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
10033##...sltu $at,$t1,$t2
10037##...beq $at,$zero,10056

10040#    mul $t3,$t3,$t2 # multiply old value by 10
10041##...mult $t3,$t2
10045##...mflo $t3
10048#    addu $t3,$t3,$t1 # add in value of new digit
10052#    j digitLoop

10056:  doneDigitLoop:

    # "push back" unused character into queue
10056#    sw $v0,lastCharRead
