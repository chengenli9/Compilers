17365##...slt $at,$zero,$t0
17369##...bne $at,$zero,17412
17372#    beq $t0,$zero,riSkipWhiteLoop # start over if space
17376#    subu $t0,$v0,10
17380#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
17384#    subu $t0,$v0,9
17388#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
17392#    subu $t0,$v0,13
17396#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
17400#    subu $t0,$v0,12
17404#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
17408#    j badIntegerFormat # illegal integer char: abort program

17412:  nonWhite:
17412#    subu $t0,$v0,'-'
17416#    li $t4,1 # final multiplier
17420#    bne $t0,$zero,helpReadInt # go read
17424#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
17428#    jal readLogicalChar

17432:  helpReadInt:
17432#    li $t2,10
17436#    subu $t1,$v0,'0' # convert digit to 0-9 value
17440#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
17441##...sltu $at,$t1,$t2
17445##...beq $at,$zero,19692
17448#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

17452:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

17452#    jal readLogicalChar # read next character
17456#    subu $t1,$v0,'0' # convert digit to 0-9 value
17460#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
17461##...sltu $at,$t1,$t2
17465##...beq $at,$zero,17484

17468#    mul $t3,$t3,$t2 # multiply old value by 10
17469##...mult $t3,$t2
17473##...mflo $t3
17476#    addu $t3,$t3,$t1 # add in value of new digit
17480#    j digitLoop

17484:  doneDigitLoop:

    # "push back" unused character into queue
17484#    sw $v0,lastCharRead

    # restore return address
17488#    lw $ra,($sp)
17492#    addu $sp, 4

    # multiply by sign and put return value in $t0
17496#    mult $t3,$t4 # multiply to account for poss. minus sign
17500#    mflo $t3
17504#    move $t0, $t3
    
    # return
17508#    jr $ra
