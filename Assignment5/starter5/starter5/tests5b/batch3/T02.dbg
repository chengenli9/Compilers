###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
7844:mth_readLine_Lib:
    
7844#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
7848#    sw $ra, 4($sp) # save $ra
7852#    move $t1,$sp # save "original" sp

7856:  doRead:

    # read the character
7856#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
7860#    subu $t2,$v0,13
7864#    bne $t2,$zero,notReturnRL
7868#    jal readLogicalChar
7872#    subu $t2,$v0,10 # check for newline
7876#    beq $t2,$zero,foundNewLine
7880#    sw $v0,lastCharRead # push back character into queue
7884#    j foundNewLine # go process the line

7888:  notReturnRL:

    # at this point, $v0 has our character

7888#    subu $t0,$v0,10
7892#    beq $t0,$zero,foundNewLine
7896#    blt $v0,$zero,foundEof
7897##...slt $at,$v0,$zero
7901##...bne $at,$zero,7916

    # we have a character, so push it onto stack
7904#    subu $sp,$sp,4
7908#    sw $v0,($sp)

    # loop back up to get next character
7912#    j doRead

7916:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
7916#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
7920#    li $s7, 0 # return-value: null
7924#    j rlReturn # return

7928:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
7928#    subu $t0,$t1,$sp # number of chars we read (times 4)
7932#    srl $s6,$t0,2 # number of words on stack with chars
7936#    subu $sp,$sp,4 # push char-count ...
7940#    sw $s6,($sp) # ... onto stack
7944#    addu $t2,$t0,5 # GC tag, incl. for count-word
7948#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
7952#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
7956#    srl $s6,$s6,2  # data words in object
7960#    move $s7,$zero # object words in object
7964#    jal newObject  # allocate space
    
    # store header words
7968#    la $t0,CLASS_String
7972#    sw $t0,-12($s7)# store class tag (String) into object
7976#    lw $t2,4($sp) # char-count
7980#    sll $t1,$t2,2 # 4 times number of chars
7984#    subu $t2,$zero,$t2 # negative of char-count
7988#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
7992#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
7996#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
7997##...slt $at,$t0,$zero
8001##...beq $at,$zero,8020
8004#    and $t0,0xff # mask off object's hash value ...
8005##...lui $at,0
8009##...ori $at,$at,0xff
8013##...and $t0,$t0,$at
8016#    sw $t0,-8($s7) # ... and store back into -8 header-word
8020:  skipMask_readLine:

8020#    sll $t0,$t0,2 # data bytes in object
8024#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
8028#    subu $t0,$t0,$t2 # place to store last character (plus 9)
8032#    addu $sp,$sp,8 # pop redundant object-pointer and count
8036#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack
