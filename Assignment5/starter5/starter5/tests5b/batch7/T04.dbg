###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
1604:mth_readLine_Lib:
    
1604#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
1608#    sw $ra, 4($sp) # save $ra
1612#    move $t1,$sp # save "original" sp

1616:  doRead:

    # read the character
1616#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
1620#    subu $t2,$v0,13
1624#    bne $t2,$zero,notReturnRL
1628#    jal readLogicalChar
1632#    subu $t2,$v0,10 # check for newline
1636#    beq $t2,$zero,foundNewLine
1640#    sw $v0,lastCharRead # push back character into queue
1644#    j foundNewLine # go process the line

1648:  notReturnRL:

    # at this point, $v0 has our character

1648#    subu $t0,$v0,10
1652#    beq $t0,$zero,foundNewLine
1656#    blt $v0,$zero,foundEof
1657##...slt $at,$v0,$zero
1661##...bne $at,$zero,1676

    # we have a character, so push it onto stack
1664#    subu $sp,$sp,4
1668#    sw $v0,($sp)

    # loop back up to get next character
1672#    j doRead

1676:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
1676#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
1680#    li $s7, 0 # return-value: null
1684#    j rlReturn # return

1688:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
1688#    subu $t0,$t1,$sp # number of chars we read (times 4)
1692#    srl $s6,$t0,2 # number of words on stack with chars
1696#    subu $sp,$sp,4 # push char-count ...
1700#    sw $s6,($sp) # ... onto stack
1704#    addu $t2,$t0,5 # GC tag, incl. for count-word
1708#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
1712#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
1716#    srl $s6,$s6,2  # data words in object
1720#    move $s7,$zero # object words in object
1724#    jal newObject  # allocate space
    
    # store header words
1728#    la $t0,CLASS_String
1732#    sw $t0,-12($s7)# store class tag (String) into object
1736#    lw $t2,4($sp) # char-count
1740#    sll $t1,$t2,2 # 4 times number of chars
1744#    subu $t2,$zero,$t2 # negative of char-count
1748#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
1752#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
1756#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
1757##...slt $at,$t0,$zero
1761##...beq $at,$zero,1780
1764#    and $t0,0xff # mask off object's hash value ...
1765##...lui $at,0
1769##...ori $at,$at,0xff
1773##...and $t0,$t0,$at
1776#    sw $t0,-8($s7) # ... and store back into -8 header-word
1780:  skipMask_readLine:

1780#    sll $t0,$t0,2 # data bytes in object
1784#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
1788#    subu $t0,$t0,$t2 # place to store last character (plus 9)
1792#    addu $sp,$sp,8 # pop redundant object-pointer and count
1796#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

1800#    beq $sp,$t1,rlReturn
1804:  charCopyLoop:
1804#    lw $t2,($sp)
1808#    sb $t2,-9($t0)
1812#    addu $sp,$sp,4
1816#    subu $t0,$t0,1
1820#    bne $sp,$t1,charCopyLoop
1824:  rlReturn:

1824#    lw $ra, 4($sp)
1828#    addu $sp, 8   # pop $ra and pointless word off stack
1832#    move $t0, $s7 # return string we allocated in $s7
1836#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
1840:mth_readInt_Lib:

    # save $ra by pushing onto stack
1840#    subu $sp,$sp,4
1844#    sw $ra,($sp)

1848:  riSkipWhiteLoop:
    # read a character
1848#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
1852#    subu $t0,$v0,32
1856#    bgt $t0,$zero,nonWhite
1857##...slt $at,$zero,$t0
1861##...bne $at,$zero,1904
1864#    beq $t0,$zero,riSkipWhiteLoop # start over if space
1868#    subu $t0,$v0,10
1872#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
1876#    subu $t0,$v0,9
1880#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
1884#    subu $t0,$v0,13
1888#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
1892#    subu $t0,$v0,12
1896#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
1900#    j badIntegerFormat # illegal integer char: abort program

1904:  nonWhite:
1904#    subu $t0,$v0,'-'
1908#    li $t4,1 # final multiplier
1912#    bne $t0,$zero,helpReadInt # go read
1916#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
1920#    jal readLogicalChar

1924:  helpReadInt:
1924#    li $t2,10
1928#    subu $t1,$v0,'0' # convert digit to 0-9 value
1932#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
1933##...sltu $at,$t1,$t2
1937##...beq $at,$zero,4220
1940#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

1944:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

1944#    jal readLogicalChar # read next character
1948#    subu $t1,$v0,'0' # convert digit to 0-9 value
1952#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
1953##...sltu $at,$t1,$t2
1957##...beq $at,$zero,1976

1960#    mul $t3,$t3,$t2 # multiply old value by 10
1961##...mult $t3,$t2
1965##...mflo $t3
1968#    addu $t3,$t3,$t1 # add in value of new digit
1972#    j digitLoop

1976:  doneDigitLoop:

    # "push back" unused character into queue
1976#    sw $v0,lastCharRead

    # restore return address
1980#    lw $ra,($sp)
1984#    addu $sp, 4

    # multiply by sign and put return value in $t0
1988#    mult $t3,$t4 # multiply to account for poss. minus sign
1992#    mflo $t3
1996#    move $t0, $t3
    
    # return
2000#    jr $ra
