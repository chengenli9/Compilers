###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
1688:mth_readLine_Lib:
    
1688#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
1692#    sw $ra, 4($sp) # save $ra
1696#    move $t1,$sp # save "original" sp

1700:  doRead:

    # read the character
1700#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
1704#    subu $t2,$v0,13
1708#    bne $t2,$zero,notReturnRL
1712#    jal readLogicalChar
1716#    subu $t2,$v0,10 # check for newline
1720#    beq $t2,$zero,foundNewLine
1724#    sw $v0,lastCharRead # push back character into queue
1728#    j foundNewLine # go process the line

1732:  notReturnRL:

    # at this point, $v0 has our character

1732#    subu $t0,$v0,10
1736#    beq $t0,$zero,foundNewLine
1740#    blt $v0,$zero,foundEof
1741##...slt $at,$v0,$zero
1745##...bne $at,$zero,1760

    # we have a character, so push it onto stack
1748#    subu $sp,$sp,4
1752#    sw $v0,($sp)

    # loop back up to get next character
1756#    j doRead

1760:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
1760#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
1764#    li $s7, 0 # return-value: null
1768#    j rlReturn # return

1772:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
1772#    subu $t0,$t1,$sp # number of chars we read (times 4)
1776#    srl $s6,$t0,2 # number of words on stack with chars
1780#    subu $sp,$sp,4 # push char-count ...
1784#    sw $s6,($sp) # ... onto stack
1788#    addu $t2,$t0,5 # GC tag, incl. for count-word
1792#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
1796#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
1800#    srl $s6,$s6,2  # data words in object
1804#    move $s7,$zero # object words in object
1808#    jal newObject  # allocate space
    
    # store header words
1812#    la $t0,CLASS_String
1816#    sw $t0,-12($s7)# store class tag (String) into object
1820#    lw $t2,4($sp) # char-count
1824#    sll $t1,$t2,2 # 4 times number of chars
1828#    subu $t2,$zero,$t2 # negative of char-count
1832#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
1836#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
1840#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
1841##...slt $at,$t0,$zero
1845##...beq $at,$zero,1864
1848#    and $t0,0xff # mask off object's hash value ...
1849##...lui $at,0
1853##...ori $at,$at,0xff
1857##...and $t0,$t0,$at
1860#    sw $t0,-8($s7) # ... and store back into -8 header-word
1864:  skipMask_readLine:

1864#    sll $t0,$t0,2 # data bytes in object
1868#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
1872#    subu $t0,$t0,$t2 # place to store last character (plus 9)
1876#    addu $sp,$sp,8 # pop redundant object-pointer and count
1880#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

1884#    beq $sp,$t1,rlReturn
1888:  charCopyLoop:
1888#    lw $t2,($sp)
1892#    sb $t2,-9($t0)
1896#    addu $sp,$sp,4
1900#    subu $t0,$t0,1
1904#    bne $sp,$t1,charCopyLoop
1908:  rlReturn:

1908#    lw $ra, 4($sp)
1912#    addu $sp, 8   # pop $ra and pointless word off stack
1916#    move $t0, $s7 # return string we allocated in $s7
1920#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
1924:mth_readInt_Lib:

    # save $ra by pushing onto stack
1924#    subu $sp,$sp,4
1928#    sw $ra,($sp)

1932:  riSkipWhiteLoop:
    # read a character
1932#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
1936#    subu $t0,$v0,32
1940#    bgt $t0,$zero,nonWhite
1941##...slt $at,$zero,$t0
1945##...bne $at,$zero,1988
1948#    beq $t0,$zero,riSkipWhiteLoop # start over if space
1952#    subu $t0,$v0,10
1956#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
1960#    subu $t0,$v0,9
1964#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
1968#    subu $t0,$v0,13
1972#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
1976#    subu $t0,$v0,12
1980#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
1984#    j badIntegerFormat # illegal integer char: abort program

1988:  nonWhite:
1988#    subu $t0,$v0,'-'
1992#    li $t4,1 # final multiplier
1996#    bne $t0,$zero,helpReadInt # go read
2000#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
2004#    jal readLogicalChar

2008:  helpReadInt:
2008#    li $t2,10
2012#    subu $t1,$v0,'0' # convert digit to 0-9 value
2016#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
2017##...sltu $at,$t1,$t2
2021##...beq $at,$zero,4304
2024#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

2028:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

2028#    jal readLogicalChar # read next character
2032#    subu $t1,$v0,'0' # convert digit to 0-9 value
2036#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
2037##...sltu $at,$t1,$t2
2041##...beq $at,$zero,2060

2044#    mul $t3,$t3,$t2 # multiply old value by 10
2045##...mult $t3,$t2
2049##...mflo $t3
2052#    addu $t3,$t3,$t1 # add in value of new digit
2056#    j digitLoop

2060:  doneDigitLoop:

    # "push back" unused character into queue
2060#    sw $v0,lastCharRead

    # restore return address
2064#    lw $ra,($sp)
2068#    addu $sp, 4

    # multiply by sign and put return value in $t0
2072#    mult $t3,$t4 # multiply to account for poss. minus sign
2076#    mflo $t3
2080#    move $t0, $t3
    
    # return
2084#    jr $ra
