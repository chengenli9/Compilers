3296#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
3300#    sw $t8,($t0)

3304:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
3304#    addu $t0,$t0,4
3308#    bltu $t0,$s1,gcNextPointerInObject
3309##...sltu $at,$t0,$s1
3313##...bne $at,$zero,3152

3316:  gcTestIterDone2:
3316#    bltu $t0,$s3,gcHeapCopyLoop
3317##...sltu $at,$t0,$s3
3321##...bne $at,$zero,3036

    ###### end outer loop to copy all non-stack-direct objects ######

3324:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
3324#    lw $s2,($sp)
3328#    addu $sp,$sp,4

    # mark us as having already GC'd
3332#    move $t5,$s5

    # go try and allocate again
3336#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
3340:vm_init:

    # mark bottom of stack
3340#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
3344#    move $s2,$zero

    #set up the "five" register
3348#    li $s5,5

3352#    la $s3,seg0_start
3356#    la $s4,seg0_end
3357##...lui $s4,16
3361##...addiu $s4,$s4,4200
    
    # return
3364#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3368:divide:
    # get parameters; abort if divisor zero
3368#    lw $t0,($sp)
3372#    lw $t1,8($sp)
3376#    beq $t0,$zero,divByZeroError
    
    # perform division
3380#    div $t1,$t0
3384#    mflo $t0

    # store result, adjust stack and return
3388#    addu $sp,$sp,8 # adjust stack
3392#    sw $t0,($sp) # store result
3396#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3400:remainder:
    # get parameters; abort if divisor zero
3400#    lw $t0,($sp)
3404#    lw $t1,8($sp)
3408#    beq $t0,$zero,divByZeroError
    
    # perform division
3412#    div $t1,$t0
3416#    mfhi $t0

    # store result, adjust stack and return
3420#    addu $sp,$sp,8 # adjust stack
3424#    sw $t0,($sp) # store result
3428#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
3432:checkCast:
    # get object, allow immediately if null
3432#    lw $t2,($sp)
3436#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
3440#    lw $t2,-12($t2) # vtable address
3444#    bge $t2,$t1,castException
3445##...slt $at,$t2,$t1
3449##...beq $at,$zero,3584
3452#    blt $t2,$t0,castException
3453##...slt $at,$t2,$t0
3457##...bne $at,$zero,3584
    
    # return, leaving object unchanged on stack
3460:  checkCastReturn:    
3460#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
3464:instanceOf:
    # get object, go return false if null
3464#    lw $t2,($sp)
3468#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
3472#    lw $t2,-12($t2) # vtable address
3476#    sge $t0,$t2,$t0 # are we >= the lower limit?
3477##...slt $t0,$t2,$t0
3481##...xori $t0,$t0,0x1
3484#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
3488#    and $t2,$t0,$t1
3492#    sw $t2,($sp)
3496:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
3496#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

3500:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
3500#    li $v0,4 # syscall-code for print-string
3504#    syscall
3508:exit:
    # print termination message
3508#    li $v0,4 # syscall-code for print-string
3512#    la $a0,exitString
3516#    syscall

    # terminate execution
3520#    li $v0,10 #syscall-code for "exit"
3524#    syscall

3528:outOfHeapMemory:
3528#    la $a0,heapMemoryMsg
3532#    j exitError
3536:divByZeroError:
3536#    la $a0,divByZeroMsg
3540#    j exitError
3544:strIndexOutOfBounds:
3544#    la $a0,strIndexOutOfBoundsMsg
3548#    j exitError
3552:arrayIndexOutOfBounds:
3552#    la $a0,arrayIndexOutOfBoundsMsg
3556#    j exitError
3560:arraySizeOutOfBounds:
3560#    la $a0,arraySizeOutOfBoundsMsg
3564#    j exitError
3568:nullPtrException:
3568#    la $a0,nullPtrExceptionMsg
3572#    j exitError
3576:badIntegerFormat:
3576#    la $a0,badIntegerFormatMsg
3580#    j exitError
3584:castException:
3584#    la $a0,castExceptionMsg
3588#    j exitError
############## data section ################
    .data
3836:hexChars:
    .ascii "0123456789abcdef"
    .align 2
3852:cur_seg:
    .word 0

3856:lastCharRead:
    .word -2 # -2 => no buffered character
3860:prevHashConstant:
    .word 0x2785173c
3864:gcCount:
