2085##...bne $at,$zero,2104
2088#    and $t1,0xff # mask out all but low byte
2089##...lui $at,0
2093##...ori $at,$at,0xff
2097##...and $t1,$t1,$at
2100#    b skipPrintStr2
2104:skipPrintStr1:
2104#    and $t1,0x7ffffff
2105##...lui $at,2047
2109##...ori $at,$at,0xffff
2113##...and $t1,$t1,$at
2116:skipPrintStr2:    
2116#    sll $t1,$t1,2
2120#    subu $t1,$t0,$t1 # first word in string
2124#    lw $t0,4($t0) # negative of string-length
2128#    subu $t0,$t1,$t0 # byte just beyond last char in string

    # print the chars in the string
2132#    beq $t0,$t1,donePrintStr
2136:  psLoop:
2136#    lb $a0,($t1) # next byte
2140#    li $v0,11 # code for printing char
