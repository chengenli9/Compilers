8040#    beq $sp,$t1,rlReturn
8044:  charCopyLoop:
8044#    lw $t2,($sp)
8048#    sb $t2,-9($t0)
8052#    addu $sp,$sp,4
8056#    subu $t0,$t0,1
8060#    bne $sp,$t1,charCopyLoop
8064:  rlReturn:

8064#    lw $ra, 4($sp)
8068#    addu $sp, 8   # pop $ra and pointless word off stack
8072#    move $t0, $s7 # return string we allocated in $s7
8076#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
8080:mth_readInt_Lib:

    # save $ra by pushing onto stack
8080#    subu $sp,$sp,4
8084#    sw $ra,($sp)

8088:  riSkipWhiteLoop:
    # read a character
8088#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
8092#    subu $t0,$v0,32
8096#    bgt $t0,$zero,nonWhite
8097##...slt $at,$zero,$t0
8101##...bne $at,$zero,8144
8104#    beq $t0,$zero,riSkipWhiteLoop # start over if space
8108#    subu $t0,$v0,10
8112#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
8116#    subu $t0,$v0,9
8120#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
8124#    subu $t0,$v0,13
8128#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
8132#    subu $t0,$v0,12
8136#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
8140#    j badIntegerFormat # illegal integer char: abort program

8144:  nonWhite:
8144#    subu $t0,$v0,'-'
8148#    li $t4,1 # final multiplier
8152#    bne $t0,$zero,helpReadInt # go read
8156#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
8160#    jal readLogicalChar

8164:  helpReadInt:
8164#    li $t2,10
8168#    subu $t1,$v0,'0' # convert digit to 0-9 value
8172#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
8173##...sltu $at,$t1,$t2
8177##...beq $at,$zero,10424
8180#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10
