3221##...lui $s4,16
3225##...addiu $s4,$s4,4700
3228#    sw $zero,cur_seg
3232#    bne $t0,$zero,skipGc1
3236#    la $t6,seg0_start
3240#    la $s3,seg1_start
3241##...lui $s3,16
3245##...addiu $s3,$s3,4700
3248#    la $s4,seg1_end
3249##...lui $s4,32
3253##...addiu $s4,$s4,4700
