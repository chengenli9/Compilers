5992#    seq $t0,$t0,$zero
5993##...subu $at,$t0,$zero
5997##...sltiu $t0,$at,1

    # pop return address and return $t0
6000#    lw $ra,($sp)
6004#    addu $sp,4

6008#    jr $ra # return
    
6012:goEsFalse:
    # put 0 in $t0 and return
6012#    li $t0, 0
6016#    jr $ra # return
