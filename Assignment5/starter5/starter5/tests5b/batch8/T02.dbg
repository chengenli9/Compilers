########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
4532:vm_init:

    # mark bottom of stack
4532#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
4536#    move $s2,$zero

    #set up the "five" register
4540#    li $s5,5

4544#    la $s3,seg0_start
4548#    la $s4,seg0_end
4549##...lui $s4,16
4553##...addiu $s4,$s4,5392
    
    # return
4556#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4560:divide:
    # get parameters; abort if divisor zero
4560#    lw $t0,($sp)
4564#    lw $t1,8($sp)
4568#    beq $t0,$zero,divByZeroError
    
    # perform division
4572#    div $t1,$t0
4576#    mflo $t0

    # store result, adjust stack and return
4580#    addu $sp,$sp,8 # adjust stack
4584#    sw $t0,($sp) # store result
4588#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4592:remainder:
    # get parameters; abort if divisor zero
4592#    lw $t0,($sp)
4596#    lw $t1,8($sp)
4600#    beq $t0,$zero,divByZeroError
    
    # perform division
4604#    div $t1,$t0
4608#    mfhi $t0

    # store result, adjust stack and return
4612#    addu $sp,$sp,8 # adjust stack
4616#    sw $t0,($sp) # store result
4620#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
4624:checkCast:
    # get object, allow immediately if null
4624#    lw $t2,($sp)
4628#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
4632#    lw $t2,-12($t2) # vtable address
4636#    bge $t2,$t1,castException
4637##...slt $at,$t2,$t1
4641##...beq $at,$zero,4776
4644#    blt $t2,$t0,castException
4645##...slt $at,$t2,$t0
4649##...bne $at,$zero,4776
    
    # return, leaving object unchanged on stack
4652:  checkCastReturn:    
4652#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
4656:instanceOf:
    # get object, go return false if null
4656#    lw $t2,($sp)
4660#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
4664#    lw $t2,-12($t2) # vtable address
4668#    sge $t0,$t2,$t0 # are we >= the lower limit?
4669##...slt $t0,$t2,$t0
4673##...xori $t0,$t0,0x1
4676#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
4680#    and $t2,$t0,$t1
4684#    sw $t2,($sp)
4688:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
4688#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

4692:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
4692#    li $v0,4 # syscall-code for print-string
4696#    syscall
4700:exit:
    # print termination message
4700#    li $v0,4 # syscall-code for print-string
4704#    la $a0,exitString
4708#    syscall

    # terminate execution
4712#    li $v0,10 #syscall-code for "exit"
4716#    syscall

4720:outOfHeapMemory:
4720#    la $a0,heapMemoryMsg
4724#    j exitError
4728:divByZeroError:
4728#    la $a0,divByZeroMsg
4732#    j exitError
4736:strIndexOutOfBounds:
4736#    la $a0,strIndexOutOfBoundsMsg
4740#    j exitError
