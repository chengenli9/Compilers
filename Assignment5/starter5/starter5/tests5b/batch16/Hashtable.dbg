#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
19456:vm_init:

    # mark bottom of stack
19456#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
19460#    move $s2,$zero

    #set up the "five" register
19464#    li $s5,5

19468#    la $s3,seg0_start
19472#    la $s4,seg0_end
19473##...lui $s4,16
19477##...addiu $s4,$s4,22140
    
    # return
19480#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
19484:divide:
    # get parameters; abort if divisor zero
19484#    lw $t0,($sp)
19488#    lw $t1,8($sp)
19492#    beq $t0,$zero,divByZeroError
    
    # perform division
19496#    div $t1,$t0
19500#    mflo $t0

    # store result, adjust stack and return
19504#    addu $sp,$sp,8 # adjust stack
19508#    sw $t0,($sp) # store result
19512#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
19516:remainder:
    # get parameters; abort if divisor zero
19516#    lw $t0,($sp)
19520#    lw $t1,8($sp)
19524#    beq $t0,$zero,divByZeroError
    
    # perform division
19528#    div $t1,$t0
19532#    mfhi $t0

    # store result, adjust stack and return
19536#    addu $sp,$sp,8 # adjust stack
19540#    sw $t0,($sp) # store result
19544#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
19548:checkCast:
    # get object, allow immediately if null
19548#    lw $t2,($sp)
19552#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
19556#    lw $t2,-12($t2) # vtable address
19560#    bge $t2,$t1,castException
19561##...slt $at,$t2,$t1
19565##...beq $at,$zero,19700
19568#    blt $t2,$t0,castException
19569##...slt $at,$t2,$t0
19573##...bne $at,$zero,19700
    
    # return, leaving object unchanged on stack
19576:  checkCastReturn:    
19576#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
19580:instanceOf:
    # get object, go return false if null
19580#    lw $t2,($sp)
19584#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
19588#    lw $t2,-12($t2) # vtable address
19592#    sge $t0,$t2,$t0 # are we >= the lower limit?
19593##...slt $t0,$t2,$t0
19597##...xori $t0,$t0,0x1
19600#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
19604#    and $t2,$t0,$t1
19608#    sw $t2,($sp)
19612:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
19612#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

19616:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
19616#    li $v0,4 # syscall-code for print-string
19620#    syscall
19624:exit:
    # print termination message
19624#    li $v0,4 # syscall-code for print-string
19628#    la $a0,exitString
19632#    syscall

    # terminate execution
19636#    li $v0,10 #syscall-code for "exit"
19640#    syscall

19644:outOfHeapMemory:
19644#    la $a0,heapMemoryMsg
19648#    j exitError
19652:divByZeroError:
19652#    la $a0,divByZeroMsg
19656#    j exitError
19660:strIndexOutOfBounds:
19660#    la $a0,strIndexOutOfBoundsMsg
19664#    j exitError
19668:arrayIndexOutOfBounds:
19668#    la $a0,arrayIndexOutOfBoundsMsg
19672#    j exitError
19676:arraySizeOutOfBounds:
19676#    la $a0,arraySizeOutOfBoundsMsg
19680#    j exitError
19684:nullPtrException:
19684#    la $a0,nullPtrExceptionMsg
19688#    j exitError
19692:badIntegerFormat:
19692#    la $a0,badIntegerFormatMsg
19696#    j exitError
19700:castException:
19700#    la $a0,castExceptionMsg
19704#    j exitError
############## data section ################
    .data
21776:hexChars:
    .ascii "0123456789abcdef"
    .align 2
21792:cur_seg:
    .word 0

21796:lastCharRead:
    .word -2 # -2 => no buffered character
21800:prevHashConstant:
    .word 0x2785173c
21804:gcCount:
    .word 0

21808:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
21835:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
21858:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
21893:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
21927:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
21960:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
21991:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
22039:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
22060:gcMsg: 
      .asciiz "\nGC!\n"
22066:gcCountMsg: 
      .asciiz "Number of garbage collections: "

22098:nullStr:
    .asciiz "null"
22103:trueString:
    .asciiz "true"
22108:falseString:
    .asciiz "false"
22114:exitString:
    .ascii "Program terminated."
    #### "falls through" here
22133:newlineString:
    .asciiz "\n"
    
    .align 2
22136:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

22140:seg0_start:
    .space 0x100000
1070716:seg0_end:
1070716:seg1_start:
    .space 0x100000
2119292:seg1_end:
