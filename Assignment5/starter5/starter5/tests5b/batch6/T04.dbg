    # processing, we're done, so go finish up
4128#    bgeu $t0,$s3,gcFinishUp
4129##...sltu $at,$t0,$s3
4133##...beq $at,$zero,4424

    ###### begin outer loop to copy all non-stack-direct objects ######

4136:  gcHeapCopyLoop:
    # get data count for object; swap header-word with first word
    # of object so that they're back in the right place
4136#    lw $t1,($t0) # (what will be) first header word for current object
4140#    move $t2,$t1 # number data bytes in object (poss. w/hash bits)
4144#    bge $t2,$zero,gcSkip4a # are there hash bits?
4145##...slt $at,$t2,$zero
4149##...beq $at,$zero,4164
4152#    and $t2,0xff # mask off hash bits
4153##...lui $at,0
4157##...ori $at,$at,0xff
4161##...and $t2,$t2,$at
4164:gcSkip4a:    
4164#    sll $t2,$t2,2 # # data bytes
4168#    addu $t2,$t2,8 # to skip header words
4172#    addu $t2,$t0,$t2 # pointer to new object
4176#    lw $t3,-8($t2) # word to swap
4180#    sw $t1,-8($t2) # store header word
4184#    sw $t3,($t0) # restore first word of object

    ################################################
    # at this point:
    # - $t2 contains the pointer to our new object
    ################################################

    # check if we have a data array
4188#    lw $t1,-12($t2) # vtable pointer
4192#    li $t0,dataArrayVTableStart # address of vtable for first data array
4196#    blt $t1,$t0,gcNotDataArray # if data array, no more xforming to do
4197##...slt $at,$t1,$t0
4201##...bne $at,$zero,4220

    # We have a vtable address that is a data array.
    # we need skip over it then loop back to do next object.
4204:  skipToNextObj:
4204#    lw $t1,-4($t2) # data words in (object position of) array
    #### note: we know that it's not a string, so the value will
    #### not be artificially negative
4208#    sll $t1,$t1,2 # convert to byte-count
4212#    addu $t0,$t2,$t1 # skip over object
4216#    j gcTestIterDone2 # go do next object, if any

    ###################################################
    # at this point:
    # - the object has been restored to normal status--that is, the
    #   word-swap has been done
    # - $t2 contains a pointer to the object
    ###################################################
    
4220:  gcNotDataArray:
4220#    lw $t3,-4($t2) # # object words (negative treated as zero)
4224#    bge $t3,$zero,gcH2Neg2
4225##...slt $at,$t3,$zero
4229##...beq $at,$zero,4236
4232#    move $t3,$zero
4236:  gcH2Neg2:
4236#    sll $t3,$t3,2 # # object bytes
4240#    move $t0,$t2 # address of first pointer in object
4244#    add $s1,$t2,$t3 # limit address for this object

    #####################################################
    # At this point, we have to "translate" all pointers,
    # starting at $t0 to (but not including) $s1
    #####################################################

    # if there are no pointer-slots (i.e., $t0=$s1), skip this
    # part
4248#    beq $t0,$s1,gcTestIterDone2
    
4252:  gcNextPointerInObject:
