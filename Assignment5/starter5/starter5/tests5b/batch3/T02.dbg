###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
7804:mth_readLine_Lib:
    
7804#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
7808#    sw $ra, 4($sp) # save $ra
7812#    move $t1,$sp # save "original" sp

7816:  doRead:

    # read the character
7816#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
7820#    subu $t2,$v0,13
7824#    bne $t2,$zero,notReturnRL
7828#    jal readLogicalChar
7832#    subu $t2,$v0,10 # check for newline
7836#    beq $t2,$zero,foundNewLine
7840#    sw $v0,lastCharRead # push back character into queue
7844#    j foundNewLine # go process the line

7848:  notReturnRL:

    # at this point, $v0 has our character

7848#    subu $t0,$v0,10
7852#    beq $t0,$zero,foundNewLine
7856#    blt $v0,$zero,foundEof
7857##...slt $at,$v0,$zero
7861##...bne $at,$zero,7876

    # we have a character, so push it onto stack
7864#    subu $sp,$sp,4
7868#    sw $v0,($sp)

    # loop back up to get next character
7872#    j doRead

7876:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
7876#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
7880#    li $s7, 0 # return-value: null
7884#    j rlReturn # return

7888:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
7888#    subu $t0,$t1,$sp # number of chars we read (times 4)
7892#    srl $s6,$t0,2 # number of words on stack with chars
7896#    subu $sp,$sp,4 # push char-count ...
7900#    sw $s6,($sp) # ... onto stack
7904#    addu $t2,$t0,5 # GC tag, incl. for count-word
7908#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
7912#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
7916#    srl $s6,$s6,2  # data words in object
7920#    move $s7,$zero # object words in object
7924#    jal newObject  # allocate space
    
    # store header words
7928#    la $t0,CLASS_String
7932#    sw $t0,-12($s7)# store class tag (String) into object
7936#    lw $t2,4($sp) # char-count
7940#    sll $t1,$t2,2 # 4 times number of chars
7944#    subu $t2,$zero,$t2 # negative of char-count
7948#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
7952#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
7956#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
7957##...slt $at,$t0,$zero
7961##...beq $at,$zero,7980
7964#    and $t0,0xff # mask off object's hash value ...
7965##...lui $at,0
7969##...ori $at,$at,0xff
7973##...and $t0,$t0,$at
7976#    sw $t0,-8($s7) # ... and store back into -8 header-word
7980:  skipMask_readLine:

7980#    sll $t0,$t0,2 # data bytes in object
7984#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
7988#    subu $t0,$t0,$t2 # place to store last character (plus 9)
7992#    addu $sp,$sp,8 # pop redundant object-pointer and count
7996#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

8000#    beq $sp,$t1,rlReturn
8004:  charCopyLoop:
8004#    lw $t2,($sp)
8008#    sb $t2,-9($t0)
8012#    addu $sp,$sp,4
8016#    subu $t0,$t0,1
8020#    bne $sp,$t1,charCopyLoop
8024:  rlReturn:

8024#    lw $ra, 4($sp)
8028#    addu $sp, 8   # pop $ra and pointless word off stack
8032#    move $t0, $s7 # return string we allocated in $s7
8036#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
8040:mth_readInt_Lib:

    # save $ra by pushing onto stack
8040#    subu $sp,$sp,4
8044#    sw $ra,($sp)

8048:  riSkipWhiteLoop:
    # read a character
8048#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
8052#    subu $t0,$v0,32
8056#    bgt $t0,$zero,nonWhite
8057##...slt $at,$zero,$t0
8061##...bne $at,$zero,8104
8064#    beq $t0,$zero,riSkipWhiteLoop # start over if space
8068#    subu $t0,$v0,10
8072#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
8076#    subu $t0,$v0,9
8080#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
8084#    subu $t0,$v0,13
8088#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
8092#    subu $t0,$v0,12
8096#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
8100#    j badIntegerFormat # illegal integer char: abort program

8104:  nonWhite:
8104#    subu $t0,$v0,'-'
8108#    li $t4,1 # final multiplier
8112#    bne $t0,$zero,helpReadInt # go read
8116#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
8120#    jal readLogicalChar

8124:  helpReadInt:
8124#    li $t2,10
8128#    subu $t1,$v0,'0' # convert digit to 0-9 value
8132#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
8133##...sltu $at,$t1,$t2
8137##...beq $at,$zero,10420
8140#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

8144:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

8144#    jal readLogicalChar # read next character
8148#    subu $t1,$v0,'0' # convert digit to 0-9 value
8152#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
8153##...sltu $at,$t1,$t2
8157##...beq $at,$zero,8176

8160#    mul $t3,$t3,$t2 # multiply old value by 10
8161##...mult $t3,$t2
8165##...mflo $t3
8168#    addu $t3,$t3,$t1 # add in value of new digit
8172#    j digitLoop

8176:  doneDigitLoop:

    # "push back" unused character into queue
8176#    sw $v0,lastCharRead

    # restore return address
8180#    lw $ra,($sp)
8184#    addu $sp, 4

    # multiply by sign and put return value in $t0
8188#    mult $t3,$t4 # multiply to account for poss. minus sign
8192#    mflo $t3
8196#    move $t0, $t3
    
    # return
8200#    jr $ra

###################################################################
# readChar() - library method (class Lib)
# - reads a single character from standard input
