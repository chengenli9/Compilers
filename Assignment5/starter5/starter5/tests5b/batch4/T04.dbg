3801##...bne $at,$zero,3784

    # at this point:
    #  $s3 has been updated to point to the next free slot,
    #    which is also the points just past our object

    # compute pointer value and set up header-words
3804#    sll $t0,$s7,2    # number of post-header bytes
3808#    subu $t0,$s3,$t0 # pointer that we will return

    # determine the value to store in the first header-word:
    # if <= 255 (unsigned):
    #  - it goes into low byte
    #  - hash bits go into high three bytes, with top bit being 1
    # if >255 (unsigned)
    #  - it goes into full word (with a 0 in the high bit)
    
3812#    li $t2,255
3816#    bgeu $s6,$t2 firstHeaderLarge
3817##...sltu $at,$s6,$t2
3821##...beq $at,$zero,3868
3824#    lw $t1,prevHashConstant
3828#    addu $t1,0x12b68fd2
3829##...lui $at,4791
3833##...addiu $at,$at,-28718
3837##...addu $t1,$at,$t1
3840#    sw $t1,prevHashConstant # update hash constant
3844#    or $t1,0x80000000 # set top bit
3845##...lui $at,32768
3849##...or $t1,$at,$t1
3852#    and $t1,0xffffff00 # clear low bit
3853##...lui $at,65535
3857##...ori $at,$at,0xff00
3861##...and $t1,$t1,$at
3864#    or $s6,$t1
3868:firstHeaderLarge:
3868#    sw $s6,-8($t0) # store header-1 value
3872#    lw $zero,-8($t0)

    # store second header-value
3876#    sw $s7,-4($t0)   # second header-word
3880#    lw $zero,-4($t0)
    
    # put return-value into $s7 and also push it onto top of stack
3884#    move $s7,$t0
3888#    subu $sp,$sp,4
3892#    sw $t0,($sp)

3896#    jr $ra
