# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1392:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
1392#    lw $t0,-8($s2) # get word with hash bits from this
1396#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
1400#    addu $t0,$t1

1404#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1408:mth_equals_Object:
1408#    move $t0,$s2 # first pointer (this)
1412#    lw $t1,($sp) # second pointer
1416#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
1417##...subu $at,$t0,$t1
1421##...sltiu $t0,$at,1

1424#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1428:mth_hashCode_String:
1428#    move $t0,$s2 # put this pointer in t0

1432#    li $t2,0 # current hash value
1436#    lw $t1,-4($t0) # negative of number of characters in string
1440#    beq $t1,$zero,done_hashCode_String # if zero length => done
1444#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
1448#    and $t0,0xfffffffc # adjust for padding
1449##...lui $at,65535
1453##...ori $at,$at,0xfffc
1457##...and $t0,$t0,$at
1460#    subu $t1,$t0,$t1 # address at end of string +12
1464:loop_hashCode_String:    
1464#    sll $t4,$t2,5 # multiply by 32
1468#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
1472#    lbu $t3,-12($t0) # current character
1476#    addu $t2,$t3 # add in current character
1480#    addu $t0,1 # go to next character's address
1484#    bne $t0,$t1,loop_hashCode_String # loop back if more
1488:done_hashCode_String:    

    # push int on stack
1488#    move $t0, $t2 # put $t2 in return slot
1492#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
1496:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
1496#    subu $sp,4
1500#    sw $ra,($sp)
    
    # get hash value
1504#    lw $t2,-12($s2) # vtable address
1508#    lw $t0,($t2) # method address
1512#    jalr $t0
1516#    subu $sp,8 # push result (int in $t0) on stack
1520#    sw $s5,4($sp)
1524#    sw $t0,($sp)

    # compute print-size of hash value
1528#    li $t0, 1
1532#    lw $t1, ($sp)
1536#    srl $t1,$t1,4
1540#    beq $t1,$zero,toString_skip_loop
1544:toString_loop_top:
1544#    addu $t0,1
1548#    srl $t1,$t1,4
1552#    bne $t1,$zero,toString_loop_top
1556:toString_skip_loop:
1556#    subu $sp,8
1560#    sw $s5,4($sp)
1564#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
1568#    lw $t2,-12($s2) # vtable address
1572#    move $t0,$t2
1576:toString_checkTagBit:
1576#    subu $t0,1
1580#    lb $t1,($t0)
1584#    and $t1,0x80
1585##...lui $at,0
1589##...ori $at,$at,0x80
1593##...and $t1,$t1,$at
1596#    beq $t1,$zero,toString_checkTagBit
1600#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
1604#    subu $sp,8
1608#    sw $t1,($sp)
1612#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
1616#    move $s7,$zero # -4 offset header word
1620#    lw $t4,8($sp) # bytes for hash value
1624#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
1628#    addu $t4,8
1632#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
1636#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

1640#    li $t0,CLASS_String # store string vtable address into ...
1644#    sw $t0,-12($s7) # ... -12 offset in object header
1648#    lw $t2,-12($s2) # our object's vtable address
1652#    lw $t5,4($sp) # number characters in prefix
1656#    lw $t1,12($sp) # number of characters in hashcode
1660#    addu $t3,$t1,$t5 # number of characters in string ...
1664#    addu $t3,1 # ... including the '@' character
1668#    subu $t0,$zero,$t3 # store negated length into ...
1672#    sw $t0,-4($s7) # ... -4 offset header word
1676#    lw $t0,-8($s7) # get -8 offset header-word
1680#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
1681##...slt $at,$t0,$zero
1685##...beq $at,$zero,1704
1688#    and $t0,0xff # mask off object's hash value ...
1689##...lui $at,0
1693##...ori $at,$at,0xff
1697##...and $t0,$t0,$at
1700#    sw $t0,-8($s7) # ... and store back into -8 header-word
1704:skipMask_toString:
1704#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
1708#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
1712#    subu $t4,$t2,$t5
1716:toString_copyLoop:    
1716#    lb $t3,($t4)
1720#    and $t3,0x7f # mask off sign bit (in case first word)
1721##...lui $at,0
1725##...ori $at,$at,0x7f
1729##...and $t3,$t3,$at
1732#    sb $t3,-8($t0)
1736#    addu $t4,1
1740#    addu $t0,1
1744#    blt $t4,$t2,toString_copyLoop
1745##...slt $at,$t4,$t2
1749##...bne $at,$zero,1716

    # copy the '@' sign
1752#    li $t3,'@'
1756#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
1760#    addu $t2,$t0,$t1 # address of last byte in string to store +8
1764#    lw $t3,20($sp) # hash code to print
1768:toString_hashCopyLoop:
1768#    and $t4,$t3,0xf
1772#    srl $t3,4
1776#    lb $t4,hexChars($t4)
1780#    sb $t4,-8($t2)
1784#    subu $t2,$t2,1
1788#    bgt $t2,$t0,toString_hashCopyLoop
1789##...slt $at,$t0,$t2
1793##...bne $at,$zero,1768

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
1796#    addu $sp,28
1800#    lw $ra,($sp)
1804#    addu $sp,4
1808#    move $t0, $s7 # return string we created
1812#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
1816:mth_equals_String:
    
    # quick test for obvious false
1816#    lw $t0,($sp) # second parameter
1820#    beq $t0,$zero,goEsFalse # go return false if null
1824#    lw $t1,-12($t0) # vtable pointer
1828#    la $t2,CLASS_String # string vtable pointer
1832#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
1836#    subu $sp,12
1840#    sw $ra,8($sp)
1844#    sw $s2,4($sp)
1848#    sw $t0,($sp)
1852#    jal mth_compareTo_String
1856#    lw $s2, 4($sp) #restore this pointer and pop parameters
1860#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
1864#    seq $t0,$t0,$zero
1865##...subu $at,$t0,$zero
1869##...sltiu $t0,$at,1

    # pop return address and return $t0
1872#    lw $ra,($sp)
1876#    addu $sp,4

1880#    jr $ra # return
    
1884:goEsFalse:
    # put 0 in $t0 and return
1884#    li $t0, 0
1888#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
1892:mth_toString_String:
    #we are a string, so return this.
1892#    move $t0, $s2
1896#    jr $ra

###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
1900:mth_readLine_Lib:
    
1900#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
1904#    sw $ra, 4($sp) # save $ra
1908#    move $t1,$sp # save "original" sp

1912:  doRead:

    # read the character
1912#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
1916#    subu $t2,$v0,13
1920#    bne $t2,$zero,notReturnRL
1924#    jal readLogicalChar
1928#    subu $t2,$v0,10 # check for newline
1932#    beq $t2,$zero,foundNewLine
1936#    sw $v0,lastCharRead # push back character into queue
1940#    j foundNewLine # go process the line

1944:  notReturnRL:

    # at this point, $v0 has our character

1944#    subu $t0,$v0,10
1948#    beq $t0,$zero,foundNewLine
1952#    blt $v0,$zero,foundEof
1953##...slt $at,$v0,$zero
1957##...bne $at,$zero,1972

    # we have a character, so push it onto stack
1960#    subu $sp,$sp,4
1964#    sw $v0,($sp)

    # loop back up to get next character
1968#    j doRead

1972:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
1972#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
1976#    li $s7, 0 # return-value: null
1980#    j rlReturn # return

1984:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
1984#    subu $t0,$t1,$sp # number of chars we read (times 4)
1988#    srl $s6,$t0,2 # number of words on stack with chars
1992#    subu $sp,$sp,4 # push char-count ...
1996#    sw $s6,($sp) # ... onto stack
2000#    addu $t2,$t0,5 # GC tag, incl. for count-word
2004#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
2008#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
2012#    srl $s6,$s6,2  # data words in object
2016#    move $s7,$zero # object words in object
2020#    jal newObject  # allocate space
    
    # store header words
2024#    la $t0,CLASS_String
2028#    sw $t0,-12($s7)# store class tag (String) into object
2032#    lw $t2,4($sp) # char-count
2036#    sll $t1,$t2,2 # 4 times number of chars
2040#    subu $t2,$zero,$t2 # negative of char-count
2044#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
2048#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
2052#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
2053##...slt $at,$t0,$zero
2057##...beq $at,$zero,2076
2060#    and $t0,0xff # mask off object's hash value ...
2061##...lui $at,0
2065##...ori $at,$at,0xff
2069##...and $t0,$t0,$at
2072#    sw $t0,-8($s7) # ... and store back into -8 header-word
2076:  skipMask_readLine:

2076#    sll $t0,$t0,2 # data bytes in object
2080#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
2084#    subu $t0,$t0,$t2 # place to store last character (plus 9)
2088#    addu $sp,$sp,8 # pop redundant object-pointer and count
2092#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

2096#    beq $sp,$t1,rlReturn
2100:  charCopyLoop:
2100#    lw $t2,($sp)
2104#    sb $t2,-9($t0)
2108#    addu $sp,$sp,4
2112#    subu $t0,$t0,1
2116#    bne $sp,$t1,charCopyLoop
2120:  rlReturn:

2120#    lw $ra, 4($sp)
2124#    addu $sp, 8   # pop $ra and pointless word off stack
2128#    move $t0, $s7 # return string we allocated in $s7
2132#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
2136:mth_readInt_Lib:

    # save $ra by pushing onto stack
2136#    subu $sp,$sp,4
2140#    sw $ra,($sp)

2144:  riSkipWhiteLoop:
    # read a character
2144#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
2148#    subu $t0,$v0,32
2152#    bgt $t0,$zero,nonWhite
2153##...slt $at,$zero,$t0
2157##...bne $at,$zero,2200
2160#    beq $t0,$zero,riSkipWhiteLoop # start over if space
2164#    subu $t0,$v0,10
2168#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
2172#    subu $t0,$v0,9
2176#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
2180#    subu $t0,$v0,13
2184#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
2188#    subu $t0,$v0,12
2192#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
2196#    j badIntegerFormat # illegal integer char: abort program

2200:  nonWhite:
2200#    subu $t0,$v0,'-'
2204#    li $t4,1 # final multiplier
2208#    bne $t0,$zero,helpReadInt # go read
2212#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
2216#    jal readLogicalChar

2220:  helpReadInt:
2220#    li $t2,10
2224#    subu $t1,$v0,'0' # convert digit to 0-9 value
2228#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
2229##...sltu $at,$t1,$t2
2233##...beq $at,$zero,4516
2236#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

2240:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

2240#    jal readLogicalChar # read next character
2244#    subu $t1,$v0,'0' # convert digit to 0-9 value
2248#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
2249##...sltu $at,$t1,$t2
2253##...beq $at,$zero,2272

