3905##...bne $at,$zero,3888

    # at this point:
    #  $s3 has been updated to point to the next free slot,
    #    which is also the points just past our object

    # compute pointer value and set up header-words
3908#    sll $t0,$s7,2    # number of post-header bytes
3912#    subu $t0,$s3,$t0 # pointer that we will return

    # determine the value to store in the first header-word:
    # if <= 255 (unsigned):
    #  - it goes into low byte
    #  - hash bits go into high three bytes, with top bit being 1
    # if >255 (unsigned)
    #  - it goes into full word (with a 0 in the high bit)
    
3916#    li $t2,255
3920#    bgeu $s6,$t2 firstHeaderLarge
3921##...sltu $at,$s6,$t2
3925##...beq $at,$zero,3972
3928#    lw $t1,prevHashConstant
3932#    addu $t1,0x12b68fd2
3933##...lui $at,4791
3937##...addiu $at,$at,-28718
3941##...addu $t1,$at,$t1
3944#    sw $t1,prevHashConstant # update hash constant
3948#    or $t1,0x80000000 # set top bit
3949##...lui $at,32768
3953##...or $t1,$at,$t1
3956#    and $t1,0xffffff00 # clear low bit
3957##...lui $at,65535
3961##...ori $at,$at,0xff00
3965##...and $t1,$t1,$at
3968#    or $s6,$t1
3972:firstHeaderLarge:
3972#    sw $s6,-8($t0) # store header-1 value
3976#    lw $zero,-8($t0)

    # store second header-value
3980#    sw $s7,-4($t0)   # second header-word
3984#    lw $zero,-4($t0)
    
    # put return-value into $s7 and also push it onto top of stack
3988#    move $s7,$t0
3992#    subu $sp,$sp,4
3996#    sw $t0,($sp)

4000#    jr $ra
