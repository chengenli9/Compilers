    # get lengths of two strings; allocate object whose size
    # is their sum divided by 4 (rounded up) plus 1
1612#    lw $t0,-4($t0) # negative size of second object
1616#    lw $t1,-4($t1) # negative size of first object
1620#    addu $s6,$t0,$t1 # sum of negative sizes
