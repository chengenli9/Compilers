##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
984:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
984#    lw $t0,-8($s2) # get word with hash bits from this
988#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
992#    addu $t0,$t1

996#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1000:mth_equals_Object:
1000#    move $t0,$s2 # first pointer (this)
1004#    lw $t1,($sp) # second pointer
1008#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
1009##...subu $at,$t0,$t1
1013##...sltiu $t0,$at,1

1016#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1020:mth_hashCode_String:
1020#    move $t0,$s2 # put this pointer in t0

1024#    li $t2,0 # current hash value
1028#    lw $t1,-4($t0) # negative of number of characters in string
1032#    beq $t1,$zero,done_hashCode_String # if zero length => done
1036#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
1040#    and $t0,0xfffffffc # adjust for padding
1041##...lui $at,65535
1045##...ori $at,$at,0xfffc
1049##...and $t0,$t0,$at
1052#    subu $t1,$t0,$t1 # address at end of string +12
1056:loop_hashCode_String:    
1056#    sll $t4,$t2,5 # multiply by 32
1060#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
1064#    lbu $t3,-12($t0) # current character
1068#    addu $t2,$t3 # add in current character
1072#    addu $t0,1 # go to next character's address
1076#    bne $t0,$t1,loop_hashCode_String # loop back if more
1080:done_hashCode_String:    

    # push int on stack
1080#    move $t0, $t2 # put $t2 in return slot
1084#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
1088:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
1088#    subu $sp,4
1092#    sw $ra,($sp)
    
    # get hash value
1096#    lw $t2,-12($s2) # vtable address
1100#    lw $t0,($t2) # method address
1104#    jalr $t0
1108#    subu $sp,8 # push result (int in $t0) on stack
1112#    sw $s5,4($sp)
1116#    sw $t0,($sp)

    # compute print-size of hash value
1120#    li $t0, 1
1124#    lw $t1, ($sp)
1128#    srl $t1,$t1,4
1132#    beq $t1,$zero,toString_skip_loop
1136:toString_loop_top:
