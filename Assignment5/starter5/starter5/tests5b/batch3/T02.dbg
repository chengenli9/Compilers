###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
7760:mth_equals_String:
    
    # quick test for obvious false
7760#    lw $t0,($sp) # second parameter
7764#    beq $t0,$zero,goEsFalse # go return false if null
7768#    lw $t1,-12($t0) # vtable pointer
7772#    la $t2,CLASS_String # string vtable pointer
7776#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
7780#    subu $sp,12
7784#    sw $ra,8($sp)
7788#    sw $s2,4($sp)
7792#    sw $t0,($sp)
7796#    jal mth_compareTo_String
7800#    lw $s2, 4($sp) #restore this pointer and pop parameters
7804#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
7808#    seq $t0,$t0,$zero
7809##...subu $at,$t0,$zero
7813##...sltiu $t0,$at,1

    # pop return address and return $t0
7816#    lw $ra,($sp)
7820#    addu $sp,4

7824#    jr $ra # return
    
7828:goEsFalse:
    # put 0 in $t0 and return
7828#    li $t0, 0
7832#    jr $ra # return

