###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
4660:mth_readLine_Lib:
    
4660#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
4664#    sw $ra, 4($sp) # save $ra
4668#    move $t1,$sp # save "original" sp

4672:  doRead:

    # read the character
4672#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
4676#    subu $t2,$v0,13
4680#    bne $t2,$zero,notReturnRL
4684#    jal readLogicalChar
4688#    subu $t2,$v0,10 # check for newline
4692#    beq $t2,$zero,foundNewLine
4696#    sw $v0,lastCharRead # push back character into queue
4700#    j foundNewLine # go process the line

4704:  notReturnRL:

    # at this point, $v0 has our character

4704#    subu $t0,$v0,10
4708#    beq $t0,$zero,foundNewLine
4712#    blt $v0,$zero,foundEof
4713##...slt $at,$v0,$zero
4717##...bne $at,$zero,4732

    # we have a character, so push it onto stack
4720#    subu $sp,$sp,4
4724#    sw $v0,($sp)

    # loop back up to get next character
4728#    j doRead

4732:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
4732#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
4736#    li $s7, 0 # return-value: null
4740#    j rlReturn # return

4744:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
4744#    subu $t0,$t1,$sp # number of chars we read (times 4)
4748#    srl $s6,$t0,2 # number of words on stack with chars
4752#    subu $sp,$sp,4 # push char-count ...
4756#    sw $s6,($sp) # ... onto stack
4760#    addu $t2,$t0,5 # GC tag, incl. for count-word
4764#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
4768#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
4772#    srl $s6,$s6,2  # data words in object
4776#    move $s7,$zero # object words in object
4780#    jal newObject  # allocate space
    
    # store header words
4784#    la $t0,CLASS_String
4788#    sw $t0,-12($s7)# store class tag (String) into object
4792#    lw $t2,4($sp) # char-count
4796#    sll $t1,$t2,2 # 4 times number of chars
4800#    subu $t2,$zero,$t2 # negative of char-count
4804#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
4808#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
4812#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
4813##...slt $at,$t0,$zero
4817##...beq $at,$zero,4836
4820#    and $t0,0xff # mask off object's hash value ...
4821##...lui $at,0
4825##...ori $at,$at,0xff
4829##...and $t0,$t0,$at
4832#    sw $t0,-8($s7) # ... and store back into -8 header-word
4836:  skipMask_readLine:

4836#    sll $t0,$t0,2 # data bytes in object
4840#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
4844#    subu $t0,$t0,$t2 # place to store last character (plus 9)
4848#    addu $sp,$sp,8 # pop redundant object-pointer and count
4852#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

4856#    beq $sp,$t1,rlReturn
4860:  charCopyLoop:
4860#    lw $t2,($sp)
4864#    sb $t2,-9($t0)
4868#    addu $sp,$sp,4
4872#    subu $t0,$t0,1
4876#    bne $sp,$t1,charCopyLoop
4880:  rlReturn:

4880#    lw $ra, 4($sp)
4884#    addu $sp, 8   # pop $ra and pointless word off stack
4888#    move $t0, $s7 # return string we allocated in $s7
4892#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
4896:mth_readInt_Lib:

    # save $ra by pushing onto stack
4896#    subu $sp,$sp,4
4900#    sw $ra,($sp)

4904:  riSkipWhiteLoop:
    # read a character
4904#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
4908#    subu $t0,$v0,32
4912#    bgt $t0,$zero,nonWhite
4913##...slt $at,$zero,$t0
4917##...bne $at,$zero,4960
4920#    beq $t0,$zero,riSkipWhiteLoop # start over if space
4924#    subu $t0,$v0,10
4928#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
4932#    subu $t0,$v0,9
4936#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
4940#    subu $t0,$v0,13
4944#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
4948#    subu $t0,$v0,12
4952#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
4956#    j badIntegerFormat # illegal integer char: abort program

4960:  nonWhite:
4960#    subu $t0,$v0,'-'
4964#    li $t4,1 # final multiplier
4968#    bne $t0,$zero,helpReadInt # go read
4972#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
4976#    jal readLogicalChar

4980:  helpReadInt:
4980#    li $t2,10
4984#    subu $t1,$v0,'0' # convert digit to 0-9 value
4988#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
4989##...sltu $at,$t1,$t2
4993##...beq $at,$zero,7276
4996#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

5000:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

5000#    jal readLogicalChar # read next character
5004#    subu $t1,$v0,'0' # convert digit to 0-9 value
5008#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
5009##...sltu $at,$t1,$t2
5013##...beq $at,$zero,5032

5016#    mul $t3,$t3,$t2 # multiply old value by 10
5017##...mult $t3,$t2
5021##...mflo $t3
5024#    addu $t3,$t3,$t1 # add in value of new digit
5028#    j digitLoop

5032:  doneDigitLoop:

    # "push back" unused character into queue
5032#    sw $v0,lastCharRead

    # restore return address
5036#    lw $ra,($sp)
5040#    addu $sp, 4

    # multiply by sign and put return value in $t0
5044#    mult $t3,$t4 # multiply to account for poss. minus sign
5048#    mflo $t3
5052#    move $t0, $t3
    
    # return
5056#    jr $ra
