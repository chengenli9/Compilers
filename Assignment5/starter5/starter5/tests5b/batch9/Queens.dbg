########################################################
# str1.concat(str2) - library method (class String)
# (as in Java)
# - parameters:
#   - ($sp) - the second string
#   - 4($sp) - old this pointer
#   - $s2 - the first string (this)
# - returns:
#   - $t0 - pointer to concatenated string
########################################################
4744:mth_concat_String:
    # save $ra by pushing onto stack
4744#    subu $sp,$sp,4
4748#    sw $ra, ($sp)

    # get string pointers and check parameter for null
4752#    lw $t0,4($sp)
4756#    beq $t0,$zero,nullPtrException
4760#    move $t1,$s2
    
    # get lengths of two strings; allocate object whose size
    # is their sum divided by 4 (rounded up) plus 1
4764#    lw $t0,-4($t0) # negative size of second object
4768#    lw $t1,-4($t1) # negative size of first object
4772#    addu $s6,$t0,$t1 # sum of negative sizes
4776#    sra $s6,$s6,2 # negative word-size of char part
4780#    subu $s6,$zero,$s6 # word size of char part
4784#    addu $s6,$s6,1 # data word size, including v-table word
4788#    move $s7,$zero
4792#    jal newObject

    # store String vtable address in vtable address field
4796#    la $t0,CLASS_String
4800#    sw $t0,-12($s7)
        
    # mask off hash bits, if needed
4804#    lw $t4,-8($s7) # # data words in source string
4808#    bge $t4,$zero,skipMask_concat # don't strip hash code if not there
4809##...slt $at,$t4,$zero
4813##...beq $at,$zero,4832
4816#    and $t4,0xff # mask off object's hash value ...
4817##...lui $at,0
4821##...ori $at,$at,0xff
4825##...and $t4,$t4,$at
4828#    sw $t4,-8($s7) # ... and store back into -8 header-word
4832:skipMask_concat:

4832#    move $t9, $s7 # store return string in unused (I hope) t9 register

    #restore $t0, and $t1 after they were potentially blown
    #away by newObject
4836#    move $t1,$s2   # first object
4840#    lw $t0,8($sp) # second object
    
    # get negative sizes; sum and store in new object size-field
4844#    lw $t2,-4($t0) # negative length of second object
4848#    lw $t3,-4($t1) # negative length of first object
4852#    addu $t4,$t2,$t3 # sum of negative lengths
4856#    sw $t4,-4($s7) # store sum as negated target-string length

    #########################################################
    # at this point:
    # - $t0 is pointer to second object
    # - $t1 is pointer to first object
    # - $t2 is negated length of second object
    # - $t3 is negated length of first object
    # - $s7 is pointer to new object
    #########################################################

    # compute addresses for moving data from first string
4860#    lw $t4,-8($t1) # # data words in first string
4864#    sll $t4,$t4,2 # # data bytes in first string
4868#    subu $t1,$t1,$t4 # addr. (+8) of first byte in first string
4872#    lw $t4,-8($s7) # # data words in new string
4876#    sll $t4,$t4,2 # # data bytes in new string
4880#    subu $s7,$s7,$t4 # addr. (+8) of first byte in new string
4884#    beq $zero,$t3,doneConcatLoop1zz # skip first loop is no bytes to copy
4888#    subu $t3,$t1,$t3 # limit (+8) address for first string

    #########################################################
    # at this point:
    # - $t0 is pointer to second object
    # - $t1 is address (+8) of first byte in first object
    # - $t2 is negated length of second object
    # - $t3 is limit-address (+8) of data in first object
    # - $s7 is address (+8) of first byte in new object
    # - note: if data-length of first object is zero, then
    #   we skip over this part, and go to 'doneConcatLoop1'
    #########################################################

    # copy the bytes from first source to target
4892:  concatLoop1zz:
4892#    lb $t4,-8($t1)
4896#    sb $t4,-8($s7)
4900#    addu $s7,$s7,1
4904#    addu $t1,$t1,1
4908#    blt $t1,$t3,concatLoop1zz
4909##...slt $at,$t1,$t3
4913##...bne $at,$zero,4892
4916:  doneConcatLoop1zz:
  
    # if second string is empty, skip rest of copy
4916#    beq $zero,$t2,doneConcatLoop2zz

      # compute addresses for moving data from second string
4920#    lw $t4,-8($t0) # # data words in second string
4924#    sll $t4,$t4,2 # # data bytes in second string
4928#    subu $t1,$t0,$t4 # addr. (+8) of first byte in second string
4932#    subu $t3,$t1,$t2 # limit (+8) address for second string

    #########################################################
    # at this point:
    # - $t1 is address (+8) of first byte in second object
    # - $t3 is limit-address (+8) of data in second object
    # - $s7 is address (+8) of next byte to write new object
    # - note: if data-length of second object is zero, then
    #   we skip over this part, and go to 'doneConcatLoop2'
    #########################################################

    # copy the bytes from first source to target
4936:  concatLoop2zz:
