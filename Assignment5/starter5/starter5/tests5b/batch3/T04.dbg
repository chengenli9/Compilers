    # buffer and return
4472#    sw $t0,lastCharRead # store -2 into buffer (i.e. "empty")
4476#    jr $ra # return
    
4480:  doReadCh:
    # we need to actually read a character: read and return
4480#    li $v0,12 # use system call to read a character
4484#    syscall
4488#    jr $ra # return
