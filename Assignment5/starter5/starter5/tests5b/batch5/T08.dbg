#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
4764:instanceOf:
    # get object, go return false if null
4764#    lw $t2,($sp)
4768#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
4772#    lw $t2,-12($t2) # vtable address
4776#    sge $t0,$t2,$t0 # are we >= the lower limit?
4777##...slt $t0,$t2,$t0
4781##...xori $t0,$t0,0x1
4784#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
4788#    and $t2,$t0,$t1
4792#    sw $t2,($sp)
4796:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
4796#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

4800:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
4800#    li $v0,4 # syscall-code for print-string
4804#    syscall
4808:exit:
    # print termination message
4808#    li $v0,4 # syscall-code for print-string
4812#    la $a0,exitString
4816#    syscall

    # print number of garbage collections
4820#    li $v0,4 # syscall-code for print-string
4824#    la $a0,gcCountMsg
4828#    syscall # print "Number of ..."
4832#    lw $a0,gcCount # number of GC's
4836#    li $v0,1 # code for print-int
4840#    syscall
4844#    li $v0,4 # syscall-code for print-string
4848#    la $a0,newlineString
4852#    syscall # print newline

    # terminate execution
4856#    li $v0,10 #syscall-code for "exit"
4860#    syscall

4864:outOfHeapMemory:
4864#    la $a0,heapMemoryMsg
4868#    j exitError
4872:divByZeroError:
4872#    la $a0,divByZeroMsg
4876#    j exitError
4880:strIndexOutOfBounds:
4880#    la $a0,strIndexOutOfBoundsMsg
4884#    j exitError
4888:arrayIndexOutOfBounds:
4888#    la $a0,arrayIndexOutOfBoundsMsg
4892#    j exitError
4896:arraySizeOutOfBounds:
4896#    la $a0,arraySizeOutOfBoundsMsg
4900#    j exitError
4904:nullPtrException:
4904#    la $a0,nullPtrExceptionMsg
4908#    j exitError
4912:badIntegerFormat:
4912#    la $a0,badIntegerFormatMsg
4916#    j exitError
4920:castException:
4920#    la $a0,castExceptionMsg
4924#    j exitError
############## data section ################
    .data
5252:hexChars:
    .ascii "0123456789abcdef"
    .align 2
5268:cur_seg:
    .word 0

5272:lastCharRead:
    .word -2 # -2 => no buffered character
5276:prevHashConstant:
    .word 0x2785173c
5280:gcCount:
    .word 0

5284:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
5311:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
5334:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
5369:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
5403:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
5436:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
5467:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
5515:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
5536:gcMsg: 
      .asciiz "\nGC!\n"
5542:gcCountMsg: 
      .asciiz "Number of garbage collections: "

5574:nullStr:
    .asciiz "null"
5579:trueString:
    .asciiz "true"
5584:falseString:
    .asciiz "false"
5590:exitString:
    .ascii "Program execution completed."
    #### "falls through" here
5618:newlineString:
    .asciiz "\n"
    
    .align 2
5620:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

5624:seg0_start:
    .space 0x100000
1054200:seg0_end:
1054200:seg1_start:
    .space 0x100000
2102776:seg1_end:
