789##...beq $at,$zero,808
792#    and $t0,0xff # mask off object's hash value ...
793##...lui $at,0
797##...ori $at,$at,0xff
801##...and $t0,$t0,$at
804#    sw $t0,-8($s7) # ... and store back into -8 header-word
808:  skipMask_readLine:

808#    sll $t0,$t0,2 # data bytes in object
812#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
816#    subu $t0,$t0,$t2 # place to store last character (plus 9)
820#    addu $sp,$sp,8 # pop redundant object-pointer and count
824#    addu $t1,$t1,$sp # first non-char spot on stack
