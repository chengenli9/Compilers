3604#    and $t8,0xff # mask off hash bits
3605##...lui $at,0
3609##...ori $at,$at,0xff
3613##...and $t8,$t8,$at

3616:  gcSkip5:
3616#    sll $t8,$t8,2 # bytes in negative-offset portion ...
3620#    addu $t8,$t8,8 # ... add in bytes for header-words
3624#    subu $t4,$t1,$t8 # address of first word of source object
3628#    lw $t3,-4($t1) # # words in positive-offset portion
3632#    bge $t3,$zero,gcNoNeg
3633##...slt $at,$t3,$zero
3637##...beq $at,$zero,3644
3640#    move $t3,$zero # negative treated as zero
3644:  gcNoNeg:
3644#    sll $t3,$t3,2 # bytes in negative-offset portion
3648#    addu $t3,$t3,$t1 # address one word past last word of source

3652#    addu $t8,$s3,$t8 # pointer to target object

    #########################################################
    # At this point:
    # - $t0 contains the address of the stack slot we'll
    #   process next
    # - $t1 contains the contents of the stack slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $t8 contains the pointer to the target object
    # - $s1 contains the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0, $t9
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger"
3656#    lw $s0,($t4)
3660#    lw $t9,-8($t1)
3664#    sw $t9,($t4)
3668#    sw $s0,-8($t1)

    # copy all source bytes to the target
3672:  gCinnerCopy2:
3672#    lw $s0,($t4)
3676#    sw $s0,($s3)
3680#    addu $t4,$t4,4
3684#    addu $s3,$s3,4
3688#    bltu $t4,$t3,gCinnerCopy2
3689##...sltu $at,$t4,$t3
3693##...bne $at,$zero,3672

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
3696#    sw $zero,-8($t1) # 0 in first header-slot
3700#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
3704#    sw $t8,($t0)

3708:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
3708#    addu $t0,$t0,4
3712#    bltu $t0,$s1,gcNextPointerInObject
3713##...sltu $at,$t0,$s1
3717##...bne $at,$zero,3556

3720:  gcTestIterDone2:
3720#    bltu $t0,$s3,gcHeapCopyLoop
3721##...sltu $at,$t0,$s3
3725##...bne $at,$zero,3440

    ###### end outer loop to copy all non-stack-direct objects ######

3728:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
3728#    lw $s2,($sp)
3732#    addu $sp,$sp,4

    # mark us as having already GC'd
3736#    move $t5,$s5

    # go try and allocate again
3740#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
3744:vm_init:

    # mark bottom of stack
3744#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
3748#    move $s2,$zero

    #set up the "five" register
3752#    li $s5,5

3756#    la $s3,seg0_start
3760#    la $s4,seg0_end
3761##...lui $s4,16
3765##...addiu $s4,$s4,4600
    
    # return
3768#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3772:divide:
    # get parameters; abort if divisor zero
3772#    lw $t0,($sp)
3776#    lw $t1,8($sp)
3780#    beq $t0,$zero,divByZeroError
    
    # perform division
3784#    div $t1,$t0
3788#    mflo $t0

    # store result, adjust stack and return
3792#    addu $sp,$sp,8 # adjust stack
3796#    sw $t0,($sp) # store result
3800#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3804:remainder:
    # get parameters; abort if divisor zero
3804#    lw $t0,($sp)
3808#    lw $t1,8($sp)
3812#    beq $t0,$zero,divByZeroError
    
    # perform division
3816#    div $t1,$t0
3820#    mfhi $t0

    # store result, adjust stack and return
3824#    addu $sp,$sp,8 # adjust stack
3828#    sw $t0,($sp) # store result
3832#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
3836:checkCast:
    # get object, allow immediately if null
3836#    lw $t2,($sp)
3840#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
3844#    lw $t2,-12($t2) # vtable address
3848#    bge $t2,$t1,castException
3849##...slt $at,$t2,$t1
3853##...beq $at,$zero,4024
3856#    blt $t2,$t0,castException
3857##...slt $at,$t2,$t0
3861##...bne $at,$zero,4024
    
    # return, leaving object unchanged on stack
3864:  checkCastReturn:    
3864#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
3868:instanceOf:
    # get object, go return false if null
3868#    lw $t2,($sp)
3872#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
3876#    lw $t2,-12($t2) # vtable address
3880#    sge $t0,$t2,$t0 # are we >= the lower limit?
3881##...slt $t0,$t2,$t0
3885##...xori $t0,$t0,0x1
3888#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
3892#    and $t2,$t0,$t1
3896#    sw $t2,($sp)
3900:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
3900#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

3904:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
3904#    li $v0,4 # syscall-code for print-string
3908#    syscall
3912:exit:
    # print termination message
3912#    li $v0,4 # syscall-code for print-string
3916#    la $a0,exitString
3920#    syscall

    # print number of garbage collections
3924#    li $v0,4 # syscall-code for print-string
3928#    la $a0,gcCountMsg
3932#    syscall # print "Number of ..."
3936#    lw $a0,gcCount # number of GC's
3940#    li $v0,1 # code for print-int
3944#    syscall
3948#    li $v0,4 # syscall-code for print-string
3952#    la $a0,newlineString
3956#    syscall # print newline

    # terminate execution
3960#    li $v0,10 #syscall-code for "exit"
3964#    syscall

3968:outOfHeapMemory:
3968#    la $a0,heapMemoryMsg
3972#    j exitError
3976:divByZeroError:
3976#    la $a0,divByZeroMsg
3980#    j exitError
3984:strIndexOutOfBounds:
3984#    la $a0,strIndexOutOfBoundsMsg
3988#    j exitError
3992:arrayIndexOutOfBounds:
3992#    la $a0,arrayIndexOutOfBoundsMsg
3996#    j exitError
4000:arraySizeOutOfBounds:
4000#    la $a0,arraySizeOutOfBoundsMsg
4004#    j exitError
4008:nullPtrException:
4008#    la $a0,nullPtrExceptionMsg
4012#    j exitError
4016:badIntegerFormat:
4016#    la $a0,badIntegerFormatMsg
4020#    j exitError
4024:castException:
4024#    la $a0,castExceptionMsg
4028#    j exitError
############## data section ################
    .data
4228:hexChars:
    .ascii "0123456789abcdef"
    .align 2
4244:cur_seg:
    .word 0

4248:lastCharRead:
    .word -2 # -2 => no buffered character
4252:prevHashConstant:
    .word 0x2785173c
4256:gcCount:
    .word 0

4260:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
4287:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
4310:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
4345:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
4379:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
4412:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
4443:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
4491:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
4512:gcMsg: 
      .asciiz "\nGC!\n"
4518:gcCountMsg: 
      .asciiz "Number of garbage collections: "

4550:nullStr:
    .asciiz "null"
4555:trueString:
    .asciiz "true"
4560:falseString:
    .asciiz "false"
4566:exitString:
    .ascii "Program execution completed."
    #### "falls through" here
4594:newlineString:
    .asciiz "\n"
    
    .align 2
4596:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

4600:seg0_start:
    .space 0x100000
1053176:seg0_end:
1053176:seg1_start:
    .space 0x100000
2101752:seg1_end:
