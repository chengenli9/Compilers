1117##...slt $at,$zero,$t0
1121##...bne $at,$zero,1164
1124#    beq $t0,$zero,riSkipWhiteLoop # start over if space
1128#    subu $t0,$v0,10
1132#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
1136#    subu $t0,$v0,9
1140#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
1144#    subu $t0,$v0,13
1148#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
1152#    subu $t0,$v0,12
1156#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
1160#    j badIntegerFormat # illegal integer char: abort program

1164:  nonWhite:
1164#    subu $t0,$v0,'-'
1168#    li $t4,1 # final multiplier
1172#    bne $t0,$zero,helpReadInt # go read
1176#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
1180#    jal readLogicalChar

1184:  helpReadInt:
1184#    li $t2,10
1188#    subu $t1,$v0,'0' # convert digit to 0-9 value
1192#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
1193##...sltu $at,$t1,$t2
1197##...beq $at,$zero,3444
1200#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

1204:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

1204#    jal readLogicalChar # read next character
1208#    subu $t1,$v0,'0' # convert digit to 0-9 value
1212#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
1213##...sltu $at,$t1,$t2
1217##...beq $at,$zero,1236

1220#    mul $t3,$t3,$t2 # multiply old value by 10
1221##...mult $t3,$t2
1225##...mflo $t3
1228#    addu $t3,$t3,$t1 # add in value of new digit
1232#    j digitLoop

1236:  doneDigitLoop:

    # "push back" unused character into queue
1236#    sw $v0,lastCharRead

    # restore return address
1240#    lw $ra,($sp)
1244#    addu $sp, 4

