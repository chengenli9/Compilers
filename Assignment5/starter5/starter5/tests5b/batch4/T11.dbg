    # buffer and return
3040#    sw $t0,lastCharRead # store -2 into buffer (i.e. "empty")
3044#    jr $ra # return
    
3048:  doReadCh:
    # we need to actually read a character: read and return
3048#    li $v0,12 # use system call to read a character
3052#    syscall
3056#    jr $ra # return
