6777##...lui $at,0
6781##...ori $at,$at,0xff
6785##...and $t2,$t2,$at
    #### OLD
    #### subu $t2,$zero,$t2 # set to 1 if -1 (number of data words)

6788:  gcSkip2:
6788#    sll $t2,$t2,2
6792#    addu $t2,$t2,8
