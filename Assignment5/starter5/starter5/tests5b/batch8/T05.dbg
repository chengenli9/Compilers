##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
17752:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
17752#    lw $t0,-8($s2) # get word with hash bits from this
17756#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
17760#    addu $t0,$t1

17764#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
17768:mth_equals_Object:
17768#    move $t0,$s2 # first pointer (this)
17772#    lw $t1,($sp) # second pointer
17776#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
17777##...subu $at,$t0,$t1
17781##...sltiu $t0,$at,1

17784#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
17788:mth_hashCode_String:
17788#    move $t0,$s2 # put this pointer in t0

17792#    li $t2,0 # current hash value
17796#    lw $t1,-4($t0) # negative of number of characters in string
17800#    beq $t1,$zero,done_hashCode_String # if zero length => done
17804#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
17808#    and $t0,0xfffffffc # adjust for padding
17809##...lui $at,65535
17813##...ori $at,$at,0xfffc
17817##...and $t0,$t0,$at
17820#    subu $t1,$t0,$t1 # address at end of string +12
17824:loop_hashCode_String:    
17824#    sll $t4,$t2,5 # multiply by 32
17828#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
17832#    lbu $t3,-12($t0) # current character
17836#    addu $t2,$t3 # add in current character
17840#    addu $t0,1 # go to next character's address
17844#    bne $t0,$t1,loop_hashCode_String # loop back if more
17848:done_hashCode_String:    

    # push int on stack
17848#    move $t0, $t2 # put $t2 in return slot
17852#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
17856:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
17856#    subu $sp,4
17860#    sw $ra,($sp)
    
    # get hash value
17864#    lw $t2,-12($s2) # vtable address
17868#    lw $t0,($t2) # method address
17872#    jalr $t0
17876#    subu $sp,8 # push result (int in $t0) on stack
17880#    sw $s5,4($sp)
17884#    sw $t0,($sp)

    # compute print-size of hash value
17888#    li $t0, 1
17892#    lw $t1, ($sp)
17896#    srl $t1,$t1,4
17900#    beq $t1,$zero,toString_skip_loop
17904:toString_loop_top:
17904#    addu $t0,1
17908#    srl $t1,$t1,4
17912#    bne $t1,$zero,toString_loop_top
17916:toString_skip_loop:
17916#    subu $sp,8
17920#    sw $s5,4($sp)
17924#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
17928#    lw $t2,-12($s2) # vtable address
17932#    move $t0,$t2
17936:toString_checkTagBit:
