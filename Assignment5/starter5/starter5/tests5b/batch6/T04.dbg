3440#    move $s7,$zero
3444#    jal newObject

    # get n from string.
3448#    lw $t1,8($sp)

    # store "String" tag into class field
3452#    la $t0,CLASS_String
3456#    sw $t0,-12($s7)
        
    # mask off hash bits, if needed
3460#    lw $t4,-8($s7) # # data words in source string
