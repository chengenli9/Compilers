###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
2816:mth_readLine_Lib:
    
2816#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
2820#    sw $ra, 4($sp) # save $ra
2824#    move $t1,$sp # save "original" sp

2828:  doRead:

    # read the character
2828#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
2832#    subu $t2,$v0,13
2836#    bne $t2,$zero,notReturnRL
2840#    jal readLogicalChar
2844#    subu $t2,$v0,10 # check for newline
2848#    beq $t2,$zero,foundNewLine
2852#    sw $v0,lastCharRead # push back character into queue
2856#    j foundNewLine # go process the line

2860:  notReturnRL:

    # at this point, $v0 has our character

2860#    subu $t0,$v0,10
2864#    beq $t0,$zero,foundNewLine
2868#    blt $v0,$zero,foundEof
2869##...slt $at,$v0,$zero
2873##...bne $at,$zero,2888

    # we have a character, so push it onto stack
2876#    subu $sp,$sp,4
2880#    sw $v0,($sp)

    # loop back up to get next character
2884#    j doRead

2888:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
2888#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
2892#    li $s7, 0 # return-value: null
2896#    j rlReturn # return

2900:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
2900#    subu $t0,$t1,$sp # number of chars we read (times 4)
2904#    srl $s6,$t0,2 # number of words on stack with chars
2908#    subu $sp,$sp,4 # push char-count ...
2912#    sw $s6,($sp) # ... onto stack
2916#    addu $t2,$t0,5 # GC tag, incl. for count-word
2920#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
2924#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
2928#    srl $s6,$s6,2  # data words in object
2932#    move $s7,$zero # object words in object
2936#    jal newObject  # allocate space
    
    # store header words
2940#    la $t0,CLASS_String
2944#    sw $t0,-12($s7)# store class tag (String) into object
2948#    lw $t2,4($sp) # char-count
2952#    sll $t1,$t2,2 # 4 times number of chars
2956#    subu $t2,$zero,$t2 # negative of char-count
2960#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
2964#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
2968#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
2969##...slt $at,$t0,$zero
2973##...beq $at,$zero,2992
2976#    and $t0,0xff # mask off object's hash value ...
2977##...lui $at,0
2981##...ori $at,$at,0xff
2985##...and $t0,$t0,$at
2988#    sw $t0,-8($s7) # ... and store back into -8 header-word
2992:  skipMask_readLine:

2992#    sll $t0,$t0,2 # data bytes in object
2996#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
3000#    subu $t0,$t0,$t2 # place to store last character (plus 9)
3004#    addu $sp,$sp,8 # pop redundant object-pointer and count
3008#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

3012#    beq $sp,$t1,rlReturn
3016:  charCopyLoop:
3016#    lw $t2,($sp)
3020#    sb $t2,-9($t0)
3024#    addu $sp,$sp,4
3028#    subu $t0,$t0,1
3032#    bne $sp,$t1,charCopyLoop
3036:  rlReturn:

3036#    lw $ra, 4($sp)
3040#    addu $sp, 8   # pop $ra and pointless word off stack
3044#    move $t0, $s7 # return string we allocated in $s7
3048#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
3052:mth_readInt_Lib:

    # save $ra by pushing onto stack
3052#    subu $sp,$sp,4
3056#    sw $ra,($sp)

3060:  riSkipWhiteLoop:
    # read a character
3060#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
3064#    subu $t0,$v0,32
3068#    bgt $t0,$zero,nonWhite
3069##...slt $at,$zero,$t0
3073##...bne $at,$zero,3116
3076#    beq $t0,$zero,riSkipWhiteLoop # start over if space
3080#    subu $t0,$v0,10
3084#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
3088#    subu $t0,$v0,9
3092#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
3096#    subu $t0,$v0,13
3100#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
3104#    subu $t0,$v0,12
3108#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
3112#    j badIntegerFormat # illegal integer char: abort program

3116:  nonWhite:
3116#    subu $t0,$v0,'-'
3120#    li $t4,1 # final multiplier
3124#    bne $t0,$zero,helpReadInt # go read
3128#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
3132#    jal readLogicalChar

3136:  helpReadInt:
3136#    li $t2,10
3140#    subu $t1,$v0,'0' # convert digit to 0-9 value
3144#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
3145##...sltu $at,$t1,$t2
3149##...beq $at,$zero,5396
3152#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

3156:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

3156#    jal readLogicalChar # read next character
3160#    subu $t1,$v0,'0' # convert digit to 0-9 value
3164#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
3165##...sltu $at,$t1,$t2
3169##...beq $at,$zero,3188

3172#    mul $t3,$t3,$t2 # multiply old value by 10
3173##...mult $t3,$t2
3177##...mflo $t3
3180#    addu $t3,$t3,$t1 # add in value of new digit
3184#    j digitLoop

3188:  doneDigitLoop:

    # "push back" unused character into queue
3188#    sw $v0,lastCharRead

    # restore return address
3192#    lw $ra,($sp)
3196#    addu $sp, 4

