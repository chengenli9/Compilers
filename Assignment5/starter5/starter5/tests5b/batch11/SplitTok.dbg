##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
5560:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
5560#    lw $t0,-8($s2) # get word with hash bits from this
5564#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
5568#    addu $t0,$t1

5572#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
5576:mth_equals_Object:
5576#    move $t0,$s2 # first pointer (this)
5580#    lw $t1,($sp) # second pointer
5584#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
5585##...subu $at,$t0,$t1
5589##...sltiu $t0,$at,1

5592#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
5596:mth_hashCode_String:
5596#    move $t0,$s2 # put this pointer in t0

5600#    li $t2,0 # current hash value
5604#    lw $t1,-4($t0) # negative of number of characters in string
5608#    beq $t1,$zero,done_hashCode_String # if zero length => done
5612#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
5616#    and $t0,0xfffffffc # adjust for padding
5617##...lui $at,65535
5621##...ori $at,$at,0xfffc
5625##...and $t0,$t0,$at
5628#    subu $t1,$t0,$t1 # address at end of string +12
5632:loop_hashCode_String:    
5632#    sll $t4,$t2,5 # multiply by 32
5636#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
5640#    lbu $t3,-12($t0) # current character
5644#    addu $t2,$t3 # add in current character
5648#    addu $t0,1 # go to next character's address
5652#    bne $t0,$t1,loop_hashCode_String # loop back if more
5656:done_hashCode_String:    

    # push int on stack
5656#    move $t0, $t2 # put $t2 in return slot
5660#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
5664:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
5664#    subu $sp,4
5668#    sw $ra,($sp)
    
    # get hash value
5672#    lw $t2,-12($s2) # vtable address
5676#    lw $t0,($t2) # method address
5680#    jalr $t0
5684#    subu $sp,8 # push result (int in $t0) on stack
5688#    sw $s5,4($sp)
5692#    sw $t0,($sp)

    # compute print-size of hash value
5696#    li $t0, 1
5700#    lw $t1, ($sp)
5704#    srl $t1,$t1,4
5708#    beq $t1,$zero,toString_skip_loop
5712:toString_loop_top:
5712#    addu $t0,1
5716#    srl $t1,$t1,4
5720#    bne $t1,$zero,toString_loop_top
5724:toString_skip_loop:
5724#    subu $sp,8
5728#    sw $s5,4($sp)
5732#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
5736#    lw $t2,-12($s2) # vtable address
5740#    move $t0,$t2
5744:toString_checkTagBit:
5744#    subu $t0,1
5748#    lb $t1,($t0)
5752#    and $t1,0x80
5753##...lui $at,0
5757##...ori $at,$at,0x80
5761##...and $t1,$t1,$at
5764#    beq $t1,$zero,toString_checkTagBit
5768#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
5772#    subu $sp,8
5776#    sw $t1,($sp)
5780#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
5784#    move $s7,$zero # -4 offset header word
5788#    lw $t4,8($sp) # bytes for hash value
5792#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
5796#    addu $t4,8
5800#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
5804#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

5808#    li $t0,CLASS_String # store string vtable address into ...
5812#    sw $t0,-12($s7) # ... -12 offset in object header
5816#    lw $t2,-12($s2) # our object's vtable address
5820#    lw $t5,4($sp) # number characters in prefix
5824#    lw $t1,12($sp) # number of characters in hashcode
5828#    addu $t3,$t1,$t5 # number of characters in string ...
5832#    addu $t3,1 # ... including the '@' character
5836#    subu $t0,$zero,$t3 # store negated length into ...
5840#    sw $t0,-4($s7) # ... -4 offset header word
5844#    lw $t0,-8($s7) # get -8 offset header-word
5848#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
5849##...slt $at,$t0,$zero
5853##...beq $at,$zero,5872
5856#    and $t0,0xff # mask off object's hash value ...
5857##...lui $at,0
5861##...ori $at,$at,0xff
5865##...and $t0,$t0,$at
5868#    sw $t0,-8($s7) # ... and store back into -8 header-word
5872:skipMask_toString:
5872#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
5876#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
5880#    subu $t4,$t2,$t5
