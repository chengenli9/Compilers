##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
692:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
692#    lw $t0,-8($s2) # get word with hash bits from this
696#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
700#    addu $t0,$t1

704#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
708:mth_equals_Object:
708#    move $t0,$s2 # first pointer (this)
712#    lw $t1,($sp) # second pointer
716#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
717##...subu $at,$t0,$t1
721##...sltiu $t0,$at,1

724#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
728:mth_hashCode_String:
728#    move $t0,$s2 # put this pointer in t0

732#    li $t2,0 # current hash value
736#    lw $t1,-4($t0) # negative of number of characters in string
740#    beq $t1,$zero,done_hashCode_String # if zero length => done
744#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
748#    and $t0,0xfffffffc # adjust for padding
749##...lui $at,65535
753##...ori $at,$at,0xfffc
757##...and $t0,$t0,$at
760#    subu $t1,$t0,$t1 # address at end of string +12
764:loop_hashCode_String:    
764#    sll $t4,$t2,5 # multiply by 32
768#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
772#    lbu $t3,-12($t0) # current character
776#    addu $t2,$t3 # add in current character
780#    addu $t0,1 # go to next character's address
784#    bne $t0,$t1,loop_hashCode_String # loop back if more
788:done_hashCode_String:    

    # push int on stack
788#    move $t0, $t2 # put $t2 in return slot
792#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
796:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
796#    subu $sp,4
800#    sw $ra,($sp)
    
    # get hash value
804#    lw $t2,-12($s2) # vtable address
808#    lw $t0,($t2) # method address
812#    jalr $t0
816#    subu $sp,8 # push result (int in $t0) on stack
820#    sw $s5,4($sp)
824#    sw $t0,($sp)

    # compute print-size of hash value
828#    li $t0, 1
832#    lw $t1, ($sp)
836#    srl $t1,$t1,4
840#    beq $t1,$zero,toString_skip_loop
844:toString_loop_top:
844#    addu $t0,1
848#    srl $t1,$t1,4
852#    bne $t1,$zero,toString_loop_top
856:toString_skip_loop:
856#    subu $sp,8
860#    sw $s5,4($sp)
864#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
868#    lw $t2,-12($s2) # vtable address
872#    move $t0,$t2
876:toString_checkTagBit:
876#    subu $t0,1
880#    lb $t1,($t0)
884#    and $t1,0x80
885##...lui $at,0
889##...ori $at,$at,0x80
893##...and $t1,$t1,$at
896#    beq $t1,$zero,toString_checkTagBit
900#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
904#    subu $sp,8
908#    sw $t1,($sp)
912#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
916#    move $s7,$zero # -4 offset header word
920#    lw $t4,8($sp) # bytes for hash value
924#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
928#    addu $t4,8
932#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
936#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

940#    li $t0,CLASS_String # store string vtable address into ...
944#    sw $t0,-12($s7) # ... -12 offset in object header
948#    lw $t2,-12($s2) # our object's vtable address
952#    lw $t5,4($sp) # number characters in prefix
956#    lw $t1,12($sp) # number of characters in hashcode
960#    addu $t3,$t1,$t5 # number of characters in string ...
964#    addu $t3,1 # ... including the '@' character
968#    subu $t0,$zero,$t3 # store negated length into ...
972#    sw $t0,-4($s7) # ... -4 offset header word
976#    lw $t0,-8($s7) # get -8 offset header-word
980#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
981##...slt $at,$t0,$zero
985##...beq $at,$zero,1004
988#    and $t0,0xff # mask off object's hash value ...
989##...lui $at,0
993##...ori $at,$at,0xff
997##...and $t0,$t0,$at
1000#    sw $t0,-8($s7) # ... and store back into -8 header-word
1004:skipMask_toString:
1004#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
1008#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
1012#    subu $t4,$t2,$t5
1016:toString_copyLoop:    
1016#    lb $t3,($t4)
1020#    and $t3,0x7f # mask off sign bit (in case first word)
1021##...lui $at,0
1025##...ori $at,$at,0x7f
1029##...and $t3,$t3,$at
1032#    sb $t3,-8($t0)
1036#    addu $t4,1
1040#    addu $t0,1
