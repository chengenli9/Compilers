    #   to the length of the shortest word

    # get begin-of-string addresses
2800#    lw $t2,-8($t0) # # data words in second string
2804#    lw $t3,-8($t1) # # data words in first string
2808#    sll $t2,$t2,2 # byte-offset to beginning of str2 (+8)
2812#    sll $t3,$t3,2 # byte-offset to beginning of str1 (+8)
2816#    subu $t0,$t0,$t2 # beginning of str1 address (+8)
2820#    subu $t1,$t1,$t3 # beginning of str2 address (+8)
