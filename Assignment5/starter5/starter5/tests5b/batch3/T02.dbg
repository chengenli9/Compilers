########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
10148:vm_init:

    # mark bottom of stack
10148#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
10152#    move $s2,$zero

    #set up the "five" register
10156#    li $s5,5

10160#    la $s3,seg0_start
10164#    la $s4,seg0_end
10165##...lui $s4,16
10169##...addiu $s4,$s4,11372
    
    # return
10172#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
10176:divide:
    # get parameters; abort if divisor zero
10176#    lw $t0,($sp)
10180#    lw $t1,8($sp)
10184#    beq $t0,$zero,divByZeroError
    
    # perform division
10188#    div $t1,$t0
10192#    mflo $t0

    # store result, adjust stack and return
10196#    addu $sp,$sp,8 # adjust stack
10200#    sw $t0,($sp) # store result
10204#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
10208:remainder:
    # get parameters; abort if divisor zero
10208#    lw $t0,($sp)
10212#    lw $t1,8($sp)
10216#    beq $t0,$zero,divByZeroError
    
    # perform division
10220#    div $t1,$t0
10224#    mfhi $t0

    # store result, adjust stack and return
10228#    addu $sp,$sp,8 # adjust stack
10232#    sw $t0,($sp) # store result
10236#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
10240:checkCast:
    # get object, allow immediately if null
10240#    lw $t2,($sp)
10244#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
10248#    lw $t2,-12($t2) # vtable address
10252#    bge $t2,$t1,castException
10253##...slt $at,$t2,$t1
10257##...beq $at,$zero,10428
10260#    blt $t2,$t0,castException
10261##...slt $at,$t2,$t0
10265##...bne $at,$zero,10428
    
    # return, leaving object unchanged on stack
10268:  checkCastReturn:    
10268#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
10272:instanceOf:
    # get object, go return false if null
10272#    lw $t2,($sp)
10276#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
10280#    lw $t2,-12($t2) # vtable address
10284#    sge $t0,$t2,$t0 # are we >= the lower limit?
10285##...slt $t0,$t2,$t0
10289##...xori $t0,$t0,0x1
10292#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
10296#    and $t2,$t0,$t1
10300#    sw $t2,($sp)
10304:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
10304#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

10308:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
10308#    li $v0,4 # syscall-code for print-string
10312#    syscall
10316:exit:
    # print termination message
10316#    li $v0,4 # syscall-code for print-string
10320#    la $a0,exitString
10324#    syscall

    # print number of garbage collections
10328#    li $v0,4 # syscall-code for print-string
10332#    la $a0,gcCountMsg
10336#    syscall # print "Number of ..."
10340#    lw $a0,gcCount # number of GC's
10344#    li $v0,1 # code for print-int
10348#    syscall
10352#    li $v0,4 # syscall-code for print-string
10356#    la $a0,newlineString
10360#    syscall # print newline

    # terminate execution
10364#    li $v0,10 #syscall-code for "exit"
10368#    syscall

10372:outOfHeapMemory:
10372#    la $a0,heapMemoryMsg
10376#    j exitError
10380:divByZeroError:
10380#    la $a0,divByZeroMsg
10384#    j exitError
10388:strIndexOutOfBounds:
10388#    la $a0,strIndexOutOfBoundsMsg
10392#    j exitError
10396:arrayIndexOutOfBounds:
10396#    la $a0,arrayIndexOutOfBoundsMsg
10400#    j exitError
10404:arraySizeOutOfBounds:
10404#    la $a0,arraySizeOutOfBoundsMsg
10408#    j exitError
10412:nullPtrException:
10412#    la $a0,nullPtrExceptionMsg
10416#    j exitError
10420:badIntegerFormat:
10420#    la $a0,badIntegerFormatMsg
10424#    j exitError
10428:castException:
10428#    la $a0,castExceptionMsg
10432#    j exitError
############## data section ################
    .data
11000:hexChars:
    .ascii "0123456789abcdef"
    .align 2
11016:cur_seg:
    .word 0

11020:lastCharRead:
    .word -2 # -2 => no buffered character
11024:prevHashConstant:
    .word 0x2785173c
11028:gcCount:
    .word 0

11032:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
11059:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
11082:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
11117:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
11151:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
11184:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
11215:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
11263:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
11284:gcMsg: 
      .asciiz "\nGC!\n"
11290:gcCountMsg: 
      .asciiz "Number of garbage collections: "

11322:nullStr:
    .asciiz "null"
11327:trueString:
    .asciiz "true"
11332:falseString:
    .asciiz "false"
11338:exitString:
    .ascii "Program execution completed."
    #### "falls through" here
11366:newlineString:
    .asciiz "\n"
    
    .align 2
11368:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

11372:seg0_start:
    .space 0x100000
1059948:seg0_end:
1059948:seg1_start:
    .space 0x100000
2108524:seg1_end:
