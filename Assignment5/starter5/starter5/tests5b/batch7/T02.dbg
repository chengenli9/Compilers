##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
7908:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
7908#    lw $t0,-8($s2) # get word with hash bits from this
7912#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
7916#    addu $t0,$t1

7920#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
7924:mth_equals_Object:
7924#    move $t0,$s2 # first pointer (this)
7928#    lw $t1,($sp) # second pointer
7932#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
7933##...subu $at,$t0,$t1
7937##...sltiu $t0,$at,1

7940#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
7944:mth_hashCode_String:
7944#    move $t0,$s2 # put this pointer in t0

7948#    li $t2,0 # current hash value
7952#    lw $t1,-4($t0) # negative of number of characters in string
7956#    beq $t1,$zero,done_hashCode_String # if zero length => done
7960#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
7964#    and $t0,0xfffffffc # adjust for padding
7965##...lui $at,65535
7969##...ori $at,$at,0xfffc
7973##...and $t0,$t0,$at
7976#    subu $t1,$t0,$t1 # address at end of string +12
7980:loop_hashCode_String:    
7980#    sll $t4,$t2,5 # multiply by 32
7984#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
7988#    lbu $t3,-12($t0) # current character
7992#    addu $t2,$t3 # add in current character
7996#    addu $t0,1 # go to next character's address
8000#    bne $t0,$t1,loop_hashCode_String # loop back if more
8004:done_hashCode_String:    

    # push int on stack
8004#    move $t0, $t2 # put $t2 in return slot
8008#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
8012:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
8012#    subu $sp,4
8016#    sw $ra,($sp)
    
    # get hash value
8020#    lw $t2,-12($s2) # vtable address
8024#    lw $t0,($t2) # method address
8028#    jalr $t0
8032#    subu $sp,8 # push result (int in $t0) on stack
8036#    sw $s5,4($sp)
8040#    sw $t0,($sp)

    # compute print-size of hash value
8044#    li $t0, 1
8048#    lw $t1, ($sp)
8052#    srl $t1,$t1,4
8056#    beq $t1,$zero,toString_skip_loop
8060:toString_loop_top:
8060#    addu $t0,1
8064#    srl $t1,$t1,4
8068#    bne $t1,$zero,toString_loop_top
8072:toString_skip_loop:
8072#    subu $sp,8
8076#    sw $s5,4($sp)
8080#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
8084#    lw $t2,-12($s2) # vtable address
8088#    move $t0,$t2
8092:toString_checkTagBit:
8092#    subu $t0,1
8096#    lb $t1,($t0)
8100#    and $t1,0x80
8101##...lui $at,0
8105##...ori $at,$at,0x80
8109##...and $t1,$t1,$at
8112#    beq $t1,$zero,toString_checkTagBit
8116#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
8120#    subu $sp,8
8124#    sw $t1,($sp)
8128#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
8132#    move $s7,$zero # -4 offset header word
8136#    lw $t4,8($sp) # bytes for hash value
8140#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
8144#    addu $t4,8
8148#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
8152#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

8156#    li $t0,CLASS_String # store string vtable address into ...
8160#    sw $t0,-12($s7) # ... -12 offset in object header
8164#    lw $t2,-12($s2) # our object's vtable address
8168#    lw $t5,4($sp) # number characters in prefix
8172#    lw $t1,12($sp) # number of characters in hashcode
8176#    addu $t3,$t1,$t5 # number of characters in string ...
8180#    addu $t3,1 # ... including the '@' character
8184#    subu $t0,$zero,$t3 # store negated length into ...
8188#    sw $t0,-4($s7) # ... -4 offset header word
8192#    lw $t0,-8($s7) # get -8 offset header-word
8196#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
8197##...slt $at,$t0,$zero
8201##...beq $at,$zero,8220
8204#    and $t0,0xff # mask off object's hash value ...
8205##...lui $at,0
8209##...ori $at,$at,0xff
8213##...and $t0,$t0,$at
8216#    sw $t0,-8($s7) # ... and store back into -8 header-word
8220:skipMask_toString:
8220#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
8224#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
8228#    subu $t4,$t2,$t5
8232:toString_copyLoop:    
8232#    lb $t3,($t4)
8236#    and $t3,0x7f # mask off sign bit (in case first word)
8237##...lui $at,0
8241##...ori $at,$at,0x7f
8245##...and $t3,$t3,$at
8248#    sb $t3,-8($t0)
8252#    addu $t4,1
8256#    addu $t0,1
8260#    blt $t4,$t2,toString_copyLoop
8261##...slt $at,$t4,$t2
8265##...bne $at,$zero,8232

    # copy the '@' sign
8268#    li $t3,'@'
8272#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
8276#    addu $t2,$t0,$t1 # address of last byte in string to store +8
8280#    lw $t3,20($sp) # hash code to print
8284:toString_hashCopyLoop:
8284#    and $t4,$t3,0xf
8288#    srl $t3,4
8292#    lb $t4,hexChars($t4)
8296#    sb $t4,-8($t2)
8300#    subu $t2,$t2,1
8304#    bgt $t2,$t0,toString_hashCopyLoop
8305##...slt $at,$t0,$t2
8309##...bne $at,$zero,8284

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
8312#    addu $sp,28
8316#    lw $ra,($sp)
8320#    addu $sp,4
8324#    move $t0, $s7 # return string we created
8328#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
8332:mth_equals_String:
    
    # quick test for obvious false
8332#    lw $t0,($sp) # second parameter
8336#    beq $t0,$zero,goEsFalse # go return false if null
8340#    lw $t1,-12($t0) # vtable pointer
8344#    la $t2,CLASS_String # string vtable pointer
8348#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
8352#    subu $sp,12
8356#    sw $ra,8($sp)
8360#    sw $s2,4($sp)
8364#    sw $t0,($sp)
8368#    jal mth_compareTo_String
8372#    lw $s2, 4($sp) #restore this pointer and pop parameters
8376#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
8380#    seq $t0,$t0,$zero
8381##...subu $at,$t0,$zero
8385##...sltiu $t0,$at,1

    # pop return address and return $t0
8388#    lw $ra,($sp)
8392#    addu $sp,4

8396#    jr $ra # return
    
8400:goEsFalse:
    # put 0 in $t0 and return
8400#    li $t0, 0
8404#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
8408:mth_toString_String:
    #we are a string, so return this.
8408#    move $t0, $s2
8412#    jr $ra

###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
8416:mth_readLine_Lib:
    
8416#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
8420#    sw $ra, 4($sp) # save $ra
8424#    move $t1,$sp # save "original" sp

8428:  doRead:

    # read the character
8428#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
8432#    subu $t2,$v0,13
8436#    bne $t2,$zero,notReturnRL
8440#    jal readLogicalChar
8444#    subu $t2,$v0,10 # check for newline
8448#    beq $t2,$zero,foundNewLine
8452#    sw $v0,lastCharRead # push back character into queue
8456#    j foundNewLine # go process the line

8460:  notReturnRL:

    # at this point, $v0 has our character

8460#    subu $t0,$v0,10
8464#    beq $t0,$zero,foundNewLine
8468#    blt $v0,$zero,foundEof
8469##...slt $at,$v0,$zero
8473##...bne $at,$zero,8488

    # we have a character, so push it onto stack
8476#    subu $sp,$sp,4
8480#    sw $v0,($sp)

    # loop back up to get next character
8484#    j doRead

8488:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
8488#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
8492#    li $s7, 0 # return-value: null
8496#    j rlReturn # return

8500:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
8500#    subu $t0,$t1,$sp # number of chars we read (times 4)
8504#    srl $s6,$t0,2 # number of words on stack with chars
8508#    subu $sp,$sp,4 # push char-count ...
8512#    sw $s6,($sp) # ... onto stack
8516#    addu $t2,$t0,5 # GC tag, incl. for count-word
8520#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
8524#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
8528#    srl $s6,$s6,2  # data words in object
8532#    move $s7,$zero # object words in object
8536#    jal newObject  # allocate space
    
    # store header words
8540#    la $t0,CLASS_String
8544#    sw $t0,-12($s7)# store class tag (String) into object
8548#    lw $t2,4($sp) # char-count
8552#    sll $t1,$t2,2 # 4 times number of chars
8556#    subu $t2,$zero,$t2 # negative of char-count
8560#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
8564#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
8568#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
8569##...slt $at,$t0,$zero
8573##...beq $at,$zero,8592
8576#    and $t0,0xff # mask off object's hash value ...
8577##...lui $at,0
8581##...ori $at,$at,0xff
8585##...and $t0,$t0,$at
8588#    sw $t0,-8($s7) # ... and store back into -8 header-word
8592:  skipMask_readLine:

8592#    sll $t0,$t0,2 # data bytes in object
8596#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
8600#    subu $t0,$t0,$t2 # place to store last character (plus 9)
8604#    addu $sp,$sp,8 # pop redundant object-pointer and count
8608#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

8612#    beq $sp,$t1,rlReturn
8616:  charCopyLoop:
8616#    lw $t2,($sp)
8620#    sb $t2,-9($t0)
8624#    addu $sp,$sp,4
8628#    subu $t0,$t0,1
8632#    bne $sp,$t1,charCopyLoop
8636:  rlReturn:

8636#    lw $ra, 4($sp)
8640#    addu $sp, 8   # pop $ra and pointless word off stack
8644#    move $t0, $s7 # return string we allocated in $s7
8648#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
8652:mth_readInt_Lib:

    # save $ra by pushing onto stack
8652#    subu $sp,$sp,4
8656#    sw $ra,($sp)

8660:  riSkipWhiteLoop:
    # read a character
8660#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
8664#    subu $t0,$v0,32
8668#    bgt $t0,$zero,nonWhite
8669##...slt $at,$zero,$t0
8673##...bne $at,$zero,8716
8676#    beq $t0,$zero,riSkipWhiteLoop # start over if space
8680#    subu $t0,$v0,10
8684#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
8688#    subu $t0,$v0,9
8692#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
8696#    subu $t0,$v0,13
8700#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
8704#    subu $t0,$v0,12
8708#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
8712#    j badIntegerFormat # illegal integer char: abort program

8716:  nonWhite:
8716#    subu $t0,$v0,'-'
8720#    li $t4,1 # final multiplier
8724#    bne $t0,$zero,helpReadInt # go read
8728#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
8732#    jal readLogicalChar

8736:  helpReadInt:
8736#    li $t2,10
8740#    subu $t1,$v0,'0' # convert digit to 0-9 value
8744#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
8745##...sltu $at,$t1,$t2
8749##...beq $at,$zero,11032
8752#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

8756:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

8756#    jal readLogicalChar # read next character
8760#    subu $t1,$v0,'0' # convert digit to 0-9 value
8764#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
8765##...sltu $at,$t1,$t2
8769##...beq $at,$zero,8788

8772#    mul $t3,$t3,$t2 # multiply old value by 10
8773##...mult $t3,$t2
8777##...mflo $t3
8780#    addu $t3,$t3,$t1 # add in value of new digit
8784#    j digitLoop

8788:  doneDigitLoop:

    # "push back" unused character into queue
8788#    sw $v0,lastCharRead

    # restore return address
8792#    lw $ra,($sp)
8796#    addu $sp, 4

    # multiply by sign and put return value in $t0
8800#    mult $t3,$t4 # multiply to account for poss. minus sign
8804#    mflo $t3
8808#    move $t0, $t3
    
    # return
8812#    jr $ra

###################################################################
# readChar() - library method (class Lib)
# - reads a single character from standard input
# - returns the integer that is the encoding of the character
# - returns -1 if end of file was encountered
# - parameter:
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
