########################################################
# readLogicalChar (millicode)
#  - logically reads a character from standard input
#  - first checks character buffer, consuming it if possible
#  - return-result:
#    - returns character in $v0
#  - side-effects:
#    - reads a character
#    - clobbers $t0
########################################################
9380:readLogicalChar:

    # check if we already have a character
9380#    lw $v0,lastCharRead
9384#    li $t0,-2
9388#    beq $t0,$v0 doReadCh

    # we have our character from the buffer. Wipe out
    # buffer and return
9392#    sw $t0,lastCharRead # store -2 into buffer (i.e. "empty")
9396#    jr $ra # return
    
9400:  doReadCh:
    # we need to actually read a character: read and return
9400#    li $v0,12 # use system call to read a character
9404#    syscall
9408#    jr $ra # return
