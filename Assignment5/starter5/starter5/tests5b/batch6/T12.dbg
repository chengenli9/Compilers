3277##...bne $at,$zero,3260

    # at this point:
    #  $s3 has been updated to point to the next free slot,
    #    which is also the points just past our object

    # compute pointer value and set up header-words
3280#    sll $t0,$s7,2    # number of post-header bytes
3284#    subu $t0,$s3,$t0 # pointer that we will return

    # determine the value to store in the first header-word:
    # if <= 255 (unsigned):
    #  - it goes into low byte
    #  - hash bits go into high three bytes, with top bit being 1
    # if >255 (unsigned)
    #  - it goes into full word (with a 0 in the high bit)
    
3288#    li $t2,255
3292#    bgeu $s6,$t2 firstHeaderLarge
3293##...sltu $at,$s6,$t2
3297##...beq $at,$zero,3344
3300#    lw $t1,prevHashConstant
3304#    addu $t1,0x12b68fd2
3305##...lui $at,4791
3309##...addiu $at,$at,-28718
3313##...addu $t1,$at,$t1
3316#    sw $t1,prevHashConstant # update hash constant
3320#    or $t1,0x80000000 # set top bit
3321##...lui $at,32768
3325##...or $t1,$at,$t1
3328#    and $t1,0xffffff00 # clear low bit
3329##...lui $at,65535
3333##...ori $at,$at,0xff00
3337##...and $t1,$t1,$at
3340#    or $s6,$t1
3344:firstHeaderLarge:
3344#    sw $s6,-8($t0) # store header-1 value
3348#    lw $zero,-8($t0)

    # store second header-value
3352#    sw $s7,-4($t0)   # second header-word
3356#    lw $zero,-4($t0)
    
    # put return-value into $s7 and also push it onto top of stack
3360#    move $s7,$t0
3364#    subu $sp,$sp,4
3368#    sw $t0,($sp)

3372#    jr $ra
