17348:mth_readInt_Lib:

    # save $ra by pushing onto stack
17348#    subu $sp,$sp,4
17352#    sw $ra,($sp)

17356:  riSkipWhiteLoop:
    # read a character
17356#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
17360#    subu $t0,$v0,32
