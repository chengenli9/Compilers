    # save $ra by pushing onto stack
1252#    subu $sp,$sp,4
1256#    sw $ra,($sp)

      # read the character
1260#    jal readLogicalChar

    # restore return address; put value in $t0
    # replacing this-pointer saved return address
1264#    lw $ra,($sp)
1268#    addu $sp, 4
1272#    move $t0, $v0

    # return
1276#    jr $ra

########################################################
