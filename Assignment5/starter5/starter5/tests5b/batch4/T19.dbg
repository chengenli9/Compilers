    # get data count for object; swap header-word with first word
    # of object so that they're back in the right place
3828#    lw $t1,($t0) # (what will be) first header word for current object
3832#    move $t2,$t1 # number data bytes in object (poss. w/hash bits)
3836#    bge $t2,$zero,gcSkip4a # are there hash bits?
3837##...slt $at,$t2,$zero
3841##...beq $at,$zero,3856
3844#    and $t2,0xff # mask off hash bits
3845##...lui $at,0
3849##...ori $at,$at,0xff
3853##...and $t2,$t2,$at
3856:gcSkip4a:    
3856#    sll $t2,$t2,2 # # data bytes
3860#    addu $t2,$t2,8 # to skip header words
3864#    addu $t2,$t0,$t2 # pointer to new object
3868#    lw $t3,-8($t2) # word to swap
3872#    sw $t1,-8($t2) # store header word
3876#    sw $t3,($t0) # restore first word of object

    ################################################
    # at this point:
    # - $t2 contains the pointer to our new object
    ################################################

    # check if we have a data array
3880#    lw $t1,-12($t2) # vtable pointer
3884#    li $t0,dataArrayVTableStart # address of vtable for first data array
3888#    blt $t1,$t0,gcNotDataArray # if data array, no more xforming to do
3889##...slt $at,$t1,$t0
3893##...bne $at,$zero,3912

    # We have a vtable address that is a data array.
    # we need skip over it then loop back to do next object.
3896:  skipToNextObj:
3896#    lw $t1,-4($t2) # data words in (object position of) array
    #### note: we know that it's not a string, so the value will
    #### not be artificially negative
3900#    sll $t1,$t1,2 # convert to byte-count
3904#    addu $t0,$t2,$t1 # skip over object
3908#    j gcTestIterDone2 # go do next object, if any

    ###################################################
    # at this point:
    # - the object has been restored to normal status--that is, the
    #   word-swap has been done
    # - $t2 contains a pointer to the object
    ###################################################
    
3912:  gcNotDataArray:
3912#    lw $t3,-4($t2) # # object words (negative treated as zero)
3916#    bge $t3,$zero,gcH2Neg2
3917##...slt $at,$t3,$zero
3921##...beq $at,$zero,3928
3924#    move $t3,$zero
3928:  gcH2Neg2:
3928#    sll $t3,$t3,2 # # object bytes
3932#    move $t0,$t2 # address of first pointer in object
3936#    add $s1,$t2,$t3 # limit address for this object

    #####################################################
    # At this point, we have to "translate" all pointers,
    # starting at $t0 to (but not including) $s1
    #####################################################

    # if there are no pointer-slots (i.e., $t0=$s1), skip this
    # part
3940#    beq $t0,$s1,gcTestIterDone2
    
3944:  gcNextPointerInObject:
    # get pointer from object
3944#    lw $t1,($t0)

    # if value is out of range, and is therefore does not refer
    # to an object, just go loop back and do the next one
3948#    bleu $t1,$t6,gcGoNextPointerSlot
3949##...sltu $at,$t6,$t1
3953##...beq $at,$zero,4096
3956#    bgtu $t1,$t7,gcGoNextPointerSlot
3957##...sltu $at,$t7,$t1
3961##...bne $at,$zero,4096

    # if the object has already been moved, update the stack-value
    # via the forwarding pointer
3964#    lw $t8,-8($t1) # possible forwarding tag
3968#    bne $t8,$zero,gcNoForward2 # if not forwarding tag, go copy
3972#    lw $t8,-4($t1) # forwarding pointer: object's new address
3976#    sw $t8,($t0) # update pointer in object
3980#    j gcGoNextPointerSlot # do next iteration

3984:  gcNoForward2:
    #########################################################
    # we actually need to copy the object into the new space
    #########################################################

    #########################################################
    # At this point:
    # - $t0 contains the address of the heap-slot we're translating
    # - $t1 will contain the contents of the heap-slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space, which will also be the first address
    #   of the target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # Then during processing:
    # And when we're actually copying an object:
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $t8 will contain a pointer to the target object
    # - available for use: $s0, $t8, $t9
    ##########################################################

    # compute the amount of space that is needed
3984#    bge $t8,$zero,gcSkip5 # # words in negative-offset portion
3985##...slt $at,$t8,$zero
3989##...beq $at,$zero,4004
3992#    and $t8,0xff # mask off hash bits
3993##...lui $at,0
3997##...ori $at,$at,0xff
4001##...and $t8,$t8,$at

4004:  gcSkip5:
4004#    sll $t8,$t8,2 # bytes in negative-offset portion ...
4008#    addu $t8,$t8,8 # ... add in bytes for header-words
4012#    subu $t4,$t1,$t8 # address of first word of source object
4016#    lw $t3,-4($t1) # # words in positive-offset portion
4020#    bge $t3,$zero,gcNoNeg
4021##...slt $at,$t3,$zero
4025##...beq $at,$zero,4032
4028#    move $t3,$zero # negative treated as zero
4032:  gcNoNeg:
4032#    sll $t3,$t3,2 # bytes in negative-offset portion
4036#    addu $t3,$t3,$t1 # address one word past last word of source

4040#    addu $t8,$s3,$t8 # pointer to target object

    #########################################################
    # At this point:
    # - $t0 contains the address of the stack slot we'll
    #   process next
    # - $t1 contains the contents of the stack slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $t8 contains the pointer to the target object
    # - $s1 contains the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0, $t9
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger"
4044#    lw $s0,($t4)
4048#    lw $t9,-8($t1)
4052#    sw $t9,($t4)
4056#    sw $s0,-8($t1)

    # copy all source bytes to the target
4060:  gCinnerCopy2:
4060#    lw $s0,($t4)
4064#    sw $s0,($s3)
4068#    addu $t4,$t4,4
4072#    addu $s3,$s3,4
4076#    bltu $t4,$t3,gCinnerCopy2
4077##...sltu $at,$t4,$t3
4081##...bne $at,$zero,4060

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
4084#    sw $zero,-8($t1) # 0 in first header-slot
4088#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
4092#    sw $t8,($t0)

4096:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
4096#    addu $t0,$t0,4
4100#    bltu $t0,$s1,gcNextPointerInObject
4101##...sltu $at,$t0,$s1
4105##...bne $at,$zero,3944

4108:  gcTestIterDone2:
4108#    bltu $t0,$s3,gcHeapCopyLoop
4109##...sltu $at,$t0,$s3
4113##...bne $at,$zero,3828

    ###### end outer loop to copy all non-stack-direct objects ######

4116:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
4116#    lw $s2,($sp)
4120#    addu $sp,$sp,4

    # mark us as having already GC'd
4124#    move $t5,$s5

    # go try and allocate again
4128#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
4132:vm_init:

    # mark bottom of stack
4132#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
4136#    move $s2,$zero

    #set up the "five" register
4140#    li $s5,5

4144#    la $s3,seg0_start
4148#    la $s4,seg0_end
4149##...lui $s4,16
4153##...addiu $s4,$s4,5036
    
    # return
4156#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4160:divide:
    # get parameters; abort if divisor zero
4160#    lw $t0,($sp)
4164#    lw $t1,8($sp)
4168#    beq $t0,$zero,divByZeroError
    
    # perform division
4172#    div $t1,$t0
4176#    mflo $t0

    # store result, adjust stack and return
4180#    addu $sp,$sp,8 # adjust stack
4184#    sw $t0,($sp) # store result
4188#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4192:remainder:
    # get parameters; abort if divisor zero
4192#    lw $t0,($sp)
4196#    lw $t1,8($sp)
4200#    beq $t0,$zero,divByZeroError
    
    # perform division
4204#    div $t1,$t0
4208#    mfhi $t0

    # store result, adjust stack and return
4212#    addu $sp,$sp,8 # adjust stack
4216#    sw $t0,($sp) # store result
4220#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
4224:checkCast:
    # get object, allow immediately if null
4224#    lw $t2,($sp)
4228#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
4232#    lw $t2,-12($t2) # vtable address
4236#    bge $t2,$t1,castException
4237##...slt $at,$t2,$t1
4241##...beq $at,$zero,4412
4244#    blt $t2,$t0,castException
4245##...slt $at,$t2,$t0
4249##...bne $at,$zero,4412
    
    # return, leaving object unchanged on stack
4252:  checkCastReturn:    
4252#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
4256:instanceOf:
    # get object, go return false if null
4256#    lw $t2,($sp)
4260#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
4264#    lw $t2,-12($t2) # vtable address
4268#    sge $t0,$t2,$t0 # are we >= the lower limit?
4269##...slt $t0,$t2,$t0
4273##...xori $t0,$t0,0x1
4276#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
4280#    and $t2,$t0,$t1
4284#    sw $t2,($sp)
4288:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
4288#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

4292:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
4292#    li $v0,4 # syscall-code for print-string
4296#    syscall
4300:exit:
    # print termination message
4300#    li $v0,4 # syscall-code for print-string
4304#    la $a0,exitString
4308#    syscall

    # print number of garbage collections
4312#    li $v0,4 # syscall-code for print-string
4316#    la $a0,gcCountMsg
4320#    syscall # print "Number of ..."
4324#    lw $a0,gcCount # number of GC's
4328#    li $v0,1 # code for print-int
4332#    syscall
4336#    li $v0,4 # syscall-code for print-string
4340#    la $a0,newlineString
4344#    syscall # print newline

    # terminate execution
4348#    li $v0,10 #syscall-code for "exit"
4352#    syscall

4356:outOfHeapMemory:
4356#    la $a0,heapMemoryMsg
4360#    j exitError
4364:divByZeroError:
4364#    la $a0,divByZeroMsg
4368#    j exitError
4372:strIndexOutOfBounds:
4372#    la $a0,strIndexOutOfBoundsMsg
4376#    j exitError
4380:arrayIndexOutOfBounds:
4380#    la $a0,arrayIndexOutOfBoundsMsg
4384#    j exitError
4388:arraySizeOutOfBounds:
4388#    la $a0,arraySizeOutOfBoundsMsg
4392#    j exitError
4396:nullPtrException:
4396#    la $a0,nullPtrExceptionMsg
4400#    j exitError
4404:badIntegerFormat:
4404#    la $a0,badIntegerFormatMsg
4408#    j exitError
4412:castException:
4412#    la $a0,castExceptionMsg
4416#    j exitError
############## data section ################
    .data
4664:hexChars:
    .ascii "0123456789abcdef"
    .align 2
4680:cur_seg:
    .word 0

4684:lastCharRead:
    .word -2 # -2 => no buffered character
4688:prevHashConstant:
    .word 0x2785173c
4692:gcCount:
    .word 0

4696:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
4723:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
4746:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
4781:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
4815:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
4848:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
4879:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
4927:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
4948:gcMsg: 
      .asciiz "\nGC!\n"
4954:gcCountMsg: 
      .asciiz "Number of garbage collections: "

4986:nullStr:
    .asciiz "null"
4991:trueString:
    .asciiz "true"
4996:falseString:
    .asciiz "false"
5002:exitString:
    .ascii "Program execution completed."
    #### "falls through" here
5030:newlineString:
    .asciiz "\n"
    
    .align 2
5032:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0
