2333##...addiu $at,$at,-28718
2337##...addu $t1,$at,$t1
2340#    sw $t1,prevHashConstant # update hash constant
2344#    or $t1,0x80000000 # set top bit
2345##...lui $at,32768
2349##...or $t1,$at,$t1
2352#    and $t1,0xffffff00 # clear low bit
2353##...lui $at,65535
2357##...ori $at,$at,0xff00
2361##...and $t1,$t1,$at
2364#    or $s6,$t1
2368:firstHeaderLarge:
2368#    sw $s6,-8($t0) # store header-1 value
2372#    lw $zero,-8($t0)

    # store second header-value
2376#    sw $s7,-4($t0)   # second header-word
2380#    lw $zero,-4($t0)
    
    # put return-value into $s7 and also push it onto top of stack
2384#    move $s7,$t0
2388#    subu $sp,$sp,4
2392#    sw $t0,($sp)
