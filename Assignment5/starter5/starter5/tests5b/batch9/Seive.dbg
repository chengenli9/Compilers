    # lower limit, and if we're < the higher limit
4756#    lw $t2,-12($t2) # vtable address
4760#    sge $t0,$t2,$t0 # are we >= the lower limit?
4761##...slt $t0,$t2,$t0
4765##...xori $t0,$t0,0x1
4768#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
4772#    and $t2,$t0,$t1
4776#    sw $t2,($sp)
4780:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
4780#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

4784:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
4784#    li $v0,4 # syscall-code for print-string
4788#    syscall
4792:exit:
    # print termination message
4792#    li $v0,4 # syscall-code for print-string
4796#    la $a0,exitString
4800#    syscall

    # print number of garbage collections
4804#    li $v0,4 # syscall-code for print-string
4808#    la $a0,gcCountMsg
4812#    syscall # print "Number of ..."
4816#    lw $a0,gcCount # number of GC's
4820#    li $v0,1 # code for print-int
4824#    syscall
4828#    li $v0,4 # syscall-code for print-string
4832#    la $a0,newlineString
4836#    syscall # print newline

    # terminate execution
4840#    li $v0,10 #syscall-code for "exit"
4844#    syscall

4848:outOfHeapMemory:
4848#    la $a0,heapMemoryMsg
4852#    j exitError
4856:divByZeroError:
4856#    la $a0,divByZeroMsg
4860#    j exitError
4864:strIndexOutOfBounds:
4864#    la $a0,strIndexOutOfBoundsMsg
4868#    j exitError
4872:arrayIndexOutOfBounds:
4872#    la $a0,arrayIndexOutOfBoundsMsg
4876#    j exitError
4880:arraySizeOutOfBounds:
4880#    la $a0,arraySizeOutOfBoundsMsg
4884#    j exitError
4888:nullPtrException:
4888#    la $a0,nullPtrExceptionMsg
4892#    j exitError
4896:badIntegerFormat:
4896#    la $a0,badIntegerFormatMsg
4900#    j exitError
4904:castException:
4904#    la $a0,castExceptionMsg
4908#    j exitError
############## data section ################
    .data
5132:hexChars:
    .ascii "0123456789abcdef"
    .align 2
5148:cur_seg:
    .word 0

5152:lastCharRead:
    .word -2 # -2 => no buffered character
5156:prevHashConstant:
    .word 0x2785173c
5160:gcCount:
    .word 0

5164:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
5191:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
5214:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
5249:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
5283:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
5316:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
5347:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
5395:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
5416:gcMsg: 
      .asciiz "\nGC!\n"
5422:gcCountMsg: 
      .asciiz "Number of garbage collections: "

5454:nullStr:
    .asciiz "null"
5459:trueString:
    .asciiz "true"
5464:falseString:
    .asciiz "false"
5470:exitString:
    .ascii "Program execution completed."
    #### "falls through" here
5498:newlineString:
    .asciiz "\n"
    
    .align 2
5500:stack_bottom:
    .word 0
