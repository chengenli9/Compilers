###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
5020:mth_readLine_Lib:
    
5020#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
5024#    sw $ra, 4($sp) # save $ra
5028#    move $t1,$sp # save "original" sp

5032:  doRead:

    # read the character
5032#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
5036#    subu $t2,$v0,13
5040#    bne $t2,$zero,notReturnRL
5044#    jal readLogicalChar
5048#    subu $t2,$v0,10 # check for newline
5052#    beq $t2,$zero,foundNewLine
5056#    sw $v0,lastCharRead # push back character into queue
5060#    j foundNewLine # go process the line

5064:  notReturnRL:

    # at this point, $v0 has our character

5064#    subu $t0,$v0,10
5068#    beq $t0,$zero,foundNewLine
5072#    blt $v0,$zero,foundEof
5073##...slt $at,$v0,$zero
5077##...bne $at,$zero,5092

    # we have a character, so push it onto stack
5080#    subu $sp,$sp,4
5084#    sw $v0,($sp)

    # loop back up to get next character
5088#    j doRead

5092:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
5092#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
5096#    li $s7, 0 # return-value: null
5100#    j rlReturn # return

5104:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
5104#    subu $t0,$t1,$sp # number of chars we read (times 4)
5108#    srl $s6,$t0,2 # number of words on stack with chars
5112#    subu $sp,$sp,4 # push char-count ...
5116#    sw $s6,($sp) # ... onto stack
5120#    addu $t2,$t0,5 # GC tag, incl. for count-word
5124#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
5128#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
5132#    srl $s6,$s6,2  # data words in object
5136#    move $s7,$zero # object words in object
5140#    jal newObject  # allocate space
    
    # store header words
5144#    la $t0,CLASS_String
5148#    sw $t0,-12($s7)# store class tag (String) into object
5152#    lw $t2,4($sp) # char-count
5156#    sll $t1,$t2,2 # 4 times number of chars
5160#    subu $t2,$zero,$t2 # negative of char-count
5164#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
5168#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
5172#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
5173##...slt $at,$t0,$zero
5177##...beq $at,$zero,5196
5180#    and $t0,0xff # mask off object's hash value ...
5181##...lui $at,0
5185##...ori $at,$at,0xff
5189##...and $t0,$t0,$at
5192#    sw $t0,-8($s7) # ... and store back into -8 header-word
5196:  skipMask_readLine:

5196#    sll $t0,$t0,2 # data bytes in object
5200#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
5204#    subu $t0,$t0,$t2 # place to store last character (plus 9)
5208#    addu $sp,$sp,8 # pop redundant object-pointer and count
5212#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

5216#    beq $sp,$t1,rlReturn
5220:  charCopyLoop:
5220#    lw $t2,($sp)
5224#    sb $t2,-9($t0)
5228#    addu $sp,$sp,4
5232#    subu $t0,$t0,1
5236#    bne $sp,$t1,charCopyLoop
5240:  rlReturn:

5240#    lw $ra, 4($sp)
5244#    addu $sp, 8   # pop $ra and pointless word off stack
5248#    move $t0, $s7 # return string we allocated in $s7
5252#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
5256:mth_readInt_Lib:

    # save $ra by pushing onto stack
5256#    subu $sp,$sp,4
5260#    sw $ra,($sp)

5264:  riSkipWhiteLoop:
    # read a character
5264#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
5268#    subu $t0,$v0,32
5272#    bgt $t0,$zero,nonWhite
5273##...slt $at,$zero,$t0
5277##...bne $at,$zero,5320
5280#    beq $t0,$zero,riSkipWhiteLoop # start over if space
5284#    subu $t0,$v0,10
5288#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
5292#    subu $t0,$v0,9
5296#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
5300#    subu $t0,$v0,13
5304#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
5308#    subu $t0,$v0,12
5312#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
5316#    j badIntegerFormat # illegal integer char: abort program

5320:  nonWhite:
5320#    subu $t0,$v0,'-'
5324#    li $t4,1 # final multiplier
5328#    bne $t0,$zero,helpReadInt # go read
5332#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
5336#    jal readLogicalChar

5340:  helpReadInt:
5340#    li $t2,10
5344#    subu $t1,$v0,'0' # convert digit to 0-9 value
5348#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
5349##...sltu $at,$t1,$t2
5353##...beq $at,$zero,7636
5356#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

5360:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

5360#    jal readLogicalChar # read next character
5364#    subu $t1,$v0,'0' # convert digit to 0-9 value
5368#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
5369##...sltu $at,$t1,$t2
5373##...beq $at,$zero,5392

5376#    mul $t3,$t3,$t2 # multiply old value by 10
5377##...mult $t3,$t2
5381##...mflo $t3
5384#    addu $t3,$t3,$t1 # add in value of new digit
5388#    j digitLoop

5392:  doneDigitLoop:

    # "push back" unused character into queue
5392#    sw $v0,lastCharRead

    # restore return address
5396#    lw $ra,($sp)
5400#    addu $sp, 4

    # multiply by sign and put return value in $t0
5404#    mult $t3,$t4 # multiply to account for poss. minus sign
5408#    mflo $t3
5412#    move $t0, $t3
    
    # return
5416#    jr $ra

###################################################################
# readChar() - library method (class Lib)
# - reads a single character from standard input
# - returns the integer that is the encoding of the character
# - returns -1 if end of file was encountered
# - parameter:
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
5420:mth_readChar_Lib:

    # save $ra by pushing onto stack
5420#    subu $sp,$sp,4
5424#    sw $ra,($sp)

      # read the character
5428#    jal readLogicalChar

    # restore return address; put value in $t0
    # replacing this-pointer saved return address
5432#    lw $ra,($sp)
5436#    addu $sp, 4
5440#    move $t0, $v0

    # return
5444#    jr $ra

########################################################
# printStr(str) - library method (class Lib)
# - prints string to standard output
# parameters:
#   - ($sp) - the string to print
#   - 4($sp) - old-this-pointer
########################################################
5448:mth_printStr_Lib:
