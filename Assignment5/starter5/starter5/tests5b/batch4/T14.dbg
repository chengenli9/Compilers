###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
924:mth_readLine_Lib:
    
924#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
928#    sw $ra, 4($sp) # save $ra
932#    move $t1,$sp # save "original" sp

936:  doRead:

    # read the character
936#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
940#    subu $t2,$v0,13
944#    bne $t2,$zero,notReturnRL
948#    jal readLogicalChar
952#    subu $t2,$v0,10 # check for newline
956#    beq $t2,$zero,foundNewLine
960#    sw $v0,lastCharRead # push back character into queue
964#    j foundNewLine # go process the line

968:  notReturnRL:

    # at this point, $v0 has our character

968#    subu $t0,$v0,10
972#    beq $t0,$zero,foundNewLine
976#    blt $v0,$zero,foundEof
977##...slt $at,$v0,$zero
981##...bne $at,$zero,996

    # we have a character, so push it onto stack
984#    subu $sp,$sp,4
988#    sw $v0,($sp)

    # loop back up to get next character
992#    j doRead

996:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
996#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
1000#    li $s7, 0 # return-value: null
1004#    j rlReturn # return

1008:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
1008#    subu $t0,$t1,$sp # number of chars we read (times 4)
1012#    srl $s6,$t0,2 # number of words on stack with chars
1016#    subu $sp,$sp,4 # push char-count ...
1020#    sw $s6,($sp) # ... onto stack
1024#    addu $t2,$t0,5 # GC tag, incl. for count-word
1028#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
1032#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
1036#    srl $s6,$s6,2  # data words in object
1040#    move $s7,$zero # object words in object
1044#    jal newObject  # allocate space
    
    # store header words
1048#    la $t0,CLASS_String
1052#    sw $t0,-12($s7)# store class tag (String) into object
1056#    lw $t2,4($sp) # char-count
1060#    sll $t1,$t2,2 # 4 times number of chars
1064#    subu $t2,$zero,$t2 # negative of char-count
1068#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
1072#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
1076#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
1077##...slt $at,$t0,$zero
1081##...beq $at,$zero,1100
1084#    and $t0,0xff # mask off object's hash value ...
1085##...lui $at,0
1089##...ori $at,$at,0xff
1093##...and $t0,$t0,$at
1096#    sw $t0,-8($s7) # ... and store back into -8 header-word
1100:  skipMask_readLine:

1100#    sll $t0,$t0,2 # data bytes in object
1104#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
1108#    subu $t0,$t0,$t2 # place to store last character (plus 9)
1112#    addu $sp,$sp,8 # pop redundant object-pointer and count
1116#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

1120#    beq $sp,$t1,rlReturn
1124:  charCopyLoop:
1124#    lw $t2,($sp)
1128#    sb $t2,-9($t0)
1132#    addu $sp,$sp,4
1136#    subu $t0,$t0,1
1140#    bne $sp,$t1,charCopyLoop
1144:  rlReturn:

1144#    lw $ra, 4($sp)
1148#    addu $sp, 8   # pop $ra and pointless word off stack
1152#    move $t0, $s7 # return string we allocated in $s7
1156#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
1160:mth_readInt_Lib:

    # save $ra by pushing onto stack
1160#    subu $sp,$sp,4
1164#    sw $ra,($sp)

1168:  riSkipWhiteLoop:
    # read a character
1168#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
1172#    subu $t0,$v0,32
1176#    bgt $t0,$zero,nonWhite
1177##...slt $at,$zero,$t0
1181##...bne $at,$zero,1224
1184#    beq $t0,$zero,riSkipWhiteLoop # start over if space
1188#    subu $t0,$v0,10
1192#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
1196#    subu $t0,$v0,9
1200#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
1204#    subu $t0,$v0,13
1208#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
1212#    subu $t0,$v0,12
1216#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
1220#    j badIntegerFormat # illegal integer char: abort program

1224:  nonWhite:
1224#    subu $t0,$v0,'-'
1228#    li $t4,1 # final multiplier
1232#    bne $t0,$zero,helpReadInt # go read
1236#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
1240#    jal readLogicalChar

1244:  helpReadInt:
1244#    li $t2,10
1248#    subu $t1,$v0,'0' # convert digit to 0-9 value
1252#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
1253##...sltu $at,$t1,$t2
1257##...beq $at,$zero,3504
1260#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

1264:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

1264#    jal readLogicalChar # read next character
1268#    subu $t1,$v0,'0' # convert digit to 0-9 value
1272#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
1273##...sltu $at,$t1,$t2
1277##...beq $at,$zero,1296

1280#    mul $t3,$t3,$t2 # multiply old value by 10
1281##...mult $t3,$t2
1285##...mflo $t3
1288#    addu $t3,$t3,$t1 # add in value of new digit
1292#    j digitLoop

1296:  doneDigitLoop:

    # "push back" unused character into queue
1296#    sw $v0,lastCharRead
