##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
4652:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
4652#    lw $t0,-8($s2) # get word with hash bits from this
4656#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
4660#    addu $t0,$t1

4664#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
4668:mth_equals_Object:
4668#    move $t0,$s2 # first pointer (this)
4672#    lw $t1,($sp) # second pointer
4676#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
4677##...subu $at,$t0,$t1
4681##...sltiu $t0,$at,1

4684#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
4688:mth_hashCode_String:
4688#    move $t0,$s2 # put this pointer in t0

4692#    li $t2,0 # current hash value
4696#    lw $t1,-4($t0) # negative of number of characters in string
4700#    beq $t1,$zero,done_hashCode_String # if zero length => done
4704#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
4708#    and $t0,0xfffffffc # adjust for padding
4709##...lui $at,65535
4713##...ori $at,$at,0xfffc
4717##...and $t0,$t0,$at
4720#    subu $t1,$t0,$t1 # address at end of string +12
4724:loop_hashCode_String:    
4724#    sll $t4,$t2,5 # multiply by 32
4728#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
4732#    lbu $t3,-12($t0) # current character
4736#    addu $t2,$t3 # add in current character
4740#    addu $t0,1 # go to next character's address
4744#    bne $t0,$t1,loop_hashCode_String # loop back if more
4748:done_hashCode_String:    

    # push int on stack
4748#    move $t0, $t2 # put $t2 in return slot
4752#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
4756:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
4756#    subu $sp,4
4760#    sw $ra,($sp)
    
    # get hash value
4764#    lw $t2,-12($s2) # vtable address
4768#    lw $t0,($t2) # method address
4772#    jalr $t0
4776#    subu $sp,8 # push result (int in $t0) on stack
4780#    sw $s5,4($sp)
4784#    sw $t0,($sp)

    # compute print-size of hash value
4788#    li $t0, 1
4792#    lw $t1, ($sp)
4796#    srl $t1,$t1,4
4800#    beq $t1,$zero,toString_skip_loop
4804:toString_loop_top:
4804#    addu $t0,1
4808#    srl $t1,$t1,4
4812#    bne $t1,$zero,toString_loop_top
4816:toString_skip_loop:
4816#    subu $sp,8
4820#    sw $s5,4($sp)
4824#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
4828#    lw $t2,-12($s2) # vtable address
4832#    move $t0,$t2
4836:toString_checkTagBit:
4836#    subu $t0,1
4840#    lb $t1,($t0)
4844#    and $t1,0x80
4845##...lui $at,0
4849##...ori $at,$at,0x80
4853##...and $t1,$t1,$at
4856#    beq $t1,$zero,toString_checkTagBit
4860#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
4864#    subu $sp,8
4868#    sw $t1,($sp)
4872#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
4876#    move $s7,$zero # -4 offset header word
4880#    lw $t4,8($sp) # bytes for hash value
4884#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
4888#    addu $t4,8
4892#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
4896#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

4900#    li $t0,CLASS_String # store string vtable address into ...
4904#    sw $t0,-12($s7) # ... -12 offset in object header
4908#    lw $t2,-12($s2) # our object's vtable address
4912#    lw $t5,4($sp) # number characters in prefix
4916#    lw $t1,12($sp) # number of characters in hashcode
4920#    addu $t3,$t1,$t5 # number of characters in string ...
4924#    addu $t3,1 # ... including the '@' character
4928#    subu $t0,$zero,$t3 # store negated length into ...
4932#    sw $t0,-4($s7) # ... -4 offset header word
4936#    lw $t0,-8($s7) # get -8 offset header-word
4940#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
4941##...slt $at,$t0,$zero
4945##...beq $at,$zero,4964
4948#    and $t0,0xff # mask off object's hash value ...
4949##...lui $at,0
4953##...ori $at,$at,0xff
4957##...and $t0,$t0,$at
4960#    sw $t0,-8($s7) # ... and store back into -8 header-word
4964:skipMask_toString:
4964#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
4968#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
4972#    subu $t4,$t2,$t5
4976:toString_copyLoop:    
4976#    lb $t3,($t4)
4980#    and $t3,0x7f # mask off sign bit (in case first word)
4981##...lui $at,0
4985##...ori $at,$at,0x7f
4989##...and $t3,$t3,$at
4992#    sb $t3,-8($t0)
4996#    addu $t4,1
5000#    addu $t0,1
5004#    blt $t4,$t2,toString_copyLoop
5005##...slt $at,$t4,$t2
5009##...bne $at,$zero,4976

    # copy the '@' sign
5012#    li $t3,'@'
5016#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
5020#    addu $t2,$t0,$t1 # address of last byte in string to store +8
5024#    lw $t3,20($sp) # hash code to print
5028:toString_hashCopyLoop:
5028#    and $t4,$t3,0xf
5032#    srl $t3,4
5036#    lb $t4,hexChars($t4)
5040#    sb $t4,-8($t2)
5044#    subu $t2,$t2,1
5048#    bgt $t2,$t0,toString_hashCopyLoop
5049##...slt $at,$t0,$t2
5053##...bne $at,$zero,5028

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
5056#    addu $sp,28
5060#    lw $ra,($sp)
5064#    addu $sp,4
5068#    move $t0, $s7 # return string we created
5072#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
5076:mth_equals_String:
    
    # quick test for obvious false
5076#    lw $t0,($sp) # second parameter
5080#    beq $t0,$zero,goEsFalse # go return false if null
5084#    lw $t1,-12($t0) # vtable pointer
5088#    la $t2,CLASS_String # string vtable pointer
5092#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
5096#    subu $sp,12
5100#    sw $ra,8($sp)
5104#    sw $s2,4($sp)
5108#    sw $t0,($sp)
5112#    jal mth_compareTo_String
5116#    lw $s2, 4($sp) #restore this pointer and pop parameters
5120#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
5124#    seq $t0,$t0,$zero
5125##...subu $at,$t0,$zero
5129##...sltiu $t0,$at,1

    # pop return address and return $t0
5132#    lw $ra,($sp)
5136#    addu $sp,4

5140#    jr $ra # return
    
5144:goEsFalse:
    # put 0 in $t0 and return
5144#    li $t0, 0
5148#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
5152:mth_toString_String:
    #we are a string, so return this.
5152#    move $t0, $s2
5156#    jr $ra

###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
5160:mth_readLine_Lib:
    
5160#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
5164#    sw $ra, 4($sp) # save $ra
5168#    move $t1,$sp # save "original" sp

5172:  doRead:

    # read the character
5172#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
5176#    subu $t2,$v0,13
5180#    bne $t2,$zero,notReturnRL
5184#    jal readLogicalChar
5188#    subu $t2,$v0,10 # check for newline
5192#    beq $t2,$zero,foundNewLine
5196#    sw $v0,lastCharRead # push back character into queue
5200#    j foundNewLine # go process the line

5204:  notReturnRL:

    # at this point, $v0 has our character

5204#    subu $t0,$v0,10
5208#    beq $t0,$zero,foundNewLine
5212#    blt $v0,$zero,foundEof
5213##...slt $at,$v0,$zero
5217##...bne $at,$zero,5232

    # we have a character, so push it onto stack
5220#    subu $sp,$sp,4
5224#    sw $v0,($sp)

    # loop back up to get next character
5228#    j doRead

5232:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
5232#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
5236#    li $s7, 0 # return-value: null
5240#    j rlReturn # return

5244:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
5244#    subu $t0,$t1,$sp # number of chars we read (times 4)
5248#    srl $s6,$t0,2 # number of words on stack with chars
5252#    subu $sp,$sp,4 # push char-count ...
5256#    sw $s6,($sp) # ... onto stack
5260#    addu $t2,$t0,5 # GC tag, incl. for count-word
5264#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
5268#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
5272#    srl $s6,$s6,2  # data words in object
5276#    move $s7,$zero # object words in object
5280#    jal newObject  # allocate space
    
    # store header words
5284#    la $t0,CLASS_String
5288#    sw $t0,-12($s7)# store class tag (String) into object
5292#    lw $t2,4($sp) # char-count
5296#    sll $t1,$t2,2 # 4 times number of chars
5300#    subu $t2,$zero,$t2 # negative of char-count
5304#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
5308#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
5312#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
5313##...slt $at,$t0,$zero
5317##...beq $at,$zero,5336
5320#    and $t0,0xff # mask off object's hash value ...
5321##...lui $at,0
5325##...ori $at,$at,0xff
5329##...and $t0,$t0,$at
5332#    sw $t0,-8($s7) # ... and store back into -8 header-word
5336:  skipMask_readLine:

5336#    sll $t0,$t0,2 # data bytes in object
5340#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
5344#    subu $t0,$t0,$t2 # place to store last character (plus 9)
5348#    addu $sp,$sp,8 # pop redundant object-pointer and count
5352#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

5356#    beq $sp,$t1,rlReturn
5360:  charCopyLoop:
5360#    lw $t2,($sp)
5364#    sb $t2,-9($t0)
5368#    addu $sp,$sp,4
5372#    subu $t0,$t0,1
5376#    bne $sp,$t1,charCopyLoop
5380:  rlReturn:

5380#    lw $ra, 4($sp)
5384#    addu $sp, 8   # pop $ra and pointless word off stack
5388#    move $t0, $s7 # return string we allocated in $s7
5392#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
