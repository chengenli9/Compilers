###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

4600:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
4600#    li $v0,4 # syscall-code for print-string
4604#    syscall
4608:exit:
    # print termination message
4608#    li $v0,4 # syscall-code for print-string
4612#    la $a0,exitString
4616#    syscall

    # print number of garbage collections
4620#    li $v0,4 # syscall-code for print-string
4624#    la $a0,gcCountMsg
4628#    syscall # print "Number of ..."
4632#    lw $a0,gcCount # number of GC's
4636#    li $v0,1 # code for print-int
4640#    syscall
4644#    li $v0,4 # syscall-code for print-string
4648#    la $a0,newlineString
4652#    syscall # print newline

    # terminate execution
4656#    li $v0,10 #syscall-code for "exit"
4660#    syscall
