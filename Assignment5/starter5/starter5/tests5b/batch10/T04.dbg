    # check if we have a data array
6752#    lw $t1,-12($t2) # vtable pointer
6756#    li $t0,dataArrayVTableStart # address of vtable for first data array
6760#    blt $t1,$t0,gcNotDataArray # if data array, no more xforming to do
6761##...slt $at,$t1,$t0
6765##...bne $at,$zero,6784

    # We have a vtable address that is a data array.
    # we need skip over it then loop back to do next object.
6768:  skipToNextObj:
6768#    lw $t1,-4($t2) # data words in (object position of) array
    #### note: we know that it's not a string, so the value will
    #### not be artificially negative
6772#    sll $t1,$t1,2 # convert to byte-count
6776#    addu $t0,$t2,$t1 # skip over object
6780#    j gcTestIterDone2 # go do next object, if any

    ###################################################
    # at this point:
    # - the object has been restored to normal status--that is, the
    #   word-swap has been done
    # - $t2 contains a pointer to the object
    ###################################################
    
6784:  gcNotDataArray:
6784#    lw $t3,-4($t2) # # object words (negative treated as zero)
6788#    bge $t3,$zero,gcH2Neg2
6789##...slt $at,$t3,$zero
6793##...beq $at,$zero,6800
6796#    move $t3,$zero
6800:  gcH2Neg2:
6800#    sll $t3,$t3,2 # # object bytes
6804#    move $t0,$t2 # address of first pointer in object
6808#    add $s1,$t2,$t3 # limit address for this object

    #####################################################
    # At this point, we have to "translate" all pointers,
    # starting at $t0 to (but not including) $s1
    #####################################################

    # if there are no pointer-slots (i.e., $t0=$s1), skip this
    # part
6812#    beq $t0,$s1,gcTestIterDone2
    
6816:  gcNextPointerInObject:
    # get pointer from object
6816#    lw $t1,($t0)

    # if value is out of range, and is therefore does not refer
    # to an object, just go loop back and do the next one
6820#    bleu $t1,$t6,gcGoNextPointerSlot
6821##...sltu $at,$t6,$t1
6825##...beq $at,$zero,6968
6828#    bgtu $t1,$t7,gcGoNextPointerSlot
6829##...sltu $at,$t7,$t1
6833##...bne $at,$zero,6968

    # if the object has already been moved, update the stack-value
    # via the forwarding pointer
6836#    lw $t8,-8($t1) # possible forwarding tag
6840#    bne $t8,$zero,gcNoForward2 # if not forwarding tag, go copy
6844#    lw $t8,-4($t1) # forwarding pointer: object's new address
6848#    sw $t8,($t0) # update pointer in object
6852#    j gcGoNextPointerSlot # do next iteration

6856:  gcNoForward2:
    #########################################################
    # we actually need to copy the object into the new space
    #########################################################

    #########################################################
    # At this point:
    # - $t0 contains the address of the heap-slot we're translating
    # - $t1 will contain the contents of the heap-slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space, which will also be the first address
    #   of the target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # Then during processing:
    # And when we're actually copying an object:
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $t8 will contain a pointer to the target object
    # - available for use: $s0, $t8, $t9
    ##########################################################

    # compute the amount of space that is needed
6856#    bge $t8,$zero,gcSkip5 # # words in negative-offset portion
6857##...slt $at,$t8,$zero
6861##...beq $at,$zero,6876
6864#    and $t8,0xff # mask off hash bits
6865##...lui $at,0
6869##...ori $at,$at,0xff
6873##...and $t8,$t8,$at

6876:  gcSkip5:
6876#    sll $t8,$t8,2 # bytes in negative-offset portion ...
6880#    addu $t8,$t8,8 # ... add in bytes for header-words
6884#    subu $t4,$t1,$t8 # address of first word of source object
6888#    lw $t3,-4($t1) # # words in positive-offset portion
6892#    bge $t3,$zero,gcNoNeg
6893##...slt $at,$t3,$zero
6897##...beq $at,$zero,6904
6900#    move $t3,$zero # negative treated as zero
6904:  gcNoNeg:
6904#    sll $t3,$t3,2 # bytes in negative-offset portion
6908#    addu $t3,$t3,$t1 # address one word past last word of source

6912#    addu $t8,$s3,$t8 # pointer to target object

    #########################################################
    # At this point:
    # - $t0 contains the address of the stack slot we'll
    #   process next
    # - $t1 contains the contents of the stack slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $t8 contains the pointer to the target object
    # - $s1 contains the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0, $t9
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger"
6916#    lw $s0,($t4)
6920#    lw $t9,-8($t1)
6924#    sw $t9,($t4)
6928#    sw $s0,-8($t1)

    # copy all source bytes to the target
6932:  gCinnerCopy2:
6932#    lw $s0,($t4)
6936#    sw $s0,($s3)
6940#    addu $t4,$t4,4
6944#    addu $s3,$s3,4
6948#    bltu $t4,$t3,gCinnerCopy2
6949##...sltu $at,$t4,$t3
6953##...bne $at,$zero,6932

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
6956#    sw $zero,-8($t1) # 0 in first header-slot
6960#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
6964#    sw $t8,($t0)

6968:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
6968#    addu $t0,$t0,4
6972#    bltu $t0,$s1,gcNextPointerInObject
6973##...sltu $at,$t0,$s1
6977##...bne $at,$zero,6816

6980:  gcTestIterDone2:
6980#    bltu $t0,$s3,gcHeapCopyLoop
6981##...sltu $at,$t0,$s3
6985##...bne $at,$zero,6700

    ###### end outer loop to copy all non-stack-direct objects ######

6988:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
6988#    lw $s2,($sp)
6992#    addu $sp,$sp,4

    # mark us as having already GC'd
6996#    move $t5,$s5

    # go try and allocate again
7000#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
7004:vm_init:

    # mark bottom of stack
7004#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
7008#    move $s2,$zero

    #set up the "five" register
7012#    li $s5,5

7016#    la $s3,seg0_start
7020#    la $s4,seg0_end
7021##...lui $s4,16
7025##...addiu $s4,$s4,8252
    
    # return
7028#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
7032:divide:
    # get parameters; abort if divisor zero
7032#    lw $t0,($sp)
7036#    lw $t1,8($sp)
7040#    beq $t0,$zero,divByZeroError
    
    # perform division
7044#    div $t1,$t0
7048#    mflo $t0

    # store result, adjust stack and return
7052#    addu $sp,$sp,8 # adjust stack
7056#    sw $t0,($sp) # store result
7060#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
7064:remainder:
    # get parameters; abort if divisor zero
7064#    lw $t0,($sp)
7068#    lw $t1,8($sp)
7072#    beq $t0,$zero,divByZeroError
    
    # perform division
7076#    div $t1,$t0
7080#    mfhi $t0

    # store result, adjust stack and return
7084#    addu $sp,$sp,8 # adjust stack
7088#    sw $t0,($sp) # store result
7092#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
7096:checkCast:
    # get object, allow immediately if null
7096#    lw $t2,($sp)
7100#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
7104#    lw $t2,-12($t2) # vtable address
7108#    bge $t2,$t1,castException
7109##...slt $at,$t2,$t1
7113##...beq $at,$zero,7284
7116#    blt $t2,$t0,castException
7117##...slt $at,$t2,$t0
7121##...bne $at,$zero,7284
    
    # return, leaving object unchanged on stack
7124:  checkCastReturn:    
7124#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
7128:instanceOf:
    # get object, go return false if null
7128#    lw $t2,($sp)
7132#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
7136#    lw $t2,-12($t2) # vtable address
7140#    sge $t0,$t2,$t0 # are we >= the lower limit?
7141##...slt $t0,$t2,$t0
7145##...xori $t0,$t0,0x1
7148#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
7152#    and $t2,$t0,$t1
7156#    sw $t2,($sp)
7160:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
7160#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

7164:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
7164#    li $v0,4 # syscall-code for print-string
7168#    syscall
7172:exit:
    # print termination message
7172#    li $v0,4 # syscall-code for print-string
7176#    la $a0,exitString
7180#    syscall

    # print number of garbage collections
7184#    li $v0,4 # syscall-code for print-string
7188#    la $a0,gcCountMsg
7192#    syscall # print "Number of ..."
7196#    lw $a0,gcCount # number of GC's
7200#    li $v0,1 # code for print-int
7204#    syscall
7208#    li $v0,4 # syscall-code for print-string
7212#    la $a0,newlineString
7216#    syscall # print newline

    # terminate execution
7220#    li $v0,10 #syscall-code for "exit"
7224#    syscall

7228:outOfHeapMemory:
7228#    la $a0,heapMemoryMsg
7232#    j exitError
7236:divByZeroError:
7236#    la $a0,divByZeroMsg
7240#    j exitError
7244:strIndexOutOfBounds:
7244#    la $a0,strIndexOutOfBoundsMsg
7248#    j exitError
7252:arrayIndexOutOfBounds:
7252#    la $a0,arrayIndexOutOfBoundsMsg
7256#    j exitError
7260:arraySizeOutOfBounds:
7260#    la $a0,arraySizeOutOfBoundsMsg
7264#    j exitError
7268:nullPtrException:
7268#    la $a0,nullPtrExceptionMsg
7272#    j exitError
7276:badIntegerFormat:
7276#    la $a0,badIntegerFormatMsg
7280#    j exitError
7284:castException:
7284#    la $a0,castExceptionMsg
7288#    j exitError
############## data section ################
    .data
7880:hexChars:
    .ascii "0123456789abcdef"
    .align 2
7896:cur_seg:
    .word 0

7900:lastCharRead:
    .word -2 # -2 => no buffered character
7904:prevHashConstant:
    .word 0x2785173c
7908:gcCount:
    .word 0

7912:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
7939:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
7962:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
7997:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
8031:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
8064:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
8095:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
8143:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
8164:gcMsg: 
      .asciiz "\nGC!\n"
8170:gcCountMsg: 
      .asciiz "Number of garbage collections: "

8202:nullStr:
    .asciiz "null"
8207:trueString:
    .asciiz "true"
8212:falseString:
    .asciiz "false"
8218:exitString:
    .ascii "Program execution completed."
    #### "falls through" here
8246:newlineString:
    .asciiz "\n"
    
    .align 2
8248:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

8252:seg0_start:
    .space 0x100000
1056828:seg0_end:
1056828:seg1_start:
    .space 0x100000
2105404:seg1_end:
