    # Then during processing:
    # And when we're actually copying an object:
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $t8 will contain a pointer to the target object
    # - available for use: $s0, $t8, $t9
    ##########################################################

    # compute the amount of space that is needed
8264#    bge $t8,$zero,gcSkip5 # # words in negative-offset portion
8265##...slt $at,$t8,$zero
8269##...beq $at,$zero,8284
8272#    and $t8,0xff # mask off hash bits
8273##...lui $at,0
8277##...ori $at,$at,0xff
8281##...and $t8,$t8,$at

8284:  gcSkip5:
8284#    sll $t8,$t8,2 # bytes in negative-offset portion ...
8288#    addu $t8,$t8,8 # ... add in bytes for header-words
8292#    subu $t4,$t1,$t8 # address of first word of source object
8296#    lw $t3,-4($t1) # # words in positive-offset portion
8300#    bge $t3,$zero,gcNoNeg
8301##...slt $at,$t3,$zero
8305##...beq $at,$zero,8312
8308#    move $t3,$zero # negative treated as zero
8312:  gcNoNeg:
8312#    sll $t3,$t3,2 # bytes in negative-offset portion
8316#    addu $t3,$t3,$t1 # address one word past last word of source

8320#    addu $t8,$s3,$t8 # pointer to target object

    #########################################################
    # At this point:
    # - $t0 contains the address of the stack slot we'll
    #   process next
    # - $t1 contains the contents of the stack slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $t8 contains the pointer to the target object
    # - $s1 contains the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0, $t9
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger"
8324#    lw $s0,($t4)
8328#    lw $t9,-8($t1)
8332#    sw $t9,($t4)
8336#    sw $s0,-8($t1)

    # copy all source bytes to the target
8340:  gCinnerCopy2:
8340#    lw $s0,($t4)
8344#    sw $s0,($s3)
8348#    addu $t4,$t4,4
8352#    addu $s3,$s3,4
8356#    bltu $t4,$t3,gCinnerCopy2
8357##...sltu $at,$t4,$t3
8361##...bne $at,$zero,8340

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
8364#    sw $zero,-8($t1) # 0 in first header-slot
8368#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
8372#    sw $t8,($t0)

8376:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
8376#    addu $t0,$t0,4
8380#    bltu $t0,$s1,gcNextPointerInObject
8381##...sltu $at,$t0,$s1
8385##...bne $at,$zero,8224

8388:  gcTestIterDone2:
8388#    bltu $t0,$s3,gcHeapCopyLoop
8389##...sltu $at,$t0,$s3
8393##...bne $at,$zero,8108

    ###### end outer loop to copy all non-stack-direct objects ######

8396:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
8396#    lw $s2,($sp)
8400#    addu $sp,$sp,4

    # mark us as having already GC'd
8404#    move $t5,$s5

    # go try and allocate again
8408#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
8412:vm_init:

    # mark bottom of stack
8412#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
8416#    move $s2,$zero

    #set up the "five" register
8420#    li $s5,5

8424#    la $s3,seg0_start
8428#    la $s4,seg0_end
8429##...lui $s4,16
8433##...addiu $s4,$s4,9704
    
    # return
8436#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
8440:divide:
    # get parameters; abort if divisor zero
8440#    lw $t0,($sp)
8444#    lw $t1,8($sp)
8448#    beq $t0,$zero,divByZeroError
    
    # perform division
8452#    div $t1,$t0
8456#    mflo $t0

    # store result, adjust stack and return
8460#    addu $sp,$sp,8 # adjust stack
8464#    sw $t0,($sp) # store result
8468#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
8472:remainder:
    # get parameters; abort if divisor zero
8472#    lw $t0,($sp)
8476#    lw $t1,8($sp)
8480#    beq $t0,$zero,divByZeroError
    
    # perform division
8484#    div $t1,$t0
8488#    mfhi $t0

    # store result, adjust stack and return
8492#    addu $sp,$sp,8 # adjust stack
8496#    sw $t0,($sp) # store result
8500#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
8504:checkCast:
    # get object, allow immediately if null
8504#    lw $t2,($sp)
8508#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
8512#    lw $t2,-12($t2) # vtable address
8516#    bge $t2,$t1,castException
8517##...slt $at,$t2,$t1
8521##...beq $at,$zero,8656
8524#    blt $t2,$t0,castException
8525##...slt $at,$t2,$t0
8529##...bne $at,$zero,8656
    
    # return, leaving object unchanged on stack
8532:  checkCastReturn:    
8532#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
8536:instanceOf:
    # get object, go return false if null
8536#    lw $t2,($sp)
8540#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
8544#    lw $t2,-12($t2) # vtable address
8548#    sge $t0,$t2,$t0 # are we >= the lower limit?
8549##...slt $t0,$t2,$t0
8553##...xori $t0,$t0,0x1
8556#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
8560#    and $t2,$t0,$t1
8564#    sw $t2,($sp)
8568:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
8568#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

8572:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
8572#    li $v0,4 # syscall-code for print-string
8576#    syscall
8580:exit:
    # print termination message
8580#    li $v0,4 # syscall-code for print-string
8584#    la $a0,exitString
8588#    syscall

    # terminate execution
8592#    li $v0,10 #syscall-code for "exit"
8596#    syscall

8600:outOfHeapMemory:
8600#    la $a0,heapMemoryMsg
8604#    j exitError
8608:divByZeroError:
8608#    la $a0,divByZeroMsg
8612#    j exitError
8616:strIndexOutOfBounds:
8616#    la $a0,strIndexOutOfBoundsMsg
8620#    j exitError
8624:arrayIndexOutOfBounds:
8624#    la $a0,arrayIndexOutOfBoundsMsg
8628#    j exitError
8632:arraySizeOutOfBounds:
8632#    la $a0,arraySizeOutOfBoundsMsg
8636#    j exitError
8640:nullPtrException:
8640#    la $a0,nullPtrExceptionMsg
8644#    j exitError
8648:badIntegerFormat:
8648#    la $a0,badIntegerFormatMsg
8652#    j exitError
8656:castException:
8656#    la $a0,castExceptionMsg
8660#    j exitError
############## data section ################
    .data
9340:hexChars:
    .ascii "0123456789abcdef"
    .align 2
9356:cur_seg:
    .word 0

9360:lastCharRead:
    .word -2 # -2 => no buffered character
9364:prevHashConstant:
    .word 0x2785173c
9368:gcCount:
    .word 0

9372:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
9399:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
9422:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
9457:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
9491:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
9524:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
9555:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
9603:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
9624:gcMsg: 
      .asciiz "\nGC!\n"
9630:gcCountMsg: 
      .asciiz "Number of garbage collections: "

9662:nullStr:
    .asciiz "null"
9667:trueString:
    .asciiz "true"
9672:falseString:
    .asciiz "false"
9678:exitString:
    .ascii "Program terminated."
    #### "falls through" here
9697:newlineString:
    .asciiz "\n"
    
    .align 2
9700:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

9704:seg0_start:
    .space 0x100000
1058280:seg0_end:
1058280:seg1_start:
    .space 0x100000
2106856:seg1_end:
