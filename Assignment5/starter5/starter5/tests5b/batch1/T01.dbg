########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
3020:vm_init:

    # mark bottom of stack
3020#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
3024#    move $s2,$zero

    #set up the "five" register
3028#    li $s5,5

3032#    la $s3,seg0_start
3036#    la $s4,seg0_end
3037##...lui $s4,16
3041##...addiu $s4,$s4,3852
    
    # return
3044#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3048:divide:
    # get parameters; abort if divisor zero
3048#    lw $t0,($sp)
3052#    lw $t1,8($sp)
3056#    beq $t0,$zero,divByZeroError
    
    # perform division
3060#    div $t1,$t0
3064#    mflo $t0

    # store result, adjust stack and return
3068#    addu $sp,$sp,8 # adjust stack
3072#    sw $t0,($sp) # store result
3076#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3080:remainder:
    # get parameters; abort if divisor zero
3080#    lw $t0,($sp)
3084#    lw $t1,8($sp)
3088#    beq $t0,$zero,divByZeroError
    
    # perform division
3092#    div $t1,$t0
3096#    mfhi $t0

    # store result, adjust stack and return
3100#    addu $sp,$sp,8 # adjust stack
3104#    sw $t0,($sp) # store result
3108#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
3112:checkCast:
    # get object, allow immediately if null
3112#    lw $t2,($sp)
3116#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
3120#    lw $t2,-12($t2) # vtable address
3124#    bge $t2,$t1,castException
3125##...slt $at,$t2,$t1
3129##...beq $at,$zero,3264
3132#    blt $t2,$t0,castException
3133##...slt $at,$t2,$t0
3137##...bne $at,$zero,3264
    
    # return, leaving object unchanged on stack
3140:  checkCastReturn:    
3140#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
3144:instanceOf:
    # get object, go return false if null
3144#    lw $t2,($sp)
3148#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
3152#    lw $t2,-12($t2) # vtable address
3156#    sge $t0,$t2,$t0 # are we >= the lower limit?
3157##...slt $t0,$t2,$t0
3161##...xori $t0,$t0,0x1
3164#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
3168#    and $t2,$t0,$t1
3172#    sw $t2,($sp)
3176:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
3176#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

3180:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
3180#    li $v0,4 # syscall-code for print-string
3184#    syscall
3188:exit:
    # print termination message
3188#    li $v0,4 # syscall-code for print-string
3192#    la $a0,exitString
3196#    syscall

    # terminate execution
3200#    li $v0,10 #syscall-code for "exit"
3204#    syscall

3208:outOfHeapMemory:
3208#    la $a0,heapMemoryMsg
3212#    j exitError
3216:divByZeroError:
3216#    la $a0,divByZeroMsg
3220#    j exitError
3224:strIndexOutOfBounds:
3224#    la $a0,strIndexOutOfBoundsMsg
3228#    j exitError
3232:arrayIndexOutOfBounds:
3232#    la $a0,arrayIndexOutOfBoundsMsg
3236#    j exitError
3240:arraySizeOutOfBounds:
3240#    la $a0,arraySizeOutOfBoundsMsg
3244#    j exitError
3248:nullPtrException:
3248#    la $a0,nullPtrExceptionMsg
3252#    j exitError
3256:badIntegerFormat:
3256#    la $a0,badIntegerFormatMsg
3260#    j exitError
3264:castException:
3264#    la $a0,castExceptionMsg
3268#    j exitError
############## data section ################
    .data
3488:hexChars:
    .ascii "0123456789abcdef"
    .align 2
3504:cur_seg:
    .word 0

3508:lastCharRead:
    .word -2 # -2 => no buffered character
3512:prevHashConstant:
    .word 0x2785173c
3516:gcCount:
