##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1104:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
1104#    lw $t0,-8($s2) # get word with hash bits from this
1108#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
1112#    addu $t0,$t1

1116#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1120:mth_equals_Object:
1120#    move $t0,$s2 # first pointer (this)
1124#    lw $t1,($sp) # second pointer
1128#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
1129##...subu $at,$t0,$t1
1133##...sltiu $t0,$at,1

1136#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1140:mth_hashCode_String:
1140#    move $t0,$s2 # put this pointer in t0

1144#    li $t2,0 # current hash value
1148#    lw $t1,-4($t0) # negative of number of characters in string
1152#    beq $t1,$zero,done_hashCode_String # if zero length => done
1156#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
1160#    and $t0,0xfffffffc # adjust for padding
1161##...lui $at,65535
1165##...ori $at,$at,0xfffc
1169##...and $t0,$t0,$at
1172#    subu $t1,$t0,$t1 # address at end of string +12
1176:loop_hashCode_String:    
1176#    sll $t4,$t2,5 # multiply by 32
1180#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
1184#    lbu $t3,-12($t0) # current character
1188#    addu $t2,$t3 # add in current character
1192#    addu $t0,1 # go to next character's address
1196#    bne $t0,$t1,loop_hashCode_String # loop back if more
1200:done_hashCode_String:    

    # push int on stack
1200#    move $t0, $t2 # put $t2 in return slot
1204#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
1208:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
1208#    subu $sp,4
1212#    sw $ra,($sp)
    
    # get hash value
1216#    lw $t2,-12($s2) # vtable address
1220#    lw $t0,($t2) # method address
1224#    jalr $t0
1228#    subu $sp,8 # push result (int in $t0) on stack
1232#    sw $s5,4($sp)
1236#    sw $t0,($sp)

    # compute print-size of hash value
1240#    li $t0, 1
1244#    lw $t1, ($sp)
1248#    srl $t1,$t1,4
1252#    beq $t1,$zero,toString_skip_loop
1256:toString_loop_top:
1256#    addu $t0,1
1260#    srl $t1,$t1,4
1264#    bne $t1,$zero,toString_loop_top
1268:toString_skip_loop:
1268#    subu $sp,8
1272#    sw $s5,4($sp)
1276#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
1280#    lw $t2,-12($s2) # vtable address
1284#    move $t0,$t2
1288:toString_checkTagBit:
1288#    subu $t0,1
1292#    lb $t1,($t0)
1296#    and $t1,0x80
1297##...lui $at,0
1301##...ori $at,$at,0x80
1305##...and $t1,$t1,$at
1308#    beq $t1,$zero,toString_checkTagBit
1312#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
1316#    subu $sp,8
1320#    sw $t1,($sp)
1324#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
1328#    move $s7,$zero # -4 offset header word
1332#    lw $t4,8($sp) # bytes for hash value
1336#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
1340#    addu $t4,8
1344#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
1348#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

1352#    li $t0,CLASS_String # store string vtable address into ...
1356#    sw $t0,-12($s7) # ... -12 offset in object header
1360#    lw $t2,-12($s2) # our object's vtable address
1364#    lw $t5,4($sp) # number characters in prefix
1368#    lw $t1,12($sp) # number of characters in hashcode
1372#    addu $t3,$t1,$t5 # number of characters in string ...
1376#    addu $t3,1 # ... including the '@' character
1380#    subu $t0,$zero,$t3 # store negated length into ...
1384#    sw $t0,-4($s7) # ... -4 offset header word
1388#    lw $t0,-8($s7) # get -8 offset header-word
1392#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
1393##...slt $at,$t0,$zero
1397##...beq $at,$zero,1416
1400#    and $t0,0xff # mask off object's hash value ...
1401##...lui $at,0
1405##...ori $at,$at,0xff
1409##...and $t0,$t0,$at
1412#    sw $t0,-8($s7) # ... and store back into -8 header-word
1416:skipMask_toString:
1416#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
1420#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
1424#    subu $t4,$t2,$t5
1428:toString_copyLoop:    
1428#    lb $t3,($t4)
1432#    and $t3,0x7f # mask off sign bit (in case first word)
1433##...lui $at,0
1437##...ori $at,$at,0x7f
1441##...and $t3,$t3,$at
1444#    sb $t3,-8($t0)
1448#    addu $t4,1
1452#    addu $t0,1
1456#    blt $t4,$t2,toString_copyLoop
1457##...slt $at,$t4,$t2
1461##...bne $at,$zero,1428

    # copy the '@' sign
1464#    li $t3,'@'
1468#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
1472#    addu $t2,$t0,$t1 # address of last byte in string to store +8
1476#    lw $t3,20($sp) # hash code to print
1480:toString_hashCopyLoop:
1480#    and $t4,$t3,0xf
1484#    srl $t3,4
1488#    lb $t4,hexChars($t4)
1492#    sb $t4,-8($t2)
1496#    subu $t2,$t2,1
1500#    bgt $t2,$t0,toString_hashCopyLoop
1501##...slt $at,$t0,$t2
1505##...bne $at,$zero,1480

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
1508#    addu $sp,28
1512#    lw $ra,($sp)
1516#    addu $sp,4
1520#    move $t0, $s7 # return string we created
1524#    jr $ra
