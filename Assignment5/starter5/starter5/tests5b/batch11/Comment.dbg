
    # determine if we have enough memory available
4808#    addu $t0,$s6,$s7
4812#    sll $t0,$t0,2
4816#    addu $t0,$t0,8 # amount of memory needed
4820#    addu $t1,$t0,$s3
4824#    bgtu $t1,$s4,doGC
