##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
5520:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
5520#    lw $t0,-8($s2) # get word with hash bits from this
5524#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
5528#    addu $t0,$t1

5532#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
5536:mth_equals_Object:
5536#    move $t0,$s2 # first pointer (this)
5540#    lw $t1,($sp) # second pointer
5544#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
5545##...subu $at,$t0,$t1
5549##...sltiu $t0,$at,1

5552#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
5556:mth_hashCode_String:
5556#    move $t0,$s2 # put this pointer in t0

5560#    li $t2,0 # current hash value
5564#    lw $t1,-4($t0) # negative of number of characters in string
5568#    beq $t1,$zero,done_hashCode_String # if zero length => done
5572#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
5576#    and $t0,0xfffffffc # adjust for padding
5577##...lui $at,65535
5581##...ori $at,$at,0xfffc
5585##...and $t0,$t0,$at
5588#    subu $t1,$t0,$t1 # address at end of string +12
5592:loop_hashCode_String:    
5592#    sll $t4,$t2,5 # multiply by 32
5596#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
5600#    lbu $t3,-12($t0) # current character
5604#    addu $t2,$t3 # add in current character
5608#    addu $t0,1 # go to next character's address
5612#    bne $t0,$t1,loop_hashCode_String # loop back if more
5616:done_hashCode_String:    

    # push int on stack
5616#    move $t0, $t2 # put $t2 in return slot
5620#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
5624:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
5624#    subu $sp,4
5628#    sw $ra,($sp)
    
    # get hash value
5632#    lw $t2,-12($s2) # vtable address
5636#    lw $t0,($t2) # method address
5640#    jalr $t0
5644#    subu $sp,8 # push result (int in $t0) on stack
5648#    sw $s5,4($sp)
5652#    sw $t0,($sp)

    # compute print-size of hash value
5656#    li $t0, 1
5660#    lw $t1, ($sp)
5664#    srl $t1,$t1,4
5668#    beq $t1,$zero,toString_skip_loop
5672:toString_loop_top:
5672#    addu $t0,1
5676#    srl $t1,$t1,4
5680#    bne $t1,$zero,toString_loop_top
5684:toString_skip_loop:
5684#    subu $sp,8
5688#    sw $s5,4($sp)
5692#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
5696#    lw $t2,-12($s2) # vtable address
5700#    move $t0,$t2
5704:toString_checkTagBit:
5704#    subu $t0,1
5708#    lb $t1,($t0)
5712#    and $t1,0x80
5713##...lui $at,0
5717##...ori $at,$at,0x80
5721##...and $t1,$t1,$at
5724#    beq $t1,$zero,toString_checkTagBit
5728#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
5732#    subu $sp,8
5736#    sw $t1,($sp)
5740#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
5744#    move $s7,$zero # -4 offset header word
5748#    lw $t4,8($sp) # bytes for hash value
5752#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
5756#    addu $t4,8
5760#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
5764#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

