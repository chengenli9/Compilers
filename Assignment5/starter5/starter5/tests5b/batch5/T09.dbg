1116#    lw $s2, 4($sp) #restore this pointer and pop parameters
1120#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
1124#    seq $t0,$t0,$zero
1125##...subu $at,$t0,$zero
1129##...sltiu $t0,$at,1

    # pop return address and return $t0
1132#    lw $ra,($sp)
1136#    addu $sp,4

1140#    jr $ra # return
    
1144:goEsFalse:
    # put 0 in $t0 and return
1144#    li $t0, 0
1148#    jr $ra # return
