3644#    j gcGoNextPointerSlot # do next iteration

3648:  gcNoForward2:
    #########################################################
    # we actually need to copy the object into the new space
    #########################################################

    #########################################################
    # At this point:
    # - $t0 contains the address of the heap-slot we're translating
    # - $t1 will contain the contents of the heap-slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space, which will also be the first address
    #   of the target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # Then during processing:
    # And when we're actually copying an object:
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $t8 will contain a pointer to the target object
    # - available for use: $s0, $t8, $t9
    ##########################################################

    # compute the amount of space that is needed
3648#    bge $t8,$zero,gcSkip5 # # words in negative-offset portion
3649##...slt $at,$t8,$zero
3653##...beq $at,$zero,3668
3656#    and $t8,0xff # mask off hash bits
3657##...lui $at,0
3661##...ori $at,$at,0xff
3665##...and $t8,$t8,$at

3668:  gcSkip5:
3668#    sll $t8,$t8,2 # bytes in negative-offset portion ...
3672#    addu $t8,$t8,8 # ... add in bytes for header-words
3676#    subu $t4,$t1,$t8 # address of first word of source object
3680#    lw $t3,-4($t1) # # words in positive-offset portion
3684#    bge $t3,$zero,gcNoNeg
3685##...slt $at,$t3,$zero
3689##...beq $at,$zero,3696
3692#    move $t3,$zero # negative treated as zero
3696:  gcNoNeg:
3696#    sll $t3,$t3,2 # bytes in negative-offset portion
3700#    addu $t3,$t3,$t1 # address one word past last word of source

3704#    addu $t8,$s3,$t8 # pointer to target object

    #########################################################
    # At this point:
    # - $t0 contains the address of the stack slot we'll
    #   process next
    # - $t1 contains the contents of the stack slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $t8 contains the pointer to the target object
    # - $s1 contains the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0, $t9
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger"
3708#    lw $s0,($t4)
3712#    lw $t9,-8($t1)
3716#    sw $t9,($t4)
3720#    sw $s0,-8($t1)

    # copy all source bytes to the target
3724:  gCinnerCopy2:
3724#    lw $s0,($t4)
3728#    sw $s0,($s3)
3732#    addu $t4,$t4,4
3736#    addu $s3,$s3,4
3740#    bltu $t4,$t3,gCinnerCopy2
3741##...sltu $at,$t4,$t3
3745##...bne $at,$zero,3724

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
3748#    sw $zero,-8($t1) # 0 in first header-slot
3752#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
3756#    sw $t8,($t0)

3760:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
3760#    addu $t0,$t0,4
3764#    bltu $t0,$s1,gcNextPointerInObject
3765##...sltu $at,$t0,$s1
3769##...bne $at,$zero,3608

3772:  gcTestIterDone2:
3772#    bltu $t0,$s3,gcHeapCopyLoop
3773##...sltu $at,$t0,$s3
3777##...bne $at,$zero,3492

    ###### end outer loop to copy all non-stack-direct objects ######

3780:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
3780#    lw $s2,($sp)
3784#    addu $sp,$sp,4

    # mark us as having already GC'd
3788#    move $t5,$s5

    # go try and allocate again
3792#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
3796:vm_init:

    # mark bottom of stack
3796#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
3800#    move $s2,$zero

    #set up the "five" register
3804#    li $s5,5

3808#    la $s3,seg0_start
3812#    la $s4,seg0_end
3813##...lui $s4,16
3817##...addiu $s4,$s4,4700
    
    # return
3820#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3824:divide:
    # get parameters; abort if divisor zero
3824#    lw $t0,($sp)
3828#    lw $t1,8($sp)
3832#    beq $t0,$zero,divByZeroError
    
    # perform division
3836#    div $t1,$t0
3840#    mflo $t0

    # store result, adjust stack and return
3844#    addu $sp,$sp,8 # adjust stack
3848#    sw $t0,($sp) # store result
3852#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3856:remainder:
    # get parameters; abort if divisor zero
3856#    lw $t0,($sp)
3860#    lw $t1,8($sp)
3864#    beq $t0,$zero,divByZeroError
    
    # perform division
3868#    div $t1,$t0
3872#    mfhi $t0

    # store result, adjust stack and return
3876#    addu $sp,$sp,8 # adjust stack
3880#    sw $t0,($sp) # store result
3884#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
3888:checkCast:
    # get object, allow immediately if null
3888#    lw $t2,($sp)
3892#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
3896#    lw $t2,-12($t2) # vtable address
3900#    bge $t2,$t1,castException
3901##...slt $at,$t2,$t1
3905##...beq $at,$zero,4076
3908#    blt $t2,$t0,castException
3909##...slt $at,$t2,$t0
3913##...bne $at,$zero,4076
    
    # return, leaving object unchanged on stack
3916:  checkCastReturn:    
3916#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
3920:instanceOf:
    # get object, go return false if null
3920#    lw $t2,($sp)
3924#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
3928#    lw $t2,-12($t2) # vtable address
3932#    sge $t0,$t2,$t0 # are we >= the lower limit?
3933##...slt $t0,$t2,$t0
3937##...xori $t0,$t0,0x1
3940#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
3944#    and $t2,$t0,$t1
3948#    sw $t2,($sp)
3952:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
3952#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

3956:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
3956#    li $v0,4 # syscall-code for print-string
3960#    syscall
3964:exit:
    # print termination message
3964#    li $v0,4 # syscall-code for print-string
3968#    la $a0,exitString
3972#    syscall

    # print number of garbage collections
3976#    li $v0,4 # syscall-code for print-string
3980#    la $a0,gcCountMsg
3984#    syscall # print "Number of ..."
3988#    lw $a0,gcCount # number of GC's
3992#    li $v0,1 # code for print-int
3996#    syscall
4000#    li $v0,4 # syscall-code for print-string
4004#    la $a0,newlineString
4008#    syscall # print newline

    # terminate execution
4012#    li $v0,10 #syscall-code for "exit"
4016#    syscall

4020:outOfHeapMemory:
4020#    la $a0,heapMemoryMsg
4024#    j exitError
4028:divByZeroError:
4028#    la $a0,divByZeroMsg
4032#    j exitError
4036:strIndexOutOfBounds:
4036#    la $a0,strIndexOutOfBoundsMsg
4040#    j exitError
4044:arrayIndexOutOfBounds:
4044#    la $a0,arrayIndexOutOfBoundsMsg
4048#    j exitError
4052:arraySizeOutOfBounds:
4052#    la $a0,arraySizeOutOfBoundsMsg
4056#    j exitError
4060:nullPtrException:
4060#    la $a0,nullPtrExceptionMsg
4064#    j exitError
4068:badIntegerFormat:
4068#    la $a0,badIntegerFormatMsg
4072#    j exitError
4076:castException:
4076#    la $a0,castExceptionMsg
4080#    j exitError
############## data section ################
    .data
4328:hexChars:
    .ascii "0123456789abcdef"
    .align 2
4344:cur_seg:
    .word 0

4348:lastCharRead:
    .word -2 # -2 => no buffered character
4352:prevHashConstant:
    .word 0x2785173c
4356:gcCount:
    .word 0

4360:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
4387:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
4410:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
4445:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
4479:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
4512:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
4543:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
4591:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
4612:gcMsg: 
      .asciiz "\nGC!\n"
4618:gcCountMsg: 
      .asciiz "Number of garbage collections: "

4650:nullStr:
    .asciiz "null"
4655:trueString:
    .asciiz "true"
4660:falseString:
    .asciiz "false"
4666:exitString:
    .ascii "Program execution completed."
    #### "falls through" here
4694:newlineString:
    .asciiz "\n"
    
    .align 2
4696:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

4700:seg0_start:
    .space 0x100000
1053276:seg0_end:
1053276:seg1_start:
    .space 0x100000
2101852:seg1_end:
