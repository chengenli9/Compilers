########################################################
# str.substring(n, k) - library method (class String)
# takes a substring of a string: Java: str.substring(n, k)
# - parameters after pushing RA:
#   - ($sp) - k: one beyond index of last char in subrange
#   - 4($sp) - GC tag
#   - 8($sp) - n: index of first char in subrange
#   - 12($sp) - GC tag
#   - 16($sp) - old this pointer
# - return value:
#  - $t0 - substring
########################################################
1512:mth_substring_String:

    # save $ra by pushing onto stack
1512#    subu $sp,$sp,4
1516#    sw $ra,($sp)

    # get string from this, we probably don't need the null check.
1520#    move $t0,$s2
1524#    beq $t0,$zero,nullPtrException

    # get both indices and string length, and ensure that
    #   0 <= n <= k <= length
1528#    lw $t0,-4($t0) # negative of string length
1532#    subu $t0,$zero,$t0 # string length
1536#    lw $t1,4($sp) # k
1540#    lw $t2,12($sp) # n
1544#    bgt $zero,$t2,strIndexOutOfBounds
1545##...slt $at,$t2,$zero
1549##...bne $at,$zero,3472
1552#    bgt $t2,$t1,strIndexOutOfBounds
1553##...slt $at,$t1,$t2
1557##...bne $at,$zero,3472
1560#    bgt $t1,$t0,strIndexOutOfBounds
1561##...slt $at,$t0,$t1
1565##...bne $at,$zero,3472

    # allocate memory
1568#    subu $s6,$t1,$t2 # # chars in target-string
1572#    addu $s6,$s6,7 # account for extra "class" (4) word + 3 to round up
1576#    srl $s6,$s6,2 # convert bytes-count to word-count
1580#    move $s7,$zero # (no object-bytes in string)
1584#    jal newObject

    # store "String" tag in object-type field
1588#    la $t0,CLASS_String
1592#    sw $t0,-12($s7)
    
    # mask off hash bits, if needed
1596#    lw $t4,-8($s7) # data words in source string
1600#    bge $t4,$zero,skipMask_substring # don't strip hash code if not there
1601##...slt $at,$t4,$zero
1605##...beq $at,$zero,1624
1608#    and $t4,0xff # mask off object's hash value ...
1609##...lui $at,0
1613##...ori $at,$at,0xff
1617##...and $t4,$t4,$at
1620#    sw $t4,-8($s7) # ... and store back into -8 header-word
1624:skipMask_substring:

    # store negative of count (=n-k) into object-length header-word
    # indicies have changed, because newObject is on stack
1624#    lw $t1,8($sp) # k
1628#    lw $t2,16($sp) # n
1632#    subu $t0,$t2,$t1 # value to store
1636#    sw $t0,-4($s7) # store value
    
1640#    move $t3,$s2 # source string pointer
    
    # skip byte-copy loop if length is zero
1644#    beq $zero,$t0,doneSubCopyzz

    # get pointers set up in preparation for copy
1648#    lw $t4,-8($t3) # data words in source string
1652#    sll $t4,$t4,2 # data bytes in source string (incl. padding)
1656#    subu $t3,$t3,$t4 # addr. of first data word of source string (+8)
1660#    addu $t3,$t3,$t2 # addr. of first source data byte to be copied (+8)
1664#    subu $t1,$t3,$t0 # addr. beyond last source data byte to be copied (+8)
1668#    lw $t2,-8($s7)   # data words in target string
1672#    sll $t2,$t2,2    # data bytes in target string
1676#    subu $t2,$s7,$t2 # addr. of first target data byte (+8)
    
    ############################################
    # at this point:
    # - we know that the string has a positive length
    # - $t3 contains 8 + address of the first source-byte
    # - $t1 contains 8 + limit-address of the first source-byte
    # - $t2 contains 8 + address first target byte
