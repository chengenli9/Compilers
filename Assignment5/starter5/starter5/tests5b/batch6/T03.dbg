3352#    move $t7,$s4
3356#    la $t6,seg1_start
3357##...lui $t6,16
3361##...addiu $t6,$t6,4808
3364#    la $s3,seg0_start
3368#    la $s4,seg0_end
3369##...lui $s4,16
3373##...addiu $s4,$s4,4808
3376#    sw $zero,cur_seg
3380#    bne $t0,$zero,skipGc1
3384#    la $t6,seg0_start
3388#    la $s3,seg1_start
3389##...lui $s3,16
3393##...addiu $s3,$s3,4808
3396#    la $s4,seg1_end
3397##...lui $s4,32
3401##...addiu $s4,$s4,4808
3404#    sw $s5,cur_seg
3408:  skipGc1:
3408#    li $t5,0x80000000
3412#    lw $t0,stack_bottom
3416#    subu $t0,4


    ###############################################################
    # at this point:
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first address of the target space
    # - $s4 contains the limit address of the target space
    # - cur_seg has been updated to refer to the target space
    # - $t0 contains the address of the deepest stack element
    # - $sp contains the address of the top stack element
    # - $s2 is available for use, having been pushed onto the stack
    # - $t5 contains the value 0x80000000
    ###############################################################

    ###### begin outer loop to copy all stack-direct objects ######

3420:  gcStackCopyLoop:
3420#    lw $t1,($t0) # current stack element

    # test if we have a GC tag
3424#    sll $t2,$t1,31 # zero iff low bit was zero
3428#    bne $t2,$zero,gcBump # go skip data values if low bit not zero

    # bump stack-address pointer
3432#    subu $t0,$t0,4
