##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
216:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
216#    lw $t0,-8($s2) # get word with hash bits from this
220#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
224#    addu $t0,$t1

228#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
232:mth_equals_Object:
232#    move $t0,$s2 # first pointer (this)
236#    lw $t1,($sp) # second pointer
240#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
241##...subu $at,$t0,$t1
245##...sltiu $t0,$at,1

248#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
252:mth_hashCode_String:
252#    move $t0,$s2 # put this pointer in t0

256#    li $t2,0 # current hash value
260#    lw $t1,-4($t0) # negative of number of characters in string
264#    beq $t1,$zero,done_hashCode_String # if zero length => done
268#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
272#    and $t0,0xfffffffc # adjust for padding
273##...lui $at,65535
277##...ori $at,$at,0xfffc
281##...and $t0,$t0,$at
284#    subu $t1,$t0,$t1 # address at end of string +12
288:loop_hashCode_String:    
288#    sll $t4,$t2,5 # multiply by 32
292#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
296#    lbu $t3,-12($t0) # current character
300#    addu $t2,$t3 # add in current character
304#    addu $t0,1 # go to next character's address
308#    bne $t0,$t1,loop_hashCode_String # loop back if more
312:done_hashCode_String:    

    # push int on stack
312#    move $t0, $t2 # put $t2 in return slot
316#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
320:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
320#    subu $sp,4
324#    sw $ra,($sp)
    
    # get hash value
328#    lw $t2,-12($s2) # vtable address
332#    lw $t0,($t2) # method address
336#    jalr $t0
340#    subu $sp,8 # push result (int in $t0) on stack
344#    sw $s5,4($sp)
348#    sw $t0,($sp)

    # compute print-size of hash value
352#    li $t0, 1
356#    lw $t1, ($sp)
360#    srl $t1,$t1,4
364#    beq $t1,$zero,toString_skip_loop
368:toString_loop_top:
368#    addu $t0,1
372#    srl $t1,$t1,4
376#    bne $t1,$zero,toString_loop_top
380:toString_skip_loop:
380#    subu $sp,8
384#    sw $s5,4($sp)
388#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
392#    lw $t2,-12($s2) # vtable address
396#    move $t0,$t2
400:toString_checkTagBit:
400#    subu $t0,1
404#    lb $t1,($t0)
408#    and $t1,0x80
409##...lui $at,0
413##...ori $at,$at,0x80
417##...and $t1,$t1,$at
420#    beq $t1,$zero,toString_checkTagBit
424#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
428#    subu $sp,8
432#    sw $t1,($sp)
436#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
440#    move $s7,$zero # -4 offset header word
444#    lw $t4,8($sp) # bytes for hash value
448#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
452#    addu $t4,8
456#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
460#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

464#    li $t0,CLASS_String # store string vtable address into ...
468#    sw $t0,-12($s7) # ... -12 offset in object header
472#    lw $t2,-12($s2) # our object's vtable address
476#    lw $t5,4($sp) # number characters in prefix
480#    lw $t1,12($sp) # number of characters in hashcode
484#    addu $t3,$t1,$t5 # number of characters in string ...
488#    addu $t3,1 # ... including the '@' character
492#    subu $t0,$zero,$t3 # store negated length into ...
496#    sw $t0,-4($s7) # ... -4 offset header word
500#    lw $t0,-8($s7) # get -8 offset header-word
504#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
505##...slt $at,$t0,$zero
509##...beq $at,$zero,528
512#    and $t0,0xff # mask off object's hash value ...
513##...lui $at,0
517##...ori $at,$at,0xff
521##...and $t0,$t0,$at
524#    sw $t0,-8($s7) # ... and store back into -8 header-word
528:skipMask_toString:
528#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
532#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
536#    subu $t4,$t2,$t5
540:toString_copyLoop:    
540#    lb $t3,($t4)
544#    and $t3,0x7f # mask off sign bit (in case first word)
545##...lui $at,0
549##...ori $at,$at,0x7f
553##...and $t3,$t3,$at
556#    sb $t3,-8($t0)
560#    addu $t4,1
564#    addu $t0,1
568#    blt $t4,$t2,toString_copyLoop
569##...slt $at,$t4,$t2
573##...bne $at,$zero,540

    # copy the '@' sign
576#    li $t3,'@'
580#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
584#    addu $t2,$t0,$t1 # address of last byte in string to store +8
588#    lw $t3,20($sp) # hash code to print
592:toString_hashCopyLoop:
592#    and $t4,$t3,0xf
596#    srl $t3,4
600#    lb $t4,hexChars($t4)
604#    sb $t4,-8($t2)
608#    subu $t2,$t2,1
612#    bgt $t2,$t0,toString_hashCopyLoop
613##...slt $at,$t0,$t2
617##...bne $at,$zero,592

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
620#    addu $sp,28
624#    lw $ra,($sp)
628#    addu $sp,4
632#    move $t0, $s7 # return string we created
636#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
640:mth_equals_String:
    
    # quick test for obvious false
640#    lw $t0,($sp) # second parameter
644#    beq $t0,$zero,goEsFalse # go return false if null
648#    lw $t1,-12($t0) # vtable pointer
652#    la $t2,CLASS_String # string vtable pointer
656#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
660#    subu $sp,12
664#    sw $ra,8($sp)
668#    sw $s2,4($sp)
672#    sw $t0,($sp)
676#    jal mth_compareTo_String
680#    lw $s2, 4($sp) #restore this pointer and pop parameters
684#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
688#    seq $t0,$t0,$zero
689##...subu $at,$t0,$zero
693##...sltiu $t0,$at,1

    # pop return address and return $t0
696#    lw $ra,($sp)
700#    addu $sp,4

704#    jr $ra # return
    
708:goEsFalse:
    # put 0 in $t0 and return
708#    li $t0, 0
712#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
716:mth_toString_String:
    #we are a string, so return this.
716#    move $t0, $s2
720#    jr $ra

###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
724:mth_readLine_Lib:
    
724#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
728#    sw $ra, 4($sp) # save $ra
732#    move $t1,$sp # save "original" sp

736:  doRead:

    # read the character
736#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
740#    subu $t2,$v0,13
744#    bne $t2,$zero,notReturnRL
748#    jal readLogicalChar
752#    subu $t2,$v0,10 # check for newline
756#    beq $t2,$zero,foundNewLine
760#    sw $v0,lastCharRead # push back character into queue
764#    j foundNewLine # go process the line

768:  notReturnRL:

    # at this point, $v0 has our character

