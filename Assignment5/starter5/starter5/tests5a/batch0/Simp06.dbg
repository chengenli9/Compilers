3561:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
3595:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
3628:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
3659:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
3707:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
3728:gcMsg: 
      .asciiz "\nGC!\n"
3734:gcCountMsg: 
      .asciiz "Number of garbage collections: "

3766:nullStr:
    .asciiz "null"
3771:trueString:
    .asciiz "true"
3776:falseString:
    .asciiz "false"
3782:exitString:
    .ascii "Program execution completed."
    #### "falls through" here
3810:newlineString:
    .asciiz "\n"
    
    .align 2
3812:stack_bottom:
    .word 0
