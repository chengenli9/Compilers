6905##...beq $at,$zero,6716

    ###### end outer loop to copy all stack-direct objects ######

    #############################################################
    # We have finished processing the stack elements.  Now we need
    # to update elements in the heap itself. This may itself involve
    # moving additional objects
    #############################################################

    #########################################################
    # At this point:
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # We want to set things up so that in addition:
    # - $t0 is the "trailing finger", containing the address
    #   of the first slot in target space that we have yet
    #   to process.
    # Then during processing:
    # - $t1 will contain the contents of the heap slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # And when we're actually copying an object:
    # - $t2 will contain pointer to the target object
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - available for use: $s0
    ##########################################################

    # set $t0 to be at the beginning of target-space
6908#    lw $t1,cur_seg
6912#    la $t0,seg0_start
6916#    beq $t1,$zero,gcSkip4
6920#    la $t0,seg1_start
6921##...lui $t0,16
6925##...addiu $t0,$t0,8452


6928:  gcSkip4:

    # if there were no objects put into the heap during stack
    # processing, we're done, so go finish up
6928#    bgeu $t0,$s3,gcFinishUp
6929##...sltu $at,$t0,$s3
6933##...beq $at,$zero,7224

    ###### begin outer loop to copy all non-stack-direct objects ######

6936:  gcHeapCopyLoop:
    # get data count for object; swap header-word with first word
    # of object so that they're back in the right place
6936#    lw $t1,($t0) # (what will be) first header word for current object
6940#    move $t2,$t1 # number data bytes in object (poss. w/hash bits)
6944#    bge $t2,$zero,gcSkip4a # are there hash bits?
6945##...slt $at,$t2,$zero
6949##...beq $at,$zero,6964
6952#    and $t2,0xff # mask off hash bits
6953##...lui $at,0
6957##...ori $at,$at,0xff
6961##...and $t2,$t2,$at
6964:gcSkip4a:    
6964#    sll $t2,$t2,2 # # data bytes
6968#    addu $t2,$t2,8 # to skip header words
6972#    addu $t2,$t0,$t2 # pointer to new object
6976#    lw $t3,-8($t2) # word to swap
6980#    sw $t1,-8($t2) # store header word
6984#    sw $t3,($t0) # restore first word of object

    ################################################
    # at this point:
    # - $t2 contains the pointer to our new object
    ################################################

    # check if we have a data array
6988#    lw $t1,-12($t2) # vtable pointer
6992#    li $t0,dataArrayVTableStart # address of vtable for first data array
6996#    blt $t1,$t0,gcNotDataArray # if data array, no more xforming to do
6997##...slt $at,$t1,$t0
7001##...bne $at,$zero,7020

    # We have a vtable address that is a data array.
    # we need skip over it then loop back to do next object.
7004:  skipToNextObj:
7004#    lw $t1,-4($t2) # data words in (object position of) array
    #### note: we know that it's not a string, so the value will
    #### not be artificially negative
7008#    sll $t1,$t1,2 # convert to byte-count
7012#    addu $t0,$t2,$t1 # skip over object
7016#    j gcTestIterDone2 # go do next object, if any

    ###################################################
    # at this point:
    # - the object has been restored to normal status--that is, the
    #   word-swap has been done
    # - $t2 contains a pointer to the object
    ###################################################
    
7020:  gcNotDataArray:
7020#    lw $t3,-4($t2) # # object words (negative treated as zero)
7024#    bge $t3,$zero,gcH2Neg2
7025##...slt $at,$t3,$zero
7029##...beq $at,$zero,7036
7032#    move $t3,$zero
7036:  gcH2Neg2:
7036#    sll $t3,$t3,2 # # object bytes
7040#    move $t0,$t2 # address of first pointer in object
7044#    add $s1,$t2,$t3 # limit address for this object

    #####################################################
    # At this point, we have to "translate" all pointers,
    # starting at $t0 to (but not including) $s1
    #####################################################

    # if there are no pointer-slots (i.e., $t0=$s1), skip this
    # part
7048#    beq $t0,$s1,gcTestIterDone2
    
7052:  gcNextPointerInObject:
    # get pointer from object
7052#    lw $t1,($t0)

    # if value is out of range, and is therefore does not refer
    # to an object, just go loop back and do the next one
7056#    bleu $t1,$t6,gcGoNextPointerSlot
7057##...sltu $at,$t6,$t1
7061##...beq $at,$zero,7204
7064#    bgtu $t1,$t7,gcGoNextPointerSlot
7065##...sltu $at,$t7,$t1
7069##...bne $at,$zero,7204

    # if the object has already been moved, update the stack-value
    # via the forwarding pointer
7072#    lw $t8,-8($t1) # possible forwarding tag
7076#    bne $t8,$zero,gcNoForward2 # if not forwarding tag, go copy
7080#    lw $t8,-4($t1) # forwarding pointer: object's new address
7084#    sw $t8,($t0) # update pointer in object
7088#    j gcGoNextPointerSlot # do next iteration

7092:  gcNoForward2:
    #########################################################
    # we actually need to copy the object into the new space
    #########################################################

    #########################################################
    # At this point:
    # - $t0 contains the address of the heap-slot we're translating
    # - $t1 will contain the contents of the heap-slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space, which will also be the first address
    #   of the target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # Then during processing:
    # And when we're actually copying an object:
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $t8 will contain a pointer to the target object
    # - available for use: $s0, $t8, $t9
    ##########################################################

    # compute the amount of space that is needed
7092#    bge $t8,$zero,gcSkip5 # # words in negative-offset portion
7093##...slt $at,$t8,$zero
7097##...beq $at,$zero,7112
7100#    and $t8,0xff # mask off hash bits
7101##...lui $at,0
7105##...ori $at,$at,0xff
7109##...and $t8,$t8,$at

7112:  gcSkip5:
7112#    sll $t8,$t8,2 # bytes in negative-offset portion ...
7116#    addu $t8,$t8,8 # ... add in bytes for header-words
7120#    subu $t4,$t1,$t8 # address of first word of source object
7124#    lw $t3,-4($t1) # # words in positive-offset portion
7128#    bge $t3,$zero,gcNoNeg
7129##...slt $at,$t3,$zero
7133##...beq $at,$zero,7140
7136#    move $t3,$zero # negative treated as zero
7140:  gcNoNeg:
7140#    sll $t3,$t3,2 # bytes in negative-offset portion
7144#    addu $t3,$t3,$t1 # address one word past last word of source

7148#    addu $t8,$s3,$t8 # pointer to target object

    #########################################################
    # At this point:
    # - $t0 contains the address of the stack slot we'll
    #   process next
    # - $t1 contains the contents of the stack slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $t8 contains the pointer to the target object
    # - $s1 contains the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0, $t9
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger"
7152#    lw $s0,($t4)
7156#    lw $t9,-8($t1)
7160#    sw $t9,($t4)
7164#    sw $s0,-8($t1)

    # copy all source bytes to the target
7168:  gCinnerCopy2:
7168#    lw $s0,($t4)
7172#    sw $s0,($s3)
7176#    addu $t4,$t4,4
7180#    addu $s3,$s3,4
7184#    bltu $t4,$t3,gCinnerCopy2
7185##...sltu $at,$t4,$t3
7189##...bne $at,$zero,7168

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
7192#    sw $zero,-8($t1) # 0 in first header-slot
7196#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
7200#    sw $t8,($t0)

7204:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
7204#    addu $t0,$t0,4
7208#    bltu $t0,$s1,gcNextPointerInObject
7209##...sltu $at,$t0,$s1
7213##...bne $at,$zero,7052

7216:  gcTestIterDone2:
7216#    bltu $t0,$s3,gcHeapCopyLoop
7217##...sltu $at,$t0,$s3
7221##...bne $at,$zero,6936

    ###### end outer loop to copy all non-stack-direct objects ######

7224:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
7224#    lw $s2,($sp)
7228#    addu $sp,$sp,4

    # mark us as having already GC'd
7232#    move $t5,$s5

    # go try and allocate again
7236#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
7240:vm_init:

    # mark bottom of stack
7240#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
7244#    move $s2,$zero

    #set up the "five" register
7248#    li $s5,5

7252#    la $s3,seg0_start
7256#    la $s4,seg0_end
7257##...lui $s4,16
7261##...addiu $s4,$s4,8452
    
    # return
7264#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
7268:divide:
    # get parameters; abort if divisor zero
7268#    lw $t0,($sp)
7272#    lw $t1,8($sp)
7276#    beq $t0,$zero,divByZeroError
    
    # perform division
7280#    div $t1,$t0
7284#    mflo $t0

    # store result, adjust stack and return
7288#    addu $sp,$sp,8 # adjust stack
7292#    sw $t0,($sp) # store result
7296#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
7300:remainder:
    # get parameters; abort if divisor zero
7300#    lw $t0,($sp)
7304#    lw $t1,8($sp)
7308#    beq $t0,$zero,divByZeroError
    
    # perform division
7312#    div $t1,$t0
7316#    mfhi $t0

    # store result, adjust stack and return
7320#    addu $sp,$sp,8 # adjust stack
7324#    sw $t0,($sp) # store result
7328#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
7332:checkCast:
    # get object, allow immediately if null
7332#    lw $t2,($sp)
7336#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
7340#    lw $t2,-12($t2) # vtable address
7344#    bge $t2,$t1,castException
7345##...slt $at,$t2,$t1
7349##...beq $at,$zero,7484
7352#    blt $t2,$t0,castException
7353##...slt $at,$t2,$t0
7357##...bne $at,$zero,7484
    
    # return, leaving object unchanged on stack
7360:  checkCastReturn:    
7360#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
7364:instanceOf:
    # get object, go return false if null
7364#    lw $t2,($sp)
7368#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
7372#    lw $t2,-12($t2) # vtable address
7376#    sge $t0,$t2,$t0 # are we >= the lower limit?
7377##...slt $t0,$t2,$t0
7381##...xori $t0,$t0,0x1
7384#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
7388#    and $t2,$t0,$t1
7392#    sw $t2,($sp)
7396:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
7396#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

7400:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
7400#    li $v0,4 # syscall-code for print-string
7404#    syscall
7408:exit:
    # print termination message
7408#    li $v0,4 # syscall-code for print-string
7412#    la $a0,exitString
7416#    syscall

    # terminate execution
7420#    li $v0,10 #syscall-code for "exit"
7424#    syscall

7428:outOfHeapMemory:
7428#    la $a0,heapMemoryMsg
7432#    j exitError
7436:divByZeroError:
7436#    la $a0,divByZeroMsg
7440#    j exitError
7444:strIndexOutOfBounds:
7444#    la $a0,strIndexOutOfBoundsMsg
7448#    j exitError
7452:arrayIndexOutOfBounds:
7452#    la $a0,arrayIndexOutOfBoundsMsg
7456#    j exitError
7460:arraySizeOutOfBounds:
7460#    la $a0,arraySizeOutOfBoundsMsg
7464#    j exitError
7468:nullPtrException:
7468#    la $a0,nullPtrExceptionMsg
7472#    j exitError
7476:badIntegerFormat:
7476#    la $a0,badIntegerFormatMsg
7480#    j exitError
7484:castException:
7484#    la $a0,castExceptionMsg
7488#    j exitError
############## data section ################
    .data
8088:hexChars:
    .ascii "0123456789abcdef"
    .align 2
8104:cur_seg:
    .word 0

8108:lastCharRead:
    .word -2 # -2 => no buffered character
8112:prevHashConstant:
    .word 0x2785173c
8116:gcCount:
    .word 0

8120:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
8147:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
8170:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
8205:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
8239:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
8272:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
8303:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
8351:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
8372:gcMsg: 
      .asciiz "\nGC!\n"
8378:gcCountMsg: 
      .asciiz "Number of garbage collections: "

8410:nullStr:
    .asciiz "null"
8415:trueString:
    .asciiz "true"
8420:falseString:
    .asciiz "false"
8426:exitString:
    .ascii "Program terminated."
    #### "falls through" here
8445:newlineString:
    .asciiz "\n"
    
    .align 2
8448:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

8452:seg0_start:
    .space 0x100000
1057028:seg0_end:
1057028:seg1_start:
    .space 0x100000
2105604:seg1_end:
