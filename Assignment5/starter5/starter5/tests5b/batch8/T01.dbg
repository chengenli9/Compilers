3141##...slt $at,$zero,$t0
3145##...bne $at,$zero,3188
3148#    beq $t0,$zero,riSkipWhiteLoop # start over if space
3152#    subu $t0,$v0,10
3156#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
3160#    subu $t0,$v0,9
3164#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
3168#    subu $t0,$v0,13
3172#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
3176#    subu $t0,$v0,12
3180#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
3184#    j badIntegerFormat # illegal integer char: abort program

3188:  nonWhite:
3188#    subu $t0,$v0,'-'
3192#    li $t4,1 # final multiplier
3196#    bne $t0,$zero,helpReadInt # go read
3200#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
3204#    jal readLogicalChar

3208:  helpReadInt:
3208#    li $t2,10
3212#    subu $t1,$v0,'0' # convert digit to 0-9 value
