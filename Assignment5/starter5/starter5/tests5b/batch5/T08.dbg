#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1788:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
1788#    lw $t0,-8($s2) # get word with hash bits from this
1792#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
1796#    addu $t0,$t1

1800#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1804:mth_equals_Object:
1804#    move $t0,$s2 # first pointer (this)
1808#    lw $t1,($sp) # second pointer
1812#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
1813##...subu $at,$t0,$t1
1817##...sltiu $t0,$at,1

1820#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1824:mth_hashCode_String:
1824#    move $t0,$s2 # put this pointer in t0

1828#    li $t2,0 # current hash value
1832#    lw $t1,-4($t0) # negative of number of characters in string
1836#    beq $t1,$zero,done_hashCode_String # if zero length => done
1840#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
1844#    and $t0,0xfffffffc # adjust for padding
1845##...lui $at,65535
1849##...ori $at,$at,0xfffc
1853##...and $t0,$t0,$at
1856#    subu $t1,$t0,$t1 # address at end of string +12
1860:loop_hashCode_String:    
1860#    sll $t4,$t2,5 # multiply by 32
1864#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
1868#    lbu $t3,-12($t0) # current character
1872#    addu $t2,$t3 # add in current character
1876#    addu $t0,1 # go to next character's address
1880#    bne $t0,$t1,loop_hashCode_String # loop back if more
1884:done_hashCode_String:    

    # push int on stack
1884#    move $t0, $t2 # put $t2 in return slot
1888#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
1892:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
1892#    subu $sp,4
1896#    sw $ra,($sp)
    
    # get hash value
1900#    lw $t2,-12($s2) # vtable address
1904#    lw $t0,($t2) # method address
1908#    jalr $t0
1912#    subu $sp,8 # push result (int in $t0) on stack
1916#    sw $s5,4($sp)
1920#    sw $t0,($sp)

    # compute print-size of hash value
1924#    li $t0, 1
1928#    lw $t1, ($sp)
1932#    srl $t1,$t1,4
1936#    beq $t1,$zero,toString_skip_loop
1940:toString_loop_top:
1940#    addu $t0,1
1944#    srl $t1,$t1,4
1948#    bne $t1,$zero,toString_loop_top
1952:toString_skip_loop:
1952#    subu $sp,8
1956#    sw $s5,4($sp)
1960#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
1964#    lw $t2,-12($s2) # vtable address
1968#    move $t0,$t2
1972:toString_checkTagBit:
1972#    subu $t0,1
1976#    lb $t1,($t0)
1980#    and $t1,0x80
1981##...lui $at,0
1985##...ori $at,$at,0x80
1989##...and $t1,$t1,$at
1992#    beq $t1,$zero,toString_checkTagBit
1996#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
2000#    subu $sp,8
2004#    sw $t1,($sp)
2008#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
2012#    move $s7,$zero # -4 offset header word
2016#    lw $t4,8($sp) # bytes for hash value
2020#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
2024#    addu $t4,8
2028#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
2032#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

2036#    li $t0,CLASS_String # store string vtable address into ...
2040#    sw $t0,-12($s7) # ... -12 offset in object header
2044#    lw $t2,-12($s2) # our object's vtable address
2048#    lw $t5,4($sp) # number characters in prefix
2052#    lw $t1,12($sp) # number of characters in hashcode
2056#    addu $t3,$t1,$t5 # number of characters in string ...
2060#    addu $t3,1 # ... including the '@' character
2064#    subu $t0,$zero,$t3 # store negated length into ...
2068#    sw $t0,-4($s7) # ... -4 offset header word
2072#    lw $t0,-8($s7) # get -8 offset header-word
2076#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
2077##...slt $at,$t0,$zero
2081##...beq $at,$zero,2100
2084#    and $t0,0xff # mask off object's hash value ...
2085##...lui $at,0
2089##...ori $at,$at,0xff
2093##...and $t0,$t0,$at
2096#    sw $t0,-8($s7) # ... and store back into -8 header-word
2100:skipMask_toString:
2100#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
2104#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
2108#    subu $t4,$t2,$t5
2112:toString_copyLoop:    
2112#    lb $t3,($t4)
2116#    and $t3,0x7f # mask off sign bit (in case first word)
2117##...lui $at,0
2121##...ori $at,$at,0x7f
2125##...and $t3,$t3,$at
2128#    sb $t3,-8($t0)
2132#    addu $t4,1
2136#    addu $t0,1
2140#    blt $t4,$t2,toString_copyLoop
2141##...slt $at,$t4,$t2
2145##...bne $at,$zero,2112

    # copy the '@' sign
2148#    li $t3,'@'
2152#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
2156#    addu $t2,$t0,$t1 # address of last byte in string to store +8
2160#    lw $t3,20($sp) # hash code to print
2164:toString_hashCopyLoop:
2164#    and $t4,$t3,0xf
2168#    srl $t3,4
2172#    lb $t4,hexChars($t4)
2176#    sb $t4,-8($t2)
2180#    subu $t2,$t2,1
2184#    bgt $t2,$t0,toString_hashCopyLoop
2185##...slt $at,$t0,$t2
2189##...bne $at,$zero,2164

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
2192#    addu $sp,28
2196#    lw $ra,($sp)
2200#    addu $sp,4
2204#    move $t0, $s7 # return string we created
2208#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
2212:mth_equals_String:
    
    # quick test for obvious false
2212#    lw $t0,($sp) # second parameter
2216#    beq $t0,$zero,goEsFalse # go return false if null
2220#    lw $t1,-12($t0) # vtable pointer
2224#    la $t2,CLASS_String # string vtable pointer
2228#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
2232#    subu $sp,12
2236#    sw $ra,8($sp)
2240#    sw $s2,4($sp)
2244#    sw $t0,($sp)
2248#    jal mth_compareTo_String
2252#    lw $s2, 4($sp) #restore this pointer and pop parameters
2256#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
2260#    seq $t0,$t0,$zero
2261##...subu $at,$t0,$zero
2265##...sltiu $t0,$at,1

    # pop return address and return $t0
2268#    lw $ra,($sp)
2272#    addu $sp,4

2276#    jr $ra # return
    
2280:goEsFalse:
    # put 0 in $t0 and return
2280#    li $t0, 0
2284#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
2288:mth_toString_String:
    #we are a string, so return this.
2288#    move $t0, $s2
2292#    jr $ra

###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
2296:mth_readLine_Lib:
    
2296#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
2300#    sw $ra, 4($sp) # save $ra
2304#    move $t1,$sp # save "original" sp

2308:  doRead:

    # read the character
2308#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
2312#    subu $t2,$v0,13
2316#    bne $t2,$zero,notReturnRL
2320#    jal readLogicalChar
2324#    subu $t2,$v0,10 # check for newline
2328#    beq $t2,$zero,foundNewLine
2332#    sw $v0,lastCharRead # push back character into queue
2336#    j foundNewLine # go process the line

2340:  notReturnRL:

    # at this point, $v0 has our character

2340#    subu $t0,$v0,10
2344#    beq $t0,$zero,foundNewLine
2348#    blt $v0,$zero,foundEof
2349##...slt $at,$v0,$zero
2353##...bne $at,$zero,2368

    # we have a character, so push it onto stack
2356#    subu $sp,$sp,4
2360#    sw $v0,($sp)

    # loop back up to get next character
2364#    j doRead

2368:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
2368#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
2372#    li $s7, 0 # return-value: null
2376#    j rlReturn # return

2380:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
