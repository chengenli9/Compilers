##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
460:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
460#    lw $t0,-8($s2) # get word with hash bits from this
464#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
468#    addu $t0,$t1

472#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
476:mth_equals_Object:
476#    move $t0,$s2 # first pointer (this)
480#    lw $t1,($sp) # second pointer
484#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
485##...subu $at,$t0,$t1
489##...sltiu $t0,$at,1

492#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
496:mth_hashCode_String:
496#    move $t0,$s2 # put this pointer in t0

500#    li $t2,0 # current hash value
504#    lw $t1,-4($t0) # negative of number of characters in string
508#    beq $t1,$zero,done_hashCode_String # if zero length => done
512#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
516#    and $t0,0xfffffffc # adjust for padding
517##...lui $at,65535
521##...ori $at,$at,0xfffc
525##...and $t0,$t0,$at
528#    subu $t1,$t0,$t1 # address at end of string +12
532:loop_hashCode_String:    
532#    sll $t4,$t2,5 # multiply by 32
536#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
540#    lbu $t3,-12($t0) # current character
544#    addu $t2,$t3 # add in current character
548#    addu $t0,1 # go to next character's address
552#    bne $t0,$t1,loop_hashCode_String # loop back if more
556:done_hashCode_String:    

    # push int on stack
556#    move $t0, $t2 # put $t2 in return slot
560#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
564:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
564#    subu $sp,4
568#    sw $ra,($sp)
    
    # get hash value
572#    lw $t2,-12($s2) # vtable address
576#    lw $t0,($t2) # method address
580#    jalr $t0
584#    subu $sp,8 # push result (int in $t0) on stack
588#    sw $s5,4($sp)
592#    sw $t0,($sp)

    # compute print-size of hash value
596#    li $t0, 1
600#    lw $t1, ($sp)
604#    srl $t1,$t1,4
608#    beq $t1,$zero,toString_skip_loop
612:toString_loop_top:
612#    addu $t0,1
616#    srl $t1,$t1,4
620#    bne $t1,$zero,toString_loop_top
624:toString_skip_loop:
624#    subu $sp,8
628#    sw $s5,4($sp)
632#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
636#    lw $t2,-12($s2) # vtable address
640#    move $t0,$t2
644:toString_checkTagBit:
644#    subu $t0,1
648#    lb $t1,($t0)
652#    and $t1,0x80
653##...lui $at,0
657##...ori $at,$at,0x80
661##...and $t1,$t1,$at
664#    beq $t1,$zero,toString_checkTagBit
668#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
672#    subu $sp,8
676#    sw $t1,($sp)
680#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
684#    move $s7,$zero # -4 offset header word
688#    lw $t4,8($sp) # bytes for hash value
692#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
696#    addu $t4,8
700#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
704#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

708#    li $t0,CLASS_String # store string vtable address into ...
712#    sw $t0,-12($s7) # ... -12 offset in object header
716#    lw $t2,-12($s2) # our object's vtable address
720#    lw $t5,4($sp) # number characters in prefix
724#    lw $t1,12($sp) # number of characters in hashcode
728#    addu $t3,$t1,$t5 # number of characters in string ...
732#    addu $t3,1 # ... including the '@' character
736#    subu $t0,$zero,$t3 # store negated length into ...
740#    sw $t0,-4($s7) # ... -4 offset header word
744#    lw $t0,-8($s7) # get -8 offset header-word
748#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
749##...slt $at,$t0,$zero
753##...beq $at,$zero,772
756#    and $t0,0xff # mask off object's hash value ...
757##...lui $at,0
761##...ori $at,$at,0xff
765##...and $t0,$t0,$at
768#    sw $t0,-8($s7) # ... and store back into -8 header-word
772:skipMask_toString:
772#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
776#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
780#    subu $t4,$t2,$t5
784:toString_copyLoop:    
784#    lb $t3,($t4)
788#    and $t3,0x7f # mask off sign bit (in case first word)
789##...lui $at,0
