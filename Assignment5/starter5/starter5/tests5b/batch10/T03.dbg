##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
396:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
396#    lw $t0,-8($s2) # get word with hash bits from this
400#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
404#    addu $t0,$t1

408#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
412:mth_equals_Object:
412#    move $t0,$s2 # first pointer (this)
416#    lw $t1,($sp) # second pointer
420#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
421##...subu $at,$t0,$t1
425##...sltiu $t0,$at,1

428#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
432:mth_hashCode_String:
432#    move $t0,$s2 # put this pointer in t0

436#    li $t2,0 # current hash value
440#    lw $t1,-4($t0) # negative of number of characters in string
444#    beq $t1,$zero,done_hashCode_String # if zero length => done
448#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
452#    and $t0,0xfffffffc # adjust for padding
453##...lui $at,65535
457##...ori $at,$at,0xfffc
461##...and $t0,$t0,$at
464#    subu $t1,$t0,$t1 # address at end of string +12
468:loop_hashCode_String:    
468#    sll $t4,$t2,5 # multiply by 32
472#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
476#    lbu $t3,-12($t0) # current character
480#    addu $t2,$t3 # add in current character
484#    addu $t0,1 # go to next character's address
488#    bne $t0,$t1,loop_hashCode_String # loop back if more
492:done_hashCode_String:    

    # push int on stack
492#    move $t0, $t2 # put $t2 in return slot
496#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
500:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
500#    subu $sp,4
504#    sw $ra,($sp)
    
    # get hash value
508#    lw $t2,-12($s2) # vtable address
512#    lw $t0,($t2) # method address
516#    jalr $t0
520#    subu $sp,8 # push result (int in $t0) on stack
524#    sw $s5,4($sp)
528#    sw $t0,($sp)

    # compute print-size of hash value
532#    li $t0, 1
536#    lw $t1, ($sp)
540#    srl $t1,$t1,4
544#    beq $t1,$zero,toString_skip_loop
548:toString_loop_top:
548#    addu $t0,1
552#    srl $t1,$t1,4
556#    bne $t1,$zero,toString_loop_top
560:toString_skip_loop:
560#    subu $sp,8
564#    sw $s5,4($sp)
568#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
572#    lw $t2,-12($s2) # vtable address
576#    move $t0,$t2
580:toString_checkTagBit:
580#    subu $t0,1
584#    lb $t1,($t0)
588#    and $t1,0x80
589##...lui $at,0
593##...ori $at,$at,0x80
597##...and $t1,$t1,$at
600#    beq $t1,$zero,toString_checkTagBit
604#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
608#    subu $sp,8
612#    sw $t1,($sp)
616#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
620#    move $s7,$zero # -4 offset header word
624#    lw $t4,8($sp) # bytes for hash value
628#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
632#    addu $t4,8
636#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
640#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

644#    li $t0,CLASS_String # store string vtable address into ...
648#    sw $t0,-12($s7) # ... -12 offset in object header
652#    lw $t2,-12($s2) # our object's vtable address
656#    lw $t5,4($sp) # number characters in prefix
660#    lw $t1,12($sp) # number of characters in hashcode
664#    addu $t3,$t1,$t5 # number of characters in string ...
668#    addu $t3,1 # ... including the '@' character
672#    subu $t0,$zero,$t3 # store negated length into ...
676#    sw $t0,-4($s7) # ... -4 offset header word
680#    lw $t0,-8($s7) # get -8 offset header-word
684#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
685##...slt $at,$t0,$zero
689##...beq $at,$zero,708
692#    and $t0,0xff # mask off object's hash value ...
693##...lui $at,0
697##...ori $at,$at,0xff
701##...and $t0,$t0,$at
704#    sw $t0,-8($s7) # ... and store back into -8 header-word
708:skipMask_toString:
708#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
712#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
716#    subu $t4,$t2,$t5
720:toString_copyLoop:    
720#    lb $t3,($t4)
724#    and $t3,0x7f # mask off sign bit (in case first word)
725##...lui $at,0
729##...ori $at,$at,0x7f
733##...and $t3,$t3,$at
736#    sb $t3,-8($t0)
740#    addu $t4,1
744#    addu $t0,1
748#    blt $t4,$t2,toString_copyLoop
749##...slt $at,$t4,$t2
753##...bne $at,$zero,720

    # copy the '@' sign
756#    li $t3,'@'
760#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
764#    addu $t2,$t0,$t1 # address of last byte in string to store +8
768#    lw $t3,20($sp) # hash code to print
772:toString_hashCopyLoop:
772#    and $t4,$t3,0xf
776#    srl $t3,4
780#    lb $t4,hexChars($t4)
784#    sb $t4,-8($t2)
788#    subu $t2,$t2,1
792#    bgt $t2,$t0,toString_hashCopyLoop
793##...slt $at,$t0,$t2
797##...bne $at,$zero,772

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
800#    addu $sp,28
804#    lw $ra,($sp)
808#    addu $sp,4
812#    move $t0, $s7 # return string we created
816#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
820:mth_equals_String:
    
    # quick test for obvious false
820#    lw $t0,($sp) # second parameter
824#    beq $t0,$zero,goEsFalse # go return false if null
828#    lw $t1,-12($t0) # vtable pointer
832#    la $t2,CLASS_String # string vtable pointer
836#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
840#    subu $sp,12
844#    sw $ra,8($sp)
848#    sw $s2,4($sp)
852#    sw $t0,($sp)
856#    jal mth_compareTo_String
860#    lw $s2, 4($sp) #restore this pointer and pop parameters
864#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
868#    seq $t0,$t0,$zero
869##...subu $at,$t0,$zero
873##...sltiu $t0,$at,1

    # pop return address and return $t0
