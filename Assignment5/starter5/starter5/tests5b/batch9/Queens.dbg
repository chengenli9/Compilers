########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
6320:vm_init:

    # mark bottom of stack
6320#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
6324#    move $s2,$zero

    #set up the "five" register
6328#    li $s5,5

6332#    la $s3,seg0_start
6336#    la $s4,seg0_end
6337##...lui $s4,16
6341##...addiu $s4,$s4,7216
    
    # return
6344#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
6348:divide:
    # get parameters; abort if divisor zero
6348#    lw $t0,($sp)
6352#    lw $t1,8($sp)
6356#    beq $t0,$zero,divByZeroError
    
    # perform division
6360#    div $t1,$t0
6364#    mflo $t0

    # store result, adjust stack and return
6368#    addu $sp,$sp,8 # adjust stack
6372#    sw $t0,($sp) # store result
6376#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
6380:remainder:
    # get parameters; abort if divisor zero
6380#    lw $t0,($sp)
6384#    lw $t1,8($sp)
6388#    beq $t0,$zero,divByZeroError
    
    # perform division
6392#    div $t1,$t0
6396#    mfhi $t0

    # store result, adjust stack and return
6400#    addu $sp,$sp,8 # adjust stack
6404#    sw $t0,($sp) # store result
6408#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
6412:checkCast:
    # get object, allow immediately if null
6412#    lw $t2,($sp)
6416#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
6420#    lw $t2,-12($t2) # vtable address
6424#    bge $t2,$t1,castException
6425##...slt $at,$t2,$t1
6429##...beq $at,$zero,6600
6432#    blt $t2,$t0,castException
6433##...slt $at,$t2,$t0
6437##...bne $at,$zero,6600
    
    # return, leaving object unchanged on stack
6440:  checkCastReturn:    
6440#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
6444:instanceOf:
    # get object, go return false if null
6444#    lw $t2,($sp)
6448#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
6452#    lw $t2,-12($t2) # vtable address
6456#    sge $t0,$t2,$t0 # are we >= the lower limit?
6457##...slt $t0,$t2,$t0
6461##...xori $t0,$t0,0x1
6464#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
6468#    and $t2,$t0,$t1
6472#    sw $t2,($sp)
6476:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
6476#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

6480:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
6480#    li $v0,4 # syscall-code for print-string
6484#    syscall
6488:exit:
    # print termination message
6488#    li $v0,4 # syscall-code for print-string
6492#    la $a0,exitString
6496#    syscall

    # print number of garbage collections
6500#    li $v0,4 # syscall-code for print-string
6504#    la $a0,gcCountMsg
6508#    syscall # print "Number of ..."
6512#    lw $a0,gcCount # number of GC's
6516#    li $v0,1 # code for print-int
6520#    syscall
6524#    li $v0,4 # syscall-code for print-string
6528#    la $a0,newlineString
6532#    syscall # print newline

    # terminate execution
6536#    li $v0,10 #syscall-code for "exit"
6540#    syscall

6544:outOfHeapMemory:
6544#    la $a0,heapMemoryMsg
