# accesses a character in a string, as in Java
# - parameters:
#   - ($sp) - the index, n
#   - 4($sp) - GC tag
#   - 8($sp) - old this pointer
#   - $s2    - this pointer
# - returns:
#   - $t0 - the character found.
########################################################
3312:mth_charAt_String:
    # get string
3312#    move $t0,$s2

    # check that index is in bounds
3316#    lw $t1,-4($t0) # negative of # data words in string
3320#    subu $t3,$zero,$t1 # # chars in string
3324#    lw $t2,($sp) # index
3328#    bgeu $t2,$t3,strIndexOutOfBounds
3329##...sltu $at,$t2,$t3
3333##...beq $at,$zero,4820

    # access element
3336#    lw $t1,-8($t0) # # data words in object
3340#    sll $t1,$t1,2 # - byte-offset from end of chars
3344#    subu $t1,$t2,$t1 # - address of first char in string, offset by 8
3348#    addu $t0,$t0,$t1 # - address of our char, offset by 8
3352#    lb $t0,-8($t0) # our char

    # return
3356#    jr $ra

########################################################
# intToString(n) - library method (class Lib)
# converts int to string: Java: ""+n
# - parameters:
#   - ($sp) - the value to convert, n
#   - 4($sp) - GC tag
#   - 8($sp) - old-this-pointer
#   - $s2 - this-pointer
# - returns:
#   - $t0 - the string, which is the string representation of
#     the integer
########################################################
3360:mth_intToString_Lib:

    # save return address on stack; allocate space for dummy GC tag
3360#    subu $sp,$sp,8
3364#    sw $ra,4($sp)

    # save current sp
3368#    move $t0,$sp

    # move constant 10 into $t3 
    # (Good, I didn't know what li did, I'm glad this comment was here)
    # * slams head through wall *
3372#    li $t3,10

    # get argument, negate if negative
3376#    lw $t1,8($sp)
3380#    bge $t1,$zero,itsNonNegLoop
3381##...slt $at,$t1,$zero
3385##...beq $at,$zero,3392
3388#    subu $t1,$zero,$t1

    # loop through, computing unsigned remainder by 10, and
    # storing digits on stack until we reach 0
3392:  itsNonNegLoop:
3392#    divu $t1,$t3
3396#    mflo $t1 # quotient
3400#    mfhi $t4 # remainder
3404#    addu $t4,$t4,'0' # turn remainder into digit
3408#    subu $sp,$sp,4
3412#    sw $t4,($sp) # push digit onto stack
3416#    bne $t1,$zero,itsNonNegLoop

    # push '-' if negative
3420#    lw $t4,8($t0)
3424#    bge $t4,$zero,itsSkipNeg
3425##...slt $at,$t4,$zero
3429##...beq $at,$zero,3444
3432#    li $t4,'-'
3436#    subu $sp,$sp,4
3440#    sw $t4,($sp)
3444:  itsSkipNeg:

    ################################################
    # At this point, all of our digits have been pushed
    # onto the stack.  $sp points to the first one;
    # $t0 contains the limit-pointer (into which we need to
    # write a GC tag).
    ################################################

    # compute number of characters on stack (one word per character);
    # write GC tag onto stack; push char-count onto stack
3444#    subu $s6,$t0,$sp
3448#    addu $t3,$s6,5 # GC tag (including for count-word, about to be pushed)
3452#    sw $t3,($t0)
3456#    srl $s6,$s6,2
3460#    subu $sp,$sp,4
3464#    sw $s6,($sp)
    
    # allocate memory
3468#    addu $s6,$s6,7 # 3 to round up, plus 4 for vtable word
3472#    srl $s6,$s6,2
3476#    move $s7,$zero # no "object" words in object
3480#    jal newObject

    # restore char-count; pop it and return value from 'newObject'
3484#    lw $t0,4($sp)
3488#    addu $sp,$sp,8

    # store "String" tag into class field
3492#    subu $s7,$s7,8 # address of header-1 word
3496#    la $t1,CLASS_String
3500#    sw $t1,-4($s7)
        
    # mask off hash bits, if needed
3504#    lw $t4,($s7) # # data words in source string
3508#    bge $t4,$zero,skipMask_intToString # don't strip hash code if not there
3509##...slt $at,$t4,$zero
3513##...beq $at,$zero,3532
3516#    and $t4,0xff # mask off object's hash value ...
3517##...lui $at,0
3521##...ori $at,$at,0xff
3525##...and $t4,$t4,$at
3528#    sw $t4,($s7) # ... and store back into -8 header-word
3532:skipMask_intToString:
    
    # store negative of char-count into header-2 word
3532#    subu $t0,$zero,$t0
3536#    sw $t0,4($s7)

3540#    lw $t1,($s7) # number of data words in string
3544#    sll $t1,$t1,2 # number data bytes in string
3548#    subu $t1,$s7,$t1 # first location to store chars in string
3552#    subu $t0,$t1,$t0 # limit address for chars in string

    ####################################################
    # at this point:
    # - $sp contains first source character address
    # - $t1 contains first target character address
    # - $t0 contains target-limit address
    ####################################################

    # loop through and copy all elements as we pop them off the stack.
    # (In this case, we know that there is it least one.)
3556:  itsLoop:
3556#    lw $t2,($sp)
3560#    addu $sp,$sp,4
3564#    sb $t2,($t1)
3568#    addu $t1,$t1,1
3572#    bne $t1,$t0,itsLoop

    ####################################################
    # At this point
    # - ($t0+15)&0xfffffffe is our return value
    # - ($sp) contains garbage (old GC tag)
    # - 4($sp) contains return address
    ####################################################

    # adjust stack, restore return address; return
3576#    lw $ra,4($sp)
3580#    addu $sp,$sp,8
3584#    addu $t0,$t0,15
3588#    and $t0,$t0,0xfffffffc
3589##...lui $at,65535
3593##...ori $at,$at,0xfffc
3597##...and $t0,$t0,$at
3600#    jr $ra

########################################################
# intToChar(n) - library method (class Lib)
# converts int to a one-character string: Java: ""+(char)(n&0xff)
# - parameters:
#   - ($sp) - the value to convert, n
#   - 4($sp) - GC tag
#   - 8($sp) - old-this-pointer
# - returns:
#   - $t0 - the string, which is the converted character
# - note: only the low 8 bits of the value n are used
########################################################
3604:mth_intToChar_Lib:
    # save return address
3604#    subu $sp,$sp,4
3608#    sw $ra,($sp)

    # allocate object
3612#    li $s6,2
3616#    move $s7,$zero
3620#    jal newObject

    # get n from string.
3624#    lw $t1,8($sp)

    # store "String" tag into class field
3628#    la $t0,CLASS_String
3632#    sw $t0,-12($s7)
        
    # mask off hash bits, if needed
3636#    lw $t4,-8($s7) # # data words in source string
3640#    bge $t4,$zero,skipMask_intToChar # don't strip hash code if not there
3641##...slt $at,$t4,$zero
3645##...beq $at,$zero,3664
3648#    and $t4,0xff # mask off object's hash value ...
3649##...lui $at,0
3653##...ori $at,$at,0xff
3657##...and $t4,$t4,$at
3660#    sw $t4,-8($s7) # ... and store back into -8 header-word
3664:  skipMask_intToChar:

    # store data in string
3664#    sb $t1,-16($s7)
    
    # store negative of size in header-word 2
3668#    li $t0,-1
3672#    sw $t0,-4($s7)

    # we're returning $s7
3676#    move $t0, $s7

    # restore $ra, and pop return address and return string off stack
3680#    lw $ra,4($sp)
3684#    addu $sp,$sp,8

    # return
3688#    jr $ra

########################################################
# str1.compareTo(str2) - library method (class String)
# compares two strings as in Java
# - parameters:
#   - ($sp) - second string
#   - 4($sp) - old this pointer
#   - $s2 - first string (this)
# - returns:
#   - $t0 - -1, 0, or 1 depending on whether str1 is
#       lexographically less than, equal to or greater than str2
########################################################
3692:mth_compareTo_String:
    # get string pointers and check parameter for null
3692#    lw $t0,($sp) # second string
3696#    beq $t0,$zero,nullPtrException
3700#    move $t1,$s2 # first string
    
    # get (negatives of) respective byte-lengths
3704#    lw $t2,-4($t0) # negative length of second string
3708#    lw $t3,-4($t1) # negative length of first string

    # put tentative return value in $t5.
    # The tentative return value is the one that we will use if we get
    # to the end of the shorter string during our comparison-loop.
3712#    slt $t4,$t3,$t2
3716#    slt $t5,$t2,$t3
3720#    subu $t5,$t5,$t4
    
    # at this point:
    # - $t0 contains the pointer to the second string object
    # - $t1 contains the pointer to the first string object
    # - $t5 contains the value to return if the strings compare equal up
    #   to the length of the shortest word

    # get begin-of-string addresses
3724#    lw $t2,-8($t0) # # data words in second string
3728#    lw $t3,-8($t1) # # data words in first string
3732#    sll $t2,$t2,2 # byte-offset to beginning of str2 (+8)
3736#    sll $t3,$t3,2 # byte-offset to beginning of str1 (+8)
3740#    subu $t0,$t0,$t2 # beginning of str1 address (+8)
3744#    subu $t1,$t1,$t3 # beginning of str2 address (+8)
    
    # put $t1-limit into $t2
3748#    beq $zero,$t5,skipStrCmpLenzz
3752#    move $t2,$t3
3756:  skipStrCmpLenzz:
3756#    add $t2,$t1,$t2
    
    # at this point:
    # - $t0 contains 8 plus the address of the first data-byte of str2
    # - $t1 contains 8 plus the address of the first data-byte of str1
    # - $t2 contains 8 plus the address of the last data-type of str1
    # - $t5 contains the value to return if the strings compare equal up
    #   to the length of the shortest word

    #######################################################
    # at this point, we have
    # - $t5 containing the tentative return-value
    # - $t1 containing address of first char in str2
    # - $t2 containing limit for $t1
    # - $t0 containing address of first char in str1
    #######################################################

    # loop through, until we find unequal words or we hit
    # our limit    
3760:  cmpLoopzz:
3760#    lw $t3,-8($t1) # word from str2
3764#    lw $t4,-8($t0) # word from str1
3768#    bne $t3,$t4,cmpNotEqualzz
3772#    addu $t1,$t1,4
3776#    addu $t0,$t0,4
3780#    bne $t1,$t2,cmpLoopzz

    # # got to the end of one string: go set up return
3784#    j cmpHitLimitzz

3788:  cmpNotEqualzz:
    # found unequal characters: return -1 or 1, depending on which is
    # greater
3788#    slt $t5,$t4,$t3 # 1 if str2 > str1, else 0
3792#    sll $t5,$t5,1 # 2 if str2 > str1, else 0
3796#    subu $t5,$t5,1 # 1 if str2 > str1, else -1
3800:  cmpHitLimitzz:
3800#    move $t0, $t5 # store return value
3804#    jr $ra # return

########################################################
# readLogicalChar (millicode)
#  - logically reads a character from standard input
#  - first checks character buffer, consuming it if possible
#  - return-result:
#    - returns character in $v0
#  - side-effects:
#    - reads a character
#    - clobbers $t0
########################################################
3808:readLogicalChar:

    # check if we already have a character
3808#    lw $v0,lastCharRead
3812#    li $t0,-2
3816#    beq $t0,$v0 doReadCh

    # we have our character from the buffer. Wipe out
    # buffer and return
3820#    sw $t0,lastCharRead # store -2 into buffer (i.e. "empty")
3824#    jr $ra # return
    
3828:  doReadCh:
    # we need to actually read a character: read and return
3828#    li $v0,12 # use system call to read a character
3832#    syscall
3836#    jr $ra # return

########################################################
# newObject (millicode)
#  - allocates a new object on the heap
#  - two-word header is set up properly
#  - all non-header words in object are set to zero
#  - parameters:
#    - $s6 = the number of data words in the negative-offset portion of
#      the object (including the vtable pointer); this value is 1 if the
#      object is an array; this should always be at least 1
#    - $s7 - second header-word, which is the number of object
#      words in the object
#      - $s7 may not be negative (this is checked); if so, the program is
#        aborted with an "array size of out bounds" error message
#      is treated as if it were zero
#  - return-result:
#    - returned in $s7
#    - and pushed on the stack
#  - side-effects:
#  - may trash all $tx registers and all $sx registers, except the
#    "permanent" ones, which get updated with values that are
#    consistent with the new space
########################################################
3840:newObject:
    # $s6 = # data words
    # $s7 = # object words (# data words if data-array allocation,
    # where a negative number is treated as 0)
    # $ra = return address
    # on return, pointer to new memory in two places:
    # - pushed onto top of stack
    # - in $s7
    
    # if the object-portion size is negative, abort with error
3840#    blt $s7,$zero arraySizeOutOfBounds
3841##...slt $at,$s7,$zero
3845##...bne $at,$zero,4836

    # mark the fact that we have not yet GC'd for this allocation
3848#    move $t5,$zero

    ###### TEMPORARY #######
    # for now, go a GC unconditionally, so that a full GC occurs
    # every time we allocate an object
    ### let's not do that for now
    # j doGC

3852:  gcJoin:

    # at this point:
    #  $s6 contains the before-header word count
    #  $s7 contains the second header word, which is also the
    #    after-header word count
    #  $t5 is zero iff we have not GC'd for this allocation

    # determine if we have enough memory available
3852#    addu $t0,$s6,$s7
3856#    sll $t0,$t0,2
3860#    addu $t0,$t0,8 # amount of memory needed
3864#    addu $t1,$t0,$s3
3868#    bgtu $t1,$s4,doGC
3869##...sltu $at,$s4,$t1
3873##...bne $at,$zero,3996

    # at this point:
    #  $s3 points to beginning of segment, and
    #  $t1 points just past the end

    # zero out the memory
3876#    move $t2,$s3
3880:  zeroObjLoop:
3880#    sw $zero,($s3)
3884#    lw $zero,($s3)

3888#    addu $s3,4
3892#    bltu $s3,$t1,zeroObjLoop
3893##...sltu $at,$s3,$t1
3897##...bne $at,$zero,3880

    # at this point:
    #  $s3 has been updated to point to the next free slot,
    #    which is also the points just past our object

    # compute pointer value and set up header-words
3900#    sll $t0,$s7,2    # number of post-header bytes
3904#    subu $t0,$s3,$t0 # pointer that we will return

    # determine the value to store in the first header-word:
    # if <= 255 (unsigned):
    #  - it goes into low byte
    #  - hash bits go into high three bytes, with top bit being 1
    # if >255 (unsigned)
    #  - it goes into full word (with a 0 in the high bit)
    
3908#    li $t2,255
3912#    bgeu $s6,$t2 firstHeaderLarge
3913##...sltu $at,$s6,$t2
3917##...beq $at,$zero,3964
3920#    lw $t1,prevHashConstant
3924#    addu $t1,0x12b68fd2
3925##...lui $at,4791
3929##...addiu $at,$at,-28718
3933##...addu $t1,$at,$t1
3936#    sw $t1,prevHashConstant # update hash constant
3940#    or $t1,0x80000000 # set top bit
3941##...lui $at,32768
3945##...or $t1,$at,$t1
3948#    and $t1,0xffffff00 # clear low bit
3949##...lui $at,65535
3953##...ori $at,$at,0xff00
3957##...and $t1,$t1,$at
3960#    or $s6,$t1
3964:firstHeaderLarge:
3964#    sw $s6,-8($t0) # store header-1 value
3968#    lw $zero,-8($t0)

    # store second header-value
3972#    sw $s7,-4($t0)   # second header-word
3976#    lw $zero,-4($t0)
    
    # put return-value into $s7 and also push it onto top of stack
3980#    move $s7,$t0
3984#    subu $sp,$sp,4
3988#    sw $t0,($sp)

3992#    jr $ra
    
3996:  doGC:
    #####################################################
    # We need to do a garbage-collect
    #####################################################
 
     ####### print that we are doing a GC ########
     ####### THESE THREE LINES WILL NORMALLY BE COMMENTED OUT #######
#         la $a0,gcMsg # prints message: "GC!" 
#         li $v0,4 # syscall-code for print-string 
#         syscall 
       

    # if we've already done a GC for this allocation, then
    # we are actually out heap-memory: abort program
3996#    bne $t5,$zero,outOfHeapMemory
      
    # increment the number of times we've done a GC, for later reporting
4000#    lw $t5,gcCount
4004#    addu $t5,1
4008#    sw $t5,gcCount

    # save $s2 (our only rooted register) on the stack
    # so that the garbage collector processes it
4012#    subu $sp,$sp,4
4016#    sw $s2,($sp)

    # set $s3 to the address of the new segment and the
    # end-limit of the new segment, respectively,
    # Also, update cur_seg to refer to the other segment
4020#    lw $t0,cur_seg
4024#    move $t7,$s4
4028#    la $t6,seg1_start
4029##...lui $t6,16
4033##...addiu $t6,$t6,5472
4036#    la $s3,seg0_start
4040#    la $s4,seg0_end
4041##...lui $s4,16
4045##...addiu $s4,$s4,5472
4048#    sw $zero,cur_seg
4052#    bne $t0,$zero,skipGc1
4056#    la $t6,seg0_start
4060#    la $s3,seg1_start
4061##...lui $s3,16
4065##...addiu $s3,$s3,5472
4068#    la $s4,seg1_end
4069##...lui $s4,32
4073##...addiu $s4,$s4,5472
4076#    sw $s5,cur_seg
4080:  skipGc1:
4080#    li $t5,0x80000000
4084#    lw $t0,stack_bottom
4088#    subu $t0,4


    ###############################################################
    # at this point:
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first address of the target space
    # - $s4 contains the limit address of the target space
    # - cur_seg has been updated to refer to the target space
    # - $t0 contains the address of the deepest stack element
    # - $sp contains the address of the top stack element
    # - $s2 is available for use, having been pushed onto the stack
    # - $t5 contains the value 0x80000000
    ###############################################################

    ###### begin outer loop to copy all stack-direct objects ######

4092:  gcStackCopyLoop:
4092#    lw $t1,($t0) # current stack element

    # test if we have a GC tag
4096#    sll $t2,$t1,31 # zero iff low bit was zero
4100#    bne $t2,$zero,gcBump # go skip data values if low bit not zero

    # bump stack-address pointer
4104#    subu $t0,$t0,4

    # if value is out of range (which includes null=0), and is
    # therefore does not refer to an object on the heap, just go
    # loop back and do the next one
4108#    bleu $t1,$t6,gcTestIterDone1
4109##...sltu $at,$t6,$t1
4113##...beq $at,$zero,4276
4116#    bgtu $t1,$t7,gcTestIterDone1
4117##...sltu $at,$t7,$t1
4121##...bne $at,$zero,4276

    # if the object has already been moved, update the stack-value
    # via the forwarding pointer
4124#    lw $t2,-8($t1) # possible forwarding tag
