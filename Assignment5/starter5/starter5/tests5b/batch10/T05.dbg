##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
3664:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
3664#    lw $t0,-8($s2) # get word with hash bits from this
3668#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
3672#    addu $t0,$t1

3676#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
3680:mth_equals_Object:
3680#    move $t0,$s2 # first pointer (this)
3684#    lw $t1,($sp) # second pointer
3688#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
3689##...subu $at,$t0,$t1
3693##...sltiu $t0,$at,1

3696#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
3700:mth_hashCode_String:
3700#    move $t0,$s2 # put this pointer in t0

3704#    li $t2,0 # current hash value
3708#    lw $t1,-4($t0) # negative of number of characters in string
3712#    beq $t1,$zero,done_hashCode_String # if zero length => done
3716#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
3720#    and $t0,0xfffffffc # adjust for padding
3721##...lui $at,65535
3725##...ori $at,$at,0xfffc
3729##...and $t0,$t0,$at
3732#    subu $t1,$t0,$t1 # address at end of string +12
3736:loop_hashCode_String:    
3736#    sll $t4,$t2,5 # multiply by 32
3740#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
3744#    lbu $t3,-12($t0) # current character
3748#    addu $t2,$t3 # add in current character
3752#    addu $t0,1 # go to next character's address
3756#    bne $t0,$t1,loop_hashCode_String # loop back if more
3760:done_hashCode_String:    

    # push int on stack
3760#    move $t0, $t2 # put $t2 in return slot
3764#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
3768:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
3768#    subu $sp,4
3772#    sw $ra,($sp)
    
    # get hash value
3776#    lw $t2,-12($s2) # vtable address
3780#    lw $t0,($t2) # method address
3784#    jalr $t0
3788#    subu $sp,8 # push result (int in $t0) on stack
3792#    sw $s5,4($sp)
3796#    sw $t0,($sp)

    # compute print-size of hash value
3800#    li $t0, 1
3804#    lw $t1, ($sp)
3808#    srl $t1,$t1,4
3812#    beq $t1,$zero,toString_skip_loop
3816:toString_loop_top:
3816#    addu $t0,1
3820#    srl $t1,$t1,4
3824#    bne $t1,$zero,toString_loop_top
3828:toString_skip_loop:
3828#    subu $sp,8
3832#    sw $s5,4($sp)
3836#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
3840#    lw $t2,-12($s2) # vtable address
3844#    move $t0,$t2
3848:toString_checkTagBit:
3848#    subu $t0,1
3852#    lb $t1,($t0)
3856#    and $t1,0x80
3857##...lui $at,0
3861##...ori $at,$at,0x80
3865##...and $t1,$t1,$at
3868#    beq $t1,$zero,toString_checkTagBit
3872#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
3876#    subu $sp,8
3880#    sw $t1,($sp)
3884#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
3888#    move $s7,$zero # -4 offset header word
3892#    lw $t4,8($sp) # bytes for hash value
3896#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
3900#    addu $t4,8
3904#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
3908#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

3912#    li $t0,CLASS_String # store string vtable address into ...
3916#    sw $t0,-12($s7) # ... -12 offset in object header
3920#    lw $t2,-12($s2) # our object's vtable address
3924#    lw $t5,4($sp) # number characters in prefix
3928#    lw $t1,12($sp) # number of characters in hashcode
3932#    addu $t3,$t1,$t5 # number of characters in string ...
3936#    addu $t3,1 # ... including the '@' character
3940#    subu $t0,$zero,$t3 # store negated length into ...
3944#    sw $t0,-4($s7) # ... -4 offset header word
3948#    lw $t0,-8($s7) # get -8 offset header-word
3952#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
3953##...slt $at,$t0,$zero
3957##...beq $at,$zero,3976
3960#    and $t0,0xff # mask off object's hash value ...
3961##...lui $at,0
3965##...ori $at,$at,0xff
3969##...and $t0,$t0,$at
3972#    sw $t0,-8($s7) # ... and store back into -8 header-word
3976:skipMask_toString:
3976#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
3980#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
3984#    subu $t4,$t2,$t5
3988:toString_copyLoop:    
3988#    lb $t3,($t4)
3992#    and $t3,0x7f # mask off sign bit (in case first word)
3993##...lui $at,0
3997##...ori $at,$at,0x7f
4001##...and $t3,$t3,$at
4004#    sb $t3,-8($t0)
4008#    addu $t4,1
4012#    addu $t0,1
4016#    blt $t4,$t2,toString_copyLoop
4017##...slt $at,$t4,$t2
4021##...bne $at,$zero,3988

    # copy the '@' sign
4024#    li $t3,'@'
4028#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
4032#    addu $t2,$t0,$t1 # address of last byte in string to store +8
4036#    lw $t3,20($sp) # hash code to print
4040:toString_hashCopyLoop:
4040#    and $t4,$t3,0xf
4044#    srl $t3,4
4048#    lb $t4,hexChars($t4)
4052#    sb $t4,-8($t2)
4056#    subu $t2,$t2,1
4060#    bgt $t2,$t0,toString_hashCopyLoop
4061##...slt $at,$t0,$t2
4065##...bne $at,$zero,4040

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
4068#    addu $sp,28
4072#    lw $ra,($sp)
4076#    addu $sp,4
4080#    move $t0, $s7 # return string we created
4084#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
4088:mth_equals_String:
    
    # quick test for obvious false
4088#    lw $t0,($sp) # second parameter
4092#    beq $t0,$zero,goEsFalse # go return false if null
4096#    lw $t1,-12($t0) # vtable pointer
4100#    la $t2,CLASS_String # string vtable pointer
4104#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
4108#    subu $sp,12
4112#    sw $ra,8($sp)
4116#    sw $s2,4($sp)
4120#    sw $t0,($sp)
4124#    jal mth_compareTo_String
4128#    lw $s2, 4($sp) #restore this pointer and pop parameters
4132#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
4136#    seq $t0,$t0,$zero
4137##...subu $at,$t0,$zero
4141##...sltiu $t0,$at,1

    # pop return address and return $t0
4144#    lw $ra,($sp)
4148#    addu $sp,4

4152#    jr $ra # return
    
4156:goEsFalse:
    # put 0 in $t0 and return
4156#    li $t0, 0
4160#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
4164:mth_toString_String:
    #we are a string, so return this.
4164#    move $t0, $s2
4168#    jr $ra

###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
4172:mth_readLine_Lib:
    
4172#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
4176#    sw $ra, 4($sp) # save $ra
4180#    move $t1,$sp # save "original" sp

4184:  doRead:

    # read the character
4184#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
4188#    subu $t2,$v0,13
4192#    bne $t2,$zero,notReturnRL
4196#    jal readLogicalChar
4200#    subu $t2,$v0,10 # check for newline
4204#    beq $t2,$zero,foundNewLine
4208#    sw $v0,lastCharRead # push back character into queue
4212#    j foundNewLine # go process the line

4216:  notReturnRL:

    # at this point, $v0 has our character

4216#    subu $t0,$v0,10
4220#    beq $t0,$zero,foundNewLine
4224#    blt $v0,$zero,foundEof
4225##...slt $at,$v0,$zero
4229##...bne $at,$zero,4244

    # we have a character, so push it onto stack
4232#    subu $sp,$sp,4
4236#    sw $v0,($sp)

