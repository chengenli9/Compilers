########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
4976:vm_init:

    # mark bottom of stack
4976#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
4980#    move $s2,$zero

    #set up the "five" register
4984#    li $s5,5

4988#    la $s3,seg0_start
4992#    la $s4,seg0_end
4993##...lui $s4,16
4997##...addiu $s4,$s4,5916
    
    # return
5000#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
5004:divide:
    # get parameters; abort if divisor zero
5004#    lw $t0,($sp)
5008#    lw $t1,8($sp)
5012#    beq $t0,$zero,divByZeroError
    
    # perform division
5016#    div $t1,$t0
5020#    mflo $t0

    # store result, adjust stack and return
5024#    addu $sp,$sp,8 # adjust stack
5028#    sw $t0,($sp) # store result
5032#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
5036:remainder:
    # get parameters; abort if divisor zero
5036#    lw $t0,($sp)
5040#    lw $t1,8($sp)
5044#    beq $t0,$zero,divByZeroError
    
    # perform division
5048#    div $t1,$t0
5052#    mfhi $t0

    # store result, adjust stack and return
5056#    addu $sp,$sp,8 # adjust stack
5060#    sw $t0,($sp) # store result
5064#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
5068:checkCast:
    # get object, allow immediately if null
5068#    lw $t2,($sp)
5072#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
5076#    lw $t2,-12($t2) # vtable address
5080#    bge $t2,$t1,castException
5081##...slt $at,$t2,$t1
5085##...beq $at,$zero,5256
5088#    blt $t2,$t0,castException
5089##...slt $at,$t2,$t0
5093##...bne $at,$zero,5256
    
    # return, leaving object unchanged on stack
5096:  checkCastReturn:    
5096#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
5100:instanceOf:
    # get object, go return false if null
5100#    lw $t2,($sp)
5104#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
5108#    lw $t2,-12($t2) # vtable address
5112#    sge $t0,$t2,$t0 # are we >= the lower limit?
5113##...slt $t0,$t2,$t0
5117##...xori $t0,$t0,0x1
5120#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
5124#    and $t2,$t0,$t1
5128#    sw $t2,($sp)
5132:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
5132#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

5136:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
5136#    li $v0,4 # syscall-code for print-string
5140#    syscall
5144:exit:
    # print termination message
5144#    li $v0,4 # syscall-code for print-string
5148#    la $a0,exitString
5152#    syscall

    # print number of garbage collections
5156#    li $v0,4 # syscall-code for print-string
5160#    la $a0,gcCountMsg
5164#    syscall # print "Number of ..."
5168#    lw $a0,gcCount # number of GC's
5172#    li $v0,1 # code for print-int
5176#    syscall
5180#    li $v0,4 # syscall-code for print-string
5184#    la $a0,newlineString
5188#    syscall # print newline

    # terminate execution
5192#    li $v0,10 #syscall-code for "exit"
5196#    syscall

5200:outOfHeapMemory:
5200#    la $a0,heapMemoryMsg
5204#    j exitError
5208:divByZeroError:
5208#    la $a0,divByZeroMsg
5212#    j exitError
5216:strIndexOutOfBounds:
5216#    la $a0,strIndexOutOfBoundsMsg
5220#    j exitError
5224:arrayIndexOutOfBounds:
5224#    la $a0,arrayIndexOutOfBoundsMsg
5228#    j exitError
5232:arraySizeOutOfBounds:
5232#    la $a0,arraySizeOutOfBoundsMsg
5236#    j exitError
5240:nullPtrException:
5240#    la $a0,nullPtrExceptionMsg
5244#    j exitError
5248:badIntegerFormat:
5248#    la $a0,badIntegerFormatMsg
5252#    j exitError
5256:castException:
5256#    la $a0,castExceptionMsg
5260#    j exitError
############## data section ################
    .data
5544:hexChars:
    .ascii "0123456789abcdef"
    .align 2
5560:cur_seg:
    .word 0

5564:lastCharRead:
    .word -2 # -2 => no buffered character
5568:prevHashConstant:
    .word 0x2785173c
5572:gcCount:
    .word 0

5576:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
5603:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
5626:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
5661:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
5695:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
5728:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
5759:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
5807:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
5828:gcMsg: 
      .asciiz "\nGC!\n"
5834:gcCountMsg: 
      .asciiz "Number of garbage collections: "

5866:nullStr:
    .asciiz "null"
5871:trueString:
    .asciiz "true"
5876:falseString:
    .asciiz "false"
5882:exitString:
    .ascii "Program execution completed."
    #### "falls through" here
5910:newlineString:
    .asciiz "\n"
    
    .align 2
5912:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

5916:seg0_start:
    .space 0x100000
1054492:seg0_end:
1054492:seg1_start:
    .space 0x100000
2103068:seg1_end:
