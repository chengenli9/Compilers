7516#    beq $t0,$zero,riSkipWhiteLoop # start over if space
7520#    subu $t0,$v0,10
7524#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
7528#    subu $t0,$v0,9
7532#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
7536#    subu $t0,$v0,13
7540#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
7544#    subu $t0,$v0,12
