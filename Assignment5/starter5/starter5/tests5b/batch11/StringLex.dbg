17176#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
17180#    srl $s6,$s6,2  # data words in object
17184#    move $s7,$zero # object words in object
17188#    jal newObject  # allocate space
    
    # store header words
17192#    la $t0,CLASS_String
17196#    sw $t0,-12($s7)# store class tag (String) into object
17200#    lw $t2,4($sp) # char-count
17204#    sll $t1,$t2,2 # 4 times number of chars
17208#    subu $t2,$zero,$t2 # negative of char-count
17212#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
17216#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
17220#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
17221##...slt $at,$t0,$zero
17225##...beq $at,$zero,17244
17228#    and $t0,0xff # mask off object's hash value ...
17229##...lui $at,0
17233##...ori $at,$at,0xff
17237##...and $t0,$t0,$at
17240#    sw $t0,-8($s7) # ... and store back into -8 header-word
17244:  skipMask_readLine:

17244#    sll $t0,$t0,2 # data bytes in object
17248#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
17252#    subu $t0,$t0,$t2 # place to store last character (plus 9)
