    # if there are no pointer-slots (i.e., $t0=$s1), skip this
    # part
7172#    beq $t0,$s1,gcTestIterDone2
    
7176:  gcNextPointerInObject:
    # get pointer from object
7176#    lw $t1,($t0)

    # if value is out of range, and is therefore does not refer
    # to an object, just go loop back and do the next one
7180#    bleu $t1,$t6,gcGoNextPointerSlot
7181##...sltu $at,$t6,$t1
7185##...beq $at,$zero,7328
7188#    bgtu $t1,$t7,gcGoNextPointerSlot
7189##...sltu $at,$t7,$t1
7193##...bne $at,$zero,7328

    # if the object has already been moved, update the stack-value
    # via the forwarding pointer
7196#    lw $t8,-8($t1) # possible forwarding tag
7200#    bne $t8,$zero,gcNoForward2 # if not forwarding tag, go copy
7204#    lw $t8,-4($t1) # forwarding pointer: object's new address
7208#    sw $t8,($t0) # update pointer in object
7212#    j gcGoNextPointerSlot # do next iteration

7216:  gcNoForward2:
    #########################################################
    # we actually need to copy the object into the new space
    #########################################################

    #########################################################
    # At this point:
    # - $t0 contains the address of the heap-slot we're translating
    # - $t1 will contain the contents of the heap-slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space, which will also be the first address
    #   of the target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # Then during processing:
    # And when we're actually copying an object:
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $t8 will contain a pointer to the target object
    # - available for use: $s0, $t8, $t9
    ##########################################################

    # compute the amount of space that is needed
7216#    bge $t8,$zero,gcSkip5 # # words in negative-offset portion
7217##...slt $at,$t8,$zero
7221##...beq $at,$zero,7236
7224#    and $t8,0xff # mask off hash bits
7225##...lui $at,0
7229##...ori $at,$at,0xff
7233##...and $t8,$t8,$at

7236:  gcSkip5:
7236#    sll $t8,$t8,2 # bytes in negative-offset portion ...
7240#    addu $t8,$t8,8 # ... add in bytes for header-words
7244#    subu $t4,$t1,$t8 # address of first word of source object
7248#    lw $t3,-4($t1) # # words in positive-offset portion
7252#    bge $t3,$zero,gcNoNeg
7253##...slt $at,$t3,$zero
7257##...beq $at,$zero,7264
7260#    move $t3,$zero # negative treated as zero
7264:  gcNoNeg:
7264#    sll $t3,$t3,2 # bytes in negative-offset portion
7268#    addu $t3,$t3,$t1 # address one word past last word of source

7272#    addu $t8,$s3,$t8 # pointer to target object

    #########################################################
    # At this point:
    # - $t0 contains the address of the stack slot we'll
    #   process next
    # - $t1 contains the contents of the stack slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $t8 contains the pointer to the target object
    # - $s1 contains the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0, $t9
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger"
7276#    lw $s0,($t4)
7280#    lw $t9,-8($t1)
7284#    sw $t9,($t4)
7288#    sw $s0,-8($t1)

    # copy all source bytes to the target
7292:  gCinnerCopy2:
7292#    lw $s0,($t4)
7296#    sw $s0,($s3)
7300#    addu $t4,$t4,4
7304#    addu $s3,$s3,4
7308#    bltu $t4,$t3,gCinnerCopy2
7309##...sltu $at,$t4,$t3
7313##...bne $at,$zero,7292

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
7316#    sw $zero,-8($t1) # 0 in first header-slot
7320#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
7324#    sw $t8,($t0)

7328:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
7328#    addu $t0,$t0,4
7332#    bltu $t0,$s1,gcNextPointerInObject
7333##...sltu $at,$t0,$s1
7337##...bne $at,$zero,7176

7340:  gcTestIterDone2:
7340#    bltu $t0,$s3,gcHeapCopyLoop
7341##...sltu $at,$t0,$s3
7345##...bne $at,$zero,7060

    ###### end outer loop to copy all non-stack-direct objects ######

7348:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
7348#    lw $s2,($sp)
7352#    addu $sp,$sp,4

    # mark us as having already GC'd
7356#    move $t5,$s5

    # go try and allocate again
7360#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
7364:vm_init:

    # mark bottom of stack
7364#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
7368#    move $s2,$zero

    #set up the "five" register
7372#    li $s5,5

7376#    la $s3,seg0_start
7380#    la $s4,seg0_end
7381##...lui $s4,16
7385##...addiu $s4,$s4,8348
    
    # return
7388#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
7392:divide:
    # get parameters; abort if divisor zero
7392#    lw $t0,($sp)
7396#    lw $t1,8($sp)
7400#    beq $t0,$zero,divByZeroError
    
    # perform division
7404#    div $t1,$t0
7408#    mflo $t0

    # store result, adjust stack and return
7412#    addu $sp,$sp,8 # adjust stack
7416#    sw $t0,($sp) # store result
7420#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
7424:remainder:
    # get parameters; abort if divisor zero
7424#    lw $t0,($sp)
7428#    lw $t1,8($sp)
7432#    beq $t0,$zero,divByZeroError
    
    # perform division
7436#    div $t1,$t0
7440#    mfhi $t0

    # store result, adjust stack and return
7444#    addu $sp,$sp,8 # adjust stack
7448#    sw $t0,($sp) # store result
7452#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
7456:checkCast:
    # get object, allow immediately if null
7456#    lw $t2,($sp)
7460#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
7464#    lw $t2,-12($t2) # vtable address
7468#    bge $t2,$t1,castException
7469##...slt $at,$t2,$t1
7473##...beq $at,$zero,7644
7476#    blt $t2,$t0,castException
7477##...slt $at,$t2,$t0
7481##...bne $at,$zero,7644
    
    # return, leaving object unchanged on stack
7484:  checkCastReturn:    
7484#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
7488:instanceOf:
    # get object, go return false if null
7488#    lw $t2,($sp)
7492#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
7496#    lw $t2,-12($t2) # vtable address
7500#    sge $t0,$t2,$t0 # are we >= the lower limit?
7501##...slt $t0,$t2,$t0
7505##...xori $t0,$t0,0x1
7508#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
7512#    and $t2,$t0,$t1
7516#    sw $t2,($sp)
7520:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
7520#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

7524:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
7524#    li $v0,4 # syscall-code for print-string
7528#    syscall
7532:exit:
    # print termination message
7532#    li $v0,4 # syscall-code for print-string
7536#    la $a0,exitString
7540#    syscall

    # print number of garbage collections
7544#    li $v0,4 # syscall-code for print-string
7548#    la $a0,gcCountMsg
7552#    syscall # print "Number of ..."
7556#    lw $a0,gcCount # number of GC's
7560#    li $v0,1 # code for print-int
7564#    syscall
7568#    li $v0,4 # syscall-code for print-string
7572#    la $a0,newlineString
7576#    syscall # print newline

    # terminate execution
7580#    li $v0,10 #syscall-code for "exit"
7584#    syscall

7588:outOfHeapMemory:
7588#    la $a0,heapMemoryMsg
7592#    j exitError
7596:divByZeroError:
7596#    la $a0,divByZeroMsg
7600#    j exitError
7604:strIndexOutOfBounds:
7604#    la $a0,strIndexOutOfBoundsMsg
7608#    j exitError
7612:arrayIndexOutOfBounds:
7612#    la $a0,arrayIndexOutOfBoundsMsg
7616#    j exitError
7620:arraySizeOutOfBounds:
7620#    la $a0,arraySizeOutOfBoundsMsg
7624#    j exitError
7628:nullPtrException:
7628#    la $a0,nullPtrExceptionMsg
7632#    j exitError
7636:badIntegerFormat:
7636#    la $a0,badIntegerFormatMsg
7640#    j exitError
7644:castException:
7644#    la $a0,castExceptionMsg
7648#    j exitError
############## data section ################
    .data
7976:hexChars:
    .ascii "0123456789abcdef"
    .align 2
7992:cur_seg:
    .word 0

7996:lastCharRead:
    .word -2 # -2 => no buffered character
8000:prevHashConstant:
    .word 0x2785173c
8004:gcCount:
    .word 0

8008:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
8035:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
8058:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
8093:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
8127:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
8160:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
8191:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
8239:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
8260:gcMsg: 
      .asciiz "\nGC!\n"
8266:gcCountMsg: 
      .asciiz "Number of garbage collections: "

8298:nullStr:
    .asciiz "null"
8303:trueString:
    .asciiz "true"
8308:falseString:
    .asciiz "false"
8314:exitString:
    .ascii "Program execution completed."
    #### "falls through" here
8342:newlineString:
    .asciiz "\n"
    
    .align 2
8344:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

8348:seg0_start:
    .space 0x100000
1056924:seg0_end:
1056924:seg1_start:
    .space 0x100000
2105500:seg1_end:
