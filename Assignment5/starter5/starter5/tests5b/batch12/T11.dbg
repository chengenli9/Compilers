###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
864:mth_readLine_Lib:
    
864#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
868#    sw $ra, 4($sp) # save $ra
872#    move $t1,$sp # save "original" sp

876:  doRead:

    # read the character
876#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
880#    subu $t2,$v0,13
884#    bne $t2,$zero,notReturnRL
888#    jal readLogicalChar
892#    subu $t2,$v0,10 # check for newline
896#    beq $t2,$zero,foundNewLine
900#    sw $v0,lastCharRead # push back character into queue
904#    j foundNewLine # go process the line

908:  notReturnRL:

    # at this point, $v0 has our character

908#    subu $t0,$v0,10
912#    beq $t0,$zero,foundNewLine
916#    blt $v0,$zero,foundEof
917##...slt $at,$v0,$zero
921##...bne $at,$zero,936

    # we have a character, so push it onto stack
924#    subu $sp,$sp,4
928#    sw $v0,($sp)

    # loop back up to get next character
932#    j doRead

936:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
936#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
940#    li $s7, 0 # return-value: null
944#    j rlReturn # return

948:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
948#    subu $t0,$t1,$sp # number of chars we read (times 4)
952#    srl $s6,$t0,2 # number of words on stack with chars
956#    subu $sp,$sp,4 # push char-count ...
960#    sw $s6,($sp) # ... onto stack
964#    addu $t2,$t0,5 # GC tag, incl. for count-word
968#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
972#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
976#    srl $s6,$s6,2  # data words in object
980#    move $s7,$zero # object words in object
984#    jal newObject  # allocate space
    
    # store header words
988#    la $t0,CLASS_String
992#    sw $t0,-12($s7)# store class tag (String) into object
996#    lw $t2,4($sp) # char-count
1000#    sll $t1,$t2,2 # 4 times number of chars
1004#    subu $t2,$zero,$t2 # negative of char-count
1008#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
1012#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
1016#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
1017##...slt $at,$t0,$zero
1021##...beq $at,$zero,1040
1024#    and $t0,0xff # mask off object's hash value ...
1025##...lui $at,0
1029##...ori $at,$at,0xff
1033##...and $t0,$t0,$at
1036#    sw $t0,-8($s7) # ... and store back into -8 header-word
1040:  skipMask_readLine:

1040#    sll $t0,$t0,2 # data bytes in object
1044#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
1048#    subu $t0,$t0,$t2 # place to store last character (plus 9)
1052#    addu $sp,$sp,8 # pop redundant object-pointer and count
1056#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

1060#    beq $sp,$t1,rlReturn
1064:  charCopyLoop:
1064#    lw $t2,($sp)
1068#    sb $t2,-9($t0)
1072#    addu $sp,$sp,4
1076#    subu $t0,$t0,1
1080#    bne $sp,$t1,charCopyLoop
1084:  rlReturn:

1084#    lw $ra, 4($sp)
1088#    addu $sp, 8   # pop $ra and pointless word off stack
1092#    move $t0, $s7 # return string we allocated in $s7
1096#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
1100:mth_readInt_Lib:

    # save $ra by pushing onto stack
1100#    subu $sp,$sp,4
1104#    sw $ra,($sp)

1108:  riSkipWhiteLoop:
    # read a character
1108#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
1112#    subu $t0,$v0,32
