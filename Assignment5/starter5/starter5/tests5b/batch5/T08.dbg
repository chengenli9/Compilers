    # check if we already have a character
3832#    lw $v0,lastCharRead
3836#    li $t0,-2
3840#    beq $t0,$v0 doReadCh

    # we have our character from the buffer. Wipe out
    # buffer and return
3844#    sw $t0,lastCharRead # store -2 into buffer (i.e. "empty")
3848#    jr $ra # return
    
3852:  doReadCh:
