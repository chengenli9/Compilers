##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
9740:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
9740#    lw $t0,-8($s2) # get word with hash bits from this
9744#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
9748#    addu $t0,$t1

9752#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
9756:mth_equals_Object:
9756#    move $t0,$s2 # first pointer (this)
9760#    lw $t1,($sp) # second pointer
9764#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
9765##...subu $at,$t0,$t1
9769##...sltiu $t0,$at,1

9772#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
9776:mth_hashCode_String:
9776#    move $t0,$s2 # put this pointer in t0

9780#    li $t2,0 # current hash value
9784#    lw $t1,-4($t0) # negative of number of characters in string
9788#    beq $t1,$zero,done_hashCode_String # if zero length => done
9792#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
9796#    and $t0,0xfffffffc # adjust for padding
9797##...lui $at,65535
9801##...ori $at,$at,0xfffc
9805##...and $t0,$t0,$at
9808#    subu $t1,$t0,$t1 # address at end of string +12
9812:loop_hashCode_String:    
9812#    sll $t4,$t2,5 # multiply by 32
9816#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
9820#    lbu $t3,-12($t0) # current character
9824#    addu $t2,$t3 # add in current character
9828#    addu $t0,1 # go to next character's address
9832#    bne $t0,$t1,loop_hashCode_String # loop back if more
9836:done_hashCode_String:    

    # push int on stack
9836#    move $t0, $t2 # put $t2 in return slot
9840#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
9844:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
9844#    subu $sp,4
9848#    sw $ra,($sp)
    
    # get hash value
9852#    lw $t2,-12($s2) # vtable address
9856#    lw $t0,($t2) # method address
9860#    jalr $t0
9864#    subu $sp,8 # push result (int in $t0) on stack
9868#    sw $s5,4($sp)
9872#    sw $t0,($sp)

    # compute print-size of hash value
9876#    li $t0, 1
9880#    lw $t1, ($sp)
9884#    srl $t1,$t1,4
9888#    beq $t1,$zero,toString_skip_loop
9892:toString_loop_top:
9892#    addu $t0,1
9896#    srl $t1,$t1,4
9900#    bne $t1,$zero,toString_loop_top
9904:toString_skip_loop:
9904#    subu $sp,8
9908#    sw $s5,4($sp)
9912#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
9916#    lw $t2,-12($s2) # vtable address
9920#    move $t0,$t2
9924:toString_checkTagBit:
9924#    subu $t0,1
9928#    lb $t1,($t0)
9932#    and $t1,0x80
9933##...lui $at,0
9937##...ori $at,$at,0x80
9941##...and $t1,$t1,$at
9944#    beq $t1,$zero,toString_checkTagBit
9948#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
9952#    subu $sp,8
9956#    sw $t1,($sp)
9960#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
9964#    move $s7,$zero # -4 offset header word
9968#    lw $t4,8($sp) # bytes for hash value
9972#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
9976#    addu $t4,8
9980#    srl $s6,$t4,2 # divide by 4
