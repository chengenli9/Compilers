###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
2760:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
2760#    lw $t0,-8($s2) # get word with hash bits from this
2764#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
2768#    addu $t0,$t1

2772#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
2776:mth_equals_Object:
2776#    move $t0,$s2 # first pointer (this)
2780#    lw $t1,($sp) # second pointer
2784#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
2785##...subu $at,$t0,$t1
2789##...sltiu $t0,$at,1

2792#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
2796:mth_hashCode_String:
2796#    move $t0,$s2 # put this pointer in t0

2800#    li $t2,0 # current hash value
2804#    lw $t1,-4($t0) # negative of number of characters in string
2808#    beq $t1,$zero,done_hashCode_String # if zero length => done
2812#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
2816#    and $t0,0xfffffffc # adjust for padding
2817##...lui $at,65535
2821##...ori $at,$at,0xfffc
2825##...and $t0,$t0,$at
2828#    subu $t1,$t0,$t1 # address at end of string +12
2832:loop_hashCode_String:    
2832#    sll $t4,$t2,5 # multiply by 32
2836#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
2840#    lbu $t3,-12($t0) # current character
2844#    addu $t2,$t3 # add in current character
2848#    addu $t0,1 # go to next character's address
2852#    bne $t0,$t1,loop_hashCode_String # loop back if more
2856:done_hashCode_String:    

    # push int on stack
2856#    move $t0, $t2 # put $t2 in return slot
2860#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
2864:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
2864#    subu $sp,4
2868#    sw $ra,($sp)
    
    # get hash value
2872#    lw $t2,-12($s2) # vtable address
2876#    lw $t0,($t2) # method address
2880#    jalr $t0
2884#    subu $sp,8 # push result (int in $t0) on stack
2888#    sw $s5,4($sp)
2892#    sw $t0,($sp)

    # compute print-size of hash value
2896#    li $t0, 1
2900#    lw $t1, ($sp)
2904#    srl $t1,$t1,4
2908#    beq $t1,$zero,toString_skip_loop
2912:toString_loop_top:
2912#    addu $t0,1
2916#    srl $t1,$t1,4
2920#    bne $t1,$zero,toString_loop_top
2924:toString_skip_loop:
2924#    subu $sp,8
2928#    sw $s5,4($sp)
2932#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
2936#    lw $t2,-12($s2) # vtable address
2940#    move $t0,$t2
2944:toString_checkTagBit:
2944#    subu $t0,1
2948#    lb $t1,($t0)
2952#    and $t1,0x80
2953##...lui $at,0
2957##...ori $at,$at,0x80
2961##...and $t1,$t1,$at
2964#    beq $t1,$zero,toString_checkTagBit
2968#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
2972#    subu $sp,8
2976#    sw $t1,($sp)
2980#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
2984#    move $s7,$zero # -4 offset header word
2988#    lw $t4,8($sp) # bytes for hash value
2992#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
2996#    addu $t4,8
3000#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
3004#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

3008#    li $t0,CLASS_String # store string vtable address into ...
3012#    sw $t0,-12($s7) # ... -12 offset in object header
3016#    lw $t2,-12($s2) # our object's vtable address
3020#    lw $t5,4($sp) # number characters in prefix
3024#    lw $t1,12($sp) # number of characters in hashcode
3028#    addu $t3,$t1,$t5 # number of characters in string ...
3032#    addu $t3,1 # ... including the '@' character
3036#    subu $t0,$zero,$t3 # store negated length into ...
3040#    sw $t0,-4($s7) # ... -4 offset header word
3044#    lw $t0,-8($s7) # get -8 offset header-word
3048#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
3049##...slt $at,$t0,$zero
3053##...beq $at,$zero,3072
3056#    and $t0,0xff # mask off object's hash value ...
3057##...lui $at,0
3061##...ori $at,$at,0xff
3065##...and $t0,$t0,$at
3068#    sw $t0,-8($s7) # ... and store back into -8 header-word
3072:skipMask_toString:
3072#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
3076#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
3080#    subu $t4,$t2,$t5
3084:toString_copyLoop:    
3084#    lb $t3,($t4)
3088#    and $t3,0x7f # mask off sign bit (in case first word)
3089##...lui $at,0
3093##...ori $at,$at,0x7f
3097##...and $t3,$t3,$at
3100#    sb $t3,-8($t0)
3104#    addu $t4,1
3108#    addu $t0,1
3112#    blt $t4,$t2,toString_copyLoop
3113##...slt $at,$t4,$t2
3117##...bne $at,$zero,3084

    # copy the '@' sign
3120#    li $t3,'@'
3124#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
3128#    addu $t2,$t0,$t1 # address of last byte in string to store +8
3132#    lw $t3,20($sp) # hash code to print
3136:toString_hashCopyLoop:
3136#    and $t4,$t3,0xf
3140#    srl $t3,4
3144#    lb $t4,hexChars($t4)
3148#    sb $t4,-8($t2)
3152#    subu $t2,$t2,1
3156#    bgt $t2,$t0,toString_hashCopyLoop
3157##...slt $at,$t0,$t2
3161##...bne $at,$zero,3136

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
3164#    addu $sp,28
3168#    lw $ra,($sp)
3172#    addu $sp,4
3176#    move $t0, $s7 # return string we created
3180#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
3184:mth_equals_String:
    
    # quick test for obvious false
3184#    lw $t0,($sp) # second parameter
3188#    beq $t0,$zero,goEsFalse # go return false if null
3192#    lw $t1,-12($t0) # vtable pointer
3196#    la $t2,CLASS_String # string vtable pointer
3200#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
3204#    subu $sp,12
3208#    sw $ra,8($sp)
3212#    sw $s2,4($sp)
3216#    sw $t0,($sp)
3220#    jal mth_compareTo_String
3224#    lw $s2, 4($sp) #restore this pointer and pop parameters
3228#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
3232#    seq $t0,$t0,$zero
3233##...subu $at,$t0,$zero
3237##...sltiu $t0,$at,1

    # pop return address and return $t0
3240#    lw $ra,($sp)
3244#    addu $sp,4

3248#    jr $ra # return
    
3252:goEsFalse:
    # put 0 in $t0 and return
3252#    li $t0, 0
3256#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
3260:mth_toString_String:
    #we are a string, so return this.
3260#    move $t0, $s2
3264#    jr $ra

###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
3268:mth_readLine_Lib:
    
3268#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
3272#    sw $ra, 4($sp) # save $ra
3276#    move $t1,$sp # save "original" sp

3280:  doRead:

    # read the character
3280#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
3284#    subu $t2,$v0,13
3288#    bne $t2,$zero,notReturnRL
3292#    jal readLogicalChar
3296#    subu $t2,$v0,10 # check for newline
3300#    beq $t2,$zero,foundNewLine
3304#    sw $v0,lastCharRead # push back character into queue
3308#    j foundNewLine # go process the line

3312:  notReturnRL:

    # at this point, $v0 has our character

3312#    subu $t0,$v0,10
3316#    beq $t0,$zero,foundNewLine
3320#    blt $v0,$zero,foundEof
3321##...slt $at,$v0,$zero
3325##...bne $at,$zero,3340

    # we have a character, so push it onto stack
3328#    subu $sp,$sp,4
3332#    sw $v0,($sp)

    # loop back up to get next character
3336#    j doRead

3340:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
3340#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
3344#    li $s7, 0 # return-value: null
3348#    j rlReturn # return

3352:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
3352#    subu $t0,$t1,$sp # number of chars we read (times 4)
3356#    srl $s6,$t0,2 # number of words on stack with chars
3360#    subu $sp,$sp,4 # push char-count ...
3364#    sw $s6,($sp) # ... onto stack
3368#    addu $t2,$t0,5 # GC tag, incl. for count-word
3372#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
3376#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
3380#    srl $s6,$s6,2  # data words in object
3384#    move $s7,$zero # object words in object
3388#    jal newObject  # allocate space
    
    # store header words
3392#    la $t0,CLASS_String
3396#    sw $t0,-12($s7)# store class tag (String) into object
3400#    lw $t2,4($sp) # char-count
3404#    sll $t1,$t2,2 # 4 times number of chars
3408#    subu $t2,$zero,$t2 # negative of char-count
