18460#    lw $t2,($sp)
18464#    sb $t2,-9($t0)
18468#    addu $sp,$sp,4
18472#    subu $t0,$t0,1
18476#    bne $sp,$t1,charCopyLoop
18480:  rlReturn:

18480#    lw $ra, 4($sp)
18484#    addu $sp, 8   # pop $ra and pointless word off stack
18488#    move $t0, $s7 # return string we allocated in $s7
18492#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
18496:mth_readInt_Lib:

    # save $ra by pushing onto stack
18496#    subu $sp,$sp,4
18500#    sw $ra,($sp)

18504:  riSkipWhiteLoop:
    # read a character
18504#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
18508#    subu $t0,$v0,32
18512#    bgt $t0,$zero,nonWhite
18513##...slt $at,$zero,$t0
18517##...bne $at,$zero,18560
18520#    beq $t0,$zero,riSkipWhiteLoop # start over if space
18524#    subu $t0,$v0,10
18528#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
18532#    subu $t0,$v0,9
18536#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
18540#    subu $t0,$v0,13
18544#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
18548#    subu $t0,$v0,12
18552#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
18556#    j badIntegerFormat # illegal integer char: abort program

18560:  nonWhite:
18560#    subu $t0,$v0,'-'
18564#    li $t4,1 # final multiplier
18568#    bne $t0,$zero,helpReadInt # go read
18572#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
18576#    jal readLogicalChar

18580:  helpReadInt:
18580#    li $t2,10
18584#    subu $t1,$v0,'0' # convert digit to 0-9 value
18588#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
18589##...sltu $at,$t1,$t2
18593##...beq $at,$zero,20840
18596#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

18600:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

18600#    jal readLogicalChar # read next character
18604#    subu $t1,$v0,'0' # convert digit to 0-9 value
18608#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
18609##...sltu $at,$t1,$t2
18613##...beq $at,$zero,18632

18616#    mul $t3,$t3,$t2 # multiply old value by 10
18617##...mult $t3,$t2
18621##...mflo $t3
18624#    addu $t3,$t3,$t1 # add in value of new digit
18628#    j digitLoop

18632:  doneDigitLoop:

    # "push back" unused character into queue
18632#    sw $v0,lastCharRead
