##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
560:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
560#    lw $t0,-8($s2) # get word with hash bits from this
564#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
568#    addu $t0,$t1

572#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
576:mth_equals_Object:
576#    move $t0,$s2 # first pointer (this)
580#    lw $t1,($sp) # second pointer
584#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
585##...subu $at,$t0,$t1
589##...sltiu $t0,$at,1

592#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
596:mth_hashCode_String:
596#    move $t0,$s2 # put this pointer in t0

600#    li $t2,0 # current hash value
604#    lw $t1,-4($t0) # negative of number of characters in string
608#    beq $t1,$zero,done_hashCode_String # if zero length => done
612#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
616#    and $t0,0xfffffffc # adjust for padding
617##...lui $at,65535
621##...ori $at,$at,0xfffc
625##...and $t0,$t0,$at
628#    subu $t1,$t0,$t1 # address at end of string +12
632:loop_hashCode_String:    
632#    sll $t4,$t2,5 # multiply by 32
636#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
640#    lbu $t3,-12($t0) # current character
644#    addu $t2,$t3 # add in current character
648#    addu $t0,1 # go to next character's address
652#    bne $t0,$t1,loop_hashCode_String # loop back if more
656:done_hashCode_String:    

    # push int on stack
656#    move $t0, $t2 # put $t2 in return slot
660#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
664:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
664#    subu $sp,4
668#    sw $ra,($sp)
    
    # get hash value
672#    lw $t2,-12($s2) # vtable address
676#    lw $t0,($t2) # method address
680#    jalr $t0
684#    subu $sp,8 # push result (int in $t0) on stack
688#    sw $s5,4($sp)
692#    sw $t0,($sp)

    # compute print-size of hash value
696#    li $t0, 1
700#    lw $t1, ($sp)
704#    srl $t1,$t1,4
708#    beq $t1,$zero,toString_skip_loop
712:toString_loop_top:
712#    addu $t0,1
716#    srl $t1,$t1,4
720#    bne $t1,$zero,toString_loop_top
724:toString_skip_loop:
724#    subu $sp,8
728#    sw $s5,4($sp)
732#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
736#    lw $t2,-12($s2) # vtable address
740#    move $t0,$t2
744:toString_checkTagBit:
744#    subu $t0,1
748#    lb $t1,($t0)
752#    and $t1,0x80
753##...lui $at,0
757##...ori $at,$at,0x80
761##...and $t1,$t1,$at
764#    beq $t1,$zero,toString_checkTagBit
768#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
772#    subu $sp,8
776#    sw $t1,($sp)
780#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
784#    move $s7,$zero # -4 offset header word
788#    lw $t4,8($sp) # bytes for hash value
792#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
796#    addu $t4,8
800#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
804#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

808#    li $t0,CLASS_String # store string vtable address into ...
812#    sw $t0,-12($s7) # ... -12 offset in object header
816#    lw $t2,-12($s2) # our object's vtable address
820#    lw $t5,4($sp) # number characters in prefix
824#    lw $t1,12($sp) # number of characters in hashcode
828#    addu $t3,$t1,$t5 # number of characters in string ...
832#    addu $t3,1 # ... including the '@' character
836#    subu $t0,$zero,$t3 # store negated length into ...
840#    sw $t0,-4($s7) # ... -4 offset header word
844#    lw $t0,-8($s7) # get -8 offset header-word
848#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
849##...slt $at,$t0,$zero
853##...beq $at,$zero,872
856#    and $t0,0xff # mask off object's hash value ...
857##...lui $at,0
861##...ori $at,$at,0xff
865##...and $t0,$t0,$at
868#    sw $t0,-8($s7) # ... and store back into -8 header-word
872:skipMask_toString:
872#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
876#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
880#    subu $t4,$t2,$t5
884:toString_copyLoop:    
884#    lb $t3,($t4)
888#    and $t3,0x7f # mask off sign bit (in case first word)
889##...lui $at,0
893##...ori $at,$at,0x7f
897##...and $t3,$t3,$at
