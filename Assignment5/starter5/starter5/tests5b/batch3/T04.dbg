4268#    move $s7,$zero
4272#    jal newObject

    # get n from string.
4276#    lw $t1,8($sp)

    # store "String" tag into class field
4280#    la $t0,CLASS_String
4284#    sw $t0,-12($s7)
        
    # mask off hash bits, if needed
4288#    lw $t4,-8($s7) # # data words in source string
4292#    bge $t4,$zero,skipMask_intToChar # don't strip hash code if not there
