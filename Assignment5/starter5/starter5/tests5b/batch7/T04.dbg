##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1096:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
1096#    lw $t0,-8($s2) # get word with hash bits from this
1100#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
1104#    addu $t0,$t1

1108#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1112:mth_equals_Object:
1112#    move $t0,$s2 # first pointer (this)
1116#    lw $t1,($sp) # second pointer
1120#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
1121##...subu $at,$t0,$t1
1125##...sltiu $t0,$at,1

1128#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1132:mth_hashCode_String:
1132#    move $t0,$s2 # put this pointer in t0

1136#    li $t2,0 # current hash value
1140#    lw $t1,-4($t0) # negative of number of characters in string
1144#    beq $t1,$zero,done_hashCode_String # if zero length => done
1148#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
1152#    and $t0,0xfffffffc # adjust for padding
1153##...lui $at,65535
1157##...ori $at,$at,0xfffc
1161##...and $t0,$t0,$at
1164#    subu $t1,$t0,$t1 # address at end of string +12
1168:loop_hashCode_String:    
