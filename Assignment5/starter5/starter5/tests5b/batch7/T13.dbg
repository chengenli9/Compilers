    .asciiz "ERROR: null-pointer exception\n"
4575:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
4623:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
4644:gcMsg: 
      .asciiz "\nGC!\n"
4650:gcCountMsg: 
      .asciiz "Number of garbage collections: "

4682:nullStr:
    .asciiz "null"
4687:trueString:
    .asciiz "true"
4692:falseString:
    .asciiz "false"
4698:exitString:
