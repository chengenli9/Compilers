1416:  nonWhite:
1416#    subu $t0,$v0,'-'
1420#    li $t4,1 # final multiplier
1424#    bne $t0,$zero,helpReadInt # go read
1428#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
