##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
2380:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
2380#    lw $t0,-8($s2) # get word with hash bits from this
2384#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
2388#    addu $t0,$t1

2392#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
2396:mth_equals_Object:
2396#    move $t0,$s2 # first pointer (this)
2400#    lw $t1,($sp) # second pointer
2404#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
2405##...subu $at,$t0,$t1
2409##...sltiu $t0,$at,1

2412#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
2416:mth_hashCode_String:
2416#    move $t0,$s2 # put this pointer in t0

2420#    li $t2,0 # current hash value
2424#    lw $t1,-4($t0) # negative of number of characters in string
2428#    beq $t1,$zero,done_hashCode_String # if zero length => done
2432#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
2436#    and $t0,0xfffffffc # adjust for padding
2437##...lui $at,65535
2441##...ori $at,$at,0xfffc
2445##...and $t0,$t0,$at
2448#    subu $t1,$t0,$t1 # address at end of string +12
2452:loop_hashCode_String:    
2452#    sll $t4,$t2,5 # multiply by 32
2456#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
2460#    lbu $t3,-12($t0) # current character
2464#    addu $t2,$t3 # add in current character
2468#    addu $t0,1 # go to next character's address
2472#    bne $t0,$t1,loop_hashCode_String # loop back if more
2476:done_hashCode_String:    

    # push int on stack
2476#    move $t0, $t2 # put $t2 in return slot
2480#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
2484:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
2484#    subu $sp,4
2488#    sw $ra,($sp)
    
    # get hash value
2492#    lw $t2,-12($s2) # vtable address
2496#    lw $t0,($t2) # method address
2500#    jalr $t0
2504#    subu $sp,8 # push result (int in $t0) on stack
2508#    sw $s5,4($sp)
2512#    sw $t0,($sp)

    # compute print-size of hash value
2516#    li $t0, 1
2520#    lw $t1, ($sp)
2524#    srl $t1,$t1,4
2528#    beq $t1,$zero,toString_skip_loop
2532:toString_loop_top:
2532#    addu $t0,1
2536#    srl $t1,$t1,4
2540#    bne $t1,$zero,toString_loop_top
2544:toString_skip_loop:
2544#    subu $sp,8
2548#    sw $s5,4($sp)
2552#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
2556#    lw $t2,-12($s2) # vtable address
2560#    move $t0,$t2
2564:toString_checkTagBit:
2564#    subu $t0,1
2568#    lb $t1,($t0)
2572#    and $t1,0x80
2573##...lui $at,0
2577##...ori $at,$at,0x80
2581##...and $t1,$t1,$at
2584#    beq $t1,$zero,toString_checkTagBit
2588#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
2592#    subu $sp,8
2596#    sw $t1,($sp)
2600#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
2604#    move $s7,$zero # -4 offset header word
2608#    lw $t4,8($sp) # bytes for hash value
2612#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
2616#    addu $t4,8
2620#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
2624#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

2628#    li $t0,CLASS_String # store string vtable address into ...
2632#    sw $t0,-12($s7) # ... -12 offset in object header
2636#    lw $t2,-12($s2) # our object's vtable address
2640#    lw $t5,4($sp) # number characters in prefix
2644#    lw $t1,12($sp) # number of characters in hashcode
2648#    addu $t3,$t1,$t5 # number of characters in string ...
2652#    addu $t3,1 # ... including the '@' character
2656#    subu $t0,$zero,$t3 # store negated length into ...
2660#    sw $t0,-4($s7) # ... -4 offset header word
2664#    lw $t0,-8($s7) # get -8 offset header-word
2668#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
2669##...slt $at,$t0,$zero
2673##...beq $at,$zero,2692
2676#    and $t0,0xff # mask off object's hash value ...
2677##...lui $at,0
2681##...ori $at,$at,0xff
2685##...and $t0,$t0,$at
2688#    sw $t0,-8($s7) # ... and store back into -8 header-word
2692:skipMask_toString:
2692#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
2696#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
2700#    subu $t4,$t2,$t5
2704:toString_copyLoop:    
2704#    lb $t3,($t4)
2708#    and $t3,0x7f # mask off sign bit (in case first word)
2709##...lui $at,0
2713##...ori $at,$at,0x7f
2717##...and $t3,$t3,$at
2720#    sb $t3,-8($t0)
2724#    addu $t4,1
