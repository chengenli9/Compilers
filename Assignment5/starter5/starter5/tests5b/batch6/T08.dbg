1068#    lw $t0,($sp) # second parameter
1072#    beq $t0,$zero,goEsFalse # go return false if null
1076#    lw $t1,-12($t0) # vtable pointer
1080#    la $t2,CLASS_String # string vtable pointer
1084#    bne $t1,$t2,goEsFalse # go return false if not a string
