##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
9136:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
9136#    lw $t0,-8($s2) # get word with hash bits from this
9140#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
9144#    addu $t0,$t1

9148#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
9152:mth_equals_Object:
9152#    move $t0,$s2 # first pointer (this)
9156#    lw $t1,($sp) # second pointer
9160#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
9161##...subu $at,$t0,$t1
9165##...sltiu $t0,$at,1

9168#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
9172:mth_hashCode_String:
9172#    move $t0,$s2 # put this pointer in t0

9176#    li $t2,0 # current hash value
9180#    lw $t1,-4($t0) # negative of number of characters in string
9184#    beq $t1,$zero,done_hashCode_String # if zero length => done
9188#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
9192#    and $t0,0xfffffffc # adjust for padding
9193##...lui $at,65535
9197##...ori $at,$at,0xfffc
9201##...and $t0,$t0,$at
9204#    subu $t1,$t0,$t1 # address at end of string +12
9208:loop_hashCode_String:    
9208#    sll $t4,$t2,5 # multiply by 32
9212#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
9216#    lbu $t3,-12($t0) # current character
9220#    addu $t2,$t3 # add in current character
9224#    addu $t0,1 # go to next character's address
9228#    bne $t0,$t1,loop_hashCode_String # loop back if more
9232:done_hashCode_String:    

    # push int on stack
9232#    move $t0, $t2 # put $t2 in return slot
9236#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
9240:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
9240#    subu $sp,4
9244#    sw $ra,($sp)
    
    # get hash value
9248#    lw $t2,-12($s2) # vtable address
9252#    lw $t0,($t2) # method address
9256#    jalr $t0
9260#    subu $sp,8 # push result (int in $t0) on stack
9264#    sw $s5,4($sp)
9268#    sw $t0,($sp)

    # compute print-size of hash value
9272#    li $t0, 1
9276#    lw $t1, ($sp)
9280#    srl $t1,$t1,4
9284#    beq $t1,$zero,toString_skip_loop
9288:toString_loop_top:
9288#    addu $t0,1
9292#    srl $t1,$t1,4
9296#    bne $t1,$zero,toString_loop_top
9300:toString_skip_loop:
9300#    subu $sp,8
9304#    sw $s5,4($sp)
9308#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
9312#    lw $t2,-12($s2) # vtable address
9316#    move $t0,$t2
9320:toString_checkTagBit:
9320#    subu $t0,1
9324#    lb $t1,($t0)
9328#    and $t1,0x80
9329##...lui $at,0
9333##...ori $at,$at,0x80
9337##...and $t1,$t1,$at
9340#    beq $t1,$zero,toString_checkTagBit
9344#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
9348#    subu $sp,8
9352#    sw $t1,($sp)
9356#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
9360#    move $s7,$zero # -4 offset header word
9364#    lw $t4,8($sp) # bytes for hash value
9368#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
9372#    addu $t4,8
9376#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
9380#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

9384#    li $t0,CLASS_String # store string vtable address into ...
9388#    sw $t0,-12($s7) # ... -12 offset in object header
9392#    lw $t2,-12($s2) # our object's vtable address
9396#    lw $t5,4($sp) # number characters in prefix
9400#    lw $t1,12($sp) # number of characters in hashcode
9404#    addu $t3,$t1,$t5 # number of characters in string ...
9408#    addu $t3,1 # ... including the '@' character
9412#    subu $t0,$zero,$t3 # store negated length into ...
9416#    sw $t0,-4($s7) # ... -4 offset header word
9420#    lw $t0,-8($s7) # get -8 offset header-word
9424#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
9425##...slt $at,$t0,$zero
9429##...beq $at,$zero,9448
