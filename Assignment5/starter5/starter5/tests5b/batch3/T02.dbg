8184:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

8184#    jal readLogicalChar # read next character
8188#    subu $t1,$v0,'0' # convert digit to 0-9 value
8192#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
8193##...sltu $at,$t1,$t2
8197##...beq $at,$zero,8216

8200#    mul $t3,$t3,$t2 # multiply old value by 10
8201##...mult $t3,$t2
8205##...mflo $t3
8208#    addu $t3,$t3,$t1 # add in value of new digit
8212#    j digitLoop

8216:  doneDigitLoop:

    # "push back" unused character into queue
8216#    sw $v0,lastCharRead
