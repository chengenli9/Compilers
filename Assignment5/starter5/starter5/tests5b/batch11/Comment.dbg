########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
5572:vm_init:

    # mark bottom of stack
5572#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
5576#    move $s2,$zero

    #set up the "five" register
5580#    li $s5,5

5584#    la $s3,seg0_start
5588#    la $s4,seg0_end
5589##...lui $s4,16
5593##...addiu $s4,$s4,6828
    
    # return
5596#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
5600:divide:
    # get parameters; abort if divisor zero
5600#    lw $t0,($sp)
5604#    lw $t1,8($sp)
5608#    beq $t0,$zero,divByZeroError
    
    # perform division
5612#    div $t1,$t0
5616#    mflo $t0

    # store result, adjust stack and return
5620#    addu $sp,$sp,8 # adjust stack
5624#    sw $t0,($sp) # store result
5628#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
5632:remainder:
    # get parameters; abort if divisor zero
5632#    lw $t0,($sp)
5636#    lw $t1,8($sp)
5640#    beq $t0,$zero,divByZeroError
    
    # perform division
5644#    div $t1,$t0
5648#    mfhi $t0

    # store result, adjust stack and return
5652#    addu $sp,$sp,8 # adjust stack
5656#    sw $t0,($sp) # store result
5660#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
5664:checkCast:
    # get object, allow immediately if null
5664#    lw $t2,($sp)
5668#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
5672#    lw $t2,-12($t2) # vtable address
5676#    bge $t2,$t1,castException
5677##...slt $at,$t2,$t1
5681##...beq $at,$zero,5852
5684#    blt $t2,$t0,castException
5685##...slt $at,$t2,$t0
5689##...bne $at,$zero,5852
    
    # return, leaving object unchanged on stack
5692:  checkCastReturn:    
5692#    jr $ra    
