###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
868:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
868#    lw $t0,-8($s2) # get word with hash bits from this
872#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
876#    addu $t0,$t1

880#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
884:mth_equals_Object:
884#    move $t0,$s2 # first pointer (this)
888#    lw $t1,($sp) # second pointer
892#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
893##...subu $at,$t0,$t1
897##...sltiu $t0,$at,1

900#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
904:mth_hashCode_String:
904#    move $t0,$s2 # put this pointer in t0

908#    li $t2,0 # current hash value
912#    lw $t1,-4($t0) # negative of number of characters in string
916#    beq $t1,$zero,done_hashCode_String # if zero length => done
920#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
924#    and $t0,0xfffffffc # adjust for padding
925##...lui $at,65535
929##...ori $at,$at,0xfffc
933##...and $t0,$t0,$at
936#    subu $t1,$t0,$t1 # address at end of string +12
940:loop_hashCode_String:    
940#    sll $t4,$t2,5 # multiply by 32
944#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
948#    lbu $t3,-12($t0) # current character
952#    addu $t2,$t3 # add in current character
956#    addu $t0,1 # go to next character's address
960#    bne $t0,$t1,loop_hashCode_String # loop back if more
964:done_hashCode_String:    

    # push int on stack
964#    move $t0, $t2 # put $t2 in return slot
968#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
972:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
972#    subu $sp,4
976#    sw $ra,($sp)
    
    # get hash value
980#    lw $t2,-12($s2) # vtable address
984#    lw $t0,($t2) # method address
988#    jalr $t0
992#    subu $sp,8 # push result (int in $t0) on stack
996#    sw $s5,4($sp)
1000#    sw $t0,($sp)

    # compute print-size of hash value
1004#    li $t0, 1
1008#    lw $t1, ($sp)
1012#    srl $t1,$t1,4
1016#    beq $t1,$zero,toString_skip_loop
1020:toString_loop_top:
1020#    addu $t0,1
1024#    srl $t1,$t1,4
1028#    bne $t1,$zero,toString_loop_top
1032:toString_skip_loop:
1032#    subu $sp,8
1036#    sw $s5,4($sp)
1040#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
1044#    lw $t2,-12($s2) # vtable address
1048#    move $t0,$t2
1052:toString_checkTagBit:
1052#    subu $t0,1
1056#    lb $t1,($t0)
1060#    and $t1,0x80
1061##...lui $at,0
1065##...ori $at,$at,0x80
1069##...and $t1,$t1,$at
1072#    beq $t1,$zero,toString_checkTagBit
1076#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
1080#    subu $sp,8
1084#    sw $t1,($sp)
1088#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
1092#    move $s7,$zero # -4 offset header word
1096#    lw $t4,8($sp) # bytes for hash value
1100#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
1104#    addu $t4,8
1108#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
1112#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

1116#    li $t0,CLASS_String # store string vtable address into ...
1120#    sw $t0,-12($s7) # ... -12 offset in object header
1124#    lw $t2,-12($s2) # our object's vtable address
1128#    lw $t5,4($sp) # number characters in prefix
1132#    lw $t1,12($sp) # number of characters in hashcode
1136#    addu $t3,$t1,$t5 # number of characters in string ...
1140#    addu $t3,1 # ... including the '@' character
1144#    subu $t0,$zero,$t3 # store negated length into ...
1148#    sw $t0,-4($s7) # ... -4 offset header word
1152#    lw $t0,-8($s7) # get -8 offset header-word
1156#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
1157##...slt $at,$t0,$zero
1161##...beq $at,$zero,1180
1164#    and $t0,0xff # mask off object's hash value ...
1165##...lui $at,0
1169##...ori $at,$at,0xff
1173##...and $t0,$t0,$at
1176#    sw $t0,-8($s7) # ... and store back into -8 header-word
1180:skipMask_toString:
1180#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
1184#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
1188#    subu $t4,$t2,$t5
1192:toString_copyLoop:    
1192#    lb $t3,($t4)
1196#    and $t3,0x7f # mask off sign bit (in case first word)
1197##...lui $at,0
1201##...ori $at,$at,0x7f
1205##...and $t3,$t3,$at
1208#    sb $t3,-8($t0)
1212#    addu $t4,1
1216#    addu $t0,1
1220#    blt $t4,$t2,toString_copyLoop
1221##...slt $at,$t4,$t2
1225##...bne $at,$zero,1192

    # copy the '@' sign
1228#    li $t3,'@'
1232#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
1236#    addu $t2,$t0,$t1 # address of last byte in string to store +8
1240#    lw $t3,20($sp) # hash code to print
1244:toString_hashCopyLoop:
1244#    and $t4,$t3,0xf
1248#    srl $t3,4
1252#    lb $t4,hexChars($t4)
1256#    sb $t4,-8($t2)
1260#    subu $t2,$t2,1
1264#    bgt $t2,$t0,toString_hashCopyLoop
1265##...slt $at,$t0,$t2
1269##...bne $at,$zero,1244

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
1272#    addu $sp,28
1276#    lw $ra,($sp)
1280#    addu $sp,4
1284#    move $t0, $s7 # return string we created
1288#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
1292:mth_equals_String:
    
    # quick test for obvious false
1292#    lw $t0,($sp) # second parameter
1296#    beq $t0,$zero,goEsFalse # go return false if null
1300#    lw $t1,-12($t0) # vtable pointer
1304#    la $t2,CLASS_String # string vtable pointer
1308#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
1312#    subu $sp,12
1316#    sw $ra,8($sp)
1320#    sw $s2,4($sp)
1324#    sw $t0,($sp)
1328#    jal mth_compareTo_String
1332#    lw $s2, 4($sp) #restore this pointer and pop parameters
1336#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
1340#    seq $t0,$t0,$zero
1341##...subu $at,$t0,$zero
1345##...sltiu $t0,$at,1

    # pop return address and return $t0
1348#    lw $ra,($sp)
1352#    addu $sp,4

1356#    jr $ra # return
    
1360:goEsFalse:
    # put 0 in $t0 and return
1360#    li $t0, 0
1364#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
1368:mth_toString_String:
    #we are a string, so return this.
1368#    move $t0, $s2
1372#    jr $ra

###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
1376:mth_readLine_Lib:
    
1376#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
1380#    sw $ra, 4($sp) # save $ra
1384#    move $t1,$sp # save "original" sp

1388:  doRead:

    # read the character
1388#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
1392#    subu $t2,$v0,13
1396#    bne $t2,$zero,notReturnRL
1400#    jal readLogicalChar
1404#    subu $t2,$v0,10 # check for newline
1408#    beq $t2,$zero,foundNewLine
1412#    sw $v0,lastCharRead # push back character into queue
1416#    j foundNewLine # go process the line

1420:  notReturnRL:

    # at this point, $v0 has our character

1420#    subu $t0,$v0,10
1424#    beq $t0,$zero,foundNewLine
1428#    blt $v0,$zero,foundEof
1429##...slt $at,$v0,$zero
1433##...bne $at,$zero,1448

    # we have a character, so push it onto stack
1436#    subu $sp,$sp,4
1440#    sw $v0,($sp)

    # loop back up to get next character
1444#    j doRead

1448:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
1448#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
1452#    li $s7, 0 # return-value: null
1456#    j rlReturn # return

1460:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
1460#    subu $t0,$t1,$sp # number of chars we read (times 4)
1464#    srl $s6,$t0,2 # number of words on stack with chars
1468#    subu $sp,$sp,4 # push char-count ...
1472#    sw $s6,($sp) # ... onto stack
1476#    addu $t2,$t0,5 # GC tag, incl. for count-word
1480#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
1484#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
1488#    srl $s6,$s6,2  # data words in object
1492#    move $s7,$zero # object words in object
1496#    jal newObject  # allocate space
    
    # store header words
1500#    la $t0,CLASS_String
1504#    sw $t0,-12($s7)# store class tag (String) into object
1508#    lw $t2,4($sp) # char-count
1512#    sll $t1,$t2,2 # 4 times number of chars
1516#    subu $t2,$zero,$t2 # negative of char-count
1520#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
1524#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
1528#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
1529##...slt $at,$t0,$zero
1533##...beq $at,$zero,1552
1536#    and $t0,0xff # mask off object's hash value ...
1537##...lui $at,0
1541##...ori $at,$at,0xff
1545##...and $t0,$t0,$at
1548#    sw $t0,-8($s7) # ... and store back into -8 header-word
1552:  skipMask_readLine:

1552#    sll $t0,$t0,2 # data bytes in object
1556#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
1560#    subu $t0,$t0,$t2 # place to store last character (plus 9)
1564#    addu $sp,$sp,8 # pop redundant object-pointer and count
1568#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

1572#    beq $sp,$t1,rlReturn
1576:  charCopyLoop:
1576#    lw $t2,($sp)
1580#    sb $t2,-9($t0)
1584#    addu $sp,$sp,4
1588#    subu $t0,$t0,1
1592#    bne $sp,$t1,charCopyLoop
1596:  rlReturn:

1596#    lw $ra, 4($sp)
1600#    addu $sp, 8   # pop $ra and pointless word off stack
1604#    move $t0, $s7 # return string we allocated in $s7
1608#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
1612:mth_readInt_Lib:

    # save $ra by pushing onto stack
1612#    subu $sp,$sp,4
1616#    sw $ra,($sp)

1620:  riSkipWhiteLoop:
    # read a character
1620#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
1624#    subu $t0,$v0,32
1628#    bgt $t0,$zero,nonWhite
1629##...slt $at,$zero,$t0
1633##...bne $at,$zero,1676
1636#    beq $t0,$zero,riSkipWhiteLoop # start over if space
1640#    subu $t0,$v0,10
1644#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
1648#    subu $t0,$v0,9
1652#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
1656#    subu $t0,$v0,13
1660#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
1664#    subu $t0,$v0,12
1668#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
1672#    j badIntegerFormat # illegal integer char: abort program

1676:  nonWhite:
1676#    subu $t0,$v0,'-'
1680#    li $t4,1 # final multiplier
1684#    bne $t0,$zero,helpReadInt # go read
1688#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
1692#    jal readLogicalChar

1696:  helpReadInt:
1696#    li $t2,10
1700#    subu $t1,$v0,'0' # convert digit to 0-9 value
1704#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
1705##...sltu $at,$t1,$t2
1709##...beq $at,$zero,3992
1712#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

1716:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

1716#    jal readLogicalChar # read next character
1720#    subu $t1,$v0,'0' # convert digit to 0-9 value
1724#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
1725##...sltu $at,$t1,$t2
1729##...beq $at,$zero,1748

1732#    mul $t3,$t3,$t2 # multiply old value by 10
1733##...mult $t3,$t2
