##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1580:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
1580#    lw $t0,-8($s2) # get word with hash bits from this
1584#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
1588#    addu $t0,$t1

1592#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1596:mth_equals_Object:
1596#    move $t0,$s2 # first pointer (this)
1600#    lw $t1,($sp) # second pointer
1604#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
1605##...subu $at,$t0,$t1
1609##...sltiu $t0,$at,1

1612#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1616:mth_hashCode_String:
1616#    move $t0,$s2 # put this pointer in t0

1620#    li $t2,0 # current hash value
1624#    lw $t1,-4($t0) # negative of number of characters in string
1628#    beq $t1,$zero,done_hashCode_String # if zero length => done
1632#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
1636#    and $t0,0xfffffffc # adjust for padding
1637##...lui $at,65535
1641##...ori $at,$at,0xfffc
1645##...and $t0,$t0,$at
1648#    subu $t1,$t0,$t1 # address at end of string +12
1652:loop_hashCode_String:    
1652#    sll $t4,$t2,5 # multiply by 32
1656#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
1660#    lbu $t3,-12($t0) # current character
1664#    addu $t2,$t3 # add in current character
1668#    addu $t0,1 # go to next character's address
1672#    bne $t0,$t1,loop_hashCode_String # loop back if more
1676:done_hashCode_String:    

    # push int on stack
1676#    move $t0, $t2 # put $t2 in return slot
1680#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
1684:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
1684#    subu $sp,4
1688#    sw $ra,($sp)
    
    # get hash value
1692#    lw $t2,-12($s2) # vtable address
1696#    lw $t0,($t2) # method address
1700#    jalr $t0
1704#    subu $sp,8 # push result (int in $t0) on stack
1708#    sw $s5,4($sp)
1712#    sw $t0,($sp)

    # compute print-size of hash value
1716#    li $t0, 1
1720#    lw $t1, ($sp)
1724#    srl $t1,$t1,4
1728#    beq $t1,$zero,toString_skip_loop
1732:toString_loop_top:
1732#    addu $t0,1
1736#    srl $t1,$t1,4
1740#    bne $t1,$zero,toString_loop_top
1744:toString_skip_loop:
1744#    subu $sp,8
1748#    sw $s5,4($sp)
1752#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
1756#    lw $t2,-12($s2) # vtable address
1760#    move $t0,$t2
1764:toString_checkTagBit:
1764#    subu $t0,1
1768#    lb $t1,($t0)
1772#    and $t1,0x80
1773##...lui $at,0
1777##...ori $at,$at,0x80
1781##...and $t1,$t1,$at
1784#    beq $t1,$zero,toString_checkTagBit
1788#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
1792#    subu $sp,8
1796#    sw $t1,($sp)
1800#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
1804#    move $s7,$zero # -4 offset header word
1808#    lw $t4,8($sp) # bytes for hash value
1812#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
1816#    addu $t4,8
1820#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
1824#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

1828#    li $t0,CLASS_String # store string vtable address into ...
1832#    sw $t0,-12($s7) # ... -12 offset in object header
1836#    lw $t2,-12($s2) # our object's vtable address
1840#    lw $t5,4($sp) # number characters in prefix
1844#    lw $t1,12($sp) # number of characters in hashcode
1848#    addu $t3,$t1,$t5 # number of characters in string ...
1852#    addu $t3,1 # ... including the '@' character
1856#    subu $t0,$zero,$t3 # store negated length into ...
1860#    sw $t0,-4($s7) # ... -4 offset header word
1864#    lw $t0,-8($s7) # get -8 offset header-word
1868#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
1869##...slt $at,$t0,$zero
1873##...beq $at,$zero,1892
1876#    and $t0,0xff # mask off object's hash value ...
1877##...lui $at,0
1881##...ori $at,$at,0xff
1885##...and $t0,$t0,$at
1888#    sw $t0,-8($s7) # ... and store back into -8 header-word
1892:skipMask_toString:
1892#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
1896#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
1900#    subu $t4,$t2,$t5
1904:toString_copyLoop:    
1904#    lb $t3,($t4)
1908#    and $t3,0x7f # mask off sign bit (in case first word)
1909##...lui $at,0
1913##...ori $at,$at,0x7f
1917##...and $t3,$t3,$at
1920#    sb $t3,-8($t0)
1924#    addu $t4,1
1928#    addu $t0,1
1932#    blt $t4,$t2,toString_copyLoop
1933##...slt $at,$t4,$t2
1937##...bne $at,$zero,1904

    # copy the '@' sign
1940#    li $t3,'@'
1944#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
1948#    addu $t2,$t0,$t1 # address of last byte in string to store +8
1952#    lw $t3,20($sp) # hash code to print
1956:toString_hashCopyLoop:
1956#    and $t4,$t3,0xf
1960#    srl $t3,4
1964#    lb $t4,hexChars($t4)
1968#    sb $t4,-8($t2)
1972#    subu $t2,$t2,1
1976#    bgt $t2,$t0,toString_hashCopyLoop
1977##...slt $at,$t0,$t2
1981##...bne $at,$zero,1956

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
1984#    addu $sp,28
1988#    lw $ra,($sp)
1992#    addu $sp,4
1996#    move $t0, $s7 # return string we created
2000#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
2004:mth_equals_String:
    
    # quick test for obvious false
2004#    lw $t0,($sp) # second parameter
2008#    beq $t0,$zero,goEsFalse # go return false if null
2012#    lw $t1,-12($t0) # vtable pointer
2016#    la $t2,CLASS_String # string vtable pointer
2020#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
2024#    subu $sp,12
2028#    sw $ra,8($sp)
2032#    sw $s2,4($sp)
2036#    sw $t0,($sp)
2040#    jal mth_compareTo_String
2044#    lw $s2, 4($sp) #restore this pointer and pop parameters
2048#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
2052#    seq $t0,$t0,$zero
2053##...subu $at,$t0,$zero
2057##...sltiu $t0,$at,1

    # pop return address and return $t0
2060#    lw $ra,($sp)
2064#    addu $sp,4

2068#    jr $ra # return
    
2072:goEsFalse:
    # put 0 in $t0 and return
2072#    li $t0, 0
2076#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
2080:mth_toString_String:
    #we are a string, so return this.
2080#    move $t0, $s2
2084#    jr $ra

###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
2088:mth_readLine_Lib:
    
2088#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
2092#    sw $ra, 4($sp) # save $ra
2096#    move $t1,$sp # save "original" sp

2100:  doRead:

    # read the character
2100#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
2104#    subu $t2,$v0,13
2108#    bne $t2,$zero,notReturnRL
2112#    jal readLogicalChar
2116#    subu $t2,$v0,10 # check for newline
2120#    beq $t2,$zero,foundNewLine
2124#    sw $v0,lastCharRead # push back character into queue
2128#    j foundNewLine # go process the line

2132:  notReturnRL:

    # at this point, $v0 has our character

2132#    subu $t0,$v0,10
2136#    beq $t0,$zero,foundNewLine
2140#    blt $v0,$zero,foundEof
2141##...slt $at,$v0,$zero
2145##...bne $at,$zero,2160

    # we have a character, so push it onto stack
2148#    subu $sp,$sp,4
2152#    sw $v0,($sp)

    # loop back up to get next character
2156#    j doRead

2160:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
2160#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
2164#    li $s7, 0 # return-value: null
2168#    j rlReturn # return

2172:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
2172#    subu $t0,$t1,$sp # number of chars we read (times 4)
2176#    srl $s6,$t0,2 # number of words on stack with chars
2180#    subu $sp,$sp,4 # push char-count ...
2184#    sw $s6,($sp) # ... onto stack
2188#    addu $t2,$t0,5 # GC tag, incl. for count-word
2192#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
2196#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
2200#    srl $s6,$s6,2  # data words in object
2204#    move $s7,$zero # object words in object
2208#    jal newObject  # allocate space
    
    # store header words
2212#    la $t0,CLASS_String
2216#    sw $t0,-12($s7)# store class tag (String) into object
2220#    lw $t2,4($sp) # char-count
2224#    sll $t1,$t2,2 # 4 times number of chars
2228#    subu $t2,$zero,$t2 # negative of char-count
2232#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
2236#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
2240#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
2241##...slt $at,$t0,$zero
2245##...beq $at,$zero,2264
2248#    and $t0,0xff # mask off object's hash value ...
2249##...lui $at,0
2253##...ori $at,$at,0xff
2257##...and $t0,$t0,$at
2260#    sw $t0,-8($s7) # ... and store back into -8 header-word
2264:  skipMask_readLine:

2264#    sll $t0,$t0,2 # data bytes in object
2268#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
2272#    subu $t0,$t0,$t2 # place to store last character (plus 9)
2276#    addu $sp,$sp,8 # pop redundant object-pointer and count
2280#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

2284#    beq $sp,$t1,rlReturn
2288:  charCopyLoop:
2288#    lw $t2,($sp)
2292#    sb $t2,-9($t0)
2296#    addu $sp,$sp,4
2300#    subu $t0,$t0,1
2304#    bne $sp,$t1,charCopyLoop
2308:  rlReturn:

2308#    lw $ra, 4($sp)
