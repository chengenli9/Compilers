##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
7296:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
7296#    lw $t0,-8($s2) # get word with hash bits from this
7300#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
7304#    addu $t0,$t1

7308#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
7312:mth_equals_Object:
7312#    move $t0,$s2 # first pointer (this)
7316#    lw $t1,($sp) # second pointer
7320#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
7321##...subu $at,$t0,$t1
7325##...sltiu $t0,$at,1

7328#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
7332:mth_hashCode_String:
7332#    move $t0,$s2 # put this pointer in t0

7336#    li $t2,0 # current hash value
7340#    lw $t1,-4($t0) # negative of number of characters in string
7344#    beq $t1,$zero,done_hashCode_String # if zero length => done
7348#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
7352#    and $t0,0xfffffffc # adjust for padding
7353##...lui $at,65535
7357##...ori $at,$at,0xfffc
7361##...and $t0,$t0,$at
7364#    subu $t1,$t0,$t1 # address at end of string +12
7368:loop_hashCode_String:    
7368#    sll $t4,$t2,5 # multiply by 32
7372#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
7376#    lbu $t3,-12($t0) # current character
7380#    addu $t2,$t3 # add in current character
7384#    addu $t0,1 # go to next character's address
7388#    bne $t0,$t1,loop_hashCode_String # loop back if more
7392:done_hashCode_String:    

    # push int on stack
7392#    move $t0, $t2 # put $t2 in return slot
7396#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
7400:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
7400#    subu $sp,4
7404#    sw $ra,($sp)
    
    # get hash value
7408#    lw $t2,-12($s2) # vtable address
7412#    lw $t0,($t2) # method address
7416#    jalr $t0
7420#    subu $sp,8 # push result (int in $t0) on stack
7424#    sw $s5,4($sp)
7428#    sw $t0,($sp)

    # compute print-size of hash value
7432#    li $t0, 1
7436#    lw $t1, ($sp)
7440#    srl $t1,$t1,4
7444#    beq $t1,$zero,toString_skip_loop
7448:toString_loop_top:
7448#    addu $t0,1
7452#    srl $t1,$t1,4
7456#    bne $t1,$zero,toString_loop_top
7460:toString_skip_loop:
7460#    subu $sp,8
7464#    sw $s5,4($sp)
7468#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
7472#    lw $t2,-12($s2) # vtable address
7476#    move $t0,$t2
7480:toString_checkTagBit:
7480#    subu $t0,1
7484#    lb $t1,($t0)
7488#    and $t1,0x80
7489##...lui $at,0
7493##...ori $at,$at,0x80
7497##...and $t1,$t1,$at
7500#    beq $t1,$zero,toString_checkTagBit
7504#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
7508#    subu $sp,8
7512#    sw $t1,($sp)
7516#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
7520#    move $s7,$zero # -4 offset header word
7524#    lw $t4,8($sp) # bytes for hash value
7528#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
7532#    addu $t4,8
7536#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
7540#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

7544#    li $t0,CLASS_String # store string vtable address into ...
7548#    sw $t0,-12($s7) # ... -12 offset in object header
7552#    lw $t2,-12($s2) # our object's vtable address
7556#    lw $t5,4($sp) # number characters in prefix
7560#    lw $t1,12($sp) # number of characters in hashcode
7564#    addu $t3,$t1,$t5 # number of characters in string ...
7568#    addu $t3,1 # ... including the '@' character
7572#    subu $t0,$zero,$t3 # store negated length into ...
7576#    sw $t0,-4($s7) # ... -4 offset header word
7580#    lw $t0,-8($s7) # get -8 offset header-word
7584#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
7585##...slt $at,$t0,$zero
7589##...beq $at,$zero,7608
7592#    and $t0,0xff # mask off object's hash value ...
7593##...lui $at,0
7597##...ori $at,$at,0xff
7601##...and $t0,$t0,$at
7604#    sw $t0,-8($s7) # ... and store back into -8 header-word
7608:skipMask_toString:
7608#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
7612#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
7616#    subu $t4,$t2,$t5
7620:toString_copyLoop:    
7620#    lb $t3,($t4)
7624#    and $t3,0x7f # mask off sign bit (in case first word)
7625##...lui $at,0
7629##...ori $at,$at,0x7f
7633##...and $t3,$t3,$at
7636#    sb $t3,-8($t0)
7640#    addu $t4,1
7644#    addu $t0,1
7648#    blt $t4,$t2,toString_copyLoop
7649##...slt $at,$t4,$t2
7653##...bne $at,$zero,7620

    # copy the '@' sign
7656#    li $t3,'@'
7660#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
7664#    addu $t2,$t0,$t1 # address of last byte in string to store +8
7668#    lw $t3,20($sp) # hash code to print
7672:toString_hashCopyLoop:
7672#    and $t4,$t3,0xf
7676#    srl $t3,4
7680#    lb $t4,hexChars($t4)
7684#    sb $t4,-8($t2)
7688#    subu $t2,$t2,1
7692#    bgt $t2,$t0,toString_hashCopyLoop
7693##...slt $at,$t0,$t2
7697##...bne $at,$zero,7672

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
7700#    addu $sp,28
7704#    lw $ra,($sp)
7708#    addu $sp,4
7712#    move $t0, $s7 # return string we created
7716#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
