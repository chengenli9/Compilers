##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
3428:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
3428#    lw $t0,-8($s2) # get word with hash bits from this
3432#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
3436#    addu $t0,$t1

3440#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
3444:mth_equals_Object:
3444#    move $t0,$s2 # first pointer (this)
3448#    lw $t1,($sp) # second pointer
3452#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
3453##...subu $at,$t0,$t1
3457##...sltiu $t0,$at,1

3460#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
3464:mth_hashCode_String:
3464#    move $t0,$s2 # put this pointer in t0

3468#    li $t2,0 # current hash value
3472#    lw $t1,-4($t0) # negative of number of characters in string
3476#    beq $t1,$zero,done_hashCode_String # if zero length => done
3480#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
3484#    and $t0,0xfffffffc # adjust for padding
3485##...lui $at,65535
3489##...ori $at,$at,0xfffc
3493##...and $t0,$t0,$at
3496#    subu $t1,$t0,$t1 # address at end of string +12
3500:loop_hashCode_String:    
3500#    sll $t4,$t2,5 # multiply by 32
3504#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
3508#    lbu $t3,-12($t0) # current character
3512#    addu $t2,$t3 # add in current character
3516#    addu $t0,1 # go to next character's address
3520#    bne $t0,$t1,loop_hashCode_String # loop back if more
3524:done_hashCode_String:    

    # push int on stack
3524#    move $t0, $t2 # put $t2 in return slot
3528#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
3532:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
3532#    subu $sp,4
3536#    sw $ra,($sp)
    
    # get hash value
3540#    lw $t2,-12($s2) # vtable address
3544#    lw $t0,($t2) # method address
3548#    jalr $t0
3552#    subu $sp,8 # push result (int in $t0) on stack
3556#    sw $s5,4($sp)
3560#    sw $t0,($sp)

    # compute print-size of hash value
3564#    li $t0, 1
3568#    lw $t1, ($sp)
3572#    srl $t1,$t1,4
3576#    beq $t1,$zero,toString_skip_loop
3580:toString_loop_top:
3580#    addu $t0,1
3584#    srl $t1,$t1,4
3588#    bne $t1,$zero,toString_loop_top
3592:toString_skip_loop:
3592#    subu $sp,8
3596#    sw $s5,4($sp)
3600#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
3604#    lw $t2,-12($s2) # vtable address
3608#    move $t0,$t2
3612:toString_checkTagBit:
3612#    subu $t0,1
3616#    lb $t1,($t0)
3620#    and $t1,0x80
3621##...lui $at,0
3625##...ori $at,$at,0x80
3629##...and $t1,$t1,$at
3632#    beq $t1,$zero,toString_checkTagBit
3636#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
3640#    subu $sp,8
3644#    sw $t1,($sp)
3648#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
3652#    move $s7,$zero # -4 offset header word
3656#    lw $t4,8($sp) # bytes for hash value
3660#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
3664#    addu $t4,8
3668#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
3672#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

3676#    li $t0,CLASS_String # store string vtable address into ...
3680#    sw $t0,-12($s7) # ... -12 offset in object header
3684#    lw $t2,-12($s2) # our object's vtable address
3688#    lw $t5,4($sp) # number characters in prefix
3692#    lw $t1,12($sp) # number of characters in hashcode
3696#    addu $t3,$t1,$t5 # number of characters in string ...
3700#    addu $t3,1 # ... including the '@' character
3704#    subu $t0,$zero,$t3 # store negated length into ...
3708#    sw $t0,-4($s7) # ... -4 offset header word
3712#    lw $t0,-8($s7) # get -8 offset header-word
3716#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
3717##...slt $at,$t0,$zero
3721##...beq $at,$zero,3740
3724#    and $t0,0xff # mask off object's hash value ...
3725##...lui $at,0
3729##...ori $at,$at,0xff
3733##...and $t0,$t0,$at
3736#    sw $t0,-8($s7) # ... and store back into -8 header-word
3740:skipMask_toString:
3740#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
3744#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
3748#    subu $t4,$t2,$t5
3752:toString_copyLoop:    
3752#    lb $t3,($t4)
3756#    and $t3,0x7f # mask off sign bit (in case first word)
3757##...lui $at,0
3761##...ori $at,$at,0x7f
3765##...and $t3,$t3,$at
3768#    sb $t3,-8($t0)
3772#    addu $t4,1
3776#    addu $t0,1
3780#    blt $t4,$t2,toString_copyLoop
3781##...slt $at,$t4,$t2
3785##...bne $at,$zero,3752

    # copy the '@' sign
3788#    li $t3,'@'
3792#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
3796#    addu $t2,$t0,$t1 # address of last byte in string to store +8
3800#    lw $t3,20($sp) # hash code to print
3804:toString_hashCopyLoop:
3804#    and $t4,$t3,0xf
3808#    srl $t3,4
3812#    lb $t4,hexChars($t4)
3816#    sb $t4,-8($t2)
3820#    subu $t2,$t2,1
3824#    bgt $t2,$t0,toString_hashCopyLoop
3825##...slt $at,$t0,$t2
3829##...bne $at,$zero,3804

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
3832#    addu $sp,28
3836#    lw $ra,($sp)
3840#    addu $sp,4
3844#    move $t0, $s7 # return string we created
3848#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
3852:mth_equals_String:
    
    # quick test for obvious false
3852#    lw $t0,($sp) # second parameter
3856#    beq $t0,$zero,goEsFalse # go return false if null
3860#    lw $t1,-12($t0) # vtable pointer
3864#    la $t2,CLASS_String # string vtable pointer
3868#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
3872#    subu $sp,12
3876#    sw $ra,8($sp)
3880#    sw $s2,4($sp)
3884#    sw $t0,($sp)
3888#    jal mth_compareTo_String
3892#    lw $s2, 4($sp) #restore this pointer and pop parameters
3896#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
3900#    seq $t0,$t0,$zero
3901##...subu $at,$t0,$zero
3905##...sltiu $t0,$at,1

    # pop return address and return $t0
3908#    lw $ra,($sp)
3912#    addu $sp,4

3916#    jr $ra # return
    
3920:goEsFalse:
    # put 0 in $t0 and return
3920#    li $t0, 0
3924#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
3928:mth_toString_String:
    #we are a string, so return this.
3928#    move $t0, $s2
3932#    jr $ra

###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
3936:mth_readLine_Lib:
    
3936#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
3940#    sw $ra, 4($sp) # save $ra
3944#    move $t1,$sp # save "original" sp

3948:  doRead:

    # read the character
3948#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
3952#    subu $t2,$v0,13
3956#    bne $t2,$zero,notReturnRL
3960#    jal readLogicalChar
3964#    subu $t2,$v0,10 # check for newline
3968#    beq $t2,$zero,foundNewLine
3972#    sw $v0,lastCharRead # push back character into queue
3976#    j foundNewLine # go process the line

3980:  notReturnRL:

    # at this point, $v0 has our character

3980#    subu $t0,$v0,10
3984#    beq $t0,$zero,foundNewLine
3988#    blt $v0,$zero,foundEof
3989##...slt $at,$v0,$zero
3993##...bne $at,$zero,4008

    # we have a character, so push it onto stack
3996#    subu $sp,$sp,4
4000#    sw $v0,($sp)

    # loop back up to get next character
4004#    j doRead

4008:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
4008#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
4012#    li $s7, 0 # return-value: null
4016#    j rlReturn # return

4020:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
4020#    subu $t0,$t1,$sp # number of chars we read (times 4)
4024#    srl $s6,$t0,2 # number of words on stack with chars
4028#    subu $sp,$sp,4 # push char-count ...
4032#    sw $s6,($sp) # ... onto stack
4036#    addu $t2,$t0,5 # GC tag, incl. for count-word
4040#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
4044#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
4048#    srl $s6,$s6,2  # data words in object
4052#    move $s7,$zero # object words in object
4056#    jal newObject  # allocate space
    
    # store header words
4060#    la $t0,CLASS_String
4064#    sw $t0,-12($s7)# store class tag (String) into object
4068#    lw $t2,4($sp) # char-count
4072#    sll $t1,$t2,2 # 4 times number of chars
4076#    subu $t2,$zero,$t2 # negative of char-count
4080#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
4084#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
4088#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
4089##...slt $at,$t0,$zero
4093##...beq $at,$zero,4112
4096#    and $t0,0xff # mask off object's hash value ...
4097##...lui $at,0
4101##...ori $at,$at,0xff
4105##...and $t0,$t0,$at
4108#    sw $t0,-8($s7) # ... and store back into -8 header-word
4112:  skipMask_readLine:

4112#    sll $t0,$t0,2 # data bytes in object
4116#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
4120#    subu $t0,$t0,$t2 # place to store last character (plus 9)
4124#    addu $sp,$sp,8 # pop redundant object-pointer and count
4128#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

4132#    beq $sp,$t1,rlReturn
4136:  charCopyLoop:
4136#    lw $t2,($sp)
4140#    sb $t2,-9($t0)
4144#    addu $sp,$sp,4
4148#    subu $t0,$t0,1
4152#    bne $sp,$t1,charCopyLoop
4156:  rlReturn:

4156#    lw $ra, 4($sp)
4160#    addu $sp, 8   # pop $ra and pointless word off stack
4164#    move $t0, $s7 # return string we allocated in $s7
4168#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
4172:mth_readInt_Lib:

    # save $ra by pushing onto stack
4172#    subu $sp,$sp,4
4176#    sw $ra,($sp)

4180:  riSkipWhiteLoop:
    # read a character
4180#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
4184#    subu $t0,$v0,32
4188#    bgt $t0,$zero,nonWhite
4189##...slt $at,$zero,$t0
4193##...bne $at,$zero,4236
4196#    beq $t0,$zero,riSkipWhiteLoop # start over if space
4200#    subu $t0,$v0,10
4204#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
4208#    subu $t0,$v0,9
4212#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
4216#    subu $t0,$v0,13
4220#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
4224#    subu $t0,$v0,12
4228#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
4232#    j badIntegerFormat # illegal integer char: abort program

4236:  nonWhite:
4236#    subu $t0,$v0,'-'
4240#    li $t4,1 # final multiplier
4244#    bne $t0,$zero,helpReadInt # go read
4248#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
4252#    jal readLogicalChar

4256:  helpReadInt:
4256#    li $t2,10
4260#    subu $t1,$v0,'0' # convert digit to 0-9 value
4264#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
4265##...sltu $at,$t1,$t2
4269##...beq $at,$zero,6552
4272#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

4276:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

4276#    jal readLogicalChar # read next character
4280#    subu $t1,$v0,'0' # convert digit to 0-9 value
4284#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
4285##...sltu $at,$t1,$t2
4289##...beq $at,$zero,4308

4292#    mul $t3,$t3,$t2 # multiply old value by 10
4293##...mult $t3,$t2
4297##...mflo $t3
4300#    addu $t3,$t3,$t1 # add in value of new digit
4304#    j digitLoop

4308:  doneDigitLoop:

    # "push back" unused character into queue
4308#    sw $v0,lastCharRead

    # restore return address
4312#    lw $ra,($sp)
4316#    addu $sp, 4

    # multiply by sign and put return value in $t0
4320#    mult $t3,$t4 # multiply to account for poss. minus sign
4324#    mflo $t3
4328#    move $t0, $t3
    
    # return
4332#    jr $ra

###################################################################
# readChar() - library method (class Lib)
# - reads a single character from standard input
# - returns the integer that is the encoding of the character
# - returns -1 if end of file was encountered
# - parameter:
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
4336:mth_readChar_Lib:

    # save $ra by pushing onto stack
4336#    subu $sp,$sp,4
4340#    sw $ra,($sp)

      # read the character
4344#    jal readLogicalChar

    # restore return address; put value in $t0
    # replacing this-pointer saved return address
4348#    lw $ra,($sp)
4352#    addu $sp, 4
4356#    move $t0, $v0

    # return
4360#    jr $ra

