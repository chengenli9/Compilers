########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
9600:vm_init:

    # mark bottom of stack
9600#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
9604#    move $s2,$zero

    #set up the "five" register
9608#    li $s5,5

9612#    la $s3,seg0_start
9616#    la $s4,seg0_end
9617##...lui $s4,16
9621##...addiu $s4,$s4,10804
    
    # return
9624#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
9628:divide:
    # get parameters; abort if divisor zero
9628#    lw $t0,($sp)
9632#    lw $t1,8($sp)
9636#    beq $t0,$zero,divByZeroError
    
    # perform division
9640#    div $t1,$t0
9644#    mflo $t0

    # store result, adjust stack and return
9648#    addu $sp,$sp,8 # adjust stack
9652#    sw $t0,($sp) # store result
9656#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
9660:remainder:
    # get parameters; abort if divisor zero
9660#    lw $t0,($sp)
9664#    lw $t1,8($sp)
9668#    beq $t0,$zero,divByZeroError
    
    # perform division
9672#    div $t1,$t0
9676#    mfhi $t0

    # store result, adjust stack and return
9680#    addu $sp,$sp,8 # adjust stack
9684#    sw $t0,($sp) # store result
9688#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
9692:checkCast:
    # get object, allow immediately if null
9692#    lw $t2,($sp)
9696#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
9700#    lw $t2,-12($t2) # vtable address
9704#    bge $t2,$t1,castException
9705##...slt $at,$t2,$t1
9709##...beq $at,$zero,9844
9712#    blt $t2,$t0,castException
9713##...slt $at,$t2,$t0
9717##...bne $at,$zero,9844
    
    # return, leaving object unchanged on stack
9720:  checkCastReturn:    
9720#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
9724:instanceOf:
    # get object, go return false if null
9724#    lw $t2,($sp)
9728#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
9732#    lw $t2,-12($t2) # vtable address
9736#    sge $t0,$t2,$t0 # are we >= the lower limit?
9737##...slt $t0,$t2,$t0
9741##...xori $t0,$t0,0x1
9744#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
9748#    and $t2,$t0,$t1
9752#    sw $t2,($sp)
9756:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
9756#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

9760:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
9760#    li $v0,4 # syscall-code for print-string
9764#    syscall
9768:exit:
    # print termination message
9768#    li $v0,4 # syscall-code for print-string
9772#    la $a0,exitString
9776#    syscall

    # terminate execution
9780#    li $v0,10 #syscall-code for "exit"
9784#    syscall

9788:outOfHeapMemory:
9788#    la $a0,heapMemoryMsg
9792#    j exitError
9796:divByZeroError:
9796#    la $a0,divByZeroMsg
9800#    j exitError
9804:strIndexOutOfBounds:
9804#    la $a0,strIndexOutOfBoundsMsg
9808#    j exitError
9812:arrayIndexOutOfBounds:
9812#    la $a0,arrayIndexOutOfBoundsMsg
9816#    j exitError
9820:arraySizeOutOfBounds:
9820#    la $a0,arraySizeOutOfBoundsMsg
9824#    j exitError
9828:nullPtrException:
9828#    la $a0,nullPtrExceptionMsg
9832#    j exitError
9836:badIntegerFormat:
9836#    la $a0,badIntegerFormatMsg
9840#    j exitError
9844:castException:
9844#    la $a0,castExceptionMsg
9848#    j exitError
############## data section ################
    .data
10440:hexChars:
    .ascii "0123456789abcdef"
    .align 2
10456:cur_seg:
    .word 0

10460:lastCharRead:
    .word -2 # -2 => no buffered character
10464:prevHashConstant:
    .word 0x2785173c
10468:gcCount:
    .word 0

10472:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
10499:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
10522:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
10557:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
10591:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
10624:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
10655:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
10703:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
10724:gcMsg: 
      .asciiz "\nGC!\n"
10730:gcCountMsg: 
      .asciiz "Number of garbage collections: "

10762:nullStr:
    .asciiz "null"
10767:trueString:
    .asciiz "true"
10772:falseString:
    .asciiz "false"
10778:exitString:
    .ascii "Program terminated."
    #### "falls through" here
10797:newlineString:
    .asciiz "\n"
    
    .align 2
10800:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

10804:seg0_start:
    .space 0x100000
1059380:seg0_end:
1059380:seg1_start:
    .space 0x100000
2107956:seg1_end:
