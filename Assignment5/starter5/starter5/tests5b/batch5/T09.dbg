1420#    beq $t0,$zero,riSkipWhiteLoop # start over if space
1424#    subu $t0,$v0,10
1428#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
1432#    subu $t0,$v0,9
1436#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
1440#    subu $t0,$v0,13
1444#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
1448#    subu $t0,$v0,12
