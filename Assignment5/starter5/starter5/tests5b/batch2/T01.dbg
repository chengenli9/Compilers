##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
2012:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
2012#    lw $t0,-8($s2) # get word with hash bits from this
2016#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
2020#    addu $t0,$t1

2024#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
2028:mth_equals_Object:
2028#    move $t0,$s2 # first pointer (this)
2032#    lw $t1,($sp) # second pointer
2036#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
2037##...subu $at,$t0,$t1
2041##...sltiu $t0,$at,1

2044#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
2048:mth_hashCode_String:
2048#    move $t0,$s2 # put this pointer in t0

2052#    li $t2,0 # current hash value
2056#    lw $t1,-4($t0) # negative of number of characters in string
2060#    beq $t1,$zero,done_hashCode_String # if zero length => done
2064#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
2068#    and $t0,0xfffffffc # adjust for padding
2069##...lui $at,65535
2073##...ori $at,$at,0xfffc
2077##...and $t0,$t0,$at
2080#    subu $t1,$t0,$t1 # address at end of string +12
2084:loop_hashCode_String:    
2084#    sll $t4,$t2,5 # multiply by 32
2088#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
2092#    lbu $t3,-12($t0) # current character
2096#    addu $t2,$t3 # add in current character
2100#    addu $t0,1 # go to next character's address
2104#    bne $t0,$t1,loop_hashCode_String # loop back if more
2108:done_hashCode_String:    

    # push int on stack
2108#    move $t0, $t2 # put $t2 in return slot
2112#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
2116:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
2116#    subu $sp,4
2120#    sw $ra,($sp)
    
    # get hash value
2124#    lw $t2,-12($s2) # vtable address
2128#    lw $t0,($t2) # method address
2132#    jalr $t0
2136#    subu $sp,8 # push result (int in $t0) on stack
2140#    sw $s5,4($sp)
2144#    sw $t0,($sp)

    # compute print-size of hash value
2148#    li $t0, 1
2152#    lw $t1, ($sp)
2156#    srl $t1,$t1,4
2160#    beq $t1,$zero,toString_skip_loop
2164:toString_loop_top:
2164#    addu $t0,1
2168#    srl $t1,$t1,4
2172#    bne $t1,$zero,toString_loop_top
2176:toString_skip_loop:
2176#    subu $sp,8
2180#    sw $s5,4($sp)
2184#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
2188#    lw $t2,-12($s2) # vtable address
2192#    move $t0,$t2
2196:toString_checkTagBit:
2196#    subu $t0,1
2200#    lb $t1,($t0)
2204#    and $t1,0x80
2205##...lui $at,0
2209##...ori $at,$at,0x80
2213##...and $t1,$t1,$at
2216#    beq $t1,$zero,toString_checkTagBit
2220#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
2224#    subu $sp,8
2228#    sw $t1,($sp)
2232#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
2236#    move $s7,$zero # -4 offset header word
2240#    lw $t4,8($sp) # bytes for hash value
2244#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
2248#    addu $t4,8
2252#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
2256#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

2260#    li $t0,CLASS_String # store string vtable address into ...
2264#    sw $t0,-12($s7) # ... -12 offset in object header
2268#    lw $t2,-12($s2) # our object's vtable address
2272#    lw $t5,4($sp) # number characters in prefix
2276#    lw $t1,12($sp) # number of characters in hashcode
2280#    addu $t3,$t1,$t5 # number of characters in string ...
2284#    addu $t3,1 # ... including the '@' character
2288#    subu $t0,$zero,$t3 # store negated length into ...
2292#    sw $t0,-4($s7) # ... -4 offset header word
2296#    lw $t0,-8($s7) # get -8 offset header-word
2300#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
2301##...slt $at,$t0,$zero
2305##...beq $at,$zero,2324
2308#    and $t0,0xff # mask off object's hash value ...
2309##...lui $at,0
2313##...ori $at,$at,0xff
2317##...and $t0,$t0,$at
2320#    sw $t0,-8($s7) # ... and store back into -8 header-word
2324:skipMask_toString:
2324#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
2328#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
2332#    subu $t4,$t2,$t5
2336:toString_copyLoop:    
2336#    lb $t3,($t4)
2340#    and $t3,0x7f # mask off sign bit (in case first word)
2341##...lui $at,0
2345##...ori $at,$at,0x7f
2349##...and $t3,$t3,$at
2352#    sb $t3,-8($t0)
2356#    addu $t4,1
2360#    addu $t0,1
2364#    blt $t4,$t2,toString_copyLoop
2365##...slt $at,$t4,$t2
2369##...bne $at,$zero,2336

    # copy the '@' sign
2372#    li $t3,'@'
2376#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
2380#    addu $t2,$t0,$t1 # address of last byte in string to store +8
2384#    lw $t3,20($sp) # hash code to print
2388:toString_hashCopyLoop:
2388#    and $t4,$t3,0xf
2392#    srl $t3,4
2396#    lb $t4,hexChars($t4)
2400#    sb $t4,-8($t2)
2404#    subu $t2,$t2,1
2408#    bgt $t2,$t0,toString_hashCopyLoop
2409##...slt $at,$t0,$t2
2413##...bne $at,$zero,2388

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
2416#    addu $sp,28
2420#    lw $ra,($sp)
2424#    addu $sp,4
2428#    move $t0, $s7 # return string we created
2432#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
2436:mth_equals_String:
    
    # quick test for obvious false
2436#    lw $t0,($sp) # second parameter
2440#    beq $t0,$zero,goEsFalse # go return false if null
2444#    lw $t1,-12($t0) # vtable pointer
2448#    la $t2,CLASS_String # string vtable pointer
2452#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
2456#    subu $sp,12
2460#    sw $ra,8($sp)
2464#    sw $s2,4($sp)
2468#    sw $t0,($sp)
2472#    jal mth_compareTo_String
2476#    lw $s2, 4($sp) #restore this pointer and pop parameters
2480#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
2484#    seq $t0,$t0,$zero
2485##...subu $at,$t0,$zero
2489##...sltiu $t0,$at,1

    # pop return address and return $t0
2492#    lw $ra,($sp)
2496#    addu $sp,4

2500#    jr $ra # return
    
2504:goEsFalse:
    # put 0 in $t0 and return
2504#    li $t0, 0
2508#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
2512:mth_toString_String:
    #we are a string, so return this.
2512#    move $t0, $s2
2516#    jr $ra

###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
2520:mth_readLine_Lib:
    
2520#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
2524#    sw $ra, 4($sp) # save $ra
2528#    move $t1,$sp # save "original" sp

2532:  doRead:

    # read the character
2532#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
2536#    subu $t2,$v0,13
2540#    bne $t2,$zero,notReturnRL
2544#    jal readLogicalChar
2548#    subu $t2,$v0,10 # check for newline
2552#    beq $t2,$zero,foundNewLine
2556#    sw $v0,lastCharRead # push back character into queue
2560#    j foundNewLine # go process the line

2564:  notReturnRL:

    # at this point, $v0 has our character

2564#    subu $t0,$v0,10
2568#    beq $t0,$zero,foundNewLine
2572#    blt $v0,$zero,foundEof
2573##...slt $at,$v0,$zero
2577##...bne $at,$zero,2592

    # we have a character, so push it onto stack
2580#    subu $sp,$sp,4
2584#    sw $v0,($sp)

    # loop back up to get next character
2588#    j doRead

2592:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
2592#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
2596#    li $s7, 0 # return-value: null
2600#    j rlReturn # return

2604:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
2604#    subu $t0,$t1,$sp # number of chars we read (times 4)
2608#    srl $s6,$t0,2 # number of words on stack with chars
2612#    subu $sp,$sp,4 # push char-count ...
2616#    sw $s6,($sp) # ... onto stack
2620#    addu $t2,$t0,5 # GC tag, incl. for count-word
2624#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
2628#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
2632#    srl $s6,$s6,2  # data words in object
2636#    move $s7,$zero # object words in object
2640#    jal newObject  # allocate space
    
    # store header words
2644#    la $t0,CLASS_String
2648#    sw $t0,-12($s7)# store class tag (String) into object
2652#    lw $t2,4($sp) # char-count
2656#    sll $t1,$t2,2 # 4 times number of chars
2660#    subu $t2,$zero,$t2 # negative of char-count
2664#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
2668#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
2672#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
2673##...slt $at,$t0,$zero
2677##...beq $at,$zero,2696
2680#    and $t0,0xff # mask off object's hash value ...
2681##...lui $at,0
2685##...ori $at,$at,0xff
2689##...and $t0,$t0,$at
2692#    sw $t0,-8($s7) # ... and store back into -8 header-word
2696:  skipMask_readLine:

2696#    sll $t0,$t0,2 # data bytes in object
2700#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
2704#    subu $t0,$t0,$t2 # place to store last character (plus 9)
2708#    addu $sp,$sp,8 # pop redundant object-pointer and count
2712#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

2716#    beq $sp,$t1,rlReturn
2720:  charCopyLoop:
2720#    lw $t2,($sp)
2724#    sb $t2,-9($t0)
2728#    addu $sp,$sp,4
2732#    subu $t0,$t0,1
2736#    bne $sp,$t1,charCopyLoop
2740:  rlReturn:

2740#    lw $ra, 4($sp)
2744#    addu $sp, 8   # pop $ra and pointless word off stack
2748#    move $t0, $s7 # return string we allocated in $s7
2752#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
2756:mth_readInt_Lib:

    # save $ra by pushing onto stack
2756#    subu $sp,$sp,4
2760#    sw $ra,($sp)

2764:  riSkipWhiteLoop:
    # read a character
2764#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
2768#    subu $t0,$v0,32
2772#    bgt $t0,$zero,nonWhite
2773##...slt $at,$zero,$t0
2777##...bne $at,$zero,2820
2780#    beq $t0,$zero,riSkipWhiteLoop # start over if space
2784#    subu $t0,$v0,10
2788#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
2792#    subu $t0,$v0,9
2796#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
2800#    subu $t0,$v0,13
2804#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
2808#    subu $t0,$v0,12
2812#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
2816#    j badIntegerFormat # illegal integer char: abort program

2820:  nonWhite:
2820#    subu $t0,$v0,'-'
2824#    li $t4,1 # final multiplier
2828#    bne $t0,$zero,helpReadInt # go read
2832#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
2836#    jal readLogicalChar

2840:  helpReadInt:
2840#    li $t2,10
2844#    subu $t1,$v0,'0' # convert digit to 0-9 value
2848#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
2849##...sltu $at,$t1,$t2
2853##...beq $at,$zero,5136
2856#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

2860:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

2860#    jal readLogicalChar # read next character
2864#    subu $t1,$v0,'0' # convert digit to 0-9 value
2868#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
2869##...sltu $at,$t1,$t2
2873##...beq $at,$zero,2892

2876#    mul $t3,$t3,$t2 # multiply old value by 10
2877##...mult $t3,$t2
2881##...mflo $t3
2884#    addu $t3,$t3,$t1 # add in value of new digit
2888#    j digitLoop

2892:  doneDigitLoop:

    # "push back" unused character into queue
2892#    sw $v0,lastCharRead

    # restore return address
2896#    lw $ra,($sp)
2900#    addu $sp, 4

    # multiply by sign and put return value in $t0
2904#    mult $t3,$t4 # multiply to account for poss. minus sign
2908#    mflo $t3
2912#    move $t0, $t3
    
    # return
2916#    jr $ra

###################################################################
# readChar() - library method (class Lib)
# - reads a single character from standard input
# - returns the integer that is the encoding of the character
# - returns -1 if end of file was encountered
# - parameter:
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
2920:mth_readChar_Lib:

    # save $ra by pushing onto stack
2920#    subu $sp,$sp,4
2924#    sw $ra,($sp)

      # read the character
2928#    jal readLogicalChar

    # restore return address; put value in $t0
    # replacing this-pointer saved return address
2932#    lw $ra,($sp)
2936#    addu $sp, 4
2940#    move $t0, $v0

    # return
2944#    jr $ra

########################################################
# printStr(str) - library method (class Lib)
# - prints string to standard output
# parameters:
#   - ($sp) - the string to print
#   - 4($sp) - old-this-pointer
########################################################
2948:mth_printStr_Lib:
    # check for null, printing "(null)", if so
2948#    lw $t0,($sp)
2952#    bne $t0,$zero,psNotNull

    # print "(null)"
2956#    la $a0,nullStr
2960#    li $v0,4
2964#    syscall
2968#    j donePrintStr
    
2972:  psNotNull:
    ##### we have a non-null string #####
    # this means that:
    # - number of data words in -8($t0):
    #   - if the sign bit is 1, the low 31 bits
    #   - if the sign bit is 0, the low 8 bits
    # - negative of number of characters in string is in -4($t0)
    # - string begins at $t0-8-(#dataWords*4), stored 1 char per byte
2972#    subu $t0,$t0,8
2976#    lw $t1,($t0) # number of data words, but needs modification
2980#    blt $t1,$zero,skipPrintStr1
2981##...slt $at,$t1,$zero
2985##...bne $at,$zero,3004
2988#    and $t1,0xff # mask out all but low byte
2989##...lui $at,0
2993##...ori $at,$at,0xff
2997##...and $t1,$t1,$at
3000#    b skipPrintStr2
3004:skipPrintStr1:
3004#    and $t1,0x7ffffff
3005##...lui $at,2047
3009##...ori $at,$at,0xffff
3013##...and $t1,$t1,$at
3016:skipPrintStr2:    
3016#    sll $t1,$t1,2
3020#    subu $t1,$t0,$t1 # first word in string
3024#    lw $t0,4($t0) # negative of string-length
3028#    subu $t0,$t1,$t0 # byte just beyond last char in string

    # print the chars in the string
3032#    beq $t0,$t1,donePrintStr
3036:  psLoop:
3036#    lb $a0,($t1) # next byte
3040#    li $v0,11 # code for printing char
3044#        syscall # print the char
3048#    addu $t1,$t1,1 # go to next char
3052#    blt $t1,$t0,psLoop
3053##...slt $at,$t1,$t0
3057##...bne $at,$zero,3036

3060:  donePrintStr:
3060#    jr $ra

########################################################
# printInt(n) - library method (class Lib)
# - prints integer in decimal format to standard output
# - parameters:
#   - ($sp) - the integer to print
#   - 4($sp) - GC tag
#   - ($sp) - old-this-pointer
########################################################
3064:mth_printInt_Lib:
3064#    lw $a0,($sp)

    # print it
3068#    li $v0,1 # code for print-int
3072#    syscall

    # return
3076#    jr $ra

########################################################
# printBool(n) - library method (class Lib)
# - prints boolean to standard output
# - parameters:
#   - ($sp) - the boolean to print
#   - 4($sp) - old-this-pointer
########################################################
3080:mth_printBool_Lib:
    # pop value off stack, along with 'this'
3080#    lw $t0,($sp)

    # print either 'true' or 'false', depending on the value
3084#    la $a0,falseString
3088#    beq $t0,$zero,skipPB
3092#    la $a0,trueString
3096:  skipPB:
3096#    li $v0,4 # code for print-string
3100#    syscall

    # return
3104#    jr $ra

########################################################
# str.substring(n, k) - library method (class String)
# takes a substring of a string: Java: str.substring(n, k)
# - parameters after pushing RA:
#   - ($sp) - k: one beyond index of last char in subrange
#   - 4($sp) - GC tag
#   - 8($sp) - n: index of first char in subrange
#   - 12($sp) - GC tag
#   - 16($sp) - old this pointer
# - return value:
#  - $t0 - substring
########################################################
3108:mth_substring_String:

    # save $ra by pushing onto stack
3108#    subu $sp,$sp,4
3112#    sw $ra,($sp)

    # get string from this, we probably don't need the null check.
3116#    move $t0,$s2
3120#    beq $t0,$zero,nullPtrException

    # get both indices and string length, and ensure that
    #   0 <= n <= k <= length
3124#    lw $t0,-4($t0) # negative of string length
3128#    subu $t0,$zero,$t0 # string length
3132#    lw $t1,4($sp) # k
3136#    lw $t2,12($sp) # n
3140#    bgt $zero,$t2,strIndexOutOfBounds
3141##...slt $at,$t2,$zero
3145##...bne $at,$zero,5104
3148#    bgt $t2,$t1,strIndexOutOfBounds
3149##...slt $at,$t1,$t2
3153##...bne $at,$zero,5104
3156#    bgt $t1,$t0,strIndexOutOfBounds
3157##...slt $at,$t0,$t1
3161##...bne $at,$zero,5104

    # allocate memory
3164#    subu $s6,$t1,$t2 # # chars in target-string
3168#    addu $s6,$s6,7 # account for extra "class" (4) word + 3 to round up
3172#    srl $s6,$s6,2 # convert bytes-count to word-count
3176#    move $s7,$zero # (no object-bytes in string)
3180#    jal newObject

    # store "String" tag in object-type field
3184#    la $t0,CLASS_String
3188#    sw $t0,-12($s7)
    
    # mask off hash bits, if needed
3192#    lw $t4,-8($s7) # data words in source string
3196#    bge $t4,$zero,skipMask_substring # don't strip hash code if not there
3197##...slt $at,$t4,$zero
3201##...beq $at,$zero,3220
3204#    and $t4,0xff # mask off object's hash value ...
3205##...lui $at,0
3209##...ori $at,$at,0xff
3213##...and $t4,$t4,$at
3216#    sw $t4,-8($s7) # ... and store back into -8 header-word
3220:skipMask_substring:

    # store negative of count (=n-k) into object-length header-word
    # indicies have changed, because newObject is on stack
3220#    lw $t1,8($sp) # k
3224#    lw $t2,16($sp) # n
3228#    subu $t0,$t2,$t1 # value to store
3232#    sw $t0,-4($s7) # store value
    
3236#    move $t3,$s2 # source string pointer
    
    # skip byte-copy loop if length is zero
3240#    beq $zero,$t0,doneSubCopyzz

    # get pointers set up in preparation for copy
3244#    lw $t4,-8($t3) # data words in source string
3248#    sll $t4,$t4,2 # data bytes in source string (incl. padding)
3252#    subu $t3,$t3,$t4 # addr. of first data word of source string (+8)
3256#    addu $t3,$t3,$t2 # addr. of first source data byte to be copied (+8)
3260#    subu $t1,$t3,$t0 # addr. beyond last source data byte to be copied (+8)
3264#    lw $t2,-8($s7)   # data words in target string
3268#    sll $t2,$t2,2    # data bytes in target string
3272#    subu $t2,$s7,$t2 # addr. of first target data byte (+8)
    
    ############################################
    # at this point:
    # - we know that the string has a positive length
    # - $t3 contains 8 + address of the first source-byte
    # - $t1 contains 8 + limit-address of the first source-byte
    # - $t2 contains 8 + address first target byte
    ############################################

    # copy the bytes from source to target
3276:  subCopyLoopzz:
3276#    lb $t4,-8($t3)
3280#    sb $t4,-8($t2)
3284#    addu $t2,$t2,1
3288#    addu $t3,$t3,1
3292#    blt $t3,$t1,subCopyLoopzz
3293##...slt $at,$t3,$t1
3297##...bne $at,$zero,3276
    
3300:  doneSubCopyzz:
    # restore return address, store return value, pop stack
3300#    lw $ra,4($sp) # restore $ra
3304#    addu $sp,$sp,8 # pop ra, and allocated newObject
3308#    move $t0, $s7 # we're returning the string we got back
                  # from newObject
    
    # return
3312#    jr $ra

########################################################
# length() - library method (class String)
# returns length of a string: Java: str.length()
# - parameters:
#   - ($sp) - old this pointer
# - return-value:
#   - $t0 - length of string
########################################################
3316:mth_length_String:

    # the length is the negative of 4($s2)
3316#    lw $t0,-4($s2) # -length
3320#    subu $t0,$zero,$t0

    # return
3324#    jr $ra


########################################################
# str1.concat(str2) - library method (class String)
# (as in Java)
# - parameters:
#   - ($sp) - the second string
#   - 4($sp) - old this pointer
#   - $s2 - the first string (this)
# - returns:
#   - $t0 - pointer to concatenated string
########################################################
3328:mth_concat_String:
    # save $ra by pushing onto stack
3328#    subu $sp,$sp,4
3332#    sw $ra, ($sp)

    # get string pointers and check parameter for null
3336#    lw $t0,4($sp)
3340#    beq $t0,$zero,nullPtrException
3344#    move $t1,$s2
    
    # get lengths of two strings; allocate object whose size
    # is their sum divided by 4 (rounded up) plus 1
3348#    lw $t0,-4($t0) # negative size of second object
3352#    lw $t1,-4($t1) # negative size of first object
3356#    addu $s6,$t0,$t1 # sum of negative sizes
3360#    sra $s6,$s6,2 # negative word-size of char part
3364#    subu $s6,$zero,$s6 # word size of char part
3368#    addu $s6,$s6,1 # data word size, including v-table word
3372#    move $s7,$zero
3376#    jal newObject

    # store String vtable address in vtable address field
3380#    la $t0,CLASS_String
3384#    sw $t0,-12($s7)
        
    # mask off hash bits, if needed
3388#    lw $t4,-8($s7) # # data words in source string
3392#    bge $t4,$zero,skipMask_concat # don't strip hash code if not there
3393##...slt $at,$t4,$zero
3397##...beq $at,$zero,3416
3400#    and $t4,0xff # mask off object's hash value ...
3401##...lui $at,0
3405##...ori $at,$at,0xff
3409##...and $t4,$t4,$at
3412#    sw $t4,-8($s7) # ... and store back into -8 header-word
3416:skipMask_concat:

3416#    move $t9, $s7 # store return string in unused (I hope) t9 register

    #restore $t0, and $t1 after they were potentially blown
    #away by newObject
3420#    move $t1,$s2   # first object
3424#    lw $t0,8($sp) # second object
    
    # get negative sizes; sum and store in new object size-field
3428#    lw $t2,-4($t0) # negative length of second object
3432#    lw $t3,-4($t1) # negative length of first object
3436#    addu $t4,$t2,$t3 # sum of negative lengths
3440#    sw $t4,-4($s7) # store sum as negated target-string length

    #########################################################
