8581##...bne $at,$zero,8560
    
8584:  doneSubCopyzz:
    # restore return address, store return value, pop stack
8584#    lw $ra,4($sp) # restore $ra
8588#    addu $sp,$sp,8 # pop ra, and allocated newObject
8592#    move $t0, $s7 # we're returning the string we got back
                  # from newObject
    
    # return
8596#    jr $ra
