###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
784:mth_readLine_Lib:
    
784#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
788#    sw $ra, 4($sp) # save $ra
792#    move $t1,$sp # save "original" sp

796:  doRead:

    # read the character
796#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
800#    subu $t2,$v0,13
804#    bne $t2,$zero,notReturnRL
808#    jal readLogicalChar
812#    subu $t2,$v0,10 # check for newline
816#    beq $t2,$zero,foundNewLine
820#    sw $v0,lastCharRead # push back character into queue
824#    j foundNewLine # go process the line

828:  notReturnRL:

    # at this point, $v0 has our character

828#    subu $t0,$v0,10
832#    beq $t0,$zero,foundNewLine
836#    blt $v0,$zero,foundEof
837##...slt $at,$v0,$zero
841##...bne $at,$zero,856

    # we have a character, so push it onto stack
844#    subu $sp,$sp,4
848#    sw $v0,($sp)

    # loop back up to get next character
852#    j doRead

856:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
856#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
860#    li $s7, 0 # return-value: null
864#    j rlReturn # return

868:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
868#    subu $t0,$t1,$sp # number of chars we read (times 4)
872#    srl $s6,$t0,2 # number of words on stack with chars
876#    subu $sp,$sp,4 # push char-count ...
880#    sw $s6,($sp) # ... onto stack
884#    addu $t2,$t0,5 # GC tag, incl. for count-word
888#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
892#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
896#    srl $s6,$s6,2  # data words in object
900#    move $s7,$zero # object words in object
904#    jal newObject  # allocate space
    
    # store header words
908#    la $t0,CLASS_String
912#    sw $t0,-12($s7)# store class tag (String) into object
916#    lw $t2,4($sp) # char-count
920#    sll $t1,$t2,2 # 4 times number of chars
924#    subu $t2,$zero,$t2 # negative of char-count
928#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
932#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
936#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
937##...slt $at,$t0,$zero
941##...beq $at,$zero,960
944#    and $t0,0xff # mask off object's hash value ...
945##...lui $at,0
949##...ori $at,$at,0xff
953##...and $t0,$t0,$at
956#    sw $t0,-8($s7) # ... and store back into -8 header-word
960:  skipMask_readLine:

960#    sll $t0,$t0,2 # data bytes in object
964#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
968#    subu $t0,$t0,$t2 # place to store last character (plus 9)
972#    addu $sp,$sp,8 # pop redundant object-pointer and count
976#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

980#    beq $sp,$t1,rlReturn
984:  charCopyLoop:
984#    lw $t2,($sp)
988#    sb $t2,-9($t0)
992#    addu $sp,$sp,4
996#    subu $t0,$t0,1
1000#    bne $sp,$t1,charCopyLoop
1004:  rlReturn:

1004#    lw $ra, 4($sp)
1008#    addu $sp, 8   # pop $ra and pointless word off stack
1012#    move $t0, $s7 # return string we allocated in $s7
1016#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
1020:mth_readInt_Lib:

    # save $ra by pushing onto stack
1020#    subu $sp,$sp,4
1024#    sw $ra,($sp)

1028:  riSkipWhiteLoop:
    # read a character
1028#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
1032#    subu $t0,$v0,32
1036#    bgt $t0,$zero,nonWhite
1037##...slt $at,$zero,$t0
1041##...bne $at,$zero,1084
1044#    beq $t0,$zero,riSkipWhiteLoop # start over if space
1048#    subu $t0,$v0,10
1052#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
1056#    subu $t0,$v0,9
1060#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
1064#    subu $t0,$v0,13
1068#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
1072#    subu $t0,$v0,12
1076#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
1080#    j badIntegerFormat # illegal integer char: abort program

1084:  nonWhite:
1084#    subu $t0,$v0,'-'
1088#    li $t4,1 # final multiplier
1092#    bne $t0,$zero,helpReadInt # go read
1096#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
1100#    jal readLogicalChar

1104:  helpReadInt:
1104#    li $t2,10
1108#    subu $t1,$v0,'0' # convert digit to 0-9 value
1112#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
1113##...sltu $at,$t1,$t2
1117##...beq $at,$zero,3400
1120#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

1124:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

1124#    jal readLogicalChar # read next character
1128#    subu $t1,$v0,'0' # convert digit to 0-9 value
1132#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
1133##...sltu $at,$t1,$t2
1137##...beq $at,$zero,1156

1140#    mul $t3,$t3,$t2 # multiply old value by 10
1141##...mult $t3,$t2
1145##...mflo $t3
1148#    addu $t3,$t3,$t1 # add in value of new digit
1152#    j digitLoop

1156:  doneDigitLoop:

    # "push back" unused character into queue
1156#    sw $v0,lastCharRead

    # restore return address
1160#    lw $ra,($sp)
1164#    addu $sp, 4

