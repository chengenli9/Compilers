3204#    addu $t4,$t4,4
3208#    addu $s3,$s3,4
3212#    bltu $t4,$t3,gCinnerCopy2
3213##...sltu $at,$t4,$t3
3217##...bne $at,$zero,3196

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
3220#    sw $zero,-8($t1) # 0 in first header-slot
3224#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
3228#    sw $t8,($t0)

3232:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
3232#    addu $t0,$t0,4
3236#    bltu $t0,$s1,gcNextPointerInObject
3237##...sltu $at,$t0,$s1
3241##...bne $at,$zero,3080

3244:  gcTestIterDone2:
3244#    bltu $t0,$s3,gcHeapCopyLoop
3245##...sltu $at,$t0,$s3
3249##...bne $at,$zero,2964

    ###### end outer loop to copy all non-stack-direct objects ######

3252:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
3252#    lw $s2,($sp)
3256#    addu $sp,$sp,4

    # mark us as having already GC'd
3260#    move $t5,$s5

    # go try and allocate again
3264#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
3268:vm_init:

    # mark bottom of stack
3268#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
3272#    move $s2,$zero

    #set up the "five" register
3276#    li $s5,5

3280#    la $s3,seg0_start
3284#    la $s4,seg0_end
3285##...lui $s4,16
3289##...addiu $s4,$s4,4176
    
    # return
3292#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3296:divide:
    # get parameters; abort if divisor zero
3296#    lw $t0,($sp)
3300#    lw $t1,8($sp)
3304#    beq $t0,$zero,divByZeroError
    
    # perform division
3308#    div $t1,$t0
3312#    mflo $t0

    # store result, adjust stack and return
3316#    addu $sp,$sp,8 # adjust stack
3320#    sw $t0,($sp) # store result
3324#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3328:remainder:
    # get parameters; abort if divisor zero
3328#    lw $t0,($sp)
3332#    lw $t1,8($sp)
3336#    beq $t0,$zero,divByZeroError
    
    # perform division
3340#    div $t1,$t0
3344#    mfhi $t0

    # store result, adjust stack and return
3348#    addu $sp,$sp,8 # adjust stack
3352#    sw $t0,($sp) # store result
3356#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
3360:checkCast:
    # get object, allow immediately if null
3360#    lw $t2,($sp)
3364#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
3368#    lw $t2,-12($t2) # vtable address
3372#    bge $t2,$t1,castException
3373##...slt $at,$t2,$t1
3377##...beq $at,$zero,3512
3380#    blt $t2,$t0,castException
3381##...slt $at,$t2,$t0
3385##...bne $at,$zero,3512
    
    # return, leaving object unchanged on stack
3388:  checkCastReturn:    
3388#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
3392:instanceOf:
    # get object, go return false if null
3392#    lw $t2,($sp)
3396#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
3400#    lw $t2,-12($t2) # vtable address
3404#    sge $t0,$t2,$t0 # are we >= the lower limit?
3405##...slt $t0,$t2,$t0
3409##...xori $t0,$t0,0x1
3412#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
3416#    and $t2,$t0,$t1
3420#    sw $t2,($sp)
3424:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
3424#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

3428:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
3428#    li $v0,4 # syscall-code for print-string
3432#    syscall
3436:exit:
    # print termination message
3436#    li $v0,4 # syscall-code for print-string
3440#    la $a0,exitString
3444#    syscall

    # terminate execution
3448#    li $v0,10 #syscall-code for "exit"
3452#    syscall

3456:outOfHeapMemory:
3456#    la $a0,heapMemoryMsg
3460#    j exitError
3464:divByZeroError:
3464#    la $a0,divByZeroMsg
3468#    j exitError
3472:strIndexOutOfBounds:
3472#    la $a0,strIndexOutOfBoundsMsg
3476#    j exitError
3480:arrayIndexOutOfBounds:
3480#    la $a0,arrayIndexOutOfBoundsMsg
3484#    j exitError
3488:arraySizeOutOfBounds:
3488#    la $a0,arraySizeOutOfBoundsMsg
3492#    j exitError
3496:nullPtrException:
3496#    la $a0,nullPtrExceptionMsg
3500#    j exitError
3504:badIntegerFormat:
3504#    la $a0,badIntegerFormatMsg
3508#    j exitError
3512:castException:
3512#    la $a0,castExceptionMsg
3516#    j exitError
############## data section ################
    .data
3812:hexChars:
    .ascii "0123456789abcdef"
    .align 2
3828:cur_seg:
    .word 0

3832:lastCharRead:
    .word -2 # -2 => no buffered character
3836:prevHashConstant:
    .word 0x2785173c
3840:gcCount:
    .word 0

3844:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
3871:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
3894:strIndexOutOfBoundsMsg:
