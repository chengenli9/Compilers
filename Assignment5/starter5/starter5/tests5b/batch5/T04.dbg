2640#  move $s2, $t0
2644#  jal mth_printStr_Lib
2648#  addu $sp, $sp, 4
2652#  lw $s2, ($sp)
2656#  addu $sp, $sp, 4
2660#  subu $sp, $sp, 4
2664#  sw $t0, ($sp)
2668#  lw $t0, ($sp)
