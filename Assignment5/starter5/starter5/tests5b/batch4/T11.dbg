3105##...lui $at,4791
3109##...addiu $at,$at,-28718
3113##...addu $t1,$at,$t1
3116#    sw $t1,prevHashConstant # update hash constant
3120#    or $t1,0x80000000 # set top bit
3121##...lui $at,32768
3125##...or $t1,$at,$t1
3128#    and $t1,0xffffff00 # clear low bit
3129##...lui $at,65535
3133##...ori $at,$at,0xff00
3137##...and $t1,$t1,$at
3140#    or $s6,$t1
3144:firstHeaderLarge:
3144#    sw $s6,-8($t0) # store header-1 value
