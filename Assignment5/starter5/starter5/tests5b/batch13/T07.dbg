1464#    subu $t0,$v0,10
1468#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
1472#    subu $t0,$v0,9
1476#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
1480#    subu $t0,$v0,13
1484#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
