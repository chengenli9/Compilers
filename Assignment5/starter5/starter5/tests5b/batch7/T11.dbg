1080#    seq $t0,$t0,$zero
1081##...subu $at,$t0,$zero
1085##...sltiu $t0,$at,1

    # pop return address and return $t0
1088#    lw $ra,($sp)
1092#    addu $sp,4

1096#    jr $ra # return
    
1100:goEsFalse:
    # put 0 in $t0 and return
1100#    li $t0, 0
1104#    jr $ra # return
