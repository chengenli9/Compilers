###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1316:mth_hashCode_String:
1316#    move $t0,$s2 # put this pointer in t0

1320#    li $t2,0 # current hash value
1324#    lw $t1,-4($t0) # negative of number of characters in string
1328#    beq $t1,$zero,done_hashCode_String # if zero length => done
1332#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
1336#    and $t0,0xfffffffc # adjust for padding
1337##...lui $at,65535
1341##...ori $at,$at,0xfffc
1345##...and $t0,$t0,$at
1348#    subu $t1,$t0,$t1 # address at end of string +12
1352:loop_hashCode_String:    
1352#    sll $t4,$t2,5 # multiply by 32
1356#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
1360#    lbu $t3,-12($t0) # current character
1364#    addu $t2,$t3 # add in current character
1368#    addu $t0,1 # go to next character's address
1372#    bne $t0,$t1,loop_hashCode_String # loop back if more
1376:done_hashCode_String:    

    # push int on stack
1376#    move $t0, $t2 # put $t2 in return slot
1380#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
1384:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
1384#    subu $sp,4
1388#    sw $ra,($sp)
    
    # get hash value
1392#    lw $t2,-12($s2) # vtable address
1396#    lw $t0,($t2) # method address
1400#    jalr $t0
1404#    subu $sp,8 # push result (int in $t0) on stack
1408#    sw $s5,4($sp)
1412#    sw $t0,($sp)

    # compute print-size of hash value
1416#    li $t0, 1
1420#    lw $t1, ($sp)
1424#    srl $t1,$t1,4
1428#    beq $t1,$zero,toString_skip_loop
1432:toString_loop_top:
1432#    addu $t0,1
1436#    srl $t1,$t1,4
1440#    bne $t1,$zero,toString_loop_top
1444:toString_skip_loop:
1444#    subu $sp,8
1448#    sw $s5,4($sp)
1452#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
1456#    lw $t2,-12($s2) # vtable address
1460#    move $t0,$t2
1464:toString_checkTagBit:
1464#    subu $t0,1
1468#    lb $t1,($t0)
1472#    and $t1,0x80
1473##...lui $at,0
1477##...ori $at,$at,0x80
1481##...and $t1,$t1,$at
1484#    beq $t1,$zero,toString_checkTagBit
1488#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
1492#    subu $sp,8
1496#    sw $t1,($sp)
1500#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
1504#    move $s7,$zero # -4 offset header word
1508#    lw $t4,8($sp) # bytes for hash value
1512#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
1516#    addu $t4,8
1520#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
1524#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

1528#    li $t0,CLASS_String # store string vtable address into ...
1532#    sw $t0,-12($s7) # ... -12 offset in object header
1536#    lw $t2,-12($s2) # our object's vtable address
1540#    lw $t5,4($sp) # number characters in prefix
1544#    lw $t1,12($sp) # number of characters in hashcode
1548#    addu $t3,$t1,$t5 # number of characters in string ...
1552#    addu $t3,1 # ... including the '@' character
1556#    subu $t0,$zero,$t3 # store negated length into ...
1560#    sw $t0,-4($s7) # ... -4 offset header word
1564#    lw $t0,-8($s7) # get -8 offset header-word
1568#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
1569##...slt $at,$t0,$zero
1573##...beq $at,$zero,1592
1576#    and $t0,0xff # mask off object's hash value ...
1577##...lui $at,0
1581##...ori $at,$at,0xff
1585##...and $t0,$t0,$at
1588#    sw $t0,-8($s7) # ... and store back into -8 header-word
1592:skipMask_toString:
1592#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
1596#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
1600#    subu $t4,$t2,$t5
1604:toString_copyLoop:    
1604#    lb $t3,($t4)
1608#    and $t3,0x7f # mask off sign bit (in case first word)
1609##...lui $at,0
1613##...ori $at,$at,0x7f
1617##...and $t3,$t3,$at
1620#    sb $t3,-8($t0)
1624#    addu $t4,1
1628#    addu $t0,1
1632#    blt $t4,$t2,toString_copyLoop
1633##...slt $at,$t4,$t2
1637##...bne $at,$zero,1604

    # copy the '@' sign
1640#    li $t3,'@'
1644#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
1648#    addu $t2,$t0,$t1 # address of last byte in string to store +8
1652#    lw $t3,20($sp) # hash code to print
1656:toString_hashCopyLoop:
1656#    and $t4,$t3,0xf
1660#    srl $t3,4
1664#    lb $t4,hexChars($t4)
1668#    sb $t4,-8($t2)
1672#    subu $t2,$t2,1
1676#    bgt $t2,$t0,toString_hashCopyLoop
1677##...slt $at,$t0,$t2
1681##...bne $at,$zero,1656

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
1684#    addu $sp,28
1688#    lw $ra,($sp)
1692#    addu $sp,4
1696#    move $t0, $s7 # return string we created
1700#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
1704:mth_equals_String:
    
    # quick test for obvious false
1704#    lw $t0,($sp) # second parameter
1708#    beq $t0,$zero,goEsFalse # go return false if null
1712#    lw $t1,-12($t0) # vtable pointer
1716#    la $t2,CLASS_String # string vtable pointer
1720#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
1724#    subu $sp,12
1728#    sw $ra,8($sp)
1732#    sw $s2,4($sp)
1736#    sw $t0,($sp)
1740#    jal mth_compareTo_String
1744#    lw $s2, 4($sp) #restore this pointer and pop parameters
1748#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
1752#    seq $t0,$t0,$zero
1753##...subu $at,$t0,$zero
1757##...sltiu $t0,$at,1

    # pop return address and return $t0
1760#    lw $ra,($sp)
1764#    addu $sp,4

1768#    jr $ra # return
    
1772:goEsFalse:
    # put 0 in $t0 and return
1772#    li $t0, 0
1776#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
