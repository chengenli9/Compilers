1205##...slt $at,$v0,$zero
1209##...bne $at,$zero,1224

    # we have a character, so push it onto stack
1212#    subu $sp,$sp,4
1216#    sw $v0,($sp)

    # loop back up to get next character
1220#    j doRead

1224:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
1224#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
1228#    li $s7, 0 # return-value: null
1232#    j rlReturn # return

1236:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
1236#    subu $t0,$t1,$sp # number of chars we read (times 4)
1240#    srl $s6,$t0,2 # number of words on stack with chars
1244#    subu $sp,$sp,4 # push char-count ...
1248#    sw $s6,($sp) # ... onto stack
1252#    addu $t2,$t0,5 # GC tag, incl. for count-word
1256#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
1260#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
1264#    srl $s6,$s6,2  # data words in object
1268#    move $s7,$zero # object words in object
1272#    jal newObject  # allocate space
    
    # store header words
1276#    la $t0,CLASS_String
1280#    sw $t0,-12($s7)# store class tag (String) into object
1284#    lw $t2,4($sp) # char-count
1288#    sll $t1,$t2,2 # 4 times number of chars
1292#    subu $t2,$zero,$t2 # negative of char-count
1296#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
1300#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
1304#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
1305##...slt $at,$t0,$zero
1309##...beq $at,$zero,1328
1312#    and $t0,0xff # mask off object's hash value ...
1313##...lui $at,0
1317##...ori $at,$at,0xff
1321##...and $t0,$t0,$at
1324#    sw $t0,-8($s7) # ... and store back into -8 header-word
1328:  skipMask_readLine:

1328#    sll $t0,$t0,2 # data bytes in object
1332#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
1336#    subu $t0,$t0,$t2 # place to store last character (plus 9)
1340#    addu $sp,$sp,8 # pop redundant object-pointer and count
