3669##...lui $at,0
3673##...ori $at,$at,0xff
3677##...and $t2,$t2,$at
3680:gcSkip4a:    
3680#    sll $t2,$t2,2 # # data bytes
3684#    addu $t2,$t2,8 # to skip header words
3688#    addu $t2,$t0,$t2 # pointer to new object
