1449##...sltu $at,$t1,$t2
1453##...beq $at,$zero,3736
1456#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

1460:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

1460#    jal readLogicalChar # read next character
1464#    subu $t1,$v0,'0' # convert digit to 0-9 value
1468#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
1469##...sltu $at,$t1,$t2
1473##...beq $at,$zero,1492

1476#    mul $t3,$t3,$t2 # multiply old value by 10
1477##...mult $t3,$t2
1481##...mflo $t3
1484#    addu $t3,$t3,$t1 # add in value of new digit
1488#    j digitLoop
