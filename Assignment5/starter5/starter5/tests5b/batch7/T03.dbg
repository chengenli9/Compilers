###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
2632:mth_readLine_Lib:
    
2632#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
2636#    sw $ra, 4($sp) # save $ra
2640#    move $t1,$sp # save "original" sp

2644:  doRead:

    # read the character
2644#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
2648#    subu $t2,$v0,13
2652#    bne $t2,$zero,notReturnRL
2656#    jal readLogicalChar
2660#    subu $t2,$v0,10 # check for newline
2664#    beq $t2,$zero,foundNewLine
2668#    sw $v0,lastCharRead # push back character into queue
2672#    j foundNewLine # go process the line

2676:  notReturnRL:

    # at this point, $v0 has our character

2676#    subu $t0,$v0,10
2680#    beq $t0,$zero,foundNewLine
2684#    blt $v0,$zero,foundEof
2685##...slt $at,$v0,$zero
2689##...bne $at,$zero,2704

    # we have a character, so push it onto stack
2692#    subu $sp,$sp,4
2696#    sw $v0,($sp)

    # loop back up to get next character
2700#    j doRead

2704:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
2704#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
2708#    li $s7, 0 # return-value: null
2712#    j rlReturn # return

2716:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
2716#    subu $t0,$t1,$sp # number of chars we read (times 4)
2720#    srl $s6,$t0,2 # number of words on stack with chars
2724#    subu $sp,$sp,4 # push char-count ...
2728#    sw $s6,($sp) # ... onto stack
2732#    addu $t2,$t0,5 # GC tag, incl. for count-word
2736#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
2740#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
2744#    srl $s6,$s6,2  # data words in object
2748#    move $s7,$zero # object words in object
2752#    jal newObject  # allocate space
    
    # store header words
2756#    la $t0,CLASS_String
2760#    sw $t0,-12($s7)# store class tag (String) into object
2764#    lw $t2,4($sp) # char-count
2768#    sll $t1,$t2,2 # 4 times number of chars
2772#    subu $t2,$zero,$t2 # negative of char-count
2776#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
2780#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
2784#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
2785##...slt $at,$t0,$zero
2789##...beq $at,$zero,2808
2792#    and $t0,0xff # mask off object's hash value ...
2793##...lui $at,0
2797##...ori $at,$at,0xff
2801##...and $t0,$t0,$at
2804#    sw $t0,-8($s7) # ... and store back into -8 header-word
2808:  skipMask_readLine:

2808#    sll $t0,$t0,2 # data bytes in object
2812#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
2816#    subu $t0,$t0,$t2 # place to store last character (plus 9)
2820#    addu $sp,$sp,8 # pop redundant object-pointer and count
2824#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

2828#    beq $sp,$t1,rlReturn
2832:  charCopyLoop:
2832#    lw $t2,($sp)
2836#    sb $t2,-9($t0)
2840#    addu $sp,$sp,4
2844#    subu $t0,$t0,1
2848#    bne $sp,$t1,charCopyLoop
2852:  rlReturn:

2852#    lw $ra, 4($sp)
2856#    addu $sp, 8   # pop $ra and pointless word off stack
2860#    move $t0, $s7 # return string we allocated in $s7
2864#    jr $ra

