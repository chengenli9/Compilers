873##...slt $at,$t0,$zero
877##...beq $at,$zero,896
880#    and $t0,0xff # mask off object's hash value ...
881##...lui $at,0
885##...ori $at,$at,0xff
889##...and $t0,$t0,$at
892#    sw $t0,-8($s7) # ... and store back into -8 header-word
896:skipMask_toString:
896#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
900#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
904#    subu $t4,$t2,$t5
908:toString_copyLoop:    
908#    lb $t3,($t4)
912#    and $t3,0x7f # mask off sign bit (in case first word)
913##...lui $at,0
917##...ori $at,$at,0x7f
921##...and $t3,$t3,$at
924#    sb $t3,-8($t0)
928#    addu $t4,1
932#    addu $t0,1
