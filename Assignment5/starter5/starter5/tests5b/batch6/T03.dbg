    # set up the forwarding pointer
3572#    sw $zero,-8($t1) # 0 in first header-slot
3576#    sw $t2,-4($t1) # forwarding pointer in second header-slot

    # update the stack slot with the address in the target space
3580#    sw $t2,4($t0)
3584#    lw $zero,-8($t2)
3588#    lw $zero,-4($t2)

    # go handle next stack slot (testing if done)
3592#    j gcTestIterDone1

