1264#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
1268#    subu $t0,$v0,9
1272#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
1276#    subu $t0,$v0,13
1280#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
1284#    subu $t0,$v0,12
