###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1448:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
1448#    lw $t0,-8($s2) # get word with hash bits from this
1452#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
1456#    addu $t0,$t1

1460#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1464:mth_equals_Object:
1464#    move $t0,$s2 # first pointer (this)
1468#    lw $t1,($sp) # second pointer
1472#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
1473##...subu $at,$t0,$t1
1477##...sltiu $t0,$at,1

1480#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1484:mth_hashCode_String:
1484#    move $t0,$s2 # put this pointer in t0

1488#    li $t2,0 # current hash value
1492#    lw $t1,-4($t0) # negative of number of characters in string
1496#    beq $t1,$zero,done_hashCode_String # if zero length => done
1500#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
1504#    and $t0,0xfffffffc # adjust for padding
1505##...lui $at,65535
1509##...ori $at,$at,0xfffc
1513##...and $t0,$t0,$at
1516#    subu $t1,$t0,$t1 # address at end of string +12
1520:loop_hashCode_String:    
1520#    sll $t4,$t2,5 # multiply by 32
1524#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
1528#    lbu $t3,-12($t0) # current character
1532#    addu $t2,$t3 # add in current character
1536#    addu $t0,1 # go to next character's address
1540#    bne $t0,$t1,loop_hashCode_String # loop back if more
1544:done_hashCode_String:    

    # push int on stack
1544#    move $t0, $t2 # put $t2 in return slot
1548#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
1552:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
1552#    subu $sp,4
1556#    sw $ra,($sp)
    
    # get hash value
1560#    lw $t2,-12($s2) # vtable address
1564#    lw $t0,($t2) # method address
1568#    jalr $t0
1572#    subu $sp,8 # push result (int in $t0) on stack
1576#    sw $s5,4($sp)
1580#    sw $t0,($sp)

    # compute print-size of hash value
1584#    li $t0, 1
1588#    lw $t1, ($sp)
1592#    srl $t1,$t1,4
1596#    beq $t1,$zero,toString_skip_loop
1600:toString_loop_top:
1600#    addu $t0,1
1604#    srl $t1,$t1,4
1608#    bne $t1,$zero,toString_loop_top
1612:toString_skip_loop:
1612#    subu $sp,8
1616#    sw $s5,4($sp)
1620#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
1624#    lw $t2,-12($s2) # vtable address
1628#    move $t0,$t2
1632:toString_checkTagBit:
1632#    subu $t0,1
1636#    lb $t1,($t0)
1640#    and $t1,0x80
1641##...lui $at,0
1645##...ori $at,$at,0x80
1649##...and $t1,$t1,$at
1652#    beq $t1,$zero,toString_checkTagBit
1656#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
1660#    subu $sp,8
1664#    sw $t1,($sp)
1668#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
1672#    move $s7,$zero # -4 offset header word
1676#    lw $t4,8($sp) # bytes for hash value
1680#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
1684#    addu $t4,8
1688#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
1692#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

1696#    li $t0,CLASS_String # store string vtable address into ...
1700#    sw $t0,-12($s7) # ... -12 offset in object header
1704#    lw $t2,-12($s2) # our object's vtable address
1708#    lw $t5,4($sp) # number characters in prefix
1712#    lw $t1,12($sp) # number of characters in hashcode
1716#    addu $t3,$t1,$t5 # number of characters in string ...
1720#    addu $t3,1 # ... including the '@' character
1724#    subu $t0,$zero,$t3 # store negated length into ...
1728#    sw $t0,-4($s7) # ... -4 offset header word
1732#    lw $t0,-8($s7) # get -8 offset header-word
1736#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
1737##...slt $at,$t0,$zero
1741##...beq $at,$zero,1760
1744#    and $t0,0xff # mask off object's hash value ...
1745##...lui $at,0
1749##...ori $at,$at,0xff
1753##...and $t0,$t0,$at
1756#    sw $t0,-8($s7) # ... and store back into -8 header-word
1760:skipMask_toString:
1760#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
1764#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
1768#    subu $t4,$t2,$t5
1772:toString_copyLoop:    
1772#    lb $t3,($t4)
1776#    and $t3,0x7f # mask off sign bit (in case first word)
1777##...lui $at,0
1781##...ori $at,$at,0x7f
1785##...and $t3,$t3,$at
1788#    sb $t3,-8($t0)
1792#    addu $t4,1
1796#    addu $t0,1
1800#    blt $t4,$t2,toString_copyLoop
1801##...slt $at,$t4,$t2
1805##...bne $at,$zero,1772

    # copy the '@' sign
1808#    li $t3,'@'
1812#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
1816#    addu $t2,$t0,$t1 # address of last byte in string to store +8
1820#    lw $t3,20($sp) # hash code to print
1824:toString_hashCopyLoop:
1824#    and $t4,$t3,0xf
1828#    srl $t3,4
1832#    lb $t4,hexChars($t4)
1836#    sb $t4,-8($t2)
1840#    subu $t2,$t2,1
1844#    bgt $t2,$t0,toString_hashCopyLoop
1845##...slt $at,$t0,$t2
1849##...bne $at,$zero,1824

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
1852#    addu $sp,28
1856#    lw $ra,($sp)
1860#    addu $sp,4
1864#    move $t0, $s7 # return string we created
1868#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
1872:mth_equals_String:
    
    # quick test for obvious false
1872#    lw $t0,($sp) # second parameter
1876#    beq $t0,$zero,goEsFalse # go return false if null
1880#    lw $t1,-12($t0) # vtable pointer
1884#    la $t2,CLASS_String # string vtable pointer
1888#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
1892#    subu $sp,12
1896#    sw $ra,8($sp)
1900#    sw $s2,4($sp)
1904#    sw $t0,($sp)
1908#    jal mth_compareTo_String
1912#    lw $s2, 4($sp) #restore this pointer and pop parameters
1916#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
1920#    seq $t0,$t0,$zero
1921##...subu $at,$t0,$zero
1925##...sltiu $t0,$at,1

    # pop return address and return $t0
1928#    lw $ra,($sp)
1932#    addu $sp,4

1936#    jr $ra # return
    
1940:goEsFalse:
    # put 0 in $t0 and return
1940#    li $t0, 0
1944#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
1948:mth_toString_String:
    #we are a string, so return this.
1948#    move $t0, $s2
1952#    jr $ra

###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
1956:mth_readLine_Lib:
    
1956#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
1960#    sw $ra, 4($sp) # save $ra
1964#    move $t1,$sp # save "original" sp

1968:  doRead:

    # read the character
1968#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
1972#    subu $t2,$v0,13
1976#    bne $t2,$zero,notReturnRL
1980#    jal readLogicalChar
1984#    subu $t2,$v0,10 # check for newline
1988#    beq $t2,$zero,foundNewLine
1992#    sw $v0,lastCharRead # push back character into queue
1996#    j foundNewLine # go process the line

2000:  notReturnRL:

    # at this point, $v0 has our character

2000#    subu $t0,$v0,10
2004#    beq $t0,$zero,foundNewLine
2008#    blt $v0,$zero,foundEof
2009##...slt $at,$v0,$zero
2013##...bne $at,$zero,2028

    # we have a character, so push it onto stack
2016#    subu $sp,$sp,4
2020#    sw $v0,($sp)

    # loop back up to get next character
2024#    j doRead

2028:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
2028#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
2032#    li $s7, 0 # return-value: null
2036#    j rlReturn # return

2040:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
2040#    subu $t0,$t1,$sp # number of chars we read (times 4)
2044#    srl $s6,$t0,2 # number of words on stack with chars
2048#    subu $sp,$sp,4 # push char-count ...
2052#    sw $s6,($sp) # ... onto stack
2056#    addu $t2,$t0,5 # GC tag, incl. for count-word
2060#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
2064#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
2068#    srl $s6,$s6,2  # data words in object
2072#    move $s7,$zero # object words in object
2076#    jal newObject  # allocate space
    
    # store header words
2080#    la $t0,CLASS_String
2084#    sw $t0,-12($s7)# store class tag (String) into object
2088#    lw $t2,4($sp) # char-count
2092#    sll $t1,$t2,2 # 4 times number of chars
2096#    subu $t2,$zero,$t2 # negative of char-count
2100#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
2104#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
2108#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
2109##...slt $at,$t0,$zero
2113##...beq $at,$zero,2132
2116#    and $t0,0xff # mask off object's hash value ...
2117##...lui $at,0
2121##...ori $at,$at,0xff
2125##...and $t0,$t0,$at
2128#    sw $t0,-8($s7) # ... and store back into -8 header-word
2132:  skipMask_readLine:

2132#    sll $t0,$t0,2 # data bytes in object
2136#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
2140#    subu $t0,$t0,$t2 # place to store last character (plus 9)
2144#    addu $sp,$sp,8 # pop redundant object-pointer and count
2148#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

2152#    beq $sp,$t1,rlReturn
2156:  charCopyLoop:
2156#    lw $t2,($sp)
2160#    sb $t2,-9($t0)
2164#    addu $sp,$sp,4
2168#    subu $t0,$t0,1
2172#    bne $sp,$t1,charCopyLoop
2176:  rlReturn:

2176#    lw $ra, 4($sp)
2180#    addu $sp, 8   # pop $ra and pointless word off stack
2184#    move $t0, $s7 # return string we allocated in $s7
2188#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
2192:mth_readInt_Lib:

    # save $ra by pushing onto stack
2192#    subu $sp,$sp,4
2196#    sw $ra,($sp)

2200:  riSkipWhiteLoop:
    # read a character
2200#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
2204#    subu $t0,$v0,32
2208#    bgt $t0,$zero,nonWhite
2209##...slt $at,$zero,$t0
2213##...bne $at,$zero,2256
2216#    beq $t0,$zero,riSkipWhiteLoop # start over if space
2220#    subu $t0,$v0,10
2224#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
2228#    subu $t0,$v0,9
2232#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
2236#    subu $t0,$v0,13
2240#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
2244#    subu $t0,$v0,12
2248#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
2252#    j badIntegerFormat # illegal integer char: abort program

2256:  nonWhite:
2256#    subu $t0,$v0,'-'
2260#    li $t4,1 # final multiplier
2264#    bne $t0,$zero,helpReadInt # go read
2268#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
2272#    jal readLogicalChar

2276:  helpReadInt:
2276#    li $t2,10
2280#    subu $t1,$v0,'0' # convert digit to 0-9 value
2284#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
2285##...sltu $at,$t1,$t2
2289##...beq $at,$zero,4572
2292#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

2296:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

2296#    jal readLogicalChar # read next character
2300#    subu $t1,$v0,'0' # convert digit to 0-9 value
2304#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
2305##...sltu $at,$t1,$t2
2309##...beq $at,$zero,2328

2312#    mul $t3,$t3,$t2 # multiply old value by 10
2313##...mult $t3,$t2
2317##...mflo $t3
