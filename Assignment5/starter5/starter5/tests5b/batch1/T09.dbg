872#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
876#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
877##...slt $at,$t0,$zero
881##...beq $at,$zero,900
884#    and $t0,0xff # mask off object's hash value ...
885##...lui $at,0
889##...ori $at,$at,0xff
893##...and $t0,$t0,$at
896#    sw $t0,-8($s7) # ... and store back into -8 header-word
