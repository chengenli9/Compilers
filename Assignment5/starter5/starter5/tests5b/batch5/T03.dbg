# converts int to a one-character string: Java: ""+(char)(n&0xff)
# - parameters:
#   - ($sp) - the value to convert, n
#   - 4($sp) - GC tag
#   - 8($sp) - old-this-pointer
# - returns:
#   - $t0 - the string, which is the converted character
# - note: only the low 8 bits of the value n are used
########################################################
3112:mth_intToChar_Lib:
    # save return address
3112#    subu $sp,$sp,4
3116#    sw $ra,($sp)

    # allocate object
3120#    li $s6,2
3124#    move $s7,$zero
3128#    jal newObject

    # get n from string.
3132#    lw $t1,8($sp)

    # store "String" tag into class field
3136#    la $t0,CLASS_String
3140#    sw $t0,-12($s7)
        
    # mask off hash bits, if needed
3144#    lw $t4,-8($s7) # # data words in source string
3148#    bge $t4,$zero,skipMask_intToChar # don't strip hash code if not there
3149##...slt $at,$t4,$zero
3153##...beq $at,$zero,3172
3156#    and $t4,0xff # mask off object's hash value ...
3157##...lui $at,0
3161##...ori $at,$at,0xff
3165##...and $t4,$t4,$at
3168#    sw $t4,-8($s7) # ... and store back into -8 header-word
3172:  skipMask_intToChar:

    # store data in string
3172#    sb $t1,-16($s7)
    
    # store negative of size in header-word 2
3176#    li $t0,-1
3180#    sw $t0,-4($s7)

    # we're returning $s7
3184#    move $t0, $s7

    # restore $ra, and pop return address and return string off stack
3188#    lw $ra,4($sp)
3192#    addu $sp,$sp,8

    # return
3196#    jr $ra

########################################################
# str1.compareTo(str2) - library method (class String)
# compares two strings as in Java
# - parameters:
#   - ($sp) - second string
#   - 4($sp) - old this pointer
#   - $s2 - first string (this)
# - returns:
#   - $t0 - -1, 0, or 1 depending on whether str1 is
#       lexographically less than, equal to or greater than str2
########################################################
3200:mth_compareTo_String:
    # get string pointers and check parameter for null
3200#    lw $t0,($sp) # second string
3204#    beq $t0,$zero,nullPtrException
3208#    move $t1,$s2 # first string
    
    # get (negatives of) respective byte-lengths
3212#    lw $t2,-4($t0) # negative length of second string
3216#    lw $t3,-4($t1) # negative length of first string

    # put tentative return value in $t5.
    # The tentative return value is the one that we will use if we get
    # to the end of the shorter string during our comparison-loop.
3220#    slt $t4,$t3,$t2
3224#    slt $t5,$t2,$t3
3228#    subu $t5,$t5,$t4
    
    # at this point:
    # - $t0 contains the pointer to the second string object
    # - $t1 contains the pointer to the first string object
    # - $t5 contains the value to return if the strings compare equal up
    #   to the length of the shortest word

    # get begin-of-string addresses
3232#    lw $t2,-8($t0) # # data words in second string
3236#    lw $t3,-8($t1) # # data words in first string
3240#    sll $t2,$t2,2 # byte-offset to beginning of str2 (+8)
3244#    sll $t3,$t3,2 # byte-offset to beginning of str1 (+8)
3248#    subu $t0,$t0,$t2 # beginning of str1 address (+8)
3252#    subu $t1,$t1,$t3 # beginning of str2 address (+8)
    
    # put $t1-limit into $t2
3256#    beq $zero,$t5,skipStrCmpLenzz
3260#    move $t2,$t3
3264:  skipStrCmpLenzz:
3264#    add $t2,$t1,$t2
    
    # at this point:
    # - $t0 contains 8 plus the address of the first data-byte of str2
    # - $t1 contains 8 plus the address of the first data-byte of str1
    # - $t2 contains 8 plus the address of the last data-type of str1
    # - $t5 contains the value to return if the strings compare equal up
    #   to the length of the shortest word

    #######################################################
    # at this point, we have
    # - $t5 containing the tentative return-value
    # - $t1 containing address of first char in str2
    # - $t2 containing limit for $t1
    # - $t0 containing address of first char in str1
    #######################################################

    # loop through, until we find unequal words or we hit
    # our limit    
3268:  cmpLoopzz:
3268#    lw $t3,-8($t1) # word from str2
3272#    lw $t4,-8($t0) # word from str1
3276#    bne $t3,$t4,cmpNotEqualzz
3280#    addu $t1,$t1,4
3284#    addu $t0,$t0,4
3288#    bne $t1,$t2,cmpLoopzz

    # # got to the end of one string: go set up return
3292#    j cmpHitLimitzz

3296:  cmpNotEqualzz:
    # found unequal characters: return -1 or 1, depending on which is
    # greater
3296#    slt $t5,$t4,$t3 # 1 if str2 > str1, else 0
3300#    sll $t5,$t5,1 # 2 if str2 > str1, else 0
3304#    subu $t5,$t5,1 # 1 if str2 > str1, else -1
3308:  cmpHitLimitzz:
3308#    move $t0, $t5 # store return value
3312#    jr $ra # return

########################################################
# readLogicalChar (millicode)
#  - logically reads a character from standard input
#  - first checks character buffer, consuming it if possible
#  - return-result:
#    - returns character in $v0
#  - side-effects:
#    - reads a character
#    - clobbers $t0
########################################################
3316:readLogicalChar:

    # check if we already have a character
3316#    lw $v0,lastCharRead
3320#    li $t0,-2
3324#    beq $t0,$v0 doReadCh

    # we have our character from the buffer. Wipe out
    # buffer and return
3328#    sw $t0,lastCharRead # store -2 into buffer (i.e. "empty")
3332#    jr $ra # return
    
3336:  doReadCh:
    # we need to actually read a character: read and return
3336#    li $v0,12 # use system call to read a character
3340#    syscall
3344#    jr $ra # return

########################################################
# newObject (millicode)
#  - allocates a new object on the heap
#  - two-word header is set up properly
#  - all non-header words in object are set to zero
#  - parameters:
#    - $s6 = the number of data words in the negative-offset portion of
#      the object (including the vtable pointer); this value is 1 if the
#      object is an array; this should always be at least 1
#    - $s7 - second header-word, which is the number of object
#      words in the object
#      - $s7 may not be negative (this is checked); if so, the program is
#        aborted with an "array size of out bounds" error message
#      is treated as if it were zero
#  - return-result:
#    - returned in $s7
#    - and pushed on the stack
#  - side-effects:
#  - may trash all $tx registers and all $sx registers, except the
#    "permanent" ones, which get updated with values that are
#    consistent with the new space
########################################################
3348:newObject:
    # $s6 = # data words
    # $s7 = # object words (# data words if data-array allocation,
    # where a negative number is treated as 0)
    # $ra = return address
    # on return, pointer to new memory in two places:
    # - pushed onto top of stack
    # - in $s7
    
    # if the object-portion size is negative, abort with error
3348#    blt $s7,$zero arraySizeOutOfBounds
3349##...slt $at,$s7,$zero
3353##...bne $at,$zero,4344

    # mark the fact that we have not yet GC'd for this allocation
3356#    move $t5,$zero

    ###### TEMPORARY #######
    # for now, go a GC unconditionally, so that a full GC occurs
    # every time we allocate an object
    ### let's not do that for now
    # j doGC

3360:  gcJoin:

    # at this point:
    #  $s6 contains the before-header word count
    #  $s7 contains the second header word, which is also the
    #    after-header word count
    #  $t5 is zero iff we have not GC'd for this allocation

    # determine if we have enough memory available
3360#    addu $t0,$s6,$s7
3364#    sll $t0,$t0,2
3368#    addu $t0,$t0,8 # amount of memory needed
3372#    addu $t1,$t0,$s3
3376#    bgtu $t1,$s4,doGC
3377##...sltu $at,$s4,$t1
3381##...bne $at,$zero,3504

    # at this point:
    #  $s3 points to beginning of segment, and
    #  $t1 points just past the end

    # zero out the memory
3384#    move $t2,$s3
3388:  zeroObjLoop:
3388#    sw $zero,($s3)
3392#    lw $zero,($s3)

3396#    addu $s3,4
3400#    bltu $s3,$t1,zeroObjLoop
3401##...sltu $at,$s3,$t1
3405##...bne $at,$zero,3388

    # at this point:
    #  $s3 has been updated to point to the next free slot,
    #    which is also the points just past our object

    # compute pointer value and set up header-words
3408#    sll $t0,$s7,2    # number of post-header bytes
3412#    subu $t0,$s3,$t0 # pointer that we will return

    # determine the value to store in the first header-word:
    # if <= 255 (unsigned):
    #  - it goes into low byte
    #  - hash bits go into high three bytes, with top bit being 1
    # if >255 (unsigned)
    #  - it goes into full word (with a 0 in the high bit)
    
3416#    li $t2,255
3420#    bgeu $s6,$t2 firstHeaderLarge
3421##...sltu $at,$s6,$t2
3425##...beq $at,$zero,3472
3428#    lw $t1,prevHashConstant
3432#    addu $t1,0x12b68fd2
3433##...lui $at,4791
3437##...addiu $at,$at,-28718
3441##...addu $t1,$at,$t1
3444#    sw $t1,prevHashConstant # update hash constant
3448#    or $t1,0x80000000 # set top bit
3449##...lui $at,32768
3453##...or $t1,$at,$t1
3456#    and $t1,0xffffff00 # clear low bit
3457##...lui $at,65535
3461##...ori $at,$at,0xff00
3465##...and $t1,$t1,$at
3468#    or $s6,$t1
3472:firstHeaderLarge:
3472#    sw $s6,-8($t0) # store header-1 value
3476#    lw $zero,-8($t0)

    # store second header-value
3480#    sw $s7,-4($t0)   # second header-word
3484#    lw $zero,-4($t0)
    
    # put return-value into $s7 and also push it onto top of stack
3488#    move $s7,$t0
3492#    subu $sp,$sp,4
3496#    sw $t0,($sp)

3500#    jr $ra
    
3504:  doGC:
    #####################################################
    # We need to do a garbage-collect
    #####################################################
 
     ####### print that we are doing a GC ########
     ####### THESE THREE LINES WILL NORMALLY BE COMMENTED OUT #######
#         la $a0,gcMsg # prints message: "GC!" 
#         li $v0,4 # syscall-code for print-string 
#         syscall 
       

    # if we've already done a GC for this allocation, then
    # we are actually out heap-memory: abort program
3504#    bne $t5,$zero,outOfHeapMemory
      
    # increment the number of times we've done a GC, for later reporting
3508#    lw $t5,gcCount
3512#    addu $t5,1
3516#    sw $t5,gcCount

    # save $s2 (our only rooted register) on the stack
    # so that the garbage collector processes it
3520#    subu $sp,$sp,4
3524#    sw $s2,($sp)

    # set $s3 to the address of the new segment and the
    # end-limit of the new segment, respectively,
    # Also, update cur_seg to refer to the other segment
3528#    lw $t0,cur_seg
3532#    move $t7,$s4
3536#    la $t6,seg1_start
3537##...lui $t6,16
3541##...addiu $t6,$t6,4984
3544#    la $s3,seg0_start
3548#    la $s4,seg0_end
3549##...lui $s4,16
3553##...addiu $s4,$s4,4984
3556#    sw $zero,cur_seg
3560#    bne $t0,$zero,skipGc1
3564#    la $t6,seg0_start
3568#    la $s3,seg1_start
3569##...lui $s3,16
3573##...addiu $s3,$s3,4984
3576#    la $s4,seg1_end
3577##...lui $s4,32
3581##...addiu $s4,$s4,4984
3584#    sw $s5,cur_seg
3588:  skipGc1:
3588#    li $t5,0x80000000
3592#    lw $t0,stack_bottom
3596#    subu $t0,4


    ###############################################################
    # at this point:
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first address of the target space
    # - $s4 contains the limit address of the target space
    # - cur_seg has been updated to refer to the target space
    # - $t0 contains the address of the deepest stack element
    # - $sp contains the address of the top stack element
    # - $s2 is available for use, having been pushed onto the stack
    # - $t5 contains the value 0x80000000
    ###############################################################

    ###### begin outer loop to copy all stack-direct objects ######

3600:  gcStackCopyLoop:
3600#    lw $t1,($t0) # current stack element

    # test if we have a GC tag
3604#    sll $t2,$t1,31 # zero iff low bit was zero
3608#    bne $t2,$zero,gcBump # go skip data values if low bit not zero

    # bump stack-address pointer
3612#    subu $t0,$t0,4

    # if value is out of range (which includes null=0), and is
    # therefore does not refer to an object on the heap, just go
    # loop back and do the next one
3616#    bleu $t1,$t6,gcTestIterDone1
3617##...sltu $at,$t6,$t1
3621##...beq $at,$zero,3784
3624#    bgtu $t1,$t7,gcTestIterDone1
3625##...sltu $at,$t7,$t1
3629##...bne $at,$zero,3784

    # if the object has already been moved, update the stack-value
    # via the forwarding pointer
3632#    lw $t2,-8($t1) # possible forwarding tag
3636#    bne $t2,$zero,gcNoForward1 # if not forwarding tag, go copy
3640#    lw $t2,-4($t1) # forwarding pointer: object's new address
3644#    sw $t2,4($t0) # update stack value
3648#    j gcTestIterDone1 # do next iteration

3652:  gcNoForward1:
    #########################################################
    # we actually need to copy the object into the new space
    #########################################################

    # compute the amount of space that is needed
3652#    bge $t2,$zero,gcSkip2
3653##...slt $at,$t2,$zero
3657##...beq $at,$zero,3672
3660#    and $t2,0xff #### mask off hash value
3661##...lui $at,0
3665##...ori $at,$at,0xff
3669##...and $t2,$t2,$at
    #### OLD
    #### subu $t2,$zero,$t2 # set to 1 if -1 (number of data words)

3672:  gcSkip2:
3672#    sll $t2,$t2,2
3676#    addu $t2,$t2,8
3680#    subu $t4,$t1,$t2 # address of first word of source
3684#    lw $t3,-4($t1) # number of object words (negative means zero)
3688#    bge $t3,$zero,gcH2Neg1
3689##...slt $at,$t3,$zero
3693##...beq $at,$zero,3700
3696#    move $t3,$zero
3700:  gcH2Neg1:
3700#    sll $t3,$t3,2
3704#    addu $t3,$t3,$t1 # address one word past last word of source

3708#    addu $t2,$s3,$t2 # pointer to target object

    #########################################################
    # At this point:
    # - $t0 contains the address of the stack slot we'll
    #   process next
    # - $t1 contains the contents of the stack slot we're
    #   currently working on, which is a pointer to the source
    #   object (i.e., the address just beyond the object's header)
    # - $t2 contains the pointer to the target object
    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0-2
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger" in the target space
3712#    lw $s0,($t4)
3716#    lw $s1,-8($t1)
3720#    sw $s1,($t4)
3724#    sw $s0,-8($t1)
    
    # copy all source bytes to the target
3728:  gCinnerCopy1:
3728#    lw $s0,($t4)
3732#    sw $s0,($s3)
3736#    addu $t4,$t4,4
3740#    addu $s3,$s3,4
3744#    bltu $t4,$t3,gCinnerCopy1
3745##...sltu $at,$t4,$t3
3749##...bne $at,$zero,3728

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
3752#    sw $zero,-8($t1) # 0 in first header-slot
3756#    sw $t2,-4($t1) # forwarding pointer in second header-slot

    # update the stack slot with the address in the target space
3760#    sw $t2,4($t0)
3764#    lw $zero,-8($t2)
3768#    lw $zero,-4($t2)

    # go handle next stack slot (testing if done)
3772#    j gcTestIterDone1

3776:  gcBump:
    #### we have a GC tag.  Bytes to skip: tag value + 3.
3776#    subu $t0,$t0,$t1
3780#    subu $t0,$t0,3

3784:  gcTestIterDone1:
3784#    bgeu $t0,$sp,gcStackCopyLoop
3785##...sltu $at,$t0,$sp
3789##...beq $at,$zero,3600

    ###### end outer loop to copy all stack-direct objects ######

    #############################################################
    # We have finished processing the stack elements.  Now we need
    # to update elements in the heap itself. This may itself involve
    # moving additional objects
    #############################################################

    #########################################################
    # At this point:
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # We want to set things up so that in addition:
    # - $t0 is the "trailing finger", containing the address
    #   of the first slot in target space that we have yet
    #   to process.
    # Then during processing:
    # - $t1 will contain the contents of the heap slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # And when we're actually copying an object:
    # - $t2 will contain pointer to the target object
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - available for use: $s0
    ##########################################################

    # set $t0 to be at the beginning of target-space
3792#    lw $t1,cur_seg
3796#    la $t0,seg0_start
3800#    beq $t1,$zero,gcSkip4
3804#    la $t0,seg1_start
3805##...lui $t0,16
3809##...addiu $t0,$t0,4984


3812:  gcSkip4:

    # if there were no objects put into the heap during stack
    # processing, we're done, so go finish up
3812#    bgeu $t0,$s3,gcFinishUp
3813##...sltu $at,$t0,$s3
3817##...beq $at,$zero,4108

    ###### begin outer loop to copy all non-stack-direct objects ######

3820:  gcHeapCopyLoop:
    # get data count for object; swap header-word with first word
    # of object so that they're back in the right place
3820#    lw $t1,($t0) # (what will be) first header word for current object
3824#    move $t2,$t1 # number data bytes in object (poss. w/hash bits)
3828#    bge $t2,$zero,gcSkip4a # are there hash bits?
3829##...slt $at,$t2,$zero
3833##...beq $at,$zero,3848
3836#    and $t2,0xff # mask off hash bits
3837##...lui $at,0
3841##...ori $at,$at,0xff
3845##...and $t2,$t2,$at
3848:gcSkip4a:    
3848#    sll $t2,$t2,2 # # data bytes
3852#    addu $t2,$t2,8 # to skip header words
3856#    addu $t2,$t0,$t2 # pointer to new object
3860#    lw $t3,-8($t2) # word to swap
3864#    sw $t1,-8($t2) # store header word
3868#    sw $t3,($t0) # restore first word of object

    ################################################
    # at this point:
    # - $t2 contains the pointer to our new object
    ################################################

    # check if we have a data array
3872#    lw $t1,-12($t2) # vtable pointer
3876#    li $t0,dataArrayVTableStart # address of vtable for first data array
3880#    blt $t1,$t0,gcNotDataArray # if data array, no more xforming to do
3881##...slt $at,$t1,$t0
3885##...bne $at,$zero,3904

    # We have a vtable address that is a data array.
    # we need skip over it then loop back to do next object.
3888:  skipToNextObj:
3888#    lw $t1,-4($t2) # data words in (object position of) array
    #### note: we know that it's not a string, so the value will
    #### not be artificially negative
3892#    sll $t1,$t1,2 # convert to byte-count
3896#    addu $t0,$t2,$t1 # skip over object
3900#    j gcTestIterDone2 # go do next object, if any

    ###################################################
    # at this point:
    # - the object has been restored to normal status--that is, the
    #   word-swap has been done
    # - $t2 contains a pointer to the object
    ###################################################
    
3904:  gcNotDataArray:
3904#    lw $t3,-4($t2) # # object words (negative treated as zero)
3908#    bge $t3,$zero,gcH2Neg2
3909##...slt $at,$t3,$zero
3913##...beq $at,$zero,3920
3916#    move $t3,$zero
3920:  gcH2Neg2:
3920#    sll $t3,$t3,2 # # object bytes
3924#    move $t0,$t2 # address of first pointer in object
3928#    add $s1,$t2,$t3 # limit address for this object

    #####################################################
    # At this point, we have to "translate" all pointers,
    # starting at $t0 to (but not including) $s1
    #####################################################

    # if there are no pointer-slots (i.e., $t0=$s1), skip this
    # part
3932#    beq $t0,$s1,gcTestIterDone2
    
3936:  gcNextPointerInObject:
    # get pointer from object
3936#    lw $t1,($t0)

    # if value is out of range, and is therefore does not refer
    # to an object, just go loop back and do the next one
3940#    bleu $t1,$t6,gcGoNextPointerSlot
3941##...sltu $at,$t6,$t1
3945##...beq $at,$zero,4088
3948#    bgtu $t1,$t7,gcGoNextPointerSlot
3949##...sltu $at,$t7,$t1
3953##...bne $at,$zero,4088

    # if the object has already been moved, update the stack-value
    # via the forwarding pointer
3956#    lw $t8,-8($t1) # possible forwarding tag
3960#    bne $t8,$zero,gcNoForward2 # if not forwarding tag, go copy
3964#    lw $t8,-4($t1) # forwarding pointer: object's new address
3968#    sw $t8,($t0) # update pointer in object
3972#    j gcGoNextPointerSlot # do next iteration

3976:  gcNoForward2:
    #########################################################
    # we actually need to copy the object into the new space
    #########################################################

    #########################################################
    # At this point:
    # - $t0 contains the address of the heap-slot we're translating
    # - $t1 will contain the contents of the heap-slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space, which will also be the first address
    #   of the target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # Then during processing:
    # And when we're actually copying an object:
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $t8 will contain a pointer to the target object
    # - available for use: $s0, $t8, $t9
    ##########################################################

    # compute the amount of space that is needed
3976#    bge $t8,$zero,gcSkip5 # # words in negative-offset portion
3977##...slt $at,$t8,$zero
3981##...beq $at,$zero,3996
3984#    and $t8,0xff # mask off hash bits
3985##...lui $at,0
3989##...ori $at,$at,0xff
3993##...and $t8,$t8,$at

3996:  gcSkip5:
3996#    sll $t8,$t8,2 # bytes in negative-offset portion ...
4000#    addu $t8,$t8,8 # ... add in bytes for header-words
4004#    subu $t4,$t1,$t8 # address of first word of source object
4008#    lw $t3,-4($t1) # # words in positive-offset portion
4012#    bge $t3,$zero,gcNoNeg
4013##...slt $at,$t3,$zero
4017##...beq $at,$zero,4024
4020#    move $t3,$zero # negative treated as zero
4024:  gcNoNeg:
4024#    sll $t3,$t3,2 # bytes in negative-offset portion
4028#    addu $t3,$t3,$t1 # address one word past last word of source

4032#    addu $t8,$s3,$t8 # pointer to target object

    #########################################################
    # At this point:
    # - $t0 contains the address of the stack slot we'll
    #   process next
    # - $t1 contains the contents of the stack slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $t8 contains the pointer to the target object
    # - $s1 contains the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0, $t9
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger"
4036#    lw $s0,($t4)
4040#    lw $t9,-8($t1)
4044#    sw $t9,($t4)
4048#    sw $s0,-8($t1)

    # copy all source bytes to the target
4052:  gCinnerCopy2:
4052#    lw $s0,($t4)
4056#    sw $s0,($s3)
4060#    addu $t4,$t4,4
4064#    addu $s3,$s3,4
4068#    bltu $t4,$t3,gCinnerCopy2
4069##...sltu $at,$t4,$t3
4073##...bne $at,$zero,4052

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
4076#    sw $zero,-8($t1) # 0 in first header-slot
4080#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
4084#    sw $t8,($t0)

4088:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
4088#    addu $t0,$t0,4
4092#    bltu $t0,$s1,gcNextPointerInObject
4093##...sltu $at,$t0,$s1
4097##...bne $at,$zero,3936

4100:  gcTestIterDone2:
4100#    bltu $t0,$s3,gcHeapCopyLoop
4101##...sltu $at,$t0,$s3
4105##...bne $at,$zero,3820

    ###### end outer loop to copy all non-stack-direct objects ######

4108:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
4108#    lw $s2,($sp)
4112#    addu $sp,$sp,4

    # mark us as having already GC'd
4116#    move $t5,$s5

    # go try and allocate again
4120#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
4124:vm_init:

    # mark bottom of stack
4124#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
4128#    move $s2,$zero

    #set up the "five" register
4132#    li $s5,5

4136#    la $s3,seg0_start
4140#    la $s4,seg0_end
4141##...lui $s4,16
4145##...addiu $s4,$s4,4984
    
    # return
4148#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4152:divide:
    # get parameters; abort if divisor zero
4152#    lw $t0,($sp)
4156#    lw $t1,8($sp)
4160#    beq $t0,$zero,divByZeroError
    
    # perform division
4164#    div $t1,$t0
4168#    mflo $t0

    # store result, adjust stack and return
4172#    addu $sp,$sp,8 # adjust stack
4176#    sw $t0,($sp) # store result
4180#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4184:remainder:
    # get parameters; abort if divisor zero
4184#    lw $t0,($sp)
4188#    lw $t1,8($sp)
4192#    beq $t0,$zero,divByZeroError
    
    # perform division
4196#    div $t1,$t0
4200#    mfhi $t0

    # store result, adjust stack and return
4204#    addu $sp,$sp,8 # adjust stack
4208#    sw $t0,($sp) # store result
4212#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
4216:checkCast:
    # get object, allow immediately if null
4216#    lw $t2,($sp)
4220#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
4224#    lw $t2,-12($t2) # vtable address
4228#    bge $t2,$t1,castException
4229##...slt $at,$t2,$t1
4233##...beq $at,$zero,4368
4236#    blt $t2,$t0,castException
4237##...slt $at,$t2,$t0
4241##...bne $at,$zero,4368
    
    # return, leaving object unchanged on stack
4244:  checkCastReturn:    
4244#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
4248:instanceOf:
    # get object, go return false if null
4248#    lw $t2,($sp)
4252#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
4256#    lw $t2,-12($t2) # vtable address
4260#    sge $t0,$t2,$t0 # are we >= the lower limit?
4261##...slt $t0,$t2,$t0
4265##...xori $t0,$t0,0x1
4268#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
4272#    and $t2,$t0,$t1
4276#    sw $t2,($sp)
4280:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
4280#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

4284:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
4284#    li $v0,4 # syscall-code for print-string
4288#    syscall
4292:exit:
    # print termination message
4292#    li $v0,4 # syscall-code for print-string
4296#    la $a0,exitString
4300#    syscall

    # terminate execution
4304#    li $v0,10 #syscall-code for "exit"
4308#    syscall

4312:outOfHeapMemory:
4312#    la $a0,heapMemoryMsg
4316#    j exitError
4320:divByZeroError:
4320#    la $a0,divByZeroMsg
4324#    j exitError
4328:strIndexOutOfBounds:
4328#    la $a0,strIndexOutOfBoundsMsg
4332#    j exitError
4336:arrayIndexOutOfBounds:
4336#    la $a0,arrayIndexOutOfBoundsMsg
4340#    j exitError
4344:arraySizeOutOfBounds:
4344#    la $a0,arraySizeOutOfBoundsMsg
4348#    j exitError
4352:nullPtrException:
4352#    la $a0,nullPtrExceptionMsg
4356#    j exitError
4360:badIntegerFormat:
4360#    la $a0,badIntegerFormatMsg
4364#    j exitError
4368:castException:
4368#    la $a0,castExceptionMsg
4372#    j exitError
############## data section ################
    .data
4620:hexChars:
    .ascii "0123456789abcdef"
    .align 2
4636:cur_seg:
    .word 0

4640:lastCharRead:
    .word -2 # -2 => no buffered character
4644:prevHashConstant:
    .word 0x2785173c
4648:gcCount:
    .word 0

4652:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
4679:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
4702:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
4737:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
4771:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
4804:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
4835:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
4883:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
4904:gcMsg: 
      .asciiz "\nGC!\n"
4910:gcCountMsg: 
      .asciiz "Number of garbage collections: "

4942:nullStr:
    .asciiz "null"
4947:trueString:
    .asciiz "true"
4952:falseString:
    .asciiz "false"
4958:exitString:
    .ascii "Program terminated."
    #### "falls through" here
4977:newlineString:
    .asciiz "\n"
    
    .align 2
4980:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

4984:seg0_start:
    .space 0x100000
1053560:seg0_end:
1053560:seg1_start:
    .space 0x100000
2102136:seg1_end:
