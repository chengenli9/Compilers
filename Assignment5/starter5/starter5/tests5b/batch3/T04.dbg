########################################################
# str.substring(n, k) - library method (class String)
# takes a substring of a string: Java: str.substring(n, k)
# - parameters after pushing RA:
#   - ($sp) - k: one beyond index of last char in subrange
#   - 4($sp) - GC tag
#   - 8($sp) - n: index of first char in subrange
#   - 12($sp) - GC tag
#   - 16($sp) - old this pointer
# - return value:
#  - $t0 - substring
########################################################
3512:mth_substring_String:

    # save $ra by pushing onto stack
3512#    subu $sp,$sp,4
3516#    sw $ra,($sp)

    # get string from this, we probably don't need the null check.
3520#    move $t0,$s2
3524#    beq $t0,$zero,nullPtrException

    # get both indices and string length, and ensure that
    #   0 <= n <= k <= length
3528#    lw $t0,-4($t0) # negative of string length
3532#    subu $t0,$zero,$t0 # string length
3536#    lw $t1,4($sp) # k
3540#    lw $t2,12($sp) # n
3544#    bgt $zero,$t2,strIndexOutOfBounds
3545##...slt $at,$t2,$zero
3549##...bne $at,$zero,5472
3552#    bgt $t2,$t1,strIndexOutOfBounds
3553##...slt $at,$t1,$t2
3557##...bne $at,$zero,5472
3560#    bgt $t1,$t0,strIndexOutOfBounds
3561##...slt $at,$t0,$t1
3565##...bne $at,$zero,5472

    # allocate memory
3568#    subu $s6,$t1,$t2 # # chars in target-string
3572#    addu $s6,$s6,7 # account for extra "class" (4) word + 3 to round up
3576#    srl $s6,$s6,2 # convert bytes-count to word-count
3580#    move $s7,$zero # (no object-bytes in string)
3584#    jal newObject

    # store "String" tag in object-type field
3588#    la $t0,CLASS_String
3592#    sw $t0,-12($s7)
    
    # mask off hash bits, if needed
3596#    lw $t4,-8($s7) # data words in source string
3600#    bge $t4,$zero,skipMask_substring # don't strip hash code if not there
3601##...slt $at,$t4,$zero
3605##...beq $at,$zero,3624
3608#    and $t4,0xff # mask off object's hash value ...
3609##...lui $at,0
3613##...ori $at,$at,0xff
3617##...and $t4,$t4,$at
3620#    sw $t4,-8($s7) # ... and store back into -8 header-word
3624:skipMask_substring:

    # store negative of count (=n-k) into object-length header-word
    # indicies have changed, because newObject is on stack
3624#    lw $t1,8($sp) # k
3628#    lw $t2,16($sp) # n
3632#    subu $t0,$t2,$t1 # value to store
3636#    sw $t0,-4($s7) # store value
    
3640#    move $t3,$s2 # source string pointer
    
    # skip byte-copy loop if length is zero
3644#    beq $zero,$t0,doneSubCopyzz

    # get pointers set up in preparation for copy
3648#    lw $t4,-8($t3) # data words in source string
3652#    sll $t4,$t4,2 # data bytes in source string (incl. padding)
3656#    subu $t3,$t3,$t4 # addr. of first data word of source string (+8)
3660#    addu $t3,$t3,$t2 # addr. of first source data byte to be copied (+8)
3664#    subu $t1,$t3,$t0 # addr. beyond last source data byte to be copied (+8)
3668#    lw $t2,-8($s7)   # data words in target string
3672#    sll $t2,$t2,2    # data bytes in target string
3676#    subu $t2,$s7,$t2 # addr. of first target data byte (+8)
    
    ############################################
    # at this point:
    # - we know that the string has a positive length
    # - $t3 contains 8 + address of the first source-byte
    # - $t1 contains 8 + limit-address of the first source-byte
    # - $t2 contains 8 + address first target byte
    ############################################

    # copy the bytes from source to target
3680:  subCopyLoopzz:
3680#    lb $t4,-8($t3)
3684#    sb $t4,-8($t2)
3688#    addu $t2,$t2,1
3692#    addu $t3,$t3,1
3696#    blt $t3,$t1,subCopyLoopzz
3697##...slt $at,$t3,$t1
3701##...bne $at,$zero,3680
    
3704:  doneSubCopyzz:
    # restore return address, store return value, pop stack
3704#    lw $ra,4($sp) # restore $ra
3708#    addu $sp,$sp,8 # pop ra, and allocated newObject
3712#    move $t0, $s7 # we're returning the string we got back
                  # from newObject
    
    # return
3716#    jr $ra

########################################################
# length() - library method (class String)
# returns length of a string: Java: str.length()
# - parameters:
#   - ($sp) - old this pointer
# - return-value:
