###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1772:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
1772#    lw $t0,-8($s2) # get word with hash bits from this
1776#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
1780#    addu $t0,$t1

1784#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1788:mth_equals_Object:
1788#    move $t0,$s2 # first pointer (this)
1792#    lw $t1,($sp) # second pointer
1796#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
1797##...subu $at,$t0,$t1
1801##...sltiu $t0,$at,1

1804#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1808:mth_hashCode_String:
1808#    move $t0,$s2 # put this pointer in t0

1812#    li $t2,0 # current hash value
1816#    lw $t1,-4($t0) # negative of number of characters in string
1820#    beq $t1,$zero,done_hashCode_String # if zero length => done
1824#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
1828#    and $t0,0xfffffffc # adjust for padding
1829##...lui $at,65535
1833##...ori $at,$at,0xfffc
1837##...and $t0,$t0,$at
1840#    subu $t1,$t0,$t1 # address at end of string +12
1844:loop_hashCode_String:    
1844#    sll $t4,$t2,5 # multiply by 32
1848#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
1852#    lbu $t3,-12($t0) # current character
1856#    addu $t2,$t3 # add in current character
1860#    addu $t0,1 # go to next character's address
1864#    bne $t0,$t1,loop_hashCode_String # loop back if more
1868:done_hashCode_String:    

    # push int on stack
1868#    move $t0, $t2 # put $t2 in return slot
1872#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
1876:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
1876#    subu $sp,4
1880#    sw $ra,($sp)
    
    # get hash value
1884#    lw $t2,-12($s2) # vtable address
1888#    lw $t0,($t2) # method address
1892#    jalr $t0
1896#    subu $sp,8 # push result (int in $t0) on stack
1900#    sw $s5,4($sp)
1904#    sw $t0,($sp)

    # compute print-size of hash value
1908#    li $t0, 1
1912#    lw $t1, ($sp)
1916#    srl $t1,$t1,4
1920#    beq $t1,$zero,toString_skip_loop
1924:toString_loop_top:
1924#    addu $t0,1
1928#    srl $t1,$t1,4
1932#    bne $t1,$zero,toString_loop_top
1936:toString_skip_loop:
1936#    subu $sp,8
1940#    sw $s5,4($sp)
1944#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
1948#    lw $t2,-12($s2) # vtable address
1952#    move $t0,$t2
1956:toString_checkTagBit:
1956#    subu $t0,1
1960#    lb $t1,($t0)
1964#    and $t1,0x80
1965##...lui $at,0
1969##...ori $at,$at,0x80
1973##...and $t1,$t1,$at
1976#    beq $t1,$zero,toString_checkTagBit
1980#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
1984#    subu $sp,8
1988#    sw $t1,($sp)
1992#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
1996#    move $s7,$zero # -4 offset header word
2000#    lw $t4,8($sp) # bytes for hash value
2004#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
2008#    addu $t4,8
2012#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
2016#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

2020#    li $t0,CLASS_String # store string vtable address into ...
2024#    sw $t0,-12($s7) # ... -12 offset in object header
2028#    lw $t2,-12($s2) # our object's vtable address
2032#    lw $t5,4($sp) # number characters in prefix
2036#    lw $t1,12($sp) # number of characters in hashcode
2040#    addu $t3,$t1,$t5 # number of characters in string ...
2044#    addu $t3,1 # ... including the '@' character
2048#    subu $t0,$zero,$t3 # store negated length into ...
2052#    sw $t0,-4($s7) # ... -4 offset header word
2056#    lw $t0,-8($s7) # get -8 offset header-word
2060#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
2061##...slt $at,$t0,$zero
2065##...beq $at,$zero,2084
2068#    and $t0,0xff # mask off object's hash value ...
2069##...lui $at,0
2073##...ori $at,$at,0xff
2077##...and $t0,$t0,$at
2080#    sw $t0,-8($s7) # ... and store back into -8 header-word
2084:skipMask_toString:
2084#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
2088#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
2092#    subu $t4,$t2,$t5
2096:toString_copyLoop:    
2096#    lb $t3,($t4)
2100#    and $t3,0x7f # mask off sign bit (in case first word)
2101##...lui $at,0
2105##...ori $at,$at,0x7f
2109##...and $t3,$t3,$at
2112#    sb $t3,-8($t0)
2116#    addu $t4,1
2120#    addu $t0,1
2124#    blt $t4,$t2,toString_copyLoop
2125##...slt $at,$t4,$t2
2129##...bne $at,$zero,2096

    # copy the '@' sign
2132#    li $t3,'@'
2136#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
2140#    addu $t2,$t0,$t1 # address of last byte in string to store +8
2144#    lw $t3,20($sp) # hash code to print
2148:toString_hashCopyLoop:
2148#    and $t4,$t3,0xf
2152#    srl $t3,4
2156#    lb $t4,hexChars($t4)
2160#    sb $t4,-8($t2)
2164#    subu $t2,$t2,1
2168#    bgt $t2,$t0,toString_hashCopyLoop
2169##...slt $at,$t0,$t2
2173##...bne $at,$zero,2148

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
2176#    addu $sp,28
2180#    lw $ra,($sp)
2184#    addu $sp,4
2188#    move $t0, $s7 # return string we created
2192#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
2196:mth_equals_String:
    
    # quick test for obvious false
2196#    lw $t0,($sp) # second parameter
2200#    beq $t0,$zero,goEsFalse # go return false if null
2204#    lw $t1,-12($t0) # vtable pointer
2208#    la $t2,CLASS_String # string vtable pointer
2212#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
2216#    subu $sp,12
2220#    sw $ra,8($sp)
2224#    sw $s2,4($sp)
2228#    sw $t0,($sp)
2232#    jal mth_compareTo_String
2236#    lw $s2, 4($sp) #restore this pointer and pop parameters
2240#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
2244#    seq $t0,$t0,$zero
2245##...subu $at,$t0,$zero
2249##...sltiu $t0,$at,1

    # pop return address and return $t0
2252#    lw $ra,($sp)
2256#    addu $sp,4

2260#    jr $ra # return
    
2264:goEsFalse:
    # put 0 in $t0 and return
2264#    li $t0, 0
2268#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
2272:mth_toString_String:
    #we are a string, so return this.
2272#    move $t0, $s2
2276#    jr $ra

###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
2280:mth_readLine_Lib:
    
2280#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
2284#    sw $ra, 4($sp) # save $ra
2288#    move $t1,$sp # save "original" sp

2292:  doRead:

    # read the character
2292#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
2296#    subu $t2,$v0,13
2300#    bne $t2,$zero,notReturnRL
2304#    jal readLogicalChar
2308#    subu $t2,$v0,10 # check for newline
2312#    beq $t2,$zero,foundNewLine
2316#    sw $v0,lastCharRead # push back character into queue
2320#    j foundNewLine # go process the line

2324:  notReturnRL:

    # at this point, $v0 has our character

2324#    subu $t0,$v0,10
2328#    beq $t0,$zero,foundNewLine
2332#    blt $v0,$zero,foundEof
2333##...slt $at,$v0,$zero
2337##...bne $at,$zero,2352

    # we have a character, so push it onto stack
2340#    subu $sp,$sp,4
2344#    sw $v0,($sp)

    # loop back up to get next character
2348#    j doRead

2352:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
2352#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
2356#    li $s7, 0 # return-value: null
2360#    j rlReturn # return

2364:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
2364#    subu $t0,$t1,$sp # number of chars we read (times 4)
2368#    srl $s6,$t0,2 # number of words on stack with chars
2372#    subu $sp,$sp,4 # push char-count ...
2376#    sw $s6,($sp) # ... onto stack
2380#    addu $t2,$t0,5 # GC tag, incl. for count-word
2384#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
2388#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
2392#    srl $s6,$s6,2  # data words in object
2396#    move $s7,$zero # object words in object
2400#    jal newObject  # allocate space
    
    # store header words
2404#    la $t0,CLASS_String
2408#    sw $t0,-12($s7)# store class tag (String) into object
2412#    lw $t2,4($sp) # char-count
