    # lower limit, and if we're < the higher limit
4748#    lw $t2,-12($t2) # vtable address
4752#    sge $t0,$t2,$t0 # are we >= the lower limit?
4753##...slt $t0,$t2,$t0
4757##...xori $t0,$t0,0x1
4760#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
4764#    and $t2,$t0,$t1
4768#    sw $t2,($sp)
4772:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
4772#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

4776:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
4776#    li $v0,4 # syscall-code for print-string
4780#    syscall
4784:exit:
    # print termination message
4784#    li $v0,4 # syscall-code for print-string
4788#    la $a0,exitString
4792#    syscall

    # terminate execution
4796#    li $v0,10 #syscall-code for "exit"
4800#    syscall

4804:outOfHeapMemory:
4804#    la $a0,heapMemoryMsg
4808#    j exitError
4812:divByZeroError:
4812#    la $a0,divByZeroMsg
4816#    j exitError
4820:strIndexOutOfBounds:
4820#    la $a0,strIndexOutOfBoundsMsg
4824#    j exitError
4828:arrayIndexOutOfBounds:
4828#    la $a0,arrayIndexOutOfBoundsMsg
4832#    j exitError
4836:arraySizeOutOfBounds:
4836#    la $a0,arraySizeOutOfBoundsMsg
4840#    j exitError
4844:nullPtrException:
4844#    la $a0,nullPtrExceptionMsg
4848#    j exitError
4852:badIntegerFormat:
4852#    la $a0,badIntegerFormatMsg
4856#    j exitError
4860:castException:
4860#    la $a0,castExceptionMsg
4864#    j exitError
############## data section ################
    .data
5108:hexChars:
    .ascii "0123456789abcdef"
    .align 2
5124:cur_seg:
    .word 0

5128:lastCharRead:
    .word -2 # -2 => no buffered character
5132:prevHashConstant:
    .word 0x2785173c
5136:gcCount:
    .word 0

5140:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
5167:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
5190:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
5225:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
5259:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
5292:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
5323:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
5371:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
5392:gcMsg: 
      .asciiz "\nGC!\n"
5398:gcCountMsg: 
      .asciiz "Number of garbage collections: "

5430:nullStr:
    .asciiz "null"
5435:trueString:
    .asciiz "true"
5440:falseString:
    .asciiz "false"
5446:exitString:
    .ascii "Program terminated."
    #### "falls through" here
5465:newlineString:
    .asciiz "\n"
    
    .align 2
5468:stack_bottom:
    .word 0
