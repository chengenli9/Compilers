
    # determine if we have enough memory available
3232#    addu $t0,$s6,$s7
3236#    sll $t0,$t0,2
3240#    addu $t0,$t0,8 # amount of memory needed
3244#    addu $t1,$t0,$s3
3248#    bgtu $t1,$s4,doGC
