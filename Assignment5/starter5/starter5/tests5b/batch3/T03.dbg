##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
9176:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
9176#    lw $t0,-8($s2) # get word with hash bits from this
9180#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
9184#    addu $t0,$t1

9188#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
9192:mth_equals_Object:
9192#    move $t0,$s2 # first pointer (this)
9196#    lw $t1,($sp) # second pointer
9200#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
9201##...subu $at,$t0,$t1
9205##...sltiu $t0,$at,1

9208#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
9212:mth_hashCode_String:
9212#    move $t0,$s2 # put this pointer in t0

9216#    li $t2,0 # current hash value
9220#    lw $t1,-4($t0) # negative of number of characters in string
9224#    beq $t1,$zero,done_hashCode_String # if zero length => done
9228#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
9232#    and $t0,0xfffffffc # adjust for padding
9233##...lui $at,65535
9237##...ori $at,$at,0xfffc
9241##...and $t0,$t0,$at
9244#    subu $t1,$t0,$t1 # address at end of string +12
9248:loop_hashCode_String:    
9248#    sll $t4,$t2,5 # multiply by 32
9252#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
9256#    lbu $t3,-12($t0) # current character
9260#    addu $t2,$t3 # add in current character
9264#    addu $t0,1 # go to next character's address
9268#    bne $t0,$t1,loop_hashCode_String # loop back if more
9272:done_hashCode_String:    

    # push int on stack
9272#    move $t0, $t2 # put $t2 in return slot
9276#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
9280:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
9280#    subu $sp,4
9284#    sw $ra,($sp)
    
    # get hash value
9288#    lw $t2,-12($s2) # vtable address
9292#    lw $t0,($t2) # method address
9296#    jalr $t0
9300#    subu $sp,8 # push result (int in $t0) on stack
9304#    sw $s5,4($sp)
9308#    sw $t0,($sp)

    # compute print-size of hash value
9312#    li $t0, 1
9316#    lw $t1, ($sp)
9320#    srl $t1,$t1,4
9324#    beq $t1,$zero,toString_skip_loop
9328:toString_loop_top:
9328#    addu $t0,1
9332#    srl $t1,$t1,4
9336#    bne $t1,$zero,toString_loop_top
9340:toString_skip_loop:
9340#    subu $sp,8
9344#    sw $s5,4($sp)
9348#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
9352#    lw $t2,-12($s2) # vtable address
9356#    move $t0,$t2
9360:toString_checkTagBit:
9360#    subu $t0,1
9364#    lb $t1,($t0)
9368#    and $t1,0x80
9369##...lui $at,0
9373##...ori $at,$at,0x80
9377##...and $t1,$t1,$at
9380#    beq $t1,$zero,toString_checkTagBit
9384#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
9388#    subu $sp,8
9392#    sw $t1,($sp)
9396#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
9400#    move $s7,$zero # -4 offset header word
9404#    lw $t4,8($sp) # bytes for hash value
9408#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
9412#    addu $t4,8
9416#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
9420#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

9424#    li $t0,CLASS_String # store string vtable address into ...
9428#    sw $t0,-12($s7) # ... -12 offset in object header
9432#    lw $t2,-12($s2) # our object's vtable address
9436#    lw $t5,4($sp) # number characters in prefix
9440#    lw $t1,12($sp) # number of characters in hashcode
9444#    addu $t3,$t1,$t5 # number of characters in string ...
