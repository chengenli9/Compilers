    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $t8 contains the pointer to the target object
    # - $s1 contains the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0, $t9
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger"
3372#    lw $s0,($t4)
3376#    lw $t9,-8($t1)
3380#    sw $t9,($t4)
3384#    sw $s0,-8($t1)

    # copy all source bytes to the target
3388:  gCinnerCopy2:
3388#    lw $s0,($t4)
3392#    sw $s0,($s3)
3396#    addu $t4,$t4,4
3400#    addu $s3,$s3,4
3404#    bltu $t4,$t3,gCinnerCopy2
3405##...sltu $at,$t4,$t3
3409##...bne $at,$zero,3388

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
3412#    sw $zero,-8($t1) # 0 in first header-slot
3416#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
3420#    sw $t8,($t0)

3424:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
3424#    addu $t0,$t0,4
3428#    bltu $t0,$s1,gcNextPointerInObject
3429##...sltu $at,$t0,$s1
3433##...bne $at,$zero,3272

3436:  gcTestIterDone2:
3436#    bltu $t0,$s3,gcHeapCopyLoop
3437##...sltu $at,$t0,$s3
3441##...bne $at,$zero,3156

    ###### end outer loop to copy all non-stack-direct objects ######

3444:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
3444#    lw $s2,($sp)
3448#    addu $sp,$sp,4

    # mark us as having already GC'd
3452#    move $t5,$s5

    # go try and allocate again
3456#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
3460:vm_init:

    # mark bottom of stack
3460#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
3464#    move $s2,$zero

    #set up the "five" register
3468#    li $s5,5

3472#    la $s3,seg0_start
3476#    la $s4,seg0_end
3477##...lui $s4,16
3481##...addiu $s4,$s4,4396
    
    # return
3484#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3488:divide:
    # get parameters; abort if divisor zero
3488#    lw $t0,($sp)
3492#    lw $t1,8($sp)
3496#    beq $t0,$zero,divByZeroError
    
    # perform division
3500#    div $t1,$t0
3504#    mflo $t0

    # store result, adjust stack and return
3508#    addu $sp,$sp,8 # adjust stack
3512#    sw $t0,($sp) # store result
3516#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3520:remainder:
    # get parameters; abort if divisor zero
3520#    lw $t0,($sp)
3524#    lw $t1,8($sp)
3528#    beq $t0,$zero,divByZeroError
    
    # perform division
3532#    div $t1,$t0
3536#    mfhi $t0

    # store result, adjust stack and return
3540#    addu $sp,$sp,8 # adjust stack
3544#    sw $t0,($sp) # store result
3548#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
3552:checkCast:
    # get object, allow immediately if null
3552#    lw $t2,($sp)
3556#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
3560#    lw $t2,-12($t2) # vtable address
3564#    bge $t2,$t1,castException
3565##...slt $at,$t2,$t1
3569##...beq $at,$zero,3740
3572#    blt $t2,$t0,castException
3573##...slt $at,$t2,$t0
3577##...bne $at,$zero,3740
    
    # return, leaving object unchanged on stack
3580:  checkCastReturn:    
3580#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
3584:instanceOf:
    # get object, go return false if null
3584#    lw $t2,($sp)
3588#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
3592#    lw $t2,-12($t2) # vtable address
3596#    sge $t0,$t2,$t0 # are we >= the lower limit?
3597##...slt $t0,$t2,$t0
3601##...xori $t0,$t0,0x1
3604#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
3608#    and $t2,$t0,$t1
3612#    sw $t2,($sp)
3616:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
3616#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

3620:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
3620#    li $v0,4 # syscall-code for print-string
3624#    syscall
3628:exit:
    # print termination message
3628#    li $v0,4 # syscall-code for print-string
3632#    la $a0,exitString
3636#    syscall

    # print number of garbage collections
3640#    li $v0,4 # syscall-code for print-string
3644#    la $a0,gcCountMsg
3648#    syscall # print "Number of ..."
3652#    lw $a0,gcCount # number of GC's
3656#    li $v0,1 # code for print-int
3660#    syscall
3664#    li $v0,4 # syscall-code for print-string
3668#    la $a0,newlineString
3672#    syscall # print newline

    # terminate execution
3676#    li $v0,10 #syscall-code for "exit"
3680#    syscall

3684:outOfHeapMemory:
3684#    la $a0,heapMemoryMsg
3688#    j exitError
3692:divByZeroError:
3692#    la $a0,divByZeroMsg
3696#    j exitError
3700:strIndexOutOfBounds:
3700#    la $a0,strIndexOutOfBoundsMsg
3704#    j exitError
3708:arrayIndexOutOfBounds:
3708#    la $a0,arrayIndexOutOfBoundsMsg
3712#    j exitError
3716:arraySizeOutOfBounds:
3716#    la $a0,arraySizeOutOfBoundsMsg
3720#    j exitError
3724:nullPtrException:
3724#    la $a0,nullPtrExceptionMsg
3728#    j exitError
3732:badIntegerFormat:
3732#    la $a0,badIntegerFormatMsg
3736#    j exitError
3740:castException:
3740#    la $a0,castExceptionMsg
3744#    j exitError
############## data section ################
    .data
4024:hexChars:
    .ascii "0123456789abcdef"
    .align 2
4040:cur_seg:
    .word 0

4044:lastCharRead:
    .word -2 # -2 => no buffered character
4048:prevHashConstant:
    .word 0x2785173c
4052:gcCount:
    .word 0

4056:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
4083:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
4106:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
4141:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
4175:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
4208:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
4239:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
4287:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
4308:gcMsg: 
      .asciiz "\nGC!\n"
4314:gcCountMsg: 
      .asciiz "Number of garbage collections: "

4346:nullStr:
    .asciiz "null"
4351:trueString:
    .asciiz "true"
4356:falseString:
    .asciiz "false"
4362:exitString:
    .ascii "Program execution completed."
    #### "falls through" here
4390:newlineString:
    .asciiz "\n"
    
    .align 2
4392:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

4396:seg0_start:
    .space 0x100000
1052972:seg0_end:
1052972:seg1_start:
    .space 0x100000
2101548:seg1_end:
