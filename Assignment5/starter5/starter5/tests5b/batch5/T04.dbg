
5152#    addu $t2,$s3,$t2 # pointer to target object

    #########################################################
    # At this point:
    # - $t0 contains the address of the stack slot we'll
    #   process next
    # - $t1 contains the contents of the stack slot we're
    #   currently working on, which is a pointer to the source
    #   object (i.e., the address just beyond the object's header)
    # - $t2 contains the pointer to the target object
    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0-2
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger" in the target space
5156#    lw $s0,($t4)
5160#    lw $s1,-8($t1)
5164#    sw $s1,($t4)
5168#    sw $s0,-8($t1)
    
    # copy all source bytes to the target
5172:  gCinnerCopy1:
5172#    lw $s0,($t4)
5176#    sw $s0,($s3)
5180#    addu $t4,$t4,4
5184#    addu $s3,$s3,4
5188#    bltu $t4,$t3,gCinnerCopy1
5189##...sltu $at,$t4,$t3
5193##...bne $at,$zero,5172

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
5196#    sw $zero,-8($t1) # 0 in first header-slot
5200#    sw $t2,-4($t1) # forwarding pointer in second header-slot

    # update the stack slot with the address in the target space
5204#    sw $t2,4($t0)
5208#    lw $zero,-8($t2)
5212#    lw $zero,-4($t2)

    # go handle next stack slot (testing if done)
5216#    j gcTestIterDone1

5220:  gcBump:
    #### we have a GC tag.  Bytes to skip: tag value + 3.
5220#    subu $t0,$t0,$t1
5224#    subu $t0,$t0,3

5228:  gcTestIterDone1:
5228#    bgeu $t0,$sp,gcStackCopyLoop
5229##...sltu $at,$t0,$sp
5233##...beq $at,$zero,5044

    ###### end outer loop to copy all stack-direct objects ######

    #############################################################
    # We have finished processing the stack elements.  Now we need
    # to update elements in the heap itself. This may itself involve
    # moving additional objects
    #############################################################

    #########################################################
    # At this point:
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # We want to set things up so that in addition:
    # - $t0 is the "trailing finger", containing the address
    #   of the first slot in target space that we have yet
    #   to process.
    # Then during processing:
    # - $t1 will contain the contents of the heap slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # And when we're actually copying an object:
    # - $t2 will contain pointer to the target object
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - available for use: $s0
    ##########################################################

    # set $t0 to be at the beginning of target-space
5236#    lw $t1,cur_seg
5240#    la $t0,seg0_start
5244#    beq $t1,$zero,gcSkip4
5248#    la $t0,seg1_start
5249##...lui $t0,16
5253##...addiu $t0,$t0,6824


5256:  gcSkip4:

    # if there were no objects put into the heap during stack
    # processing, we're done, so go finish up
5256#    bgeu $t0,$s3,gcFinishUp
5257##...sltu $at,$t0,$s3
5261##...beq $at,$zero,5552

    ###### begin outer loop to copy all non-stack-direct objects ######

5264:  gcHeapCopyLoop:
    # get data count for object; swap header-word with first word
    # of object so that they're back in the right place
5264#    lw $t1,($t0) # (what will be) first header word for current object
5268#    move $t2,$t1 # number data bytes in object (poss. w/hash bits)
5272#    bge $t2,$zero,gcSkip4a # are there hash bits?
5273##...slt $at,$t2,$zero
5277##...beq $at,$zero,5292
5280#    and $t2,0xff # mask off hash bits
5281##...lui $at,0
5285##...ori $at,$at,0xff
5289##...and $t2,$t2,$at
5292:gcSkip4a:    
5292#    sll $t2,$t2,2 # # data bytes
5296#    addu $t2,$t2,8 # to skip header words
5300#    addu $t2,$t0,$t2 # pointer to new object
5304#    lw $t3,-8($t2) # word to swap
5308#    sw $t1,-8($t2) # store header word
5312#    sw $t3,($t0) # restore first word of object

    ################################################
    # at this point:
    # - $t2 contains the pointer to our new object
    ################################################

    # check if we have a data array
5316#    lw $t1,-12($t2) # vtable pointer
5320#    li $t0,dataArrayVTableStart # address of vtable for first data array
5324#    blt $t1,$t0,gcNotDataArray # if data array, no more xforming to do
5325##...slt $at,$t1,$t0
5329##...bne $at,$zero,5348

    # We have a vtable address that is a data array.
    # we need skip over it then loop back to do next object.
5332:  skipToNextObj:
5332#    lw $t1,-4($t2) # data words in (object position of) array
    #### note: we know that it's not a string, so the value will
    #### not be artificially negative
5336#    sll $t1,$t1,2 # convert to byte-count
5340#    addu $t0,$t2,$t1 # skip over object
5344#    j gcTestIterDone2 # go do next object, if any

    ###################################################
    # at this point:
    # - the object has been restored to normal status--that is, the
    #   word-swap has been done
    # - $t2 contains a pointer to the object
    ###################################################
    
5348:  gcNotDataArray:
5348#    lw $t3,-4($t2) # # object words (negative treated as zero)
5352#    bge $t3,$zero,gcH2Neg2
5353##...slt $at,$t3,$zero
5357##...beq $at,$zero,5364
5360#    move $t3,$zero
5364:  gcH2Neg2:
5364#    sll $t3,$t3,2 # # object bytes
5368#    move $t0,$t2 # address of first pointer in object
5372#    add $s1,$t2,$t3 # limit address for this object

    #####################################################
    # At this point, we have to "translate" all pointers,
    # starting at $t0 to (but not including) $s1
    #####################################################

    # if there are no pointer-slots (i.e., $t0=$s1), skip this
    # part
5376#    beq $t0,$s1,gcTestIterDone2
    
5380:  gcNextPointerInObject:
    # get pointer from object
5380#    lw $t1,($t0)

    # if value is out of range, and is therefore does not refer
    # to an object, just go loop back and do the next one
5384#    bleu $t1,$t6,gcGoNextPointerSlot
5385##...sltu $at,$t6,$t1
5389##...beq $at,$zero,5532
5392#    bgtu $t1,$t7,gcGoNextPointerSlot
5393##...sltu $at,$t7,$t1
5397##...bne $at,$zero,5532

    # if the object has already been moved, update the stack-value
    # via the forwarding pointer
5400#    lw $t8,-8($t1) # possible forwarding tag
5404#    bne $t8,$zero,gcNoForward2 # if not forwarding tag, go copy
5408#    lw $t8,-4($t1) # forwarding pointer: object's new address
5412#    sw $t8,($t0) # update pointer in object
5416#    j gcGoNextPointerSlot # do next iteration

5420:  gcNoForward2:
    #########################################################
    # we actually need to copy the object into the new space
    #########################################################

    #########################################################
    # At this point:
    # - $t0 contains the address of the heap-slot we're translating
    # - $t1 will contain the contents of the heap-slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space, which will also be the first address
    #   of the target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # Then during processing:
    # And when we're actually copying an object:
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $t8 will contain a pointer to the target object
    # - available for use: $s0, $t8, $t9
    ##########################################################

    # compute the amount of space that is needed
5420#    bge $t8,$zero,gcSkip5 # # words in negative-offset portion
5421##...slt $at,$t8,$zero
5425##...beq $at,$zero,5440
5428#    and $t8,0xff # mask off hash bits
5429##...lui $at,0
5433##...ori $at,$at,0xff
5437##...and $t8,$t8,$at

5440:  gcSkip5:
5440#    sll $t8,$t8,2 # bytes in negative-offset portion ...
5444#    addu $t8,$t8,8 # ... add in bytes for header-words
5448#    subu $t4,$t1,$t8 # address of first word of source object
5452#    lw $t3,-4($t1) # # words in positive-offset portion
5456#    bge $t3,$zero,gcNoNeg
5457##...slt $at,$t3,$zero
5461##...beq $at,$zero,5468
5464#    move $t3,$zero # negative treated as zero
5468:  gcNoNeg:
5468#    sll $t3,$t3,2 # bytes in negative-offset portion
5472#    addu $t3,$t3,$t1 # address one word past last word of source

5476#    addu $t8,$s3,$t8 # pointer to target object

    #########################################################
    # At this point:
    # - $t0 contains the address of the stack slot we'll
    #   process next
    # - $t1 contains the contents of the stack slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $t8 contains the pointer to the target object
    # - $s1 contains the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0, $t9
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger"
5480#    lw $s0,($t4)
5484#    lw $t9,-8($t1)
5488#    sw $t9,($t4)
5492#    sw $s0,-8($t1)

    # copy all source bytes to the target
5496:  gCinnerCopy2:
5496#    lw $s0,($t4)
5500#    sw $s0,($s3)
5504#    addu $t4,$t4,4
5508#    addu $s3,$s3,4
5512#    bltu $t4,$t3,gCinnerCopy2
5513##...sltu $at,$t4,$t3
5517##...bne $at,$zero,5496

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
5520#    sw $zero,-8($t1) # 0 in first header-slot
5524#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
5528#    sw $t8,($t0)

5532:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
5532#    addu $t0,$t0,4
5536#    bltu $t0,$s1,gcNextPointerInObject
5537##...sltu $at,$t0,$s1
5541##...bne $at,$zero,5380

5544:  gcTestIterDone2:
5544#    bltu $t0,$s3,gcHeapCopyLoop
5545##...sltu $at,$t0,$s3
5549##...bne $at,$zero,5264

    ###### end outer loop to copy all non-stack-direct objects ######

5552:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
5552#    lw $s2,($sp)
5556#    addu $sp,$sp,4

    # mark us as having already GC'd
5560#    move $t5,$s5

    # go try and allocate again
5564#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
5568:vm_init:

    # mark bottom of stack
5568#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
5572#    move $s2,$zero

    #set up the "five" register
5576#    li $s5,5

5580#    la $s3,seg0_start
5584#    la $s4,seg0_end
5585##...lui $s4,16
5589##...addiu $s4,$s4,6824
    
    # return
5592#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
5596:divide:
    # get parameters; abort if divisor zero
5596#    lw $t0,($sp)
5600#    lw $t1,8($sp)
5604#    beq $t0,$zero,divByZeroError
    
    # perform division
5608#    div $t1,$t0
5612#    mflo $t0

    # store result, adjust stack and return
5616#    addu $sp,$sp,8 # adjust stack
5620#    sw $t0,($sp) # store result
5624#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
5628:remainder:
    # get parameters; abort if divisor zero
5628#    lw $t0,($sp)
5632#    lw $t1,8($sp)
5636#    beq $t0,$zero,divByZeroError
    
    # perform division
5640#    div $t1,$t0
5644#    mfhi $t0

    # store result, adjust stack and return
5648#    addu $sp,$sp,8 # adjust stack
5652#    sw $t0,($sp) # store result
5656#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
5660:checkCast:
    # get object, allow immediately if null
5660#    lw $t2,($sp)
5664#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
5668#    lw $t2,-12($t2) # vtable address
5672#    bge $t2,$t1,castException
5673##...slt $at,$t2,$t1
5677##...beq $at,$zero,5848
5680#    blt $t2,$t0,castException
5681##...slt $at,$t2,$t0
5685##...bne $at,$zero,5848
    
    # return, leaving object unchanged on stack
5688:  checkCastReturn:    
5688#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
5692:instanceOf:
    # get object, go return false if null
5692#    lw $t2,($sp)
5696#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
5700#    lw $t2,-12($t2) # vtable address
5704#    sge $t0,$t2,$t0 # are we >= the lower limit?
5705##...slt $t0,$t2,$t0
5709##...xori $t0,$t0,0x1
5712#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
5716#    and $t2,$t0,$t1
5720#    sw $t2,($sp)
5724:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
5724#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

5728:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
5728#    li $v0,4 # syscall-code for print-string
5732#    syscall
5736:exit:
    # print termination message
5736#    li $v0,4 # syscall-code for print-string
5740#    la $a0,exitString
5744#    syscall

    # print number of garbage collections
5748#    li $v0,4 # syscall-code for print-string
5752#    la $a0,gcCountMsg
5756#    syscall # print "Number of ..."
5760#    lw $a0,gcCount # number of GC's
5764#    li $v0,1 # code for print-int
5768#    syscall
5772#    li $v0,4 # syscall-code for print-string
5776#    la $a0,newlineString
5780#    syscall # print newline

    # terminate execution
5784#    li $v0,10 #syscall-code for "exit"
5788#    syscall

5792:outOfHeapMemory:
5792#    la $a0,heapMemoryMsg
5796#    j exitError
5800:divByZeroError:
5800#    la $a0,divByZeroMsg
5804#    j exitError
5808:strIndexOutOfBounds:
5808#    la $a0,strIndexOutOfBoundsMsg
5812#    j exitError
5816:arrayIndexOutOfBounds:
5816#    la $a0,arrayIndexOutOfBoundsMsg
5820#    j exitError
5824:arraySizeOutOfBounds:
5824#    la $a0,arraySizeOutOfBoundsMsg
5828#    j exitError
5832:nullPtrException:
5832#    la $a0,nullPtrExceptionMsg
5836#    j exitError
5840:badIntegerFormat:
5840#    la $a0,badIntegerFormatMsg
5844#    j exitError
5848:castException:
5848#    la $a0,castExceptionMsg
5852#    j exitError
############## data section ################
    .data
6452:hexChars:
    .ascii "0123456789abcdef"
    .align 2
6468:cur_seg:
    .word 0

6472:lastCharRead:
    .word -2 # -2 => no buffered character
6476:prevHashConstant:
    .word 0x2785173c
6480:gcCount:
    .word 0

6484:heapMemoryMsg:
