########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
4644:instanceOf:
    # get object, go return false if null
4644#    lw $t2,($sp)
4648#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
4652#    lw $t2,-12($t2) # vtable address
4656#    sge $t0,$t2,$t0 # are we >= the lower limit?
4657##...slt $t0,$t2,$t0
4661##...xori $t0,$t0,0x1
4664#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
4668#    and $t2,$t0,$t1
4672#    sw $t2,($sp)
4676:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
4676#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

4680:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
4680#    li $v0,4 # syscall-code for print-string
4684#    syscall
4688:exit:
    # print termination message
4688#    li $v0,4 # syscall-code for print-string
4692#    la $a0,exitString
4696#    syscall

    # terminate execution
4700#    li $v0,10 #syscall-code for "exit"
4704#    syscall

4708:outOfHeapMemory:
4708#    la $a0,heapMemoryMsg
4712#    j exitError
4716:divByZeroError:
4716#    la $a0,divByZeroMsg
4720#    j exitError
4724:strIndexOutOfBounds:
4724#    la $a0,strIndexOutOfBoundsMsg
4728#    j exitError
4732:arrayIndexOutOfBounds:
4732#    la $a0,arrayIndexOutOfBoundsMsg
4736#    j exitError
4740:arraySizeOutOfBounds:
4740#    la $a0,arraySizeOutOfBoundsMsg
4744#    j exitError
4748:nullPtrException:
4748#    la $a0,nullPtrExceptionMsg
4752#    j exitError
4756:badIntegerFormat:
4756#    la $a0,badIntegerFormatMsg
4760#    j exitError
4764:castException:
4764#    la $a0,castExceptionMsg
4768#    j exitError
############## data section ################
    .data
5092:hexChars:
    .ascii "0123456789abcdef"
    .align 2
5108:cur_seg:
    .word 0

5112:lastCharRead:
    .word -2 # -2 => no buffered character
5116:prevHashConstant:
    .word 0x2785173c
5120:gcCount:
    .word 0

5124:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
5151:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
5174:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
5209:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
5243:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
5276:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
5307:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
5355:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
5376:gcMsg: 
