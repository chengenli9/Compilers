    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
976#    addu $t4,8
980#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
984#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

988#    li $t0,CLASS_String # store string vtable address into ...
992#    sw $t0,-12($s7) # ... -12 offset in object header
996#    lw $t2,-12($s2) # our object's vtable address
1000#    lw $t5,4($sp) # number characters in prefix
1004#    lw $t1,12($sp) # number of characters in hashcode
1008#    addu $t3,$t1,$t5 # number of characters in string ...
1012#    addu $t3,1 # ... including the '@' character
1016#    subu $t0,$zero,$t3 # store negated length into ...
1020#    sw $t0,-4($s7) # ... -4 offset header word
1024#    lw $t0,-8($s7) # get -8 offset header-word
