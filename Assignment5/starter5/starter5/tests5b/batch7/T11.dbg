1312#    beq $sp,$t1,rlReturn
1316:  charCopyLoop:
1316#    lw $t2,($sp)
1320#    sb $t2,-9($t0)
1324#    addu $sp,$sp,4
1328#    subu $t0,$t0,1
1332#    bne $sp,$t1,charCopyLoop
1336:  rlReturn:

1336#    lw $ra, 4($sp)
1340#    addu $sp, 8   # pop $ra and pointless word off stack
1344#    move $t0, $s7 # return string we allocated in $s7
1348#    jr $ra
