4053##...sltu $at,$t0,$sp
4057##...beq $at,$zero,3868

    ###### end outer loop to copy all stack-direct objects ######

    #############################################################
    # We have finished processing the stack elements.  Now we need
    # to update elements in the heap itself. This may itself involve
    # moving additional objects
    #############################################################

    #########################################################
    # At this point:
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # We want to set things up so that in addition:
    # - $t0 is the "trailing finger", containing the address
    #   of the first slot in target space that we have yet
    #   to process.
    # Then during processing:
    # - $t1 will contain the contents of the heap slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # And when we're actually copying an object:
    # - $t2 will contain pointer to the target object
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - available for use: $s0
    ##########################################################

    # set $t0 to be at the beginning of target-space
4060#    lw $t1,cur_seg
4064#    la $t0,seg0_start
4068#    beq $t1,$zero,gcSkip4
4072#    la $t0,seg1_start
4073##...lui $t0,16
4077##...addiu $t0,$t0,5320


4080:  gcSkip4:

    # if there were no objects put into the heap during stack
    # processing, we're done, so go finish up
4080#    bgeu $t0,$s3,gcFinishUp
4081##...sltu $at,$t0,$s3
4085##...beq $at,$zero,4376

    ###### begin outer loop to copy all non-stack-direct objects ######

4088:  gcHeapCopyLoop:
    # get data count for object; swap header-word with first word
    # of object so that they're back in the right place
4088#    lw $t1,($t0) # (what will be) first header word for current object
4092#    move $t2,$t1 # number data bytes in object (poss. w/hash bits)
4096#    bge $t2,$zero,gcSkip4a # are there hash bits?
4097##...slt $at,$t2,$zero
4101##...beq $at,$zero,4116
4104#    and $t2,0xff # mask off hash bits
4105##...lui $at,0
4109##...ori $at,$at,0xff
4113##...and $t2,$t2,$at
4116:gcSkip4a:    
4116#    sll $t2,$t2,2 # # data bytes
4120#    addu $t2,$t2,8 # to skip header words
4124#    addu $t2,$t0,$t2 # pointer to new object
4128#    lw $t3,-8($t2) # word to swap
4132#    sw $t1,-8($t2) # store header word
4136#    sw $t3,($t0) # restore first word of object

    ################################################
    # at this point:
    # - $t2 contains the pointer to our new object
    ################################################

    # check if we have a data array
4140#    lw $t1,-12($t2) # vtable pointer
4144#    li $t0,dataArrayVTableStart # address of vtable for first data array
4148#    blt $t1,$t0,gcNotDataArray # if data array, no more xforming to do
4149##...slt $at,$t1,$t0
4153##...bne $at,$zero,4172

    # We have a vtable address that is a data array.
    # we need skip over it then loop back to do next object.
4156:  skipToNextObj:
4156#    lw $t1,-4($t2) # data words in (object position of) array
    #### note: we know that it's not a string, so the value will
    #### not be artificially negative
4160#    sll $t1,$t1,2 # convert to byte-count
4164#    addu $t0,$t2,$t1 # skip over object
4168#    j gcTestIterDone2 # go do next object, if any

    ###################################################
    # at this point:
    # - the object has been restored to normal status--that is, the
    #   word-swap has been done
    # - $t2 contains a pointer to the object
    ###################################################
    
4172:  gcNotDataArray:
4172#    lw $t3,-4($t2) # # object words (negative treated as zero)
4176#    bge $t3,$zero,gcH2Neg2
4177##...slt $at,$t3,$zero
4181##...beq $at,$zero,4188
4184#    move $t3,$zero
4188:  gcH2Neg2:
4188#    sll $t3,$t3,2 # # object bytes
4192#    move $t0,$t2 # address of first pointer in object
4196#    add $s1,$t2,$t3 # limit address for this object

    #####################################################
    # At this point, we have to "translate" all pointers,
    # starting at $t0 to (but not including) $s1
    #####################################################

    # if there are no pointer-slots (i.e., $t0=$s1), skip this
    # part
4200#    beq $t0,$s1,gcTestIterDone2
    
4204:  gcNextPointerInObject:
    # get pointer from object
4204#    lw $t1,($t0)

    # if value is out of range, and is therefore does not refer
    # to an object, just go loop back and do the next one
4208#    bleu $t1,$t6,gcGoNextPointerSlot
4209##...sltu $at,$t6,$t1
4213##...beq $at,$zero,4356
4216#    bgtu $t1,$t7,gcGoNextPointerSlot
4217##...sltu $at,$t7,$t1
4221##...bne $at,$zero,4356

    # if the object has already been moved, update the stack-value
    # via the forwarding pointer
4224#    lw $t8,-8($t1) # possible forwarding tag
4228#    bne $t8,$zero,gcNoForward2 # if not forwarding tag, go copy
4232#    lw $t8,-4($t1) # forwarding pointer: object's new address
4236#    sw $t8,($t0) # update pointer in object
4240#    j gcGoNextPointerSlot # do next iteration

4244:  gcNoForward2:
    #########################################################
    # we actually need to copy the object into the new space
    #########################################################

    #########################################################
    # At this point:
    # - $t0 contains the address of the heap-slot we're translating
    # - $t1 will contain the contents of the heap-slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space, which will also be the first address
    #   of the target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # Then during processing:
    # And when we're actually copying an object:
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $t8 will contain a pointer to the target object
    # - available for use: $s0, $t8, $t9
    ##########################################################

    # compute the amount of space that is needed
4244#    bge $t8,$zero,gcSkip5 # # words in negative-offset portion
4245##...slt $at,$t8,$zero
4249##...beq $at,$zero,4264
4252#    and $t8,0xff # mask off hash bits
4253##...lui $at,0
4257##...ori $at,$at,0xff
4261##...and $t8,$t8,$at

4264:  gcSkip5:
4264#    sll $t8,$t8,2 # bytes in negative-offset portion ...
4268#    addu $t8,$t8,8 # ... add in bytes for header-words
4272#    subu $t4,$t1,$t8 # address of first word of source object
4276#    lw $t3,-4($t1) # # words in positive-offset portion
4280#    bge $t3,$zero,gcNoNeg
4281##...slt $at,$t3,$zero
4285##...beq $at,$zero,4292
4288#    move $t3,$zero # negative treated as zero
4292:  gcNoNeg:
4292#    sll $t3,$t3,2 # bytes in negative-offset portion
4296#    addu $t3,$t3,$t1 # address one word past last word of source

4300#    addu $t8,$s3,$t8 # pointer to target object

    #########################################################
    # At this point:
    # - $t0 contains the address of the stack slot we'll
    #   process next
    # - $t1 contains the contents of the stack slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $t8 contains the pointer to the target object
    # - $s1 contains the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0, $t9
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger"
4304#    lw $s0,($t4)
4308#    lw $t9,-8($t1)
4312#    sw $t9,($t4)
4316#    sw $s0,-8($t1)

    # copy all source bytes to the target
4320:  gCinnerCopy2:
4320#    lw $s0,($t4)
4324#    sw $s0,($s3)
4328#    addu $t4,$t4,4
4332#    addu $s3,$s3,4
4336#    bltu $t4,$t3,gCinnerCopy2
4337##...sltu $at,$t4,$t3
4341##...bne $at,$zero,4320

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
4344#    sw $zero,-8($t1) # 0 in first header-slot
4348#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
4352#    sw $t8,($t0)

4356:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
4356#    addu $t0,$t0,4
4360#    bltu $t0,$s1,gcNextPointerInObject
4361##...sltu $at,$t0,$s1
4365##...bne $at,$zero,4204

4368:  gcTestIterDone2:
4368#    bltu $t0,$s3,gcHeapCopyLoop
4369##...sltu $at,$t0,$s3
4373##...bne $at,$zero,4088

    ###### end outer loop to copy all non-stack-direct objects ######

4376:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
4376#    lw $s2,($sp)
4380#    addu $sp,$sp,4

    # mark us as having already GC'd
4384#    move $t5,$s5

    # go try and allocate again
4388#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
4392:vm_init:

    # mark bottom of stack
4392#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
4396#    move $s2,$zero

    #set up the "five" register
4400#    li $s5,5

4404#    la $s3,seg0_start
4408#    la $s4,seg0_end
4409##...lui $s4,16
4413##...addiu $s4,$s4,5320
    
    # return
4416#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4420:divide:
    # get parameters; abort if divisor zero
4420#    lw $t0,($sp)
4424#    lw $t1,8($sp)
4428#    beq $t0,$zero,divByZeroError
    
    # perform division
4432#    div $t1,$t0
4436#    mflo $t0

    # store result, adjust stack and return
4440#    addu $sp,$sp,8 # adjust stack
4444#    sw $t0,($sp) # store result
4448#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4452:remainder:
    # get parameters; abort if divisor zero
4452#    lw $t0,($sp)
4456#    lw $t1,8($sp)
4460#    beq $t0,$zero,divByZeroError
    
    # perform division
4464#    div $t1,$t0
4468#    mfhi $t0

    # store result, adjust stack and return
4472#    addu $sp,$sp,8 # adjust stack
4476#    sw $t0,($sp) # store result
4480#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
4484:checkCast:
    # get object, allow immediately if null
4484#    lw $t2,($sp)
4488#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
4492#    lw $t2,-12($t2) # vtable address
4496#    bge $t2,$t1,castException
4497##...slt $at,$t2,$t1
4501##...beq $at,$zero,4672
4504#    blt $t2,$t0,castException
4505##...slt $at,$t2,$t0
4509##...bne $at,$zero,4672
    
    # return, leaving object unchanged on stack
4512:  checkCastReturn:    
4512#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
4516:instanceOf:
    # get object, go return false if null
4516#    lw $t2,($sp)
4520#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
4524#    lw $t2,-12($t2) # vtable address
4528#    sge $t0,$t2,$t0 # are we >= the lower limit?
4529##...slt $t0,$t2,$t0
4533##...xori $t0,$t0,0x1
4536#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
4540#    and $t2,$t0,$t1
4544#    sw $t2,($sp)
4548:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
4548#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

4552:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
4552#    li $v0,4 # syscall-code for print-string
4556#    syscall
4560:exit:
    # print termination message
4560#    li $v0,4 # syscall-code for print-string
4564#    la $a0,exitString
4568#    syscall

    # print number of garbage collections
4572#    li $v0,4 # syscall-code for print-string
4576#    la $a0,gcCountMsg
4580#    syscall # print "Number of ..."
4584#    lw $a0,gcCount # number of GC's
4588#    li $v0,1 # code for print-int
4592#    syscall
4596#    li $v0,4 # syscall-code for print-string
4600#    la $a0,newlineString
4604#    syscall # print newline

    # terminate execution
4608#    li $v0,10 #syscall-code for "exit"
4612#    syscall

4616:outOfHeapMemory:
4616#    la $a0,heapMemoryMsg
4620#    j exitError
4624:divByZeroError:
4624#    la $a0,divByZeroMsg
4628#    j exitError
4632:strIndexOutOfBounds:
4632#    la $a0,strIndexOutOfBoundsMsg
4636#    j exitError
4640:arrayIndexOutOfBounds:
4640#    la $a0,arrayIndexOutOfBoundsMsg
4644#    j exitError
4648:arraySizeOutOfBounds:
4648#    la $a0,arraySizeOutOfBoundsMsg
4652#    j exitError
4656:nullPtrException:
4656#    la $a0,nullPtrExceptionMsg
4660#    j exitError
4664:badIntegerFormat:
4664#    la $a0,badIntegerFormatMsg
4668#    j exitError
4672:castException:
