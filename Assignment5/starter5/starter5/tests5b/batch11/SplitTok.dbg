6300#    subu $t0,$v0,9
6304#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
6308#    subu $t0,$v0,13
6312#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
6316#    subu $t0,$v0,12
