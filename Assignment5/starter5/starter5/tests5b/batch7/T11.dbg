###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
1032:mth_equals_String:
    
    # quick test for obvious false
1032#    lw $t0,($sp) # second parameter
1036#    beq $t0,$zero,goEsFalse # go return false if null
1040#    lw $t1,-12($t0) # vtable pointer
1044#    la $t2,CLASS_String # string vtable pointer
1048#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
1052#    subu $sp,12
1056#    sw $ra,8($sp)
1060#    sw $s2,4($sp)
1064#    sw $t0,($sp)
1068#    jal mth_compareTo_String
1072#    lw $s2, 4($sp) #restore this pointer and pop parameters
1076#    addu $sp, 8 # pop parameters
