
1672#    lw $ra, 4($sp)
1676#    addu $sp, 8   # pop $ra and pointless word off stack
1680#    move $t0, $s7 # return string we allocated in $s7
1684#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
1688:mth_readInt_Lib:

    # save $ra by pushing onto stack
1688#    subu $sp,$sp,4
1692#    sw $ra,($sp)

1696:  riSkipWhiteLoop:
    # read a character
1696#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
1700#    subu $t0,$v0,32
1704#    bgt $t0,$zero,nonWhite
1705##...slt $at,$zero,$t0
1709##...bne $at,$zero,1752
1712#    beq $t0,$zero,riSkipWhiteLoop # start over if space
1716#    subu $t0,$v0,10
1720#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
1724#    subu $t0,$v0,9
1728#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
1732#    subu $t0,$v0,13
1736#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
1740#    subu $t0,$v0,12
1744#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
1748#    j badIntegerFormat # illegal integer char: abort program

1752:  nonWhite:
1752#    subu $t0,$v0,'-'
1756#    li $t4,1 # final multiplier
1760#    bne $t0,$zero,helpReadInt # go read
1764#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
1768#    jal readLogicalChar

1772:  helpReadInt:
1772#    li $t2,10
1776#    subu $t1,$v0,'0' # convert digit to 0-9 value
1780#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
1781##...sltu $at,$t1,$t2
1785##...beq $at,$zero,4068
1788#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

1792:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

1792#    jal readLogicalChar # read next character
1796#    subu $t1,$v0,'0' # convert digit to 0-9 value
1800#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
1801##...sltu $at,$t1,$t2
1805##...beq $at,$zero,1824

1808#    mul $t3,$t3,$t2 # multiply old value by 10
1809##...mult $t3,$t2
1813##...mflo $t3
1816#    addu $t3,$t3,$t1 # add in value of new digit
1820#    j digitLoop

1824:  doneDigitLoop:

    # "push back" unused character into queue
1824#    sw $v0,lastCharRead
