1600#    lw $t1,-4($t1) # negative size of first object
1604#    addu $s6,$t0,$t1 # sum of negative sizes
1608#    sra $s6,$s6,2 # negative word-size of char part
1612#    subu $s6,$zero,$s6 # word size of char part
