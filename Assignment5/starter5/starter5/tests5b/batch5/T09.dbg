##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
652:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
652#    lw $t0,-8($s2) # get word with hash bits from this
656#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
660#    addu $t0,$t1

664#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
668:mth_equals_Object:
668#    move $t0,$s2 # first pointer (this)
672#    lw $t1,($sp) # second pointer
676#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
677##...subu $at,$t0,$t1
681##...sltiu $t0,$at,1

684#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
688:mth_hashCode_String:
688#    move $t0,$s2 # put this pointer in t0

692#    li $t2,0 # current hash value
696#    lw $t1,-4($t0) # negative of number of characters in string
700#    beq $t1,$zero,done_hashCode_String # if zero length => done
704#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
708#    and $t0,0xfffffffc # adjust for padding
709##...lui $at,65535
713##...ori $at,$at,0xfffc
717##...and $t0,$t0,$at
720#    subu $t1,$t0,$t1 # address at end of string +12
724:loop_hashCode_String:    
724#    sll $t4,$t2,5 # multiply by 32
728#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
732#    lbu $t3,-12($t0) # current character
736#    addu $t2,$t3 # add in current character
740#    addu $t0,1 # go to next character's address
744#    bne $t0,$t1,loop_hashCode_String # loop back if more
748:done_hashCode_String:    

    # push int on stack
748#    move $t0, $t2 # put $t2 in return slot
752#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
756:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
756#    subu $sp,4
760#    sw $ra,($sp)
    
    # get hash value
764#    lw $t2,-12($s2) # vtable address
768#    lw $t0,($t2) # method address
772#    jalr $t0
776#    subu $sp,8 # push result (int in $t0) on stack
780#    sw $s5,4($sp)
784#    sw $t0,($sp)

    # compute print-size of hash value
788#    li $t0, 1
792#    lw $t1, ($sp)
796#    srl $t1,$t1,4
800#    beq $t1,$zero,toString_skip_loop
804:toString_loop_top:
804#    addu $t0,1
808#    srl $t1,$t1,4
812#    bne $t1,$zero,toString_loop_top
816:toString_skip_loop:
816#    subu $sp,8
820#    sw $s5,4($sp)
824#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
828#    lw $t2,-12($s2) # vtable address
832#    move $t0,$t2
836:toString_checkTagBit:
836#    subu $t0,1
840#    lb $t1,($t0)
844#    and $t1,0x80
845##...lui $at,0
849##...ori $at,$at,0x80
853##...and $t1,$t1,$at
856#    beq $t1,$zero,toString_checkTagBit
860#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
864#    subu $sp,8
868#    sw $t1,($sp)
872#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
876#    move $s7,$zero # -4 offset header word
880#    lw $t4,8($sp) # bytes for hash value
884#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
888#    addu $t4,8
892#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
896#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

900#    li $t0,CLASS_String # store string vtable address into ...
904#    sw $t0,-12($s7) # ... -12 offset in object header
908#    lw $t2,-12($s2) # our object's vtable address
912#    lw $t5,4($sp) # number characters in prefix
916#    lw $t1,12($sp) # number of characters in hashcode
920#    addu $t3,$t1,$t5 # number of characters in string ...
924#    addu $t3,1 # ... including the '@' character
