    # to the end of the shorter string during our comparison-loop.
5684#    slt $t4,$t3,$t2
5688#    slt $t5,$t2,$t3
5692#    subu $t5,$t5,$t4
    
    # at this point:
    # - $t0 contains the pointer to the second string object
    # - $t1 contains the pointer to the first string object
    # - $t5 contains the value to return if the strings compare equal up
    #   to the length of the shortest word

    # get begin-of-string addresses
5696#    lw $t2,-8($t0) # # data words in second string
5700#    lw $t3,-8($t1) # # data words in first string
5704#    sll $t2,$t2,2 # byte-offset to beginning of str2 (+8)
5708#    sll $t3,$t3,2 # byte-offset to beginning of str1 (+8)
5712#    subu $t0,$t0,$t2 # beginning of str1 address (+8)
5716#    subu $t1,$t1,$t3 # beginning of str2 address (+8)
