6009##...sltu $at,$t6,$t1
6013##...beq $at,$zero,6176
6016#    bgtu $t1,$t7,gcTestIterDone1
6017##...sltu $at,$t7,$t1
6021##...bne $at,$zero,6176

    # if the object has already been moved, update the stack-value
    # via the forwarding pointer
6024#    lw $t2,-8($t1) # possible forwarding tag
6028#    bne $t2,$zero,gcNoForward1 # if not forwarding tag, go copy
6032#    lw $t2,-4($t1) # forwarding pointer: object's new address
6036#    sw $t2,4($t0) # update stack value
6040#    j gcTestIterDone1 # do next iteration

6044:  gcNoForward1:
    #########################################################
    # we actually need to copy the object into the new space
    #########################################################
