
    # mark us as having already GC'd
10180#    move $t5,$s5

    # go try and allocate again
10184#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
10188:vm_init:

    # mark bottom of stack
10188#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
10192#    move $s2,$zero

    #set up the "five" register
10196#    li $s5,5

10200#    la $s3,seg0_start
10204#    la $s4,seg0_end
10205##...lui $s4,16
10209##...addiu $s4,$s4,11368
    
    # return
10212#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
10216:divide:
    # get parameters; abort if divisor zero
10216#    lw $t0,($sp)
10220#    lw $t1,8($sp)
10224#    beq $t0,$zero,divByZeroError
    
    # perform division
10228#    div $t1,$t0
10232#    mflo $t0

    # store result, adjust stack and return
10236#    addu $sp,$sp,8 # adjust stack
10240#    sw $t0,($sp) # store result
10244#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
10248:remainder:
    # get parameters; abort if divisor zero
10248#    lw $t0,($sp)
10252#    lw $t1,8($sp)
10256#    beq $t0,$zero,divByZeroError
    
    # perform division
10260#    div $t1,$t0
10264#    mfhi $t0

    # store result, adjust stack and return
10268#    addu $sp,$sp,8 # adjust stack
10272#    sw $t0,($sp) # store result
10276#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
10280:checkCast:
    # get object, allow immediately if null
10280#    lw $t2,($sp)
10284#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
10288#    lw $t2,-12($t2) # vtable address
10292#    bge $t2,$t1,castException
10293##...slt $at,$t2,$t1
10297##...beq $at,$zero,10432
10300#    blt $t2,$t0,castException
10301##...slt $at,$t2,$t0
10305##...bne $at,$zero,10432
    
    # return, leaving object unchanged on stack
10308:  checkCastReturn:    
10308#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
10312:instanceOf:
    # get object, go return false if null
10312#    lw $t2,($sp)
10316#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
10320#    lw $t2,-12($t2) # vtable address
10324#    sge $t0,$t2,$t0 # are we >= the lower limit?
10325##...slt $t0,$t2,$t0
10329##...xori $t0,$t0,0x1
10332#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
10336#    and $t2,$t0,$t1
10340#    sw $t2,($sp)
10344:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
10344#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

10348:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
10348#    li $v0,4 # syscall-code for print-string
10352#    syscall
10356:exit:
    # print termination message
10356#    li $v0,4 # syscall-code for print-string
10360#    la $a0,exitString
10364#    syscall

    # terminate execution
10368#    li $v0,10 #syscall-code for "exit"
10372#    syscall

10376:outOfHeapMemory:
10376#    la $a0,heapMemoryMsg
10380#    j exitError
10384:divByZeroError:
10384#    la $a0,divByZeroMsg
10388#    j exitError
10392:strIndexOutOfBounds:
10392#    la $a0,strIndexOutOfBoundsMsg
10396#    j exitError
10400:arrayIndexOutOfBounds:
10400#    la $a0,arrayIndexOutOfBoundsMsg
10404#    j exitError
10408:arraySizeOutOfBounds:
10408#    la $a0,arraySizeOutOfBoundsMsg
10412#    j exitError
10416:nullPtrException:
10416#    la $a0,nullPtrExceptionMsg
10420#    j exitError
10424:badIntegerFormat:
10424#    la $a0,badIntegerFormatMsg
10428#    j exitError
10432:castException:
10432#    la $a0,castExceptionMsg
10436#    j exitError
############## data section ################
    .data
11004:hexChars:
    .ascii "0123456789abcdef"
    .align 2
11020:cur_seg:
    .word 0

11024:lastCharRead:
    .word -2 # -2 => no buffered character
11028:prevHashConstant:
    .word 0x2785173c
11032:gcCount:
    .word 0

11036:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
11063:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
11086:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
11121:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
11155:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
11188:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
11219:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
11267:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
11288:gcMsg: 
      .asciiz "\nGC!\n"
11294:gcCountMsg: 
      .asciiz "Number of garbage collections: "

11326:nullStr:
    .asciiz "null"
11331:trueString:
    .asciiz "true"
11336:falseString:
    .asciiz "false"
11342:exitString:
    .ascii "Program terminated."
    #### "falls through" here
11361:newlineString:
    .asciiz "\n"
    
    .align 2
11364:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

11368:seg0_start:
    .space 0x100000
1059944:seg0_end:
1059944:seg1_start:
    .space 0x100000
2108520:seg1_end:
