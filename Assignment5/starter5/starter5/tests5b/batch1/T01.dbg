    # allocate the appropriate Object
784#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
788#    srl $s6,$s6,2  # data words in object
792#    move $s7,$zero # object words in object
796#    jal newObject  # allocate space
    
    # store header words
800#    la $t0,CLASS_String
804#    sw $t0,-12($s7)# store class tag (String) into object
808#    lw $t2,4($sp) # char-count
812#    sll $t1,$t2,2 # 4 times number of chars
816#    subu $t2,$zero,$t2 # negative of char-count
820#    sw $t2,-4($s7) # store negative char-count as header-word 2
