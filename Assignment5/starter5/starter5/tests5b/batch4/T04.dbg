2396#    beq $t0,$zero,riSkipWhiteLoop # start over if space
2400#    subu $t0,$v0,10
2404#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
2408#    subu $t0,$v0,9
2412#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
2416#    subu $t0,$v0,13
2420#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
2424#    subu $t0,$v0,12
