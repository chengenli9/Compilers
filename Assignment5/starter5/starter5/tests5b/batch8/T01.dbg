3217##...sltu $at,$t1,$t2
3221##...beq $at,$zero,5504
3224#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

3228:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

3228#    jal readLogicalChar # read next character
3232#    subu $t1,$v0,'0' # convert digit to 0-9 value
3236#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
3237##...sltu $at,$t1,$t2
3241##...beq $at,$zero,3260

3244#    mul $t3,$t3,$t2 # multiply old value by 10
3245##...mult $t3,$t2
3249##...mflo $t3
3252#    addu $t3,$t3,$t1 # add in value of new digit
3256#    j digitLoop
