1109##...slt $at,$t0,$zero
1113##...beq $at,$zero,1132
1116#    and $t0,0xff # mask off object's hash value ...
1117##...lui $at,0
1121##...ori $at,$at,0xff
1125##...and $t0,$t0,$at
1128#    sw $t0,-8($s7) # ... and store back into -8 header-word
1132:skipMask_toString:
1132#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
1136#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
1140#    subu $t4,$t2,$t5
1144:toString_copyLoop:    
1144#    lb $t3,($t4)
1148#    and $t3,0x7f # mask off sign bit (in case first word)
1149##...lui $at,0
1153##...ori $at,$at,0x7f
1157##...and $t3,$t3,$at
1160#    sb $t3,-8($t0)
