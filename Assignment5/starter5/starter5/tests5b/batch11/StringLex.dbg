10301##...slt $at,$v0,$zero
10305##...bne $at,$zero,10320

    # we have a character, so push it onto stack
10308#    subu $sp,$sp,4
10312#    sw $v0,($sp)

    # loop back up to get next character
10316#    j doRead

10320:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
10320#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
10324#    li $s7, 0 # return-value: null
10328#    j rlReturn # return

10332:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
10332#    subu $t0,$t1,$sp # number of chars we read (times 4)
10336#    srl $s6,$t0,2 # number of words on stack with chars
10340#    subu $sp,$sp,4 # push char-count ...
10344#    sw $s6,($sp) # ... onto stack
10348#    addu $t2,$t0,5 # GC tag, incl. for count-word
10352#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
10356#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
10360#    srl $s6,$s6,2  # data words in object
10364#    move $s7,$zero # object words in object
10368#    jal newObject  # allocate space
    
    # store header words
10372#    la $t0,CLASS_String
10376#    sw $t0,-12($s7)# store class tag (String) into object
10380#    lw $t2,4($sp) # char-count
10384#    sll $t1,$t2,2 # 4 times number of chars
10388#    subu $t2,$zero,$t2 # negative of char-count
10392#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
10396#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
10400#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
10401##...slt $at,$t0,$zero
10405##...beq $at,$zero,10424
10408#    and $t0,0xff # mask off object's hash value ...
10409##...lui $at,0
10413##...ori $at,$at,0xff
10417##...and $t0,$t0,$at
10420#    sw $t0,-8($s7) # ... and store back into -8 header-word
10424:  skipMask_readLine:

10424#    sll $t0,$t0,2 # data bytes in object
10428#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
10432#    subu $t0,$t0,$t2 # place to store last character (plus 9)
