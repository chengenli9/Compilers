###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
1068:mth_readLine_Lib:
    
1068#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
1072#    sw $ra, 4($sp) # save $ra
1076#    move $t1,$sp # save "original" sp

1080:  doRead:

    # read the character
1080#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
1084#    subu $t2,$v0,13
1088#    bne $t2,$zero,notReturnRL
1092#    jal readLogicalChar
1096#    subu $t2,$v0,10 # check for newline
1100#    beq $t2,$zero,foundNewLine
1104#    sw $v0,lastCharRead # push back character into queue
1108#    j foundNewLine # go process the line

1112:  notReturnRL:

    # at this point, $v0 has our character

1112#    subu $t0,$v0,10
1116#    beq $t0,$zero,foundNewLine
1120#    blt $v0,$zero,foundEof
1121##...slt $at,$v0,$zero
1125##...bne $at,$zero,1140

    # we have a character, so push it onto stack
1128#    subu $sp,$sp,4
1132#    sw $v0,($sp)

    # loop back up to get next character
1136#    j doRead

1140:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
1140#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
1144#    li $s7, 0 # return-value: null
1148#    j rlReturn # return

1152:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
1152#    subu $t0,$t1,$sp # number of chars we read (times 4)
1156#    srl $s6,$t0,2 # number of words on stack with chars
1160#    subu $sp,$sp,4 # push char-count ...
1164#    sw $s6,($sp) # ... onto stack
1168#    addu $t2,$t0,5 # GC tag, incl. for count-word
1172#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
1176#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
1180#    srl $s6,$s6,2  # data words in object
1184#    move $s7,$zero # object words in object
1188#    jal newObject  # allocate space
    
    # store header words
1192#    la $t0,CLASS_String
1196#    sw $t0,-12($s7)# store class tag (String) into object
1200#    lw $t2,4($sp) # char-count
1204#    sll $t1,$t2,2 # 4 times number of chars
1208#    subu $t2,$zero,$t2 # negative of char-count
1212#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
1216#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
1220#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
1221##...slt $at,$t0,$zero
1225##...beq $at,$zero,1244
1228#    and $t0,0xff # mask off object's hash value ...
1229##...lui $at,0
1233##...ori $at,$at,0xff
1237##...and $t0,$t0,$at
1240#    sw $t0,-8($s7) # ... and store back into -8 header-word
1244:  skipMask_readLine:

1244#    sll $t0,$t0,2 # data bytes in object
1248#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
1252#    subu $t0,$t0,$t2 # place to store last character (plus 9)
1256#    addu $sp,$sp,8 # pop redundant object-pointer and count
1260#    addu $t1,$t1,$sp # first non-char spot on stack
