6049##...beq $at,$zero,6064
6052#    and $t2,0xff #### mask off hash value
6053##...lui $at,0
6057##...ori $at,$at,0xff
6061##...and $t2,$t2,$at
    #### OLD
    #### subu $t2,$zero,$t2 # set to 1 if -1 (number of data words)

