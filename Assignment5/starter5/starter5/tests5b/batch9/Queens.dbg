4993##...sltu $at,$t2,$t3
4997##...beq $at,$zero,6520

    # access element
5000#    lw $t1,-8($t0) # # data words in object
5004#    sll $t1,$t1,2 # - byte-offset from end of chars
5008#    subu $t1,$t2,$t1 # - address of first char in string, offset by 8
5012#    addu $t0,$t0,$t1 # - address of our char, offset by 8
5016#    lb $t0,-8($t0) # our char

    # return
5020#    jr $ra
