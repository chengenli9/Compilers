
    # We have a vtable address that is a data array.
    # we need skip over it then loop back to do next object.
3744:  skipToNextObj:
3744#    lw $t1,-4($t2) # data words in (object position of) array
    #### note: we know that it's not a string, so the value will
    #### not be artificially negative
3748#    sll $t1,$t1,2 # convert to byte-count
3752#    addu $t0,$t2,$t1 # skip over object
3756#    j gcTestIterDone2 # go do next object, if any

    ###################################################
    # at this point:
    # - the object has been restored to normal status--that is, the
    #   word-swap has been done
    # - $t2 contains a pointer to the object
    ###################################################
    
3760:  gcNotDataArray:
3760#    lw $t3,-4($t2) # # object words (negative treated as zero)
3764#    bge $t3,$zero,gcH2Neg2
3765##...slt $at,$t3,$zero
3769##...beq $at,$zero,3776
3772#    move $t3,$zero
3776:  gcH2Neg2:
3776#    sll $t3,$t3,2 # # object bytes
3780#    move $t0,$t2 # address of first pointer in object
3784#    add $s1,$t2,$t3 # limit address for this object

    #####################################################
    # At this point, we have to "translate" all pointers,
    # starting at $t0 to (but not including) $s1
    #####################################################

    # if there are no pointer-slots (i.e., $t0=$s1), skip this
    # part
3788#    beq $t0,$s1,gcTestIterDone2
    
3792:  gcNextPointerInObject:
    # get pointer from object
3792#    lw $t1,($t0)

    # if value is out of range, and is therefore does not refer
    # to an object, just go loop back and do the next one
3796#    bleu $t1,$t6,gcGoNextPointerSlot
3797##...sltu $at,$t6,$t1
3801##...beq $at,$zero,3944
3804#    bgtu $t1,$t7,gcGoNextPointerSlot
3805##...sltu $at,$t7,$t1
3809##...bne $at,$zero,3944

    # if the object has already been moved, update the stack-value
    # via the forwarding pointer
3812#    lw $t8,-8($t1) # possible forwarding tag
3816#    bne $t8,$zero,gcNoForward2 # if not forwarding tag, go copy
3820#    lw $t8,-4($t1) # forwarding pointer: object's new address
3824#    sw $t8,($t0) # update pointer in object
3828#    j gcGoNextPointerSlot # do next iteration

3832:  gcNoForward2:
    #########################################################
    # we actually need to copy the object into the new space
    #########################################################

    #########################################################
    # At this point:
    # - $t0 contains the address of the heap-slot we're translating
    # - $t1 will contain the contents of the heap-slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space, which will also be the first address
    #   of the target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # Then during processing:
    # And when we're actually copying an object:
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $t8 will contain a pointer to the target object
    # - available for use: $s0, $t8, $t9
    ##########################################################

    # compute the amount of space that is needed
3832#    bge $t8,$zero,gcSkip5 # # words in negative-offset portion
3833##...slt $at,$t8,$zero
3837##...beq $at,$zero,3852
3840#    and $t8,0xff # mask off hash bits
3841##...lui $at,0
3845##...ori $at,$at,0xff
3849##...and $t8,$t8,$at

3852:  gcSkip5:
3852#    sll $t8,$t8,2 # bytes in negative-offset portion ...
3856#    addu $t8,$t8,8 # ... add in bytes for header-words
3860#    subu $t4,$t1,$t8 # address of first word of source object
3864#    lw $t3,-4($t1) # # words in positive-offset portion
3868#    bge $t3,$zero,gcNoNeg
3869##...slt $at,$t3,$zero
3873##...beq $at,$zero,3880
3876#    move $t3,$zero # negative treated as zero
3880:  gcNoNeg:
3880#    sll $t3,$t3,2 # bytes in negative-offset portion
3884#    addu $t3,$t3,$t1 # address one word past last word of source

3888#    addu $t8,$s3,$t8 # pointer to target object

    #########################################################
    # At this point:
    # - $t0 contains the address of the stack slot we'll
    #   process next
    # - $t1 contains the contents of the stack slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $t8 contains the pointer to the target object
    # - $s1 contains the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0, $t9
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger"
3892#    lw $s0,($t4)
3896#    lw $t9,-8($t1)
3900#    sw $t9,($t4)
3904#    sw $s0,-8($t1)

    # copy all source bytes to the target
3908:  gCinnerCopy2:
3908#    lw $s0,($t4)
3912#    sw $s0,($s3)
3916#    addu $t4,$t4,4
3920#    addu $s3,$s3,4
3924#    bltu $t4,$t3,gCinnerCopy2
3925##...sltu $at,$t4,$t3
3929##...bne $at,$zero,3908

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
3932#    sw $zero,-8($t1) # 0 in first header-slot
3936#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
3940#    sw $t8,($t0)

3944:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
3944#    addu $t0,$t0,4
3948#    bltu $t0,$s1,gcNextPointerInObject
3949##...sltu $at,$t0,$s1
3953##...bne $at,$zero,3792

3956:  gcTestIterDone2:
3956#    bltu $t0,$s3,gcHeapCopyLoop
3957##...sltu $at,$t0,$s3
3961##...bne $at,$zero,3676

    ###### end outer loop to copy all non-stack-direct objects ######

3964:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
3964#    lw $s2,($sp)
3968#    addu $sp,$sp,4

    # mark us as having already GC'd
3972#    move $t5,$s5

    # go try and allocate again
3976#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
3980:vm_init:

    # mark bottom of stack
3980#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
3984#    move $s2,$zero

    #set up the "five" register
3988#    li $s5,5

3992#    la $s3,seg0_start
3996#    la $s4,seg0_end
3997##...lui $s4,16
4001##...addiu $s4,$s4,4896
    
    # return
4004#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4008:divide:
    # get parameters; abort if divisor zero
4008#    lw $t0,($sp)
4012#    lw $t1,8($sp)
4016#    beq $t0,$zero,divByZeroError
    
    # perform division
4020#    div $t1,$t0
4024#    mflo $t0

    # store result, adjust stack and return
4028#    addu $sp,$sp,8 # adjust stack
4032#    sw $t0,($sp) # store result
4036#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4040:remainder:
    # get parameters; abort if divisor zero
4040#    lw $t0,($sp)
4044#    lw $t1,8($sp)
4048#    beq $t0,$zero,divByZeroError
    
    # perform division
4052#    div $t1,$t0
4056#    mfhi $t0

    # store result, adjust stack and return
4060#    addu $sp,$sp,8 # adjust stack
4064#    sw $t0,($sp) # store result
4068#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
4072:checkCast:
    # get object, allow immediately if null
4072#    lw $t2,($sp)
4076#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
4080#    lw $t2,-12($t2) # vtable address
4084#    bge $t2,$t1,castException
4085##...slt $at,$t2,$t1
4089##...beq $at,$zero,4260
4092#    blt $t2,$t0,castException
4093##...slt $at,$t2,$t0
4097##...bne $at,$zero,4260
    
    # return, leaving object unchanged on stack
4100:  checkCastReturn:    
4100#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
4104:instanceOf:
    # get object, go return false if null
4104#    lw $t2,($sp)
4108#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
4112#    lw $t2,-12($t2) # vtable address
4116#    sge $t0,$t2,$t0 # are we >= the lower limit?
4117##...slt $t0,$t2,$t0
4121##...xori $t0,$t0,0x1
4124#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
4128#    and $t2,$t0,$t1
4132#    sw $t2,($sp)
4136:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
4136#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

4140:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
4140#    li $v0,4 # syscall-code for print-string
4144#    syscall
4148:exit:
    # print termination message
4148#    li $v0,4 # syscall-code for print-string
4152#    la $a0,exitString
4156#    syscall

    # print number of garbage collections
4160#    li $v0,4 # syscall-code for print-string
4164#    la $a0,gcCountMsg
4168#    syscall # print "Number of ..."
4172#    lw $a0,gcCount # number of GC's
4176#    li $v0,1 # code for print-int
4180#    syscall
4184#    li $v0,4 # syscall-code for print-string
4188#    la $a0,newlineString
4192#    syscall # print newline

    # terminate execution
4196#    li $v0,10 #syscall-code for "exit"
4200#    syscall

4204:outOfHeapMemory:
4204#    la $a0,heapMemoryMsg
4208#    j exitError
4212:divByZeroError:
4212#    la $a0,divByZeroMsg
4216#    j exitError
4220:strIndexOutOfBounds:
4220#    la $a0,strIndexOutOfBoundsMsg
4224#    j exitError
4228:arrayIndexOutOfBounds:
4228#    la $a0,arrayIndexOutOfBoundsMsg
4232#    j exitError
4236:arraySizeOutOfBounds:
4236#    la $a0,arraySizeOutOfBoundsMsg
4240#    j exitError
4244:nullPtrException:
4244#    la $a0,nullPtrExceptionMsg
4248#    j exitError
4252:badIntegerFormat:
4252#    la $a0,badIntegerFormatMsg
4256#    j exitError
4260:castException:
4260#    la $a0,castExceptionMsg
4264#    j exitError
############## data section ################
    .data
4524:hexChars:
    .ascii "0123456789abcdef"
    .align 2
4540:cur_seg:
    .word 0

4544:lastCharRead:
    .word -2 # -2 => no buffered character
4548:prevHashConstant:
    .word 0x2785173c
4552:gcCount:
    .word 0

4556:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
4583:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
4606:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
4641:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
4675:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
4708:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
4739:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
4787:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
4808:gcMsg: 
      .asciiz "\nGC!\n"
4814:gcCountMsg: 
      .asciiz "Number of garbage collections: "

4846:nullStr:
    .asciiz "null"
4851:trueString:
    .asciiz "true"
4856:falseString:
    .asciiz "false"
4862:exitString:
    .ascii "Program execution completed."
    #### "falls through" here
4890:newlineString:
    .asciiz "\n"
    
    .align 2
4892:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

4896:seg0_start:
    .space 0x100000
1053472:seg0_end:
1053472:seg1_start:
    .space 0x100000
2102048:seg1_end:
