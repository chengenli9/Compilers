##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
3048:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
3048#    lw $t0,-8($s2) # get word with hash bits from this
3052#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
3056#    addu $t0,$t1

3060#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
3064:mth_equals_Object:
3064#    move $t0,$s2 # first pointer (this)
3068#    lw $t1,($sp) # second pointer
3072#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
3073##...subu $at,$t0,$t1
3077##...sltiu $t0,$at,1

3080#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
3084:mth_hashCode_String:
3084#    move $t0,$s2 # put this pointer in t0

3088#    li $t2,0 # current hash value
3092#    lw $t1,-4($t0) # negative of number of characters in string
3096#    beq $t1,$zero,done_hashCode_String # if zero length => done
3100#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
3104#    and $t0,0xfffffffc # adjust for padding
3105##...lui $at,65535
3109##...ori $at,$at,0xfffc
3113##...and $t0,$t0,$at
3116#    subu $t1,$t0,$t1 # address at end of string +12
3120:loop_hashCode_String:    
3120#    sll $t4,$t2,5 # multiply by 32
3124#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
3128#    lbu $t3,-12($t0) # current character
3132#    addu $t2,$t3 # add in current character
3136#    addu $t0,1 # go to next character's address
3140#    bne $t0,$t1,loop_hashCode_String # loop back if more
3144:done_hashCode_String:    

    # push int on stack
3144#    move $t0, $t2 # put $t2 in return slot
3148#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
3152:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
3152#    subu $sp,4
3156#    sw $ra,($sp)
    
    # get hash value
3160#    lw $t2,-12($s2) # vtable address
3164#    lw $t0,($t2) # method address
3168#    jalr $t0
3172#    subu $sp,8 # push result (int in $t0) on stack
3176#    sw $s5,4($sp)
3180#    sw $t0,($sp)

    # compute print-size of hash value
3184#    li $t0, 1
3188#    lw $t1, ($sp)
3192#    srl $t1,$t1,4
3196#    beq $t1,$zero,toString_skip_loop
3200:toString_loop_top:
3200#    addu $t0,1
3204#    srl $t1,$t1,4
3208#    bne $t1,$zero,toString_loop_top
3212:toString_skip_loop:
3212#    subu $sp,8
3216#    sw $s5,4($sp)
3220#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
3224#    lw $t2,-12($s2) # vtable address
3228#    move $t0,$t2
3232:toString_checkTagBit:
3232#    subu $t0,1
3236#    lb $t1,($t0)
3240#    and $t1,0x80
3241##...lui $at,0
3245##...ori $at,$at,0x80
3249##...and $t1,$t1,$at
3252#    beq $t1,$zero,toString_checkTagBit
3256#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
3260#    subu $sp,8
3264#    sw $t1,($sp)
3268#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
3272#    move $s7,$zero # -4 offset header word
3276#    lw $t4,8($sp) # bytes for hash value
3280#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
3284#    addu $t4,8
3288#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
3292#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

3296#    li $t0,CLASS_String # store string vtable address into ...
3300#    sw $t0,-12($s7) # ... -12 offset in object header
3304#    lw $t2,-12($s2) # our object's vtable address
3308#    lw $t5,4($sp) # number characters in prefix
3312#    lw $t1,12($sp) # number of characters in hashcode
3316#    addu $t3,$t1,$t5 # number of characters in string ...
3320#    addu $t3,1 # ... including the '@' character
3324#    subu $t0,$zero,$t3 # store negated length into ...
3328#    sw $t0,-4($s7) # ... -4 offset header word
3332#    lw $t0,-8($s7) # get -8 offset header-word
3336#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
3337##...slt $at,$t0,$zero
3341##...beq $at,$zero,3360
3344#    and $t0,0xff # mask off object's hash value ...
3345##...lui $at,0
3349##...ori $at,$at,0xff
3353##...and $t0,$t0,$at
3356#    sw $t0,-8($s7) # ... and store back into -8 header-word
3360:skipMask_toString:
3360#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
3364#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
3368#    subu $t4,$t2,$t5
3372:toString_copyLoop:    
3372#    lb $t3,($t4)
3376#    and $t3,0x7f # mask off sign bit (in case first word)
3377##...lui $at,0
3381##...ori $at,$at,0x7f
3385##...and $t3,$t3,$at
3388#    sb $t3,-8($t0)
3392#    addu $t4,1
3396#    addu $t0,1
3400#    blt $t4,$t2,toString_copyLoop
3401##...slt $at,$t4,$t2
3405##...bne $at,$zero,3372

    # copy the '@' sign
3408#    li $t3,'@'
3412#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
3416#    addu $t2,$t0,$t1 # address of last byte in string to store +8
3420#    lw $t3,20($sp) # hash code to print
3424:toString_hashCopyLoop:
3424#    and $t4,$t3,0xf
3428#    srl $t3,4
3432#    lb $t4,hexChars($t4)
3436#    sb $t4,-8($t2)
3440#    subu $t2,$t2,1
3444#    bgt $t2,$t0,toString_hashCopyLoop
3445##...slt $at,$t0,$t2
3449##...bne $at,$zero,3424

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
3452#    addu $sp,28
3456#    lw $ra,($sp)
3460#    addu $sp,4
3464#    move $t0, $s7 # return string we created
3468#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
3472:mth_equals_String:
    
    # quick test for obvious false
3472#    lw $t0,($sp) # second parameter
3476#    beq $t0,$zero,goEsFalse # go return false if null
3480#    lw $t1,-12($t0) # vtable pointer
3484#    la $t2,CLASS_String # string vtable pointer
3488#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
3492#    subu $sp,12
3496#    sw $ra,8($sp)
3500#    sw $s2,4($sp)
3504#    sw $t0,($sp)
3508#    jal mth_compareTo_String
3512#    lw $s2, 4($sp) #restore this pointer and pop parameters
3516#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
3520#    seq $t0,$t0,$zero
3521##...subu $at,$t0,$zero
3525##...sltiu $t0,$at,1

    # pop return address and return $t0
3528#    lw $ra,($sp)
3532#    addu $sp,4

3536#    jr $ra # return
    
3540:goEsFalse:
    # put 0 in $t0 and return
3540#    li $t0, 0
3544#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
3548:mth_toString_String:
    #we are a string, so return this.
3548#    move $t0, $s2
3552#    jr $ra

###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
3556:mth_readLine_Lib:
    
3556#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
3560#    sw $ra, 4($sp) # save $ra
3564#    move $t1,$sp # save "original" sp

3568:  doRead:

    # read the character
3568#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
3572#    subu $t2,$v0,13
3576#    bne $t2,$zero,notReturnRL
3580#    jal readLogicalChar
3584#    subu $t2,$v0,10 # check for newline
3588#    beq $t2,$zero,foundNewLine
3592#    sw $v0,lastCharRead # push back character into queue
3596#    j foundNewLine # go process the line

3600:  notReturnRL:

    # at this point, $v0 has our character

3600#    subu $t0,$v0,10
3604#    beq $t0,$zero,foundNewLine
3608#    blt $v0,$zero,foundEof
3609##...slt $at,$v0,$zero
3613##...bne $at,$zero,3628

    # we have a character, so push it onto stack
3616#    subu $sp,$sp,4
3620#    sw $v0,($sp)

    # loop back up to get next character
3624#    j doRead

3628:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
3628#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
3632#    li $s7, 0 # return-value: null
3636#    j rlReturn # return

3640:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
3640#    subu $t0,$t1,$sp # number of chars we read (times 4)
3644#    srl $s6,$t0,2 # number of words on stack with chars
3648#    subu $sp,$sp,4 # push char-count ...
3652#    sw $s6,($sp) # ... onto stack
3656#    addu $t2,$t0,5 # GC tag, incl. for count-word
3660#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
3664#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
3668#    srl $s6,$s6,2  # data words in object
3672#    move $s7,$zero # object words in object
3676#    jal newObject  # allocate space
    
    # store header words
3680#    la $t0,CLASS_String
3684#    sw $t0,-12($s7)# store class tag (String) into object
3688#    lw $t2,4($sp) # char-count
3692#    sll $t1,$t2,2 # 4 times number of chars
3696#    subu $t2,$zero,$t2 # negative of char-count
3700#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
3704#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
3708#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
3709##...slt $at,$t0,$zero
3713##...beq $at,$zero,3732
3716#    and $t0,0xff # mask off object's hash value ...
3717##...lui $at,0
3721##...ori $at,$at,0xff
3725##...and $t0,$t0,$at
3728#    sw $t0,-8($s7) # ... and store back into -8 header-word
3732:  skipMask_readLine:

3732#    sll $t0,$t0,2 # data bytes in object
3736#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
3740#    subu $t0,$t0,$t2 # place to store last character (plus 9)
3744#    addu $sp,$sp,8 # pop redundant object-pointer and count
3748#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

3752#    beq $sp,$t1,rlReturn
3756:  charCopyLoop:
3756#    lw $t2,($sp)
3760#    sb $t2,-9($t0)
3764#    addu $sp,$sp,4
3768#    subu $t0,$t0,1
3772#    bne $sp,$t1,charCopyLoop
3776:  rlReturn:

3776#    lw $ra, 4($sp)
3780#    addu $sp, 8   # pop $ra and pointless word off stack
3784#    move $t0, $s7 # return string we allocated in $s7
3788#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
3792:mth_readInt_Lib:

    # save $ra by pushing onto stack
3792#    subu $sp,$sp,4
3796#    sw $ra,($sp)

3800:  riSkipWhiteLoop:
    # read a character
3800#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
3804#    subu $t0,$v0,32
3808#    bgt $t0,$zero,nonWhite
3809##...slt $at,$zero,$t0
3813##...bne $at,$zero,3856
3816#    beq $t0,$zero,riSkipWhiteLoop # start over if space
3820#    subu $t0,$v0,10
3824#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
3828#    subu $t0,$v0,9
3832#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
3836#    subu $t0,$v0,13
3840#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
3844#    subu $t0,$v0,12
3848#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
3852#    j badIntegerFormat # illegal integer char: abort program

3856:  nonWhite:
3856#    subu $t0,$v0,'-'
3860#    li $t4,1 # final multiplier
3864#    bne $t0,$zero,helpReadInt # go read
3868#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
3872#    jal readLogicalChar

3876:  helpReadInt:
3876#    li $t2,10
3880#    subu $t1,$v0,'0' # convert digit to 0-9 value
3884#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
3885##...sltu $at,$t1,$t2
3889##...beq $at,$zero,6136
3892#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

3896:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

3896#    jal readLogicalChar # read next character
3900#    subu $t1,$v0,'0' # convert digit to 0-9 value
3904#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
3905##...sltu $at,$t1,$t2
3909##...beq $at,$zero,3928

3912#    mul $t3,$t3,$t2 # multiply old value by 10
3913##...mult $t3,$t2
3917##...mflo $t3
3920#    addu $t3,$t3,$t1 # add in value of new digit
3924#    j digitLoop

3928:  doneDigitLoop:

    # "push back" unused character into queue
3928#    sw $v0,lastCharRead

    # restore return address
3932#    lw $ra,($sp)
3936#    addu $sp, 4

    # multiply by sign and put return value in $t0
3940#    mult $t3,$t4 # multiply to account for poss. minus sign
3944#    mflo $t3
3948#    move $t0, $t3
    
    # return
3952#    jr $ra

###################################################################
# readChar() - library method (class Lib)
# - reads a single character from standard input
# - returns the integer that is the encoding of the character
# - returns -1 if end of file was encountered
# - parameter:
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
3956:mth_readChar_Lib:

    # save $ra by pushing onto stack
3956#    subu $sp,$sp,4
