    # lower limit, and if we're < the higher limit
4612#    lw $t2,-12($t2) # vtable address
4616#    sge $t0,$t2,$t0 # are we >= the lower limit?
4617##...slt $t0,$t2,$t0
4621##...xori $t0,$t0,0x1
4624#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
4628#    and $t2,$t0,$t1
4632#    sw $t2,($sp)
4636:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
4636#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

4640:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
4640#    li $v0,4 # syscall-code for print-string
4644#    syscall
4648:exit:
    # print termination message
4648#    li $v0,4 # syscall-code for print-string
4652#    la $a0,exitString
4656#    syscall

    # print number of garbage collections
4660#    li $v0,4 # syscall-code for print-string
4664#    la $a0,gcCountMsg
4668#    syscall # print "Number of ..."
4672#    lw $a0,gcCount # number of GC's
4676#    li $v0,1 # code for print-int
4680#    syscall
4684#    li $v0,4 # syscall-code for print-string
4688#    la $a0,newlineString
4692#    syscall # print newline

    # terminate execution
4696#    li $v0,10 #syscall-code for "exit"
4700#    syscall

4704:outOfHeapMemory:
4704#    la $a0,heapMemoryMsg
4708#    j exitError
4712:divByZeroError:
4712#    la $a0,divByZeroMsg
4716#    j exitError
4720:strIndexOutOfBounds:
4720#    la $a0,strIndexOutOfBoundsMsg
4724#    j exitError
4728:arrayIndexOutOfBounds:
4728#    la $a0,arrayIndexOutOfBoundsMsg
4732#    j exitError
4736:arraySizeOutOfBounds:
4736#    la $a0,arraySizeOutOfBoundsMsg
4740#    j exitError
4744:nullPtrException:
4744#    la $a0,nullPtrExceptionMsg
4748#    j exitError
4752:badIntegerFormat:
4752#    la $a0,badIntegerFormatMsg
4756#    j exitError
4760:castException:
4760#    la $a0,castExceptionMsg
4764#    j exitError
############## data section ################
    .data
5088:hexChars:
    .ascii "0123456789abcdef"
    .align 2
5104:cur_seg:
    .word 0

5108:lastCharRead:
    .word -2 # -2 => no buffered character
5112:prevHashConstant:
    .word 0x2785173c
5116:gcCount:
    .word 0

5120:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
5147:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
5170:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
5205:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
5239:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
5272:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
5303:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
5351:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
5372:gcMsg: 
      .asciiz "\nGC!\n"
5378:gcCountMsg: 
      .asciiz "Number of garbage collections: "

5410:nullStr:
    .asciiz "null"
5415:trueString:
    .asciiz "true"
5420:falseString:
    .asciiz "false"
5426:exitString:
    .ascii "Program execution completed."
    #### "falls through" here
5454:newlineString:
    .asciiz "\n"
    
    .align 2
5456:stack_bottom:
    .word 0

