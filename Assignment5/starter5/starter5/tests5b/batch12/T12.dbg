        # can be found by "trailing finger"
3324#    lw $s0,($t4)
3328#    lw $t9,-8($t1)
3332#    sw $t9,($t4)
3336#    sw $s0,-8($t1)

    # copy all source bytes to the target
3340:  gCinnerCopy2:
3340#    lw $s0,($t4)
3344#    sw $s0,($s3)
3348#    addu $t4,$t4,4
3352#    addu $s3,$s3,4
3356#    bltu $t4,$t3,gCinnerCopy2
3357##...sltu $at,$t4,$t3
3361##...bne $at,$zero,3340

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
3364#    sw $zero,-8($t1) # 0 in first header-slot
3368#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
3372#    sw $t8,($t0)

3376:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
3376#    addu $t0,$t0,4
3380#    bltu $t0,$s1,gcNextPointerInObject
3381##...sltu $at,$t0,$s1
3385##...bne $at,$zero,3224

3388:  gcTestIterDone2:
3388#    bltu $t0,$s3,gcHeapCopyLoop
3389##...sltu $at,$t0,$s3
3393##...bne $at,$zero,3108

    ###### end outer loop to copy all non-stack-direct objects ######

3396:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
3396#    lw $s2,($sp)
3400#    addu $sp,$sp,4

    # mark us as having already GC'd
3404#    move $t5,$s5

    # go try and allocate again
3408#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
3412:vm_init:

    # mark bottom of stack
3412#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
3416#    move $s2,$zero

    #set up the "five" register
3420#    li $s5,5

3424#    la $s3,seg0_start
3428#    la $s4,seg0_end
3429##...lui $s4,16
3433##...addiu $s4,$s4,4276
    
    # return
3436#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3440:divide:
    # get parameters; abort if divisor zero
3440#    lw $t0,($sp)
3444#    lw $t1,8($sp)
3448#    beq $t0,$zero,divByZeroError
    
    # perform division
3452#    div $t1,$t0
3456#    mflo $t0

    # store result, adjust stack and return
3460#    addu $sp,$sp,8 # adjust stack
3464#    sw $t0,($sp) # store result
3468#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3472:remainder:
    # get parameters; abort if divisor zero
3472#    lw $t0,($sp)
3476#    lw $t1,8($sp)
3480#    beq $t0,$zero,divByZeroError
    
    # perform division
3484#    div $t1,$t0
3488#    mfhi $t0

    # store result, adjust stack and return
3492#    addu $sp,$sp,8 # adjust stack
3496#    sw $t0,($sp) # store result
3500#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
3504:checkCast:
    # get object, allow immediately if null
3504#    lw $t2,($sp)
3508#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
3512#    lw $t2,-12($t2) # vtable address
3516#    bge $t2,$t1,castException
3517##...slt $at,$t2,$t1
3521##...beq $at,$zero,3656
3524#    blt $t2,$t0,castException
3525##...slt $at,$t2,$t0
3529##...bne $at,$zero,3656
    
    # return, leaving object unchanged on stack
3532:  checkCastReturn:    
3532#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
3536:instanceOf:
    # get object, go return false if null
3536#    lw $t2,($sp)
3540#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
3544#    lw $t2,-12($t2) # vtable address
3548#    sge $t0,$t2,$t0 # are we >= the lower limit?
3549##...slt $t0,$t2,$t0
3553##...xori $t0,$t0,0x1
3556#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
3560#    and $t2,$t0,$t1
3564#    sw $t2,($sp)
3568:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
3568#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

3572:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
3572#    li $v0,4 # syscall-code for print-string
3576#    syscall
3580:exit:
    # print termination message
3580#    li $v0,4 # syscall-code for print-string
3584#    la $a0,exitString
3588#    syscall

    # terminate execution
3592#    li $v0,10 #syscall-code for "exit"
3596#    syscall

3600:outOfHeapMemory:
3600#    la $a0,heapMemoryMsg
3604#    j exitError
3608:divByZeroError:
3608#    la $a0,divByZeroMsg
3612#    j exitError
3616:strIndexOutOfBounds:
3616#    la $a0,strIndexOutOfBoundsMsg
3620#    j exitError
3624:arrayIndexOutOfBounds:
3624#    la $a0,arrayIndexOutOfBoundsMsg
3628#    j exitError
3632:arraySizeOutOfBounds:
3632#    la $a0,arraySizeOutOfBoundsMsg
3636#    j exitError
3640:nullPtrException:
3640#    la $a0,nullPtrExceptionMsg
3644#    j exitError
3648:badIntegerFormat:
3648#    la $a0,badIntegerFormatMsg
3652#    j exitError
3656:castException:
3656#    la $a0,castExceptionMsg
3660#    j exitError
############## data section ################
    .data
3912:hexChars:
    .ascii "0123456789abcdef"
    .align 2
3928:cur_seg:
    .word 0

3932:lastCharRead:
    .word -2 # -2 => no buffered character
3936:prevHashConstant:
    .word 0x2785173c
3940:gcCount:
    .word 0

3944:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
3971:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
3994:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
4029:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
4063:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
4096:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
4127:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
4175:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
4196:gcMsg: 
      .asciiz "\nGC!\n"
4202:gcCountMsg: 
      .asciiz "Number of garbage collections: "

4234:nullStr:
    .asciiz "null"
4239:trueString:
    .asciiz "true"
4244:falseString:
    .asciiz "false"
4250:exitString:
    .ascii "Program terminated."
    #### "falls through" here
4269:newlineString:
    .asciiz "\n"
    
    .align 2
4272:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

4276:seg0_start:
    .space 0x100000
1052852:seg0_end:
1052852:seg1_start:
