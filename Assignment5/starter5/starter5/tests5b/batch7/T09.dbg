2312#    move $s7,$zero
2316#    jal newObject

    # get n from string.
2320#    lw $t1,8($sp)

    # store "String" tag into class field
2324#    la $t0,CLASS_String
2328#    sw $t0,-12($s7)
        
    # mask off hash bits, if needed
2332#    lw $t4,-8($s7) # # data words in source string
