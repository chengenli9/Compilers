    #   process next
    # - $t1 contains the contents of the stack slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $t8 contains the pointer to the target object
    # - $s1 contains the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0, $t9
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger"
11900#    lw $s0,($t4)
11904#    lw $t9,-8($t1)
11908#    sw $t9,($t4)
11912#    sw $s0,-8($t1)

    # copy all source bytes to the target
11916:  gCinnerCopy2:
11916#    lw $s0,($t4)
11920#    sw $s0,($s3)
11924#    addu $t4,$t4,4
11928#    addu $s3,$s3,4
11932#    bltu $t4,$t3,gCinnerCopy2
11933##...sltu $at,$t4,$t3
11937##...bne $at,$zero,11916

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
11940#    sw $zero,-8($t1) # 0 in first header-slot
11944#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
11948#    sw $t8,($t0)

11952:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
11952#    addu $t0,$t0,4
11956#    bltu $t0,$s1,gcNextPointerInObject
11957##...sltu $at,$t0,$s1
11961##...bne $at,$zero,11800

11964:  gcTestIterDone2:
11964#    bltu $t0,$s3,gcHeapCopyLoop
11965##...sltu $at,$t0,$s3
11969##...bne $at,$zero,11684

    ###### end outer loop to copy all non-stack-direct objects ######

11972:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
11972#    lw $s2,($sp)
11976#    addu $sp,$sp,4

    # mark us as having already GC'd
11980#    move $t5,$s5

    # go try and allocate again
11984#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
11988:vm_init:

    # mark bottom of stack
11988#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
11992#    move $s2,$zero

    #set up the "five" register
11996#    li $s5,5

12000#    la $s3,seg0_start
12004#    la $s4,seg0_end
12005##...lui $s4,16
12009##...addiu $s4,$s4,13260
    
    # return
12012#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
12016:divide:
    # get parameters; abort if divisor zero
12016#    lw $t0,($sp)
12020#    lw $t1,8($sp)
12024#    beq $t0,$zero,divByZeroError
    
    # perform division
12028#    div $t1,$t0
12032#    mflo $t0

    # store result, adjust stack and return
12036#    addu $sp,$sp,8 # adjust stack
12040#    sw $t0,($sp) # store result
12044#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
12048:remainder:
    # get parameters; abort if divisor zero
12048#    lw $t0,($sp)
12052#    lw $t1,8($sp)
12056#    beq $t0,$zero,divByZeroError
    
    # perform division
12060#    div $t1,$t0
12064#    mfhi $t0

    # store result, adjust stack and return
12068#    addu $sp,$sp,8 # adjust stack
12072#    sw $t0,($sp) # store result
12076#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
12080:checkCast:
    # get object, allow immediately if null
12080#    lw $t2,($sp)
12084#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
12088#    lw $t2,-12($t2) # vtable address
12092#    bge $t2,$t1,castException
12093##...slt $at,$t2,$t1
12097##...beq $at,$zero,12268
12100#    blt $t2,$t0,castException
12101##...slt $at,$t2,$t0
12105##...bne $at,$zero,12268
    
    # return, leaving object unchanged on stack
12108:  checkCastReturn:    
12108#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
12112:instanceOf:
    # get object, go return false if null
12112#    lw $t2,($sp)
12116#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
12120#    lw $t2,-12($t2) # vtable address
12124#    sge $t0,$t2,$t0 # are we >= the lower limit?
12125##...slt $t0,$t2,$t0
12129##...xori $t0,$t0,0x1
12132#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
12136#    and $t2,$t0,$t1
12140#    sw $t2,($sp)
12144:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
12144#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

12148:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
12148#    li $v0,4 # syscall-code for print-string
12152#    syscall
12156:exit:
    # print termination message
12156#    li $v0,4 # syscall-code for print-string
12160#    la $a0,exitString
12164#    syscall

    # print number of garbage collections
12168#    li $v0,4 # syscall-code for print-string
12172#    la $a0,gcCountMsg
12176#    syscall # print "Number of ..."
12180#    lw $a0,gcCount # number of GC's
12184#    li $v0,1 # code for print-int
12188#    syscall
12192#    li $v0,4 # syscall-code for print-string
12196#    la $a0,newlineString
12200#    syscall # print newline

    # terminate execution
12204#    li $v0,10 #syscall-code for "exit"
12208#    syscall

12212:outOfHeapMemory:
12212#    la $a0,heapMemoryMsg
12216#    j exitError
12220:divByZeroError:
12220#    la $a0,divByZeroMsg
12224#    j exitError
12228:strIndexOutOfBounds:
12228#    la $a0,strIndexOutOfBoundsMsg
12232#    j exitError
12236:arrayIndexOutOfBounds:
12236#    la $a0,arrayIndexOutOfBoundsMsg
12240#    j exitError
12244:arraySizeOutOfBounds:
12244#    la $a0,arraySizeOutOfBoundsMsg
12248#    j exitError
12252:nullPtrException:
12252#    la $a0,nullPtrExceptionMsg
12256#    j exitError
12260:badIntegerFormat:
12260#    la $a0,badIntegerFormatMsg
12264#    j exitError
12268:castException:
12268#    la $a0,castExceptionMsg
12272#    j exitError
############## data section ################
    .data
12888:hexChars:
    .ascii "0123456789abcdef"
    .align 2
12904:cur_seg:
    .word 0

12908:lastCharRead:
    .word -2 # -2 => no buffered character
12912:prevHashConstant:
    .word 0x2785173c
12916:gcCount:
    .word 0

12920:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
12947:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
12970:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
13005:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
13039:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
13072:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
13103:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
13151:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
13172:gcMsg: 
      .asciiz "\nGC!\n"
13178:gcCountMsg: 
      .asciiz "Number of garbage collections: "

13210:nullStr:
    .asciiz "null"
13215:trueString:
    .asciiz "true"
13220:falseString:
    .asciiz "false"
13226:exitString:
    .ascii "Program execution completed."
    #### "falls through" here
13254:newlineString:
    .asciiz "\n"
    
    .align 2
13256:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

13260:seg0_start:
    .space 0x100000
1061836:seg0_end:
1061836:seg1_start:
    .space 0x100000
2110412:seg1_end:
