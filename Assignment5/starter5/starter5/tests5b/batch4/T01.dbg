3265##...bne $at,$zero,3308
3268#    beq $t0,$zero,riSkipWhiteLoop # start over if space
3272#    subu $t0,$v0,10
3276#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
3280#    subu $t0,$v0,9
3284#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
3288#    subu $t0,$v0,13
3292#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
3296#    subu $t0,$v0,12
3300#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
3304#    j badIntegerFormat # illegal integer char: abort program

3308:  nonWhite:
3308#    subu $t0,$v0,'-'
3312#    li $t4,1 # final multiplier
3316#    bne $t0,$zero,helpReadInt # go read
3320#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
3324#    jal readLogicalChar

3328:  helpReadInt:
3328#    li $t2,10
3332#    subu $t1,$v0,'0' # convert digit to 0-9 value
