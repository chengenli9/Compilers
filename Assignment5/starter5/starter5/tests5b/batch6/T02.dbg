###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
1636:mth_readLine_Lib:
    
1636#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
1640#    sw $ra, 4($sp) # save $ra
1644#    move $t1,$sp # save "original" sp

1648:  doRead:

    # read the character
1648#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
1652#    subu $t2,$v0,13
1656#    bne $t2,$zero,notReturnRL
1660#    jal readLogicalChar
1664#    subu $t2,$v0,10 # check for newline
1668#    beq $t2,$zero,foundNewLine
1672#    sw $v0,lastCharRead # push back character into queue
1676#    j foundNewLine # go process the line

1680:  notReturnRL:

    # at this point, $v0 has our character

1680#    subu $t0,$v0,10
1684#    beq $t0,$zero,foundNewLine
1688#    blt $v0,$zero,foundEof
1689##...slt $at,$v0,$zero
1693##...bne $at,$zero,1708

    # we have a character, so push it onto stack
1696#    subu $sp,$sp,4
1700#    sw $v0,($sp)

    # loop back up to get next character
1704#    j doRead

1708:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
1708#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
1712#    li $s7, 0 # return-value: null
1716#    j rlReturn # return

1720:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
1720#    subu $t0,$t1,$sp # number of chars we read (times 4)
1724#    srl $s6,$t0,2 # number of words on stack with chars
1728#    subu $sp,$sp,4 # push char-count ...
1732#    sw $s6,($sp) # ... onto stack
1736#    addu $t2,$t0,5 # GC tag, incl. for count-word
1740#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
1744#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
1748#    srl $s6,$s6,2  # data words in object
1752#    move $s7,$zero # object words in object
1756#    jal newObject  # allocate space
    
    # store header words
1760#    la $t0,CLASS_String
1764#    sw $t0,-12($s7)# store class tag (String) into object
1768#    lw $t2,4($sp) # char-count
1772#    sll $t1,$t2,2 # 4 times number of chars
1776#    subu $t2,$zero,$t2 # negative of char-count
1780#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
1784#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
1788#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
1789##...slt $at,$t0,$zero
1793##...beq $at,$zero,1812
1796#    and $t0,0xff # mask off object's hash value ...
1797##...lui $at,0
1801##...ori $at,$at,0xff
1805##...and $t0,$t0,$at
1808#    sw $t0,-8($s7) # ... and store back into -8 header-word
1812:  skipMask_readLine:

1812#    sll $t0,$t0,2 # data bytes in object
1816#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
1820#    subu $t0,$t0,$t2 # place to store last character (plus 9)
1824#    addu $sp,$sp,8 # pop redundant object-pointer and count
1828#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

1832#    beq $sp,$t1,rlReturn
1836:  charCopyLoop:
1836#    lw $t2,($sp)
1840#    sb $t2,-9($t0)
1844#    addu $sp,$sp,4
1848#    subu $t0,$t0,1
1852#    bne $sp,$t1,charCopyLoop
1856:  rlReturn:

1856#    lw $ra, 4($sp)
1860#    addu $sp, 8   # pop $ra and pointless word off stack
1864#    move $t0, $s7 # return string we allocated in $s7
1868#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
1872:mth_readInt_Lib:

    # save $ra by pushing onto stack
1872#    subu $sp,$sp,4
1876#    sw $ra,($sp)

1880:  riSkipWhiteLoop:
    # read a character
1880#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
1884#    subu $t0,$v0,32
1888#    bgt $t0,$zero,nonWhite
1889##...slt $at,$zero,$t0
1893##...bne $at,$zero,1936
1896#    beq $t0,$zero,riSkipWhiteLoop # start over if space
1900#    subu $t0,$v0,10
1904#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
1908#    subu $t0,$v0,9
1912#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
1916#    subu $t0,$v0,13
1920#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
1924#    subu $t0,$v0,12
1928#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
1932#    j badIntegerFormat # illegal integer char: abort program

1936:  nonWhite:
1936#    subu $t0,$v0,'-'
1940#    li $t4,1 # final multiplier
1944#    bne $t0,$zero,helpReadInt # go read
1948#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
1952#    jal readLogicalChar

1956:  helpReadInt:
1956#    li $t2,10
1960#    subu $t1,$v0,'0' # convert digit to 0-9 value
1964#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
1965##...sltu $at,$t1,$t2
1969##...beq $at,$zero,4252
1972#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

1976:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

1976#    jal readLogicalChar # read next character
1980#    subu $t1,$v0,'0' # convert digit to 0-9 value
1984#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
1985##...sltu $at,$t1,$t2
1989##...beq $at,$zero,2008

1992#    mul $t3,$t3,$t2 # multiply old value by 10
1993##...mult $t3,$t2
1997##...mflo $t3
2000#    addu $t3,$t3,$t1 # add in value of new digit
2004#    j digitLoop

2008:  doneDigitLoop:

    # "push back" unused character into queue
2008#    sw $v0,lastCharRead

    # restore return address
2012#    lw $ra,($sp)
2016#    addu $sp, 4

    # multiply by sign and put return value in $t0
2020#    mult $t3,$t4 # multiply to account for poss. minus sign
2024#    mflo $t3
2028#    move $t0, $t3
    
    # return
2032#    jr $ra
