########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
4864:vm_init:

    # mark bottom of stack
4864#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
4868#    move $s2,$zero

    #set up the "five" register
4872#    li $s5,5

4876#    la $s3,seg0_start
4880#    la $s4,seg0_end
4881##...lui $s4,16
4885##...addiu $s4,$s4,5864
    
    # return
4888#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4892:divide:
    # get parameters; abort if divisor zero
4892#    lw $t0,($sp)
4896#    lw $t1,8($sp)
4900#    beq $t0,$zero,divByZeroError
    
    # perform division
4904#    div $t1,$t0
4908#    mflo $t0

    # store result, adjust stack and return
4912#    addu $sp,$sp,8 # adjust stack
4916#    sw $t0,($sp) # store result
4920#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4924:remainder:
    # get parameters; abort if divisor zero
4924#    lw $t0,($sp)
4928#    lw $t1,8($sp)
4932#    beq $t0,$zero,divByZeroError
    
    # perform division
4936#    div $t1,$t0
4940#    mfhi $t0

    # store result, adjust stack and return
4944#    addu $sp,$sp,8 # adjust stack
4948#    sw $t0,($sp) # store result
4952#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
4956:checkCast:
    # get object, allow immediately if null
4956#    lw $t2,($sp)
4960#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
4964#    lw $t2,-12($t2) # vtable address
4968#    bge $t2,$t1,castException
4969##...slt $at,$t2,$t1
4973##...beq $at,$zero,5144
4976#    blt $t2,$t0,castException
4977##...slt $at,$t2,$t0
4981##...bne $at,$zero,5144
    
    # return, leaving object unchanged on stack
4984:  checkCastReturn:    
4984#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
4988:instanceOf:
    # get object, go return false if null
4988#    lw $t2,($sp)
4992#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
4996#    lw $t2,-12($t2) # vtable address
5000#    sge $t0,$t2,$t0 # are we >= the lower limit?
5001##...slt $t0,$t2,$t0
5005##...xori $t0,$t0,0x1
5008#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
5012#    and $t2,$t0,$t1
5016#    sw $t2,($sp)
5020:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
5020#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

5024:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
5024#    li $v0,4 # syscall-code for print-string
5028#    syscall
5032:exit:
    # print termination message
5032#    li $v0,4 # syscall-code for print-string
5036#    la $a0,exitString
5040#    syscall

    # print number of garbage collections
5044#    li $v0,4 # syscall-code for print-string
5048#    la $a0,gcCountMsg
5052#    syscall # print "Number of ..."
5056#    lw $a0,gcCount # number of GC's
5060#    li $v0,1 # code for print-int
5064#    syscall
5068#    li $v0,4 # syscall-code for print-string
5072#    la $a0,newlineString
5076#    syscall # print newline

    # terminate execution
5080#    li $v0,10 #syscall-code for "exit"
5084#    syscall

5088:outOfHeapMemory:
5088#    la $a0,heapMemoryMsg
5092#    j exitError
5096:divByZeroError:
5096#    la $a0,divByZeroMsg
5100#    j exitError
5104:strIndexOutOfBounds:
5104#    la $a0,strIndexOutOfBoundsMsg
5108#    j exitError
5112:arrayIndexOutOfBounds:
5112#    la $a0,arrayIndexOutOfBoundsMsg
5116#    j exitError
5120:arraySizeOutOfBounds:
5120#    la $a0,arraySizeOutOfBoundsMsg
5124#    j exitError
5128:nullPtrException:
5128#    la $a0,nullPtrExceptionMsg
5132#    j exitError
5136:badIntegerFormat:
5136#    la $a0,badIntegerFormatMsg
5140#    j exitError
5144:castException:
5144#    la $a0,castExceptionMsg
5148#    j exitError
############## data section ################
    .data
5492:hexChars:
    .ascii "0123456789abcdef"
    .align 2
5508:cur_seg:
    .word 0

5512:lastCharRead:
    .word -2 # -2 => no buffered character
5516:prevHashConstant:
    .word 0x2785173c
5520:gcCount:
    .word 0

5524:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
5551:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
5574:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
5609:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
5643:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
5676:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
5707:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
5755:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
5776:gcMsg: 
      .asciiz "\nGC!\n"
5782:gcCountMsg: 
      .asciiz "Number of garbage collections: "

5814:nullStr:
    .asciiz "null"
5819:trueString:
    .asciiz "true"
5824:falseString:
    .asciiz "false"
5830:exitString:
    .ascii "Program execution completed."
    #### "falls through" here
5858:newlineString:
    .asciiz "\n"
    
    .align 2
5860:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

5864:seg0_start:
    .space 0x100000
1054440:seg0_end:
1054440:seg1_start:
    .space 0x100000
2103016:seg1_end:
