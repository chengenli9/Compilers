4356#    lw $t9,-8($t1)
4360#    sw $t9,($t4)
4364#    sw $s0,-8($t1)

    # copy all source bytes to the target
4368:  gCinnerCopy2:
4368#    lw $s0,($t4)
4372#    sw $s0,($s3)
4376#    addu $t4,$t4,4
4380#    addu $s3,$s3,4
