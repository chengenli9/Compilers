###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
1788:mth_readLine_Lib:
    
1788#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
1792#    sw $ra, 4($sp) # save $ra
1796#    move $t1,$sp # save "original" sp

1800:  doRead:

    # read the character
1800#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
1804#    subu $t2,$v0,13
1808#    bne $t2,$zero,notReturnRL
1812#    jal readLogicalChar
1816#    subu $t2,$v0,10 # check for newline
1820#    beq $t2,$zero,foundNewLine
1824#    sw $v0,lastCharRead # push back character into queue
1828#    j foundNewLine # go process the line

1832:  notReturnRL:

    # at this point, $v0 has our character

1832#    subu $t0,$v0,10
1836#    beq $t0,$zero,foundNewLine
1840#    blt $v0,$zero,foundEof
1841##...slt $at,$v0,$zero
1845##...bne $at,$zero,1860

    # we have a character, so push it onto stack
1848#    subu $sp,$sp,4
1852#    sw $v0,($sp)

    # loop back up to get next character
1856#    j doRead

1860:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
1860#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
1864#    li $s7, 0 # return-value: null
1868#    j rlReturn # return

1872:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
1872#    subu $t0,$t1,$sp # number of chars we read (times 4)
1876#    srl $s6,$t0,2 # number of words on stack with chars
1880#    subu $sp,$sp,4 # push char-count ...
1884#    sw $s6,($sp) # ... onto stack
1888#    addu $t2,$t0,5 # GC tag, incl. for count-word
1892#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
1896#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
1900#    srl $s6,$s6,2  # data words in object
1904#    move $s7,$zero # object words in object
1908#    jal newObject  # allocate space
    
    # store header words
1912#    la $t0,CLASS_String
1916#    sw $t0,-12($s7)# store class tag (String) into object
1920#    lw $t2,4($sp) # char-count
1924#    sll $t1,$t2,2 # 4 times number of chars
1928#    subu $t2,$zero,$t2 # negative of char-count
1932#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
1936#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
1940#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
1941##...slt $at,$t0,$zero
1945##...beq $at,$zero,1964
1948#    and $t0,0xff # mask off object's hash value ...
1949##...lui $at,0
1953##...ori $at,$at,0xff
1957##...and $t0,$t0,$at
1960#    sw $t0,-8($s7) # ... and store back into -8 header-word
1964:  skipMask_readLine:

1964#    sll $t0,$t0,2 # data bytes in object
1968#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
1972#    subu $t0,$t0,$t2 # place to store last character (plus 9)
1976#    addu $sp,$sp,8 # pop redundant object-pointer and count
1980#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

1984#    beq $sp,$t1,rlReturn
1988:  charCopyLoop:
1988#    lw $t2,($sp)
1992#    sb $t2,-9($t0)
1996#    addu $sp,$sp,4
2000#    subu $t0,$t0,1
2004#    bne $sp,$t1,charCopyLoop
2008:  rlReturn:

2008#    lw $ra, 4($sp)
2012#    addu $sp, 8   # pop $ra and pointless word off stack
2016#    move $t0, $s7 # return string we allocated in $s7
2020#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
2024:mth_readInt_Lib:

    # save $ra by pushing onto stack
2024#    subu $sp,$sp,4
2028#    sw $ra,($sp)

2032:  riSkipWhiteLoop:
    # read a character
2032#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
2036#    subu $t0,$v0,32
2040#    bgt $t0,$zero,nonWhite
2041##...slt $at,$zero,$t0
2045##...bne $at,$zero,2088
2048#    beq $t0,$zero,riSkipWhiteLoop # start over if space
2052#    subu $t0,$v0,10
2056#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
2060#    subu $t0,$v0,9
2064#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
2068#    subu $t0,$v0,13
2072#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
2076#    subu $t0,$v0,12
2080#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
2084#    j badIntegerFormat # illegal integer char: abort program

2088:  nonWhite:
2088#    subu $t0,$v0,'-'
2092#    li $t4,1 # final multiplier
2096#    bne $t0,$zero,helpReadInt # go read
2100#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
2104#    jal readLogicalChar

2108:  helpReadInt:
2108#    li $t2,10
2112#    subu $t1,$v0,'0' # convert digit to 0-9 value
2116#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
2117##...sltu $at,$t1,$t2
2121##...beq $at,$zero,4404
2124#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

2128:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

2128#    jal readLogicalChar # read next character
2132#    subu $t1,$v0,'0' # convert digit to 0-9 value
2136#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
2137##...sltu $at,$t1,$t2
2141##...beq $at,$zero,2160

2144#    mul $t3,$t3,$t2 # multiply old value by 10
2145##...mult $t3,$t2
2149##...mflo $t3
2152#    addu $t3,$t3,$t1 # add in value of new digit
2156#    j digitLoop

2160:  doneDigitLoop:

    # "push back" unused character into queue
2160#    sw $v0,lastCharRead

    # restore return address
2164#    lw $ra,($sp)
2168#    addu $sp, 4

    # multiply by sign and put return value in $t0
2172#    mult $t3,$t4 # multiply to account for poss. minus sign
2176#    mflo $t3
2180#    move $t0, $t3
    
    # return
2184#    jr $ra

###################################################################
# readChar() - library method (class Lib)
# - reads a single character from standard input
# - returns the integer that is the encoding of the character
# - returns -1 if end of file was encountered
# - parameter:
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
2188:mth_readChar_Lib:

    # save $ra by pushing onto stack
2188#    subu $sp,$sp,4
2192#    sw $ra,($sp)

      # read the character
2196#    jal readLogicalChar

    # restore return address; put value in $t0
    # replacing this-pointer saved return address
2200#    lw $ra,($sp)
2204#    addu $sp, 4
2208#    move $t0, $v0
