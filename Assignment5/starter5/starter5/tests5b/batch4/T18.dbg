    # therefore does not refer to an object on the heap, just go
    # loop back and do the next one
3456#    bleu $t1,$t6,gcTestIterDone1
3457##...sltu $at,$t6,$t1
3461##...beq $at,$zero,3624
3464#    bgtu $t1,$t7,gcTestIterDone1
3465##...sltu $at,$t7,$t1
3469##...bne $at,$zero,3624

    # if the object has already been moved, update the stack-value
    # via the forwarding pointer
3472#    lw $t2,-8($t1) # possible forwarding tag
3476#    bne $t2,$zero,gcNoForward1 # if not forwarding tag, go copy
3480#    lw $t2,-4($t1) # forwarding pointer: object's new address
3484#    sw $t2,4($t0) # update stack value
3488#    j gcTestIterDone1 # do next iteration

3492:  gcNoForward1:
    #########################################################
    # we actually need to copy the object into the new space
    #########################################################

    # compute the amount of space that is needed
3492#    bge $t2,$zero,gcSkip2
3493##...slt $at,$t2,$zero
3497##...beq $at,$zero,3512
3500#    and $t2,0xff #### mask off hash value
3501##...lui $at,0
3505##...ori $at,$at,0xff
3509##...and $t2,$t2,$at
    #### OLD
    #### subu $t2,$zero,$t2 # set to 1 if -1 (number of data words)

3512:  gcSkip2:
3512#    sll $t2,$t2,2
3516#    addu $t2,$t2,8
3520#    subu $t4,$t1,$t2 # address of first word of source
3524#    lw $t3,-4($t1) # number of object words (negative means zero)
3528#    bge $t3,$zero,gcH2Neg1
3529##...slt $at,$t3,$zero
3533##...beq $at,$zero,3540
3536#    move $t3,$zero
3540:  gcH2Neg1:
3540#    sll $t3,$t3,2
3544#    addu $t3,$t3,$t1 # address one word past last word of source

3548#    addu $t2,$s3,$t2 # pointer to target object

    #########################################################
    # At this point:
    # - $t0 contains the address of the stack slot we'll
    #   process next
    # - $t1 contains the contents of the stack slot we're
    #   currently working on, which is a pointer to the source
    #   object (i.e., the address just beyond the object's header)
    # - $t2 contains the pointer to the target object
    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0-2
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger" in the target space
3552#    lw $s0,($t4)
3556#    lw $s1,-8($t1)
3560#    sw $s1,($t4)
3564#    sw $s0,-8($t1)
    
    # copy all source bytes to the target
3568:  gCinnerCopy1:
3568#    lw $s0,($t4)
3572#    sw $s0,($s3)
3576#    addu $t4,$t4,4
3580#    addu $s3,$s3,4
3584#    bltu $t4,$t3,gCinnerCopy1
3585##...sltu $at,$t4,$t3
3589##...bne $at,$zero,3568

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
3592#    sw $zero,-8($t1) # 0 in first header-slot
3596#    sw $t2,-4($t1) # forwarding pointer in second header-slot

    # update the stack slot with the address in the target space
3600#    sw $t2,4($t0)
3604#    lw $zero,-8($t2)
3608#    lw $zero,-4($t2)

    # go handle next stack slot (testing if done)
3612#    j gcTestIterDone1

3616:  gcBump:
    #### we have a GC tag.  Bytes to skip: tag value + 3.
3616#    subu $t0,$t0,$t1
3620#    subu $t0,$t0,3

3624:  gcTestIterDone1:
3624#    bgeu $t0,$sp,gcStackCopyLoop
3625##...sltu $at,$t0,$sp
3629##...beq $at,$zero,3440

    ###### end outer loop to copy all stack-direct objects ######

    #############################################################
    # We have finished processing the stack elements.  Now we need
    # to update elements in the heap itself. This may itself involve
    # moving additional objects
    #############################################################

    #########################################################
    # At this point:
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # We want to set things up so that in addition:
    # - $t0 is the "trailing finger", containing the address
    #   of the first slot in target space that we have yet
    #   to process.
    # Then during processing:
    # - $t1 will contain the contents of the heap slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # And when we're actually copying an object:
    # - $t2 will contain pointer to the target object
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - available for use: $s0
    ##########################################################

    # set $t0 to be at the beginning of target-space
3632#    lw $t1,cur_seg
3636#    la $t0,seg0_start
3640#    beq $t1,$zero,gcSkip4
3644#    la $t0,seg1_start
3645##...lui $t0,16
3649##...addiu $t0,$t0,4852


3652:  gcSkip4:

    # if there were no objects put into the heap during stack
    # processing, we're done, so go finish up
3652#    bgeu $t0,$s3,gcFinishUp
3653##...sltu $at,$t0,$s3
3657##...beq $at,$zero,3948

    ###### begin outer loop to copy all non-stack-direct objects ######

3660:  gcHeapCopyLoop:
    # get data count for object; swap header-word with first word
    # of object so that they're back in the right place
3660#    lw $t1,($t0) # (what will be) first header word for current object
3664#    move $t2,$t1 # number data bytes in object (poss. w/hash bits)
3668#    bge $t2,$zero,gcSkip4a # are there hash bits?
3669##...slt $at,$t2,$zero
3673##...beq $at,$zero,3688
3676#    and $t2,0xff # mask off hash bits
3677##...lui $at,0
3681##...ori $at,$at,0xff
3685##...and $t2,$t2,$at
3688:gcSkip4a:    
3688#    sll $t2,$t2,2 # # data bytes
3692#    addu $t2,$t2,8 # to skip header words
3696#    addu $t2,$t0,$t2 # pointer to new object
3700#    lw $t3,-8($t2) # word to swap
3704#    sw $t1,-8($t2) # store header word
3708#    sw $t3,($t0) # restore first word of object

    ################################################
    # at this point:
    # - $t2 contains the pointer to our new object
    ################################################

    # check if we have a data array
3712#    lw $t1,-12($t2) # vtable pointer
3716#    li $t0,dataArrayVTableStart # address of vtable for first data array
3720#    blt $t1,$t0,gcNotDataArray # if data array, no more xforming to do
3721##...slt $at,$t1,$t0
3725##...bne $at,$zero,3744

    # We have a vtable address that is a data array.
    # we need skip over it then loop back to do next object.
3728:  skipToNextObj:
3728#    lw $t1,-4($t2) # data words in (object position of) array
    #### note: we know that it's not a string, so the value will
    #### not be artificially negative
3732#    sll $t1,$t1,2 # convert to byte-count
3736#    addu $t0,$t2,$t1 # skip over object
3740#    j gcTestIterDone2 # go do next object, if any

    ###################################################
    # at this point:
    # - the object has been restored to normal status--that is, the
    #   word-swap has been done
    # - $t2 contains a pointer to the object
    ###################################################
    
3744:  gcNotDataArray:
3744#    lw $t3,-4($t2) # # object words (negative treated as zero)
3748#    bge $t3,$zero,gcH2Neg2
3749##...slt $at,$t3,$zero
3753##...beq $at,$zero,3760
3756#    move $t3,$zero
3760:  gcH2Neg2:
3760#    sll $t3,$t3,2 # # object bytes
3764#    move $t0,$t2 # address of first pointer in object
3768#    add $s1,$t2,$t3 # limit address for this object

    #####################################################
    # At this point, we have to "translate" all pointers,
    # starting at $t0 to (but not including) $s1
    #####################################################

    # if there are no pointer-slots (i.e., $t0=$s1), skip this
    # part
3772#    beq $t0,$s1,gcTestIterDone2
    
3776:  gcNextPointerInObject:
    # get pointer from object
3776#    lw $t1,($t0)

    # if value is out of range, and is therefore does not refer
    # to an object, just go loop back and do the next one
3780#    bleu $t1,$t6,gcGoNextPointerSlot
3781##...sltu $at,$t6,$t1
3785##...beq $at,$zero,3928
3788#    bgtu $t1,$t7,gcGoNextPointerSlot
3789##...sltu $at,$t7,$t1
3793##...bne $at,$zero,3928

    # if the object has already been moved, update the stack-value
    # via the forwarding pointer
3796#    lw $t8,-8($t1) # possible forwarding tag
3800#    bne $t8,$zero,gcNoForward2 # if not forwarding tag, go copy
3804#    lw $t8,-4($t1) # forwarding pointer: object's new address
3808#    sw $t8,($t0) # update pointer in object
3812#    j gcGoNextPointerSlot # do next iteration

3816:  gcNoForward2:
    #########################################################
    # we actually need to copy the object into the new space
    #########################################################

    #########################################################
    # At this point:
    # - $t0 contains the address of the heap-slot we're translating
    # - $t1 will contain the contents of the heap-slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space, which will also be the first address
    #   of the target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # Then during processing:
    # And when we're actually copying an object:
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $t8 will contain a pointer to the target object
    # - available for use: $s0, $t8, $t9
    ##########################################################

    # compute the amount of space that is needed
3816#    bge $t8,$zero,gcSkip5 # # words in negative-offset portion
3817##...slt $at,$t8,$zero
3821##...beq $at,$zero,3836
3824#    and $t8,0xff # mask off hash bits
3825##...lui $at,0
3829##...ori $at,$at,0xff
3833##...and $t8,$t8,$at

3836:  gcSkip5:
3836#    sll $t8,$t8,2 # bytes in negative-offset portion ...
3840#    addu $t8,$t8,8 # ... add in bytes for header-words
3844#    subu $t4,$t1,$t8 # address of first word of source object
3848#    lw $t3,-4($t1) # # words in positive-offset portion
3852#    bge $t3,$zero,gcNoNeg
3853##...slt $at,$t3,$zero
3857##...beq $at,$zero,3864
3860#    move $t3,$zero # negative treated as zero
3864:  gcNoNeg:
3864#    sll $t3,$t3,2 # bytes in negative-offset portion
3868#    addu $t3,$t3,$t1 # address one word past last word of source

3872#    addu $t8,$s3,$t8 # pointer to target object

    #########################################################
    # At this point:
    # - $t0 contains the address of the stack slot we'll
    #   process next
    # - $t1 contains the contents of the stack slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $t8 contains the pointer to the target object
    # - $s1 contains the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0, $t9
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger"
3876#    lw $s0,($t4)
3880#    lw $t9,-8($t1)
3884#    sw $t9,($t4)
3888#    sw $s0,-8($t1)

    # copy all source bytes to the target
3892:  gCinnerCopy2:
3892#    lw $s0,($t4)
3896#    sw $s0,($s3)
3900#    addu $t4,$t4,4
3904#    addu $s3,$s3,4
3908#    bltu $t4,$t3,gCinnerCopy2
3909##...sltu $at,$t4,$t3
3913##...bne $at,$zero,3892

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
3916#    sw $zero,-8($t1) # 0 in first header-slot
3920#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
3924#    sw $t8,($t0)

3928:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
3928#    addu $t0,$t0,4
3932#    bltu $t0,$s1,gcNextPointerInObject
3933##...sltu $at,$t0,$s1
3937##...bne $at,$zero,3776

3940:  gcTestIterDone2:
3940#    bltu $t0,$s3,gcHeapCopyLoop
3941##...sltu $at,$t0,$s3
3945##...bne $at,$zero,3660

    ###### end outer loop to copy all non-stack-direct objects ######

3948:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
3948#    lw $s2,($sp)
3952#    addu $sp,$sp,4

    # mark us as having already GC'd
3956#    move $t5,$s5

    # go try and allocate again
3960#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
3964:vm_init:

    # mark bottom of stack
3964#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
3968#    move $s2,$zero

    #set up the "five" register
3972#    li $s5,5

3976#    la $s3,seg0_start
3980#    la $s4,seg0_end
3981##...lui $s4,16
3985##...addiu $s4,$s4,4852
    
    # return
3988#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3992:divide:
    # get parameters; abort if divisor zero
3992#    lw $t0,($sp)
3996#    lw $t1,8($sp)
4000#    beq $t0,$zero,divByZeroError
    
    # perform division
4004#    div $t1,$t0
4008#    mflo $t0

    # store result, adjust stack and return
4012#    addu $sp,$sp,8 # adjust stack
4016#    sw $t0,($sp) # store result
4020#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4024:remainder:
    # get parameters; abort if divisor zero
4024#    lw $t0,($sp)
4028#    lw $t1,8($sp)
4032#    beq $t0,$zero,divByZeroError
    
    # perform division
4036#    div $t1,$t0
4040#    mfhi $t0

    # store result, adjust stack and return
4044#    addu $sp,$sp,8 # adjust stack
4048#    sw $t0,($sp) # store result
4052#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
4056:checkCast:
    # get object, allow immediately if null
4056#    lw $t2,($sp)
4060#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
4064#    lw $t2,-12($t2) # vtable address
4068#    bge $t2,$t1,castException
4069##...slt $at,$t2,$t1
4073##...beq $at,$zero,4244
4076#    blt $t2,$t0,castException
4077##...slt $at,$t2,$t0
4081##...bne $at,$zero,4244
    
    # return, leaving object unchanged on stack
4084:  checkCastReturn:    
4084#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
4088:instanceOf:
    # get object, go return false if null
4088#    lw $t2,($sp)
4092#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
4096#    lw $t2,-12($t2) # vtable address
4100#    sge $t0,$t2,$t0 # are we >= the lower limit?
4101##...slt $t0,$t2,$t0
4105##...xori $t0,$t0,0x1
4108#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
4112#    and $t2,$t0,$t1
4116#    sw $t2,($sp)
4120:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
4120#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

4124:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
4124#    li $v0,4 # syscall-code for print-string
4128#    syscall
4132:exit:
    # print termination message
4132#    li $v0,4 # syscall-code for print-string
4136#    la $a0,exitString
4140#    syscall

    # print number of garbage collections
4144#    li $v0,4 # syscall-code for print-string
4148#    la $a0,gcCountMsg
4152#    syscall # print "Number of ..."
4156#    lw $a0,gcCount # number of GC's
4160#    li $v0,1 # code for print-int
4164#    syscall
4168#    li $v0,4 # syscall-code for print-string
4172#    la $a0,newlineString
4176#    syscall # print newline

    # terminate execution
4180#    li $v0,10 #syscall-code for "exit"
4184#    syscall

4188:outOfHeapMemory:
4188#    la $a0,heapMemoryMsg
4192#    j exitError
4196:divByZeroError:
4196#    la $a0,divByZeroMsg
4200#    j exitError
4204:strIndexOutOfBounds:
4204#    la $a0,strIndexOutOfBoundsMsg
4208#    j exitError
4212:arrayIndexOutOfBounds:
4212#    la $a0,arrayIndexOutOfBoundsMsg
4216#    j exitError
4220:arraySizeOutOfBounds:
4220#    la $a0,arraySizeOutOfBoundsMsg
4224#    j exitError
4228:nullPtrException:
4228#    la $a0,nullPtrExceptionMsg
4232#    j exitError
4236:badIntegerFormat:
4236#    la $a0,badIntegerFormatMsg
4240#    j exitError
4244:castException:
4244#    la $a0,castExceptionMsg
4248#    j exitError
############## data section ################
    .data
4480:hexChars:
    .ascii "0123456789abcdef"
    .align 2
4496:cur_seg:
    .word 0

4500:lastCharRead:
    .word -2 # -2 => no buffered character
4504:prevHashConstant:
    .word 0x2785173c
4508:gcCount:
    .word 0

4512:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
4539:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
4562:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
4597:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
4631:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
4664:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
4695:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
4743:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
4764:gcMsg: 
      .asciiz "\nGC!\n"
4770:gcCountMsg: 
      .asciiz "Number of garbage collections: "

4802:nullStr:
    .asciiz "null"
4807:trueString:
    .asciiz "true"
4812:falseString:
    .asciiz "false"
4818:exitString:
    .ascii "Program execution completed."
    #### "falls through" here
4846:newlineString:
    .asciiz "\n"
    
    .align 2
4848:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

4852:seg0_start:
    .space 0x100000
1053428:seg0_end:
1053428:seg1_start:
    .space 0x100000
2102004:seg1_end:
