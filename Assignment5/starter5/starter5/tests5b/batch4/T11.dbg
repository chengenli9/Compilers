#       lexographically less than, equal to or greater than str2
########################################################
2912:mth_compareTo_String:
    # get string pointers and check parameter for null
2912#    lw $t0,($sp) # second string
2916#    beq $t0,$zero,nullPtrException
2920#    move $t1,$s2 # first string
    
