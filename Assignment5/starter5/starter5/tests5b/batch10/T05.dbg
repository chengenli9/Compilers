    # store second header-value
5872#    sw $s7,-4($t0)   # second header-word
5876#    lw $zero,-4($t0)
    
    # put return-value into $s7 and also push it onto top of stack
5880#    move $s7,$t0
5884#    subu $sp,$sp,4
5888#    sw $t0,($sp)
