
    # copy all source bytes to the target
3472:  gCinnerCopy2:
3472#    lw $s0,($t4)
3476#    sw $s0,($s3)
3480#    addu $t4,$t4,4
3484#    addu $s3,$s3,4
3488#    bltu $t4,$t3,gCinnerCopy2
3489##...sltu $at,$t4,$t3
3493##...bne $at,$zero,3472

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
3496#    sw $zero,-8($t1) # 0 in first header-slot
3500#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
3504#    sw $t8,($t0)

3508:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
3508#    addu $t0,$t0,4
3512#    bltu $t0,$s1,gcNextPointerInObject
3513##...sltu $at,$t0,$s1
3517##...bne $at,$zero,3356

3520:  gcTestIterDone2:
3520#    bltu $t0,$s3,gcHeapCopyLoop
3521##...sltu $at,$t0,$s3
3525##...bne $at,$zero,3240

    ###### end outer loop to copy all non-stack-direct objects ######

3528:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
3528#    lw $s2,($sp)
3532#    addu $sp,$sp,4

    # mark us as having already GC'd
3536#    move $t5,$s5

    # go try and allocate again
3540#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
3544:vm_init:

    # mark bottom of stack
3544#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
3548#    move $s2,$zero

    #set up the "five" register
3552#    li $s5,5

3556#    la $s3,seg0_start
3560#    la $s4,seg0_end
3561##...lui $s4,16
3565##...addiu $s4,$s4,4400
    
    # return
3568#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3572:divide:
    # get parameters; abort if divisor zero
3572#    lw $t0,($sp)
3576#    lw $t1,8($sp)
3580#    beq $t0,$zero,divByZeroError
    
    # perform division
3584#    div $t1,$t0
3588#    mflo $t0

    # store result, adjust stack and return
3592#    addu $sp,$sp,8 # adjust stack
3596#    sw $t0,($sp) # store result
3600#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3604:remainder:
    # get parameters; abort if divisor zero
3604#    lw $t0,($sp)
3608#    lw $t1,8($sp)
3612#    beq $t0,$zero,divByZeroError
    
    # perform division
3616#    div $t1,$t0
3620#    mfhi $t0

    # store result, adjust stack and return
3624#    addu $sp,$sp,8 # adjust stack
3628#    sw $t0,($sp) # store result
3632#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
3636:checkCast:
    # get object, allow immediately if null
3636#    lw $t2,($sp)
3640#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
3644#    lw $t2,-12($t2) # vtable address
3648#    bge $t2,$t1,castException
3649##...slt $at,$t2,$t1
3653##...beq $at,$zero,3824
3656#    blt $t2,$t0,castException
3657##...slt $at,$t2,$t0
3661##...bne $at,$zero,3824
    
    # return, leaving object unchanged on stack
3664:  checkCastReturn:    
3664#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
3668:instanceOf:
    # get object, go return false if null
3668#    lw $t2,($sp)
3672#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
3676#    lw $t2,-12($t2) # vtable address
3680#    sge $t0,$t2,$t0 # are we >= the lower limit?
3681##...slt $t0,$t2,$t0
3685##...xori $t0,$t0,0x1
3688#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
3692#    and $t2,$t0,$t1
3696#    sw $t2,($sp)
3700:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
3700#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

3704:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
3704#    li $v0,4 # syscall-code for print-string
3708#    syscall
3712:exit:
    # print termination message
3712#    li $v0,4 # syscall-code for print-string
3716#    la $a0,exitString
3720#    syscall

    # print number of garbage collections
3724#    li $v0,4 # syscall-code for print-string
3728#    la $a0,gcCountMsg
3732#    syscall # print "Number of ..."
3736#    lw $a0,gcCount # number of GC's
3740#    li $v0,1 # code for print-int
3744#    syscall
3748#    li $v0,4 # syscall-code for print-string
3752#    la $a0,newlineString
3756#    syscall # print newline

    # terminate execution
3760#    li $v0,10 #syscall-code for "exit"
3764#    syscall

3768:outOfHeapMemory:
3768#    la $a0,heapMemoryMsg
3772#    j exitError
3776:divByZeroError:
3776#    la $a0,divByZeroMsg
3780#    j exitError
3784:strIndexOutOfBounds:
3784#    la $a0,strIndexOutOfBoundsMsg
3788#    j exitError
3792:arrayIndexOutOfBounds:
3792#    la $a0,arrayIndexOutOfBoundsMsg
3796#    j exitError
3800:arraySizeOutOfBounds:
3800#    la $a0,arraySizeOutOfBoundsMsg
3804#    j exitError
3808:nullPtrException:
3808#    la $a0,nullPtrExceptionMsg
3812#    j exitError
3816:badIntegerFormat:
3816#    la $a0,badIntegerFormatMsg
3820#    j exitError
3824:castException:
3824#    la $a0,castExceptionMsg
3828#    j exitError
############## data section ################
    .data
4028:hexChars:
    .ascii "0123456789abcdef"
    .align 2
4044:cur_seg:
    .word 0

4048:lastCharRead:
    .word -2 # -2 => no buffered character
4052:prevHashConstant:
    .word 0x2785173c
4056:gcCount:
    .word 0

4060:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
4087:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
4110:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
4145:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
4179:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
4212:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
4243:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
4291:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
4312:gcMsg: 
      .asciiz "\nGC!\n"
4318:gcCountMsg: 
      .asciiz "Number of garbage collections: "

4350:nullStr:
    .asciiz "null"
4355:trueString:
    .asciiz "true"
4360:falseString:
    .asciiz "false"
4366:exitString:
    .ascii "Program execution completed."
    #### "falls through" here
4394:newlineString:
    .asciiz "\n"
    
    .align 2
4396:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

4400:seg0_start:
    .space 0x100000
1052976:seg0_end:
1052976:seg1_start:
    .space 0x100000
2101552:seg1_end:
