#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
16604:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
16604#    lw $t0,-8($s2) # get word with hash bits from this
16608#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
16612#    addu $t0,$t1

16616#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
16620:mth_equals_Object:
16620#    move $t0,$s2 # first pointer (this)
16624#    lw $t1,($sp) # second pointer
16628#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
16629##...subu $at,$t0,$t1
16633##...sltiu $t0,$at,1

16636#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
16640:mth_hashCode_String:
16640#    move $t0,$s2 # put this pointer in t0

16644#    li $t2,0 # current hash value
16648#    lw $t1,-4($t0) # negative of number of characters in string
16652#    beq $t1,$zero,done_hashCode_String # if zero length => done
16656#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
16660#    and $t0,0xfffffffc # adjust for padding
16661##...lui $at,65535
16665##...ori $at,$at,0xfffc
16669##...and $t0,$t0,$at
16672#    subu $t1,$t0,$t1 # address at end of string +12
16676:loop_hashCode_String:    
16676#    sll $t4,$t2,5 # multiply by 32
16680#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
16684#    lbu $t3,-12($t0) # current character
16688#    addu $t2,$t3 # add in current character
16692#    addu $t0,1 # go to next character's address
16696#    bne $t0,$t1,loop_hashCode_String # loop back if more
16700:done_hashCode_String:    

    # push int on stack
16700#    move $t0, $t2 # put $t2 in return slot
16704#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
16708:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
16708#    subu $sp,4
16712#    sw $ra,($sp)
    
    # get hash value
16716#    lw $t2,-12($s2) # vtable address
16720#    lw $t0,($t2) # method address
16724#    jalr $t0
16728#    subu $sp,8 # push result (int in $t0) on stack
16732#    sw $s5,4($sp)
16736#    sw $t0,($sp)

    # compute print-size of hash value
16740#    li $t0, 1
16744#    lw $t1, ($sp)
16748#    srl $t1,$t1,4
16752#    beq $t1,$zero,toString_skip_loop
16756:toString_loop_top:
16756#    addu $t0,1
16760#    srl $t1,$t1,4
16764#    bne $t1,$zero,toString_loop_top
16768:toString_skip_loop:
16768#    subu $sp,8
16772#    sw $s5,4($sp)
16776#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
16780#    lw $t2,-12($s2) # vtable address
16784#    move $t0,$t2
16788:toString_checkTagBit:
16788#    subu $t0,1
16792#    lb $t1,($t0)
16796#    and $t1,0x80
16797##...lui $at,0
16801##...ori $at,$at,0x80
16805##...and $t1,$t1,$at
16808#    beq $t1,$zero,toString_checkTagBit
16812#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
16816#    subu $sp,8
16820#    sw $t1,($sp)
16824#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
16828#    move $s7,$zero # -4 offset header word
16832#    lw $t4,8($sp) # bytes for hash value
16836#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
16840#    addu $t4,8
16844#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
16848#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

16852#    li $t0,CLASS_String # store string vtable address into ...
16856#    sw $t0,-12($s7) # ... -12 offset in object header
16860#    lw $t2,-12($s2) # our object's vtable address
16864#    lw $t5,4($sp) # number characters in prefix
16868#    lw $t1,12($sp) # number of characters in hashcode
16872#    addu $t3,$t1,$t5 # number of characters in string ...
16876#    addu $t3,1 # ... including the '@' character
16880#    subu $t0,$zero,$t3 # store negated length into ...
16884#    sw $t0,-4($s7) # ... -4 offset header word
16888#    lw $t0,-8($s7) # get -8 offset header-word
16892#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
16893##...slt $at,$t0,$zero
16897##...beq $at,$zero,16916
16900#    and $t0,0xff # mask off object's hash value ...
16901##...lui $at,0
16905##...ori $at,$at,0xff
16909##...and $t0,$t0,$at
16912#    sw $t0,-8($s7) # ... and store back into -8 header-word
16916:skipMask_toString:
16916#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
16920#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
16924#    subu $t4,$t2,$t5
16928:toString_copyLoop:    
16928#    lb $t3,($t4)
16932#    and $t3,0x7f # mask off sign bit (in case first word)
16933##...lui $at,0
16937##...ori $at,$at,0x7f
16941##...and $t3,$t3,$at
16944#    sb $t3,-8($t0)
16948#    addu $t4,1
16952#    addu $t0,1
16956#    blt $t4,$t2,toString_copyLoop
16957##...slt $at,$t4,$t2
16961##...bne $at,$zero,16928

    # copy the '@' sign
16964#    li $t3,'@'
16968#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
16972#    addu $t2,$t0,$t1 # address of last byte in string to store +8
16976#    lw $t3,20($sp) # hash code to print
16980:toString_hashCopyLoop:
16980#    and $t4,$t3,0xf
16984#    srl $t3,4
16988#    lb $t4,hexChars($t4)
16992#    sb $t4,-8($t2)
16996#    subu $t2,$t2,1
17000#    bgt $t2,$t0,toString_hashCopyLoop
17001##...slt $at,$t0,$t2
17005##...bne $at,$zero,16980

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
17008#    addu $sp,28
17012#    lw $ra,($sp)
17016#    addu $sp,4
17020#    move $t0, $s7 # return string we created
17024#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
17028:mth_equals_String:
    
    # quick test for obvious false
17028#    lw $t0,($sp) # second parameter
