5381##...beq $at,$zero,5428
5384#    lw $t1,prevHashConstant
5388#    addu $t1,0x12b68fd2
5389##...lui $at,4791
5393##...addiu $at,$at,-28718
5397##...addu $t1,$at,$t1
5400#    sw $t1,prevHashConstant # update hash constant
5404#    or $t1,0x80000000 # set top bit
5405##...lui $at,32768
5409##...or $t1,$at,$t1
5412#    and $t1,0xffffff00 # clear low bit
5413##...lui $at,65535
5417##...ori $at,$at,0xff00
5421##...and $t1,$t1,$at
5424#    or $s6,$t1
5428:firstHeaderLarge:
5428#    sw $s6,-8($t0) # store header-1 value
5432#    lw $zero,-8($t0)

    # store second header-value
5436#    sw $s7,-4($t0)   # second header-word
5440#    lw $zero,-4($t0)
    
    # put return-value into $s7 and also push it onto top of stack
5444#    move $s7,$t0
5448#    subu $sp,$sp,4
5452#    sw $t0,($sp)
