########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
4888:vm_init:

    # mark bottom of stack
4888#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
4892#    move $s2,$zero

    #set up the "five" register
4896#    li $s5,5

4900#    la $s3,seg0_start
4904#    la $s4,seg0_end
4905##...lui $s4,16
4909##...addiu $s4,$s4,5768
    
    # return
4912#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4916:divide:
    # get parameters; abort if divisor zero
4916#    lw $t0,($sp)
4920#    lw $t1,8($sp)
4924#    beq $t0,$zero,divByZeroError
    
    # perform division
4928#    div $t1,$t0
4932#    mflo $t0

    # store result, adjust stack and return
4936#    addu $sp,$sp,8 # adjust stack
4940#    sw $t0,($sp) # store result
4944#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4948:remainder:
    # get parameters; abort if divisor zero
4948#    lw $t0,($sp)
4952#    lw $t1,8($sp)
4956#    beq $t0,$zero,divByZeroError
    
    # perform division
4960#    div $t1,$t0
4964#    mfhi $t0

    # store result, adjust stack and return
4968#    addu $sp,$sp,8 # adjust stack
4972#    sw $t0,($sp) # store result
4976#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
4980:checkCast:
    # get object, allow immediately if null
4980#    lw $t2,($sp)
4984#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
4988#    lw $t2,-12($t2) # vtable address
4992#    bge $t2,$t1,castException
4993##...slt $at,$t2,$t1
4997##...beq $at,$zero,5132
5000#    blt $t2,$t0,castException
5001##...slt $at,$t2,$t0
5005##...bne $at,$zero,5132
    
    # return, leaving object unchanged on stack
5008:  checkCastReturn:    
5008#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
5012:instanceOf:
    # get object, go return false if null
5012#    lw $t2,($sp)
5016#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
5020#    lw $t2,-12($t2) # vtable address
5024#    sge $t0,$t2,$t0 # are we >= the lower limit?
5025##...slt $t0,$t2,$t0
5029##...xori $t0,$t0,0x1
5032#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
5036#    and $t2,$t0,$t1
5040#    sw $t2,($sp)
5044:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
5044#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

5048:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
5048#    li $v0,4 # syscall-code for print-string
5052#    syscall
5056:exit:
    # print termination message
5056#    li $v0,4 # syscall-code for print-string
5060#    la $a0,exitString
5064#    syscall

    # terminate execution
5068#    li $v0,10 #syscall-code for "exit"
5072#    syscall

5076:outOfHeapMemory:
5076#    la $a0,heapMemoryMsg
5080#    j exitError
5084:divByZeroError:
5084#    la $a0,divByZeroMsg
5088#    j exitError
5092:strIndexOutOfBounds:
5092#    la $a0,strIndexOutOfBoundsMsg
5096#    j exitError
5100:arrayIndexOutOfBounds:
5100#    la $a0,arrayIndexOutOfBoundsMsg
5104#    j exitError
5108:arraySizeOutOfBounds:
5108#    la $a0,arraySizeOutOfBoundsMsg
5112#    j exitError
5116:nullPtrException:
5116#    la $a0,nullPtrExceptionMsg
5120#    j exitError
5124:badIntegerFormat:
5124#    la $a0,badIntegerFormatMsg
5128#    j exitError
5132:castException:
5132#    la $a0,castExceptionMsg
5136#    j exitError
############## data section ################
    .data
5404:hexChars:
    .ascii "0123456789abcdef"
    .align 2
5420:cur_seg:
    .word 0

5424:lastCharRead:
    .word -2 # -2 => no buffered character
5428:prevHashConstant:
    .word 0x2785173c
5432:gcCount:
    .word 0

5436:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
5463:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
5486:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
5521:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
5555:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
5588:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
5619:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
5667:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
5688:gcMsg: 
      .asciiz "\nGC!\n"
5694:gcCountMsg: 
      .asciiz "Number of garbage collections: "

5726:nullStr:
    .asciiz "null"
5731:trueString:
    .asciiz "true"
5736:falseString:
    .asciiz "false"
5742:exitString:
    .ascii "Program terminated."
    #### "falls through" here
5761:newlineString:
    .asciiz "\n"
    
    .align 2
5764:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

5768:seg0_start:
    .space 0x100000
1054344:seg0_end:
1054344:seg1_start:
    .space 0x100000
2102920:seg1_end:
