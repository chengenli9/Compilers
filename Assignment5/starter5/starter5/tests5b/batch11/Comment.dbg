###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
2720:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
2720#    lw $t0,-8($s2) # get word with hash bits from this
2724#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
2728#    addu $t0,$t1

2732#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
2736:mth_equals_Object:
2736#    move $t0,$s2 # first pointer (this)
2740#    lw $t1,($sp) # second pointer
2744#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
2745##...subu $at,$t0,$t1
2749##...sltiu $t0,$at,1

2752#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
2756:mth_hashCode_String:
2756#    move $t0,$s2 # put this pointer in t0

2760#    li $t2,0 # current hash value
2764#    lw $t1,-4($t0) # negative of number of characters in string
2768#    beq $t1,$zero,done_hashCode_String # if zero length => done
2772#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
2776#    and $t0,0xfffffffc # adjust for padding
2777##...lui $at,65535
2781##...ori $at,$at,0xfffc
2785##...and $t0,$t0,$at
2788#    subu $t1,$t0,$t1 # address at end of string +12
2792:loop_hashCode_String:    
2792#    sll $t4,$t2,5 # multiply by 32
2796#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
2800#    lbu $t3,-12($t0) # current character
2804#    addu $t2,$t3 # add in current character
2808#    addu $t0,1 # go to next character's address
2812#    bne $t0,$t1,loop_hashCode_String # loop back if more
2816:done_hashCode_String:    

    # push int on stack
2816#    move $t0, $t2 # put $t2 in return slot
2820#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
2824:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
2824#    subu $sp,4
2828#    sw $ra,($sp)
    
    # get hash value
2832#    lw $t2,-12($s2) # vtable address
2836#    lw $t0,($t2) # method address
2840#    jalr $t0
2844#    subu $sp,8 # push result (int in $t0) on stack
2848#    sw $s5,4($sp)
2852#    sw $t0,($sp)

    # compute print-size of hash value
2856#    li $t0, 1
2860#    lw $t1, ($sp)
2864#    srl $t1,$t1,4
2868#    beq $t1,$zero,toString_skip_loop
2872:toString_loop_top:
2872#    addu $t0,1
2876#    srl $t1,$t1,4
2880#    bne $t1,$zero,toString_loop_top
2884:toString_skip_loop:
2884#    subu $sp,8
2888#    sw $s5,4($sp)
2892#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
2896#    lw $t2,-12($s2) # vtable address
2900#    move $t0,$t2
2904:toString_checkTagBit:
2904#    subu $t0,1
2908#    lb $t1,($t0)
2912#    and $t1,0x80
2913##...lui $at,0
2917##...ori $at,$at,0x80
2921##...and $t1,$t1,$at
2924#    beq $t1,$zero,toString_checkTagBit
2928#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
2932#    subu $sp,8
2936#    sw $t1,($sp)
2940#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
2944#    move $s7,$zero # -4 offset header word
2948#    lw $t4,8($sp) # bytes for hash value
2952#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
2956#    addu $t4,8
2960#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
2964#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

2968#    li $t0,CLASS_String # store string vtable address into ...
2972#    sw $t0,-12($s7) # ... -12 offset in object header
2976#    lw $t2,-12($s2) # our object's vtable address
2980#    lw $t5,4($sp) # number characters in prefix
2984#    lw $t1,12($sp) # number of characters in hashcode
2988#    addu $t3,$t1,$t5 # number of characters in string ...
2992#    addu $t3,1 # ... including the '@' character
2996#    subu $t0,$zero,$t3 # store negated length into ...
3000#    sw $t0,-4($s7) # ... -4 offset header word
3004#    lw $t0,-8($s7) # get -8 offset header-word
3008#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
3009##...slt $at,$t0,$zero
3013##...beq $at,$zero,3032
3016#    and $t0,0xff # mask off object's hash value ...
3017##...lui $at,0
3021##...ori $at,$at,0xff
3025##...and $t0,$t0,$at
3028#    sw $t0,-8($s7) # ... and store back into -8 header-word
3032:skipMask_toString:
3032#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
3036#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
3040#    subu $t4,$t2,$t5
3044:toString_copyLoop:    
3044#    lb $t3,($t4)
3048#    and $t3,0x7f # mask off sign bit (in case first word)
3049##...lui $at,0
3053##...ori $at,$at,0x7f
3057##...and $t3,$t3,$at
3060#    sb $t3,-8($t0)
3064#    addu $t4,1
3068#    addu $t0,1
3072#    blt $t4,$t2,toString_copyLoop
3073##...slt $at,$t4,$t2
3077##...bne $at,$zero,3044

    # copy the '@' sign
3080#    li $t3,'@'
3084#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
3088#    addu $t2,$t0,$t1 # address of last byte in string to store +8
3092#    lw $t3,20($sp) # hash code to print
3096:toString_hashCopyLoop:
3096#    and $t4,$t3,0xf
3100#    srl $t3,4
3104#    lb $t4,hexChars($t4)
3108#    sb $t4,-8($t2)
3112#    subu $t2,$t2,1
3116#    bgt $t2,$t0,toString_hashCopyLoop
3117##...slt $at,$t0,$t2
3121##...bne $at,$zero,3096

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
3124#    addu $sp,28
3128#    lw $ra,($sp)
3132#    addu $sp,4
3136#    move $t0, $s7 # return string we created
3140#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
3144:mth_equals_String:
    
    # quick test for obvious false
3144#    lw $t0,($sp) # second parameter
3148#    beq $t0,$zero,goEsFalse # go return false if null
3152#    lw $t1,-12($t0) # vtable pointer
3156#    la $t2,CLASS_String # string vtable pointer
3160#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
3164#    subu $sp,12
3168#    sw $ra,8($sp)
3172#    sw $s2,4($sp)
3176#    sw $t0,($sp)
3180#    jal mth_compareTo_String
3184#    lw $s2, 4($sp) #restore this pointer and pop parameters
3188#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
3192#    seq $t0,$t0,$zero
3193##...subu $at,$t0,$zero
3197##...sltiu $t0,$at,1

    # pop return address and return $t0
3200#    lw $ra,($sp)
3204#    addu $sp,4

3208#    jr $ra # return
    
3212:goEsFalse:
    # put 0 in $t0 and return
3212#    li $t0, 0
3216#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
3220:mth_toString_String:
    #we are a string, so return this.
3220#    move $t0, $s2
3224#    jr $ra

###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
3228:mth_readLine_Lib:
    
3228#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
3232#    sw $ra, 4($sp) # save $ra
3236#    move $t1,$sp # save "original" sp

3240:  doRead:

    # read the character
3240#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
3244#    subu $t2,$v0,13
3248#    bne $t2,$zero,notReturnRL
3252#    jal readLogicalChar
3256#    subu $t2,$v0,10 # check for newline
3260#    beq $t2,$zero,foundNewLine
3264#    sw $v0,lastCharRead # push back character into queue
3268#    j foundNewLine # go process the line

3272:  notReturnRL:

    # at this point, $v0 has our character

3272#    subu $t0,$v0,10
3276#    beq $t0,$zero,foundNewLine
3280#    blt $v0,$zero,foundEof
3281##...slt $at,$v0,$zero
3285##...bne $at,$zero,3300

    # we have a character, so push it onto stack
3288#    subu $sp,$sp,4
3292#    sw $v0,($sp)

    # loop back up to get next character
3296#    j doRead

3300:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
3300#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
3304#    li $s7, 0 # return-value: null
3308#    j rlReturn # return

3312:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
3312#    subu $t0,$t1,$sp # number of chars we read (times 4)
3316#    srl $s6,$t0,2 # number of words on stack with chars
3320#    subu $sp,$sp,4 # push char-count ...
3324#    sw $s6,($sp) # ... onto stack
3328#    addu $t2,$t0,5 # GC tag, incl. for count-word
3332#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
3336#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
3340#    srl $s6,$s6,2  # data words in object
3344#    move $s7,$zero # object words in object
3348#    jal newObject  # allocate space
    
    # store header words
3352#    la $t0,CLASS_String
3356#    sw $t0,-12($s7)# store class tag (String) into object
3360#    lw $t2,4($sp) # char-count
3364#    sll $t1,$t2,2 # 4 times number of chars
3368#    subu $t2,$zero,$t2 # negative of char-count
3372#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
3376#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
3380#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
