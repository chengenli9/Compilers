3108#    lw $t0,($sp) # second string
3112#    beq $t0,$zero,nullPtrException
3116#    move $t1,$s2 # first string
    
    # get (negatives of) respective byte-lengths
3120#    lw $t2,-4($t0) # negative length of second string
3124#    lw $t3,-4($t1) # negative length of first string

