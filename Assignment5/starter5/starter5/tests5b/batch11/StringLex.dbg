.text
.globl main
0:main:
0#  jal vm_init
4#  li $s6, 1
8#  li $s7, 0
12#  jal newObject
16#  la $t0, CLASS_Main
20#  sw $t0, -12($s7)
24#  addu $sp, $sp, 4
28#  move $s2, $s7
32#  jal mth_main_Main
36#  li $v0, 10
40#  syscall
.globl mth_main_Main
44:mth_main_Main:
44#  subu $sp, $sp, 4
48#  sw $ra, ($sp)
52#  li $s6, 1
56#  li $s7, 0
60#  jal newObject
64#  la $t0, CLASS_Lib
68#  sw $t0, -12($s7)
