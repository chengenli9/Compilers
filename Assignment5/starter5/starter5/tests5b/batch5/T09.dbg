3041##...lui $at,0
3045##...ori $at,$at,0xff
3049##...and $t2,$t2,$at
    #### OLD
    #### subu $t2,$zero,$t2 # set to 1 if -1 (number of data words)

3052:  gcSkip2:
3052#    sll $t2,$t2,2
