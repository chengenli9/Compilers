########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
4516:vm_init:

    # mark bottom of stack
4516#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
4520#    move $s2,$zero

    #set up the "five" register
4524#    li $s5,5

4528#    la $s3,seg0_start
4532#    la $s4,seg0_end
4533##...lui $s4,16
4537##...addiu $s4,$s4,5568
    
    # return
4540#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4544:divide:
    # get parameters; abort if divisor zero
4544#    lw $t0,($sp)
4548#    lw $t1,8($sp)
4552#    beq $t0,$zero,divByZeroError
    
    # perform division
4556#    div $t1,$t0
4560#    mflo $t0

    # store result, adjust stack and return
4564#    addu $sp,$sp,8 # adjust stack
4568#    sw $t0,($sp) # store result
4572#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4576:remainder:
    # get parameters; abort if divisor zero
4576#    lw $t0,($sp)
4580#    lw $t1,8($sp)
4584#    beq $t0,$zero,divByZeroError
    
    # perform division
4588#    div $t1,$t0
4592#    mfhi $t0

    # store result, adjust stack and return
4596#    addu $sp,$sp,8 # adjust stack
4600#    sw $t0,($sp) # store result
4604#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
4608:checkCast:
    # get object, allow immediately if null
4608#    lw $t2,($sp)
4612#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
4616#    lw $t2,-12($t2) # vtable address
4620#    bge $t2,$t1,castException
4621##...slt $at,$t2,$t1
4625##...beq $at,$zero,4760
4628#    blt $t2,$t0,castException
4629##...slt $at,$t2,$t0
4633##...bne $at,$zero,4760
    
    # return, leaving object unchanged on stack
4636:  checkCastReturn:    
4636#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
4640:instanceOf:
    # get object, go return false if null
4640#    lw $t2,($sp)
4644#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
4648#    lw $t2,-12($t2) # vtable address
4652#    sge $t0,$t2,$t0 # are we >= the lower limit?
4653##...slt $t0,$t2,$t0
4657##...xori $t0,$t0,0x1
4660#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
4664#    and $t2,$t0,$t1
4668#    sw $t2,($sp)
4672:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
4672#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

4676:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
4676#    li $v0,4 # syscall-code for print-string
4680#    syscall
4684:exit:
    # print termination message
4684#    li $v0,4 # syscall-code for print-string
4688#    la $a0,exitString
4692#    syscall

    # terminate execution
4696#    li $v0,10 #syscall-code for "exit"
4700#    syscall

4704:outOfHeapMemory:
4704#    la $a0,heapMemoryMsg
4708#    j exitError
4712:divByZeroError:
4712#    la $a0,divByZeroMsg
4716#    j exitError
4720:strIndexOutOfBounds:
4720#    la $a0,strIndexOutOfBoundsMsg
4724#    j exitError
4728:arrayIndexOutOfBounds:
4728#    la $a0,arrayIndexOutOfBoundsMsg
4732#    j exitError
4736:arraySizeOutOfBounds:
4736#    la $a0,arraySizeOutOfBoundsMsg
4740#    j exitError
4744:nullPtrException:
4744#    la $a0,nullPtrExceptionMsg
4748#    j exitError
4752:badIntegerFormat:
4752#    la $a0,badIntegerFormatMsg
4756#    j exitError
4760:castException:
4760#    la $a0,castExceptionMsg
4764#    j exitError
############## data section ################
    .data
5204:hexChars:
    .ascii "0123456789abcdef"
    .align 2
5220:cur_seg:
    .word 0

5224:lastCharRead:
    .word -2 # -2 => no buffered character
5228:prevHashConstant:
    .word 0x2785173c
5232:gcCount:
    .word 0

5236:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
5263:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
5286:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
5321:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
5355:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
5388:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
5419:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
5467:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
5488:gcMsg: 
      .asciiz "\nGC!\n"
5494:gcCountMsg: 
      .asciiz "Number of garbage collections: "

5526:nullStr:
    .asciiz "null"
5531:trueString:
    .asciiz "true"
5536:falseString:
    .asciiz "false"
5542:exitString:
    .ascii "Program terminated."
    #### "falls through" here
5561:newlineString:
    .asciiz "\n"
    
    .align 2
5564:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

5568:seg0_start:
    .space 0x100000
1054144:seg0_end:
1054144:seg1_start:
    .space 0x100000
2102720:seg1_end:
