6312#    sll $t2,$t2,2 # # data bytes
6316#    addu $t2,$t2,8 # to skip header words
6320#    addu $t2,$t0,$t2 # pointer to new object
6324#    lw $t3,-8($t2) # word to swap
6328#    sw $t1,-8($t2) # store header word
6332#    sw $t3,($t0) # restore first word of object

    ################################################
    # at this point:
    # - $t2 contains the pointer to our new object
    ################################################

    # check if we have a data array
6336#    lw $t1,-12($t2) # vtable pointer
