    # greater
2148#    slt $t5,$t4,$t3 # 1 if str2 > str1, else 0
2152#    sll $t5,$t5,1 # 2 if str2 > str1, else 0
2156#    subu $t5,$t5,1 # 1 if str2 > str1, else -1
2160:  cmpHitLimitzz:
2160#    move $t0, $t5 # store return value
2164#    jr $ra # return
