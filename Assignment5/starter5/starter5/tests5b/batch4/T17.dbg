###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
11900:mth_readLine_Lib:
    
11900#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
11904#    sw $ra, 4($sp) # save $ra
11908#    move $t1,$sp # save "original" sp

11912:  doRead:

    # read the character
11912#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
11916#    subu $t2,$v0,13
11920#    bne $t2,$zero,notReturnRL
11924#    jal readLogicalChar
11928#    subu $t2,$v0,10 # check for newline
11932#    beq $t2,$zero,foundNewLine
11936#    sw $v0,lastCharRead # push back character into queue
11940#    j foundNewLine # go process the line

11944:  notReturnRL:

    # at this point, $v0 has our character

11944#    subu $t0,$v0,10
11948#    beq $t0,$zero,foundNewLine
11952#    blt $v0,$zero,foundEof
11953##...slt $at,$v0,$zero
11957##...bne $at,$zero,11972

    # we have a character, so push it onto stack
11960#    subu $sp,$sp,4
11964#    sw $v0,($sp)

    # loop back up to get next character
11968#    j doRead

11972:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
11972#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
11976#    li $s7, 0 # return-value: null
11980#    j rlReturn # return

11984:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
11984#    subu $t0,$t1,$sp # number of chars we read (times 4)
11988#    srl $s6,$t0,2 # number of words on stack with chars
11992#    subu $sp,$sp,4 # push char-count ...
11996#    sw $s6,($sp) # ... onto stack
12000#    addu $t2,$t0,5 # GC tag, incl. for count-word
12004#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
12008#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
12012#    srl $s6,$s6,2  # data words in object
12016#    move $s7,$zero # object words in object
12020#    jal newObject  # allocate space
    
    # store header words
12024#    la $t0,CLASS_String
12028#    sw $t0,-12($s7)# store class tag (String) into object
12032#    lw $t2,4($sp) # char-count
12036#    sll $t1,$t2,2 # 4 times number of chars
12040#    subu $t2,$zero,$t2 # negative of char-count
12044#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
12048#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
12052#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
12053##...slt $at,$t0,$zero
12057##...beq $at,$zero,12076
12060#    and $t0,0xff # mask off object's hash value ...
12061##...lui $at,0
12065##...ori $at,$at,0xff
12069##...and $t0,$t0,$at
12072#    sw $t0,-8($s7) # ... and store back into -8 header-word
12076:  skipMask_readLine:

12076#    sll $t0,$t0,2 # data bytes in object
12080#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
12084#    subu $t0,$t0,$t2 # place to store last character (plus 9)
12088#    addu $sp,$sp,8 # pop redundant object-pointer and count
12092#    addu $t1,$t1,$sp # first non-char spot on stack
