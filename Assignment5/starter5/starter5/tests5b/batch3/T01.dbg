########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
4900:vm_init:

    # mark bottom of stack
4900#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
4904#    move $s2,$zero

    #set up the "five" register
4908#    li $s5,5

4912#    la $s3,seg0_start
4916#    la $s4,seg0_end
4917##...lui $s4,16
4921##...addiu $s4,$s4,5876
    
    # return
4924#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4928:divide:
    # get parameters; abort if divisor zero
4928#    lw $t0,($sp)
4932#    lw $t1,8($sp)
4936#    beq $t0,$zero,divByZeroError
    
    # perform division
4940#    div $t1,$t0
4944#    mflo $t0

    # store result, adjust stack and return
4948#    addu $sp,$sp,8 # adjust stack
4952#    sw $t0,($sp) # store result
4956#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4960:remainder:
    # get parameters; abort if divisor zero
4960#    lw $t0,($sp)
4964#    lw $t1,8($sp)
4968#    beq $t0,$zero,divByZeroError
    
    # perform division
4972#    div $t1,$t0
4976#    mfhi $t0

    # store result, adjust stack and return
4980#    addu $sp,$sp,8 # adjust stack
4984#    sw $t0,($sp) # store result
4988#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
4992:checkCast:
    # get object, allow immediately if null
4992#    lw $t2,($sp)
4996#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
5000#    lw $t2,-12($t2) # vtable address
5004#    bge $t2,$t1,castException
5005##...slt $at,$t2,$t1
5009##...beq $at,$zero,5180
5012#    blt $t2,$t0,castException
5013##...slt $at,$t2,$t0
5017##...bne $at,$zero,5180
    
    # return, leaving object unchanged on stack
5020:  checkCastReturn:    
5020#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
5024:instanceOf:
    # get object, go return false if null
5024#    lw $t2,($sp)
5028#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
5032#    lw $t2,-12($t2) # vtable address
5036#    sge $t0,$t2,$t0 # are we >= the lower limit?
5037##...slt $t0,$t2,$t0
5041##...xori $t0,$t0,0x1
5044#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
5048#    and $t2,$t0,$t1
5052#    sw $t2,($sp)
5056:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
5056#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

5060:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
5060#    li $v0,4 # syscall-code for print-string
5064#    syscall
5068:exit:
    # print termination message
5068#    li $v0,4 # syscall-code for print-string
5072#    la $a0,exitString
5076#    syscall

    # print number of garbage collections
5080#    li $v0,4 # syscall-code for print-string
5084#    la $a0,gcCountMsg
5088#    syscall # print "Number of ..."
5092#    lw $a0,gcCount # number of GC's
5096#    li $v0,1 # code for print-int
5100#    syscall
5104#    li $v0,4 # syscall-code for print-string
5108#    la $a0,newlineString
5112#    syscall # print newline

    # terminate execution
5116#    li $v0,10 #syscall-code for "exit"
5120#    syscall

5124:outOfHeapMemory:
5124#    la $a0,heapMemoryMsg
5128#    j exitError
5132:divByZeroError:
5132#    la $a0,divByZeroMsg
5136#    j exitError
5140:strIndexOutOfBounds:
5140#    la $a0,strIndexOutOfBoundsMsg
5144#    j exitError
5148:arrayIndexOutOfBounds:
5148#    la $a0,arrayIndexOutOfBoundsMsg
5152#    j exitError
5156:arraySizeOutOfBounds:
5156#    la $a0,arraySizeOutOfBoundsMsg
5160#    j exitError
5164:nullPtrException:
5164#    la $a0,nullPtrExceptionMsg
5168#    j exitError
5172:badIntegerFormat:
5172#    la $a0,badIntegerFormatMsg
5176#    j exitError
5180:castException:
5180#    la $a0,castExceptionMsg
5184#    j exitError
############## data section ################
    .data
5504:hexChars:
    .ascii "0123456789abcdef"
    .align 2
5520:cur_seg:
    .word 0

5524:lastCharRead:
    .word -2 # -2 => no buffered character
5528:prevHashConstant:
    .word 0x2785173c
5532:gcCount:
    .word 0

5536:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
5563:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
5586:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
5621:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
5655:arraySizeOutOfBoundsMsg:
