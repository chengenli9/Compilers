1132#  la $t0, strLit_94
1136#  subu $sp, $sp, 4
1140#  sw $t0, ($sp)
1144#  lw $t0, 4($sp)
1148#  sw $s2, 4($sp)
1152#  move $s2, $t0
1156#  jal mth_printStr_Lib
1160#  addu $sp, $sp, 4
1164#  lw $s2, ($sp)
1168#  addu $sp, $sp, 4
1172#  subu $sp, $sp, 4
1176#  sw $t0, ($sp)
1180#  lw $t0, ($sp)
