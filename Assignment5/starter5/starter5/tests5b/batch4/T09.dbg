3913##...slt $at,$zero,$t0
3917##...bne $at,$zero,3960
3920#    beq $t0,$zero,riSkipWhiteLoop # start over if space
3924#    subu $t0,$v0,10
3928#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
3932#    subu $t0,$v0,9
3936#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
3940#    subu $t0,$v0,13
3944#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
3948#    subu $t0,$v0,12
3952#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
3956#    j badIntegerFormat # illegal integer char: abort program

3960:  nonWhite:
3960#    subu $t0,$v0,'-'
3964#    li $t4,1 # final multiplier
3968#    bne $t0,$zero,helpReadInt # go read
3972#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
3976#    jal readLogicalChar

3980:  helpReadInt:
3980#    li $t2,10
3984#    subu $t1,$v0,'0' # convert digit to 0-9 value
3988#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
3989##...sltu $at,$t1,$t2
3993##...beq $at,$zero,6240
3996#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

4000:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

4000#    jal readLogicalChar # read next character
4004#    subu $t1,$v0,'0' # convert digit to 0-9 value
4008#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
4009##...sltu $at,$t1,$t2
4013##...beq $at,$zero,4032

4016#    mul $t3,$t3,$t2 # multiply old value by 10
4017##...mult $t3,$t2
4021##...mflo $t3
4024#    addu $t3,$t3,$t1 # add in value of new digit
4028#    j digitLoop

4032:  doneDigitLoop:

    # "push back" unused character into queue
4032#    sw $v0,lastCharRead
