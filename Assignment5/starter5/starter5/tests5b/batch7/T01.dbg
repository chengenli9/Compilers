# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
2544:mth_readLine_Lib:
    
2544#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
2548#    sw $ra, 4($sp) # save $ra
2552#    move $t1,$sp # save "original" sp

2556:  doRead:

    # read the character
2556#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
2560#    subu $t2,$v0,13
2564#    bne $t2,$zero,notReturnRL
2568#    jal readLogicalChar
2572#    subu $t2,$v0,10 # check for newline
2576#    beq $t2,$zero,foundNewLine
2580#    sw $v0,lastCharRead # push back character into queue
2584#    j foundNewLine # go process the line

2588:  notReturnRL:

    # at this point, $v0 has our character

2588#    subu $t0,$v0,10
2592#    beq $t0,$zero,foundNewLine
2596#    blt $v0,$zero,foundEof
2597##...slt $at,$v0,$zero
2601##...bne $at,$zero,2616

    # we have a character, so push it onto stack
2604#    subu $sp,$sp,4
2608#    sw $v0,($sp)

    # loop back up to get next character
2612#    j doRead

2616:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
2616#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
2620#    li $s7, 0 # return-value: null
2624#    j rlReturn # return

2628:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
2628#    subu $t0,$t1,$sp # number of chars we read (times 4)
2632#    srl $s6,$t0,2 # number of words on stack with chars
2636#    subu $sp,$sp,4 # push char-count ...
2640#    sw $s6,($sp) # ... onto stack
2644#    addu $t2,$t0,5 # GC tag, incl. for count-word
2648#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
2652#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
2656#    srl $s6,$s6,2  # data words in object
2660#    move $s7,$zero # object words in object
2664#    jal newObject  # allocate space
    
    # store header words
2668#    la $t0,CLASS_String
2672#    sw $t0,-12($s7)# store class tag (String) into object
2676#    lw $t2,4($sp) # char-count
2680#    sll $t1,$t2,2 # 4 times number of chars
2684#    subu $t2,$zero,$t2 # negative of char-count
2688#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
2692#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
2696#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
2697##...slt $at,$t0,$zero
2701##...beq $at,$zero,2720
2704#    and $t0,0xff # mask off object's hash value ...
2705##...lui $at,0
2709##...ori $at,$at,0xff
2713##...and $t0,$t0,$at
2716#    sw $t0,-8($s7) # ... and store back into -8 header-word
2720:  skipMask_readLine:

2720#    sll $t0,$t0,2 # data bytes in object
2724#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
2728#    subu $t0,$t0,$t2 # place to store last character (plus 9)
2732#    addu $sp,$sp,8 # pop redundant object-pointer and count
2736#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

2740#    beq $sp,$t1,rlReturn
2744:  charCopyLoop:
2744#    lw $t2,($sp)
2748#    sb $t2,-9($t0)
2752#    addu $sp,$sp,4
2756#    subu $t0,$t0,1
2760#    bne $sp,$t1,charCopyLoop
2764:  rlReturn:

2764#    lw $ra, 4($sp)
2768#    addu $sp, 8   # pop $ra and pointless word off stack
2772#    move $t0, $s7 # return string we allocated in $s7
2776#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
2780:mth_readInt_Lib:

    # save $ra by pushing onto stack
2780#    subu $sp,$sp,4
2784#    sw $ra,($sp)

2788:  riSkipWhiteLoop:
    # read a character
2788#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
2792#    subu $t0,$v0,32
2796#    bgt $t0,$zero,nonWhite
2797##...slt $at,$zero,$t0
2801##...bne $at,$zero,2844
2804#    beq $t0,$zero,riSkipWhiteLoop # start over if space
2808#    subu $t0,$v0,10
2812#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
2816#    subu $t0,$v0,9
2820#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
2824#    subu $t0,$v0,13
2828#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
2832#    subu $t0,$v0,12
2836#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
2840#    j badIntegerFormat # illegal integer char: abort program

2844:  nonWhite:
2844#    subu $t0,$v0,'-'
2848#    li $t4,1 # final multiplier
2852#    bne $t0,$zero,helpReadInt # go read
2856#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
2860#    jal readLogicalChar

2864:  helpReadInt:
2864#    li $t2,10
2868#    subu $t1,$v0,'0' # convert digit to 0-9 value
2872#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
2873##...sltu $at,$t1,$t2
2877##...beq $at,$zero,5124
2880#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

2884:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

2884#    jal readLogicalChar # read next character
2888#    subu $t1,$v0,'0' # convert digit to 0-9 value
2892#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
2893##...sltu $at,$t1,$t2
2897##...beq $at,$zero,2916

2900#    mul $t3,$t3,$t2 # multiply old value by 10
2901##...mult $t3,$t2
2905##...mflo $t3
2908#    addu $t3,$t3,$t1 # add in value of new digit
2912#    j digitLoop

2916:  doneDigitLoop:

    # "push back" unused character into queue
2916#    sw $v0,lastCharRead

    # restore return address
2920#    lw $ra,($sp)
2924#    addu $sp, 4

    # multiply by sign and put return value in $t0
2928#    mult $t3,$t4 # multiply to account for poss. minus sign
2932#    mflo $t3
2936#    move $t0, $t3
    
    # return
2940#    jr $ra

###################################################################
# readChar() - library method (class Lib)
# - reads a single character from standard input
# - returns the integer that is the encoding of the character
# - returns -1 if end of file was encountered
# - parameter:
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
2944:mth_readChar_Lib:

    # save $ra by pushing onto stack
2944#    subu $sp,$sp,4
2948#    sw $ra,($sp)

      # read the character
2952#    jal readLogicalChar

    # restore return address; put value in $t0
    # replacing this-pointer saved return address
2956#    lw $ra,($sp)
2960#    addu $sp, 4
2964#    move $t0, $v0

    # return
2968#    jr $ra

########################################################
# printStr(str) - library method (class Lib)
# - prints string to standard output
# parameters:
#   - ($sp) - the string to print
#   - 4($sp) - old-this-pointer
########################################################
2972:mth_printStr_Lib:
    # check for null, printing "(null)", if so
2972#    lw $t0,($sp)
2976#    bne $t0,$zero,psNotNull

    # print "(null)"
2980#    la $a0,nullStr
2984#    li $v0,4
2988#    syscall
2992#    j donePrintStr
    
2996:  psNotNull:
    ##### we have a non-null string #####
    # this means that:
    # - number of data words in -8($t0):
    #   - if the sign bit is 1, the low 31 bits
    #   - if the sign bit is 0, the low 8 bits
    # - negative of number of characters in string is in -4($t0)
    # - string begins at $t0-8-(#dataWords*4), stored 1 char per byte
2996#    subu $t0,$t0,8
3000#    lw $t1,($t0) # number of data words, but needs modification
3004#    blt $t1,$zero,skipPrintStr1
3005##...slt $at,$t1,$zero
3009##...bne $at,$zero,3028
3012#    and $t1,0xff # mask out all but low byte
3013##...lui $at,0
3017##...ori $at,$at,0xff
3021##...and $t1,$t1,$at
3024#    b skipPrintStr2
3028:skipPrintStr1:
3028#    and $t1,0x7ffffff
3029##...lui $at,2047
3033##...ori $at,$at,0xffff
3037##...and $t1,$t1,$at
3040:skipPrintStr2:    
3040#    sll $t1,$t1,2
3044#    subu $t1,$t0,$t1 # first word in string
3048#    lw $t0,4($t0) # negative of string-length
3052#    subu $t0,$t1,$t0 # byte just beyond last char in string

    # print the chars in the string
3056#    beq $t0,$t1,donePrintStr
3060:  psLoop:
3060#    lb $a0,($t1) # next byte
3064#    li $v0,11 # code for printing char
3068#        syscall # print the char
3072#    addu $t1,$t1,1 # go to next char
3076#    blt $t1,$t0,psLoop
3077##...slt $at,$t1,$t0
3081##...bne $at,$zero,3060

3084:  donePrintStr:
3084#    jr $ra

########################################################
# printInt(n) - library method (class Lib)
# - prints integer in decimal format to standard output
# - parameters:
#   - ($sp) - the integer to print
#   - 4($sp) - GC tag
#   - ($sp) - old-this-pointer
########################################################
3088:mth_printInt_Lib:
3088#    lw $a0,($sp)

    # print it
3092#    li $v0,1 # code for print-int
3096#    syscall

    # return
3100#    jr $ra

########################################################
# printBool(n) - library method (class Lib)
# - prints boolean to standard output
# - parameters:
#   - ($sp) - the boolean to print
#   - 4($sp) - old-this-pointer
########################################################
3104:mth_printBool_Lib:
    # pop value off stack, along with 'this'
3104#    lw $t0,($sp)

    # print either 'true' or 'false', depending on the value
3108#    la $a0,falseString
3112#    beq $t0,$zero,skipPB
3116#    la $a0,trueString
3120:  skipPB:
3120#    li $v0,4 # code for print-string
3124#    syscall

    # return
3128#    jr $ra

########################################################
# str.substring(n, k) - library method (class String)
# takes a substring of a string: Java: str.substring(n, k)
# - parameters after pushing RA:
#   - ($sp) - k: one beyond index of last char in subrange
#   - 4($sp) - GC tag
#   - 8($sp) - n: index of first char in subrange
#   - 12($sp) - GC tag
#   - 16($sp) - old this pointer
# - return value:
#  - $t0 - substring
########################################################
3132:mth_substring_String:

    # save $ra by pushing onto stack
3132#    subu $sp,$sp,4
3136#    sw $ra,($sp)

    # get string from this, we probably don't need the null check.
3140#    move $t0,$s2
3144#    beq $t0,$zero,nullPtrException

    # get both indices and string length, and ensure that
    #   0 <= n <= k <= length
3148#    lw $t0,-4($t0) # negative of string length
3152#    subu $t0,$zero,$t0 # string length
3156#    lw $t1,4($sp) # k
3160#    lw $t2,12($sp) # n
3164#    bgt $zero,$t2,strIndexOutOfBounds
3165##...slt $at,$t2,$zero
3169##...bne $at,$zero,5092
3172#    bgt $t2,$t1,strIndexOutOfBounds
3173##...slt $at,$t1,$t2
3177##...bne $at,$zero,5092
3180#    bgt $t1,$t0,strIndexOutOfBounds
3181##...slt $at,$t0,$t1
3185##...bne $at,$zero,5092

    # allocate memory
3188#    subu $s6,$t1,$t2 # # chars in target-string
3192#    addu $s6,$s6,7 # account for extra "class" (4) word + 3 to round up
3196#    srl $s6,$s6,2 # convert bytes-count to word-count
3200#    move $s7,$zero # (no object-bytes in string)
3204#    jal newObject

    # store "String" tag in object-type field
3208#    la $t0,CLASS_String
3212#    sw $t0,-12($s7)
    
    # mask off hash bits, if needed
3216#    lw $t4,-8($s7) # data words in source string
3220#    bge $t4,$zero,skipMask_substring # don't strip hash code if not there
3221##...slt $at,$t4,$zero
3225##...beq $at,$zero,3244
3228#    and $t4,0xff # mask off object's hash value ...
3229##...lui $at,0
3233##...ori $at,$at,0xff
3237##...and $t4,$t4,$at
3240#    sw $t4,-8($s7) # ... and store back into -8 header-word
3244:skipMask_substring:

    # store negative of count (=n-k) into object-length header-word
    # indicies have changed, because newObject is on stack
3244#    lw $t1,8($sp) # k
3248#    lw $t2,16($sp) # n
3252#    subu $t0,$t2,$t1 # value to store
3256#    sw $t0,-4($s7) # store value
    
3260#    move $t3,$s2 # source string pointer
    
    # skip byte-copy loop if length is zero
3264#    beq $zero,$t0,doneSubCopyzz

    # get pointers set up in preparation for copy
3268#    lw $t4,-8($t3) # data words in source string
3272#    sll $t4,$t4,2 # data bytes in source string (incl. padding)
3276#    subu $t3,$t3,$t4 # addr. of first data word of source string (+8)
3280#    addu $t3,$t3,$t2 # addr. of first source data byte to be copied (+8)
3284#    subu $t1,$t3,$t0 # addr. beyond last source data byte to be copied (+8)
3288#    lw $t2,-8($s7)   # data words in target string
3292#    sll $t2,$t2,2    # data bytes in target string
3296#    subu $t2,$s7,$t2 # addr. of first target data byte (+8)
    
    ############################################
    # at this point:
    # - we know that the string has a positive length
    # - $t3 contains 8 + address of the first source-byte
    # - $t1 contains 8 + limit-address of the first source-byte
    # - $t2 contains 8 + address first target byte
    ############################################

    # copy the bytes from source to target
3300:  subCopyLoopzz:
3300#    lb $t4,-8($t3)
3304#    sb $t4,-8($t2)
3308#    addu $t2,$t2,1
3312#    addu $t3,$t3,1
3316#    blt $t3,$t1,subCopyLoopzz
3317##...slt $at,$t3,$t1
3321##...bne $at,$zero,3300
    
3324:  doneSubCopyzz:
    # restore return address, store return value, pop stack
3324#    lw $ra,4($sp) # restore $ra
3328#    addu $sp,$sp,8 # pop ra, and allocated newObject
3332#    move $t0, $s7 # we're returning the string we got back
                  # from newObject
    
    # return
3336#    jr $ra

########################################################
# length() - library method (class String)
# returns length of a string: Java: str.length()
# - parameters:
#   - ($sp) - old this pointer
# - return-value:
#   - $t0 - length of string
########################################################
3340:mth_length_String:

    # the length is the negative of 4($s2)
3340#    lw $t0,-4($s2) # -length
3344#    subu $t0,$zero,$t0

    # return
3348#    jr $ra


########################################################
# str1.concat(str2) - library method (class String)
# (as in Java)
# - parameters:
#   - ($sp) - the second string
#   - 4($sp) - old this pointer
#   - $s2 - the first string (this)
# - returns:
#   - $t0 - pointer to concatenated string
########################################################
3352:mth_concat_String:
    # save $ra by pushing onto stack
3352#    subu $sp,$sp,4
3356#    sw $ra, ($sp)

    # get string pointers and check parameter for null
3360#    lw $t0,4($sp)
3364#    beq $t0,$zero,nullPtrException
3368#    move $t1,$s2
    
    # get lengths of two strings; allocate object whose size
    # is their sum divided by 4 (rounded up) plus 1
3372#    lw $t0,-4($t0) # negative size of second object
3376#    lw $t1,-4($t1) # negative size of first object
3380#    addu $s6,$t0,$t1 # sum of negative sizes
3384#    sra $s6,$s6,2 # negative word-size of char part
3388#    subu $s6,$zero,$s6 # word size of char part
3392#    addu $s6,$s6,1 # data word size, including v-table word
3396#    move $s7,$zero
3400#    jal newObject

    # store String vtable address in vtable address field
3404#    la $t0,CLASS_String
3408#    sw $t0,-12($s7)
        
    # mask off hash bits, if needed
3412#    lw $t4,-8($s7) # # data words in source string
3416#    bge $t4,$zero,skipMask_concat # don't strip hash code if not there
3417##...slt $at,$t4,$zero
3421##...beq $at,$zero,3440
3424#    and $t4,0xff # mask off object's hash value ...
3425##...lui $at,0
3429##...ori $at,$at,0xff
3433##...and $t4,$t4,$at
3436#    sw $t4,-8($s7) # ... and store back into -8 header-word
3440:skipMask_concat:

3440#    move $t9, $s7 # store return string in unused (I hope) t9 register

    #restore $t0, and $t1 after they were potentially blown
    #away by newObject
3444#    move $t1,$s2   # first object
3448#    lw $t0,8($sp) # second object
    
    # get negative sizes; sum and store in new object size-field
3452#    lw $t2,-4($t0) # negative length of second object
3456#    lw $t3,-4($t1) # negative length of first object
3460#    addu $t4,$t2,$t3 # sum of negative lengths
3464#    sw $t4,-4($s7) # store sum as negated target-string length

    #########################################################
