###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
1236:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
1236#    subu $sp,4
1240#    sw $ra,($sp)
    
    # get hash value
1244#    lw $t2,-12($s2) # vtable address
1248#    lw $t0,($t2) # method address
1252#    jalr $t0
1256#    subu $sp,8 # push result (int in $t0) on stack
1260#    sw $s5,4($sp)
1264#    sw $t0,($sp)

    # compute print-size of hash value
1268#    li $t0, 1
1272#    lw $t1, ($sp)
1276#    srl $t1,$t1,4
1280#    beq $t1,$zero,toString_skip_loop
1284:toString_loop_top:
1284#    addu $t0,1
1288#    srl $t1,$t1,4
1292#    bne $t1,$zero,toString_loop_top
1296:toString_skip_loop:
1296#    subu $sp,8
1300#    sw $s5,4($sp)
1304#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
1308#    lw $t2,-12($s2) # vtable address
1312#    move $t0,$t2
1316:toString_checkTagBit:
1316#    subu $t0,1
1320#    lb $t1,($t0)
1324#    and $t1,0x80
1325##...lui $at,0
1329##...ori $at,$at,0x80
1333##...and $t1,$t1,$at
1336#    beq $t1,$zero,toString_checkTagBit
1340#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
1344#    subu $sp,8
1348#    sw $t1,($sp)
1352#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
1356#    move $s7,$zero # -4 offset header word
1360#    lw $t4,8($sp) # bytes for hash value
1364#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
1368#    addu $t4,8
1372#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
1376#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

1380#    li $t0,CLASS_String # store string vtable address into ...
1384#    sw $t0,-12($s7) # ... -12 offset in object header
1388#    lw $t2,-12($s2) # our object's vtable address
1392#    lw $t5,4($sp) # number characters in prefix
1396#    lw $t1,12($sp) # number of characters in hashcode
1400#    addu $t3,$t1,$t5 # number of characters in string ...
1404#    addu $t3,1 # ... including the '@' character
1408#    subu $t0,$zero,$t3 # store negated length into ...
1412#    sw $t0,-4($s7) # ... -4 offset header word
1416#    lw $t0,-8($s7) # get -8 offset header-word
1420#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
1421##...slt $at,$t0,$zero
1425##...beq $at,$zero,1444
1428#    and $t0,0xff # mask off object's hash value ...
1429##...lui $at,0
1433##...ori $at,$at,0xff
1437##...and $t0,$t0,$at
1440#    sw $t0,-8($s7) # ... and store back into -8 header-word
1444:skipMask_toString:
1444#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
1448#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
1452#    subu $t4,$t2,$t5
1456:toString_copyLoop:    
1456#    lb $t3,($t4)
1460#    and $t3,0x7f # mask off sign bit (in case first word)
1461##...lui $at,0
1465##...ori $at,$at,0x7f
1469##...and $t3,$t3,$at
1472#    sb $t3,-8($t0)
1476#    addu $t4,1
1480#    addu $t0,1
1484#    blt $t4,$t2,toString_copyLoop
1485##...slt $at,$t4,$t2
1489##...bne $at,$zero,1456

    # copy the '@' sign
1492#    li $t3,'@'
1496#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
1500#    addu $t2,$t0,$t1 # address of last byte in string to store +8
1504#    lw $t3,20($sp) # hash code to print
1508:toString_hashCopyLoop:
1508#    and $t4,$t3,0xf
1512#    srl $t3,4
1516#    lb $t4,hexChars($t4)
1520#    sb $t4,-8($t2)
1524#    subu $t2,$t2,1
1528#    bgt $t2,$t0,toString_hashCopyLoop
1529##...slt $at,$t0,$t2
1533##...bne $at,$zero,1508

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
1536#    addu $sp,28
1540#    lw $ra,($sp)
1544#    addu $sp,4
1548#    move $t0, $s7 # return string we created
1552#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
1556:mth_equals_String:
    
    # quick test for obvious false
1556#    lw $t0,($sp) # second parameter
1560#    beq $t0,$zero,goEsFalse # go return false if null
1564#    lw $t1,-12($t0) # vtable pointer
1568#    la $t2,CLASS_String # string vtable pointer
1572#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
1576#    subu $sp,12
1580#    sw $ra,8($sp)
1584#    sw $s2,4($sp)
1588#    sw $t0,($sp)
1592#    jal mth_compareTo_String
1596#    lw $s2, 4($sp) #restore this pointer and pop parameters
1600#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
1604#    seq $t0,$t0,$zero
1605##...subu $at,$t0,$zero
1609##...sltiu $t0,$at,1

    # pop return address and return $t0
1612#    lw $ra,($sp)
1616#    addu $sp,4

1620#    jr $ra # return
    
1624:goEsFalse:
    # put 0 in $t0 and return
1624#    li $t0, 0
1628#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
