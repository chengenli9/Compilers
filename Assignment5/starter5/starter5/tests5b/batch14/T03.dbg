7500#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
7504:vm_init:

    # mark bottom of stack
7504#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
7508#    move $s2,$zero

    #set up the "five" register
7512#    li $s5,5

7516#    la $s3,seg0_start
7520#    la $s4,seg0_end
7521##...lui $s4,16
7525##...addiu $s4,$s4,8824
    
    # return
7528#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
7532:divide:
    # get parameters; abort if divisor zero
7532#    lw $t0,($sp)
7536#    lw $t1,8($sp)
7540#    beq $t0,$zero,divByZeroError
    
    # perform division
7544#    div $t1,$t0
7548#    mflo $t0

    # store result, adjust stack and return
7552#    addu $sp,$sp,8 # adjust stack
7556#    sw $t0,($sp) # store result
7560#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
7564:remainder:
    # get parameters; abort if divisor zero
7564#    lw $t0,($sp)
7568#    lw $t1,8($sp)
7572#    beq $t0,$zero,divByZeroError
    
    # perform division
7576#    div $t1,$t0
7580#    mfhi $t0

    # store result, adjust stack and return
7584#    addu $sp,$sp,8 # adjust stack
7588#    sw $t0,($sp) # store result
7592#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
7596:checkCast:
    # get object, allow immediately if null
7596#    lw $t2,($sp)
7600#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
7604#    lw $t2,-12($t2) # vtable address
7608#    bge $t2,$t1,castException
7609##...slt $at,$t2,$t1
7613##...beq $at,$zero,7784
7616#    blt $t2,$t0,castException
7617##...slt $at,$t2,$t0
7621##...bne $at,$zero,7784
    
    # return, leaving object unchanged on stack
7624:  checkCastReturn:    
7624#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
7628:instanceOf:
    # get object, go return false if null
7628#    lw $t2,($sp)
7632#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
7636#    lw $t2,-12($t2) # vtable address
7640#    sge $t0,$t2,$t0 # are we >= the lower limit?
7641##...slt $t0,$t2,$t0
7645##...xori $t0,$t0,0x1
7648#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
7652#    and $t2,$t0,$t1
7656#    sw $t2,($sp)
7660:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
7660#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

7664:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
7664#    li $v0,4 # syscall-code for print-string
7668#    syscall
7672:exit:
    # print termination message
7672#    li $v0,4 # syscall-code for print-string
7676#    la $a0,exitString
7680#    syscall

    # print number of garbage collections
7684#    li $v0,4 # syscall-code for print-string
7688#    la $a0,gcCountMsg
7692#    syscall # print "Number of ..."
7696#    lw $a0,gcCount # number of GC's
7700#    li $v0,1 # code for print-int
7704#    syscall
7708#    li $v0,4 # syscall-code for print-string
7712#    la $a0,newlineString
7716#    syscall # print newline

    # terminate execution
7720#    li $v0,10 #syscall-code for "exit"
7724#    syscall

7728:outOfHeapMemory:
7728#    la $a0,heapMemoryMsg
7732#    j exitError
7736:divByZeroError:
7736#    la $a0,divByZeroMsg
7740#    j exitError
7744:strIndexOutOfBounds:
7744#    la $a0,strIndexOutOfBoundsMsg
7748#    j exitError
7752:arrayIndexOutOfBounds:
7752#    la $a0,arrayIndexOutOfBoundsMsg
7756#    j exitError
7760:arraySizeOutOfBounds:
7760#    la $a0,arraySizeOutOfBoundsMsg
7764#    j exitError
7768:nullPtrException:
7768#    la $a0,nullPtrExceptionMsg
7772#    j exitError
7776:badIntegerFormat:
7776#    la $a0,badIntegerFormatMsg
7780#    j exitError
7784:castException:
