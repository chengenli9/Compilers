888#    seq $t0,$t0,$zero
889##...subu $at,$t0,$zero
893##...sltiu $t0,$at,1

    # pop return address and return $t0
896#    lw $ra,($sp)
900#    addu $sp,4

904#    jr $ra # return
    
908:goEsFalse:
    # put 0 in $t0 and return
908#    li $t0, 0
912#    jr $ra # return
