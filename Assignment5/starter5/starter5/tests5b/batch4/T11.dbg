3508#    and $t2,0xff # mask off hash bits
3509##...lui $at,0
3513##...ori $at,$at,0xff
3517##...and $t2,$t2,$at
3520:gcSkip4a:    
3520#    sll $t2,$t2,2 # # data bytes
3524#    addu $t2,$t2,8 # to skip header words
3528#    addu $t2,$t0,$t2 # pointer to new object
