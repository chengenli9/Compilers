##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
268:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
268#    lw $t0,-8($s2) # get word with hash bits from this
272#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
276#    addu $t0,$t1

280#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
284:mth_equals_Object:
284#    move $t0,$s2 # first pointer (this)
288#    lw $t1,($sp) # second pointer
292#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
293##...subu $at,$t0,$t1
297##...sltiu $t0,$at,1

300#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
304:mth_hashCode_String:
304#    move $t0,$s2 # put this pointer in t0

308#    li $t2,0 # current hash value
312#    lw $t1,-4($t0) # negative of number of characters in string
316#    beq $t1,$zero,done_hashCode_String # if zero length => done
320#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
324#    and $t0,0xfffffffc # adjust for padding
325##...lui $at,65535
329##...ori $at,$at,0xfffc
333##...and $t0,$t0,$at
336#    subu $t1,$t0,$t1 # address at end of string +12
340:loop_hashCode_String:    
340#    sll $t4,$t2,5 # multiply by 32
344#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
348#    lbu $t3,-12($t0) # current character
352#    addu $t2,$t3 # add in current character
356#    addu $t0,1 # go to next character's address
360#    bne $t0,$t1,loop_hashCode_String # loop back if more
364:done_hashCode_String:    

    # push int on stack
364#    move $t0, $t2 # put $t2 in return slot
368#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
372:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
372#    subu $sp,4
376#    sw $ra,($sp)
    
    # get hash value
380#    lw $t2,-12($s2) # vtable address
384#    lw $t0,($t2) # method address
388#    jalr $t0
392#    subu $sp,8 # push result (int in $t0) on stack
396#    sw $s5,4($sp)
400#    sw $t0,($sp)

    # compute print-size of hash value
404#    li $t0, 1
408#    lw $t1, ($sp)
412#    srl $t1,$t1,4
416#    beq $t1,$zero,toString_skip_loop
420:toString_loop_top:
420#    addu $t0,1
424#    srl $t1,$t1,4
428#    bne $t1,$zero,toString_loop_top
432:toString_skip_loop:
432#    subu $sp,8
436#    sw $s5,4($sp)
440#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
444#    lw $t2,-12($s2) # vtable address
448#    move $t0,$t2
452:toString_checkTagBit:
452#    subu $t0,1
456#    lb $t1,($t0)
460#    and $t1,0x80
461##...lui $at,0
465##...ori $at,$at,0x80
469##...and $t1,$t1,$at
472#    beq $t1,$zero,toString_checkTagBit
476#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
480#    subu $sp,8
484#    sw $t1,($sp)
488#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
492#    move $s7,$zero # -4 offset header word
496#    lw $t4,8($sp) # bytes for hash value
500#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
504#    addu $t4,8
508#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
512#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

516#    li $t0,CLASS_String # store string vtable address into ...
520#    sw $t0,-12($s7) # ... -12 offset in object header
524#    lw $t2,-12($s2) # our object's vtable address
528#    lw $t5,4($sp) # number characters in prefix
532#    lw $t1,12($sp) # number of characters in hashcode
536#    addu $t3,$t1,$t5 # number of characters in string ...
540#    addu $t3,1 # ... including the '@' character
544#    subu $t0,$zero,$t3 # store negated length into ...
548#    sw $t0,-4($s7) # ... -4 offset header word
552#    lw $t0,-8($s7) # get -8 offset header-word
556#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
557##...slt $at,$t0,$zero
561##...beq $at,$zero,580
564#    and $t0,0xff # mask off object's hash value ...
565##...lui $at,0
569##...ori $at,$at,0xff
573##...and $t0,$t0,$at
576#    sw $t0,-8($s7) # ... and store back into -8 header-word
580:skipMask_toString:
580#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
584#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
588#    subu $t4,$t2,$t5
592:toString_copyLoop:    
592#    lb $t3,($t4)
596#    and $t3,0x7f # mask off sign bit (in case first word)
597##...lui $at,0
601##...ori $at,$at,0x7f
605##...and $t3,$t3,$at
608#    sb $t3,-8($t0)
612#    addu $t4,1
616#    addu $t0,1
620#    blt $t4,$t2,toString_copyLoop
621##...slt $at,$t4,$t2
625##...bne $at,$zero,592

    # copy the '@' sign
628#    li $t3,'@'
632#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
636#    addu $t2,$t0,$t1 # address of last byte in string to store +8
640#    lw $t3,20($sp) # hash code to print
644:toString_hashCopyLoop:
644#    and $t4,$t3,0xf
648#    srl $t3,4
652#    lb $t4,hexChars($t4)
656#    sb $t4,-8($t2)
660#    subu $t2,$t2,1
664#    bgt $t2,$t0,toString_hashCopyLoop
665##...slt $at,$t0,$t2
669##...bne $at,$zero,644

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
672#    addu $sp,28
676#    lw $ra,($sp)
680#    addu $sp,4
684#    move $t0, $s7 # return string we created
688#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
692:mth_equals_String:
    
    # quick test for obvious false
692#    lw $t0,($sp) # second parameter
696#    beq $t0,$zero,goEsFalse # go return false if null
700#    lw $t1,-12($t0) # vtable pointer
704#    la $t2,CLASS_String # string vtable pointer
708#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
712#    subu $sp,12
716#    sw $ra,8($sp)
720#    sw $s2,4($sp)
724#    sw $t0,($sp)
728#    jal mth_compareTo_String
732#    lw $s2, 4($sp) #restore this pointer and pop parameters
736#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
740#    seq $t0,$t0,$zero
741##...subu $at,$t0,$zero
745##...sltiu $t0,$at,1

    # pop return address and return $t0
748#    lw $ra,($sp)
752#    addu $sp,4

756#    jr $ra # return
    
760:goEsFalse:
