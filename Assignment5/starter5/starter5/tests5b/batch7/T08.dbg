###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
932:mth_readLine_Lib:
    
932#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
936#    sw $ra, 4($sp) # save $ra
940#    move $t1,$sp # save "original" sp

944:  doRead:

    # read the character
944#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
948#    subu $t2,$v0,13
952#    bne $t2,$zero,notReturnRL
956#    jal readLogicalChar
960#    subu $t2,$v0,10 # check for newline
964#    beq $t2,$zero,foundNewLine
968#    sw $v0,lastCharRead # push back character into queue
972#    j foundNewLine # go process the line

976:  notReturnRL:

    # at this point, $v0 has our character

976#    subu $t0,$v0,10
980#    beq $t0,$zero,foundNewLine
984#    blt $v0,$zero,foundEof
985##...slt $at,$v0,$zero
989##...bne $at,$zero,1004

    # we have a character, so push it onto stack
992#    subu $sp,$sp,4
996#    sw $v0,($sp)

    # loop back up to get next character
1000#    j doRead

1004:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
1004#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
1008#    li $s7, 0 # return-value: null
1012#    j rlReturn # return

1016:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
1016#    subu $t0,$t1,$sp # number of chars we read (times 4)
1020#    srl $s6,$t0,2 # number of words on stack with chars
1024#    subu $sp,$sp,4 # push char-count ...
1028#    sw $s6,($sp) # ... onto stack
1032#    addu $t2,$t0,5 # GC tag, incl. for count-word
1036#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
1040#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
1044#    srl $s6,$s6,2  # data words in object
1048#    move $s7,$zero # object words in object
1052#    jal newObject  # allocate space
    
    # store header words
1056#    la $t0,CLASS_String
1060#    sw $t0,-12($s7)# store class tag (String) into object
1064#    lw $t2,4($sp) # char-count
1068#    sll $t1,$t2,2 # 4 times number of chars
1072#    subu $t2,$zero,$t2 # negative of char-count
1076#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
1080#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
1084#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
1085##...slt $at,$t0,$zero
1089##...beq $at,$zero,1108
1092#    and $t0,0xff # mask off object's hash value ...
1093##...lui $at,0
1097##...ori $at,$at,0xff
1101##...and $t0,$t0,$at
1104#    sw $t0,-8($s7) # ... and store back into -8 header-word
1108:  skipMask_readLine:

1108#    sll $t0,$t0,2 # data bytes in object
1112#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
1116#    subu $t0,$t0,$t2 # place to store last character (plus 9)
1120#    addu $sp,$sp,8 # pop redundant object-pointer and count
1124#    addu $t1,$t1,$sp # first non-char spot on stack
