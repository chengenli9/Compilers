3765##...lui $s4,16
3769##...addiu $s4,$s4,5184
3772#    sw $zero,cur_seg
3776#    bne $t0,$zero,skipGc1
3780#    la $t6,seg0_start
3784#    la $s3,seg1_start
3785##...lui $s3,16
3789##...addiu $s3,$s3,5184
3792#    la $s4,seg1_end
3793##...lui $s4,32
3797##...addiu $s4,$s4,5184
3800#    sw $s5,cur_seg
