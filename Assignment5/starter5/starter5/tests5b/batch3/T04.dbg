###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
2924:mth_readLine_Lib:
    
2924#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
2928#    sw $ra, 4($sp) # save $ra
2932#    move $t1,$sp # save "original" sp

2936:  doRead:

    # read the character
2936#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
2940#    subu $t2,$v0,13
2944#    bne $t2,$zero,notReturnRL
2948#    jal readLogicalChar
2952#    subu $t2,$v0,10 # check for newline
2956#    beq $t2,$zero,foundNewLine
2960#    sw $v0,lastCharRead # push back character into queue
2964#    j foundNewLine # go process the line

2968:  notReturnRL:

    # at this point, $v0 has our character

2968#    subu $t0,$v0,10
2972#    beq $t0,$zero,foundNewLine
2976#    blt $v0,$zero,foundEof
2977##...slt $at,$v0,$zero
2981##...bne $at,$zero,2996

    # we have a character, so push it onto stack
2984#    subu $sp,$sp,4
2988#    sw $v0,($sp)

    # loop back up to get next character
2992#    j doRead

2996:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
2996#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
3000#    li $s7, 0 # return-value: null
3004#    j rlReturn # return

3008:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
3008#    subu $t0,$t1,$sp # number of chars we read (times 4)
3012#    srl $s6,$t0,2 # number of words on stack with chars
3016#    subu $sp,$sp,4 # push char-count ...
3020#    sw $s6,($sp) # ... onto stack
3024#    addu $t2,$t0,5 # GC tag, incl. for count-word
3028#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
3032#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
3036#    srl $s6,$s6,2  # data words in object
3040#    move $s7,$zero # object words in object
3044#    jal newObject  # allocate space
    
    # store header words
3048#    la $t0,CLASS_String
3052#    sw $t0,-12($s7)# store class tag (String) into object
3056#    lw $t2,4($sp) # char-count
3060#    sll $t1,$t2,2 # 4 times number of chars
3064#    subu $t2,$zero,$t2 # negative of char-count
3068#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
3072#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
3076#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
3077##...slt $at,$t0,$zero
3081##...beq $at,$zero,3100
3084#    and $t0,0xff # mask off object's hash value ...
3085##...lui $at,0
3089##...ori $at,$at,0xff
3093##...and $t0,$t0,$at
3096#    sw $t0,-8($s7) # ... and store back into -8 header-word
3100:  skipMask_readLine:

3100#    sll $t0,$t0,2 # data bytes in object
3104#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
3108#    subu $t0,$t0,$t2 # place to store last character (plus 9)
3112#    addu $sp,$sp,8 # pop redundant object-pointer and count
3116#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

3120#    beq $sp,$t1,rlReturn
3124:  charCopyLoop:
3124#    lw $t2,($sp)
3128#    sb $t2,-9($t0)
3132#    addu $sp,$sp,4
3136#    subu $t0,$t0,1
3140#    bne $sp,$t1,charCopyLoop
3144:  rlReturn:

3144#    lw $ra, 4($sp)
3148#    addu $sp, 8   # pop $ra and pointless word off stack
3152#    move $t0, $s7 # return string we allocated in $s7
3156#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
3160:mth_readInt_Lib:

    # save $ra by pushing onto stack
3160#    subu $sp,$sp,4
3164#    sw $ra,($sp)

3168:  riSkipWhiteLoop:
    # read a character
3168#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
3172#    subu $t0,$v0,32
3176#    bgt $t0,$zero,nonWhite
3177##...slt $at,$zero,$t0
3181##...bne $at,$zero,3224
3184#    beq $t0,$zero,riSkipWhiteLoop # start over if space
3188#    subu $t0,$v0,10
3192#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
3196#    subu $t0,$v0,9
3200#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
3204#    subu $t0,$v0,13
3208#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
3212#    subu $t0,$v0,12
3216#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
3220#    j badIntegerFormat # illegal integer char: abort program

3224:  nonWhite:
3224#    subu $t0,$v0,'-'
3228#    li $t4,1 # final multiplier
3232#    bne $t0,$zero,helpReadInt # go read
3236#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
3240#    jal readLogicalChar

3244:  helpReadInt:
3244#    li $t2,10
3248#    subu $t1,$v0,'0' # convert digit to 0-9 value
3252#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
3253##...sltu $at,$t1,$t2
3257##...beq $at,$zero,5504
3260#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

3264:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

3264#    jal readLogicalChar # read next character
3268#    subu $t1,$v0,'0' # convert digit to 0-9 value
3272#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
3273##...sltu $at,$t1,$t2
3277##...beq $at,$zero,3296

3280#    mul $t3,$t3,$t2 # multiply old value by 10
3281##...mult $t3,$t2
3285##...mflo $t3
3288#    addu $t3,$t3,$t1 # add in value of new digit
3292#    j digitLoop

3296:  doneDigitLoop:

    # "push back" unused character into queue
3296#    sw $v0,lastCharRead

    # restore return address
3300#    lw $ra,($sp)
3304#    addu $sp, 4

    # multiply by sign and put return value in $t0
3308#    mult $t3,$t4 # multiply to account for poss. minus sign
3312#    mflo $t3
3316#    move $t0, $t3
    
    # return
3320#    jr $ra

###################################################################
# readChar() - library method (class Lib)
# - reads a single character from standard input
