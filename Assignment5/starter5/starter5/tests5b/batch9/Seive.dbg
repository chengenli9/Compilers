3816#    lw $v0,lastCharRead
3820#    li $t0,-2
3824#    beq $t0,$v0 doReadCh

    # we have our character from the buffer. Wipe out
    # buffer and return
3828#    sw $t0,lastCharRead # store -2 into buffer (i.e. "empty")
3832#    jr $ra # return
    
3836:  doReadCh:
    # we need to actually read a character: read and return
3836#    li $v0,12 # use system call to read a character
3840#    syscall
3844#    jr $ra # return
