8481##...slt $at,$t4,$zero
8485##...beq $at,$zero,8504
8488#    and $t4,0xff # mask off object's hash value ...
8489##...lui $at,0
8493##...ori $at,$at,0xff
8497##...and $t4,$t4,$at
8500#    sw $t4,-8($s7) # ... and store back into -8 header-word
8504:skipMask_substring:

    # store negative of count (=n-k) into object-length header-word
    # indicies have changed, because newObject is on stack
8504#    lw $t1,8($sp) # k
8508#    lw $t2,16($sp) # n
8512#    subu $t0,$t2,$t1 # value to store
8516#    sw $t0,-4($s7) # store value
