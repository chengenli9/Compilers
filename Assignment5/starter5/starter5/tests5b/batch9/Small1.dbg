3184#  sw $t0, ($sp)
3188#  lw $t0, ($sp)
3192#  addu $sp, $sp, 8
3196#  sw $t0, -16($s2)
3200#  subu $sp, $sp, 4
3204#  sw $s2, ($sp)
3208#  lw $t0, ($sp)
3212#  addu $sp, $sp, 4
3216#  lw $ra, ($sp)
3220#  addu $sp, $sp, 4
3224#  jr $ra
##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
3228:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
3228#    lw $t0,-8($s2) # get word with hash bits from this
3232#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
3236#    addu $t0,$t1

3240#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
3244:mth_equals_Object:
3244#    move $t0,$s2 # first pointer (this)
3248#    lw $t1,($sp) # second pointer
3252#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
3253##...subu $at,$t0,$t1
3257##...sltiu $t0,$at,1

3260#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
3264:mth_hashCode_String:
3264#    move $t0,$s2 # put this pointer in t0

3268#    li $t2,0 # current hash value
3272#    lw $t1,-4($t0) # negative of number of characters in string
3276#    beq $t1,$zero,done_hashCode_String # if zero length => done
3280#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
3284#    and $t0,0xfffffffc # adjust for padding
3285##...lui $at,65535
3289##...ori $at,$at,0xfffc
3293##...and $t0,$t0,$at
3296#    subu $t1,$t0,$t1 # address at end of string +12
3300:loop_hashCode_String:    
3300#    sll $t4,$t2,5 # multiply by 32
3304#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
3308#    lbu $t3,-12($t0) # current character
3312#    addu $t2,$t3 # add in current character
3316#    addu $t0,1 # go to next character's address
3320#    bne $t0,$t1,loop_hashCode_String # loop back if more
3324:done_hashCode_String:    

    # push int on stack
3324#    move $t0, $t2 # put $t2 in return slot
3328#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
3332:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
3332#    subu $sp,4
3336#    sw $ra,($sp)
    
    # get hash value
3340#    lw $t2,-12($s2) # vtable address
3344#    lw $t0,($t2) # method address
3348#    jalr $t0
3352#    subu $sp,8 # push result (int in $t0) on stack
3356#    sw $s5,4($sp)
3360#    sw $t0,($sp)

    # compute print-size of hash value
3364#    li $t0, 1
3368#    lw $t1, ($sp)
3372#    srl $t1,$t1,4
3376#    beq $t1,$zero,toString_skip_loop
3380:toString_loop_top:
3380#    addu $t0,1
3384#    srl $t1,$t1,4
3388#    bne $t1,$zero,toString_loop_top
3392:toString_skip_loop:
3392#    subu $sp,8
3396#    sw $s5,4($sp)
3400#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
3404#    lw $t2,-12($s2) # vtable address
3408#    move $t0,$t2
3412:toString_checkTagBit:
3412#    subu $t0,1
3416#    lb $t1,($t0)
3420#    and $t1,0x80
3421##...lui $at,0
3425##...ori $at,$at,0x80
3429##...and $t1,$t1,$at
3432#    beq $t1,$zero,toString_checkTagBit
3436#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
3440#    subu $sp,8
3444#    sw $t1,($sp)
3448#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
3452#    move $s7,$zero # -4 offset header word
3456#    lw $t4,8($sp) # bytes for hash value
3460#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
3464#    addu $t4,8
3468#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
3472#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

3476#    li $t0,CLASS_String # store string vtable address into ...
3480#    sw $t0,-12($s7) # ... -12 offset in object header
3484#    lw $t2,-12($s2) # our object's vtable address
3488#    lw $t5,4($sp) # number characters in prefix
3492#    lw $t1,12($sp) # number of characters in hashcode
3496#    addu $t3,$t1,$t5 # number of characters in string ...
3500#    addu $t3,1 # ... including the '@' character
3504#    subu $t0,$zero,$t3 # store negated length into ...
3508#    sw $t0,-4($s7) # ... -4 offset header word
3512#    lw $t0,-8($s7) # get -8 offset header-word
3516#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
3517##...slt $at,$t0,$zero
3521##...beq $at,$zero,3540
3524#    and $t0,0xff # mask off object's hash value ...
3525##...lui $at,0
3529##...ori $at,$at,0xff
3533##...and $t0,$t0,$at
3536#    sw $t0,-8($s7) # ... and store back into -8 header-word
3540:skipMask_toString:
3540#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
3544#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
3548#    subu $t4,$t2,$t5
3552:toString_copyLoop:    
3552#    lb $t3,($t4)
3556#    and $t3,0x7f # mask off sign bit (in case first word)
3557##...lui $at,0
3561##...ori $at,$at,0x7f
3565##...and $t3,$t3,$at
3568#    sb $t3,-8($t0)
3572#    addu $t4,1
3576#    addu $t0,1
3580#    blt $t4,$t2,toString_copyLoop
3581##...slt $at,$t4,$t2
3585##...bne $at,$zero,3552

    # copy the '@' sign
3588#    li $t3,'@'
3592#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
3596#    addu $t2,$t0,$t1 # address of last byte in string to store +8
3600#    lw $t3,20($sp) # hash code to print
3604:toString_hashCopyLoop:
3604#    and $t4,$t3,0xf
3608#    srl $t3,4
3612#    lb $t4,hexChars($t4)
3616#    sb $t4,-8($t2)
3620#    subu $t2,$t2,1
3624#    bgt $t2,$t0,toString_hashCopyLoop
3625##...slt $at,$t0,$t2
3629##...bne $at,$zero,3604

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
3632#    addu $sp,28
3636#    lw $ra,($sp)
3640#    addu $sp,4
3644#    move $t0, $s7 # return string we created
3648#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
3652:mth_equals_String:
    
    # quick test for obvious false
3652#    lw $t0,($sp) # second parameter
3656#    beq $t0,$zero,goEsFalse # go return false if null
3660#    lw $t1,-12($t0) # vtable pointer
3664#    la $t2,CLASS_String # string vtable pointer
3668#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
3672#    subu $sp,12
3676#    sw $ra,8($sp)
3680#    sw $s2,4($sp)
3684#    sw $t0,($sp)
3688#    jal mth_compareTo_String
3692#    lw $s2, 4($sp) #restore this pointer and pop parameters
3696#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
3700#    seq $t0,$t0,$zero
3701##...subu $at,$t0,$zero
3705##...sltiu $t0,$at,1

    # pop return address and return $t0
3708#    lw $ra,($sp)
3712#    addu $sp,4

3716#    jr $ra # return
    
3720:goEsFalse:
    # put 0 in $t0 and return
3720#    li $t0, 0
3724#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
3728:mth_toString_String:
    #we are a string, so return this.
3728#    move $t0, $s2
3732#    jr $ra

###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
3736:mth_readLine_Lib:
    
3736#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
3740#    sw $ra, 4($sp) # save $ra
3744#    move $t1,$sp # save "original" sp

3748:  doRead:

    # read the character
3748#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
3752#    subu $t2,$v0,13
3756#    bne $t2,$zero,notReturnRL
3760#    jal readLogicalChar
3764#    subu $t2,$v0,10 # check for newline
3768#    beq $t2,$zero,foundNewLine
3772#    sw $v0,lastCharRead # push back character into queue
3776#    j foundNewLine # go process the line

3780:  notReturnRL:

    # at this point, $v0 has our character

3780#    subu $t0,$v0,10
3784#    beq $t0,$zero,foundNewLine
3788#    blt $v0,$zero,foundEof
3789##...slt $at,$v0,$zero
3793##...bne $at,$zero,3808

    # we have a character, so push it onto stack
3796#    subu $sp,$sp,4
3800#    sw $v0,($sp)

    # loop back up to get next character
3804#    j doRead

3808:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
3808#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
3812#    li $s7, 0 # return-value: null
3816#    j rlReturn # return

3820:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
3820#    subu $t0,$t1,$sp # number of chars we read (times 4)
3824#    srl $s6,$t0,2 # number of words on stack with chars
3828#    subu $sp,$sp,4 # push char-count ...
3832#    sw $s6,($sp) # ... onto stack
3836#    addu $t2,$t0,5 # GC tag, incl. for count-word
3840#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
3844#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
3848#    srl $s6,$s6,2  # data words in object
3852#    move $s7,$zero # object words in object
3856#    jal newObject  # allocate space
    
    # store header words
3860#    la $t0,CLASS_String
3864#    sw $t0,-12($s7)# store class tag (String) into object
3868#    lw $t2,4($sp) # char-count
3872#    sll $t1,$t2,2 # 4 times number of chars
3876#    subu $t2,$zero,$t2 # negative of char-count
3880#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
3884#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
3888#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
3889##...slt $at,$t0,$zero
3893##...beq $at,$zero,3912
3896#    and $t0,0xff # mask off object's hash value ...
3897##...lui $at,0
3901##...ori $at,$at,0xff
3905##...and $t0,$t0,$at
3908#    sw $t0,-8($s7) # ... and store back into -8 header-word
3912:  skipMask_readLine:

3912#    sll $t0,$t0,2 # data bytes in object
3916#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
3920#    subu $t0,$t0,$t2 # place to store last character (plus 9)
3924#    addu $sp,$sp,8 # pop redundant object-pointer and count
3928#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

3932#    beq $sp,$t1,rlReturn
3936:  charCopyLoop:
3936#    lw $t2,($sp)
3940#    sb $t2,-9($t0)
3944#    addu $sp,$sp,4
3948#    subu $t0,$t0,1
3952#    bne $sp,$t1,charCopyLoop
3956:  rlReturn:

3956#    lw $ra, 4($sp)
3960#    addu $sp, 8   # pop $ra and pointless word off stack
3964#    move $t0, $s7 # return string we allocated in $s7
3968#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
3972:mth_readInt_Lib:

    # save $ra by pushing onto stack
3972#    subu $sp,$sp,4
3976#    sw $ra,($sp)

3980:  riSkipWhiteLoop:
    # read a character
3980#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
3984#    subu $t0,$v0,32
3988#    bgt $t0,$zero,nonWhite
3989##...slt $at,$zero,$t0
3993##...bne $at,$zero,4036
3996#    beq $t0,$zero,riSkipWhiteLoop # start over if space
4000#    subu $t0,$v0,10
4004#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
4008#    subu $t0,$v0,9
4012#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
4016#    subu $t0,$v0,13
4020#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
4024#    subu $t0,$v0,12
4028#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
4032#    j badIntegerFormat # illegal integer char: abort program

4036:  nonWhite:
4036#    subu $t0,$v0,'-'
4040#    li $t4,1 # final multiplier
4044#    bne $t0,$zero,helpReadInt # go read
4048#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
4052#    jal readLogicalChar

4056:  helpReadInt:
4056#    li $t2,10
4060#    subu $t1,$v0,'0' # convert digit to 0-9 value
