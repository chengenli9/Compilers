3761##...bne $at,$zero,3744

    # at this point:
    #  $s3 has been updated to point to the next free slot,
    #    which is also the points just past our object

    # compute pointer value and set up header-words
3764#    sll $t0,$s7,2    # number of post-header bytes
3768#    subu $t0,$s3,$t0 # pointer that we will return

    # determine the value to store in the first header-word:
    # if <= 255 (unsigned):
    #  - it goes into low byte
    #  - hash bits go into high three bytes, with top bit being 1
    # if >255 (unsigned)
    #  - it goes into full word (with a 0 in the high bit)
    
3772#    li $t2,255
3776#    bgeu $s6,$t2 firstHeaderLarge
3777##...sltu $at,$s6,$t2
3781##...beq $at,$zero,3828
3784#    lw $t1,prevHashConstant
3788#    addu $t1,0x12b68fd2
3789##...lui $at,4791
3793##...addiu $at,$at,-28718
3797##...addu $t1,$at,$t1
3800#    sw $t1,prevHashConstant # update hash constant
3804#    or $t1,0x80000000 # set top bit
3805##...lui $at,32768
3809##...or $t1,$at,$t1
3812#    and $t1,0xffffff00 # clear low bit
3813##...lui $at,65535
3817##...ori $at,$at,0xff00
3821##...and $t1,$t1,$at
3824#    or $s6,$t1
3828:firstHeaderLarge:
3828#    sw $s6,-8($t0) # store header-1 value
3832#    lw $zero,-8($t0)

    # store second header-value
3836#    sw $s7,-4($t0)   # second header-word
3840#    lw $zero,-4($t0)
    
    # put return-value into $s7 and also push it onto top of stack
3844#    move $s7,$t0
3848#    subu $sp,$sp,4
3852#    sw $t0,($sp)

3856#    jr $ra
