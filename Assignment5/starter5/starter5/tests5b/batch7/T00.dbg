    #############################################################
    # We have finished processing the stack elements.  Now we need
    # to update elements in the heap itself. This may itself involve
    # moving additional objects
    #############################################################

    #########################################################
    # At this point:
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # We want to set things up so that in addition:
    # - $t0 is the "trailing finger", containing the address
    #   of the first slot in target space that we have yet
    #   to process.
    # Then during processing:
    # - $t1 will contain the contents of the heap slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # And when we're actually copying an object:
    # - $t2 will contain pointer to the target object
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - available for use: $s0
    ##########################################################

    # set $t0 to be at the beginning of target-space
3912#    lw $t1,cur_seg
3916#    la $t0,seg0_start
3920#    beq $t1,$zero,gcSkip4
3924#    la $t0,seg1_start
3925##...lui $t0,16
3929##...addiu $t0,$t0,5136


3932:  gcSkip4:

    # if there were no objects put into the heap during stack
    # processing, we're done, so go finish up
3932#    bgeu $t0,$s3,gcFinishUp
3933##...sltu $at,$t0,$s3
3937##...beq $at,$zero,4228

    ###### begin outer loop to copy all non-stack-direct objects ######

3940:  gcHeapCopyLoop:
    # get data count for object; swap header-word with first word
    # of object so that they're back in the right place
3940#    lw $t1,($t0) # (what will be) first header word for current object
3944#    move $t2,$t1 # number data bytes in object (poss. w/hash bits)
3948#    bge $t2,$zero,gcSkip4a # are there hash bits?
3949##...slt $at,$t2,$zero
3953##...beq $at,$zero,3968
3956#    and $t2,0xff # mask off hash bits
3957##...lui $at,0
3961##...ori $at,$at,0xff
3965##...and $t2,$t2,$at
3968:gcSkip4a:    
3968#    sll $t2,$t2,2 # # data bytes
3972#    addu $t2,$t2,8 # to skip header words
3976#    addu $t2,$t0,$t2 # pointer to new object
3980#    lw $t3,-8($t2) # word to swap
3984#    sw $t1,-8($t2) # store header word
3988#    sw $t3,($t0) # restore first word of object

    ################################################
    # at this point:
    # - $t2 contains the pointer to our new object
    ################################################

    # check if we have a data array
3992#    lw $t1,-12($t2) # vtable pointer
3996#    li $t0,dataArrayVTableStart # address of vtable for first data array
4000#    blt $t1,$t0,gcNotDataArray # if data array, no more xforming to do
4001##...slt $at,$t1,$t0
4005##...bne $at,$zero,4024

    # We have a vtable address that is a data array.
    # we need skip over it then loop back to do next object.
4008:  skipToNextObj:
4008#    lw $t1,-4($t2) # data words in (object position of) array
    #### note: we know that it's not a string, so the value will
    #### not be artificially negative
4012#    sll $t1,$t1,2 # convert to byte-count
4016#    addu $t0,$t2,$t1 # skip over object
4020#    j gcTestIterDone2 # go do next object, if any

    ###################################################
    # at this point:
    # - the object has been restored to normal status--that is, the
    #   word-swap has been done
    # - $t2 contains a pointer to the object
    ###################################################
    
4024:  gcNotDataArray:
4024#    lw $t3,-4($t2) # # object words (negative treated as zero)
4028#    bge $t3,$zero,gcH2Neg2
4029##...slt $at,$t3,$zero
4033##...beq $at,$zero,4040
4036#    move $t3,$zero
4040:  gcH2Neg2:
4040#    sll $t3,$t3,2 # # object bytes
4044#    move $t0,$t2 # address of first pointer in object
4048#    add $s1,$t2,$t3 # limit address for this object

    #####################################################
    # At this point, we have to "translate" all pointers,
    # starting at $t0 to (but not including) $s1
    #####################################################

    # if there are no pointer-slots (i.e., $t0=$s1), skip this
    # part
4052#    beq $t0,$s1,gcTestIterDone2
    
4056:  gcNextPointerInObject:
    # get pointer from object
4056#    lw $t1,($t0)

    # if value is out of range, and is therefore does not refer
    # to an object, just go loop back and do the next one
4060#    bleu $t1,$t6,gcGoNextPointerSlot
4061##...sltu $at,$t6,$t1
4065##...beq $at,$zero,4208
4068#    bgtu $t1,$t7,gcGoNextPointerSlot
4069##...sltu $at,$t7,$t1
4073##...bne $at,$zero,4208

    # if the object has already been moved, update the stack-value
    # via the forwarding pointer
4076#    lw $t8,-8($t1) # possible forwarding tag
4080#    bne $t8,$zero,gcNoForward2 # if not forwarding tag, go copy
4084#    lw $t8,-4($t1) # forwarding pointer: object's new address
4088#    sw $t8,($t0) # update pointer in object
4092#    j gcGoNextPointerSlot # do next iteration

4096:  gcNoForward2:
    #########################################################
    # we actually need to copy the object into the new space
    #########################################################

    #########################################################
    # At this point:
    # - $t0 contains the address of the heap-slot we're translating
    # - $t1 will contain the contents of the heap-slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space, which will also be the first address
    #   of the target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # Then during processing:
    # And when we're actually copying an object:
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $t8 will contain a pointer to the target object
    # - available for use: $s0, $t8, $t9
    ##########################################################

    # compute the amount of space that is needed
4096#    bge $t8,$zero,gcSkip5 # # words in negative-offset portion
4097##...slt $at,$t8,$zero
4101##...beq $at,$zero,4116
4104#    and $t8,0xff # mask off hash bits
4105##...lui $at,0
4109##...ori $at,$at,0xff
4113##...and $t8,$t8,$at

4116:  gcSkip5:
4116#    sll $t8,$t8,2 # bytes in negative-offset portion ...
4120#    addu $t8,$t8,8 # ... add in bytes for header-words
4124#    subu $t4,$t1,$t8 # address of first word of source object
4128#    lw $t3,-4($t1) # # words in positive-offset portion
4132#    bge $t3,$zero,gcNoNeg
4133##...slt $at,$t3,$zero
4137##...beq $at,$zero,4144
4140#    move $t3,$zero # negative treated as zero
4144:  gcNoNeg:
4144#    sll $t3,$t3,2 # bytes in negative-offset portion
4148#    addu $t3,$t3,$t1 # address one word past last word of source

4152#    addu $t8,$s3,$t8 # pointer to target object

    #########################################################
    # At this point:
    # - $t0 contains the address of the stack slot we'll
    #   process next
    # - $t1 contains the contents of the stack slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $t8 contains the pointer to the target object
    # - $s1 contains the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0, $t9
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger"
4156#    lw $s0,($t4)
4160#    lw $t9,-8($t1)
4164#    sw $t9,($t4)
4168#    sw $s0,-8($t1)

    # copy all source bytes to the target
4172:  gCinnerCopy2:
4172#    lw $s0,($t4)
4176#    sw $s0,($s3)
4180#    addu $t4,$t4,4
4184#    addu $s3,$s3,4
4188#    bltu $t4,$t3,gCinnerCopy2
4189##...sltu $at,$t4,$t3
4193##...bne $at,$zero,4172

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
4196#    sw $zero,-8($t1) # 0 in first header-slot
4200#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
4204#    sw $t8,($t0)

4208:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
4208#    addu $t0,$t0,4
4212#    bltu $t0,$s1,gcNextPointerInObject
4213##...sltu $at,$t0,$s1
4217##...bne $at,$zero,4056

4220:  gcTestIterDone2:
4220#    bltu $t0,$s3,gcHeapCopyLoop
4221##...sltu $at,$t0,$s3
4225##...bne $at,$zero,3940

    ###### end outer loop to copy all non-stack-direct objects ######

4228:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
4228#    lw $s2,($sp)
4232#    addu $sp,$sp,4

    # mark us as having already GC'd
4236#    move $t5,$s5

    # go try and allocate again
4240#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
4244:vm_init:

    # mark bottom of stack
4244#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
4248#    move $s2,$zero

    #set up the "five" register
4252#    li $s5,5

4256#    la $s3,seg0_start
4260#    la $s4,seg0_end
4261##...lui $s4,16
4265##...addiu $s4,$s4,5136
    
    # return
4268#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4272:divide:
    # get parameters; abort if divisor zero
4272#    lw $t0,($sp)
4276#    lw $t1,8($sp)
4280#    beq $t0,$zero,divByZeroError
    
    # perform division
4284#    div $t1,$t0
4288#    mflo $t0

    # store result, adjust stack and return
4292#    addu $sp,$sp,8 # adjust stack
4296#    sw $t0,($sp) # store result
4300#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4304:remainder:
    # get parameters; abort if divisor zero
4304#    lw $t0,($sp)
4308#    lw $t1,8($sp)
4312#    beq $t0,$zero,divByZeroError
    
    # perform division
4316#    div $t1,$t0
4320#    mfhi $t0

    # store result, adjust stack and return
4324#    addu $sp,$sp,8 # adjust stack
4328#    sw $t0,($sp) # store result
4332#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
4336:checkCast:
    # get object, allow immediately if null
4336#    lw $t2,($sp)
4340#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
4344#    lw $t2,-12($t2) # vtable address
4348#    bge $t2,$t1,castException
4349##...slt $at,$t2,$t1
4353##...beq $at,$zero,4524
4356#    blt $t2,$t0,castException
4357##...slt $at,$t2,$t0
4361##...bne $at,$zero,4524
    
    # return, leaving object unchanged on stack
4364:  checkCastReturn:    
4364#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
4368:instanceOf:
    # get object, go return false if null
4368#    lw $t2,($sp)
4372#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
4376#    lw $t2,-12($t2) # vtable address
4380#    sge $t0,$t2,$t0 # are we >= the lower limit?
4381##...slt $t0,$t2,$t0
4385##...xori $t0,$t0,0x1
4388#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
4392#    and $t2,$t0,$t1
4396#    sw $t2,($sp)
4400:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
4400#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

4404:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
4404#    li $v0,4 # syscall-code for print-string
4408#    syscall
4412:exit:
    # print termination message
4412#    li $v0,4 # syscall-code for print-string
4416#    la $a0,exitString
4420#    syscall

    # print number of garbage collections
4424#    li $v0,4 # syscall-code for print-string
4428#    la $a0,gcCountMsg
4432#    syscall # print "Number of ..."
4436#    lw $a0,gcCount # number of GC's
4440#    li $v0,1 # code for print-int
4444#    syscall
4448#    li $v0,4 # syscall-code for print-string
4452#    la $a0,newlineString
4456#    syscall # print newline

    # terminate execution
4460#    li $v0,10 #syscall-code for "exit"
4464#    syscall

4468:outOfHeapMemory:
4468#    la $a0,heapMemoryMsg
4472#    j exitError
4476:divByZeroError:
4476#    la $a0,divByZeroMsg
4480#    j exitError
4484:strIndexOutOfBounds:
4484#    la $a0,strIndexOutOfBoundsMsg
4488#    j exitError
4492:arrayIndexOutOfBounds:
4492#    la $a0,arrayIndexOutOfBoundsMsg
4496#    j exitError
4500:arraySizeOutOfBounds:
4500#    la $a0,arraySizeOutOfBoundsMsg
4504#    j exitError
4508:nullPtrException:
4508#    la $a0,nullPtrExceptionMsg
4512#    j exitError
4516:badIntegerFormat:
4516#    la $a0,badIntegerFormatMsg
4520#    j exitError
4524:castException:
4524#    la $a0,castExceptionMsg
4528#    j exitError
############## data section ################
    .data
4764:hexChars:
    .ascii "0123456789abcdef"
    .align 2
4780:cur_seg:
    .word 0

4784:lastCharRead:
    .word -2 # -2 => no buffered character
4788:prevHashConstant:
    .word 0x2785173c
4792:gcCount:
    .word 0

4796:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
4823:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
4846:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
4881:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
4915:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
4948:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
4979:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
5027:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
5048:gcMsg: 
      .asciiz "\nGC!\n"
5054:gcCountMsg: 
      .asciiz "Number of garbage collections: "

5086:nullStr:
    .asciiz "null"
5091:trueString:
    .asciiz "true"
5096:falseString:
    .asciiz "false"
5102:exitString:
    .ascii "Program execution completed."
    #### "falls through" here
5130:newlineString:
    .asciiz "\n"
    
    .align 2
5132:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

5136:seg0_start:
    .space 0x100000
1053712:seg0_end:
1053712:seg1_start:
    .space 0x100000
2102288:seg1_end:
