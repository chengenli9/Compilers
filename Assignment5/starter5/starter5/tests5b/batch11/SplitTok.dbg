###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
6028:mth_readLine_Lib:
    
6028#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
6032#    sw $ra, 4($sp) # save $ra
6036#    move $t1,$sp # save "original" sp

6040:  doRead:

    # read the character
6040#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
6044#    subu $t2,$v0,13
6048#    bne $t2,$zero,notReturnRL
6052#    jal readLogicalChar
6056#    subu $t2,$v0,10 # check for newline
6060#    beq $t2,$zero,foundNewLine
6064#    sw $v0,lastCharRead # push back character into queue
6068#    j foundNewLine # go process the line

6072:  notReturnRL:

    # at this point, $v0 has our character

6072#    subu $t0,$v0,10
6076#    beq $t0,$zero,foundNewLine
6080#    blt $v0,$zero,foundEof
6081##...slt $at,$v0,$zero
6085##...bne $at,$zero,6100

    # we have a character, so push it onto stack
6088#    subu $sp,$sp,4
6092#    sw $v0,($sp)

    # loop back up to get next character
6096#    j doRead

6100:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
6100#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
6104#    li $s7, 0 # return-value: null
6108#    j rlReturn # return

6112:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
6112#    subu $t0,$t1,$sp # number of chars we read (times 4)
6116#    srl $s6,$t0,2 # number of words on stack with chars
6120#    subu $sp,$sp,4 # push char-count ...
6124#    sw $s6,($sp) # ... onto stack
6128#    addu $t2,$t0,5 # GC tag, incl. for count-word
6132#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
6136#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
6140#    srl $s6,$s6,2  # data words in object
6144#    move $s7,$zero # object words in object
6148#    jal newObject  # allocate space
    
    # store header words
6152#    la $t0,CLASS_String
6156#    sw $t0,-12($s7)# store class tag (String) into object
6160#    lw $t2,4($sp) # char-count
6164#    sll $t1,$t2,2 # 4 times number of chars
6168#    subu $t2,$zero,$t2 # negative of char-count
6172#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
6176#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
6180#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
6181##...slt $at,$t0,$zero
6185##...beq $at,$zero,6204
6188#    and $t0,0xff # mask off object's hash value ...
6189##...lui $at,0
6193##...ori $at,$at,0xff
6197##...and $t0,$t0,$at
6200#    sw $t0,-8($s7) # ... and store back into -8 header-word
6204:  skipMask_readLine:

6204#    sll $t0,$t0,2 # data bytes in object
6208#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
6212#    subu $t0,$t0,$t2 # place to store last character (plus 9)
6216#    addu $sp,$sp,8 # pop redundant object-pointer and count
6220#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack
