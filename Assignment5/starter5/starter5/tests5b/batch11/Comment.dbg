3508#    sw $ra,($sp)

3512:  riSkipWhiteLoop:
    # read a character
3512#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
3516#    subu $t0,$v0,32
3520#    bgt $t0,$zero,nonWhite
3521##...slt $at,$zero,$t0
3525##...bne $at,$zero,3568
3528#    beq $t0,$zero,riSkipWhiteLoop # start over if space
3532#    subu $t0,$v0,10
3536#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
3540#    subu $t0,$v0,9
3544#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
3548#    subu $t0,$v0,13
3552#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
3556#    subu $t0,$v0,12
3560#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
3564#    j badIntegerFormat # illegal integer char: abort program

3568:  nonWhite:
3568#    subu $t0,$v0,'-'
3572#    li $t4,1 # final multiplier
3576#    bne $t0,$zero,helpReadInt # go read
3580#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
3584#    jal readLogicalChar

3588:  helpReadInt:
3588#    li $t2,10
