##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
3112:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
3112#    lw $t0,-8($s2) # get word with hash bits from this
3116#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
3120#    addu $t0,$t1

3124#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
3128:mth_equals_Object:
3128#    move $t0,$s2 # first pointer (this)
3132#    lw $t1,($sp) # second pointer
3136#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
3137##...subu $at,$t0,$t1
3141##...sltiu $t0,$at,1

3144#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
3148:mth_hashCode_String:
3148#    move $t0,$s2 # put this pointer in t0

3152#    li $t2,0 # current hash value
3156#    lw $t1,-4($t0) # negative of number of characters in string
3160#    beq $t1,$zero,done_hashCode_String # if zero length => done
3164#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
3168#    and $t0,0xfffffffc # adjust for padding
3169##...lui $at,65535
3173##...ori $at,$at,0xfffc
3177##...and $t0,$t0,$at
3180#    subu $t1,$t0,$t1 # address at end of string +12
3184:loop_hashCode_String:    
3184#    sll $t4,$t2,5 # multiply by 32
3188#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
3192#    lbu $t3,-12($t0) # current character
3196#    addu $t2,$t3 # add in current character
3200#    addu $t0,1 # go to next character's address
3204#    bne $t0,$t1,loop_hashCode_String # loop back if more
3208:done_hashCode_String:    

    # push int on stack
3208#    move $t0, $t2 # put $t2 in return slot
3212#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
3216:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
3216#    subu $sp,4
3220#    sw $ra,($sp)
    
    # get hash value
3224#    lw $t2,-12($s2) # vtable address
3228#    lw $t0,($t2) # method address
3232#    jalr $t0
3236#    subu $sp,8 # push result (int in $t0) on stack
3240#    sw $s5,4($sp)
3244#    sw $t0,($sp)

    # compute print-size of hash value
3248#    li $t0, 1
3252#    lw $t1, ($sp)
3256#    srl $t1,$t1,4
3260#    beq $t1,$zero,toString_skip_loop
3264:toString_loop_top:
3264#    addu $t0,1
3268#    srl $t1,$t1,4
3272#    bne $t1,$zero,toString_loop_top
3276:toString_skip_loop:
3276#    subu $sp,8
3280#    sw $s5,4($sp)
3284#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
3288#    lw $t2,-12($s2) # vtable address
3292#    move $t0,$t2
3296:toString_checkTagBit:
3296#    subu $t0,1
3300#    lb $t1,($t0)
3304#    and $t1,0x80
3305##...lui $at,0
3309##...ori $at,$at,0x80
3313##...and $t1,$t1,$at
3316#    beq $t1,$zero,toString_checkTagBit
3320#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
3324#    subu $sp,8
3328#    sw $t1,($sp)
3332#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
3336#    move $s7,$zero # -4 offset header word
3340#    lw $t4,8($sp) # bytes for hash value
3344#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
3348#    addu $t4,8
3352#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
3356#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

3360#    li $t0,CLASS_String # store string vtable address into ...
3364#    sw $t0,-12($s7) # ... -12 offset in object header
3368#    lw $t2,-12($s2) # our object's vtable address
3372#    lw $t5,4($sp) # number characters in prefix
3376#    lw $t1,12($sp) # number of characters in hashcode
3380#    addu $t3,$t1,$t5 # number of characters in string ...
3384#    addu $t3,1 # ... including the '@' character
3388#    subu $t0,$zero,$t3 # store negated length into ...
3392#    sw $t0,-4($s7) # ... -4 offset header word
3396#    lw $t0,-8($s7) # get -8 offset header-word
3400#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
3401##...slt $at,$t0,$zero
3405##...beq $at,$zero,3424
3408#    and $t0,0xff # mask off object's hash value ...
3409##...lui $at,0
3413##...ori $at,$at,0xff
3417##...and $t0,$t0,$at
3420#    sw $t0,-8($s7) # ... and store back into -8 header-word
3424:skipMask_toString:
3424#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
3428#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
3432#    subu $t4,$t2,$t5
3436:toString_copyLoop:    
3436#    lb $t3,($t4)
3440#    and $t3,0x7f # mask off sign bit (in case first word)
3441##...lui $at,0
3445##...ori $at,$at,0x7f
3449##...and $t3,$t3,$at
3452#    sb $t3,-8($t0)
3456#    addu $t4,1
3460#    addu $t0,1
3464#    blt $t4,$t2,toString_copyLoop
3465##...slt $at,$t4,$t2
3469##...bne $at,$zero,3436

    # copy the '@' sign
3472#    li $t3,'@'
3476#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
3480#    addu $t2,$t0,$t1 # address of last byte in string to store +8
3484#    lw $t3,20($sp) # hash code to print
3488:toString_hashCopyLoop:
3488#    and $t4,$t3,0xf
3492#    srl $t3,4
3496#    lb $t4,hexChars($t4)
3500#    sb $t4,-8($t2)
3504#    subu $t2,$t2,1
3508#    bgt $t2,$t0,toString_hashCopyLoop
3509##...slt $at,$t0,$t2
3513##...bne $at,$zero,3488

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
3516#    addu $sp,28
3520#    lw $ra,($sp)
3524#    addu $sp,4
3528#    move $t0, $s7 # return string we created
3532#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
3536:mth_equals_String:
    
    # quick test for obvious false
3536#    lw $t0,($sp) # second parameter
3540#    beq $t0,$zero,goEsFalse # go return false if null
3544#    lw $t1,-12($t0) # vtable pointer
3548#    la $t2,CLASS_String # string vtable pointer
3552#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
3556#    subu $sp,12
3560#    sw $ra,8($sp)
3564#    sw $s2,4($sp)
3568#    sw $t0,($sp)
3572#    jal mth_compareTo_String
3576#    lw $s2, 4($sp) #restore this pointer and pop parameters
3580#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
3584#    seq $t0,$t0,$zero
3585##...subu $at,$t0,$zero
3589##...sltiu $t0,$at,1

    # pop return address and return $t0
3592#    lw $ra,($sp)
3596#    addu $sp,4

3600#    jr $ra # return
    
3604:goEsFalse:
    # put 0 in $t0 and return
3604#    li $t0, 0
3608#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
