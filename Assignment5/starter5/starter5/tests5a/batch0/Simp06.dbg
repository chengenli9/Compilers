##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
124:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
124#    lw $t0,-8($s2) # get word with hash bits from this
128#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
132#    addu $t0,$t1

136#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
140:mth_equals_Object:
140#    move $t0,$s2 # first pointer (this)
144#    lw $t1,($sp) # second pointer
148#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
149##...subu $at,$t0,$t1
153##...sltiu $t0,$at,1

156#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
160:mth_hashCode_String:
160#    move $t0,$s2 # put this pointer in t0

164#    li $t2,0 # current hash value
168#    lw $t1,-4($t0) # negative of number of characters in string
172#    beq $t1,$zero,done_hashCode_String # if zero length => done
176#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
180#    and $t0,0xfffffffc # adjust for padding
181##...lui $at,65535
185##...ori $at,$at,0xfffc
189##...and $t0,$t0,$at
192#    subu $t1,$t0,$t1 # address at end of string +12
196:loop_hashCode_String:    
196#    sll $t4,$t2,5 # multiply by 32
200#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
204#    lbu $t3,-12($t0) # current character
208#    addu $t2,$t3 # add in current character
212#    addu $t0,1 # go to next character's address
216#    bne $t0,$t1,loop_hashCode_String # loop back if more
220:done_hashCode_String:    

    # push int on stack
220#    move $t0, $t2 # put $t2 in return slot
224#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
228:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
228#    subu $sp,4
232#    sw $ra,($sp)
    
    # get hash value
236#    lw $t2,-12($s2) # vtable address
240#    lw $t0,($t2) # method address
244#    jalr $t0
248#    subu $sp,8 # push result (int in $t0) on stack
252#    sw $s5,4($sp)
256#    sw $t0,($sp)

    # compute print-size of hash value
260#    li $t0, 1
264#    lw $t1, ($sp)
268#    srl $t1,$t1,4
272#    beq $t1,$zero,toString_skip_loop
276:toString_loop_top:
276#    addu $t0,1
280#    srl $t1,$t1,4
284#    bne $t1,$zero,toString_loop_top
288:toString_skip_loop:
288#    subu $sp,8
292#    sw $s5,4($sp)
296#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
300#    lw $t2,-12($s2) # vtable address
304#    move $t0,$t2
308:toString_checkTagBit:
308#    subu $t0,1
312#    lb $t1,($t0)
316#    and $t1,0x80
317##...lui $at,0
321##...ori $at,$at,0x80
325##...and $t1,$t1,$at
328#    beq $t1,$zero,toString_checkTagBit
332#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
336#    subu $sp,8
340#    sw $t1,($sp)
344#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
348#    move $s7,$zero # -4 offset header word
352#    lw $t4,8($sp) # bytes for hash value
356#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
360#    addu $t4,8
364#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
368#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

372#    li $t0,CLASS_String # store string vtable address into ...
376#    sw $t0,-12($s7) # ... -12 offset in object header
380#    lw $t2,-12($s2) # our object's vtable address
384#    lw $t5,4($sp) # number characters in prefix
388#    lw $t1,12($sp) # number of characters in hashcode
392#    addu $t3,$t1,$t5 # number of characters in string ...
396#    addu $t3,1 # ... including the '@' character
400#    subu $t0,$zero,$t3 # store negated length into ...
404#    sw $t0,-4($s7) # ... -4 offset header word
408#    lw $t0,-8($s7) # get -8 offset header-word
412#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
413##...slt $at,$t0,$zero
417##...beq $at,$zero,436
420#    and $t0,0xff # mask off object's hash value ...
421##...lui $at,0
425##...ori $at,$at,0xff
429##...and $t0,$t0,$at
432#    sw $t0,-8($s7) # ... and store back into -8 header-word
436:skipMask_toString:
436#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
440#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
444#    subu $t4,$t2,$t5
448:toString_copyLoop:    
448#    lb $t3,($t4)
452#    and $t3,0x7f # mask off sign bit (in case first word)
453##...lui $at,0
457##...ori $at,$at,0x7f
461##...and $t3,$t3,$at
464#    sb $t3,-8($t0)
468#    addu $t4,1
472#    addu $t0,1
476#    blt $t4,$t2,toString_copyLoop
477##...slt $at,$t4,$t2
481##...bne $at,$zero,448

    # copy the '@' sign
484#    li $t3,'@'
488#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
492#    addu $t2,$t0,$t1 # address of last byte in string to store +8
496#    lw $t3,20($sp) # hash code to print
500:toString_hashCopyLoop:
500#    and $t4,$t3,0xf
504#    srl $t3,4
508#    lb $t4,hexChars($t4)
512#    sb $t4,-8($t2)
516#    subu $t2,$t2,1
520#    bgt $t2,$t0,toString_hashCopyLoop
521##...slt $at,$t0,$t2
525##...bne $at,$zero,500

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
528#    addu $sp,28
532#    lw $ra,($sp)
536#    addu $sp,4
540#    move $t0, $s7 # return string we created
544#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
548:mth_equals_String:
    
    # quick test for obvious false
548#    lw $t0,($sp) # second parameter
552#    beq $t0,$zero,goEsFalse # go return false if null
556#    lw $t1,-12($t0) # vtable pointer
560#    la $t2,CLASS_String # string vtable pointer
564#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
568#    subu $sp,12
572#    sw $ra,8($sp)
576#    sw $s2,4($sp)
580#    sw $t0,($sp)
584#    jal mth_compareTo_String
588#    lw $s2, 4($sp) #restore this pointer and pop parameters
592#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
596#    seq $t0,$t0,$zero
597##...subu $at,$t0,$zero
601##...sltiu $t0,$at,1

    # pop return address and return $t0
604#    lw $ra,($sp)
608#    addu $sp,4

612#    jr $ra # return
    
616:goEsFalse:
    # put 0 in $t0 and return
616#    li $t0, 0
620#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
624:mth_toString_String:
    #we are a string, so return this.
624#    move $t0, $s2
628#    jr $ra

###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
632:mth_readLine_Lib:
    
632#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
636#    sw $ra, 4($sp) # save $ra
640#    move $t1,$sp # save "original" sp

644:  doRead:

    # read the character
644#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
648#    subu $t2,$v0,13
652#    bne $t2,$zero,notReturnRL
656#    jal readLogicalChar
660#    subu $t2,$v0,10 # check for newline
664#    beq $t2,$zero,foundNewLine
668#    sw $v0,lastCharRead # push back character into queue
672#    j foundNewLine # go process the line

676:  notReturnRL:

    # at this point, $v0 has our character

676#    subu $t0,$v0,10
680#    beq $t0,$zero,foundNewLine
684#    blt $v0,$zero,foundEof
685##...slt $at,$v0,$zero
689##...bne $at,$zero,704

    # we have a character, so push it onto stack
692#    subu $sp,$sp,4
696#    sw $v0,($sp)

    # loop back up to get next character
700#    j doRead

704:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
704#    bne $t1,$sp foundNewLine

