##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1112:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
1112#    lw $t0,-8($s2) # get word with hash bits from this
1116#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
1120#    addu $t0,$t1

1124#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1128:mth_equals_Object:
1128#    move $t0,$s2 # first pointer (this)
1132#    lw $t1,($sp) # second pointer
1136#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
1137##...subu $at,$t0,$t1
1141##...sltiu $t0,$at,1

1144#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1148:mth_hashCode_String:
1148#    move $t0,$s2 # put this pointer in t0

1152#    li $t2,0 # current hash value
1156#    lw $t1,-4($t0) # negative of number of characters in string
1160#    beq $t1,$zero,done_hashCode_String # if zero length => done
1164#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
1168#    and $t0,0xfffffffc # adjust for padding
1169##...lui $at,65535
1173##...ori $at,$at,0xfffc
1177##...and $t0,$t0,$at
1180#    subu $t1,$t0,$t1 # address at end of string +12
1184:loop_hashCode_String:    
1184#    sll $t4,$t2,5 # multiply by 32
1188#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
1192#    lbu $t3,-12($t0) # current character
1196#    addu $t2,$t3 # add in current character
1200#    addu $t0,1 # go to next character's address
1204#    bne $t0,$t1,loop_hashCode_String # loop back if more
1208:done_hashCode_String:    

    # push int on stack
1208#    move $t0, $t2 # put $t2 in return slot
1212#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
1216:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
1216#    subu $sp,4
1220#    sw $ra,($sp)
    
    # get hash value
1224#    lw $t2,-12($s2) # vtable address
1228#    lw $t0,($t2) # method address
1232#    jalr $t0
1236#    subu $sp,8 # push result (int in $t0) on stack
1240#    sw $s5,4($sp)
1244#    sw $t0,($sp)

    # compute print-size of hash value
1248#    li $t0, 1
1252#    lw $t1, ($sp)
1256#    srl $t1,$t1,4
1260#    beq $t1,$zero,toString_skip_loop
1264:toString_loop_top:
1264#    addu $t0,1
1268#    srl $t1,$t1,4
1272#    bne $t1,$zero,toString_loop_top
1276:toString_skip_loop:
1276#    subu $sp,8
1280#    sw $s5,4($sp)
1284#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
1288#    lw $t2,-12($s2) # vtable address
1292#    move $t0,$t2
1296:toString_checkTagBit:
1296#    subu $t0,1
1300#    lb $t1,($t0)
1304#    and $t1,0x80
1305##...lui $at,0
1309##...ori $at,$at,0x80
1313##...and $t1,$t1,$at
1316#    beq $t1,$zero,toString_checkTagBit
1320#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
1324#    subu $sp,8
1328#    sw $t1,($sp)
1332#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
1336#    move $s7,$zero # -4 offset header word
1340#    lw $t4,8($sp) # bytes for hash value
1344#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
1348#    addu $t4,8
1352#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
1356#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

1360#    li $t0,CLASS_String # store string vtable address into ...
1364#    sw $t0,-12($s7) # ... -12 offset in object header
1368#    lw $t2,-12($s2) # our object's vtable address
1372#    lw $t5,4($sp) # number characters in prefix
1376#    lw $t1,12($sp) # number of characters in hashcode
1380#    addu $t3,$t1,$t5 # number of characters in string ...
1384#    addu $t3,1 # ... including the '@' character
1388#    subu $t0,$zero,$t3 # store negated length into ...
1392#    sw $t0,-4($s7) # ... -4 offset header word
1396#    lw $t0,-8($s7) # get -8 offset header-word
1400#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
1401##...slt $at,$t0,$zero
1405##...beq $at,$zero,1424
1408#    and $t0,0xff # mask off object's hash value ...
1409##...lui $at,0
1413##...ori $at,$at,0xff
1417##...and $t0,$t0,$at
1420#    sw $t0,-8($s7) # ... and store back into -8 header-word
1424:skipMask_toString:
1424#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
1428#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
1432#    subu $t4,$t2,$t5
1436:toString_copyLoop:    
1436#    lb $t3,($t4)
1440#    and $t3,0x7f # mask off sign bit (in case first word)
1441##...lui $at,0
1445##...ori $at,$at,0x7f
1449##...and $t3,$t3,$at
1452#    sb $t3,-8($t0)
1456#    addu $t4,1
1460#    addu $t0,1
1464#    blt $t4,$t2,toString_copyLoop
1465##...slt $at,$t4,$t2
1469##...bne $at,$zero,1436

    # copy the '@' sign
1472#    li $t3,'@'
1476#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
1480#    addu $t2,$t0,$t1 # address of last byte in string to store +8
1484#    lw $t3,20($sp) # hash code to print
1488:toString_hashCopyLoop:
1488#    and $t4,$t3,0xf
1492#    srl $t3,4
1496#    lb $t4,hexChars($t4)
1500#    sb $t4,-8($t2)
1504#    subu $t2,$t2,1
1508#    bgt $t2,$t0,toString_hashCopyLoop
1509##...slt $at,$t0,$t2
1513##...bne $at,$zero,1488

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
1516#    addu $sp,28
1520#    lw $ra,($sp)
1524#    addu $sp,4
1528#    move $t0, $s7 # return string we created
1532#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
1536:mth_equals_String:
    
    # quick test for obvious false
1536#    lw $t0,($sp) # second parameter
1540#    beq $t0,$zero,goEsFalse # go return false if null
1544#    lw $t1,-12($t0) # vtable pointer
1548#    la $t2,CLASS_String # string vtable pointer
1552#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
1556#    subu $sp,12
1560#    sw $ra,8($sp)
1564#    sw $s2,4($sp)
1568#    sw $t0,($sp)
1572#    jal mth_compareTo_String
1576#    lw $s2, 4($sp) #restore this pointer and pop parameters
1580#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
1584#    seq $t0,$t0,$zero
1585##...subu $at,$t0,$zero
1589##...sltiu $t0,$at,1

    # pop return address and return $t0
1592#    lw $ra,($sp)
1596#    addu $sp,4

1600#    jr $ra # return
    
1604:goEsFalse:
    # put 0 in $t0 and return
1604#    li $t0, 0
1608#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
