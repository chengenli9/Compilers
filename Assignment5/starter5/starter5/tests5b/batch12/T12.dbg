1332#    subu $t0,$v0,10
1336#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
1340#    subu $t0,$v0,9
1344#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
1348#    subu $t0,$v0,13
1352#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
1356#    subu $t0,$v0,12
