########################################################
# str.substring(n, k) - library method (class String)
# takes a substring of a string: Java: str.substring(n, k)
# - parameters after pushing RA:
#   - ($sp) - k: one beyond index of last char in subrange
#   - 4($sp) - GC tag
#   - 8($sp) - n: index of first char in subrange
#   - 12($sp) - GC tag
#   - 16($sp) - old this pointer
# - return value:
#  - $t0 - substring
########################################################
4524:mth_substring_String:

    # save $ra by pushing onto stack
4524#    subu $sp,$sp,4
4528#    sw $ra,($sp)

    # get string from this, we probably don't need the null check.
4532#    move $t0,$s2
4536#    beq $t0,$zero,nullPtrException

    # get both indices and string length, and ensure that
    #   0 <= n <= k <= length
4540#    lw $t0,-4($t0) # negative of string length
4544#    subu $t0,$zero,$t0 # string length
4548#    lw $t1,4($sp) # k
4552#    lw $t2,12($sp) # n
4556#    bgt $zero,$t2,strIndexOutOfBounds
4557##...slt $at,$t2,$zero
4561##...bne $at,$zero,6520
4564#    bgt $t2,$t1,strIndexOutOfBounds
4565##...slt $at,$t1,$t2
4569##...bne $at,$zero,6520
4572#    bgt $t1,$t0,strIndexOutOfBounds
4573##...slt $at,$t0,$t1
4577##...bne $at,$zero,6520

    # allocate memory
4580#    subu $s6,$t1,$t2 # # chars in target-string
4584#    addu $s6,$s6,7 # account for extra "class" (4) word + 3 to round up
4588#    srl $s6,$s6,2 # convert bytes-count to word-count
4592#    move $s7,$zero # (no object-bytes in string)
4596#    jal newObject

    # store "String" tag in object-type field
4600#    la $t0,CLASS_String
4604#    sw $t0,-12($s7)
    
    # mask off hash bits, if needed
4608#    lw $t4,-8($s7) # data words in source string
4612#    bge $t4,$zero,skipMask_substring # don't strip hash code if not there
4613##...slt $at,$t4,$zero
4617##...beq $at,$zero,4636
4620#    and $t4,0xff # mask off object's hash value ...
4621##...lui $at,0
4625##...ori $at,$at,0xff
4629##...and $t4,$t4,$at
4632#    sw $t4,-8($s7) # ... and store back into -8 header-word
4636:skipMask_substring:

    # store negative of count (=n-k) into object-length header-word
    # indicies have changed, because newObject is on stack
4636#    lw $t1,8($sp) # k
4640#    lw $t2,16($sp) # n
4644#    subu $t0,$t2,$t1 # value to store
4648#    sw $t0,-4($s7) # store value
    
4652#    move $t3,$s2 # source string pointer
    
    # skip byte-copy loop if length is zero
4656#    beq $zero,$t0,doneSubCopyzz

    # get pointers set up in preparation for copy
4660#    lw $t4,-8($t3) # data words in source string
4664#    sll $t4,$t4,2 # data bytes in source string (incl. padding)
4668#    subu $t3,$t3,$t4 # addr. of first data word of source string (+8)
4672#    addu $t3,$t3,$t2 # addr. of first source data byte to be copied (+8)
4676#    subu $t1,$t3,$t0 # addr. beyond last source data byte to be copied (+8)
4680#    lw $t2,-8($s7)   # data words in target string
4684#    sll $t2,$t2,2    # data bytes in target string
4688#    subu $t2,$s7,$t2 # addr. of first target data byte (+8)
    
    ############################################
    # at this point:
    # - we know that the string has a positive length
    # - $t3 contains 8 + address of the first source-byte
    # - $t1 contains 8 + limit-address of the first source-byte
    # - $t2 contains 8 + address first target byte
    ############################################

    # copy the bytes from source to target
4692:  subCopyLoopzz:
4692#    lb $t4,-8($t3)
4696#    sb $t4,-8($t2)
4700#    addu $t2,$t2,1
4704#    addu $t3,$t3,1
4708#    blt $t3,$t1,subCopyLoopzz
4709##...slt $at,$t3,$t1
4713##...bne $at,$zero,4692
    
4716:  doneSubCopyzz:
    # restore return address, store return value, pop stack
4716#    lw $ra,4($sp) # restore $ra
4720#    addu $sp,$sp,8 # pop ra, and allocated newObject
4724#    move $t0, $s7 # we're returning the string we got back
                  # from newObject
    
    # return
4728#    jr $ra

########################################################
# length() - library method (class String)
# returns length of a string: Java: str.length()
# - parameters:
#   - ($sp) - old this pointer
# - return-value:
