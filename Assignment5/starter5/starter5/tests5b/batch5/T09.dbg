1464#    li $t4,1 # final multiplier
1468#    bne $t0,$zero,helpReadInt # go read
1472#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
1476#    jal readLogicalChar

1480:  helpReadInt:
1480#    li $t2,10
1484#    subu $t1,$v0,'0' # convert digit to 0-9 value
