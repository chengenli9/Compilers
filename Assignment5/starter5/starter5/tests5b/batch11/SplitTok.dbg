8225##...slt $at,$t8,$zero
8229##...beq $at,$zero,8244
8232#    and $t8,0xff # mask off hash bits
8233##...lui $at,0
8237##...ori $at,$at,0xff
8241##...and $t8,$t8,$at

8244:  gcSkip5:
8244#    sll $t8,$t8,2 # bytes in negative-offset portion ...
8248#    addu $t8,$t8,8 # ... add in bytes for header-words
8252#    subu $t4,$t1,$t8 # address of first word of source object
8256#    lw $t3,-4($t1) # # words in positive-offset portion
8260#    bge $t3,$zero,gcNoNeg
8261##...slt $at,$t3,$zero
8265##...beq $at,$zero,8272
8268#    move $t3,$zero # negative treated as zero
8272:  gcNoNeg:
8272#    sll $t3,$t3,2 # bytes in negative-offset portion
8276#    addu $t3,$t3,$t1 # address one word past last word of source

8280#    addu $t8,$s3,$t8 # pointer to target object

    #########################################################
    # At this point:
    # - $t0 contains the address of the stack slot we'll
    #   process next
    # - $t1 contains the contents of the stack slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $t8 contains the pointer to the target object
    # - $s1 contains the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0, $t9
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger"
8284#    lw $s0,($t4)
8288#    lw $t9,-8($t1)
8292#    sw $t9,($t4)
8296#    sw $s0,-8($t1)

    # copy all source bytes to the target
8300:  gCinnerCopy2:
8300#    lw $s0,($t4)
8304#    sw $s0,($s3)
8308#    addu $t4,$t4,4
8312#    addu $s3,$s3,4
8316#    bltu $t4,$t3,gCinnerCopy2
8317##...sltu $at,$t4,$t3
8321##...bne $at,$zero,8300

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
8324#    sw $zero,-8($t1) # 0 in first header-slot
8328#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
8332#    sw $t8,($t0)

8336:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
8336#    addu $t0,$t0,4
8340#    bltu $t0,$s1,gcNextPointerInObject
8341##...sltu $at,$t0,$s1
8345##...bne $at,$zero,8184

8348:  gcTestIterDone2:
8348#    bltu $t0,$s3,gcHeapCopyLoop
8349##...sltu $at,$t0,$s3
8353##...bne $at,$zero,8068

    ###### end outer loop to copy all non-stack-direct objects ######

8356:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
8356#    lw $s2,($sp)
8360#    addu $sp,$sp,4

    # mark us as having already GC'd
8364#    move $t5,$s5

    # go try and allocate again
8368#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
8372:vm_init:

    # mark bottom of stack
8372#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
8376#    move $s2,$zero

    #set up the "five" register
8380#    li $s5,5

8384#    la $s3,seg0_start
8388#    la $s4,seg0_end
8389##...lui $s4,16
8393##...addiu $s4,$s4,9708
    
    # return
8396#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
8400:divide:
    # get parameters; abort if divisor zero
8400#    lw $t0,($sp)
8404#    lw $t1,8($sp)
8408#    beq $t0,$zero,divByZeroError
    
    # perform division
8412#    div $t1,$t0
8416#    mflo $t0

    # store result, adjust stack and return
8420#    addu $sp,$sp,8 # adjust stack
8424#    sw $t0,($sp) # store result
8428#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
8432:remainder:
    # get parameters; abort if divisor zero
8432#    lw $t0,($sp)
8436#    lw $t1,8($sp)
8440#    beq $t0,$zero,divByZeroError
    
    # perform division
8444#    div $t1,$t0
8448#    mfhi $t0

    # store result, adjust stack and return
8452#    addu $sp,$sp,8 # adjust stack
8456#    sw $t0,($sp) # store result
8460#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
8464:checkCast:
    # get object, allow immediately if null
8464#    lw $t2,($sp)
8468#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
8472#    lw $t2,-12($t2) # vtable address
8476#    bge $t2,$t1,castException
8477##...slt $at,$t2,$t1
8481##...beq $at,$zero,8652
8484#    blt $t2,$t0,castException
8485##...slt $at,$t2,$t0
8489##...bne $at,$zero,8652
    
    # return, leaving object unchanged on stack
8492:  checkCastReturn:    
8492#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
8496:instanceOf:
    # get object, go return false if null
8496#    lw $t2,($sp)
8500#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
8504#    lw $t2,-12($t2) # vtable address
8508#    sge $t0,$t2,$t0 # are we >= the lower limit?
8509##...slt $t0,$t2,$t0
8513##...xori $t0,$t0,0x1
8516#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
8520#    and $t2,$t0,$t1
8524#    sw $t2,($sp)
8528:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
8528#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

8532:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
8532#    li $v0,4 # syscall-code for print-string
8536#    syscall
8540:exit:
    # print termination message
8540#    li $v0,4 # syscall-code for print-string
8544#    la $a0,exitString
8548#    syscall

    # print number of garbage collections
8552#    li $v0,4 # syscall-code for print-string
8556#    la $a0,gcCountMsg
8560#    syscall # print "Number of ..."
8564#    lw $a0,gcCount # number of GC's
8568#    li $v0,1 # code for print-int
8572#    syscall
8576#    li $v0,4 # syscall-code for print-string
8580#    la $a0,newlineString
8584#    syscall # print newline

    # terminate execution
8588#    li $v0,10 #syscall-code for "exit"
8592#    syscall

8596:outOfHeapMemory:
8596#    la $a0,heapMemoryMsg
8600#    j exitError
8604:divByZeroError:
8604#    la $a0,divByZeroMsg
8608#    j exitError
8612:strIndexOutOfBounds:
8612#    la $a0,strIndexOutOfBoundsMsg
8616#    j exitError
8620:arrayIndexOutOfBounds:
8620#    la $a0,arrayIndexOutOfBoundsMsg
8624#    j exitError
8628:arraySizeOutOfBounds:
8628#    la $a0,arraySizeOutOfBoundsMsg
8632#    j exitError
8636:nullPtrException:
8636#    la $a0,nullPtrExceptionMsg
8640#    j exitError
8644:badIntegerFormat:
8644#    la $a0,badIntegerFormatMsg
8648#    j exitError
8652:castException:
8652#    la $a0,castExceptionMsg
8656#    j exitError
############## data section ################
    .data
9336:hexChars:
    .ascii "0123456789abcdef"
    .align 2
9352:cur_seg:
    .word 0

9356:lastCharRead:
    .word -2 # -2 => no buffered character
9360:prevHashConstant:
    .word 0x2785173c
9364:gcCount:
    .word 0

9368:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
9395:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
9418:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
9453:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
9487:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
9520:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
9551:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
9599:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
9620:gcMsg: 
      .asciiz "\nGC!\n"
9626:gcCountMsg: 
      .asciiz "Number of garbage collections: "

9658:nullStr:
    .asciiz "null"
9663:trueString:
    .asciiz "true"
9668:falseString:
    .asciiz "false"
9674:exitString:
    .ascii "Program execution completed."
    #### "falls through" here
9702:newlineString:
    .asciiz "\n"
    
    .align 2
9704:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

9708:seg0_start:
    .space 0x100000
1058284:seg0_end:
1058284:seg1_start:
    .space 0x100000
2106860:seg1_end:
