    # save $ra by pushing onto stack
5060#    subu $sp,$sp,4
5064#    sw $ra,($sp)

      # read the character
5068#    jal readLogicalChar

    # restore return address; put value in $t0
    # replacing this-pointer saved return address
5072#    lw $ra,($sp)
5076#    addu $sp, 4
5080#    move $t0, $v0

    # return
5084#    jr $ra
