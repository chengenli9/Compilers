4037##...slt $at,$t0,$zero
4041##...beq $at,$zero,4060
4044#    and $t0,0xff # mask off object's hash value ...
4045##...lui $at,0
4049##...ori $at,$at,0xff
4053##...and $t0,$t0,$at
4056#    sw $t0,-8($s7) # ... and store back into -8 header-word
