##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
260:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
260#    lw $t0,-8($s2) # get word with hash bits from this
264#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
268#    addu $t0,$t1

272#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
276:mth_equals_Object:
276#    move $t0,$s2 # first pointer (this)
280#    lw $t1,($sp) # second pointer
284#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
285##...subu $at,$t0,$t1
289##...sltiu $t0,$at,1

292#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
296:mth_hashCode_String:
296#    move $t0,$s2 # put this pointer in t0

300#    li $t2,0 # current hash value
304#    lw $t1,-4($t0) # negative of number of characters in string
308#    beq $t1,$zero,done_hashCode_String # if zero length => done
312#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
316#    and $t0,0xfffffffc # adjust for padding
317##...lui $at,65535
321##...ori $at,$at,0xfffc
325##...and $t0,$t0,$at
328#    subu $t1,$t0,$t1 # address at end of string +12
332:loop_hashCode_String:    
332#    sll $t4,$t2,5 # multiply by 32
336#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
340#    lbu $t3,-12($t0) # current character
344#    addu $t2,$t3 # add in current character
348#    addu $t0,1 # go to next character's address
352#    bne $t0,$t1,loop_hashCode_String # loop back if more
356:done_hashCode_String:    

    # push int on stack
356#    move $t0, $t2 # put $t2 in return slot
360#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
364:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
364#    subu $sp,4
368#    sw $ra,($sp)
    
    # get hash value
372#    lw $t2,-12($s2) # vtable address
376#    lw $t0,($t2) # method address
380#    jalr $t0
384#    subu $sp,8 # push result (int in $t0) on stack
388#    sw $s5,4($sp)
392#    sw $t0,($sp)

    # compute print-size of hash value
396#    li $t0, 1
400#    lw $t1, ($sp)
404#    srl $t1,$t1,4
408#    beq $t1,$zero,toString_skip_loop
412:toString_loop_top:
412#    addu $t0,1
416#    srl $t1,$t1,4
420#    bne $t1,$zero,toString_loop_top
424:toString_skip_loop:
424#    subu $sp,8
428#    sw $s5,4($sp)
432#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
436#    lw $t2,-12($s2) # vtable address
440#    move $t0,$t2
444:toString_checkTagBit:
444#    subu $t0,1
448#    lb $t1,($t0)
452#    and $t1,0x80
453##...lui $at,0
457##...ori $at,$at,0x80
461##...and $t1,$t1,$at
464#    beq $t1,$zero,toString_checkTagBit
468#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
472#    subu $sp,8
476#    sw $t1,($sp)
480#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
484#    move $s7,$zero # -4 offset header word
488#    lw $t4,8($sp) # bytes for hash value
492#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
496#    addu $t4,8
500#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
504#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

508#    li $t0,CLASS_String # store string vtable address into ...
512#    sw $t0,-12($s7) # ... -12 offset in object header
516#    lw $t2,-12($s2) # our object's vtable address
520#    lw $t5,4($sp) # number characters in prefix
524#    lw $t1,12($sp) # number of characters in hashcode
528#    addu $t3,$t1,$t5 # number of characters in string ...
532#    addu $t3,1 # ... including the '@' character
536#    subu $t0,$zero,$t3 # store negated length into ...
540#    sw $t0,-4($s7) # ... -4 offset header word
544#    lw $t0,-8($s7) # get -8 offset header-word
548#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
549##...slt $at,$t0,$zero
553##...beq $at,$zero,572
556#    and $t0,0xff # mask off object's hash value ...
557##...lui $at,0
561##...ori $at,$at,0xff
565##...and $t0,$t0,$at
568#    sw $t0,-8($s7) # ... and store back into -8 header-word
572:skipMask_toString:
572#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
576#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
580#    subu $t4,$t2,$t5
584:toString_copyLoop:    
584#    lb $t3,($t4)
588#    and $t3,0x7f # mask off sign bit (in case first word)
589##...lui $at,0
593##...ori $at,$at,0x7f
597##...and $t3,$t3,$at
600#    sb $t3,-8($t0)
604#    addu $t4,1
608#    addu $t0,1
612#    blt $t4,$t2,toString_copyLoop
613##...slt $at,$t4,$t2
617##...bne $at,$zero,584

    # copy the '@' sign
620#    li $t3,'@'
624#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
628#    addu $t2,$t0,$t1 # address of last byte in string to store +8
632#    lw $t3,20($sp) # hash code to print
636:toString_hashCopyLoop:
636#    and $t4,$t3,0xf
640#    srl $t3,4
644#    lb $t4,hexChars($t4)
648#    sb $t4,-8($t2)
652#    subu $t2,$t2,1
656#    bgt $t2,$t0,toString_hashCopyLoop
657##...slt $at,$t0,$t2
661##...bne $at,$zero,636

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
664#    addu $sp,28
668#    lw $ra,($sp)
672#    addu $sp,4
676#    move $t0, $s7 # return string we created
680#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
684:mth_equals_String:
    
    # quick test for obvious false
684#    lw $t0,($sp) # second parameter
688#    beq $t0,$zero,goEsFalse # go return false if null
692#    lw $t1,-12($t0) # vtable pointer
696#    la $t2,CLASS_String # string vtable pointer
700#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
704#    subu $sp,12
708#    sw $ra,8($sp)
712#    sw $s2,4($sp)
716#    sw $t0,($sp)
720#    jal mth_compareTo_String
724#    lw $s2, 4($sp) #restore this pointer and pop parameters
728#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
732#    seq $t0,$t0,$zero
733##...subu $at,$t0,$zero
737##...sltiu $t0,$at,1

    # pop return address and return $t0
740#    lw $ra,($sp)
744#    addu $sp,4

748#    jr $ra # return
    
752:goEsFalse:
    # put 0 in $t0 and return
752#    li $t0, 0
756#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
760:mth_toString_String:
    #we are a string, so return this.
760#    move $t0, $s2
764#    jr $ra

###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
768:mth_readLine_Lib:
    
768#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
772#    sw $ra, 4($sp) # save $ra
776#    move $t1,$sp # save "original" sp

780:  doRead:

    # read the character
780#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
784#    subu $t2,$v0,13
788#    bne $t2,$zero,notReturnRL
792#    jal readLogicalChar
796#    subu $t2,$v0,10 # check for newline
800#    beq $t2,$zero,foundNewLine
804#    sw $v0,lastCharRead # push back character into queue
808#    j foundNewLine # go process the line

812:  notReturnRL:

    # at this point, $v0 has our character

812#    subu $t0,$v0,10
816#    beq $t0,$zero,foundNewLine
820#    blt $v0,$zero,foundEof
821##...slt $at,$v0,$zero
825##...bne $at,$zero,840

    # we have a character, so push it onto stack
828#    subu $sp,$sp,4
832#    sw $v0,($sp)

    # loop back up to get next character
836#    j doRead

840:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
840#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
844#    li $s7, 0 # return-value: null
848#    j rlReturn # return

852:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
852#    subu $t0,$t1,$sp # number of chars we read (times 4)
856#    srl $s6,$t0,2 # number of words on stack with chars
860#    subu $sp,$sp,4 # push char-count ...
864#    sw $s6,($sp) # ... onto stack
868#    addu $t2,$t0,5 # GC tag, incl. for count-word
872#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
876#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
880#    srl $s6,$s6,2  # data words in object
884#    move $s7,$zero # object words in object
888#    jal newObject  # allocate space
    
    # store header words
892#    la $t0,CLASS_String
896#    sw $t0,-12($s7)# store class tag (String) into object
900#    lw $t2,4($sp) # char-count
904#    sll $t1,$t2,2 # 4 times number of chars
908#    subu $t2,$zero,$t2 # negative of char-count
912#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
916#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
920#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
921##...slt $at,$t0,$zero
925##...beq $at,$zero,944
928#    and $t0,0xff # mask off object's hash value ...
929##...lui $at,0
933##...ori $at,$at,0xff
937##...and $t0,$t0,$at
940#    sw $t0,-8($s7) # ... and store back into -8 header-word
944:  skipMask_readLine:

944#    sll $t0,$t0,2 # data bytes in object
948#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
952#    subu $t0,$t0,$t2 # place to store last character (plus 9)
956#    addu $sp,$sp,8 # pop redundant object-pointer and count
960#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

964#    beq $sp,$t1,rlReturn
968:  charCopyLoop:
968#    lw $t2,($sp)
972#    sb $t2,-9($t0)
976#    addu $sp,$sp,4
980#    subu $t0,$t0,1
984#    bne $sp,$t1,charCopyLoop
988:  rlReturn:

988#    lw $ra, 4($sp)
992#    addu $sp, 8   # pop $ra and pointless word off stack
996#    move $t0, $s7 # return string we allocated in $s7
1000#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
1004:mth_readInt_Lib:

    # save $ra by pushing onto stack
1004#    subu $sp,$sp,4
1008#    sw $ra,($sp)

1012:  riSkipWhiteLoop:
    # read a character
1012#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
1016#    subu $t0,$v0,32
1020#    bgt $t0,$zero,nonWhite
1021##...slt $at,$zero,$t0
1025##...bne $at,$zero,1068
1028#    beq $t0,$zero,riSkipWhiteLoop # start over if space
1032#    subu $t0,$v0,10
1036#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
1040#    subu $t0,$v0,9
1044#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
1048#    subu $t0,$v0,13
1052#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
1056#    subu $t0,$v0,12
1060#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
1064#    j badIntegerFormat # illegal integer char: abort program

1068:  nonWhite:
1068#    subu $t0,$v0,'-'
1072#    li $t4,1 # final multiplier
1076#    bne $t0,$zero,helpReadInt # go read
1080#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
1084#    jal readLogicalChar

1088:  helpReadInt:
1088#    li $t2,10
1092#    subu $t1,$v0,'0' # convert digit to 0-9 value
1096#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
1097##...sltu $at,$t1,$t2
1101##...beq $at,$zero,3384
1104#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

1108:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

1108#    jal readLogicalChar # read next character
1112#    subu $t1,$v0,'0' # convert digit to 0-9 value
1116#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
1117##...sltu $at,$t1,$t2
1121##...beq $at,$zero,1140

1124#    mul $t3,$t3,$t2 # multiply old value by 10
1125##...mult $t3,$t2
1129##...mflo $t3
1132#    addu $t3,$t3,$t1 # add in value of new digit
1136#    j digitLoop

1140:  doneDigitLoop:

    # "push back" unused character into queue
1140#    sw $v0,lastCharRead

    # restore return address
1144#    lw $ra,($sp)
1148#    addu $sp, 4

    # multiply by sign and put return value in $t0
1152#    mult $t3,$t4 # multiply to account for poss. minus sign
1156#    mflo $t3
1160#    move $t0, $t3
    
    # return
1164#    jr $ra

