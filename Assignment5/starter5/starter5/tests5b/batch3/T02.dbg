    # allocate memory
8488#    subu $s6,$t1,$t2 # # chars in target-string
8492#    addu $s6,$s6,7 # account for extra "class" (4) word + 3 to round up
8496#    srl $s6,$s6,2 # convert bytes-count to word-count
8500#    move $s7,$zero # (no object-bytes in string)
