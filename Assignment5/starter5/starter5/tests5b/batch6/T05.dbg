3188#    sw $t0,lastCharRead # store -2 into buffer (i.e. "empty")
3192#    jr $ra # return
    
3196:  doReadCh:
    # we need to actually read a character: read and return
3196#    li $v0,12 # use system call to read a character
3200#    syscall
3204#    jr $ra # return
