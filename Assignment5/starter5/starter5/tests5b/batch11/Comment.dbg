# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

5732:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
5732#    li $v0,4 # syscall-code for print-string
5736#    syscall
5740:exit:
    # print termination message
5740#    li $v0,4 # syscall-code for print-string
5744#    la $a0,exitString
5748#    syscall

    # print number of garbage collections
5752#    li $v0,4 # syscall-code for print-string
5756#    la $a0,gcCountMsg
5760#    syscall # print "Number of ..."
5764#    lw $a0,gcCount # number of GC's
5768#    li $v0,1 # code for print-int
5772#    syscall
5776#    li $v0,4 # syscall-code for print-string
5780#    la $a0,newlineString
5784#    syscall # print newline

    # terminate execution
5788#    li $v0,10 #syscall-code for "exit"
5792#    syscall

5796:outOfHeapMemory:
5796#    la $a0,heapMemoryMsg
5800#    j exitError
5804:divByZeroError:
5804#    la $a0,divByZeroMsg
5808#    j exitError
5812:strIndexOutOfBounds:
5812#    la $a0,strIndexOutOfBoundsMsg
5816#    j exitError
5820:arrayIndexOutOfBounds:
5820#    la $a0,arrayIndexOutOfBoundsMsg
5824#    j exitError
5828:arraySizeOutOfBounds:
5828#    la $a0,arraySizeOutOfBoundsMsg
5832#    j exitError
5836:nullPtrException:
5836#    la $a0,nullPtrExceptionMsg
5840#    j exitError
5844:badIntegerFormat:
5844#    la $a0,badIntegerFormatMsg
5848#    j exitError
5852:castException:
5852#    la $a0,castExceptionMsg
5856#    j exitError
############## data section ################
    .data
6456:hexChars:
    .ascii "0123456789abcdef"
    .align 2
6472:cur_seg:
    .word 0

6476:lastCharRead:
    .word -2 # -2 => no buffered character
6480:prevHashConstant:
    .word 0x2785173c
6484:gcCount:
    .word 0

6488:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
6515:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
6538:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
6573:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
6607:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
6640:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
6671:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
6719:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
6740:gcMsg: 
      .asciiz "\nGC!\n"
6746:gcCountMsg: 
      .asciiz "Number of garbage collections: "

6778:nullStr:
    .asciiz "null"
6783:trueString:
    .asciiz "true"
6788:falseString:
    .asciiz "false"
6794:exitString:
    .ascii "Program execution completed."
    #### "falls through" here
6822:newlineString:
    .asciiz "\n"
    
    .align 2
6824:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

6828:seg0_start:
    .space 0x100000
1055404:seg0_end:
1055404:seg1_start:
    .space 0x100000
2103980:seg1_end:
